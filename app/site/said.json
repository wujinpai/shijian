情","告白"]],["只愿君心似我心，定不负相思意。","李之仪","卜算子","宋",316047,["爱情","告白"]],["曾经沧海难为水，除却巫山不是云。","元稹","离思五首 其四","唐",6743,["爱情","告白"]],["两情若是长久时，又岂在朝朝暮暮。","秦观","鹊桥仙","宋",318250,["爱情","告白","七夕"]],["金风玉露一相逢，便胜却人间无数。","秦观","鹊桥仙","宋",318250,["爱情","七夕"]],["愿我如星君如月，夜夜流光相皎洁。","范成大","车遥遥篇","宋",294350,["爱情","告白"]],["玲珑骰子安红豆，入骨相思知不知。","温庭筠","南歌子词二首 其二","唐",7074,["爱情","告白"]],["红豆生南国，春来发几枝。愿君多采撷，此物最相思。","王维","相思","唐",2500,["相思","爱情"]],["一日不见，如三月兮。","佚名","采葛","先秦",71,["相思"]],["衣带渐宽终不悔，为伊消得人憔悴。","柳永","凤栖梧・蝶恋花","宋",316105,["相思"]],["此情无计可消除，才下眉头，却上心头。","李清照","一剪梅・一翦梅","宋",330264,["相思"]],["春心莫共花争发，一寸相思一寸灰。","李商隐","无题四首 其二","唐",31750,["相思"]],["君问归期未有期，巴山夜雨涨秋池。","李商隐","夜雨寄北","唐",6521,["相思"]],["何当共剪西窗烛，却话巴山夜雨时。","李商隐","夜雨寄北","唐",6521,["相思"]],["青青子衿，悠悠我心。","佚名","子衿","先秦",90,["相思"]],["天涯地角有穷时，只有相思无尽处。","晏殊","木兰花 春恨","宋",316050,["相思"]],["井底点灯深烛伊，共郎长行莫围棋。","温庭筠","南歌子词二首 其二","唐",7074,["相思"]],["但愿人长久，千里共婵娟。","苏轼","水调歌头 丙辰中秋，欢饮达旦，大醉。作此篇，兼怀子由","宋",316000,["相思","中秋"]],["此情可待成追忆，只是当时已惘然。","李商隐","锦瑟","唐",31728,["失恋","遗憾"]],["人生若只如初见，何事秋风悲画扇。","纳兰性德","木兰花令·拟古决绝词","清",349001,["失恋","遗憾"]],["当时只道是寻常。","纳兰性德","浣溪沙·谁念西风独自凉","清",349008,["失恋","遗憾"]],["去年今日此门中，人面桃花相映红。人面不知何处在，桃花依旧笑春风。","崔护","题都城南庄","唐",7038,["失恋","遗憾"]],["多情却被无情恼。","苏轼","蝶恋花 春景","宋",316425,["失恋","遗憾"]],["东风恶，欢情薄。一怀愁绪，几年离索。错、错、错。","陆游","钗头凤・撷芳词","宋",317849,["失恋","遗憾"]],["还君明珠双泪垂，何不相逢未嫁时。","张籍","节妇吟寄东平李司空师道","唐",871207,["失恋","遗憾"]],["等闲变却故人心，却道故心人易变。","纳兰性德","木兰花令·拟古决绝词","清",349001,["失恋","遗憾"]],["十年生死两茫茫，不思量，自难忘。","苏轼","江神子 乙卯正月二十日夜记梦","宋",316110,["失恋"]],["无可奈何花落去，似曾相识燕归来。","晏殊","假中示判官张寺丞王校勘","宋",211560,["失恋"]],["落花人独立，微雨燕双飞。","晏几道","临江仙 其七","宋",316059,["失恋"]],["问君能有几多愁，恰似一江春水向东流。","李煜","虞美人·春花秋月何时了","五代",61004,["愁"]],["抽刀断水水更流，举杯销愁愁更愁。","李白","宣州谢朓楼饯别校书叔云","唐",49966,["愁"]],["寻寻觅觅，冷冷清清，凄凄惨惨戚戚。","李清照","声声慢","宋",316003,["愁"]],["只恐双溪舴艋舟，载不动许多愁。","李清照","武陵春 春晚","宋",317385,["愁"]],["剪不断，理还乱，是离愁。别是一般滋味在心头。","李煜","相见欢·无言独上西楼","五代",61015,["愁"]],["少年不识愁滋味，爱上层楼。","辛弃疾","丑奴儿 书博山道中壁","宋",324802,["愁"]],["而今识尽愁滋味，欲说还休。欲说还休，却道天凉好个秋。","辛弃疾","丑奴儿 书博山道中壁","宋",324802,["愁"]]