[["高宗建炎初祀昊天上帝 皇帝还位用《正安》。","郊庙朝会歌辞","四言",["典祀有常，昭事上帝。","奉以告虔，逮迄奠币。","钟鼓既设，礼仪既备。","神之格思，恭承贶赐。"],0,"x207","宋"],["绍兴亲享明堂二十六首 其二十一 皇帝饮福用《胙安》。","郊庙朝会歌辞","四言",["孰谓天远，至诚则通。","孰谓地厚，与天则同。","惠我纯嘏，克成大功。","握图而治，如日之中。"],0,"x207","宋"],["维摩居士赞","李之仪","四言",["毗耶离城，此去几许。","一睹慈光，如到其所。","八万四千，翻风驾雨。","枯者即荣，堕者斯举。","周遍恒沙，了无一语。"],0,"x203","宋"],["文忠公画像赞","李之仪","四言",["霜空无云，秋天澄雾。","照然政通，何劳钟簴。","俨然望之，希世一遇。","万折方东，逢坡益注。"],0,"x203","宋"],["偈颂三十首 其八","释慧晖","四言",["真到做处，清虚妙体。","时时随后，步步在前。"],0,194,"宋"],["为人作真赞 其一","李之仪","四言",["王良不作，世绝麒麟。","是可欺邪，岂无后人。","谁其似之，维烈武孙。","武则似矣，而济以文。","气已万里，方尔就秣。","风云其时，会如兔脱。","俨然是则，现居士身。","幅巾白拂，无一点尘。","以无尘故，始终一如。","显忠数功，固非两途。"],0,"x203","宋"],["梦中作四言用前韵二首 其二","洪炎","四言",["鹢鹢珍腿，猩猩美唇。","醴齐调适，勺药和匀。","老商嬉笑，西施解颦。","倦龟若士，翳桑饿人。"],0,110,"宋"],["寂音自赞四首 其二","惠洪","四言",["三玄纲宗，壁立崔嵬。","攀缘路绝，热恼心灰。","如化鲲鹏，不借风雷。","盖自化耳，宁有法哉。","汾阳此秘，寂音揭开。","手提大千，毫端往来。"],0,"x42","宋"],["承天宝禅师赞","黄庭坚","四言",["灵山会上，得个消息。","达安城中，不落裷𩃫。","黄抚路口，雪里开花。","九江渡头，无风起浪。"],0,"x66","宋"],["视师颂","常挺","四言",["岷山穹隆，岷水浺瀜。","气郁葱葱，至和所钟。","秀毓临邛，笃生英雄。","绰有祖风，唐之郑公。","进思尽忠，王臣靡躬。","万壑奔洚，砥植在中。","退思固穷，为时儒宗。","启迪颛蒙，如金在镕。","王明泰通，虎啸风从。","入觐九重，天子改容。","时谨边烽，命公抚戎。","大江西东，隐若长墉。","甲兵藏胸，樽俎折冲。","万年之功，寿与天同。","聊述鄙悰，以侑乐工。"],0,228,"宋"],["初荣  其一","曾丰","四言",["𦴇𦴇者菊，九月初荣。","于家之庭，有旗有铃。","主文孔明，绰其能声。","之子初荣，与象为声。","匪家之馨，维乡之馨。"],0,"x193","宋"],["绍兴以后祀五方帝六十首 黑帝奠玉币用《嘉安》。","郊庙朝会歌辞","四言",["晨曦未升，天宇肃穆。","祗若元祀，将以币玉。","神之格思，三献茅缩。","明灵怿豫，下土是福。"],0,"x207","宋"],["宋江三十六赞 其二十一 小旋风柴进","龚开","四言",["风有大小，黑恶则惧。","一噫之微，香满太虚。"],0,103,"宋"],["纳火祀大辰十二首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["币玉肃陈，笙簧具举。","桂醑浮觞，琼羞溢俎。","礼有三献，式和且序。","神具醉止，庆流寰宇。"],0,"x207","宋"],["辞众偈","释师体","四言",["铁树开花，雄鸡生卵。","七十二年，摇篮绳断。"],0,5,"宋"],["绍兴十年发皇太后册宝八首 其一 皇帝随册宝降殿用《圣安》。","郊庙朝会歌辞","四言",["景祚有开，符天媲昊。","诞毓圣神，是崇位号。","星拱天随，祗严册宝。","还御慈宁，增光舜道。"],0,"x207","宋"],["高宗建炎初祀昊天上帝 送神用《景安》。","郊庙朝会歌辞","四言",["于赫上帝，乘龙御天。","惟圣克事，明飨斯虔。","荐豆云彻，灵猋且旋。","载锡休祉，其惟有年。"],0,"x207","宋"],["偈颂九十三首 其四十九","释梵琮","四言",["灭门刺史，破家县令。","一句全提，头正尾正。","塞却耳根，谛听谛听。"],0,100,"宋"],["宋颂九首 其二 圣武","石介","四言",["圣仁如天，恶杀好生。","于以耀德，匪来观兵。","亟命止戈，无兹黩刑。","不剿其类，戴我以兄。","屈膝请和，畏我威灵。"],0,105,"宋"],["缘识 其十九","赵炅","四言",["道泰希夷，乃咏歌之。","群材奋发，迭奏相追。","风骚不失，千载一时。","倜傥沿革，大启箴规。"],0,"x63","宋"],["跋涂毒与惠老偈","楼钥","四言",["我铭师塔，而不识面。","一瞻顶相，烂烂岩电。","横说竖说，不待饶舌。","涂毒一声，百兽脑裂。"],0,"x175","宋"],["泐潭我和尚真赞","黄庭坚","四言",["枯木突兀，傲睨万物。","顶门上眼，正法中骨。"],0,"x66","宋"],["畴依  其一六","王柏","四言",["皇宋文明，周子天畀。","不由师传，道体默契。","建图属书，以觉后觉。","上接洙泗，下开河洛。"],0,"x137","宋"],["题淮阴泰山行宫庙","徐积","四言",["泰山隆隆，作镇于东。","有如配林，在淮之阴。","厥庙维严，厥貌维肖。","斯民奉之，是为别庙。"],0,"x123","宋"],["偈颂六十五首 其六十一","释普济","四言",["深山穷谷，蛇虎纵横。","平田浅草，鸦鸣鹊噪。"],0,73,"宋"],["偈颂二十五首 其八","释道璨","四言",["仰山撼树，沩山良久。","说体说用，互扬家丑。"],0,93,"宋"],["祐胜菩萨赞","惠洪","四言",["雷发春晓，象牙有花。","是何因缘，而使然耶。","一切幻物，感以无心。","不思而合，如磁石针。","况我大士，慈善根力。","不起于座，沛然甘泽。","千峰青碧，环如长城。","经今几时，殿阁崇成。","咨尔邦士，时朔荐拜。","稽首真慈，是甘露海。"],0,"x42","宋"],["祭九鼎十二首 其三 亚、终献用《文安》。","郊庙朝会歌辞","四言",["工祝致辞，黄流协鬯。","爰登清歌，载期神享。","噫予诚心，精禋是虔。","嘉予陈祀，丰盈豆笾。"],0,"x207","宋"],["题画竹石","张翼","四言",["嗟彼凤去，空馀虎蹲。","竹不可食，石不能言。"],0,178,"元"],["和子瞻次韵陶渊明停云诗 其三","苏辙","四言",["欣然而笑，是无枯荣。","手足相依，所钟则情。","情忘意消，神凝不征。","可以安身，可以长生。"],0,"x135","宋"],["题梅四首 其二","袁甫","四言",["雪欺梅耶，抑梅欺雪。","孤高之操，凛凛清绝。"],0,229,"宋"],["偈颂七十六首 其五","释师观","四言",["动弦别曲，叶落知秋。","风生大野，水向东流。"],0,210,"宋"],["解字吟","邵雍","四言",["人言为信，日月为明。","止戈为武，羔美为羹。"],0,"x57","宋"],["元符亲郊五首 其四 彻豆用《熙安》。","郊庙朝会歌辞","四言",["陟彼郊丘，大祀是承。","其豆孔庶，其香始升。","上帝时歆，以我齐明。","卒事而彻，福禄来咸。"],0,"x207","宋"],["偈颂二十五首 其九","释道璨","四言",["开眼便是，开口便是。","举手便是，举足便是。","虽然如是，未是未是。"],0,93,"宋"],["偈","释妙堪","四言",["大荼毒鼓，轰天震地。","转脑回头，横死万里。"],0,243,"宋"],["绣释迦像并十八罗汉赞 第十四伐那波斯尊者","惠洪","四言",["纵倚箕踞，莫不是定。","毒既止息，邪亦自正。","钵花自香，蒲扇闲把。","目视云霄，我相未舍。"],0,"x42","宋"],["六世祖师画像赞 初祖","惠洪","四言",["妄想无性，证不灭受。","前圣所知，转相授手。","风烟花开，器界以形。","霜露果熟，王子乃生。","护持佛乘，指示心体。","但遮其非，不言其是。","婴儿索物，意正语偏。","哆啝之中，语意俱捐。"],0,"x42","宋"],["汉诏郡县行乡饮酒礼颂诗  其六","洪遵","四言",["迺速庠门，迺洁东荣。","宾主僎介，堪舆是程。"],0,18,"宋"],["偈颂一百三十三首 其四十五","释居简","四言",["是佛亦拜，是魔亦拜。","大胆小心，不妨忒煞。"],0,"x94","宋"],["吴郡王冷泉图赞","赵构","四言",["富贵不骄，戚畹称贤。","扫除膏粱，放旷林泉。","沧浪濯足，风度萧然。","国之元舅，人中神仙。"],0,249,"宋"],["上邓宪生辰  其四","杨简","四言",["有孙维良，秉德正方。","天子曰于，寘彼周行。"],0,118,"宋"],["和陶劝农韵勉吾乡之学者 其五","吴芾","四言",["大抵名儒，岂患穷匮。","大抵外物，岂在侥冀。","学成道尊，富贵自至。","不学空虚，非惟自愧。"],0,"x95","宋"],["颂古三十三首 其十","释师观","四言",["百丈卷席，马祖升堂。","作么作么，验尽当行。"],0,210,"宋"],["宋颂九首 其三 圣武","石介","四言",["弃甲以归，处彼北隩。","千斯年兮，永以为好。","边人其安，养幼送老。","民有肥田，马有茂草。","威德远兮，思我圣考。"],0,105,"宋"],["并用存心微妙诀","晁迥","四言",["处世间法，或伸或屈。","用观察智，无固无必。","出世间法，勿违勿失。","用决定信，惟精惟一。","曲尽其妙，退藏于密。"],0,199,"宋"],["颂古九十八首 其五十一","释印肃","四言",["东西南北，通彻交过。","悟者清凉，迷者大祸。","随流入流，法真不堕。","若未全提，谁敢担荷。"],0,"x121","宋"],["和子瞻次韵陶渊明停云诗 其四","苏辙","四言",["跋扈飞扬，谁匪南柯。","运历相寻，忧喜杂和。","我游其外，所享则多。","削迹拔木，其如予何。"],0,"x135","宋"],["上邓宪生辰  其三","杨简","四言",["使者维何，有祖高密。","云台第一，流芳泌泌。"],0,118,"宋"],["和陶劝农韵勉吾乡之学者 其三","吴芾","四言",["吾乡人物，散处川陆。","岂无秀民，生而清穆。","亦既从师，步趋随逐。","亦既穷经，访寻归宿。"],0,"x95","宋"],["偈颂一百六十首 其十七","释宗杲","四言",["一不成只，两不在双。","剑号巨阙，珠称夜光。"],0,"x112","宋"],["文宣王及其弟子赞 其六十二","赵构","四言",["师席高振，大成是集。","至道克传，贤达斯执。","善道云袤，儒风可立。","渔阳之士，得跂而及。"],0,249,"宋"],["偈颂六十五首 其二十二","释普济","四言",["击鼓升堂，不谈世法。","冬至月头，卖被买牛。","冬至月尾，卖牛买被。"],0,73,"宋"],["费力吟","邵雍","四言",["事无巨细，人有得失。","得之小心，失之费力。"],0,"x57","宋"],["偈颂一百二十三首 其四十六","释祖钦","四言",["水不洗水，金不博金。","青天白日，自古自今。"],0,64,"宋"],["临际大师赞","释智愚","四言",["黄檗棒头，大愚肋下。","后代儿孙，乌焉成马。"],0,"x153","宋"],["亲耕藉田七首 其二 亲耕。","郊庙朝会歌辞","四言",["元辰既择，礼备乐成。","洪縻在手，祗饰专精。","三推一垡，端冕朱纮。","靡辞染屦，以示黎氓。"],0,"x207","宋"],["亲耕藉田七首 其三 升坛。","郊庙朝会歌辞","四言",["方坛屹立，陛级而登。","玉色下照，临观耦耕。","万目咸睹，如日之升。","成规成矩，百禄是膺。"],0,"x207","宋"],["亲耕藉田七首 其六 降坛。","郊庙朝会歌辞","四言",["肇新帝藉，率我农人。","三推终亩，祗事咸均。","陟降孔时，粲然有文。","受天之祜，多稼如云。"],0,"x207","宋"],["偈颂一百零一首 其九十六","释慧性","四言",["智不是道，心不是佛。","辊雪峰毬，舞道吾笏。"],0,46,"宋"],["辞众颂","释宗印","四言",["四十九年，一场热哄。","八十七春，老汉独弄。","谁少谁多，一般作梦。","归去来兮，梅梢雪重。"],0,84,"宋"],["提辖官钟勤及其子可久写平园真睨蟾倚桂为生日寿","周必大","四言",["元丰壬戌，中元之夕。","仇池飞仙，浩歌赤壁。","今两甲子，明月犹昔。","嘉尔父子，记我颜色。","丹桂婆娑，银蟾皎洁。","愿言冰轮，常圆罔缺。"],0,"x76","宋"],["吴王造见应命二帖赞","岳珂","四言",["所书如此，而事如彼。","既悦我目，亦冷我齿。","我录此事，与郗超比。","名焉不刊，帖亦奚毁。"],0,"x202","宋"],["塔铭","释如珙","四言",["天生一穴，藏吾枯骨。","骨朽成土，土能生物。","结个葫芦，挂赵州壁。","永脱轮回，超三世佛。"],0,255,"宋"],["为黄仲宣赋山中四章章四句  其四","方回","四言",["于疏于𫏋，朋来其学。","彼恶知兹，山中之乐。"],0,"x59","宋"],["绍兴祈谷三首 其一 太宗位奠币用《宗安》。","郊庙朝会歌辞","四言",["于穆思文，克配上帝。","涓选休成，遵扬严卫。","祗荐明诚，肃陈量币。","享兹吉蠲，申锡来裔。"],0,"x207","宋"],["送李守孝博","徐积","四言",["外官之重，其惟使乎。","使者之重，兵政刑诛。","持挈纲领，设施楷模。","以实去伪，以清革污。","善本须养，恶根必锄。","非严不肃，非宽不舒。","非威不行，非信不孚。","诸如此类，一不可无。","而况百粤，岭阳海隅。","其俗彍悍，戒吏侵渔。","缓之则怀，扰之则吁。","又况其徼，溪洞蛮居。","虑要先定，戒须早图。","使臣之重，不其然欤。","命使维何，曰山阳守。","维山阳守，其质忠厚。","既明而恕，惟所自有。","以严以威，以左以右。","维恕维平，维详维精。","所济维敏，所孚维诚。","刑无必用，事皆原情。","或虚其狱，或空其庭。","称者盈巷，传者盈城。","四境之内，尽为欢声。","其体则庄，面无浮气。","其目则瞭，心无所蔽。","不激不诡，不迁不泥。","亦不自务，亦不自恃。","好谋好询，使臣所贵。","维询维谋，何以酬之。","维时武备，为国修之。","我闻番禺，熙宁之前。","弓手之外，枪手三千。","总计一路，何啻万数。","因而循之，不烦招募。","可增其籍，可当土兵。","不费斗粟，不用尺缯。","其便如此，何惮弗兴。","付之善吏，以成其能。","训之练之，按阅有程。","可如汉制，选择骁锐。","号为奔命，无所不备。","岂惟广东，自广而西。","闻命即赴，势张力齐。","如声如响，如鸷如飞。","如决大水，从山赴溪。","盖神速者，用兵之奇。","仍坚其城，仍浚其池。","虽有交趾，正如狐狸。","伏藏窟穴，其何能为。"],0,"x123","宋"],["宋江三十六赞 其二十八 一直撞董平","龚开","四言",["昔樊将军，鸿门直撞。","斗酒肉肩，其言甚壮。"],0,103,"宋"],["宋颂九首 其一 六合雷声","石介","四言",["六合雷声，中国有君。","涂其耳目，不使听闻。","隔在荒外，嗟尔并人。"],0,105,"宋"],["史忠定蚤作帖赞","岳珂","四言",["危微精一，传之在心。","二典勋华，光于有临。","大原自天，端倪孰寻。","岂无畴咨，培高浚深。","寝明以昌，举元难壬。","烝哉明良，嗣此德音。","匪鉴而讽，匪鉴而箴。","启迪在初，有开宸襟。","岩廊南风，袗衣鼓琴。","渊跃𥬞云，匣铏发镡。","达其已充，泽彼苍黔。","王度之恢，如玉如金。","进而虞渊，宾旸发霠。","坱圠机衡，开阖阳阴。","九韶其谐，万奏皆瘖。","退而卷怀，艺圃书林。","出入欧颜，而加𣂏斟。","湛湛秋江，岧岧春岑。","如彼德人，危冠整簪。","不伐不矜，森严深沉。","我考问学，惟心靡谌。","端平自我，何用弗钦。","重抵九鼎，价逾万琛。","惟帖可观，为世砭针。","尚信我言，匪今斯今。"],0,"x202","宋"],["上邓宪生辰  其九","杨简","四言",["首白蠲租，宽博其模。","大公靡私，匪畏匪拘。"],0,118,"宋"],["偈颂一百六十首 其五十八","释宗杲","四言",["即念离念，觉与非觉。","有心无心，若善若恶。","搅成一块，将错就错。"],0,"x112","宋"],["颂古一百二十一首 其四十三","释宗杲","四言",["入门便棒，郎当不少。","依而行之，胡麻厮缴。"],0,"x112","宋"],["宝祐二年皇子冠二十首 其十四","郊庙朝会歌辞","四言",["善颂善祷，三加弥尊。","爵弁峨峨，介圭温温。","阳德方长，成德允存。","燕及君亲，厥祉孔蕃。"],0,"x207","宋"],["朝采卷耳行","释文珦","四言",["朝采卷耳，于陵于冈。","取叶存根，以备酒浆。","嗟我怀人，在彼遐方。","闵其勤劳，寤寐弗忘。","念得送我，置尔之傍。","所愿莫遂，徘徊彷徨。","凤游四海，亦思其凰。","毋以道远，而易中肠。","好鸟和鸣，其飞颉颃。","感物增忧，泣涕沾裳。"],0,"x80","宋"],["畴依  其二","王柏","四言",["巍乎大哉，尧之为君。","其仁如天，其知如神。","凿井耕田，出作入息。","击壤而歌，不知帝力。"],0,"x137","宋"],["宋颂九首 其二 皇祖","石介","四言",["皇祖龙骧，畴敢猖狂。","元年九月，进叛于扬。","皇祖长驱，至扬城隅。","进窘登楼，并焚其孥。"],0,105,"宋"],["偈五首 其三","释岩","四言",["诸人知处，山僧尽知。","山僧知处，诸人不知。","头上是天，脚下是地。"],0,5,"宋"],["高宗祀明堂前朝享太庙二十一首 其一 皇帝入门用《干安》。","郊庙朝会歌辞","四言",["于皇我后，祗戒专精。","齐肃有容，祖考是承。","造次匪懈，孝思纯诚。","神听有格，福禄来宁。"],0,"x207","宋"],["宋颂九首 其一 皇祖","石介","四言",["皇祖神武，畴敢戏豫。","元年四月，筠叛于潞。","皇祖跃马，至潞城下。","筠窘赴火，焦头烂胯。"],0,105,"宋"],["偈颂六十五首 其十三","释普济","四言",["冬至前后，沙飞石走。","佛祖潜踪，寸铁在手。"],0,73,"宋"],["上邓宪生辰  其八","杨简","四言",["民饥毋恐，惠泽方涌。","适兼郡符，民有天宠。"],0,118,"宋"],["朝阳穿破衲赞","释绍昙","四言",["断线无蹊，折针缺鼻。","提得完全，金乌西坠。"],0,"x108","宋"],["绍兴释奠武成王七首 其七 送神。","郊庙朝会歌辞","四言",["日惟上戊，神顾精纯。","礼备三献，乐成七均。","奄留洋洋，流福无垠。","言还恍惚，空想如存。"],0,"x207","宋"],["偈十九首 其十七","释守卓","四言",["风从何来，雨从何至。","皮下有血，面上有鼻。","脱体相呈，全无忌讳。","明眼衲僧，更须瞥地。","瞥地如何，且莫瞌睡。"],0,42,"宋"],["四先生像赞 晦庵朱文公","刘黻","四言",["天振斯文，紫阳木铎。","博详反约，是继绝学。","日月昭炳，揭之以行。","闲居野服，身屈道亨。"],0,247,"宋"],["临济和尚赞","释师观","四言",["一喝当阳，寸丝不挂。","挠括丛林，至今话把。"],0,210,"宋"],["北窗伊吾 其三","赵戣","四言",["伊吾维吾，缉柳编蒲。","爰席其珍，尺璧珊瑚。"],0,237,"宋"],["乾道七年册皇太子四首 其一","郊庙朝会歌辞","四言",["建储以贤，辟宫于东。","典册既备，筮占既从。","济济卿士，锵锵鼓钟。","天子戾止，盛哉礼容。"],0,"x207","宋"],["大观闻喜宴六首 其六","郊庙朝会歌辞","四言",["思皇多士，扬于王庭。","钟鼓乐之，肃雍和鸣。","威仪抑抑，既安且宁。","天子万寿，永观厥成。"],0,"x207","宋"],["范文正问医帖赞","岳珂","四言",["元气在天，日星系焉。","骨鲠在身，四体恃焉。","王国之干，公实似焉。","有炜翰墨，抑其细焉。","是书之传，自尹氏焉。","历年虽多，人争毖焉。","彼名家者，众或弃焉。","胁肩夏畦，亦何利焉。","一卷之师，览者愧焉。"],0,"x202","宋"],["宁宗郊祀二十九首 尚书彻豆用《熙安》。","郊庙朝会歌辞","四言",["兰豆既升，簠簋既登。","礼备俎实，飨贵牲𦞪。","时乃告彻，器用毕兴。","祚我皇基，介福是膺。"],0,"x207","宋"],["大中祥符朝会五首 其一 皇帝举酒用《醴泉》。","郊庙朝会歌辞","四言",["觱沸槛泉，寒流清泚。","地不爱宝，其旨如醴。","上善至柔，灵休所启。","利泽无疆，允资岱礼。"],0,"x207","宋"],["高宗祀明堂前朝享太庙二十一首 其十五 徽宗室用《承元》。","郊庙朝会歌辞","四言",["圣考巍巍，光绍丕基。","礼隆乐备，时维纯熙。","天仁兼覆，皇化无为。","功成弗处，心潜希夷。"],0,"x207","宋"],["北游朔城行","释文珦","四言",["北游朔城，险阻艰难。","荒溪遐旷，穹谷纡盘。","白日晦景，阴云洞寒。","凝冰不冶，积雪宁干。","冻草色死，北风声酸。","林啸猛虎，路多胡犴。","愁肠分裂，趼足蹒跚。","风餐不饱，露宿难安。","别离之苦，维昔所叹。","怀哉征人，曷云来还。"],0,"x80","宋"],["偈颂十八首 其三","释道璨","四言",["鼓棹扬帆，驾没底船。","横行海上，神头鬼面。"],0,93,"宋"],["绍兴十三年发皇后册宝十三首 其十","郊庙朝会歌辞","四言",["素月澄辉，众星显列。","炳为天文，各有攸别。","椒房既正，阴教斯设。","关雎麟趾，应如响捷。"],0,"x207","宋"],["标指六偈 坐禅","释清远","四言",["心光虚映，体绝偏圆。","金波匝匝，动寂常禅。","念起念灭，不用止绝。","任运滔滔，何曾起灭。","起灭寂灭，现大迦叶。","坐卧经行，未曾间歇。","禅何不坐，坐何不禅。","了得如是，始号坐禅。","坐者何人，禅是何物。","而欲坐之，用佛觅佛。","佛不用觅，觅之转失。","坐不我观，禅非外术。","初心闹乱，未免回换。","所以多方，教渠静观。","端坐收神，初则纷纭。","久久恬淡，虚闲六门。","六门稍歇，于中分别。","分别才生，似成起灭。","起灭转变，从自心现。","还用自心，返观一遍。","一返不再，圆光顶戴。","灵焰腾辉，心心无碍。","横该竖入，生死永息。","一粒还丹，点金成汁。","身心客尘，透漏无门。","迷悟且说，逆顺休论。","细思昔日，冷坐寻觅。","虽然不别，也大狼籍。","刹那凡圣，无人能信。","匝地茫茫，大须谨慎。","如其不知，端坐思惟。","一日筑著，伏惟伏惟。"],0,116,"宋"],["御楼 其三","郊庙朝会歌辞","四言",["重城春满，双阙云浮。","将披雉扇，载俨珠旒。","叶风应律，文德怀柔。","溥天率土，惠泽咸周。"],0,"x207","宋"],["哲宗发皇后册宝三首 其一","郊庙朝会歌辞","四言",["既登乃依，如日之升。","有严有翼，丕显丕承。","天作之合，家邦其兴。","朱芾斯皇，子孙绳绳。"],0,"x207","宋"]]