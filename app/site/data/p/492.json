[["郊庙歌辞 朝日乐章 迎神","佚名","四言",["太阳朝序，王宫有仪。","蟠桃彩驾，细柳光驰。","轩祥表合，汉历彰奇。","礼和乐备，神其降斯。"],0,"x14","唐"],["补周礼九夏系文   四","皮日休","四言",["出有嘉谋，入有内则。","繄彼臣庶，钦王之式。"],0,"x15","唐"],["补周礼九夏系文   四","皮日休","四言",["我牢不愆，我货不匮。","硕硕其才，有乐而止。"],0,"x15","唐"],["补周礼九夏系文   四","皮日休","四言",["何以乐之，金石九奏。","何以锡之，龙旗九旒。"],0,"x15","唐"],["郊庙歌辞 祭大社乐章 送神","佚名","四言",["吉祥式就，酬功载毕。","亲地尊天，礼文经术。","贶征令序，福流初日。","神驭爰归，祠官其出。"],0,"x14","唐"],["郊庙歌辞 祀圜丘乐章 太和","褚亮","四言",["穆穆我后，道应千龄。","登三处大，得一居贞。","礼惟崇德，乐以和声。","百神仰止，天下文明。"],0,150,"唐"],["郊庙歌辞 享太庙乐章 长发舞","张说","四言",["具礼崇德，备乐承风。","魏推幢主，周赠司空。","不行而至，无成有终。","神兴王业，天归帝功。"],0,133,"唐"],["汉堤诗","卢肇","四言",["阴沴奸阳，来暴于襄。","洎入大郛，波端若铓。","触厚摧高，不知其防。","骇溃颠委，万室皆毁。","灶登蛟鼍，堂集鳣鲔。","惟恩若雠，母不能子。","洪溃既涸，闬闳其虚。","以隳我堵，以剥我庐。","酸伤顾望，若践丘墟。","帝曰念嗟，朕日南顾。","流灾降慝，天曷台怒。","滔滔襄郊，捽我婴孺。","于惟馀氓，饥伤喘呼。","斯为淫痍，孰往膏傅。","惟汝元寮，佥举明哲。","我公用谐，苴茅杖节。","来视襄人，喔咻提挈。","不日不月，咍乎抃悦。","乃泳故堤，陷于沙泥。","缺落坳圯，由东讫西。","公曰呜呼，汉之有堤。","实命襄人，不力乃力，则及乃身。","具锸与畚，汉堤其新。","帝廪有粟，帝府有缗。","尔成尔堤，必锡尔勤。","襄人怡怡，听命襄浒。","背襄肩杵，奔走蹈舞。","分之卒伍，令以麾鼓。","寻尺既度，日月可数。","登登嶪嶪，周旋上下。","披岘斲楚，飞石挽土。","举筑殷雷，骇汗霏雨。","疲癃鳏独，奋有筋膂。","呀吁来助，提筐负筥。","不劳其劳，杂沓笑语。","咸曰卢公，来赐我生。","斯堤既成，蜿蜿而平。","确尔山固，屹如云横。","汉流虽狂，坚不可蚀。","代千年亿，与天无极。","惟公之堤，昔在人心。","既筑既城，横之于南。","萌渚不峻，此门不深。","今复在兹，于汉之阴。","斯堤已崇，兹民获祐。","𫠜童相庆，室以完富。","贻于襄人，愿保厥寿。","繄公之功，赫焉如昼。","捍此巨灾，崒若京阜。","天子赐之，百姓载之。","族孙作诗，昭示厥后。"],0,177,"唐"],null,["郊庙歌辞 祭方丘乐章 雍和","褚亮","四言",["柔而能方，直而能敬。","载厚以德，大亨以正。","有涤斯牷，有馨斯盛。","介兹景福，祚我休庆。"],0,150,"唐"],["郊庙歌辞 享太庙乐章 大政舞","张说","四言",["于赫元命，权舆帝文。","天齐八柱，地半三分。","宗庙观德，笙镛乐勋。","封唐之兆，成天下君。"],0,133,"唐"],["郊庙歌辞 享太庙乐章 承光舞","佚名","四言",["金相载穆，玉裕重辉。","养德清禁，承光紫微。","干宫候色，震象增威。","监国方永，宾天不归。","孝友自衷，温文性与。","龙楼正启，鹤驾斯举。","丹扆流念，鸿名式序。","中兴考室，永陈彝俎。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 歆和","佚名","四言",["崇禋已备，粢盛聿修。","洁诚斯展，钟石方遒。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 雍和二章 其一","张说","四言",["在涤嘉豢，丽碑敬牲。","角握之牡，色纯之骍。","火传阳燧，水溉阴精。","太公胖俎，傅说和羹。"],0,133,"唐"],["补周礼九夏系文   三","皮日休","四言",["出有龙旗，入有珩佩。","勿驱勿驰，惟慎惟戒。"],0,"x15","唐"],["补周礼九夏系文   三","皮日休","四言",["自筐及筥，我有牢醑。","自筐及篚，我有货币。"],0,"x15","唐"],["补周礼九夏系文   三","皮日休","四言",["王有掌讶，遉尔疆理。","王有掌客，馈尔饔饩。"],0,"x15","唐"],["补周礼九夏系文   三","皮日休","四言",["礼酒既罄，嘉宾既醒，雅为之行。"],0,"x15","唐"],["补周礼九夏系文","皮日休","四言",["㻏㻏衡笄，翚衣褕翟。","自内而祭，为君之则。"],0,"x15","唐"],null,["郊庙歌辞 封泰山乐章 肃和","张说","四言",["奠祖配天，承天享帝。","百灵咸秩，四海来祭。","植我苍璧，布我玄制。","华日裴回，神烟容裔。"],0,133,"唐"],["郊庙歌辞 五郊乐章 黄帝宫音","魏征","四言",["黄中正位，含章居贞。","既长六律，兼和五声。","毕陈万舞，乃荐斯牲。","神其下降，永祚休平。"],0,152,"唐"],["郊庙歌辞 享隐太子庙乐章 雍和","佚名","四言",["明典肃陈，神居邃启。","春伯联事，秋官相礼。","有来雍雍，登歌济济。","缅维主鬯，庶歆芳醴。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 昭感","佚名","四言",["铿锵韶濩，肃穆神容。","洪规赫赫，祠典雍雍。","已周三献，将乘六龙。","虔诚有托，恳志无从。"],0,"x14","唐"],["倬彼我系 其一","王勃","四言",["倬彼我系，出自有周。","分疆锡社，派别支流。","居衞仕宋，臣嬴相刘。","廼武廼文，或公或侯。"],0,239,"唐"],["倬彼我系 其二","王勃","四言",["晋历崩坼，衣冠扰弊。","粤自太原，播徂江澨。","礼丧贤隐，时屯道闭。","王室如毁，生人多殪。"],0,239,"唐"],["倬彼我系 其四","王勃","四言",["伊我祖德，思济九埏。","不常厥所，于兹五迁。","欲及时也，夫岂愿焉。","其位虽屈，其言则传。"],0,239,"唐"],["倬彼我系 其六","王勃","四言",["伊余小子，信慙明哲。","彼网有条，彼车有辙。","思屏人事，克终前烈。","于嗟代网，卒余来絏。"],0,239,"唐"],["倬彼我系 其七","王勃","四言",["来絏伊何，谓余曰仕。","我瞻先达，三十方起。","夫岂不怀，高山仰止。","愿言毓德，啜菽饮水。"],0,239,"唐"],null,["还丹歌 七","杨行真人","四言",["铅汞二阴，还丹之心。","相制不难，人迷不寻。","学者不见，徒费千金。","堪得指教，作福拯贫。","如斯之用，天人不嗔。","非道破除，天之大怒。","恶病加之，遭官刑狱。"],0,50,"唐"],["郊庙歌辞 祭汾阴乐章 雍和","贾曾","四言",["蠲我饎餴，絜我膋芗。","有豆孔硕，为羞既臧。","至诚无昧，精意惟芳。","神其醉止，欣欣乐康。"],0,159,"唐"],["还丹歌 九","杨行真人","四言",["丹砂丹砂，济命济家。","能济我命，能济我家。","能生姹女，嫁与黄芽。","事夫洁素，无喜无怒。","礼乐周旋，晨昏节度。","金亦可作，世亦可度。","作今不成，徒然自悮。"],0,50,"唐"],["郊庙歌辞 享太庙乐章 肃和","魏征","四言",["大哉至德，允兹明圣。","格于上下，聿遵诚敬。","嘉乐斯登，鸣球以咏。","神其降止，式隆景命。"],0,152,"唐"],["上古之什补亡训传十三章 左车二章之一 其二","顾况","四言",["左车有庆，万人犹病。","曷可去之，于党孔盛。","敏尔之生，胡为波迸。"],0,191,"唐"],["郊庙歌辞 祭[太]社乐章 肃和","褚亮","四言",["后土凝德，神功协契。","九域底平，两仪交际。","戊期应序，阴墉展币。","灵车少留，俯歆樽桂。"],0,150,"唐"],["上古之什补亡训传十三章 左车二章之二 其三","顾况","四言",["左车有赫，万人毒螫。","曷可去之，于党孔硕。","敏尔之生，胡为草戚。"],0,191,"唐"],["郊庙歌辞 享太庙乐章 保大舞","郭子仪","四言",["于穆文考，圣神昭章。","肃勺群慝，含光远方。","万物茂遂，九夷宾王。","愔愔云韶，德音不忘。"],0,201,"唐"],["还丹歌 十五","杨行真人","四言",["能知少女，必定还精。","能伏朱儿，必定坚贞。","金精石髓，是魂之灵。","能修者圣，能伏者灵。","鬼官不追，仙籍有名。","。"],0,50,"唐"],["郊庙歌辞 禅社首乐章 肃和","贺知章、源乾曜","四言",["黄祇是[祗]，我其夙夜。","寅畏诚絜，匪遑宁舍。","礼以琮玉，荐厥茅藉。","念兹降康，胡宁克暇。"],0,126,"唐"],["郊庙歌辞 五郊乐章 黑帝羽音 肃和","魏征","四言",["律回玉琯，星周金度。","次极阳乌，纪穷阴兔。","火林霰雪，阳泉凝冱。","八蜡已登，三农息务。"],0,152,"唐"],null,["郊庙歌辞 五郊乐章 黑帝羽音 雍和","魏征","四言",["阳月斯纪，应钟在候。","载洁牲牷，爰登俎豆。","既高既远，无声无臭。","静言格思，惟神保祐。"],0,152,"唐"],["郊庙歌辞 周朝飨乐章 治顺","佚名","四言",["庭陈大乐，作当太微。","凝旒负扆，端拱垂衣。","鸳鸾成列，簪组相辉。","御炉香散，郁郁霏霏。"],0,"x14","唐"],["上古之什补亡训传十三章","顾况","四言",["我行自东，山海其空。","旅棘有丛，我行自西。","垒与云齐，雨雪凄凄。","我行自南，烈火满林。","日中无禽，雾雨淫淫。","我行自北，烛龙寡色。"],0,191,"唐"],["郊庙歌辞 朝日乐章 送神","佚名","四言",["五齐兼酌，百羞具陈。","乐终广奏，礼毕崇禋。","明鉴万宇，照临兆人。","永流洪庆，式动曦轮。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 通和","佚名","四言",["祠容既毕，仙座爰兴。","停停凤举，霭霭云升。","长隆宝运，永锡休征。","福覃贻厥，恩被黎蒸。"],0,"x14","唐"],["郊庙歌辞  懿宗室舞","萧倣","四言",["圣祚无疆，庆传乐章。","金枝繁茂，玉叶延长。","海渎常[晏]，波涛不扬。","汪汪美化，垂范今王。"],0,180,"唐"],null,["郊庙歌辞 享文敬太子庙乐章 请神","许孟容","四言",["觞牢具品，管磬有节。","祝道夤恭，神仪昭晰。","桐圭早贵，象辂追设。","声达乐成，降歆丰洁。"],0,203,"唐"],["郊庙歌辞 昭德皇后庙乐章 雍和","佚名","四言",["我将我享，尽明而诚。","载芬黍稷，载涤牺牲。","懿矣元良，万邦以贞。","心乎爱敬，若覩容声。"],0,"x14","唐"],["郊庙歌辞 昭德皇后庙乐章 雍和","佚名","四言",["公尸既起，享礼载终。","称歌进彻，尽敬繇衷。","泽流惠下，大小咸同。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 文舞","张说","四言",["圣谟九德，真言五千。","庆集昌胄，符开帝先。","高文杖钺，克配彼天。","三宗握镜，六合涣然。","帝其承祀，率礼罔愆。","图书雾出，日月清悬。","舞形德类，咏谂功传。","黄龙蜿蟺，彩云蹁跹。","五行气顺，八佾风宣。","介此百禄，于皇万年。"],0,133,"唐"],["郊庙歌辞 五郊乐章 青帝角音 肃和","魏征","四言",["玄鸟司春，苍龙登岁。","节物变柳，光风转蕙。","瑶席降神，朱弦飨帝。","诚备祝嘏，礼殚珪币。"],0,152,"唐"],["郊庙歌辞 蜡百神乐章 雍和","佚名","四言",["缇籥劲序，玄英晚候。","姬蜡开仪，豳歌入奏。","蕙馥雕俎，兰芬玉酎。","大享明祇，永绥多祐。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 大和舞","张说","四言",["退居江水，郁起丹陵。","礼物还旧，朝章中兴。","龙图友及，骏命恭膺。","鸣球香瓒，大糦是承。"],0,133,"唐"],["郊庙歌辞 禅社首乐章 其三 肃和","贺知章","四言",["黄祇是祗，我其夙夜。","夤畏诚絜，匪遑宁舍。","礼以琮玉，荐厥茅藉。","念兹降康，胡宁克暇。"],0,210,"唐"],null,["补周礼九夏系文   二","皮日休","四言",["爣爣皎日，歘入于地。","厥晦厥贞，如王入焉。"],0,"x15","唐"],["补周礼九夏系文   二","皮日休","四言",["杳杳阴竹，坎坎路鼓。","我尸入矣，得神之祜。"],0,"x15","唐"],["补周礼九夏系文   二","皮日休","四言",["既醑既酢，爰朄爰舞。","象物既降，全乘之去。"],0,"x15","唐"],["补周礼九夏系文   二","皮日休","四言",["凤之愉愉，不篝不笯。","乐德而至，如宾之娱。"],0,"x15","唐"],["补周礼九夏系文   二","皮日休","四言",["王有虎臣，锡之圭瓒。","征彼不享，一烘而泮。"],0,"x15","唐"],["补周礼九夏系文   二","皮日休","四言",["厥流浩漾，厥势嵯峨。","今君之酌，慰我实多。"],0,"x15","唐"],["补周礼九夏系文   二","皮日休","四言",["礼酒既竭，嘉宾既悦，应为之节。"],0,"x15","唐"],["补周礼九夏系文   二","皮日休","四言",["桓桓其珪，衮衮其服。","入作三孤，国人是福。"],0,"x15","唐"],null,["郊庙歌辞 五郊乐章 赤帝徵音 雍和","魏征","四言",["昭昭丹陆，奕奕炎方。","礼陈牲币，乐备篪簧。","琼羞溢俎，玉醑浮觞。","恭惟正直，歆此馨香。"],0,152,"唐"],["郊庙歌辞 祀雨师乐章 迎俎酌献","包佶","四言",["阳开幽蛰，躬奉郁鬯。","礼备节应，震来灵降。","动植求声，飞沈允望。","时康气茂，惟神之贶。"],0,30,"唐"],["郊庙歌辞 享太庙乐章 光大舞","佚名","四言",["大业龙祉，徽音骏尊。","潜居皇德，赫嗣天昆。","展仪宗祖，重诚孝孙。","春秋无极，享奏存存。"],0,"x14","唐"],null,null,["郊庙歌辞 五郊乐章 白帝商音 雍和","魏征","四言",["律应西成，气躔南吕。","珪币咸列，笙竽备举。","苾苾兰羞，芬芬桂醑。","式资宴贶，用调霜序。"],0,152,"唐"],null,["郊庙歌辞 祀风师乐章 迎神","包佶","四言",["太皞御气，句芒肇功。","苍龙青旗，爰候祥风。","律以和应，神以感通。","鼎俎修蚃，时惟礼崇。"],0,30,"唐"],["乐府杂曲 鼓吹铙歌曲十二篇 其九 靖本邦","柳宗元","四言",["本邦伊晋，惟时不靖。","根柢之摇，枝叶攸病。","守臣不任，勚于神圣。","惟钺之兴，翦焉则定。","洪惟我理，式和以敬。","群顽既夷，庶绩咸正。","皇谟载大，惟人之庆。"],0,143,"唐"],["五郊乐章 赤帝徵音 雍和","魏征","四言",["昭昭丹陆，帟帟炎方。","礼陈牲币，乐备箎簧。","琼羞溢俎，玉𨠨浮觞。","恭惟正直，歆此馨香。"],0,152,"唐"],["咏方圆动静","李泌","四言",["方如行义，圆如用智。","动如逞才，静如遂意。"],0,172,"唐"],["郊庙歌辞 祀雨师乐章 迎神","包佶","四言",["陟降左右，诚达幽圜。","作解之功，乐惟有年。","云𫐌戾止，洒雾飘烟。","惟馨展礼，爰列豆笾。"],0,30,"唐"],null,null,null,["倬彼我系 其八","王勃","四言",["有鸟反哺，其声嗷嗷。","言念旧德，忧心忉忉。","今我不养，岁月其滔。","僶俛从役，岂敢告劳。"],0,239,"唐"],null,["倬彼我系 其三","王勃","四言",["伊我有器，思逢其主。","自东施西，择木开宇。","田彼河曲，家乎汾浦。","天未厌乱，吾将谁辅。"],0,239,"唐"],["郊庙歌辞 明皇祀圜丘乐章 雍和","佚名","四言",["烂云普洽，律风无外。","千品其凝，九宾斯会。","禋尊晋烛，纯牺涤汰。","玄覆攸广，鸿休汪濊。"],0,"x14","唐"],["江有枫一篇十章 三","萧颖士","四言",["想彼槭矣，亦类其枫。","矧伊怀人，而忘其东。"],0,199,"唐"],["郊庙歌辞 享先农乐章 雍和","褚亮","四言",["前夕视牲，质明奉俎。","沐芳整弁，其仪式序。","盛礼毕陈，嘉乐备举。","歆我懿德，非馨稷黍。"],0,150,"唐"],["江有枫一篇十章 九","萧颖士","四言",["有鸟有鸟，粤鸥与鹭。","浮湍戏渚，皓然洁素。","忘其猜妒，彼何人斯，曾足伤惧。"],0,199,"唐"],["江有枫一篇十章 六","萧颖士","四言",["我朋在矣，彼陆之子。","如松如杞，淑问不已。"],0,199,"唐"],["郊庙歌辞 仪坤庙乐章 寿和","徐坚","四言",["于穆清庙，肃雍严祀。","合福受厘，介以繁祉。"],0,247,"唐"],["倬彼我系 其九","王勃","四言",["从役伊何，薄求卑位。","告劳伊何，来参卿事。","名存实爽，负信愆义。","静言遐思，中心是愧。"],0,239,"唐"],null,["祭汾阴乐章","贾曾","四言",["蠲我渐饎，洁我膋芗。","有豆孔硕，为羞既臧。","至城无昧，精意惟芳。","神其醉止，欣欣乐康。"],0,159,"唐"],["补乐歌十首  一","元结","四言",["猗太帝兮，其智如神。","分草实兮，济我生人。"],0,63,"唐"],["郊庙歌辞 仪坤庙乐章 金奏","佚名","四言",["阴灵曜祉，轩曜降精。","祥符淑气，庆集柔明。","瑶俎既列，雕桐发声。","徽猷永远，比德皇英。"],0,"x14","唐"],["判行营将士申请裹粮","宋光嗣","四言",["才请冬赐，又给行装。","汉州咫尺，要甚裹粮？","绵州物贱，直到益昌。"],0,187,"唐"],["郊庙歌辞 祭汾阴乐章 寿和","苏颋","四言",["礼物斯具，乐章乃陈。","谁其作主，皇考圣真。","对越在天，圣明佐神。","窅然汾上，厚泽如春。"],0,238,"唐"],["江有枫一篇十章 十","萧颖士","四言",["此惧惟何，惧寘于罗。","彼骄者子，谗言孔多。","我闻先师，体命委和。","公伯之愬，则如予何。","怅然山河，惟以啸歌，其忧也哉。"],0,199,"唐"],["郊庙歌辞 祭神州乐章 雍和","褚亮","四言",["泰折严享，阴郊展敬。","礼以导神，乐以和性。","黝牲在列，黄琮俯暎。","九土既平，万邦贻庆。"],0,150,"唐"]]