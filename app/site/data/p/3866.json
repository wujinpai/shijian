[null,null,null,["菩萨蛮 送友戏拟稼轩体","金启孮","词",["前程已过临漳水。","客中几点行人泪。","书剑挂雕鞍。","夕阳无限山。","长亭留不住。","比较萧然去。","鸿雁一时疏。","闲听金鹧鸪。","昨宵梦境萧萧去。","沉思枕畔愁千缕。","紫陌系骅骝。","依然万户侯。","倚栏闲对月。","相偎说离别。","醒后陋椽遮。","恒河几点沙。","河桥凉月浑如昨。","故人已是长飘泊。","相忆不能眠。","西窗欲曙天。","五更鸡唱冷。","残烛摇疏影。","端的负今生。","今生太薄情。","秋风小院初弦月。","紫姑那观经年别。","谁解忆长安。","空怜玉露寒。","当年低语唤。","半晌红绡畔。","端的为谁娇。","睡残双凤翘。","春风春雨消春昼。","镜中乍觉容颜瘦。","春色满汀洲。","泪珠缘颊流。","醒来孤枕梦。","愁压薄衾重。","缺月下杨枝。","铜盘烛尽时。","夜来乍畏重衾薄。","困眠无奈三更角。","惊起愁压肩。","遣书和泪看。","红颜终是老。","且把愁容扫。","休负好春天。","陌间花正繁。"],0,133,"近现代"],null,null,null,["好事近 芒种","金启孮","词",["雨后又微风，满地碎阴凉月。","枉把好春辜负，到杜鹃啼血。","年年日日总相思，况复辞花节。","本欲一尘不染，奈闲情纠葛。","别后总相思，博得心魂零落。","盼到关山重见，似故人情薄。","忆昔同剪西窗烛，话竟三更角。","多少风霜冷暖，慰问情萧索。"],0,133,"近现代"],null,["鹧鸪天 题三弟茂深《秋雨阁诗稿》","金启孮","词",["过去韶光不可看。","唯将辞赋写辛酸。","茅斋剩却窗前月，陋巷空余雨后烟。","诗乍就，泪初干。","东坡子由至今传。","让他黄九秦七妒，留得千年与万年。","小院黄昏半掩门。","绿阴深处敛夕棔。","空庭雨过蛙声闹，陋室灯昏鸟语频。","心愔愔，睡昏昏。","闲阶花落净无尘。","人生风月能多少，已是匆匆廿二春。","参透方能见假真。","不将浮念系吾心。","情根慧业原无异，贝叶莲花自有分。","灯暗淡，气氛氲。","拈香顶礼磬声频。","善缘佛豆菩提子，十字街头到处寻。"],0,133,"近现代"],["蝶恋花 同前","金启孮","词",["碧甃风铃萧寺路。","贝叶莲花，在在足千古。","何必暗香深处住。","虔心自把檀香炷。","正是陌头飘落絮。","休忆当年，月下叮咛语。","一刻抛残千万绪。","佛灯初上黄昏雨。","最恨无情天上月。","不照团𪢮，偏照人诀别。","多少衷肠和泪说。","叮咛唯恐音书绝。","古道茫茫愁暗结。","那堪巂周，促得归思切。","尺素欲封还又折。","五更茅店鸡声咽。"],0,133,"近现代"],["浣溪沙 过芸公府","金启孮","词",["莫向儿时忆岁华。","鸡鸣枕上病相加。","每经旧宅怕停车。","紫陌荒凉堆败叶，宫门萧索落槐花。","不知今是阿谁家。","草市梢头柳絮飞。","柳庄深处杏花稀。","东风古寺伴余晖。","燕子不来禅院静，鹧鸪初到篆烟微。","碧苔石磴雨霏霏。"],0,133,"近现代"],null,null,["浣溪沙 六连岛","金启孮","词",["翠嶂迎人暗不明。","梦魂忽觉一身轻。","细风斜雨客边情。","暮色乍添残照外，晚云忽傍远山横。","就中无以慰今生。","渔市风吹大鼓声。","黄昏萧寺鉴微诚。","廿年往事太懵腾。","清水一瓢堪净我，梵香三炷达神明。","不知何以慰今生。","央及东风且莫狂。","暂容双燕宿雕梁。","一春能几好韶光。","细雨打窗灯影背，红烛烧残暗神伤。","人生何事太凄凉。","古刹唐门壁四围。","黄昏檐际蝠飞飞。","夕风吹彻殿铃微。","欲访阿七何处是，乱碑斜矗径都迷。","人生无事不唏吁。","绿芜丛中细路分。","似曾相识鹿依人。","朝参礼罢篆香薰。","古木蔽天疑绝峪，新芳盈目类繁频。","不成欢乐转逡巡。","释道真宗说日莲。","半山风雨晚秋天。","夕阳钹鼓费留连。","灵骨岂能知休咎，樱苞翻似道无边。","顶香击掌意绵绵。"],0,133,"近现代"],null,["菩萨蛮 齐齐哈尔客舍","金启孮","词",["诺尼江畔惊秋早。","卜魁城里秋将老。","孤馆一灯明。","夜寒听雨声。","更深还淅沥。","枕侧檐流急。","明日进榆关。","客心愁未阑。","故乡何事劳相忆。","枝头又见春消息。","岁月易蹉跎。","恼人情绪多。","幽燕成阻隔。","梦绕蠕蠕塞。","纵得梦还家。","落残桃杏花。","荒原一片沉沉白。","蟾蜍乍升榆林塞。","才隐暮云端。","便觉风露寒。","经年长做客。","羁旅颜非昨。","极目又平沙。","明朝可到家。","嵯峨一丈阴山雪。","凄凄拂晓黑河月。","何处是家乡。","枕边幽梦长。","梦长留不住。","又逐金风去。","路远故人疏。","近来音信无。"],0,133,"近现代"],["浣溪沙 乌梁素海","金启孮","词",["一叶扁舟港路长。","菰蒲夹岸泛清香。","水禽递唱韵悠扬。","涟漪如绫拂短舷，温风似酒动轻裳。","海天一色际难量。","抛却无端理钓矶。","乌梁素海雨霏霏。","闲看燕子拂船飞。","近水渔乡堪入画，远天云破又横霓。","苇梢凉气扑人衣。"],0,133,"近现代"],null,null,null,null,null,null,["清平乐 再题香南卷子","赵尊岳","词",["莺嗔燕妒。","斜日波云路。","一笑匆匆心暗许。","回首缤纷花雨。","安排凤管鸾笺。","消魂碧海青天。","梦里不成相忆，春风珍重幺弦。","帘波侬汝。","莫放春归去。","唱澈吴云天尺五。","认取旧时钿柱。","少年鸲鹆心情。","护花乞与金铃。","梦到红罗亭子，归来斜月残檠。"],0,"x236","近现代"],null,null,null,["清平乐 瘿公属再继声前调","赵尊岳","词",["霜清逾艳。","粉试芙蓉面。","柳眼于人青未减。","此际多情多感。","秋山瘦更生姿。","秋云淡更相思。","秋水伊人玉雪，秋声都付新词。","黄花开又。","可可东篱秀。","正是重阳佳节后。","容易相逢卮酒。","夕张珍重佳期。","秋心诉与骚词。","绝世珠歌翠舞，个侬玉骨冰姿。","蓉清菊瘦。","风景萸觞后。","蓦地玉山光照酒。","却见灵和春柳。","高梧谁慰幽栖。","芳梅近惜分携。","大好秋容罨画，可无门外斑骓。","愿为翠羽。","梦逐南枝去。","风度萼华应念取。","清燕叨陪俊侣。","玲珑碧藕心肠。","娉婷玉笋班行。","一席香南分占，宝镫传出明妆。","露华金井。","最忆王孙影。","玉拨金笼亲手整。","促织声中漏永。","开天影事曾谙。","半闲风味谁耽。","凉夜水纹衫子，吟情赚煞陈髯。","棋消昼永。","玉鸭添香饼。","日转花梢云弄影。","韵事霜簃绝胜。","何妨劫急偏迟。","沉吟几费琼思。","桑海付他柯烂，尽教吹皱春池。","吴笺小砑。","清课茸窗下。","早擅簪花时誉也。","犹是卫恒未嫁。","摩挲晋石唐碑。","安排象管乌丝。","我愧瘦金家法，拈毫特地矜持。","缟衣仙侣。","相约瑶京住。","豆记银屏光订误。","那许周郎轻顾。","坐风缀玉轩窗。","妍秾桃李门墙。","按谱九宫南北，真成旧学商量。","新腔甫试。","婉转成娟媚。","乍破银屏倾碧水。","簌簌梁尘飞坠。","遥空几驻行云。","妙香兰麝微唯。","最是啭喉入破，隔花怕有莺嗔。","诗篇甲乙。","湖海萧骚客。","金谱丝阑新按拍。","节鼓花前协律。","最怜秋士平生。","者般玉艳霜清。","乡国招郎才调，护花甘作金铃。","家丞秋实。","艳是才人笔。","比玉生香霜有色。","学得琼芳高格。","兰荃不尽余情。","风怀总付秦筝。","说似狂奴心性，尊前最惜娉婷。","师雄陈迹。","几向罗浮觅。","别有梦中春笑赤。","相见似曾相识。","珠喉掩抑丝簧。","绣罗渲染新妆。","群玉山头伫立，灵修回首前芳。"],0,"x236","近现代"],null,null,["蝶恋花 和六一词","赵尊岳","词",["丝雨弄晴寒尚峭。","燕子呢喃，说与春迟早。","依约含苞娇杏小。","红情已妒新妆巧。","才玩赪鳞浮碧藻。","尺素难传，翻被多情恼。","见说春光晴最好。","无端惆怅啼莺晓。","廉纤雨作消寒阵。","百宝阑前，已茁兰芽嫩。","𣨼酒花扶人易困。","脸霞渐渐红生晕。","弦柱华年催转瞬。","付与瞢腾，无复前方寸。","醉眼天涯迷远近。","番风输与相思信。","玉梅犹似年时绽。","娥月多情，来傍花阴转。","粉蕊琼枝齐照眼。","妍风刬地香云乱。","倦理秦筝银甲缓。","愁到而今，一任花深浅。","梦里不知魂欲断。","红裳翠羽分明见。","一抹粉云生碧栋。","拂槛风柔，想见帘波动。","嫞理残妆鬟翠重。","不成春睡和衣拥。","罗胜合欢钗亸凤。","商略眉图，犹记菱花共。","迟日茜窗残月弄。","流光消得年时梦。","斜空珠帘风荡漾。","燕燕衔泥，辛苦频来往。","著意纤纤金缕放。","腰肢似汝堪惆怅。","倦拂云屏翻翠浪。","一角屏山，花路空相向。","看取游丝萦画幌。","愁痕恰到眉梢上。","帘外斜阳低碧树。","帘底炉熏，销尽沈馢缕。","缕缕丝丝萦雁柱。","东风恰向天涯去。","分付残花帘坠絮。","休向池塘，点点和烟雨。","{氵皱}尽文漪谁共语。","杜鹃啼到花深处。","彷佛青溪邀笛步。","满目烟芜，空袅晴丝暮。","大好韶光留客住。","更从何处寻春去。","云外片帆轻不度。","已忍年时，携手临歧语。","问讯垂杨无意绪。","年年绿遍啼莺处。","玉树交柯栖乳燕。","尽意呢喃，钩起情撩乱。","山远眉长人不见。","梨云梦冷闲庭院。","镇日思量千百遍。","已拌春深，瘦损如花面。","倦倚阑干多别怨。","音书也似回肠断。","燕燕留春春未许。","九十韶光，能几番风数。","拾翠归来惆怅处。","将离开到长亭路。","寂寞空庭烟景暮。","花卜归期，花肯留人住。","写遍吴笺无好语。","柳绵更被风吹去。","记得青墩牵画舫。","春水情深，芳约横塘上。","风暖日斜翻翠浪。","乱红著意随双桨。","巧啭莺吭回踏唱。","剪绿裁红，骅骝纷相向。","玉斝莫辞斟碧酿。","此情休待成惆怅。","画槛临春杨柳畔。","倚立凝情，亸袖双金钏。","隐约眉颦呈粉面。","谁知此际情深浅。","开到荼蘼春又晚。","绣线琴丝，算是茸窗伴。","梦里蓬山知近远。","柔情似水浑无岸。","翠罨菱花花叠浪。","接叶交柯，弄影妆台上。","更帖花钿迟一向。","眉痕欲斗山鬟样。","道是缃桃犹未放。","强起临鸾，著意生惆怅。","得似玉奁春荡漾。","婵娟千里曾相望。","向晓帘栊寒未歇。","宝鸭浓熏，消得情深切。","残角疏砧都听彻。","梦回苦忆年时别。","玉漏三商肠百结。","拌醉和衣，随分孤芬节。","万绪千愁谁与说。","照人犹有西楼月。","柳拂横塘金缕细。","刬地蘼芜，春已无边际。","写入屏山图画里。","妍秾得似人中意。","载榼归来扶浅醉。","蝶趁蜂随，珍重余情味。","倒尽金尊君莫悔。","有花无酒真憔悴。","绿袖翾翩回绮宴。","画烛摇红，映掩新妆面。","粉簌行云珠一串。","媚香飞越流霞盏。","何事新声生别怨。","纵赋同心，聚了还愁散。","寒到被池惊梦惯。","也须怜人肠断。","偻指花风知别久。","检点腰围，非复年时旧。","记得长亭斟别酒。","一春已拌思君瘦。","碧映帘栊新舞柳。","深浅情怀，随分年年有。","泪墨千行携满袖。","回环不尽书成后。","软绣大堤春满目。","堤上游丝，舞絮纷相逐。","俊侣联镳催辘辘。","朱轮碾地蘼芜绿。","未许骢嘶归太促。","宛款啼莺，花外商量足。","十里芳郊程断续。","高楼唱彻吴娘曲。","{互/水}曲回阑朱字亚。","阑外遥山，掩映斜阳下。","飞羽传觞犹未罢。","新蟾已向林梢挂。","眼底韶光难暂舍。","烟景清和，远近都宜画。","莫遣柳绵飞尽也。","东风门巷乌衣谢。","燕燕衔泥芳径去。","尽意蹁跹，不管春迟暮。","辛苦天涯芳草路。","绿梅已换缃桃树。","藻井呢喃千万语。","伫尽斜阳，有识人愁否。","苦恨香泥粘弱絮。","絮飞前度经行处。","晴日帘栊风细细。","嚼玉吹香，更惜红英坠。","香篆茶声撩午睡。","醒来闲倚鸳鸯被。","契阔情怀经岁岁。","鱼雁无凭，多事征邮违。","莫道相思无可寄。","襟痕看取伤离泪。","杏雨新晴春婉娩。","柳外高楼，楼外花深浅。","又是蔷薇香一院。","如何春在人难见。","云影迷离花影乱。","极目遥天，不到江南岸。","廿四番风容易换。","天涯付与骢嘶断。","乍暖还寒春意早。","载榼寻芳，香径啼莺小。","万一流光轻负了。","少年能否年年少。","不解酬春应自笑。","飞絮飞花，犹有晴丝绕。","未必蓬山无梦到。","逢花且拌新刍倒。"],0,"x236","近现代"],null,null,["归国谣 和飞卿","赵尊岳","词",["雕玉。","静押垂帘春簌簌。","绛纱波荡银粟。","一天侵晚绿。","梦回泪凝桦烛。","枕机欢意促。","共谁重理箫曲。","漏深嫌断续。","娇脸。","彩秀象奁分琰艳。","背人眉角微敛。","面霞红缬染。","曼吟小唇先掩。","更频拈瑶簟。","烛花交映春靥。","数残更几点。"],0,"x236","近现代"],["女冠子 和韦庄","赵尊岳","词",["记得七七，阆苑蕙风晴日，绽枝时。","斗艳花融脸，分娇柳妒眉。","绝怜春畹晚，偏拟蝶追随。","香入罗裙褶，瘦腰知。","梦里酒半，倩影依稀频见，泥人时。","樱熟朱沾吻，山遥黛约眉。","乍醒知有泪，别去恨无依。","听残更漏滴，一寻思。"],0,"x236","近现代"],["采桑子 和阳春","赵尊岳","词",["一春未解桐花冻，寒𣨼吴绵。","惆怅吟边。","倚尽阑干。","落照悬。","秾春须不教轻负，芳草连天。","拼醉花前。","今日为君泛玉船。","风前嫩箨抽新竹，料量畦丁。","看取春生。","翠葆红缨渐长成。","闲寻诗思重来处，怕倚猩屏。","■■■■。","惊起黄鹂恰一声。"],0,"x236","近现代"],["临江仙 和阳春","赵尊岳","词",["布帆烟树隋堤路，望中一片云深。","几回搔首雁书沉。","别离千万缕，空遣柳摇金。","绿波荡尽文纱影，催醒还怯鸣禽。","天涯惜起倚阑心。","梦余残照，空翠湿衣襟。","雾裾瑶縠催琼驾，胜他玉骨珊珊。","清秋风露不知寒。","多情眉子月，歧路照长干。","七襄锦字成虚约，愁怀难托天孙。","凝情无绪对痴云。","凉柯如水，柔绿梦镫昏。","娇姿嫞起临鸾镜，芙蓉浅映澄漪。","绕楼犹著柳丝垂。","窥人无限意，青眼最芳时。","禊春记取当年事，花前携榼听鹂。","至今惟梦可寻追。","微风吹面，重复引离思。"],0,"x236","近现代"],["虞美人 和后主","赵尊岳","词",["荼蘼一架才开了。","便觉春光少。","游丝几度袅东风。","更逐残英，飞舞小庭中。","雏莺乳燕寻常在。","转烛年华改。","声声你不断离愁。","绿绮窗前惊醒梦如流。","湘弦润湿苔侵绿。","春雨相连续。","玉阑孤倚悄无言。","看尽浮花，浪蕊送华年。","回头挂壁银筝在。","手涩调新解。","无声过泛最情深。","为问满怀，幽怨可能任。"],0,"x236","近现代"],["望江南 和后主","赵尊岳","词",["端正好，时节恰秾春。","箫鼓隔堤催画鹢，镜漪落照罨芳尘。","犹有未归人。","端正好，风露下新秋。","脸色荷花相逞艳，轻拂垂柳看行舟。","脉脉水西楼。","无限恨，消领绣帏中。","轻梦已随兰麝散，五更和泪咽铜龙。","侵晓怯微风。","伤往事，人倦独支颐。","坐久重楼都入望，画阑犹倚玉箫吹。","将信更还疑。"],0,"x236","近现代"],null,["鹧鸪天 柝津归途，示双侃向仲坚","赵尊岳","词",["抵死催人禁漏清。","夜残星斗已三更。","明朝容易金鞍去，芳草天涯又一程。","归梦促，别情深。","临歧无泪祇吞声。","落花许向春边住，画里流莺子细听。","细草黄尘饯腊残。","香醪玉黍倚留筵。","何堪惜别三分逝，纵许重来一惘然。","清禁月，御炉烟。","梦回天上又人间。","不辞身作堂前燕，岁岁南云自往还。"],0,"x236","近现代"],["鹧鸪天 汤尔和属题六松图卷，时北方兵警正亟","赵尊岳","词",["一片斜阳落浅芜。","青山故国两模糊。","耕烟无计栽瑶草，傲雪余情酬玉壶。","涛翠涨，影虬拿。","六龙偃蹇似诗癯。","贞心聱叟堪招隐，漱石凌云托画图。","茧纸斑斑带泪痕。","封套谡谡也声吞。","盘根甫里疑无地，放叶思翁总露根。","吟北渚，唱西昆。","冬青短引共消魂。","欲教唤起云龙动，酬取丹霄翠崿思。"],0,"x236","近现代"],["鹧鸪天 庚辰十一月朔日仿遗山宫体八首","赵尊岳","词",["啼鴂西川未忍闻。","劫余残梦付残春。","玉窗绰约迷沉水，金殿葱笼唱遏云。","凭断梗，𣨼斜曛。","繁弦似诉最怜君。","无情一往千秋恨，元朔龙蛇叹不辰。","坠絮无端滞翠苔。","骄花紫陌伫重开。","十年驹隙随波逝，九锡蓬瀛赉使来。","愁对酒，忍倾杯。","钿盟镜约几低回。","信能挽得银河转，皂帽黄尘亦可哀。","匼匝珠帘绕禁楼。","遥听桴鼓间清讴。","孽龙渡海催前奏，天马腾空驻上游。","开玉镜，敛吴钩。","啼妆粉靥学风流。","真灵位业神仙侣，不分虞宾比列侯。","锦字回文子细看。","玉愁花笑怎为欢。","凤凰闲里排宵宴，宁远楼前问早安。","笺泪墨，玺书丹。","许凭带砺誓河山。","都俞别有伤心在，强和嵩呼一展颜。","凭遍危阑一角红。","便愁风雨葬吴宫。","三生花草蓬山外，满地江湖落照中。","藁馆启，苇航通。","金缯乞与护珍丛。","云笺纵抵关山近，不信瑶珰系断鸿。","谁道筹添海可桑。","仙家随分话兴亡。","沉灰入地难回劫，弱水中流不载航。","金屈戌，玉钗梁。","梦回峨冠试明妆。","花开记取韶光好，驻景犹难觅上方。","贝阙珠宫弟几层。","玉堂雅致见天真。","镫前绣佛清堪供，画里疏梅淡亦春。","词宛转，步逡巡。","遍翻芸笈校灵文。","葳蕤好写东皇帖，切莫沾泥误锦茵。","燕寝香凝酒未干。","绮疏春殿伫团𪢮。","赚他比翼通鹣?，负我重衾梦触蛮。","消誓海，说盟山。","不知是玦尚为环。","环连玦绝他生事，斜倚熏笼掩袂看。"],0,"x236","近现代"],["思嘉客 晚过虎邱而无锡而家园，信拈清课","赵尊岳","词",["已拌残曛恋故枝。","漫随流水送芳时。","青山掠影浑疑醉，白鹭亲人为底痴。","眉妒月，柳如丝。","旧情历历彩云知。","塔痕渐稳铃声远，听到无声别有思。","绿树阴浓匝地闲。","故园环水复环山。","云边夺雨生新霁，塔畔鸣铃唤暮寒。","愁蜡屐，过乡关。","劫余父老尽潸然。","生平誓墓情何及，饮恨孤儿梦里还。"],0,"x236","近现代"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["定风波 拟白石","赵尊岳","词",["柳陌桃蹊未易寻。","梦回霜鬓已骎骎。","万水千山行更远。","肠断。","朱楼一桁换晴阴。","眉月几余清泪赚，菱花拍著暗尘侵。","莫道人间离别久。","终有。","天吴紫凤证盟深。","别久春归两不胜。","海天梦雨湿疏棂。","祇待消愁拌剧醉。","无寐。","漏长苦更对青灯。","颦笑盘龙应似旧，音书孤雁竟无凭。","相见几时休更问。","空剩。","夜涛寂寞撼愁城。"],0,"x236","近现代"],null,null,null,null,null,["浣溪沙 壬寅九月十六夜作","赵尊岳","词",["蝶僽蜂僝两不胜。","窗窥户罥几逡巡。","游丝缕缕太关情。","昨日寻盟盟碧海，他年有梦梦倾城。","相思树下数残灯。","鹃血斑斑点玉簪。","帕罗封泪剩哀吟。","纵无风雨亦春深。","万劫沾泥终不悔，千秋密誓待重寻。","昨宵圆月照街心。","说去应难住亦难。","夜深风露袭衣单。","一帘明月并肩看。","细字泪珠溅纸茧，瑶奁黛墨伴钗鸾。","三生证取耐清寒。","真把闲愁付与伊。","空巢心事许天知。","隔帘怕见乱花飞。","密意已酬盟翠钿，佳辰莫道缓金卮。","占他横幅是南枝。"],0,"x236","近现代"],["菩萨蛮 病榻不寐","赵尊岳","词",["秋宵一雨清如洗。","轻衾微觉生寒气。","皓月透窗明。","怀归梦不成。","鸡声初破晓。","云罨疏林杪。","坐起看遥山。","残灯映镜鬟。","盈盈花雾侵帘轴。","筠蓝渐遣开金菽。","夕照泛疏棂。","雏蜂趱落英。","几回人倦倚。","独对苍茫际。","叫破一声声。","长空归雁鸣。"],0,"x236","近现代"],["鹧鸪天 赠瞿禅","徐震堮","词",["有客相从寂寞滨。","书堂遥忆谢家邻。","新词漫遣供惆怅，矮屋犹堪一欠伸。","歌抑塞，酒逡巡。","未妨高卧北山云。","龙蛇影里钩帘坐，不染西风庾亮尘。","几度春归在客先。","不离西阁又经年。","百金未买东屯宅，十亩曾无下噀田。","愁瓠落，酒蝉连。","扁舟心事堕风烟。","松涛一枕城南路，著我高楼听雨眠。"],0,136,"近现代"],null,["金缕曲 哭王敬老","徐震堮","词",["屡负携筇约，怪连旬馀寒犹凝，东风又恶。","待得池塘生春草，已是阶翻红药。","矧转眼黄垆邈若。","从此停云无好句，闭东轩对影成孤酌。","醒与醉，总非昨。","百年可有藏舟壑。","都一笑彭夭殇寿，孔忧颜乐。","白石清泉今已矣，盼煞乌头马角。","休指点山川城郭。","身似淮王旧鸡犬，甚无端化作归来鹤。","存殁感，付寥廓。","不见墙东老，似成连刺船径去，水波浩渺。","十丈珊瑚映天紫，下有任公坐钓。","我亦欲东还海道。","指点楼台云气外，奈船风引去无由到。","为君鼓，水仙操。","钧天一梦胡然觉。","猛回头狖啼花落，山回云抱。","独自跰?来鉴井，依旧胶胶扰扰。","倘今夜月明瑶岛。","俯视齐州烟九点，惹洪崖拍手灵妃笑。","书一纸，寄青鸟。"],0,136,"近现代"]]