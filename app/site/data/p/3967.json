[["东昏侯时宫中谣","佚名","隋",["赵鬼食鸭肃刂。","诸鬼尽著调。"],{"ad":"隋"},"x239","隋"],["时人为桓康语","佚名","隋",["欲侜张。","问桓康。"],{"ad":"隋"},"x239","隋"],["荀伯玉闻青衣小儿语","佚名","隋",["草中肃。","九五相追逐。"],{"ad":"隋"},"x239","隋"],["时人为荀伯玉语","佚名","隋",["十敕五令。","不如荀伯玉命。"],{"ad":"隋"},"x239","隋"],["时人为萧晃语","佚名","隋",["焕焕萧四伞。"],{"ad":"隋"},"x239","隋"],["时人为刘绘语","佚名","隋",["刘绘贴宅，别开一门。"],{"ad":"隋"},"x239","隋"],["时人为张周刘三姓语","佚名","隋",["三人共宅夹清漳。","张南周北刘中央。"],{"ad":"隋"},"x239","隋"],["时人为沈麟士语","佚名","隋",["吴差山中有贤士。","开门教授居成市。"],{"ad":"隋"},"x239","隋"],["南州为江革语","佚名","隋",["故人不道智，新人佞散骑。","莫知度不度，新人不如故。"],{"ad":"隋"},"x239","隋"],["都下民语","佚名","隋",["欲求贵职依刀敕。","须得富豪事御力。"],{"ad":"隋"},"x239","隋"],["共戏乐 其一","佚名","隋",["齐世方昌书轨同。","万宇献乐列国风。"],{"ad":"隋"},"x239","隋"],["共戏乐 其二","佚名","隋",["时泰民康人物盛。","腰鼓铃柈各相竞。"],{"ad":"隋"},"x239","隋"],["共戏乐 其三","佚名","隋",["长袖翩翩若鸿惊。","纤腰袅袅会人情。"],{"ad":"隋"},"x239","隋"],["共戏乐 其四","佚名","隋",["观风采乐德化昌。","圣皇万寿乐未央。"],{"ad":"隋"},"x239","隋"],["杨叛儿 其一","佚名","隋",["截玉作手钩，七宝光平天。","绣沓织成带，严帐信可怜。"],{"ad":"隋"},"x239","隋"],["杨叛儿 其三","佚名","隋",["送郎乘艇子，不作遭风虑。","横篙掷去桨，愿倒逐流去。"],{"ad":"隋"},"x239","隋"],["杨叛儿 其四","佚名","隋",["七宝珠络鼓，教郎拍复拍。","黄牛细犊儿，杨柳映松柏。"],{"ad":"隋"},"x239","隋"],["杨叛儿 其五","佚名","隋",["欢欲见莲时，移湖安屋里。","芙蓉绕床生，眠卧抱莲子。"],{"ad":"隋"},"x239","隋"],["杨叛儿 其六","佚名","隋",["闻欢远行去。","送欢至新亭。","津逻无侬名。"],{"ad":"隋"},"x239","隋"],["杨叛儿 其七","佚名","隋",["落秦中庭生，诚知非好草。","龙头相钩连，见枝如欲绕。"],{"ad":"隋"},"x239","隋"],["杨叛儿 其八","佚名","隋",["杨叛西随曲，柳花经东阴。","风流随远近，飘扬闷侬心。"],{"ad":"隋"},"x239","隋"],["乐辞","佚名","隋",["绣幕围香风。","耳节朱丝桐。","不知理何事。","浅立经营中。","爱惜加穷裤。","防闲托守宫。","今日牛羊上丘陇。","当年近前面发红。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其一 肃咸乐谢超宗","佚名","隋",["夤承宝命，严恭帝绪。","奄受敷锡，升中拓宇。","亘地称皇，罄天作主。","月域来宾，日际奉土。","开元首正，礼交乐举。","六典联事，九官列序。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其二 引牲乐","佚名","隋",["皇乎敬矣，恭事上灵。","昭教国祀，肃肃明明。","有牲有涤，有洁在俎。","以荐王衷，以答神祜。","陟配在京，降德在民。","奔精望夜，高燎伫晨。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其三 嘉荐乐","佚名","隋",["我恭我享，惟孟之春。","以孝以敬，立我烝民。","青坛奄霭，翠幕端凝。","嘉俎重荐，兼籍再升。","设业设虡，展容玉庭。","肇禋配祀，克对上灵。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其四 昭夏乐","佚名","隋",["惟圣飨帝，惟孝飨亲。","礼行宗祀，敬达郊禋。","金枝中树，广乐四陈。","月御案节，星驱扶轮。","遥光远驾，曜曜振振。","告成大报，受厘元神。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其五 永至乐","佚名","隋",["紫坛望灵，翠幕伫神。","率天奉贽，罄地来宾。","神贶并介，泯祗合祉。","恭昭鉴享，肃光孝祀。","威蔼四灵，洞曜三光。","皇德全被，大礼流昌。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其六 登歌","佚名","隋",["报惟事天，祭实尊灵。","史正嘉兆，神宅崇祯。","五畤昭鬯，六宗彝序。","介丘望尘，皇轩肃举。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其八 武德宣烈乐","佚名","隋",["功烛上宙，德耀中天。","风移九域，礼饰八埏。","四灵晨炳，五纬宵明。","膺历缔运，道茂前声。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其九 高德宣烈乐王俭","佚名","隋",["飨帝严亲，则天光大。","舄奕前古，荣镜无外。","日月宣华，卿云流霭。","五汉同休，六幽咸泰。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其十 嘉胙乐谢超宗","佚名","隋",["鬯嘉礼。","承休锡。","盛德符景纬。","昌华应帝策。","圣蔼耀昌基。","融祉晖世历。","声正涵月轨。","书文同日迹。","宝瑞昭神图。","灵贶流瑞液。","我皇崇晖祚。","重芬冠往籍。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其十一 昭夏乐","佚名","隋",["荐飨洽，礼乐该。","神娱展，辰旆回。","洞云路，拂璇阶。","紫雰蔼，青霄开。","眷皇都，顾玉台。","留昌德，结圣怀。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其十二 昭远乐","佚名","隋",["天以德降，地以礼报。","牲尊俯陈，柴币仰燎。","事展司采，敬达瑄芗。","烟贽青昊，震飏紫场。","陈馨示策，肃志宗禋。","礼非物备，福唯诚陈。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其十三 休成乐","佚名","隋",["昭事上祀，飨荐具陈。","回銮转翠，拂景翔宸。","缀县敷畅，钟石昭融。","羽炫深晷，龠曀行风。","肆序辍度，肃礼停文。","四金耸卫，六驭齐轮。"],{"ad":"隋"},"x239","隋"],["齐北郊乐歌六首 其一 昭夏乐谢超宗","佚名","隋",["诏礼崇营，敬飨玄畤。","灵正丹帷，月肃紫墀。","展荐登华，风县凝锵。","神惟戾止，郁葆遥庄。","昭望岁芬，环游辰太。","穆哉尚礼，横光秉蔼。"],{"ad":"隋"},"x239","隋"],["齐北郊乐歌六首 其二 登歌","佚名","隋",["伫灵敬享，禋肃彝文。","县动声仪，荐絜牲芬。","阴祇以贶，昭祀式庆。","九服熙度，六农祥正。"],{"ad":"隋"},"x239","隋"],["齐北郊乐歌六首 其三 地德凯容乐","佚名","隋",["缮方丘，端国阴。","掩圭晷，仰灵心。","诏源委，遍丘林。","礼献物，乐荐音。"],{"ad":"隋"},"x239","隋"],["齐北郊乐歌六首 其四 昭德凯容乐","佚名","隋",["庆图浚邈，蕴祥秘瑶。","伣天炳月，嫔光紫霄。","邦化灵懋，阃则风调。","俪德方仪，徽载以昭。"],{"ad":"隋"},"x239","隋"],["齐北郊乐歌六首 其五 昭夏乐","佚名","隋",["荐神升，享序楙。","淹玉俎，停金奏。","宝旆转，旒驾旋。","溢素景，郁紫躔。","灵心顾，留宸眷。","洽外瀛，瑞中县。"],{"ad":"隋"},"x239","隋"],["齐北郊乐歌六首 其六 隶幽乐","佚名","隋",["后皇嘉庆，定祗玄畤。","承帝休图，祗敷灵祉。","篚幂周序，轩朱凝会。","牲币芬坛，精明伫盖。","调川瑞昌，警岳祥泰。"],{"ad":"隋"},"x239","隋"],null,["齐明堂乐歌十五首 其二","佚名","隋",["尊事威仪，辉容昭序。","迅恭明神，絜盛牲俎。","肃肃严宫，蔼蔼崇基。","皇灵降止，百祗具司。","戒诚望夜，端烈承朝。","依微昭旦，物色轻宵。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其三 引牲乐","佚名","隋",["惟诚絜飨，惟孝尊灵。","敬度黍稷，敬涤牺牲。","骍茧在豢，载溢载丰。","以承宗祀，以肃皇衷。","萧芳四举，华火周传。","神鉴孔昭，嘉足三牷。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 嘉荐乐二首 其四","佚名","隋",["肇禋戒祀，礼容咸举。","六典饰文，九司照序。","牲柔既昭，牺刚既陈。","恭涤惟清，敬事惟神。","加笾再御，兼俎重荐。","节动轩越，声流金县。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其五","佚名","隋",["奕奕閟幄，亹亹严闱。","絜诚夕鉴，端服晨晖。","圣灵戾止，翊我皇则。","上绥四宇，下洋万国。","永言孝飨，孝飨有容。","傧僚赞列，肃肃雍雍。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其六 昭夏乐","佚名","隋",["地纽谧，干枢回。","华盖动，紫微开。","旌蔽日，车若云。","驾六龙，乘烟煴。","烨帝景，耀天邑。","圣祖降，五云集。","懋粢盛，絜牲牷。","百礼肃，群司虔。","皇德远，大孝昌。","贯九幽，洞三光。","神之安，解玉銮。","景福至，万宇欢。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其七 登歌","佚名","隋",["雍台辨朔，泽宫选辰。","絜火夕炤，明水朝陈。","六瑚贲室，八羽华庭。","昭事先圣，怀濡上灵。","肆夏式敬，升歌发德。","永固洪基，以绥万国。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其八 凯容宣烈乐","佚名","隋",["酾醴具登，嘉佾咸荐。","飨洽诚陈，礼周乐遍。","祝辞罢裸，序容辍县。","跸动端庭，銮回严殿。","神仪驻景，华汉高虚。","作灵案卫，三只解途。","翠盖澄耀，罼帟凝宸。","玉镳息节，金辂怀音。","戒诚达孝，底心肃感。","追凭皇鉴，思承渊范。","神锡懋祉，四纬昭明。","仰福帝徽，俯齐庶生。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其九 青帝歌","佚名","隋",["参映夕，驷昭晨。","灵乘震，司青春。","雁将向，桐始蕤。","和风舞，暄光迟。","萌动达，万品亲。","润无际，泽无垠。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其十 赤帝歌","佚名","隋",["龙精初见。","大火中。","朱光北至。","圭景同。","帝在在离。","寔司衡。","雨水方降。","木槿荣。","庶物盛长。","咸殷阜。","恩泽四溟。","被九有。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其十一 黄帝歌","佚名","隋",["履艮宅中宇，司绳总四方。","裁化遍寒燠，布政司炎凉。","至分乘经晷，闭启集恒度。","帝晖缉万有，皇灵澄国步。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其十二 白帝歌","佚名","隋",["百川若镜。","天地爽且明。","云冲气举。","盛德在素精。","庶类收成。","岁功行欲宁。","浃地奉渥。","罄宇承帝灵。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其十三 黑帝歌","佚名","隋",["岁既暮日方驰，灵乘坎德司规。","玄云合晦鸟蹊，白灵繁亘天涯。","晨晷促夕漏延，太阴极微阳宣。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其十四 嘉胙乐","佚名","隋",["神荐洽。","福胙昌。","圣皇膺嘉佑。","帝业凝休祥。","居极乘景运。","宅德瑞中王。","澄明临四奥。","精华延八乡。","洞海同声惠。","澈宇丽干光。","灵庆缠世祉。","鸿烈永无疆。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其十五 昭夏乐","佚名","隋",["蕴礼容。","馀乐度。","灵方留。","景欲暮。","开九重。","肃五达。","凤参差。","龙已沫。","云既动。","河既梁。","万里照。","四空香。","神之车。","归清都。","璇庭寂。","玉殿虚。","鸿化疑。","孝风炽。","顾灵心。","结皇思。","鸿庆遐鬯。","嘉荐令芳。","翊帝明德。","永祚深光。"],{"ad":"隋"},"x239","隋"],["齐前后舞歌二首 其一 前舞阶步歌","佚名","隋",["天挺圣哲，三方维纲。","川岳伊宁，七曜重光。","茂育万物，众庶咸康。","道用潜通，仁施遐扬。","德厚坤极，功高昊苍。","舞象盛容，德以歌章。","八音既节，龙跃凤翔。","皇基永树，二仪等长。"],{"ad":"隋"},"x239","隋"],["齐前后舞歌二首 其二 后舞阶步歌","佚名","隋",["皇皇我后，绍业盛明。","涤拂除秽，宇宙载清。","允执中和，以莅苍生。","玄化远被，兆世轨形。","何以崇德，乃作九成。","妍步恂恂，雅曲芬馨。","八风清鼓，应以祥祯。","泽浩天下，功齐百灵。"],{"ad":"隋"},"x239","隋"],["齐鼙舞曲三首 其二 圣主曲辞","佚名","隋",["圣主受天命，应期则虞唐。","升旒综万机，端扆驭八方。","盈虚自然数，揖让归圣明。","北化陵河塞，南威越沧溟。","广德齐七政，敷教腾三辰。","万宇必承庆，百福咸来臻。","圣皇应福始，昌德洞佑先。"],{"ad":"隋"},"x239","隋"],["齐鼙舞曲三首 其三 明君辞","佚名","隋",["明君御四海，总鉴尽人灵。","仰成恩已洽，竭忠身必荣。","圣泽洞三灵，德教被八乡。","草木变柯叶，川岳洞嘉祥。","愉乐盛明运，舞蹈升太时。","微霜永昌命，轨心长欢怡。"],{"ad":"隋"},"x239","隋"],["齐民昌辞","佚名","隋",["齐世昌。","四海安乐齐太平。","人命长。","当结久。","千秋万岁皆老寿。"],{"ad":"隋"},"x239","隋"],["荆州民为始兴王憺歌","佚名","隋",["始兴王。","民之爹。","赴人急。","如水火。","何时复来哺乳我。"],{"ad":"隋"},"x239","隋"],["北军为韦睿歌","佚名","隋",["不畏萧娘与吕姥。","但畏合肥有韦武。"],{"ad":"隋"},"x239","隋"],["鄱阳民为陆襄歌二首 其一","佚名","隋",["鲜于平后善恶分。","民无枉赖陆君。"],{"ad":"隋"},"x239","隋"],["鄱阳民为陆襄歌二首 其二","佚名","隋",["陆君政，无怨家。","斗既罢，仇共车。"],{"ad":"隋"},"x239","隋"],["南豫州民为夏侯兄弟歌","佚名","隋",["我之有州，赖彼夏侯。","前兄后弟，布政优优。"],{"ad":"隋"},"x239","隋"],["梁武帝接民间为萧恪歌","佚名","隋",["江千万。","蔡五百。","王新车。","庾大宅。","主人愦愦不如客。"],{"ad":"隋"},"x239","隋"],["北方童谣","佚名","隋",["荆山为上格，浮山为下格。","潼沱为激沟，并灌钜野泽。"],{"ad":"隋"},"x239","隋"],["洛阳童谣","佚名","隋",["名军大将莫自牢。","千兵万马避白袍。"],{"ad":"隋"},"x239","隋"],["梁武帝时谣","佚名","隋",["莫匆匆。","且宽公。","谁当作天子。","草覆车边已。"],{"ad":"隋"},"x239","隋"],["昭明为太子时谣","佚名","隋",["鹿子开城门，城门鹿子开。","当开复未开，使我心徘徊。","城中诸少年，逐欢归去来。"],{"ad":"隋"},"x239","隋"],["普通中童谣","佚名","隋",["青丝白马寿阳来。"],{"ad":"隋"},"x239","隋"],["侯景时的脰乌童谣","佚名","隋",["的脰乌。","拂朱雀。","还与吴。"],{"ad":"隋"},"x239","隋"],["侯景即位时童谣","佚名","隋",["脱青袍。","著芒𪨗。","荆州天子挺应著。"],{"ad":"隋"},"x239","隋"],["江陵童谣","佚名","隋",["苦竹町。","市南有好井。","荆州军。","杀侯景。"],{"ad":"隋"},"x239","隋"],["湘东王府中为鱼宏徐绲谣","佚名","隋",["北路鱼。","南路徐。"],{"ad":"隋"},"x239","隋"],["柳达摩引北方童谣","佚名","隋",["石头捣两裆。","捣青复捣黄。"],{"ad":"隋"},"x239","隋"],["梁时童谣","佚名","隋",["虏万夫。","入五湖。","城南酒家使虏奴。"],{"ad":"隋"},"x239","隋"],["梁末童谣","佚名","隋",["可怜巴马子，一日行千里。","不见马上郎，但有黄尘起。","黄尘污人衣，皂荚相料理。"],{"ad":"隋"},"x239","隋"],["百姓为萧正德父子谣","佚名","隋",["宁逢五虎入市。","不欲见临贺父子。"],{"ad":"隋"},"x239","隋"],["鸟山童谣","佚名","隋",["鸟山出天子。"],{"ad":"隋"},"x239","隋"],["三馀童谣","佚名","隋",["夫子之居在三馀。"],{"ad":"隋"},"x239","隋"],["谚语后人引梁世谚论史职","佚名","隋",["上车不落则著作，体中保如则秘书。"],{"ad":"隋"},"x239","隋"],["梁元帝引谚论占雨","佚名","隋",["雨月额千里赤。"],{"ad":"隋"},"x239","隋"],["刘昼引谚","佚名","隋",["力贵突。","智贵卒。"],{"ad":"隋"},"x239","隋"],["刘昼引古谚","佚名","隋",["深不绝涓泉，稚子浴其渊。","高不绝丘陵，跛羊游其巅。"],{"ad":"隋"},"x239","隋"],["任昉引南海俗谚","佚名","隋",["蛇珠千枚。","不及玫瑰。"],{"ad":"隋"},"x239","隋"],["任昉引越人谚","佚名","隋",["种千亩木奴。","不如一龙珠。"],{"ad":"隋"},"x239","隋"],["颜之推引江南谚论书法","佚名","隋",["尺牍书疏，千里面目。"],{"ad":"隋"},"x239","隋"],["时人为张氏语","佚名","隋",["充融卷稷，是为四张。"],{"ad":"隋"},"x239","隋"],["时人为王谢子弟语","佚名","隋",["谢有览举。","王有养炬。"],{"ad":"隋"},"x239","隋"],["时人为张融陆杲语","佚名","隋",["无对日下，惟舅与甥。"],{"ad":"隋"},"x239","隋"],["时人为何子朗语 其一","佚名","隋",["东海三何。","子朗最多。"],{"ad":"隋"},"x239","隋"],["时人为何子朗语 其二","佚名","隋",["人中爽爽何子朗。"],{"ad":"隋"},"x239","隋"],["时人为王志王彬语","佚名","隋",["三真六草。","为天下宝。"],{"ad":"隋"},"x239","隋"],["时人为鲍正语","佚名","隋",["无处不逢鸟噪，无处不逢鲍佐。"],{"ad":"隋"},"x239","隋"],["巴东行人为庾子舆语","佚名","隋",["淫预如幞本不通。","瞿塘水退为庾公。"],{"ad":"隋"},"x239","隋"],["时人为玉莹语","佚名","隋",["欲向南，钱可贪。","遂向东，为黄铜。"],{"ad":"隋"},"x239","隋"],["省中为贺琛语","佚名","隋",["上殿不下有贺雅。"],{"ad":"隋"},"x239","隋"],["时人为丁觇语","佚名","隋",["丁君十纸。","不敌王褒数字。"],{"ad":"隋"},"x239","隋"],["都下为禅师语","佚名","隋",["斗场禅师窟，安东谈议林。"],{"ad":"隋"},"x239","隋"]]