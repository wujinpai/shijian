[null,null,null,null,null,null,null,null,null,null,null,null,null,null,["晚别乐记室彦","褚亮","隋",["穷途属岁晚，临水忽分悲。","抱影同为客，伤情共此时。","雾色侵虚牖，霜氛冷薄帷。","举袂惨将别，停杯怅不怡。","风严征雁远，雪暗去篷迟。","他乡有岐路，游子欲何之。"],{"ad":"隋"},150,"唐"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["五郊乐章 赤帝徵音 雍和","魏征","隋",["昭昭丹陆，帟帟炎方。","礼陈牲币，乐备篪簧。","琼羞溢俎，玉?浮觞。","恭惟正直，歆此馨香。"],{"ad":"隋"},152,"唐"]]