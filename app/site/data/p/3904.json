[["洛阳人为祝良歌","佚名","魏晋",["天久不雨，烝民失所。","天王自出，祝令特苦。","精符感应，滂沱而下。"],{"ad":"魏晋"},"x238","魏晋"],["巴人歌陈纪山","佚名","魏晋",["筑室载直梁，国人以贞真。","邪娱不扬目，狂行不动身。","奸轨僻乎远，理义协乎民。"],{"ad":"魏晋"},"x238","魏晋"],["汲县长老为崔瑗歌","佚名","魏晋",["上天降神明，锡我仁慈父。","临民布德泽，恩惠施以序。","穿沟广溉灌，决渠作甘雨。"],{"ad":"魏晋"},"x238","魏晋"],["崔君歌","佚名","魏晋",["讠毕治小序兮稼穑分。","天赐我兮此崔君。"],{"ad":"魏晋"},"x238","魏晋"],["彭子阳歌","佚名","魏晋",["时岁仓卒。","盗贼纵横。","大戟强弩不可当。","赖遇贤令彭子阳。"],{"ad":"魏晋"},"x238","魏晋"],["王世容歌","佚名","魏晋",["王世容，治无双。","省徭役，盗贼空。"],{"ad":"魏晋"},"x238","魏晋"],["巴郡人为吴资歌","佚名","魏晋",["习习晨风动，澍雨润禾苗。","我后恤时务，我人以优饶。"],{"ad":"魏晋"},"x238","魏晋"],["又歌","佚名","魏晋",["望远忽不见，惆怅当徘徊。","恩泽实难忘，悠悠心永怀。"],{"ad":"魏晋"},"x238","魏晋"],["六县吏人为爰珍歌","佚名","魏晋",["我有田畴，爰父殖置。","我有子弟，爰父教诲。"],{"ad":"魏晋"},"x238","魏晋"],["后时蜀中童谣","佚名","魏晋",["黄牛白腹。","五铢当复。"],{"ad":"魏晋"},"x238","魏晋"],["会稽童谣","佚名","魏晋",["弃我戟，捐我矛。","盗贼尽，吏皆休。"],{"ad":"魏晋"},"x238","魏晋"],["会稽童谣","佚名","魏晋",["城上乌鸣哺父母。","府中诸吏皆孝友。"],{"ad":"魏晋"},"x238","魏晋"],["河内谣","佚名","魏晋",["王稚子，世未有。","平徭役，百姓喜。"],{"ad":"魏晋"},"x238","魏晋"],["蜀郡童谣","佚名","魏晋",["两日出。","天兵戢。"],{"ad":"魏晋"},"x238","魏晋"],["益都民为王忳谣","佚名","魏晋",["信哉少林世为遇。","飞被走马与鬼语。"],{"ad":"魏晋"},"x238","魏晋"],["恒农童谣","佚名","魏晋",["君不我忧，人何以休。","不行界署，焉知人处。"],{"ad":"魏晋"},"x238","魏晋"],["桓帝初天下童谣","佚名","魏晋",["小麦青青大麦枯。","谁当获者妇与姑。","丈夫何在西击胡。","吏卖马。","君具车。","请为诸君鼓咙胡。"],{"ad":"魏晋"},"x238","魏晋"],["桓帝初城上乌童谣","佚名","魏晋",["城上乌。","尾毕逋。","公为吏。","子为徒。","一徒死。","百乘车。","车班班。","入河间。","河间姹女工数钱。","以钱为室金为堂。","石上慊慊舂黄粱。","梁下有悬鼓。","我欲击之丞卿怒。"],{"ad":"魏晋"},"x238","魏晋"],["桓帝时京都童谣","佚名","魏晋",["游平卖印自有平，不辟豪贤及大姓。"],{"ad":"魏晋"},"x238","魏晋"],["桓帝末京都童谣","佚名","魏晋",["白盖小车何延延。","河间来合谐。","河间来合谐。"],{"ad":"魏晋"},"x238","魏晋"],["桓帝末京都童谣","佚名","魏晋",["茅田一顷中有井。","四方纤纤不可整。","嚼复嚼。","今年尚可后年饶。"],{"ad":"魏晋"},"x238","魏晋"],["乡人谣","佚名","魏晋",["天下规矩。","房伯武。","因师获印。","周仲进。"],{"ad":"魏晋"},"x238","魏晋"],["二郡谣","佚名","魏晋",["汝南太守范孟博，南阳宗资主画诺。","南阳太守岑公孝，弘农成瑨但坐啸。"],{"ad":"魏晋"},"x238","魏晋"],["太学中谣五首 其一 三君","佚名","魏晋",["天下忠诚窦游平。","天下义府陈仲举。","天下德弘刘仲承。"],{"ad":"魏晋"},"x238","魏晋"],["太学中谣五首 其二 八俊","佚名","魏晋",["天下模楷李元礼，天下英秀王叔茂。","天下良辅杜周甫，天下冰凌朱季陵。","天下忠贞魏少英，天下好交荀伯条。","天下稽古刘伯祖，天下才英赵仲经。"],{"ad":"魏晋"},"x238","魏晋"],["太学中谣五首 其三 八顾","佚名","魏晋",["天下和雍郭林宗，天下慕恃夏子治。","天下英藩尹伯元，天下清苦羊嗣祖。","天下宝金刘叔林，天下雅志蔡孟喜。","天下卧虎巴恭祖，天下通儒宗孝初。"],{"ad":"魏晋"},"x238","魏晋"],["太学中谣五首 其四 八及","佚名","魏晋",["海内贵珍陈子鳞。","海内忠烈张元节。","海内謇谔范孟博。","海内通士檀文友。","海内彬彬范仲真。","海内珍好岑公孝。","海内所称刘景升。"],{"ad":"魏晋"},"x238","魏晋"],["太学中谣五首 其五 八厨","佚名","魏晋",["海内贤智王伯义。","海内修整蕃嘉景。","海内贞良秦平王。","海内珍奇胡母季皮。","海内光光刘子相。","海内依怙王文祖。","海内严恪张孟卓。","海内清明度博平。"],{"ad":"魏晋"},"x238","魏晋"],["京兆民为李庄歌","佚名","魏晋",["我府君。","惠如春。","盛如唐。"],{"ad":"魏晋"},"x238","魏晋"],["灵帝末京都童谣","佚名","魏晋",["侯非侯。","王非王。","千乘万骑上北芒。"],{"ad":"魏晋"},"x238","魏晋"],["献帝初京都童谣","佚名","魏晋",["千里草，何青青。","十日卜，不得生。"],{"ad":"魏晋"},"x238","魏晋"],["献帝初童谣","佚名","魏晋",["燕南垂。","赵北际。","中央不合大如砺。","唯有此中可避世。"],{"ad":"魏晋"},"x238","魏晋"],["初平中长安谣","佚名","魏晋",["头白皓然，食不充粮。","裹衣蹇裳，当还故乡。","圣王悯念，悉用补郎。","舍是布衣，被彼玄黄。"],{"ad":"魏晋"},"x238","魏晋"],["兴平中吴中童谣","佚名","魏晋",["黄金车，班兰耳。","开阊门，出天子。"],{"ad":"魏晋"},"x238","魏晋"],["建安初荆州童谣","佚名","魏晋",["八九年间始欲衰。","至十三年无孑遗。"],{"ad":"魏晋"},"x238","魏晋"],["汉末洛中童谣","佚名","魏晋",["虽有千黄金，无如我斗粟。","斗粟自可饱，千金何所直。"],{"ad":"魏晋"},"x238","魏晋"],["汉末江淮间童谣","佚名","魏晋",["大兵如市，人死如林。","持金易粟，粟贵于金。"],{"ad":"魏晋"},"x238","魏晋"],["京师为光禄茂才谣","佚名","魏晋",["欲得不能。","光禄茂才。"],{"ad":"魏晋"},"x238","魏晋"],["阎君谣","佚名","魏晋",["阎君赋政，既明且昶。","去苛去碎，动以礼让。"],{"ad":"魏晋"},"x238","魏晋"],["东门奂谣","佚名","魏晋",["东门奂，取吴半。","吴不足，济阴续。"],{"ad":"魏晋"},"x238","魏晋"],["商子华谣","佚名","魏晋",["石里之勇商子华。","暴虎见之藏爪牙。"],{"ad":"魏晋"},"x238","魏晋"],["时人谣","佚名","魏晋",["五侯之斗血成江。"],{"ad":"魏晋"},"x238","魏晋"],["擿洛谣","佚名","魏晋",["剡者配姬以放贤。","山崩水溃纳小人。","家伯罔主异哉震。"],{"ad":"魏晋"},"x238","魏晋"],["京师为唐约谣","佚名","魏晋",["治身无嫌。","唐仲谦。"],{"ad":"魏晋"},"x238","魏晋"],["蒋横遘祸时童谣","佚名","魏晋",["君用谗慝，忠烈是殛。","鬼怨神怒，妖气充塞。"],{"ad":"魏晋"},"x238","魏晋"],["锡山古谣","佚名","魏晋",["有锡兵。","无锡宁。"],{"ad":"魏晋"},"x238","魏晋"],["时人为三茅君谣","佚名","魏晋",["茅山连金陵，江湖据下流。","三神乘白鹤，各在一山头。","佳雨灌畦稻，陆地亦复周。","妻子保堂室，使我无百忧。","白鹤翔青天，何时复来游。"],{"ad":"魏晋"},"x238","魏晋"],["谚语】【光武述时人语","佚名","魏晋",["关东觥觥。","《郭子》横。"],{"ad":"魏晋"},"x238","魏晋"],["时人为郭况语","佚名","魏晋",["洛阳多钱郭氏室。","月夜书昼富无匹。"],{"ad":"魏晋"},"x238","魏晋"],["光武引谚","佚名","魏晋",["贵易交，富易妻。"],{"ad":"魏晋"},"x238","魏晋"],["宋弘引语","佚名","魏晋",["贫贱之知不可忘。","糟糠之妻不下堂。"],{"ad":"魏晋"},"x238","魏晋"],["南阳为杜师语","佚名","魏晋",["前有召父。","后有杜母。"],{"ad":"魏晋"},"x238","魏晋"],["时人为廉范语","佚名","魏晋",["前有管鲍，后有庆廉。"],{"ad":"魏晋"},"x238","魏晋"],["章帝引谚","佚名","魏晋",["作舍道边，三年不成。"],{"ad":"魏晋"},"x238","魏晋"],["班固引谚论经方","佚名","魏晋",["有病不治。","常得中医。"],{"ad":"魏晋"},"x238","魏晋"],["班昭女诫引鄙谚","佚名","魏晋",["生男如狼，犹恐其尪。","生女如鼠，犹恐其虎。"],{"ad":"魏晋"},"x238","魏晋"],["王逸引谚","佚名","魏晋",["政如冰霜，奸轨消亡。","威如雷霆，寇贼不生。"],{"ad":"魏晋"},"x238","魏晋"],["虞诩引谚","佚名","魏晋",["关西出将。","关东出相。"],{"ad":"魏晋"},"x238","魏晋"],["王符引谚论得贤","佚名","魏晋",["一犬吠形。","百犬吠声。"],{"ad":"魏晋"},"x238","魏晋"],["京师为黄香号","佚名","魏晋",["天下无双，江夏黄童。"],{"ad":"魏晋"},"x238","魏晋"],["人为高慎语","佚名","魏晋",["嶷然不语。","名高孝甫。"],{"ad":"魏晋"},"x238","魏晋"],["颍川为荀爽语","佚名","魏晋",["荀氏八龙，慈明无双。"],{"ad":"魏晋"},"x238","魏晋"],["崔实引农家谚","佚名","魏晋",["上火不落。","下火滴沰。"],{"ad":"魏晋"},"x238","魏晋"],["崔寔引里语","佚名","魏晋",["一岁再赦，奴儿喑恶。"],{"ad":"魏晋"},"x238","魏晋"],["李固引语","佚名","魏晋",["善人在患。","饥不及餐。"],{"ad":"魏晋"},"x238","魏晋"],["益州长为尹就谚","佚名","魏晋",["虏来尚可。","尹来杀我。"],{"ad":"魏晋"},"x238","魏晋"],["天下为贾彪语","佚名","魏晋",["贾氏三虎。","伟节最怒。"],{"ad":"魏晋"},"x238","魏晋"],["应劭引俚语论正失","佚名","魏晋",["狐欲渡河。","无奈尾河。"],{"ad":"魏晋"},"x238","魏晋"],["应劭引俚语论愆礼","佚名","魏晋",["妇死腹悲。","唯身知之。"],{"ad":"魏晋"},"x238","魏晋"],["应劭引里语论日蚀","佚名","魏晋",["不救蚀者，出行遇语。"],{"ad":"魏晋"},"x238","魏晋"],["应劭引里语论主客","佚名","魏晋",["越陌度阡，更为客主。"],{"ad":"魏晋"},"x238","魏晋"],["应劭引里语论谳狱","佚名","魏晋",["县官漫漫。","冤死者半。"],{"ad":"魏晋"},"x238","魏晋"],["应劭引里语","佚名","魏晋",["仕宦不止车生耳。"],{"ad":"魏晋"},"x238","魏晋"],["应劭引语论正失","佚名","魏晋",["金不可作。","世不可度。"],{"ad":"魏晋"},"x238","魏晋"],["时人为庞氏语","佚名","魏晋",["庐里诸庞。","凿井得铜。","买奴得翁。"],{"ad":"魏晋"},"x238","魏晋"],["民为二殽语","佚名","魏晋",["东殽西殽。","渑池所高。"],{"ad":"魏晋"},"x238","魏晋"],["南阳为卫修陈茂语","佚名","魏晋",["卫修有事，陈茂治之。","卫修无事，陈茂杀之。"],{"ad":"魏晋"},"x238","魏晋"],["公沙六龙","佚名","魏晋",["公沙六龙，天下无双。"],{"ad":"魏晋"},"x238","魏晋"],["民为五门语","佚名","魏晋",["苑中三公，馆下二卿。","五门嚄嚄，但闻豚声。"],{"ad":"魏晋"},"x238","魏晋"],["时人为作奏语","佚名","魏晋",["作奏虽工。","宜去葛龚。"],{"ad":"魏晋"},"x238","魏晋"],["高诱引谚论毁誉","佚名","魏晋",["欲人不知。","莫如不为。"],{"ad":"魏晋"},"x238","魏晋"],["武陵人为黄氏兄弟谚","佚名","魏晋",["天有冬夏，人有二黄。"],{"ad":"魏晋"},"x238","魏晋"],["时人为杨氏四子语","佚名","魏晋",["三苗不止。","四珍复起。"],{"ad":"魏晋"},"x238","魏晋"],["羊元引谚","佚名","魏晋",["孤犊触乳。","骄子詈母。"],{"ad":"魏晋"},"x238","魏晋"],["古谚","佚名","魏晋",["虽有神药，不如少年。","虽有珠玉，不如金钱。"],{"ad":"魏晋"},"x238","魏晋"],["时人为郭典语","佚名","魏晋",["郭君围堑，董将不许。","几令狐狸，化为豺虎。","赖我郭君，不畏强御。","转机之间，敌为穷虏。","猗猗惠君，实完疆土。"],{"ad":"魏晋"},"x238","魏晋"],["时人为周泽语","佚名","魏晋",["居世不谐为太常妻。","一岁三百六十日。","三百五十九日齐。","一日不齐醉如泥。","既作事。","复低迷。"],{"ad":"魏晋"},"x238","魏晋"],["崔实引语","佚名","魏晋",["小民发如韭。","剪复生。","头如鸡。","割复鸣。","吏不必可畏。","从来必可轻。","奈何欲望平。"],{"ad":"魏晋"},"x238","魏晋"],["时人为桓典语","佚名","魏晋",["行行且止。","避骢御史。"],{"ad":"魏晋"},"x238","魏晋"],["益都乡里为柳宗语","佚名","魏晋",["得黄金一笥。","不如为柳伯骞所识。"],{"ad":"魏晋"},"x238","魏晋"],["宣城为封使君语","佚名","魏晋",["无作封使君。","生来治民死食民。"],{"ad":"魏晋"},"x238","魏晋"],["益都为任文公语","佚名","魏晋",["任文公，智无双。"],{"ad":"魏晋"},"x238","魏晋"],["马皇后引俗语","佚名","魏晋",["时无赭，浇黄土。"],{"ad":"魏晋"},"x238","魏晋"],["崔寔引里语","佚名","魏晋",["州郡记，如霹雳。","得诏书，但挂壁。"],{"ad":"魏晋"},"x238","魏晋"],["崔寔引农语 其一","佚名","魏晋",["二月昏，参星夕。","杏花盛，桑椹赤。"],{"ad":"魏晋"},"x238","魏晋"],["崔寔引农语 其二","佚名","魏晋",["河射角，堪夜作。","犁星没，水生骨。"],{"ad":"魏晋"},"x238","魏晋"],["京师为袁成谚","佚名","魏晋",["事不谐。","诣文开。"],{"ad":"魏晋"},"x238","魏晋"],["天下为四侯语","佚名","魏晋",["左回天，具独坐。","徐卧虎，唐两堕。"],{"ad":"魏晋"},"x238","魏晋"],["京师为张盘语","佚名","魏晋",["闻清白。","张子石。"],{"ad":"魏晋"},"x238","魏晋"]]