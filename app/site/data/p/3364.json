欲变，入夜俳徊庭际。","新秋知是昨宵来，爱残月、纤纤西坠。","芭蕉老大，流萤衰倦，静里细观天意。","轻风未有半分凉，奈人道、今宵好睡。"],0,"x107","宋"],["鹊桥仙·连汀接渚","张镃","鹊桥仙",["连汀接渚，萦蒲带藻，万镜香浮光满。","湿烟吹霁木栏轻，照波底、红娇翠腕。","玉纤采处，银笼携去，一曲山长水远。","采鸳双惯贴人飞，恨南浦、离多梦短。"],0,"x107","宋"],["鹧鸪天·闲立飞虹远兴长","张镃","鹧鸪天",["闲立飞虹远兴长。","一方云锦荐疏凉。","翻风翠盖无尘土，出水红妆有艳香。","携靓侣，泛轻航。","棹歌惊起野鸳鸯。","同过清夏看新月，茉莉花园小象床。"],0,"x107","宋"],["鹧鸪天·不似琵琶不似琴","张镃","鹧鸪天",["不似琵琶不似琴。","四弦陶写晋人心。","指尖历历泉鸣涧，腹上锵锵玉振金。","天外曲，月边音。","为君转轴拟秋砧。","又成雅集相依坐，清致高标记竹林。"],0,"x107","宋"],["临江仙·七个圈儿为岁数","张镃","临江仙",["七个圈儿为岁数，年年用墨糊涂。","一圈又剩半圈馀。","看看云蔽月，三际等空虚。","纵使古稀真个得，后来争免呜呼。","肯闲何必更悬车。","非关轻利禄，自是没工夫。"],0,"x107","宋"],["御街行·良宵无意贪游玩","张镃","御街行",["良宵无意贪游玩。","奈怜友、闲呼唤。","六街非是少人行，不似旧时风范。","笙歌零落，绮罗销减，枉了心情看。","思量往事堪肠断。","怕频到、帘儿畔。","朦胧月下却归来，指望阿谁收管。","低头注定，两汪儿泪，百计难销遣。"],0,"x107","宋"],["满庭芳·月洗高梧","张镃","满庭芳",["月洗高梧，露漙幽草，宝钗楼外秋深。","土花沿翠，萤火坠墙阴。","静听寒声断续，微韵转、凄咽悲沈。","争求侣，殷勤劝织，促破晓机心。","儿时，曾记得，呼灯灌穴，敛步随音。","任满身花影，犹自追寻。","携向花堂戏斗，亭台小、笼巧妆金。","今休说，从渠床下，凉夜伴孤吟。"],{"tg":["宋词三百首"]},"x107","宋"],["风入松·小樊标韵称香山","张镃","风入松",["小樊标韵称香山。","压尽花间。","便须著个楼儿住，彩鸾看、飞舞妖闲。","珠佩时因醉解，云扉常为春关。","耳边属付话儿奸。","休放蛮檀。","绿窗惟怕今宵梦，莺声巧、春满阑干。","待把衷肠教与，却愁长远都难。"],0,"x107","宋"],["鹧鸪天 其三 宣和己亥代人赠别","向子𬤇","鹧鸪天",["说著分飞百种猜。","泥人细数几时回。","风流可惯曾孤冷，怀抱如何得好开。","垂玉箸，下香阶。","凭肩小语更兜鞋。","再三莫遣归期误，第一频教入梦来。"],0,108,"宋"],["鹧鸪天 其四","向子𬤇","鹧鸪天",["浅浅妆成淡淡梅。","见梅忆着傍妆台。","书无鸿雁如何寄，肠断催归作么回。","千种恨，百般猜。","为伊怀抱几时开。","可堪江上风头恶，不放朝云入梦来。"],0,108,"宋"],["鹧鸪天","向子𬤇","鹧鸪天",["几处秋千懒未收。","花梢柳外出纤柔。","霞衣轻举疑奔月，宝髻敧倾若坠楼。","争缥缈，斗风流。","蜂儿蛱蝶共嬉游。","朝朝暮暮春风里，落尽梨花未肯休。"],0,108,"宋"],["踏莎行 政和丙申九江道中","向子𬤇","踏莎行",["霭霭朝云，矜春态度。","楚宫梦断寻无路。","欲将尊酒遣新愁，谁知引到愁深处。","不尽长江，无边细雨。","只疑都把愁来做。","西山总不解遮栏，随春直过东湖去。"],{"tg":["长江"]},108,"宋"],["鹊桥仙","向子𬤇","鹊桥仙",["合卺风流，擘钗情态，压倒痴牛呆女。","今年云外果深期，想却笑、人间离苦。","萦愁叠恨，青山绿水，杳杳重重无数。","寻常犹有梦能来，到此夜、无寻梦处。"],0,108,"宋"],["虞美人 其一 政和丁酉下琵琶沟作","向子𬤇","虞美人",["蒙蒙烟树无重数。","不碍相思路。","晚云分外欲增愁。","更那堪疏雨、送归舟。","雨来还被风吹去。","陨泪多如雨。","拟题双叶问离忧。","怎得水随人意、肯西流。"],0,108,"宋"],["虞美人 其二","向子𬤇","虞美人",["去年不到琼花底。","蝶梦空相倚。","今年特地趁花来。","却甚不教同醉、过花开。","花知此恨年年有。","也伴人春瘦。","一枝和泪寄春风。","应把旧愁新怨、入眉峰。"],0,108,"宋"],["虞美人 其三 宣和辛丑","向子𬤇","虞美人",["去年雪满长安树。","望断扬州路。","今年看雪在扬州。","人在蓬莱深处、若为愁。","而今不恨伊相误。","自恨来何暮。","平山堂下旧嬉游。","只有舞春杨柳、似风流。"],0,108,"宋"],["虞美人 其四","向子𬤇","虞美人",["倚窗人似莺藏柳。","巧语春心透。","声声清切入人深。","一夜不知两鬓、雪霜侵。","何时月下歌金缕。","醉看行云住。","懒将幽恨寄瑶琴。","却倩金笼鹦鹉、递芳音。"],0,108,"宋"],["更漏子 其一 题赵伯山青白轩，时王丰父、刘长因同赋","向子𬤇","更漏子",["竹孤青，梅酽白。","更着使君清绝。","梅似竹，竹如君。","须知德有邻。","月同高，风同调。","月底风前一笑。","翻碎影，度微香。","与人风味长。"],0,108,"宋"],["更漏子 其二","向子𬤇","更漏子",["鹊桥边，牛渚上。","翠节红旌相向。","承玉露，御金风。","年年岁岁同。","懒飞梭，停弄杼。","遥想彩云深处。","人咫尺，事关山。","无聊独倚栏。"],0,108,"宋"],["鹊桥仙 七夕","向子𬤇","鹊桥仙",["澄江如练，远山横翠，一段风烟如画。","层楼杰阁倚晴空，疑便是、支矶石下。","宝奁琼鉴，淡匀轻扫，纤手弄妆初罢。","拟将心事问天公，与牛女、平分今夜。"],0,108,"宋"],["南歌子 代张仲宗赋","向子𬤇","南歌子",["碧落飞明镜，晴烟幂远山。","扁舟夜下广陵滩。","照我白苹红蓼、一杯残。","初望同盘饮，如何两处看。","遥知香雾湿云鬟。","凭暖琼楼十二、玉栏干。"],0,108,"宋"],["鹊桥仙","向子𬤇","鹊桥仙",["飞云多态，凉飕微度，都到酒边歌处。","冰肌玉骨照人寒，更做弄、一帘风雨。","同盘风味，合欢情思，不管星娥猜妒。","桃花溪水接银河，与占断、鹊桥归路。"],0,108,"宋"],["南歌子 其一 郭小娘道装","向子𬤇","南歌子",["缥缈云间质，轻盈波上身。","瑶林玉树出风尘。","不是野花凡草、等闲春。","翠羽双垂珥，乌纱巧制巾。","经珠不动两眉颦。","须信铅华销尽、见天真。"],0,108,"宋"],["南歌子 其二","向子𬤇","南歌子",["梁苑千花乱，隋堤一水长。","眼前风物总悲凉。","何况眉头心上、不相忘。","因梦聊携手，凭书续断肠。","已惊蝴蝶过东墙。","更被风吹鸿雁、不成行。"],0,108,"宋"],null,["菩萨蛮 其一","向子𬤇","菩萨蛮",["鸳鸯翡翠同心侣。","惊风不得双飞去。","春水绿西池。","重期相见时。","长怜心共语。","梦里池边路。","相见不如新。","花应解笑人。"],0,108,"宋"],["菩萨蛮 其二 政和丙申","向子𬤇","菩萨蛮",["娟娟明月如霜白。","鳌山可是蓬山隔。","恨不及春风。","行云处处同。","暖香红雾里。","一笑谁新喜。","知得远愁无。","春衫有泪珠。"],0,108,"宋"],["菩萨蛮 其三","向子𬤇","菩萨蛮",["袜儿窄剪鞋儿小。","纹鸳并影双双好。","微步巧藏人。","轻飞洛浦尘。","前回深处见。","欲近还相远。","心事不能知。","教人直是疑。"],0,108,"宋"],["南歌子","向子𬤇","南歌子",["雨过林峦静，风回池阁凉。","窥人双燕语雕梁。","笑看小荷翻处、戏鸳鸯。","共饮菖蒲细，同分彩线长。","今朝真不负风光。","绝胜几年飞梦、绕高唐。"],0,108,"宋"],["减字木兰花 政和癸巳","向子𬤇","减字木兰花",["几年不见。","胡蝶枕中魂梦远。","一日相逢。","鹦鹉杯深笑靥浓。","欢心未已。","流水落花愁又起。","离恨如何。","细雨斜风晚更多。"],0,108,"宋"],["秦楼月・忆秦娥","向子𬤇","秦楼月・忆秦娥",["虫声切。","柔肠欲断伤离别。","伤离别。","几行清泪，界残红颊。","玉阶白露侵罗袜。","下帘却望玲珑月。","玲珑月。","寒光凌乱，照人愁绝。"],0,108,"宋"],["生查子 其一 与王丰父、郑曼卿兄弟嵩山道中","向子𬤇","生查子",["月在两山间，人在空明里。","山色碧于天，月色光于水。","心闲物物幽，心动尘尘起。","莫向动中来，长愿闲如此。"],0,108,"宋"],["生查子 其二","向子𬤇","生查子",["春心如杜鹃，日夜思归切。","啼尽一川花，愁落千山月。","遥怜白玉人，翠被馀香歇。","可惯独眠寒，减动丰肌雪。"],0,108,"宋"],["生查子 其三","向子𬤇","生查子",["近似月当怀，远似花藏雾。","好是月明时，同醉花深处。","看花不自持，对月空相顾。","愿学月频圆，莫作花飞去。"],0,108,"宋"]]