[["京师为鲍永鲍恢语","佚名","魏晋",["贵戚敛手避二鲍。"],{"ad":"魏晋"},"x238","魏晋"],["时人为折氏谚","佚名","魏晋",["折氏客谁。","朱云卿段节英。","中有佃子赵仲平。","但说天文论五经。"],{"ad":"魏晋"},"x238","魏晋"],["王符引谚论守边","佚名","魏晋",["痛不著身言忍之，钱不出家言与之。"],{"ad":"魏晋"},"x238","魏晋"],["三府为朱震语","佚名","魏晋",["车如鸡栖马如狗。","疾恶如风朱伯厚。"],{"ad":"魏晋"},"x238","魏晋"],["时人为贡举语","佚名","魏晋",["古人欲达勤诵经。","今民图官勉治生。"],{"ad":"魏晋"},"x238","魏晋"],["赵岐引南阳旧语","佚名","魏晋",["前队大夫范仲公。","盐蒜果共一筒。"],{"ad":"魏晋"},"x238","魏晋"],["考城为仇览谚","佚名","魏晋",["父母何在在我庭。","化我鸤枭哺所生。"],{"ad":"魏晋"},"x238","魏晋"],["时人为孔氏兄弟语","佚名","魏晋",["鲁国孔氏好读经。","兄弟讲诵皆可听。","学士来者有声名。","不过孔氏那得成。"],{"ad":"魏晋"},"x238","魏晋"],["华容女子狱中歌吟","佚名","魏晋",["不意李立为贵人。"],{"ad":"魏晋"},"x238","魏晋"],["阚骃引语","佚名","魏晋",["仕宦不偶值冀部，幽冀之人钝如椎。"],{"ad":"魏晋"},"x238","魏晋"],["王符引谚论考绩","佚名","魏晋",["曲木恶直绳，重罚恶明证。"],{"ad":"魏晋"},"x238","魏晋"],["时人为王符语","佚名","魏晋",["徒见二千石。","不如一缝掖。"],{"ad":"魏晋"},"x238","魏晋"],["乡里为雷义陈重语","佚名","魏晋",["胶漆自谓坚，不如雷与陈。"],{"ad":"魏晋"},"x238","魏晋"],["郑玄引俗语","佚名","魏晋",["隐疾难为医。"],{"ad":"魏晋"},"x238","魏晋"],["时人为吕布语","佚名","魏晋",["人中有吕布。","马中有赤兔。"],{"ad":"魏晋"},"x238","魏晋"],["关中为游殷谚","佚名","魏晋",["生有知人之明。","死有贵神之灵。"],{"ad":"魏晋"},"x238","魏晋"],["京师为戴凭语","佚名","魏晋",["解经二不穷。","戴侍中。"],{"ad":"魏晋"},"x238","魏晋"],["京师为井丹语","佚名","魏晋",["五经纷纶。","井大春。"],{"ad":"魏晋"},"x238","魏晋"],["时人为王君公语","佚名","魏晋",["避世墙东。","王君公。"],{"ad":"魏晋"},"x238","魏晋"],["京师为杨政语","佚名","魏晋",["说经铿铿。","杨子行。"],{"ad":"魏晋"},"x238","魏晋"],["京师为祁圣元号","佚名","魏晋",["论难僠僠。","祁圣元。"],{"ad":"魏晋"},"x238","魏晋"],["寿春乡里为召驯语","佚名","魏晋",["德得恂恂。","召伯春。"],{"ad":"魏晋"},"x238","魏晋"],["时人为丁鸿语","佚名","魏晋",["殿中无双。","丁孝公。"],{"ad":"魏晋"},"x238","魏晋"],["京兆乡里为冯豹语","佚名","魏晋",["道德彬彬。","冯仲文。"],{"ad":"魏晋"},"x238","魏晋"],["诸儒为贾逵语","佚名","魏晋",["问事不休。","贾长头。"],{"ad":"魏晋"},"x238","魏晋"],["关中为鲁丕语","佚名","魏晋",["五经复兴。","鲁叔陵。"],{"ad":"魏晋"},"x238","魏晋"],["诸儒为杨震语","佚名","魏晋",["关西孔子。","杨伯起。"],{"ad":"魏晋"},"x238","魏晋"],["时人为许慎语","佚名","魏晋",["五经无双。","许叔重。"],{"ad":"魏晋"},"x238","魏晋"],["京师为周举语","佚名","魏晋",["五经从横。","周宣光。"],{"ad":"魏晋"},"x238","魏晋"],["京师为胡广语","佚名","魏晋",["万事不理。","问伯始。","天下中庸。","有胡公。"],{"ad":"魏晋"},"x238","魏晋"],["时人为任安语","佚名","魏晋",["欲知仲桓。","问任安。","居今行古。","任定祖。"],{"ad":"魏晋"},"x238","魏晋"],["时人为陈嚣语","佚名","魏晋",["关东说诗。","陈君期。"],{"ad":"魏晋"},"x238","魏晋"],["诸儒为刘恺语","佚名","魏晋",["难经伉伉。","刘太常。"],{"ad":"魏晋"},"x238","魏晋"],["人为许晏谚","佚名","魏晋",["殿上成群。","许伟君。"],{"ad":"魏晋"},"x238","魏晋"],["乡里为茨充号","佚名","魏晋",["一马两车。","茨子河。"],{"ad":"魏晋"},"x238","魏晋"],["时人为缪文雅语","佚名","魏晋",["素车白马。","缪文雅。"],{"ad":"魏晋"},"x238","魏晋"],["敦煌乡人为曹全谚","佚名","魏晋",["重亲致欢。","曹景完。"],{"ad":"魏晋"},"x238","魏晋"],["将归操","佚名","魏晋",["狄之水兮风扬波。","船楫颠倒更相加。","归来归来胡为斯。"],{"ad":"魏晋"},"x238","魏晋"],["陬操","佚名","魏晋",["周道衰微，礼乐陵迟。","文武既坠，吾将焉归。","周游天下，靡邦可依。","凤鸟不识，珍宝枭鸱。","眷然顾之，惨然心悲。","巾车命驾，将适唐都。","黄河洋洋，攸攸之鱼。","临津不济，还辕息鄹。","伤予道穷，哀彼无辜。","翱翔于卫，复我旧庐。","从我所好，其乐只且。"],{"ad":"魏晋"},"x238","魏晋"],["猗兰操","佚名","魏晋",["习习谷风，以阴以雨。","之子于归，远送于野。","何彼苍天，不得其所。","逍遥九州，无有定处。","世人暗蔽，不知贤者。","年纪迈逝，一身将老。"],{"ad":"魏晋"},"x238","魏晋"],["龟山操","佚名","魏晋",["予欲望鲁兮龟山蔽之。","手无斧柯。","奈龟山何。"],{"ad":"魏晋"},"x238","魏晋"],["越裳操","佚名","魏晋",["于戏嗟嗟。","非旦之力。","乃文王之德。"],{"ad":"魏晋"},"x238","魏晋"],["拘幽操","佚名","魏晋",["殷道溷溷浸浊烦兮。","朱紫相合不别分兮。","迷乱声色信谗言兮。","炎炎之虐使我愆兮。","幽闭牢阱由其言兮。","无辜桎梏谁所宣兮。","进我四人忧勤勤兮。","得此珍玩且解大患兮。","仓皇迤命遗后昆兮。","作此象变兆在昌兮。","钦承祖命天不丧兮。","遂临下土在圣明兮。","讨暴除乱诛逆王兮。"],{"ad":"魏晋"},"x238","魏晋"],["履霜操","佚名","魏晋",["履朝霜兮采晨寒。","考不明其心兮听谗言。","孤恩别离兮摧肺肝。","何辜皇天兮遭斯愆。","痛殁不同兮恩有偏。","谁说顾兮知我冤。"],{"ad":"魏晋"},"x238","魏晋"],["雉朝飞操","佚名","魏晋",["雉朝飞。","鸣相和。","雌雄群游于山阿。","我独何命兮未有家。","时将暮兮可奈何。","嗟嗟暮兮可奈何。"],{"ad":"魏晋"},"x238","魏晋"],["别鹤操","佚名","魏晋",["将乖比翼兮隔天端。","山川悠远兮路漫漫。","揽衣不寐兮食忘餐。"],{"ad":"魏晋"},"x238","魏晋"],["列女引","佚名","魏晋",["忠谏行兮正不邪，众妾夸兮继嗣多。"],{"ad":"魏晋"},"x238","魏晋"],["贞女引","佚名","魏晋",["菁菁茂木隐独荣兮。","变化垂枝含秀英兮。","修身养行建令名兮。","厥道不移善恶并兮。","屈躬就浊世彻清兮。","怀忠见疑何贪生兮。"],{"ad":"魏晋"},"x238","魏晋"],["辟历","佚名","魏晋",["疾雨盈河。","辟历下臻。","洪水浩浩滔厥天。","铿?隆愧。","隐隐阗阗。","国将亡兮丧厥年。"],{"ad":"魏晋"},"x238","魏晋"],["箕山操","佚名","魏晋",["登彼箕山兮瞻望天下。","山川丽崎。","万物还普。","日月运照。","靡不记睹。","游放其间。","何所却虑。","叹彼唐尧。","独自愁苦。","劳心九州。","忧勤后土。","谓余钦明。","传禅易祖。","我乐如何。","盖不盼顾。","河水流兮缘高山。","甘瓜施兮弃绵蛮。","高林肃兮相错连。","居此之处傲尧君。"],{"ad":"魏晋"},"x238","魏晋"],["文王受命","佚名","魏晋",["翼翼翱翔彼鸾皇兮，衔书来游以命昌兮。","瞻天案图殷将亡兮，苍苍昊天始有萌兮。","神连精合谋于房兮，与我之业望羊来兮。"],{"ad":"魏晋"},"x238","魏晋"],["思亲操","佚名","魏晋",["陟彼历山兮崔嵬。","有鸟翔兮高飞。","瞻彼鸠兮徘徊。","河水洋洋兮清冷。","深谷鸟鸣兮嘤嘤。","设罝张■兮思我父母力耕。","日与月兮往如驰。","父母远兮吾将安归。"],{"ad":"魏晋"},"x238","魏晋"],["仪凤歌","佚名","魏晋",["凤皇翔兮于紫庭。","余何德兮以感灵。","赖先人兮恩泽臻。","于胥乐兮民以宁。","凤皇来兮百兽晨。"],{"ad":"魏晋"},"x238","魏晋"],["龙蛇歌","佚名","魏晋",["有龙矫矫，遭天谴怒。","卷逃鳞甲，来遁于下。","志愿不得，与蛇同伍。","龙蛇俱行，周遍山野。","龙遭饥饿，蛇割腓股。","龙得升天，安厥房产。","蛇独抑摧，沈滞泥土。","仰天怨望，惆怅悲苦。","非乐龙伍，怪不盼顾。"],{"ad":"魏晋"},"x238","魏晋"],["龙蛇歌","佚名","魏晋",["有龙矫矫。","将失其所。","有蛇从之。","周流天下。","龙既入深渊。","得其安所。","蛇脂尽干。","独不得甘雨。"],{"ad":"魏晋"},"x238","魏晋"],["龙蛇歌","佚名","魏晋",["有龙矫矫，而失其所。","有蛇从之，而啖其口。","龙既升云，蛇独泥处。"],{"ad":"魏晋"},"x238","魏晋"],["芑梁妻歌","佚名","魏晋",["乐莫乐兮新相知。","悲莫悲兮生别离。","哀感皇天兮城为隳。"],{"ad":"魏晋"},"x238","魏晋"],["信立","佚名","魏晋",["悠悠沂水经荆山兮。","精气郁泱谷岩岩兮。","中有神宝灼明明兮。","穴山采玉难为功兮。","于何献之楚先王兮。","遇王暗昧信谗言兮。","断截两足离余身兮。","俯仰嗟叹心摧伤兮。","紫之乱朱粉墨同兮。","空山歔欷涕龙钟兮。","天鉴孔明竟以彰兮。","沂水滂沌流于汶兮。","进宝得刑足离分兮。","去封立信守休芸兮。","断者不续岂不冤兮。"],{"ad":"魏晋"},"x238","魏晋"],["归耕操","佚名","魏晋",["歔欷归耕来兮。","安所耕历山盘兮。","以晏父母我心博兮。"],{"ad":"魏晋"},"x238","魏晋"],["引声歌","佚名","魏晋",["天地之道，近在胸臆。","呼噏精神，以养九德。","渴不求饮，饥不索食。","避世守道，志洁如玉。","卿相之位，难可直当。","岩岩之石，幽而清凉。","枕块寝处，乐在其央。","寒凉固回，可以久长。"],{"ad":"魏晋"},"x238","魏晋"],["霍将军歌","佚名","魏晋",["四夷既获诸夏康兮。","国家安宁乐无央兮。","载戢干戈弓矢藏兮。","麒麟来臻凤皇翔兮。","与天相保永无疆兮。","亲亲百年各延长兮。"],{"ad":"魏晋"},"x238","魏晋"],["失题","佚名","魏晋",["俟罪斯国志愿得兮。","庶此太康皆为力兮。"],{"ad":"魏晋"},"x238","魏晋"],["饭牛歌","佚名","魏晋",["南山矸。","白石䃹。","生不逢尧与舜禅。","短而单衣裁至骭。","长夜漫漫何时旦。"],{"ad":"魏晋"},"x238","魏晋"],["失题","佚名","魏晋",["鹓彼鸣鹣。","在严山之唫。"],{"ad":"魏晋"},"x238","魏晋"],["神人畅","佚名","魏晋",["清庙穆兮承予宗。","百僚肃兮于寝堂。","醊祷进福求年丰。","有?在坐敕予为?在玄中。","钦哉昊天德不隆。","承命任禹写中宫。"],{"ad":"魏晋"},"x238","魏晋"],["南风操","佚名","魏晋",["反彼三山兮商岳嵯峨。","天降五老兮迎我来歌。","有黄龙兮自出于河。","负书图兮委蛇罗沙。","案图观谶兮闵天嗟嗟。","击石拊韶兮沦幽洞微。","鸟兽跄跄兮凤凰来仪。","凯风自南兮喟其增悲。"],{"ad":"魏晋"},"x238","魏晋"],["箕子操","佚名","魏晋",["嗟嗟纣为无道杀比干。","嗟重复嗟。","独柰何。","漆身为厉。","被发以佯狂。","今柰宗庙保。","天乎天哉。","欲负石自投河。","嗟复嗟柰社稷何。"],{"ad":"魏晋"},"x238","魏晋"],["克商操","佚名","魏晋",["上告皇天兮可以行乎。"],{"ad":"魏晋"},"x238","魏晋"],["水仙操","佚名","魏晋",["翳洞渭兮流澌濩，舟楫逝兮仙不还。","移形素兮蓬莱山，歍钦伤宫仙石还。"],{"ad":"魏晋"},"x238","魏晋"],["伯姬引","佚名","魏晋",["嘉名洁兮行弥章。","托节鼓兮令躬丧。","歍钦何辜遇斯殃。","嗟嗟柰何罹斯殃。"],{"ad":"魏晋"},"x238","魏晋"],["思归引","佚名","魏晋",["涓涓泉水。","流及于淇兮。","有怀于卫。","靡日不思。","执节不移兮行不隳。","砛轲何辜兮离厥菑。","嗟乎何辜兮离厥菑。"],{"ad":"魏晋"},"x238","魏晋"],["琴引","佚名","魏晋",["酒坐俱勿往。","听吾琴之所言。","舒长袖似舞兮乃褕袂何曼。","奏章而却逢兮愿瞻心之所欢。","借连娟之寒态兮假卮酒酌五般。","泣喻而妖兮纳其声声丽颜。","长㯓兮叹曰骑。","美人旖旎纷嬆。","枻霜罗衣兮羽旄。","夜褒圭玉珠参差。","妙丽兮被云髾。","登高台兮望青挨。","常羊啖还何厌兮归来。"],{"ad":"魏晋"},"x238","魏晋"],["岐山操","佚名","魏晋",["狄戎侵兮土地迁移。","邦邑适于岐山。","烝民不忧兮谁者知。","嗟嗟柰何兮予命遭斯。"],{"ad":"魏晋"},"x238","魏晋"],["绥山谣","佚名","魏晋",["得绥山一桃。","虽不得仙。","亦足亦豪。"],{"ad":"魏晋"},"x238","魏晋"],["长安中谣","佚名","魏晋",["见乞儿与美酒。","以免破屋之咎。"],{"ad":"魏晋"},"x238","魏晋"],["里语","佚名","魏晋",["年未半。","枝不汗。"],{"ad":"魏晋"},"x238","魏晋"],["赤雀辞","佚名","魏晋",["安公安公。","冶与天通。","七月七日。","迎汝以赤龙。"],{"ad":"魏晋"},"x238","魏晋"],["鬼神】【崔少府女赠卢充诗","佚名","魏晋",["煌煌灵芝质，光丽何猗猗。","华艳当时显，嘉异表神奇。","含英未及秀，中夏罹霜萎。","荣曜长幽灭，世路永无施。","不悟阴阳运，哲人忽来仪。","会浅离别速，皆由灵与祗。","何以赠余亲，金鋺可养儿。","爱恩从此别，断绝伤肝碑。"],{"ad":"魏晋"},"x238","魏晋"],["咏谯君黄诗","佚名","魏晋",["肃肃清节士，执德实固贞。","违恶以授命，没世遗令声。"],{"ad":"魏晋"},"x238","魏晋"],["伤三贞诗","佚名","魏晋",["间关黄鸟，爰集于树。","窈窕淑女，是绣是黼。","惟彼绣黼，其心匪石。","嗟尔临川，邈不可获。"],{"ad":"魏晋"},"x238","魏晋"],["风巴郡太守诗","佚名","魏晋",["明明上天，下土是亲。","帝选元后，求定安民。","孰可不念，祸福由人。","愿君奉诏，惟德日新。"],{"ad":"魏晋"},"x238","魏晋"],["思治诗","佚名","魏晋",["混混浊沼鱼，习习激清流。","温温乱国民，业业仰前修。"],{"ad":"魏晋"},"x238","魏晋"],["张公神碑歌","佚名","魏晋",["綦水汤汤扬清波。","东流□折□于河。","□□□□□朝歌。","县以吉静无秽瑕。","公□守相驾蜚鱼。","往来悠忽遂熹娱。","佑此兆民宁厥居。","出自綦□□□□。","松柏郁茂兰公□。","□神往来乘浮云。","种德收福惠斯民。","家饶户富无□贫。","畺界家静和睦口。","朝歌荡阴及犁阳。","三女所处各殊方。","三门鼎列推其乡。","时携甥幼归候公。","夫人□□□容□。","□□□□飨□觞。","穆风屑兮起坛旁。","乐吏民兮永未央。","鹿呦呦兮□□庭。","文乐乐兮□□□。","饮清泉兮□□□。","见□伏兮不骇惊。","惟公德兮之所宁。","上陵庙兮助三牲。","天时和兮甘露冷。","日番□兮无亏倾。","□□蜚兮朱鸟栖。","□□荣兮鸣喈喈。","䳒鹄剿兮乳徘徊。","给御卵兮献于西。","惟公德兮之所怀。","池水□兮钓台粲。","四角楼兮临深涧。","鱼岌岌兮踊跃见。","振鳞尾兮游旰旰。","时钓取兮给烹献。","惟公德兮之所衍。","栗萧草兮丛铺陈。","新美萌兮香苾芬。","蕙草生兮满园田。","竞苔茗兮给万钱。","惟公德兮之所□。","门堂郁兮文耀光。","公神赫兮坐东方。","明暴视兮俨卬卬。","夫人□女兮列在旁。","陈君处北兮从官□。","车骑骆驿兮交错重。","乘𫐐轺兮驾蜚龙。","骖白鹿兮从仙僮。","游北岳兮与天通。","玄碑既立双阙建兮。","□□□□大路畔兮。","亭长阍□□捍难兮。","列种槐梓方茂烂兮。","天下远近□不见兮。","公神日著声洞遍兮。","□□干川传亿万兮。"],{"ad":"魏晋"},"x238","魏晋"],["李翊夫人碑叹","佚名","魏晋",["阴阳分兮钟律滋。","星月列兮有四时。","神宓设兮万姓熹。","寿十二兮九九期。","五三末兮衰在姬。","秋发兮春华殆。","周公九兮成称灾。","靡黄发兮盖夭胎。","卅有皇兮气所裁。","赴鸿渊兮逝不来。","凤延颈兮泣交颐。","■■悲兮涕陨零。","寐耿耿兮摧伤情。","彼苍天兮朔神灵。","忡切剥兮年法荣。","兰茝亡兮丧芝英。","谁不忉兮作偯声。","畴■号兮鸣莺莺。","杞之至兮感动城。","陟四极兮升天庭。","曰司命兮致不平。","飞蜂?兮豁仁良。","魂魄孤兮独茕茕。","陈衤勺祠兮返所生。","幽不见兮存厥井刂。","嗟日遐兮适窅窅。"],{"ad":"魏晋"},"x238","魏晋"],["郭辅碑歌","佚名","魏晋",["寔惟先生，虢仲之裔。","盛德遗祀，休矣亦世。","孝友贞信，仁恕好惠。","直己自求，不欲荣势。","绰绰令人，获道之至。","笃生七子，钟天之祉。","堂堂四俊，硕大婉敏。","娥娥三妃，行追大姒。","叶叶昆嗣，福禄茂止。","克昌厥后，身去烈在。","镌石作歌，昭示万祀。"],{"ad":"魏晋"},"x238","魏晋"],["风雨诗","佚名","魏晋",["日不显目兮黑云多。","月不见视兮风非沙。","从恣蒙水诚江河。","州流灌注兮转扬波。","辟柱槙到忘相加。","天门狭小路彭池。","无因以上如之何。","兴诗教海兮诚难过。"],{"ad":"魏晋"},"x238","魏晋"],["古诗十九首 其一","佚名","魏晋",["行行重行行，与君生别离。","相去万馀里，各在天一涯。","道路阻且长，会面安可知。","胡马依北风，越鸟巢南枝。","相去日已远，衣带日已缓。","浮云蔽白日，游子不顾返。","思君令人老，岁月忽已晚。","弃捐勿复道，努力加餐饭。"],{"ad":"魏晋"},"x238","魏晋"],["古诗五首 其三","佚名","魏晋",["悲与亲友别，气结不能言。","赠子以自爱，道远会见难。","人生无几时，颠沛在其间。","念子弃我去，新心有所欢。","结志青云上，何时复来还。"],{"ad":"魏晋"},"x238","魏晋"],["李陵录别诗二十一首 其二","佚名","魏晋",["携手上河梁，游子暮何之。","徘徊蹊路侧，悢悢不能辞。","行人难久留，各言长相思。","安知非日月，弦望自有时。","努力崇明德，皓首以为期。"],{"ad":"魏晋"},"x238","魏晋"],["李陵录别诗二十一首 其三","佚名","魏晋",["嘉会难再遇，三载为千秋。","临河濯长缨，念子怅悠悠。","远望悲风至，对酒不能酬。","行人怀往路，何以慰我愁。","独有盈觞酒，与子结绸缪。"],{"ad":"魏晋"},"x238","魏晋"],["李陵录别诗二十一首 其五","佚名","魏晋",["结发为夫妻，恩爱两不疑。","欢娱在今夕，燕婉及良时。","征夫怀往路，起视夜何其。","参辰皆已没，去去从此辞。","行役在战场，相见未有期。","握手一长叹，泪为生别滋。","努力爱春华，莫忘欢乐时。","生当复来归，死当长相思。"],{"ad":"魏晋"},"x238","魏晋"],["李陵录别诗二十一首 其六","佚名","魏晋",["黄鹄一远别，千里顾徘徊。","胡马失其群，思心常依依。","何况双飞龙，羽翼临当乖。","幸有弦歌曲，可以喻中怀。","请为游子吟，泠泠一何悲。","丝竹厉清声，慷慨有馀哀。","长歌正激烈，中心怆以摧。","欲展清商曲，念子不得归。","俯仰内伤心，泪下不可挥。","愿为双黄鹄，送子俱远飞。"],{"ad":"魏晋"},"x238","魏晋"],["李陵录别诗二十一首 其七","佚名","魏晋",["烛烛晨明月，馥馥我兰芳。","芬馨良夜发，随风闻我堂。","征夫怀远路，游子恋故乡。","寒冬十二月，晨起践严霜。","俯观江汉流，仰视浮云翔。","良友远别离，各在天一方。","山海隔中州，相去悠且长。","嘉会难再遇，欢乐殊未央。","愿君崇令德，随时爱景光。"],{"ad":"魏晋"},"x238","魏晋"],["李陵录别诗二十一首 其九","佚名","魏晋",["烁烁三星列，拳拳月初生。","寒凉应节至，蟠蟀夜悲鸣。","晨风动乔木，枝叶日夜零。","游子暮思归，塞耳不能听。","远望正萧条，百里无人声。","豺狼鸣后园，虎豹步前庭。","远处天一隅，苦困独零丁。","亲人随风散，历历如流星。","三萍离不结，思心独屏营。","愿得萱草枝，以解饥渴情。"],{"ad":"魏晋"},"x238","魏晋"],["李陵录别诗二十一首 其十","佚名","魏晋",["寂寂君子坐，奕奕合众芳。","温声何穆穆，因风动馨香。","清言振东序，良时著西痒。","乃令丝竹音，列席无高唱。","悲意何慷慨，清歌正激扬。","长哀发华屋，四坐莫不伤。"],{"ad":"魏晋"},"x238","魏晋"],["李陵录别诗二十一首 其十一","佚名","魏晋",["晨风鸣北林，熠耀东南飞。","愿言所相思，日暮不垂帷。","明月照高楼，想见馀光辉。","玄鸟夜过庭，仿佛能复飞。","褰裳路踟蹰，彷徨不能归。","浮云日千里，安知我心悲。","思得琼树枝，以解长渴饥。"],{"ad":"魏晋"},"x238","魏晋"],["李陵录别诗二十一首 其十二","佚名","魏晋",["陟彼南山隅，送子淇水阳。","尔行西南游，我独东北翔。","辕马顾悲鸣，五步一彷徨。","双凫相背飞，相远日已长。","远望云中路，想见来圭璋。","万里遥相思，何益心独伤。","随时爱景曜，愿言莫相忘。"],{"ad":"魏晋"},"x238","魏晋"],["李陵录别诗二十一首 其十三","佚名","魏晋",["钟子歌南音，仲尼叹归与。","戎马悲边鸣，游子恋故庐。","阳鸟归飞云，蛟龙乐潜居。","人生一世间，贵与愿同俱。","身无四凶罪，何为天一隅。","与其苦筋力，必欲荣薄躯。","不如及清时，策名于天衢。"],{"ad":"魏晋"},"x238","魏晋"],["李陵录别诗二十一首 其十四","佚名","魏晋",["凤皇鸣高冈，有翼不好飞。","安知凤皇德，贵其来见稀。"],{"ad":"魏晋"},"x238","魏晋"],["李陵录别诗二十一首 其十五","佚名","魏晋",["红尘蔽天地，白日何冥冥。","许由不洗耳。","后世有何征。"],{"ad":"魏晋"},"x238","魏晋"]]