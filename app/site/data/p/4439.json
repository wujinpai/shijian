[["浣溪沙","刘敏中","词",["㶁㶁清流浅见沙。","沙边翠竹野人家。","野人延客不堪夸。","旋扫太初岩顶雪，细烹阳羡贡余茶。","古铜瓶子蜡梅花。"],0,204,"元"],["浣溪沙","刘敏中","词",["拂旦恩麻下玉墀。","六朝元老万人知。","知公福庆世间稀。","年过太公渔渭日，官如郑武相周时。","一行金带五男儿。"],0,204,"元"],["浣溪沙","刘敏中","词",["共说莲花似六郎。","从来魏紫冠群芳。","多情恨不一时香。","也甚春风闲着意，许教国色嫁横塘。","海枯石烂两鸳鸯。"],0,204,"元"],["浣溪沙 次前韵","刘敏中","词",["世事恒河水内沙。","干忙谁遣强离家。","如今老也不矜夸。","检得闲书能引睡，暖来薄酒胜煎茶。","一江风月四时花。"],0,204,"元"],["破阵子","刘敏中","词",["画道十分意巧，不知一段天成。","捉得山中独脚鬼，变作人间有尾丁。","奇哉见未曾。","说破何愁脱牡，把来真是持平。","得力最宜高处柱，行倦还堪立地凭。","衰年吾友生。"],0,204,"元"],["破阵子 野亭遣兴","刘敏中","词",["老眼偏宜大字，白头好映乌纱。","诗不求奇聊遣兴，酒但成醺也胜茶。","出家元在家。","野水傍边种竹，草亭直下栽花。","拙妇善供无米粥，稚子能描枯树槎。","无涯还有涯。"],0,204,"元"],["减字木兰花","刘敏中","词",["年时寿酒。","共喜秋卿新拜后。","寿酒今朝。","道改春闱是昨宵。","官随福转。","一到生辰须一换。","看取明年。","凤诏迎年醉寿筵。"],0,204,"元"],["减字木兰花 有怀泺源胜概楼旧游","刘敏中","词",["江山胜概。","天与飞楼供眼界。","上得楼头。","销尽人间万古愁。","十年京国。","两鬓黄尘归未得。","卷地泉声。","辜负凭阑带月听。"],0,204,"元"],["婆罗门引 寿大智先生","刘敏中","词",["草堂潇洒，今年初种碧琅玕。","更宜野菊幽兰。","便信先生于此，真个不求官。","但西负揽镜，落日凭栏。","耕笔钓磻。","算遭遇，未应难。","好待青霄得路，稳上长安。","良辰乐事，且展放尊前舞袖宽。","天影外、秋色南山。"],0,204,"元"],["婆罗门引 送李士元之荆南提刑经历","刘敏中","词",["京华逆旅，转头岁月十年中。","悠悠真赏难逢。","牢落黄金已尽，仆马亦龙钟。","但平生豪气，未减元龙。","临江故封。","吴与蜀，渺西东。","此幕聊堪一笑，且叹途穷。","扁舟南下，正霜落荆门江树空。","诗有兴、说与飞鸿。"],0,204,"元"],["清平乐","刘敏中","词",["云窗月户。","水秀山奇处。","画里二三千里路。","一步哦诗一住。","诗中却也思家。","寄来满纸烟霞。","办了皇华事业，做成冷淡生涯。"],0,204,"元"],["清平乐","刘敏中","词",["蜂房蚁户。","总是容身处。","脚底东西南北路。","万古人行人住。","出家何必离家。","求仙不用餐霞。","但得花开酒美，老夫欢喜逾涯。"],0,204,"元"],["清平乐","刘敏中","词",["松窗竹户。","山气空蒙处。","烟柳迷人花满路。","此是中庵旧住。","沙鸥久望归家。","归心已接飞霞。","他日乘轩过我，待君绣水之涯。"],0,204,"元"],["清平乐","刘敏中","词",["繁华敢望。","自喜清贫状。","老屋三间空荡荡。","几册闲书架上。","客来或问中庵。","平生虎穴曾探。","隐几悠然不答，窗间笑指山岚。"],0,204,"元"],["清平乐","刘敏中","词",["茸茸碧草。","点点金花小。","十里青山山下道。","地锦都教盖了。","天然草软平匀。","马蹄稳送行人。","路断不堪回首，南风依旧黄尘。"],0,204,"元"],["清平乐","刘敏中","词",["山灵久望。","要看游山状。","酒榼诗囊空放荡。","不肯凌风直上。","快教去结山庵。","安排暮历朝探。","整顷衰年杖屦，并君飞出危岚。"],0,204,"元"],["清平乐 九月回至隆兴","刘敏中","词",["云峰咫尺。","竹静芭蕉静。","鹤绕苍苔行又立。","不见高堂素壁。","簿书驲骑匆匆。","暂时留住衰翁。","一片归心难画，野亭绣水秋风。"],0,204,"元"],["清平乐 山行见芍药","刘敏中","词",["山寒开晚。","开也无人管。","风里欹红颜色浅。","恨与天涯共远。","多时立马彷徨。","一枝为挽余香。","欲说扬州旧谱，怕渠分外凄凉。"],0,204,"元"],["清平乐 白芍药","刘敏中","词",["何年金屑。","飞上玲珑雪。","一树风情谁解说。","只有盈盈夜月。","牡丹红叶相夸。","铅华各自名家。","为向看花人道，此花不在铅华。"],0,204,"元"],["清平乐 次前韵","刘敏中","词",["相亲相望。","两个哦诗状。","坐即堆豗行旷荡。","怎着麒麟阁上。","风岩水穴云庵。","非君与我谁探。","好兴最难忘处，半山斜日浓岚。"],0,204,"元"],["清平乐 次前韵","刘敏中","词",["东皋晚望。","尽了溪山状。","一似龙湫浮雁荡。","人在营丘画上。","中间小小吾庵。","君来共此奇探。","啼鸟一声飞去，落花点破层岚。"],0,204,"元"],["清平乐 次前韵","刘敏中","词",["功名休望。","且看龙钟状。","身是龙钟心坦荡。","大吉宜称上上。","如今已结幽庵。","溪山好处须探。","料得山风知我，隔林吹下飞岚。"],0,204,"元"],["清平乐 次前韵","刘敏中","词",["经春闭户。","人不思量处。","蓦地花神通一路。","留得神仙肯住。","相欢忘却无家。","对花细引流霞。","此日诗来肠断，望君东海西涯。"],0,204,"元"],["清平乐 次前韵","刘敏中","词",["悠扬酒望。","点缀春情状。","云气欲酣花气荡。","语燕啼莺下上。","水边柳阁松庵。","遥遥眼力先探。","一阵山风雨过，马头日脚烘岚。"],0,204,"元"],["清平乐 此篇促游山","刘敏中","词",["今晨过望。","尽得山形状。","石险路危心欲荡。","手拨白云又上。","半空仰见仙庵。","山灵许我高探。","倦处旋倾春酒，不愁冒雨冲岚。"],0,204,"元"],["清平乐 张秀实芍药词","刘敏中","词",["牡丹花落。","梦里东风恶。","见说君家红芍药。","尽把春愁忘却。","隔墙百步香来。","数丛为我全开。","拚向彩云堆里，醉时同卧苍苔。"],0,204,"元"],["清平乐 野芳亭观画罗汉","刘敏中","词",["千金不换。","壁上阿罗汉。","古怪清奇君细看。","画是如来变现。","天龙鬼物青红。","断崖流水孤松。","知在野芳亭上，恍然兜率天中。"],0,204,"元"],["渔家傲 饯表兄魏鹏举归华亭寓居","刘敏中","词",["矍铄诗翁人共许。","远游不怕别离苦。","梦里华亭亭下路。","来又去。","扁舟一叶轻如舞。","二陆人材今似古。","五湖风景饶烟雨。","倦处一杯君自举。","还有路。","江山信美非君土。"],0,204,"元"],["眼儿媚","刘敏中","词",["春来应怪洗妆悭。","故作两回看。","风流依旧，檀心晕紫，翠袖凝丹。","玉容寂寞栏干泪，细雨豆花寒。","多情谁管，今宵冷落，淡月东栏。"],0,204,"元"],["菩萨蛮","刘敏中","词",["行行正向西山缺。","遥遥望见东山雪。","风色夜来间。","杏花寒不寒。","故人家远近。","只向林东问。","一径傍山开。","鹊声迎我来。"],0,204,"元"],["菩萨蛮","刘敏中","词",["眼中有此妖娆色。","花中无此风流格。","一月一番新。","一年都是春。","盈盈花上月。","几度圆还缺。","不去卷金荷。","奈渠花月何。"],0,204,"元"],["菩萨蛮","刘敏中","词",["挈家来吃山城水。","三年不剩公田米。","何物办归装。","一车风满箱。","吾人垂泪叹。","过客回头看。","谁不爱清官。","清官似子难。"],0,204,"元"],["菩萨蛮 山居遣兴","刘敏中","词",["众山围绕横塘路。","中庵正向中间住。","花木四时开。","沙鸥日日来。","门前车马驻。","不得中庵趣。","下马问中庵。","庵中睡正酣。"],0,204,"元"],["菩萨蛮 忆家庭月桂二首 其一","刘敏中","词",["新枝旧孕娇无力。","翠销香雾阑干湿。","秋月与春风。","深红复浅红。","相思幽梦苦。","夜夜西窗雨。","且莫怨芳菲。","惜花人欲归。"],0,204,"元"],["菩萨蛮 月夕对玉簪独酌","刘敏中","词",["遥看疑是梅花雪。","近前不似梨花月。","秋入一簪凉。","满庭风露香。","举杯香露洗。","月在杯心里。","醉眼月徘徊。","玉鸾花上飞。"],0,204,"元"],["菩萨蛮 次前韵","刘敏中","词",["看君自是丰年玉。","赠行不用阳关曲。","但把此心论。","几人能似君。","到官消息好。","来岁春风早。","再折绣江梅。","寄君挥一杯。"],0,204,"元"],["菩萨蛮 次解安卿韵","刘敏中","词",["惜花不似东庵惜。","近来恰得真消息。","玉雪两三枝。","暗藏和靖诗。","看花谁可约。","定与花斟酌。","后阁盛筵开。","老夫来不来。"],0,204,"元"],["菩萨蛮 盆梅","刘敏中","词",["纤条渐见稀稀蕾。","孤根旋透温温水。","但得一枝春。","谁嫌老瓦盆。","寒愁芳意懒。","移近南窗暖。","却怕盛开时。","香魂来索诗。"],0,204,"元"],["菩萨蛮 送秦主簿赴宿迁二首 其一","刘敏中","词",["绣江江水清如玉。","梅花香满清江曲。","风味此中论。","可怜惟有君。","江头春正好。","别去君何早。","折得一枝梅。","送君三百杯。"],0,204,"元"],["菩萨蛮 绣江即事","刘敏中","词",["行云恰过前山北。","靠山村落移时黑。","脚底一声雷。","北风截雨回。","出门南望立。","过客衣裳湿。","问有雨如何。","一倾三尺多。"],0,204,"元"],["最高楼","刘敏中","词",["幽居好，烟霭翠生漪。","水绕更山围。","锦帏四面花藏屋，绿云一望稻盈畦。","问谁欤，君子者，美人兮。","也不看李家堂里月。","也不踏班生关外雪。","寻寂寞，觅希夷。","醉眠长被莺呼起，相看时有燕飞归。","我怜君，君似我，本无机。"],0,204,"元"],["最高楼","刘敏中","词",["山家好，河水净涟漪。","茅舍绿荫围。","儿童不解针垂钓，老翁只会瓮浇畦。","我思之，君倦矣，去来兮。","也问甚野芳亭上月。","也问甚太初岩下雪。","乘款段，载鸱夷。","兴来便作寻花去，醉时不记插花归。","问沙鸥，从此后，可忘机。"],0,204,"元"],["最高楼 又次前韵","刘敏中","词",["吾衰矣，废治不重漪。","朽木更堪围。","触藩曾看赢其角，胁肩又见病于畦。","此何哉，自取耳，亦难兮。","待阔展月台秋待月。","更别起雪堂冬听雪。","花灌溉，草芟夷。","偶逢林叟欢成醉，闲随沙鸟淡忘归。","叹人生，尘土事，漫劳机。"],0,204,"元"],["最高楼 又前韵","刘敏中","词",["江风远，吹皱翠罗漪。","山绕似重围。","连延花枝香成阵，坡陀垄亩绿如畦。","个中间，吾受者，一尘兮。","君不见花间偏爱月。","又不见山阴偏喜雪。","搴杜若，载辛夷。","东篱日落悠然坐，舞雩春暖咏而歌。","此何人，千万古，一天机。"],0,204,"元"],["最高楼 次前韵","刘敏中","词",["文章好，自得似风漪。","不定似棋围。","郢人斫垩元无迹，仙家种玉不论畦。","子能之，吾耄矣，奈何兮。","都占断野芳花与月。","更带却野亭风与雪。","情放旷，境清夷。","木瓜暂比空函往，琼瑶已报满车归。","怪天孙，浑不藉，锦云机。"],0,204,"元"],["最高楼 次韵答张县尹","刘敏中","词",["高高屋，罗幕卷轻漪。","阿渚一周围。","雄吞不数针三碗，治生何计韭千畦。","是贤乎，既富矣，又时兮。","我喜踏探梅溪畔月。","君爱扫、煮茶枝上雪。","君遣兴，我心夷。","东家画鼓更深舞，西家红烛醉时归。","莫教他，知我辈，不投机。"],0,204,"元"],["感皇恩","刘敏中","词",["公子说春台，其光如水。","相对偏宜子瞻椅。","老父危坐，不觉耳闻心喜。","慨然都见许，情何已。","禅榻鬓丝，绳床乌几。","前辈风流要吾比。","绣江风月，鸥鹭已应知矣。","几时分付到，中庵里。"],0,204,"元"],["感皇恩 立秋后一日有感","刘敏中","词",["云月淡幽窗，黄昏微雨。","窗外梧桐共人语。","秋来情味，便觉今宵如许。","断肠杨柳苑，芙蓉浦。","青鬓易消，失颜难驻。","行乐光阴水东注。","山林朝市，两地笑人返袂。","伤心都付与，潘郎句。"],0,204,"元"],["摸鱼儿","刘敏中","词",["莫相疑、爱石如许，流形我亦随寓。","神麇更有神麇在，照影几烦清滏。","山下路。","还记得、当时射虎人曾误。","如今文府。","但日永闲阶，香凝燕寝，云岫翳还吐。","崔嵬起，欲作飞仙骞翥。","依稀老眼如雾。","品题好刻奇章字，嗟尔赏音难遇。","如砥柱。","应笑我心，更欲谁安住。","茶余客去，相对静无言，悠然意会，一阵北窗雨。"],0,204,"元"],["摸鱼儿 九日上都次韵答邢伯才","刘敏中","词",["叹萍蓬、此生无定，年年客里重九。","南来北去风沙梦，弹指已成白首。","谁有酒。","都唤起、一天秋色开林薮。","还开笑口。","对满意青山，多情黄菊，莫唱渭城柳。","龙钟态，也向人前叉手。","思量难以持久。","东涂西抹皆倾国，只有效颦人丑。","嗟汝叟。","今误矣，江亭好去藏衰朽。","鸣鸡吠狗。","尽里社追随，何须更说，鼻醋吸三斗。"],0,204,"元"],["念奴娇","刘敏中","词",["探梅时候，怯朝寒、倦说梅溪清浅。","谁窃玄都春一握，烘暖小斋冰砚。","何意芳妍，如今又与，前度刘郎面。","武陵回首，断肠流水花片。","信道造化能移，何须更问，世事云千变。","犹胜当时深院里，满树芳菲细剪。","宝鸭熏香，铜瓶浴水，休把重帘卷。","风流故在，乞浆怕有人见。"],0,204,"元"],["满江红","刘敏中","词",["爱日回春，恰开放、江头梅萼。","还更有、远山晴雪，竹溪松壑。","晚节丰年人尽喜，良辰美景君须乐。","便拚教寿酒一千钟，深深的。","眉宇秀，胸怀廓。","问谁识，平生略。","只优游无事，笑谈宾幕。","万里秋天鸿鹄志，高名四海麒麟阁。","待此时、满意祝庄椿，扬州鹤。"],0,204,"元"],["满江红","刘敏中","词",["十载京华，也曾是、飘零狂客。","还有幸、公家兄弟，相逢相识。","记得宣恩疏决日，柏台骢马秋官笔。","甚人生聚散等闲间，都难测。","摩抚手，天西北。","放浪迹，江湖国。","忽高轩飞下，今夕何夕。","头上貂蝉看欲见，掌中珠颗今先得。","暂放教、诗酒豁平生，公休惜。"],0,204,"元"],["满江红","刘敏中","词",["百花开后，殿余春、只有翻阶红药。","人似春光留不住，半夜东风作恶。","寥落离怀，苍凉行色，更与花前酌。","浩歌一曲鸟，啼花自飞落。","潇洒谁复如君，溪山如此，何限山中乐。","政尔功名相促迫，眼底台东阁。","我识君才，青云明日，万里秋天鹤。","有时还梦，野亭亭下岩壑。"],0,204,"元"],["满江红 又次前韵","刘敏中","词",["我笑前人，痴绝甚、搔瓜钻李。","天壤内、神奇腐朽，有所穷已。","才见凌风霄汉上，忽看垂翅蓬蒿底。","试闲将、得失遍思量，凡经几。","无汝愧，从渠毁。","非我有，何吾喜。","但物来即应，尽心焉耳。","一榻高眠人事了，一瓢乐饮家缘理。","也何曾、直待马千蹄，童千指。"],0,204,"元"],["念奴娇 又次前韵","刘敏中","词",["看花须约，一千年、知赴瑶池缘浅。","雪里花枝来索句，恍觉春生冷砚。","却忆前时，寻芳处处，霞影浮杯面。","酒醒花落，树头飞下余片。","何事岁晚重妍，多情应笑，我早朱颜变。","依样铅华红胜锦，争得瓶梅并剪。","小阁幽窗，回寒向暖，百怕霜风卷。","旧家野老，也来惊讶希见。"],0,204,"元"],["满江红 次韵答畅泊然","刘敏中","词",["满纸龙鸾，浑压倒、来禽青李。","黄绢好、朝吟暮玩，爱之无已。","玉刻来从千载上，宝珠出自重渊底。","每相逢慰淡相于，如君几。","无所见，哗然毁。","安所有，同然喜。","赖多情问我，病欤贫耳。","一寸灰心寒欲尽，数茎绿发愁难理。","说青帘高处有仙乡，无人指。"],0,204,"元"],["念奴娇 自述呈知己时有小言","刘敏中","词",["乌飞兔走，叹劳生、浮世匆匆如此。","眼底风尘今古梦，到了谁非谁是。","击短扶长，曲邀横结，为问都能几。","悠悠长啸，谩嗟真个男子。","数载黄卷青灯，种兰植蕙，颇遂平生喜。","冷笑纷纷儿女语，都付春风马耳。","美景良辰，亲朋密友，有酒何妨醉。","高歌一曲，二三知己知彼。"],0,204,"元"],["满江红 送李清甫赴西蜀提刑副使","刘敏中","词",["万古云霄，谁办得、妙龄勋业。","长有恨、君恩未报，鬓毛先雪。","紫诏俄从天关下，绣衣已逐星轺发。","但七千里外望闱，三年别。","忠与孝，心应切。","行与止，君须决。","说蜀中父老，望君如渴。","地迥无妨鹰隼系，山深要静狐狸穴。","着新诗、收拾锦城春，归来说。"],0,204,"元"],["满江红 送郑鹏南经历赴河东廉访幕","刘敏中","词",["宿酒初醒，秋已老、故人来别。","情味恶、从前万里，不堪重说。","大抵男儿忠孝耳，此身如叶心如铁。","但始终夷险要扶持，平生节。","湖海气，诗书业。","霜雪地，风云客。","问而今月旦，果谁豪杰。","君去还经汾水上，依然照见齐州月。","怕相思、休费短长吟，生华发。"],0,204,"元"],["满江红 病中又次前韵","刘敏中","词",["北去南来，凡几度、风沙行李。","离又合、新欢旧恨，古今何已。","风鉴俄瞻衡宇外，月明照见寒江底。","问朱丝白雪尚依然，知音几。","无所作，谁成毁。","非所望，何悲喜。","谓人生得失，卷舒天耳。","病骨支离羁思乱，此情正要公料理。","但无言、手捉玉连环，东南指。"],0,204,"元"],["满江红 病中呈诸友","刘敏中","词",["昼景清和，南风扇、葛衣未试。","知又是、梅黄时候，麦秋天气。","宝鸭旋薰香篆小，绿阴生寂重门闭。","有画梁双燕伴人愁，知人意。","萤窗苦，貂蝉贵。","穷与达，心如醉。","个月来多病，不禁憔悴。","讳疲怎谩衣带缓，怯眠却把窗儿倚。","问阿谁、心绪正如今，还如此。"],0,204,"元"],["满庭芳","刘敏中","词",["鞍马雄豪，搢绅驰骤，几年都付寻常。","边城岁晚，莲幕锦生光。","得意尊前一笑，遐冲具威凛秋霜。","人谁似，胸怀豁落，温雅更文章。","从军真乐事，功名那问，故国他乡。","笑熊非渭水，龙卧南阳。","从此鹏程高举，快天风万里无妨。","回首怅，穷途狂客，摇荡叹行藏。"],0,204,"元"],["满庭芳 寿何聪山平章","刘敏中","词",["经济才难，升平事了，喜公亲见唐虞。","精神如画，风节凛云衢。","回首岩岩钜望，更须问、山斗何如。","还知否，三朝旧德，眷倚在吁俞。","高情谁得似，诗中元亮，易里尧夫。","便萧然忘却，玉带金鱼。","此意君恩亦许，三二日一到中书。","公无倦，长开寿域，四海一蓬壶。"],0,204,"元"],["鹊桥仙","刘敏中","词",["乌瞻三足，蟾看膰腹。","矫首惊虬突兀。","走来便吸绣江波，却只是、陶泓旧物。","玄卿如故，毛生未秃。","老楮犹堪一拂。","此时才气斗谁先，看个个、骊珠吐出。"],0,204,"元"],["鹊桥仙","刘敏中","词",["黄尘古驿，荒园小树。","几朵晴云自舞。","殷勤马上折来看，问过却、行人几许。","琼苞半拆，檀心乍吐。","笑向春风不语。","多情莫怪洗妆迟，我也是、天涯逆旅。"],0,204,"元"],["鹊桥仙 上都金莲","刘敏中","词",["重房自拆，娇黄谁注。","烂熳风前无数。","凌波梦断几番秋，只认得、三生月露。","川平野阔，山遮水护。","不似溪塘迟暮。","年年迎送翠华行，看照耀、恩光满路。"],0,204,"元"],["鹊桥仙 书合曲诗卷","刘敏中","词",["无情枯竹，多情软语。","谁按梨园新谱。","邻舟余韵遏云声，只认作、珠绳一缕。","秦台风物，当时几许。","扇影春风解舞。","客愁都向坐间空，问谁管、西窗夜雨。"],0,204,"元"],["鹊桥仙 以纱巾竹扇为赵文卿寿","刘敏中","词",["飞云半卷，乌纱一幅。","扇影寒生湘竹。","雪髯丹颊羽衣裳，真个是、神仙人物。","浊醪醉倒，清风睡足。","不识黄金满屋。","野夫倦眼少曾开，为吾子、狂歌一曲。"],0,204,"元"],["鹊桥仙 观接牡丹","刘敏中","词",["栽时白露，开时谷雨。","培养工夫良苦。","闲园消息阿谁传，算只是、司花说与。","寒梢一拂，芳心寸许。","点破凡根宿土。","不知魏紫是姚黄，到来岁、春风看取。"],0,204,"元"],["鹊桥仙 盆梅","刘敏中","词",["孤根如寄，高标自整。","坐上西湖风景。","几回误作杏花看，被梦里、香魂唤省。","薰炉茶灶，春闲昼永。","不似霜清月冷。","从今更爱短檠灯，夜夜看、江边瘦影。"],0,204,"元"],["鹊桥仙 谢人惠酒","刘敏中","词",["江村岁晚，山寒雪落。","一树梅花寂寞。","门前剥啄问谁来，惊不起、檐间噪鹊。","白衣锦字，清尊玉络。","尽把离愁忘却。","历城春色故人心，放老子、梅边细酌。"],0,204,"元"],["蝶恋花","刘敏中","词",["多病多愁心性软。","自上疏帘，怕隔双飞燕。","梦觉绿窗花影畔。","起来翻喜茶瓯浅。","香压玉炉消欲断。","情绪厌厌，犹傍琴书懒。","瞥见壁间蜗引篆。","急将山水图儿卷。"],0,204,"元"],["蝶恋花","刘敏中","词",["我似漏卮长不满。","暮侧朝翻，自笑天机浅。","君似宝珠无可拣。","暑天不热冬还暖。","神欲逍遥心欲散。","咫尺幽栖，回首云霄远。","千古风流嵇与阮。","竹林不受黄尘管。"],0,204,"元"],["蝶恋花","刘敏中","词",["带上乌犀谁摘落。","方响匀排，不见朱丝约。","一个拈来香满阁。","矮炉翻动松风壑。","几日余酲情味恶。","七碗何须，一啜都醒却。","两腋清风无处着。","梦寻卢老翔寥廓。"],0,204,"元"],["蝶恋花","刘敏中","词",["忽得新词深自愧。","欲记无名，未见无名例。","自古求名今却避。","不知谁与君同议。","旦昼行为昏暮睡。","我自无心，何物能吾累。","若道无名名可弃。","无名名处曾留意。"],0,204,"元"],["蝶恋花 又次前韵","刘敏中","词",["帘底青灯帘外雨。","酒醒更阑，寂寞情何许。","肠断南园回首处。","月明花影闲朱户。","听彻楼头三叠鼓。","题遍云笺，总是伤心句。","咫尺巫山无路去。","浪凭青鸟丁宁语。"],0,204,"元"],["蝶恋花 次韵答魏鹏举","刘敏中","词",["五日祥风十日雨。","国泰年丰，天也应相许。","见说少年行乐处。","青楼宛转低琼户。","城市笙箫村社鼓。","何碍狂夫，醉里闲诗句。","明日南山携酒去。","共君一笑云间语。"],0,204,"元"],["蝶恋花 晓至野亭","刘敏中","词",["临水衰葵欹欲倒。","三两幽花，更比初开好。","何处飞来金凤小。","碧筵开彻忘忧草。","月桂新裁枝叶少。","一朵妖红，点破江烟晓。","最爱牵牛随意绕。","四阑青锦遮围了。"],0,204,"元"],["蝶恋花 清和即事","刘敏中","词",["池馆清和风色软。","笋绿梅黄，细雨忙新燕。","榴萼尚含红一半。","荷钱乱叠青犹浅。","心绪未忺肠已断。","病损形骸，自是追陪懒。","一缕麝烟斜作篆。","日长慵把重帘卷。"],0,204,"元"],["鹧鸪天","刘敏中","词",["一段清香云锦秋。","双花开处尽风流。","只应无语常相并，却是多情不自由。","湘水怨，汉滨愁。","淡烟斜日两悠悠。","凌波不下横塘路，对立西风共倚羞。"],0,204,"元"],["鹧鸪天 寿潘君美","刘敏中","词",["萱草堂前锦棣花。","灵椿树下玉兰芽。","二毛鬓莫惊青鉴，五朵云须上白麻。","携斗酒，醉君家。","春风吹我帽檐斜。","座中贵客应相笑，前日疏狂未减些。"],0,204,"元"],["鹧鸪天 祖母寿日","刘敏中","词",["绿牖凉霏紫麝尘。","宝猊晴暖瑞香云。","蟠桃日日瑶池宴，玉桂年年月殿馨。","潘岳赋，孟家邻。","尽将歌酒寿良辰。","慈颜剩为斑衣乐，眼底儿孙莫厌贫。"],0,204,"元"],["鹧鸪天 秋日","刘敏中","词",["竹瘦桐枯菊又开。","远山合抱水萦回。","几行银篆蜗行过，一朵梨花蝶舞来。","秋意思，闷情怀。","懒将闲事强支排。","倚栏目送归鸿尽，万里晴空入酒杯。"],0,204,"元"],["鹧鸪天 题双头莲二首","刘敏中","词",["脉脉谁教并蒂芳。","情缘何许苦难量。","西风香冷同幽怨，落日红酣对晚妆。","波浩荡，月微茫。","湘灵寂寞下横塘。","不堪回首鸳鸯浦，一样相思只断肠。"],0,204,"元"],["小重山 述怀","王丹桂","词",["猛悟尘劳跳出笼。","胸襟多少事，尽成空。","逍遥物外效愚蒙。","真脱洒，端的好家风。","启户对松峰。","红尘飞不到，白云中。","道心不与利心同。","开怀抱，高卧养疏慵。"],0,112,"元"],["凤栖梧 山居遣兴","王丹桂","词",["满目青青松间竹。","掩映山家，有甚闲荣辱。","独自唱吟斟美醁。","味浓醉倒和衣宿。","清梦觉来情未足。","重抱瑶琴，品弄无生曲。","谁是知音余伴侣。","草堂风月应相许。"],0,112,"元"],["凤栖梧 劝游春子","王丹桂","词",["嫩柳垂金花烂坼。","随处园林，拂袂香风快。","无限眼前闲景色。","只应妆点春光煞。","游骑骈骈驰雅态。","不道繁华，暗换朱颜改。","到底有情终不耐。","殷勤说与寻芳客。"],0,112,"元"],["凤栖梧 寄同道","王丹桂","词",["世事纷纷何事苦。","死去生来，轮贩无停住。","有幸高真开法宇。","引人同上无生路。","路上行人当听属。","属付虔诚，念道忘思虑。","清静功夫昭且著。","无生路上常相遇。"],0,112,"元"],["凤栖梧 清明前三日因微雨过示众","王丹桂","词",["割爱忘情惟谨谨。","兔走乌飞，催逼年华迅。","又是清明将欲近。","家家烟火宜防慎。","和气氤氲当宝运。","细雨廉纤，不负阳春信。","造化工夫犹此进。","仙葩迤逦飘香韵。"],0,112,"元"],["凤栖梧 暮春闻莺","王丹桂","词",["短景相催何太促。","丽日和风，又送春光暮。","渐听流莺枝上语。","绵蛮似把衷情诉。","昨日花开红满树。","今已飘零，狂荡逐飞絮。","奉劝游人生觉悟。","莫教失却来时路。"],0,112,"元"],["忆王孙","王丹桂","词",["不持斋戒不看经。","不论金丹共五行。","玉瑟闲调月正明。","韵轻清。","响彻瑶台十二层。"],0,112,"元"],["忆王孙","王丹桂","词",["几人学得我风流。","疏尽尘缘散尽愁。","闲品羌笛驾白牛。","好因由。","四大神舟任意游。"],0,112,"元"],["忆王孙","王丹桂","词",["本来真性唤神仙。","为爱幽栖远市廛。","独隐山堂妙最玄。","乐恬然。","欣即高歌困即眠。"],0,112,"元"],["忆王孙","王丹桂","词",["三田常用铁牛耕。","种得黄芽渐渐生。","法雨时时浇灌频。","转滋荣。","采摘归来上玉京。"],0,112,"元"],["忆王孙","王丹桂","词",["四时流转急如梭。","百岁韶华屈指过。","惟愿人人出爱河。","养冲和。","功满超升赴大罗。"],0,112,"元"],["忆王孙","王丹桂","词",["逍遥坦荡绝忧愁。","管甚流年春复秋。","露地安眠放白牛。","晚烟收。","一曲高歌古渡头。"],0,112,"元"],["忆王孙 因王孙二旧友同日不期而会","王丹桂","词",["闲闲闲里忆王孙。","今幸相逢语笑频。","各各勤修精气神。","行功臻。","同宴桃源碧洞春。"],0,112,"元"],["忆王孙 自咏","王丹桂","词",["云何便会做痴憨。","只为番番世事谙。","度日随缘不外贪。","处云庵。","渴饮醍醐味转甘。"],0,112,"元"],["忆秦娥 咏竹","王丹桂","词",["性贞洁。","柔枝嫩叶堪图写。","堪图写。","四时常伴，草堂风月。","孤高劲节天然别。","虚心永永无凋谢。","无凋谢。","绿阴摇曳，瑞音清绝。"],0,112,"元"]]