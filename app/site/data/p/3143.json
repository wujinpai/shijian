[["句","田叔通","残句",["铸剑斩佞臣。"],0,181,"宋"],["句 其六","释希昼","残句",["寄禅关树老，乞食塞城羌。"],0,164,"宋"],["句 其十二","蒋之奇","残句",["白云飞鸟皆在下，一江峡水向东流。"],0,62,"宋"],["句  其二","徐似道","残句",["小桃洗面添光泽，未点胭脂已自红。"],0,139,"宋"],["句 其二","叶廷珪","残句",["人休清樾摩挲认，鸟泊高枝睥睨看。"],0,113,"宋"],["句  其九二","释晓莹","残句",["贪看春山如许青。"],0,182,"宋"],["句","张康国","残句",["银檐不雨溜常滴，玉树无风花自开。"],0,29,"宋"],["句","葛次仲","残句",["荣枯不经意。"],0,178,"宋"],["句","罗舜举","残句",["腊酒催诗处，春幡剪彩时。"],0,232,"宋"],["句 其五","谌祜","残句",["白发古今天北极，黄华宇宙客西风。"],0,110,"宋"],["句 其四","李宗谔","残句",["门外溪山荆渚路，马前梅杏汉江春。"],0,206,"宋"],["句  其八四","释晓莹","残句",["谁教并向此中见。"],0,182,"宋"],["句 其二","谢景初","残句",["峰巅见沧海，日出常先最。"],0,164,"宋"],["句 其三","赵汝腾","残句",["芳草绿边陋鹦鹉，杨花飞处避河豚。"],0,47,"宋"],["句 其十四","韩驹","残句",["雨暗阶前路，苔冶林外家。"],0,"x104","宋"],["句 其六十","谌祜","残句",["万国梦回秦月在，千年事过蜀云飞。"],0,110,"宋"],["句","释宝印","残句",["满屋挂碑光耿耿。"],0,106,"宋"],["句 其二","曾致尧","残句",["云昏迷侯馆，树缺辨江湖。"],0,53,"宋"],["句 其十七","谌祜","残句",["中原一发天涯梦，元祐孤臣海外归。"],0,110,"宋"],["句 其二十二","张商英","残句",["如障如屏如绣画，似幢似盖似旌旗。"],0,116,"宋"],["句","王文淑","残句",["草草杯盘供语笑，昏昏灯火话平生。"],0,180,"宋"],["句","张宗尹","残句",["大书文字堤防老，剩买田园准备闲。"],0,3,"宋"],["句","刘清轩","残句",["可笑吴痴亡越憾，却夸范蠡作三高。"],0,210,"宋"],["句 其一","鲍慎由","残句",["三白岁可期，一饱分已定。"],0,180,"宋"],["句","释道臻","残句",["疑君魂梦在清都。"],0,110,"宋"],["句 其十五","孟宾于","残句",["自怜成事攀仙桂，谁似投闲向草莱。"],0,207,"宋"],["句 其十九","谌祜","残句",["看翻后夜月回照，梦忆前生地不同。"],0,110,"宋"],["句 其三","曾肇","残句",["鼎湖弓剑仙游远，渭水衣冠辇路新。"],0,26,"宋"],["句 其十五","冯坦","残句",["可怜门外新归燕，不见堂前旧主人。"],0,149,"宋"],["句","李申之","残句",["区区已上和亲策，安得元戎一点头。"],0,73,"宋"],["句 其二十七","谌祜","残句",["层城楼橹看如画，三镇军民梦解围。"],0,110,"宋"],["句  其三四","释晓莹","残句",["谈笑会当同。"],0,182,"宋"],["句 其一","赵讷轩","残句",["门外须臾风竹定，橹声摇曳出芦花。"],0,145,"宋"],["句 其十六","卢襄","残句",["客来如见小窗扉，便是山翁想山处。"],0,217,"宋"],["句 其二十五","石延年","残句",["几为物象添诗僻。"],0,42,"宋"],["句 其二","左誉","残句",["山色晚来犹入座，药苗春后自成畦。"],0,57,"宋"],null,["句","潘阆","残句",["散拽禅师来鞠蹴，乱拖游女上秋千。"],0,124,"宋"],["句  其二七","释晓莹","残句",["细柳乱摇风。"],0,182,"宋"],["句","崔仰之","残句",["山色监巴迥，江流入汉清。"],0,180,"宋"],["句","袁说友","残句",["水暗人家水拍堤。"],0,"x192","宋"],["句","彭奭","残句",["六龙极北瞻明主，三凤河东愧腐儒。"],0,1,"宋"],["句  其一","高元矩","残句",["砚贮寒泉碧，庭堆败叶红。"],0,168,"宋"],["句 其五",