[["和陶诗 其四 命子","李贤（原德","四言",["根株既培，已茂其柯。","元鼎见削，户乃设罗。","惟运则然，岂曰自窊。","在晋中业，起我长沙。"],0,208,"明"],["和陶诗 其五 命子","李贤（原德","四言",["呜呼长沙，乃懋厥德。","厥德不惑，受此方国。","王室赖焉，孰敢僭忒。","岂曰今人，古不易得。"],0,208,"明"],["和陶诗 其六 命子","李贤（原德","四言",["世有显人，吾何为始。","伟哉武昌，遗泽千里。","皇考继之，载安其止。","仕路有声，闻过则喜。"],0,208,"明"],["和陶诗 其七 命子","李贤（原德","四言",["瞻望前烈，予何能及。","艰辛备尝，未有成立。","矫性之偏，佩弦自急。","将类卞和，抱玉以泣。"],0,208,"明"],["和陶诗 其八 命子","李贤（原德","四言",["凡事预立，学贵及时。","五官之职，在心曰思。","君子修身，尚念于兹。","俨其敬哉，勿或怠而。"],0,208,"明"],["和陶诗 其九 命子","李贤（原德","四言",["孔道如日，老庄爝火。","君子为学，取舍由我。","事亲之孝，曾子云可。","勉旃真有，何事久假。"],0,208,"明"],["和陶诗 其十 命子","李贤（原德","四言",["人之良能，观此提孩。","伊既学矣，告往知来。","呜呼小子，尚竭其才。","尔不竭才，于我何哉。"],0,208,"明"],["和陶诗 其一 归鸟","李贤（原德","四言",["有鸟来归，栖于旧林。","白云依依，亦在其岑。","抱瓮之叟，厌彼机心。","云胡不息，恶木之阴。"],0,208,"明"],["和陶诗 其二 归鸟","李贤（原德","四言",["归鸟迟迟，不能奋飞。","森森灌木，载栖载依。","矧伊人矣，岂不怀归。","税吾驾矣，与世相违。"],0,208,"明"],["和陶诗 其三 归鸟","李贤（原德","四言",["有鸟来归，绕林徘徊。","岂不高举，乐此故栖。","双双比翼，其意则谐。","悠然见之，惬我襟怀。"],0,208,"明"],["和陶诗 其四 归鸟","李贤（原德","四言",["归鸟迟迟，林下萧条。","日既久矣，宿于丛标。","载戢其羽，鸣声交交。","亦既倦矣，云何能劳。"],0,208,"明"],["惩咎诗并启一首上大名张太守鄮西吴吏部少槐李翰林东岗","卢楠","四言",["于皇明祖，历数在躬。","龙翔淮甸，凤时金陵。","哲后继启，寔为太宗。","涤宇沙汉，定鼎北平。","鳦鸟肇迹，笃生我皇。","文思钦明，武烈威扬。","九壤流化，八叶载光。","越商轶周，方轨于唐。","赫赫明圣，鉴临下土。","阅兹藩魏，在漳之浒。","政狎民逸，不克时叙。","咨汝宰臣，孰宁予处。","天官曰都，张公臣邻。","懿思渊塞，迈德种勋。","三揖缁衣，五马白唇。","锡汝淮阳，以优王宾。","曰若李公，维帝喉舌。","逆鳞补衮，持稷紏契。","执宪匪回，万夫之特。","投章出郊，藩此南国。","曰维吴公，环拱紫微。","县衡泰垣，曳履龙墀。","三台中拆，骇栗天维。","怀玦之屏，绝景超辉。","象服有韡，式宴嘉会。","剑履云行，徽章雾丽。","丹霞扶轩，流飙承佩。","相协天人，调和鼎鼐。","振举颓纲，综厘群纪。","肃肃公徒，峨峨俊士。","有怀克绥，无颇不圮。","神人胥悦，黄耇称美。","繄余小子，髫龀载年。","圜彼桥门，执经陈虔。","虡磬玉鬯，琴瑟洞弦。","官师儆惎，我弼我愆。","嗟余小子，般乐肆射。","禽色交荒，曾匪日夜。","日居月诸，忽焉代谢。","长老有言，固而弗化。","履霜坚冰，积雪维霰。","福始祸基，致毁匪嫚。","臧获跋扈，竖牛之渐。","驾言锄挺，搆兹奇怨。","谁其为梗，职此厉阶。","行人牵牛，邑人之菑。","匪曰狡狂，孰为斯媒。","沉思窳圉，遐不怆怀。","蹇蹇王臣，侯来于京。","云驰四表，雷动八纮。","霜飞天钺，秋冠烈缨。","如追放豚，寘余典刑。","群公穷烛，察我冤隐。","洒以甘露，润此槁轸。","烁燹燎原，扑灭可近。","三宥弗张，六极迭惷。","犴狴勿密，缠牵永殛。","卧无曲肱，行有颠踣。","日星安施，违此昏墨。","维绁之傫，与余偃息。","大夜何长，伫视虚照。","魑魅僛偲，既嚬亦笑。","招之不来，迤逦入庙。","非予作孽，斯焉取造。","瞻彼卫澳，有苹有蘩。","祁祁士女，大佩琼璠。","以嬉以游，俯仰如神。","岂不尔怀，畏此棘垣。","麋鹿榛榛，虎豹伾伾。","号走旷野，啮肉茹爢。","夫我无食，不如尔怡。","欲往同群，驺虞在逵。","伊禽之介，黄鹄其羽。","千里一息，不遑宁处。","荡荡玄霄，俦克与伍。","有泚厚颜，莫不能举。","嗈嗈鸿雁，唼喋江湘。","弋人何篡，实汝瑶觞。","汝之匪觏，亦自云亡。","罪岂碆卢，俾我悲伤。","何我人斯，不如狱草。","晨光朝晞，零露夜灏。","草之油油，孤秀斯宝。","嗟予小子，胡不自好。","严父辞堂，慈母去闱。","二灵并暴，风雨中摧。","圜幽五稔，谁掩葛藟。","心膂惨伤，发肤当乖。","两稚失怙，咨命不永。","厥绪斩㔃，谁继余统。","马牛风埏，牧竖登陇。","万岁千秋，涕下如绠。","妻孥牵裙，将柰若何。","我有严刑，遑恤其它。","生当来归，死当长嗟。","兹其余辜，怨岂在遐。","谔谔三公，奕世夔龙。","投分绍运，骈翊帝衷。","力侔造化，志与神通。","何惜覆盆，照此微躬。","蠢尔黠虏，窥我华阙。","愿投有畀，亲冒矢石。","搴旗瀚海，奋剑沙碛。","雷毂雁门，电扫张掖。","捐躯国难，解颐龙鳞。","血化为碧，膏涂铁斤。","薄劣既弛，少谢陶钧。","死虽一辙，肝胆殊分。","天未悔祸，忧心烦劳。","怀贤如渴，德音式昭。","梦寐赤舄，仰止嵩高。","王泽弗竭，鉴我时髦。"],0,17,"明"],["杂兴五首 其一","卢楠","四言",["轻车载脂，良马且闲。","于盘于游，游览山川。","绿萝高林，鸟鸣关关。","神逸志悦，踞石饮泉。","划然长啸，鸣谷振烟。","青云何意，翱翔我前。","欲揽以登，倏然上天。","整巾顿缨，薄暮言还。"],0,17,"明"],["杂兴五首 其二","卢楠","四言",["巍巍苍山，汤汤洪河。","鸟集于林，鱼游于波。","飞潜攸扬，物谓尔何。","遵彼修陵，顾景高歌。","手弄旸熙，神渝天和。","日月迅迈，胡为蹉跎。"],0,17,"明"],["杂兴五首 其三","卢楠","四言",["采采石华，薄言江沚。","婉美者谁，中洲之士。","目余有成，惠若桃李。","遗我九垓，倏忽千里。","澹然遐思，俱兹流驶。"],0,17,"明"],["杂兴五首 其四","卢楠","四言",["揭旌蘅阪，弭盖昆丘。","砺齿石林，洗耳沧洲。","仰瞩归云，俯鉴川流。","从彼物化，操我虚舟。","冥心大壑，超然神游。","是谓维何，列子好仇。"],0,17,"明"],["杂兴五首 其五","卢楠","四言",["月生兰圃，云流华轩。","微风扇闺，曲池有澜。","旨酒既清，嘉殽且赡。","爰御琴瑟，一鼓再弹。","申此徽音，怀我所欢。","永言莫晤，云何吁叹。"],0,17,"明"],["凫墩","卢楠","四言",["东观岱岳，西引凫墩。","偃仰怙恃，有如子孙。","凫墩之容，温懿无弛。","轸父之疴，欢揄凫里。","白杨锵锵，矫若龙翔。","仰天一呼，烈石飞霜。","实毒我父，宁知我股。","䀌血溅溅，以瀹以釜。","父曰予瞢，啜此肴羹。","殆其有廖，欻如已酲。","稚笋之荐，江鱼之膳。","昔闻太史，今兹匪謴。","荆蜀之乡，爰有铜梁。","笃是异人，刑我有邦。"],0,17,"明"],["别友","邹元标","四言",["迢迢觅道，与道背驰。","归而求之，自有馀师。","朋友切切，兄弟怡怡。","大心体物，敬以自持。","实有诸已，信予匪欺。"],0,150,"明"],["仁文书院 其一","邹元标","四言",["父母生我，耳聪目明。","能思能索，手持足行。","至道难闻，宁虚此生。","乘时勉学，敢告同盟。"],0,150,"明"],["仁文书院 其二","邹元标","四言",["先立其大，在识本心。","时时默识，海里寻针。","把柄在手，点铁为金。","有鹤在林，遗我好音。"],0,150,"明"],["仁文书院 其三","邹元标","四言",["大明中天，千载一时。","无参意见，无涉支离。","卓彼先觉，示我良规。","上帝临汝，心实严师。"],0,150,"明"],["仁文书院 其四","邹元标","四言",["英贤济济，聚首一堂。","商搉疑义，剖晰毫芒。","凤毛麟趾，规圆矩方。","日新月盛，笃实辉光。"],0,150,"明"],["客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其一","邹元标","四言",["咬得菜根，百事可成。","不负天子，不愧苍生。"],0,150,"明"],["客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其二","邹元标","四言",["咬得菜根，可以躬耕。","无忝庭训，贻亲令名。"],0,150,"明"],["客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其三","邹元标","四言",["咬得菜根，进退惟轻。","舍我斯退，用我斯行。"],0,150,"明"],["客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其四","邹元标","四言",["咬得菜根，物不能撄。","如霆斯震，我心不惊。"],0,150,"明"],["客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其五","邹元标","四言",["咬得菜根，与世无争。","所至虚舟，坦坦平平。"],0,150,"明"],["客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其六","邹元标","四言",["咬得菜根，高卧柴荆。","何必崇膴，布衣也荣。"],0,150,"明"],["客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其七","邹元标","四言",["咬得菜根，义利严明。","为世之瑞，为国之祯。"],0,150,"明"],["客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其八","邹元标","四言",["咬得菜根，万善皆诚。","塞于天地，心迹双清。"],0,150,"明"],["客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其九","邹元标","四言",["咬得菜根，扶危定倾。","首阳人远，匪弟伊兄。"],0,150,"明"],["客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其十","邹元标","四言",["咬得菜根，顺事无情。","味虽澹薄，其中有精。"],0,150,"明"],["家训","邹元标","四言",["诗咏多福，易言馀庆。","积善之家，罔不繁盛。","眇予小子，厕名士绅。","愧无实德，裨补君民。","未能治国，愿教吾家。","敷诚布衷，寂听无哗。","凡我宗人，无忽予言。","洗心涤虑，培根达源。","敬奉天地，孝养双亲。","与其浊富，宁守清贫。","勿利货贿，嘱托上官。","小民叫冤，尔心何安。","输赋无讼，迹绝公室。","尊宪守约，终鲜差失。","里闬姻党，情谊无涯。","富贵轮流，转眼虚花。","出入以度，惟公惟平。","夜半叩门，尔心不惊。","永言孝思，世德作求。","我语谆谆，我心悠悠。","毫厘不差，神明临汝。","良心不昧，三复斯语。"],0,150,"明"],["默庵和尚","邹元标","四言",["莽莽谭禅，谁否谁得。","有喙三尺，横恣胸臆。","真学道者，先须一默。","甘苦自尝，无徒耳食。"],0,150,"明"],["书刘生卷 其一","邹元标","四言",["手开斯卷，剖晰玄微。","芝兰并馥，珠玉联辉。","愧我不学，启口知非。","冥心冥心，尚杜德机。"],0,150,"明"],["书刘生卷 其二","邹元标","四言",["圣远言湮，浑浇淳漓。","意真词繁，道德背驰。","问子痛痒，子必自知。","曰孝曰弟，归有馀师。"],0,150,"明"],["示昆弟","邹元标","四言",["告我诸弟，予猎浮名。","忆昔负遣，万死一生。","圣主恩深，归卧溪衡。","萧萧华发，绝知屏营。","人间毁誉，羽毛斯轻。","惟此簧鼓，世比蛙鸣。","水田之麓，可以躬耕。","岂无好我，示我周行。"],0,150,"明"],["勖从子","邹元标","四言",["勖哉诸子，无汨尔真。","诜诜轮轮，难得者身。","修身维何，蹈道履淳。","彼佻者子，自堕沈沦。","耽于酒色，比于匪人。","时移运失，受此艰辛。","光阴驹隙，黾勉青春。","纵尔不思，当念尔亲。"],0,150,"明"],["鹡鸰图并序，为大巷伍克和题三首 其一","黎贞","四言",["相彼鹡鸰，载飞载鸣。","念我兄弟，有恻斯情。","斯情维何，赋形同气。","因性合情，莫远具迩。"],0,228,"明"],["鹡鸰图并序，为大巷伍克和题三首 其二","黎贞","四言",["鹡鸰载飞，摇摇其尾。","有子和乐，媚我兄弟。","兄弟孔良，颙颙昂昂。","无有急难，茀禄尔常。"],0,228,"明"],["鹡鸰图并序，为大巷伍克和题三首 其三","黎贞","四言",["鹡鸰载鸣，啾啾其响。","兄弟具在，莫我遐想。","我酒既馨，我殽既旨。","斑衣彩裳，悦我父母。"],0,228,"明"],["柬薛剑公 其一","陈邦彦","四言",["朗如玉映，轩若霞举。","昔见其人，今闻其语。","谁同卫玠，亦有杜虎。","濯濯冰魂，城南无暑。"],0,126,"明"],["柬薛剑公 其二","陈邦彦","四言",["骙骙者驹，于城之隅。","梅花倚笛，如披其图。","薄言絷之，于城之阿。","罗敷有词，使君若何。"],0,126,"明"],["清远城陷题朱氏池亭 其一","陈邦彦","四言",["无拳无勇，无饷无兵。","联络山海，矢佐中兴。","天命不佑，祸患是婴。","千秋而下，鉴此孤贞。"],0,126,"明"],["送弟叔永入北雍 其一","区怀瑞","四言",["有雍者鸟，起于平楚。","僷僷其章，肃肃其羽。","天祚明德，来仪率舞。","瞻企云阊，于焉高举。"],0,98,"明"],["送弟叔永入北雍 其二","区怀瑞","四言",["桂峭珠泓，琛惟文明。","诞我家先，滃浡而兴。","佑启后嗣，子墨丕承。","芬苾哲弟，昭于上京。"],0,98,"明"],["送弟叔永入北雍 其三","区怀瑞","四言",["逢掖之光，遘兹圣作。","明堂辟雍，维新礼乐。","蔼蔼多士，抱经齿学。","或掇其席，或折其角。"],0,98,"明"],["送弟叔永入北雍 其四","区怀瑞","四言",["国之梓材，实储成均。","以桢以干，为槱为薪。","儒英有造，岁月为熏。","用享用宾，代侈其人。"],0,98,"明"],["送弟叔永入北雍 其五","区怀瑞","四言",["苑籞之需，云罗是急。","如彼骙骙，以莫不及。","斧藻国猷，中天而立。","贲若史宬，拓我家笈。"],0,98,"明"],["送弟叔永入北雍 其六","区怀瑞","四言",["尔之降祥，首于京师。","纶扉退食，闻礼闻诗。","藜火流辉，脉望隃麋。","苑树宫云，式是瞻依。"],0,98,"明"],["送弟叔永入北雍 其七","区怀瑞","四言",["大雅既波，文心为靡。","我有前徽，德言是以。","将似将续，惟予与尔。","将砥将慎，应于千里。"],0,98,"明"],["送弟叔永入北雍 其八","区怀瑞","四言",["千里有行，离思难任。","厥有倚闾，慈荀之林。","发之皑皑，涕之涔涔。","爱日惜阴，以慰其心。"],0,98,"明"],["答陆叔度 其一","区怀瑞","四言",["有赫广宇，德慧是充。","君子晖吉，小人屯蒙。","求我灵牖，律厥玄同。","宣幽导郁，以籁民风。","声希之始，黄钟之宫。"],0,98,"明"],["答陆叔度 其二","区怀瑞","四言",["代有述著，咸式斯轨。","变化日新，筌蹄拟议。","雅丧世波，谐于里耳。","不有卓者，其何能砥。","东南竹箭，实惟吾子。"],0,98,"明"],["答陆叔度 其三","区怀瑞","四言",["发彼昆山，其道骙骙。","酣我文心，元韵不醨。","濯锦璧宫，烨于京师。","如埙如篪，臭味之知。","云衢十舍，驽蹇能追。"],0,98,"明"],["答陆叔度 其四","区怀瑞","四言",["嗟予古癖，成于髫稚。","绣虎何功，丧羊于易。","千秋之衰，百里之寄。","途远心劳，达于梦寐。","载此衮章，愧以永岁。"],0,98,"明"],["送西充李铨部赴阙六首 其一","区怀瑞","四言",["峨峨铜梁，上拂井络。","东束夔门，北跨剑阁。","石擘五丁，鼎峙三国。","浚哲文明，光分于岳。"],0,98,"明"],["送西充李铨部赴阙六首 其二","区怀瑞","四言",["剖岳出神，佐命惟人。","玄圭素绂，青鹥黄麟。","于岷之源，于渝之坟。","因兹笃庆，玉友金昆。"],0,98,"明"],["送西充李铨部赴阙六首 其三","区怀瑞","四言",["昆弟孔硕，令德炜炜。","共捷南宫，逍遥云陛。","华萼河阳，连镳并轨。","或居柱史，或领驭士。"],0,98,"明"],["送西充李铨部赴阙六首 其四","区怀瑞","四言",["师济奋庸，论列在公。","邦家之祯，以莫不崇。","献替作猷，启事达聪。","鹓鹭羽簉，君子所充。"],0,98,"明"],["送西充李铨部赴阙六首 其五","区怀瑞","四言",["惟彼天步，需材以掖。","惟此简在，进贤是力。","朝采之间，阴阳消息。","帝曰得人，予嘉乃绩。"],0,98,"明"],["送西充李铨部赴阙六首 其六","区怀瑞","四言",["骙骙骖𬴂，将凌天阍。","髦誉弹冠，国士衔恩。","俾我药石，尝卑献尊。","何以纻衣，刍荛之言。"],0,98,"明"],["观山","虞堪","四言",["山无垢色，云无住心。","达人观之，其高且深。"],0,222,"明"],["题柏子庭画石菖蒲","虞堪","四言",["蹲此于菟，直捋尔须。","大啸一声，风清月孤。"],0,222,"明"],["临高台","王洪","四言",["今日不乐，登彼高台。","吹竹弹丝，与君徘徊。","发我浩歌，酌我金罍。","顾望四山，郁何崔嵬。","人生若寄，多忧何为。","岁月既遒，曾不我迟。","皎皎明月，泥沙蔽之。","灵蜦云飞，蝍且制之。","织女在室，不秉机杼。","惟星有鳖，不可以釜。","黄鹄一举，戾于云衢。","啁啁鸒斯，哂之枋榆。","莫高匪山，莫深匪海。","玄穹为幕，长河为带。","招彼黄鹄，俾为君驾。","君坐而驰，我以为御。","超厥泰邃，历天而游。","逍遥无为，以永千秋。"],0,0,"明"],["鲁林怀思","王洪","四言",["郁郁鲁林，有枌有檀。","逖我后裔，于越之间。","一本中分，爱念伊始。","我欲从之，不遐甚迩。","于川于舟，于陆于马。","岂不夙夜，于林之下。","岩岩鲁山，有庙奕奕。","羽籥琴瑟，左右有绎。","衍我圣祖，金石愔愔。","愿言靡获，实劳我心。","明明我祖，典常是纪。","恩被罔极，讵曰厥世。","穑夫之良，克念惟贤。","矧兹承德，敢有不虔。","乔乔林木，遗泽所萃。","穆穆我宗，四方所视。","惟积斯高，惟浚斯深。","匪古匪今，茂是德音。"],0,0,"明"],["黄石斋举子同馆勒双卮以寿 其一","倪元璐","四言",["杏坛推才，五台选德。","为是父儿，宜烦孔释。"],0,82,"明"],["黄石斋举子同馆勒双卮以寿 其二","倪元璐","四言",["今之黄童，乃在漳江。","是父是子，亦既有双。"],0,82,"明"],["题王季重石鼓淮河两歌","倪元璐","四言",["二千年古，九千里曲。","请无彼观，而此之读。","掷地作声，染字皆绿。","昌黎扶轮，少陵捧毂。"],0,82,"明"],["题画石为吴骏公","倪元璐","四言",["骨则有馀，态殊不足。","问之君平，传于五鹿。"],0,82,"明"],["画石为祝寰瀛 其三","倪元璐","四言",["人痴多肉，石狡去骨。","山灵世情，与汨俱没。"],0,82,"明"],["画石为祝寰瀛 其五","倪元璐","四言",["黝然以黑，蟠然以憨。","似随鱼网，出于江潭。","化书谭峭，想当盘桓。","烦子再往，敬问平安。"],0,82,"明"],["题扇石为王霁宇司马","倪元璐","四言",["静安以贞，轩翱而骋。","巫高见飞，李广疑寝。","其矫如虬，将萦似蚓。","备德矜能，肤清骨挺。","我将拜之，请君勿哂。"],0,82,"明"],["题画石为朱丈恒岳","倪元璐","四言",["中洞以灵，骨强而正。","使人如此，天下其定。"],0,82,"明"],["为胡甥武迁题扇石奉陈明卿祭酒 其一","倪元璐","四言",["结为地脉，奋为星精。","观其岳岳，有若文人。"],0,82,"明"],["为胡甥武迁题扇石奉陈明卿祭酒 其二","倪元璐","四言",["如其飞来，必有攫去。","此石头禅，不去不住。"],0,82,"明"],["画石为祝寰瀛","倪元璐","四言",["我醉欲眠，其中空洞。","静而有文，可不与语。","人痴多肉，石狡去骨。","山灵世情，与汨俱没。","比类连徒，棱棱岸岸。","黝然以黑，蟠然以憨。","似随鱼网，出于江潭。","化书谭峭，想当盘桓。","烦子再往，敬问平安。","居百尺楼，或拜其下。","熊经鸟申，可以长生。","善舞多窍，强骨能飞。"],0,82,"明"],["述先十章","区怀年","四言",["隆隆嘉运，硕彦是膺。","德沭温粹，言贲休明。","挠之不屈，溷之逾清。","懿型姱节，邦国之桢。","伊予肇宗，鬼臾斯衍。","匡翼有熊，令闻不殄。","厥祚悠长，逮于中宪。","受牧东瓯，崇勋懋展。","肃后方升，岛夷搆难。","屠民戕吏，井邑既殚。","宾资良牧，振旅桓桓。","挫彼狂狡，越以乂安。","鸟尽弓藏，昔贤所慑。","乐毅强燕，代于骑劫。","衮钺不侔，奸回肆谍。","遥遥副车，亶堕骏业。","天锡纯嘏，赫濯以昌。","笃生哲考，维珩维璜。","丕承先烈，微直肯堂。","跻于清庙，黼黻用光。","粤在定陵，份份文质。","孰佐论思，既轨既物。","豹尾宣麻，螭头载笔。","夙夜惟寅，昭其罔佚。","珠辉玉灿，穆穆其容。","爰承简命，作友储宫。","陈诗绎典，纳诸谦冲。","乃赞三礼，百辟景从。","直道寡援，孤行速谤。","谗人訾訾，清时弗谅。","休养天闲，宸衷特贶。","夷然引退，戒此羸壮。","达生无我，高谊薄云。","冥情显晦，泉石娱真。","玄风独迈，逸藻缤纷。","芟厥蘩秽，功在斯文。","嗟我小子，匿瑕丛类。","负荷不堪，濒于废坠。","遑遑昕夕，尔勖尔励。","缅维慎修，敢云保世。"],0,170,"明"],["呈司徒季父五章","区怀年","四言",["廓哉二仪，至道克塞。","孰是仔肩，元夫有则。","被仁弘义，渊毅方直。","四国景行，其仪不忒。","精一之旨，往哲肇宣。","汇流洙泗，实浚其源。","繄余季父，独刊陈筌。","居然堂奥，德业攸尊。","植德既丰，秉节维纯。","绝彼奸回，济此国屯。","乃丁阳九，越在隐沦。","志存身晦，卓尔天民。","丘园适贲，性学阐敷。","朋来豫乐，斯人为徒。","周旋謦咳，允著嘉谟。","冥于化运，曷问荣枯。","滔滔末世，情欲是縻。","垫乎昏瞀，惟父振之。","履道坦坦，慎言偲偲。","抉微修慝，玄襟匪夷。"],0,170,"明"],["丰草六章","区怀年","四言",["萋萋丰草，漠漠长林。","裴回昕夕，实慰我心。","往哲是模，岂繄自今。","顾瞻飞鸟，爰写鸣琴。","丰草萋萋，长林漠漠。","裴回昕夕，我心既获。","火耨刀耕，资用匪薄。","时乎不遇，考槃斯托。","炎疢既消，景物斯和。","招从邻曲，幽事实多。","晤言诜诜，遂及笑歌。","今我不乐，来日如何。","得失之际，宣尼有言。","苟能衡命，不讳执鞭。","庸知所好，淡薄自耑。","优哉悠哉，聊以永年。","孰是保躯，而非明哲。","漱彼清泠，荫此嘉樾。","心遥晷驶，言念綦切。","巧者劳劳，我任其拙。","舍生徇物，岂情所宜。","一丘一壑，自谓过之。","饥则待炊，闲当命卮。","寤寐无忝，庶其免而。"],0,170,"明"],["善哉行","邝露","四言",["出彼城𬮱，有车辚辚。","四时成岁，值此穷阴。","鸡声喔喔，贯于青林。","百蛰族处，尔独何心。","羽物斯升，鳞物斯沉。","忧之瘁矣，钟此劳人。","劳人伊何，抚斧伐柯。","前修不远，古处弗讹。","盈盈如月，旦暮有缺。","哀我人斯，惟忧用说。","善哉善哉，日往月来。","琴歌有道，经德不回。"],0,176,"清"],["短歌行","邝露","四言",["和乐安康，有琴在堂。","今我不御，白日其行。","行道迟迟，载渴载饥。","抽琴命操，眷彼路岐。","峨峨九华，有粲其花。","顾言思子，中心弗遐。","槐棘阴阴，兰蕙同心。","道之云远，怀子好音。","嗷嗷云雁，鸣声及旦。","君子有酒，以速亲串。","梓兮桑兮，无枝可栖。","有鱼赪尾，困彼沙泥。","高山有桐，比于林中。","鹓雏税羽，君子攸同。","河则有图，洛则有书。","畀贞之吉，千载不渝。"],0,176,"清"],["初信学题","杨起元","四言",["一是百是，一非百非。","行远自迩，登高自卑。","迩却无渐，卑却无梯。","圣凡隔处，一悟一迷。","口诀无多，格物致知。"],0,53,"明"],["再证学改题","杨起元","四言",["何者曰是，何者曰非。","无远胡迩，无高胡卑。","是谓无渐，是谓无梯。","无凡无圣，无悟无迷。","口诀从今，无物无知。"],0,53,"明"],["羊城示同志 其一","杨起元","四言",["茫茫岭海，秀毓文明。","光天帝德，暨我苍生。","将无往哲，作我仪刑。"],0,53,"明"],["羊城示同志 其二","杨起元","四言",["往哲伊谁，遗编可稽。","由来太音，其声孔希。","按谱操弦，听者以疑。"],0,53,"明"],["羊城示同志 其三","杨起元","四言",["嗟予昏昏，幼诵古文。","日迈月征，四十无闻。","诸子我从，惭赧何云。"],0,53,"明"],["羊城示同志 其四","杨起元","四言",["予虽寡陋，尚幸师友。","诲我道真，信吾固有。","愿言与子，是图是究。"],0,53,"明"],["羊城示同志 其五","杨起元","四言",["物备诸身，道不远人。","简则有功，易则有亲。","纤毫费力，尚隔一尘。"],0,53,"明"],["羊城示同志 其六","杨起元","四言",["惟尽乃心，始知乃性。","卤莽灭裂，惟学之病。","甘为夷稗，岂曰无竞。"],0,53,"明"],["题上官参军册","杨起元","四言",["幕天藉地，枕琴荫榉。","厥形偃仰，厥心伛偻。","有命自天，封章赐予。","益恭益虔，循墙若惧。","同气之亲，火待而举。","缥帙盈箧，名士所与。","好善若渴，孰厌其取。","混迹在朝，超神在墅。","谁为肖之，梦觉蘧蘧。","其后寝昌，视此题句。"],0,53,"明"],["题夏氏象贤图 其一","杨起元","四言",["于惟夏氏，爰自伯禹。","于其子孙，播越南土。","暨入皇明，文儒绳武。"],0,53,"明"],["题夏氏象贤图 其二","杨起元","四言",["赫赫荆门，经明道尊。","克勤内行，孝友是敦。","爱日遗荣，我风如春。"],0,53,"明"],["题夏氏象贤图 其三","杨起元","四言",["翼翼潼川，克箕克裘。","皋皮再设，谈易不休。","白下耆英，邈然寡俦。"],0,53,"明"],["题夏氏象贤图 其四","杨起元","四言",["瞿瞿宁海，其德靡晦。","礼学庭趋，秩任郎贵。","遘闵不出，伤禄不逮。"],0,53,"明"],["题夏氏象贤图 其五","杨起元","四言",["爰自曾孙，规衿矩裾。","衡门楼迟，乐彼琴书。","训厥后昆，作为此图。"],0,53,"明"],["题夏氏象贤图 其六","杨起元","四言",["予交曾孙，廿载以往。","嘉汝世儒，钦此遗像。","为作此诗，以告来襁。"],0,53,"明"],["寄曹鲁川 其一","杨起元","四言",["往夏徂秋，君惠来游。","足我平生，其乐绸缪。","招招舟子，曾不我留。"],0,53,"明"],["寄曹鲁川 其二","杨起元","四言",["往秋徂冬，雨雪蒙蒙。","搔首延伫，有鳞有鸿。","善保岁寒，如何弗衷。"],0,53,"明"]]