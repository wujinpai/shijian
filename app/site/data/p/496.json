[["补茅鸱 其四","丘光庭","四言",["茅鸱茅鸱，无𠵾我陵。","汝食汝饱，莫我好声。","愿弹去汝，来彼苍鹰。","来彼苍鹰，祭鸟是征。"],0,28,"唐"],null,null,["唐享昊天乐 第十","武则天","四言",["肃肃祀典，邕邕礼秩。","三献已周，九成斯毕。","爰撤其俎，载迁其实。","或升或降，惟诚惟质。"],0,96,"唐"],null,null,["补茅鸱 其二","丘光庭","四言",["茅鸱茅鸱，无啄我雀。","汝食汝饱，莫我肯略。","愿弹去汝，来彼瑞鹊。","来彼瑞鹊，其音可乐。"],0,28,"唐"],["补茅鸱 其一","丘光庭","四言",["茅鸱茅鸱，无搏𫛽鹠。","汝食汝饱，莫我为休。","愿弹去汝，来彼鸤鸠。","来彼鸤鸠，食子其周。"],0,28,"唐"],["郊庙歌辞 释奠文宣王乐章 诚和","佚名","四言",["圣道日用，神几不测。","金石以陈，弦歌载陟。","爰释其菜，匪馨于稷。","来顾来享，是宗是极。"],0,"x14","唐"],["郊庙歌辞 享懿德太子庙乐章 迎俎酌献","佚名","四言",["雍雍盛典，肃肃灵祠。","宾天有圣，对日无期。","飘飖羽服，掣曳云旗。","眷言主鬯，心乎怆兹。"],0,"x14","唐"],null,["郊庙歌辞 享先农乐章 咸和","佚名","四言",["三推礼就，万庾祈凝。","夤宾志远，藨衮惟兴。","降歆肃荐，垂祐祗膺。","送神有乐，神其上升。"],0,"x14","唐"],["遗简诗 其一","赵惠宗","四言",["生我于虚，置我于无。","至精为神，元气为躯。","散阳为明，合阴为符。","形为灰土，神为仙居。","众垢将毕，万事永除。"],0,98,"唐"],null,["冬夜宴萧十丈因饯殷郭二子西上","息夫牧","四言",["有琴斯鸣，于宰之庭。","君子莅止，其心孔平。","政既告成，德以永贞。","鸣琴有衎，于颍之畔。","彼之才髦，其年未冠。","闻诗闻礼，斐兮璨璨。","鸣琴其怡，于颍之湄。","二子翰飞，言戾京师。","有郁者桂，爰攀其枝。","琴既鸣矣，宵既清矣。","烘煁有炜，酒醴惟旨。","喟我寤叹，吁其别矣。"],0,221,"唐"],["蝉鸣一篇五章 五","宋华","四言",["岁之秋深，蝉其夕吟。","披衣轩除，萧萧风林。","我友来斯，言告离衿。","何以叙怀，临水鸣琴。","何以赠言，委顺浮沈。"],0,78,"唐"],null,["蝉鸣一篇五章 一","宋华","四言",["蝉其鸣矣，于彼疎桐。","庇影容迹，何所不容。","嘒嘒其长，永托于风。","未见君子，我心仲仲。","既见君子，乐且有融。"],0,78,"唐"],["蝉鸣一篇五章 三","宋华","四言",["蝉鸣蝉鸣，幽畅乎而。","肃肃尔庭，远近凉飔。","言赴高柳，丛篁间之。","思而不见，如渴如饥。","亦既觏止，我心则夷。"],0,78,"唐"],["蝉鸣一篇五章 四","宋华","四言",["蝉鸣伊何，时运未与。","匪叹秋徂，怨斯路阻。","愿言莫从，郁悒谁语。","君子至止，慰我延伫。","何斯违斯，倏尔遐举。"],0,78,"唐"],null,["蝉鸣一篇五章 二","宋华","四言",["彼蝉鸣矣，于林之表。","含风饮露，以乐吾道。","有怀载迁，伊谁云保。","未见君子，我心悄悄。","既见君子，披豁予抱。"],0,78,"唐"],["郊庙歌辞 周宗庙乐舞辞 福顺","佚名","四言",["新庙奕奕，金奏洋洋。","享于祖考，循彼典章。","清酤特满，嘉玉腾光。","神醉既告，帝祉无疆。"],0,"x14","唐"],["郊庙歌辞 释奠文宣王乐章 肃和","佚名","四言",["粤惟上圣，有纵自天。","傍周万物，俯应千年。","旧章允著，嘉贽孔虔。","王化兹首，儒风是宣。"],0,"x14","唐"],["郊庙歌辞 周宗庙乐舞辞 禋顺","佚名","四言",["旨酒既献，嘉殽乃迎。","振其鼗鼓，洁以铏羹。","肇禋肇祀，或炮或烹。","皇尸俨若，保飨是明。"],0,"x14","唐"],["郊庙歌辞 祀九宫贵神乐章 雍和","佚名","四言",["俎豆有践，黄流在尊。","九宫之祀，三代莫存。","乐变六宫，坛开八门。","圣皇昭对，祐我黎元。"],0,"x14","唐"],null,["游长安诸寺联句 翊善坊保寿寺 光天帧赞联句","段成式","四言",["观音化身，厥形孔怪。","胣脑淫厉，众魔膜拜。","指梦鸿纷，牓列区界。","其事明张，何不可解。","阎阿德川，大士先天。","众象参罗，福源田田。","百亿花发，百千灯然。","胶如[络绎]，浩汗连緜。","燄摩界戚，洛迦苦霁。","正念皈依，众青如𥶙。","戾滓可汰，痴膜可蜕。","稽首如空，睟容若睇。","阐提墨师，覩而面之。","寸念不生，未遇乎而。"],0,113,"唐"],["郊庙歌辞 周朝飨乐章 忠顺","佚名","四言",["岁迎更始，节及朝元。","冕旒仰止，冠劒相连。","八音合奏，万物齐宣。","常陈盛礼，愿永千年。"],0,"x14","唐"],["郊庙歌辞 周朝飨乐章 忠顺","佚名","四言",["明君当宁，列辟奉觞。","云容表瑞，日影初长。","衣冠济济，钟磬洋洋。","令仪克盛，嘉会有章。"],0,"x14","唐"],["郊庙歌辞 周朝飨乐章 忠顺","佚名","四言",["礼成三爵，乐毕九成。","共离金戺，复列彤庭。"],0,"x14","唐"],["郊庙歌辞 周朝飨乐章 忠顺","佚名","四言",["明庭展礼，为龙为光。","咸韶息韵，鹓鹭归行。"],0,"x14","唐"],["郊庙歌辞 明皇祀圜丘乐章 豫和","佚名","四言",["至矣丕搆，烝哉太平。","授牺膺箓，复禹继明。","草木仁化，凫鹥颂声。","祀宗陈德，无媿斯诚。"],0,"x14","唐"],["郊庙歌辞 明皇祀圜丘乐章 豫和","佚名","四言",["大号成命，思文配天。","神光肸蚃，龙驾言旋。","眇眇阊阖，昭昭上玄。","俾昌而大，于斯万年。"],0,"x14","唐"],["郊庙歌辞 明皇祀圜丘乐章 肃和","佚名","四言",["止奏潜聆，登仪宿啭。","太玉躬奉，参钟首奠。","簠簋聿升，牺牲遰荐。","昭事颙若，存存以伣。"],0,"x14","唐"],["郊庙歌辞 周宗庙乐舞辞 观成舞","佚名","四言",["穆穆王国，奕奕神功。","毖祀载展，明德有融。","彝樽斯满，簠簋斯丰。","纷𫄨旄羽，锵洋磬钟。","或升或降，克和克同。","孔惠之礼，必肃之容。","锡以纯嘏，祚其允恭。","神保是飨，万世无穷。"],0,"x14","唐"],["道藏歌诗 三十八","佚名","四言",["斩灭六天，严整北酆。","束精缚妖，受事玉皇。"],0,"x14","唐"],null,["留别卢陲","崔少玄","四言",["得之一元，匪受自天。","太老之真，无上之僊。","光含影藏，形于自然。","真安匪求，神之久留。","淑美其真，体性刚柔。","丹霄碧虚，上圣之俦。","百岁之后，空余坟丘。"],0,38,"唐"],["郊庙歌辞 享节愍太子庙乐章 迎俎酌献","佚名","四言",["嘉荐有典，至诚莫骞。","画梁云亘，雕俎星连。","乐器周列，礼容备宣。","依稀如在，若未宾天。"],0,"x14","唐"],["讲德联句","皎然","四言",["先王设位，以正邦国。","建立大官，封植有德。","二南敷化，四岳述职。","其言不朽，其仪不忒。","暨于嬴刘，乃创程式。","罢侯置守，剖竹分域。","赫矣皇唐，康哉立极。","精选藩翰，庸资正直。","爰命我公，东土作则。","克己恭俭，疲人休息。","济济闾闬，油油黍稷。","既富既教，足兵足食。","恤其凋瘵，剪其荆棘。","威怀逋叛，扑灭蝥贼。","疾恶如雠，闻善不惑。","哀矜鳏寡，旌礼儒墨。","乃修堤防，乃浚沟洫。","以利通商，以溉嘉谷。","征赋以节，计功以时。","人胥怀惠，吏不能欺。","我政载孚，我邦载绥。","猛兽不暴，嘉鱼维滋。","肃恭明神，齐沐不亏。","岁或骄阳，雨无愆期。","帝嘉有庸，宠命来斯。","紫绂载绥，金章陆离。","资忠履孝，阅礼敦诗。","明德惟馨，自天祐之。"],0,"x22","唐"],null,null,["乐府古题序 君莫非","元稹","四言",["鸟不解走，兽不解飞。","两不相解，那得相讥。","犬不饮露，蝉不噉肥。","以蝉易犬，蝉死犬饥。","燕在梁栋，鼠在阶基。","各自窠窟，人不能移。","妇好针缕，夫读书诗。","男翁女嫁，卒不相知。","惧聋摘耳，效痛嚬眉。","我不非尔，尔无我非。"],0,"x4","唐"],null,["恺悌诗（幷序） 良哉二章（一章十句，一章十二句）（良哉，协帝赉也。） 一","孙宗闵","四言",["巨望弥耸，其德不回。","乃眷西顾，赉公贤才。","帝曰钦往，时称良哉。","乃邦之彦，实民之怀。","飞荣骊阙，进秩兰台。","。"],0,137,"唐"],["唐大飨拜洛乐章 通和","武则天","四言",["皇皇灵眷，穆穆神心。","暂动凝质，还归积阴。","功玄枢纽，理寂高深。","衔恩佩德，耸志翘襟。"],0,96,"唐"],["恺悌诗（幷序） 宜兮一章（二十句）（宜兮，洽民心也。）","孙宗闵","四言",["启藩斯境，民之宜兮。","令必响赴，动而悦随。","濬明宣哲，淑慎经彝。","善化郁郁，群心披披。","我有惸独，公则安之，我有弟子，公则教之。","匪民之宜，实德之基，实邦之基。","帝典昭灼，王度清夷。","说命将举，慰兹群黎。"],0,137,"唐"],["道藏歌诗 四十六","佚名","四言",["司命保算，丹书南昌。","解技七元，腐骨更蓊。"],0,"x14","唐"],null,["五郊乐章 黄帝宫音 雍和","魏征","四言",["金悬夕肆，玉俎朝陈。","飨荐黄道，芬流紫辰。","廼诚廼敬，载享载禋。","崇荐斯在，惟皇是宾。"],0,152,"唐"],null,null,["大蜀高祖潜龙日献陈情偈颂","贯休","四言",["有叟有叟，居岳之室。","忽振金汤，下彼巉崪。","闻蜀风景，地宁得一。","富人侯王，旦奭摩诘。","龙角日角，紫气盘屈。","揭日月行，符汤禹出。","天步孔艰，横流犯跸。","穆穆蜀俗，整整师律。","髯发垂雪，忠贞贯日。","四人苏活，万里丰谧。","无雨不膏，有露皆滴。","有叟有叟，无实行实。","一瓶一衲，既朴且质。","幸蒙顾盼，词煖恩郁。","轩镜光中，愿如善吉。"],0,"x30","唐"],null,["祈谷乐章 雍和","褚亮","四言",["殷荐乘春，太坛临曙。","八簋盈和，六瑚登御。","嘉稷匪歆，德馨斯饫。","祝嘏无易，灵心有豫。"],0,150,"唐"],["郊庙歌辞 中宗祀昊天乐章 雍和","佚名","四言",["郊坛展敬，严配因心。","孤竹箫管，空桑瑟琴。","肃穆大礼，铿锵八音。","恭惟上帝，希降灵歆。"],0,"x14","唐"],null,["郊庙歌辞 明皇祀圜丘乐章 寿和","佚名","四言",["六变爰阕，八阶载虔。","祐我皇祚，于万斯年。"],0,"x14","唐"],["郊庙歌辞 明皇祀圜丘乐章 寿和","佚名","四言",["于赫圣祖，龙飞晋阳。","底定万国，奄有四方。","功格上下，道冠农黄。","郊天配享，德合无疆。"],0,"x14","唐"],["郊庙歌辞 明皇祀圜丘乐章 寿和","佚名","四言",["崇崇泰畤，肃肃严禋。","粢盛既洁，金石毕陈。","上帝来享，介福爰臻。","受厘合祉，宝祚维新。"],0,"x14","唐"],["《酉阳杂俎》引语 四","佚名","四言",["得合澜𧑏，虽不足豪，亦足以高。"],0,"x14","唐"],["中和乐九章 歌中宫第五","卢照邻","四言",["祥游沙麓，庆洽瑶衣。","黄云昼聚，白气宵飞。","居中履正，禀和体微。","仪刑赤县，演教椒闱。","陶钧万国，丹青四妃。","河洲在咏，风化攸归。"],0,250,"唐"],["三月三日宴王明府山亭","崔知贤","四言",["京洛皇居，芳禊春余。","影媚元巳，和风上除。","云开翠帟，水鹜鲜居。","林渚萦暎，烟霞卷舒。","花飘粉蝶，藻跃文鱼。","沿波式宴，其乐只且。"],0,221,"唐"],["唐德明兴圣庙乐章 迎俎","李纾","四言",["盛牲实俎，涓选休成。","鼎煁阳燧，玉盥阴精。","有𫗣嘉豆，既和大羹。","侑以清乐，细齐人情。"],0,255,"唐"],["白金小还丹歌 其十","罗公远","四言",["铜铁坏形，丹灰损力。","欲验其神，须存本色。","一阴一阳，事易候则。","异族同群，自种荆棘。"],0,204,"唐"],["白金小还丹歌 其一","罗公远","四言",["法药变化，无非水精。","六芝润色，黄芽自生。","阳光不起，阴流无声。","道方秘易，学者难成。"],0,204,"唐"],["白金小还丹歌 其二","罗公远","四言",["既养黄男，先禁家鬼。","尽死扶金，余生制水。","世人能明，并穷斯理。","亲奉圣言，事难自揣。"],0,204,"唐"],["白金小还丹歌 其四","罗公远","四言",["黄子淳淑，自娶玄妃。","金成力厚，药就身肥。","土宅三分，火房二仪。","至德消阴，纯阳幽微。"],0,204,"唐"],["白金小还丹歌 其七","罗公远","四言",["赭涂四壁，丹守圆扉。","一居火匮，二处灰池。","五蟾可保，三乌无疑。","道情未速，益日加奇。"],0,204,"唐"],["白金小还丹歌 其三","罗公远","四言",["笼虚其底，免被炎驰。","知白守黑，清黄一支。","能忌阴秽，不逾百时。","延生大道，易解难知。"],0,204,"唐"],["白金小还丹歌 其六","罗公远","四言",["言依口诀，亲贵手传。","七日自伏，万刻牢坚。","千炼万煑，托在五贤。","好蕴金器，不绝玄关。"],0,204,"唐"],["白金小还丹歌 其八","罗公远","四言",["一黄二白，三铢两作。","养至满蟾，生其高鹤。","事忌他非，道身自乐。","传受非人，天殃地虐。"],0,204,"唐"],["白金小还丹歌 其五","罗公远","四言",["一味白金，固人衰朽。","杂性难防，同心易守。","服食千粒，百日无咎。","万疴渐除，天地同寿。"],0,204,"唐"],["白金小还丹歌 其九","罗公远","四言",["芽属黄男，药属玄女。","外助无非，玉芝清醑。","俗士多闻，道君少语。","用物参差，虚受辛苦。"],0,204,"唐"],null,null,null,null,["冲佑观","张绍","四言",["大始未形，混沌无际。","上下开运，乾坤定位。","日月丽天，山川镇地。","万汇犹屯，三才始备。","肇有神化，初生蒸民。","上惟立德，下无疏亲。","皇风荡荡，黔首淳淳。","天下有道，谁非圣人。","开源嗜欲，浇漓俗盛。","贤者避世，真人华命。","八极神乡，十州异境。","翠阜丹丘，潜伏灵圣。","惟彼武夷，实曰洞天。","峰峦黛染，岩岫霞鲜。","金房玉室，羽盖云𫐌。","葬日风雨，会有神仙。","国步多艰，皇纲中绝。","四海九州，瓜分幅裂。","稔祸陬隅，阻兵瓯越。","寂寞玄风，荒凉绛阙。","赫赫烈祖，再造丕基。","拱揖高让，神人乐推。","明明我后，允协昌基。","功崇下武，德茂重熙。","睿哲英断，雄略神智。","拓土开疆，经天纬地。","五岭来庭，三湘清彻。","四海震威，群生怀惠。","犹劳宵旰，犹混马车。","贪狼俟静，害焉方除。","淹留骏驭，想像鹑居。","心悬真洞，梦到华胥。","乃眷名山，追惟圣迹。","内库颁金，元侯奉职。","三境求规，五灵取则。","跨谷弥冈，张霄架极。","珠宫宝殿，璇台玉堂。","凤翔高甍，龙转回廊。","错落金碧，玲珑璧珰。","云生林楚，雷绕藩墙。","七圣斯严，三君如在。","八景灵舆，九华神盖。","清霄莫胥，明霜匪对。","彷佛壶中，依稀物外。","众真之宇，拟之无伦。","会仙之类，名之惟新。","高峰为壑，区谷成坰。","皇献颂声，永绝淄磷。"],0,29,"唐"],["三月三日宴王[明]府山亭","高球","四言",["洛城春禊，元巳芳年。","季伦园里，逸少亭前。","曲中举白，谈际生玄。","陆离轩盖，凄清管弦。","萍疎波荡，柳弱风牵。","未淹欢趣，林溪夕烟。"],0,198,"唐"],null,["郊庙歌辞 梁郊祀乐章 庆隆","张衮","四言",["恭祀上帝，于国之阳。","爵醴是荷，鸿基永昌。"],{"yz":["赵光逢"]},68,"唐"],["乐府古题序 田野狐兔行","元稹","四言",["种豆耘锄，种禾沟甽。","禾苗豆甲，狐榾兔翦。","割鹄𫗪鹰，烹麟噉犬。","鹰怕兔毫，犬被狐引。","狐兔相须，鹰犬相尽。","日暗天寒，禾稀豆损。","鹰犬就烹，狐兔俱哂。"],0,"x4","唐"],["长安人为宋清语（题拟）","佚名","四言",["人有义声，卖药宋清。","（同前卷中）。"],0,"x14","唐"],null,["遗简诗 其二","赵惠宗","四言",["吾驾时马，日月为卫。","洞耀九霄，上谒天帝。","明明我众，及我门人。","伪道养形，真道养神。","懋哉懋哉，余无所陈。"],0,98,"唐"],["郊庙歌辞 释奠文宣王乐章 雍和","佚名","四言",["堂献瑶篚，庭敷璆县。","礼备其容，乐和其变。","肃肃亲享，雍雍执奠。","明德惟馨，苹蘩可荐。"],0,"x14","唐"],["恺悌诗（幷序） 心如水兮二章（一章十句，一章八句）（心如水兮，志尚清洁矣。） 一","孙宗闵","四言",["我公之心，含渊濬洁。","挹之弥冲，酌而莫竭。","灵府汪洋，璇源莹彻。","若鉴之明，如井之洌。","利物至柔，漱芳弥潏。","。"],0,137,"唐"],["恺悌诗（幷序） 心如水兮二章（一章十句，一章八句）（心如水兮，志尚清洁矣。） 二","孙宗闵","四言",["行业滋茂，言泉洞开。","浸仁沐义，津贤育材。","润无不洒，清而不回。","叔度之顷，公何远哉。"],0,137,"唐"],null,["判导江县申状封皮上著状门府衙","宋光嗣","四言",["勅加开府，不是门府。","典押双眇，令佐单瞽。","量提书罚，胜打十五。","令佐盘庚，典押岁取。","事了速归，用修廨宇。"],0,187,"唐"],["《灌畦暇语》引常言","佚名","四言",["一作一止，知人表里。","（《灌畦暇语》）。"],0,"x14","唐"],null,null,null,["恺悌诗（幷序） 惠风二章（一章十二句，一章八句）（惠风，民被赐也。） 二","孙宗闵","四言",["猎野班春，苏萌润坼。","腾茂英英，扬光赫赫。","福介群黎，欢飞广陌。","敢继周诗，式歌召伯。"],0,137,"唐"],["恺悌诗（幷序） 惠风二章（一章十二句，一章八句）（惠风，民被赐也。） 一","孙宗闵","四言",["习习惠风，施于千里。","吹淡民心，洽兹仁理。","动必响臻，应如草靡。","泠泠四驰，飘飘中起。","利物厚生，条纲振纪。","鼓音埙箎，发馨兰芷。"],0,137,"唐"]]