[["送马书升之江西","董以宁","杂言",["春风倦羽各差池，携手还倾酒一卮。","《别赋》送将南浦去，漫游安用《北山移》？","城头月落骊歌早，江上花明雀舫迟。","但慰诸生迎绛帐，欲闻长笛更何时。"],0,51,"清"],["闲中好•闺夏","董以宁","杂言",["闲中好，茉莉香中坐，珠汗怕沾纱。","红绒罢绣花。"],0,51,"清"],["荷叶杯•相逢曲","董以宁","杂言",["若个粉郎娇艳。","当面。","多事一凝眸。","恰逢小妹乍回头。","羞么羞。","羞么羞。"],0,51,"清"],["渔歌子•相思曲","董以宁","杂言",["银蒜低垂睡起迟。","楝花天气耐相思。","羞对镜，怯吟诗。","午倦添香入被池。"],0,51,"清"],["捣练子•桥头","董以宁","杂言",["金作勒，玉为羁。","小马惊香何处嘶。","红板桥头扉半掩，几丝杨柳挂黄鹂。"],0,51,"清"],["忆江南•叩叩词","董以宁","杂言",["章台女，叩叩结新欢。","堂下每迎花底笑，人前私向镜中看。","可许一生拚。"],0,51,"清"],["忆王孙•春闺","董以宁","杂言",["东风庭院暗香恬。","半树梨花压画檐。","眉黛无端簇一尖。","晚愁添。","细雨潇潇不卷帘。"],0,51,"清"],["如梦令•赋别","董以宁","杂言",["绮语和郎细诵。","红袖半肩轻拥。","忘却漏声催，早是信鸡催送。","珍重。","珍重。","此去画桥霜冻。"],0,51,"清"],["风流子•久别","董以宁","杂言",["已是别时惆怅。","更是而今惝恍。","空寄语，未逢欢，愁被春风吹长。","自怜一样。","眼角眉梢心上。"],0,51,"清"],["长相思•舟泊","董以宁","杂言",["片云留。","片云流。","水远山长客子愁。","如何是尽头。","一孤洲。","一孤舟。","憔悴天涯黑敝裘。","相思玳瑁楼。"],0,51,"清"],["望梅花•过鹦鹉洲","董以宁","杂言",["芳草萋萋如画。","唤起祢生闲话。","死向风波曾不怕。","长裤请君穿罢。","除是阿瞒还值骂。","黄祖不堪君诧。"],0,51,"清"],["调笑令•赋张巡妾","董以宁","杂言",["记取。","和君语。","自读睢阳闻笛句。","纵馀黄土无归处。","莫洒双双红箸。","愿日后携侬巾帼，二十四城传去。"],0,51,"清"],["醉太平•寿玉虬叔三十叔别号云痴","董以宁","杂言",["苏仙李仙。","张颠米颠。","其诗其字之间。","许云痴并肩。","书帘茗烟。","琴弦画笺。","年年长向花前。","著金貂醉眠。"],0,51,"清"],["感恩多•鸿信","董以宁","杂言",["昨夜传鸿信。","雨后花扶病。","兼传病有因。","为郎颦。","忒觉情多，真假转难分。","转难分。","便是空言，忍猜他未真。"],0,51,"清"],["点绛唇•江晚","董以宁","杂言",["去去江舟，烟中山色浑无据。","落云迎屿。","雁向潇湘去。","晚浦观渔，不辨渔人语。","花如絮。","月芦深处。","那里汀头住。"],0,51,"清"],["点绛唇•消闲","董以宁","杂言",["无可消闲，不愁怎得光阴过。","绿窗赓和。","佯说愁城大。","强约愁来，愁也来何莫。","曾经么。","和衣独卧。","今夜愁真个。"],0,51,"清"],["点绛唇•闺思","董以宁","杂言",["翠被葡萄，轻笼金鸭香烟重。","梅花影动。","小阁寒宵共。","到得而今，无计凰求凤。","愁千种。","一场春梦。","又被灯花哄。"],0,51,"清"],["点绛唇•旅赠","董以宁","杂言",["旅馆黄昏，檠灯襆被钟声悄。","心烟缥缈。","只是随郎袅。","眉语低时，暗计行程早。","如何好。","画眉虽巧。","五日张京兆。"],0,51,"清"],["女冠子•春闺","董以宁","杂言",["柳绵吹怯。","不费东风着力。","看来迟。","曲沼经行处，回廊遍倚时。","鸳鸯游冶子，鹦鹉滑稽儿。","见人消瘦尽，笑人痴。"],0,51,"清"],["浣溪纱•晓","董以宁","杂言",["幽梦宵来托锦胶。","起看杂树已花交。","不禁莲瓣一轻敲。","盥手试香按豆蔻，开奁占喜得蟏蛸。","绣床针帖尚闲抛。"],0,51,"清"],["浣溪纱•夜","董以宁","杂言",["淡月回廊几处湾。","花阴潜入候双镮。","残灯明灭未曾还。","落绣正窥金约腕，罢妆犹系玉连环。","一重屈戌隔蓬山。"],0,51,"清"],["浣溪纱•赋别梁溪主人","董以宁","杂言",["十里珠帘正冶游。","好乘青雀下苏州。","双银曾寄杏花楼。","爱尔一樽桑落酒，迟予三日木兰舟。","春风寒到紫鼷裘。"],0,51,"清"],["浣溪纱•闺思集句","董以宁","杂言",["欲作家书意万重。","美人千里思何穷。","眼看春尽不相逢。","几处吹笳明月夜，一声肠断绣帷中。","秋波不动簟纹融。"],0,51,"清"],["减字木兰花•村落","董以宁","杂言",["柴门傍岸。","白板双桥连曲断。","水涨花溪。","一夜东风没钓矶。","渔童叉髻。","待攀细柳穿双鲤。","细柳条条。","拖得黄鹂拂板桥。"],0,51,"清"],["菩萨蛮•舟次集唐","董以宁","杂言",["一樽酒尽青山暮。","雨昏青草湖边过。","沙浅浪痕交。","云帆碍浦桥。","潮平两岸阔。","古木疑撑月。","何事与心违。","潇湘人未归。"],0,51,"清"],["菩萨蛮•代伊","董以宁","杂言",["阿娘碎语绵如絮。","檀郎只好心头贮。","音信日来稀。","思伊转恨伊。","此情频欲寄。","又恐伤郎意。","斟酌数行书。","言欢字字虚。"],0,51,"清"],["卜算子•雪江晴月","董以宁","杂言",["明月淡飞琼，阴云薄中酒。","收尽盈盈舞絮飘，点点轻鸥咒。","晴浦晚风寒，青山玉骨瘦。","回看亭亭雪映窗，淡淡烟垂岫。"],0,51,"清"],["丑奴儿令•闺怨","董以宁","杂言",["欢情别恨匆匆换，欢是前宵。","别是今朝。","一样轻魂两样销。","梦来梦去迢迢觅，去梦郎招。","来梦奴邀。","两处轻魂一处飘。"],0,51,"清"],["醉太平•金钱卜","董以宁","杂言",["鹊儿不断。","灯儿不管。","紫姑仙不曾明判。","掷金钱再算。","青蚨飞去还飞转。","只郎去、归偏缓。","待点六爻还未半。","奈心丝先乱。"],0,51,"清"],["清平乐•私语","董以宁","杂言",["已将身许。","敢比风中絮。","可奈檀郎疑又虑。","未肯信侬言语。","便将一缕心烟。","花间敛衽告天。","若负小窗欢约，来生丑似无盐。"],0,51,"清"],["占春芳•金盆濯发","董以宁","杂言",["看翠雨，香缭绕，乱绾正三分。","斜插牙梳欲堕，云边钩月初新。","待洗忽含颦。","为檀郎、银剪留痕。","遮藏且唤双鬟去，莫捧金盆。"],0,51,"清"],["相思引•为云孙咏侍儿小福","董以宁","杂言",["年纪花梢半未谙。","柔情先似再眠蚕。","偏将串结，珍重叠香函。","闲伴夫人同斗草，沉思未敢摘宜男。","郎情深浅，还向梦回参。"],0,51,"清"],["忆秦娥•堪讶","董以宁","杂言",["殊堪讶。","自将阿骛无端嫁。","无端嫁。","留他不得，掉他不下。","眤人秋水临行泻。","旧时团扇应难舍。","应难舍。","看他明日，耐他今夜。"],0,51,"清"],["忆秦娥•闺怨","董以宁","杂言",["迎风哢。","隔帘长自莺声哄。","莺声哄。","起来无力，睡来无梦。","记得当年南浦送。","双斟鹊脑情千种。","情千种。","低眉款语，几声珍重。"],0,51,"清"],["忆秦娥•鹦哥","董以宁","杂言",["猫来也。","鹦哥唤道哥哥打。","哥哥打。","声声忏悔，摩诃般若。","美人怜惜愁偏惹。","粉盂喂肉犀帘下。","犀帘下。","金笼半启，雪衣轻洒。"],0,51,"清"],["忆秦娥•冶游","董以宁","杂言",["郎君去。","郎君骏马谁家住。","谁家住。","垆前绿酒，床前红炬。","游丝欲系春风絮。","睡花蝴蝶痴情绪。","痴情绪。","千金博得，明眸一觑。"],0,51,"清"],["画堂春•夏日课婢掌书","董以宁","杂言",["几床书卷散牙签。","闲时信手常拈。","抛来高枕帙谁缄。","好倩纤纤。","莫把燃脂污染，还将辟蠹香添。","频频亲捧向冰帘。","一卷楞严。"],0,51,"清"],["画堂春•浣葛","董以宁","杂言",["衣纹单复尽能匀。","怜伊大好腰身。","那堪常傍葛衣尘。","酒污馀痕。","凭向银床漫洗，任教莲杵频闻。","桁边风透帐边熏。","一缕氤氲。"],0,51,"清"],["画堂春•浇花","董以宁","杂言",["为怜春去惜芳菲。","将泉欲滴花枝。","秃襟小袖汲来迟。","别样腰肢。","细洒恐溅裙幅，徐倾好沁香脾。","一枝轻摘衬乌丝。","拣又多时。"],0,51,"清"],["画堂春•晒药","董以宁","杂言",["茂陵消渴未全瘥。","奁中药裹偏多。","一丸休认枕边挼。","错皱双蛾。","晒久频移花影，暄侵小褪香罗。","窃来休向桂婆娑。","伴了姮娥。"],0,51,"清"],["画堂春•烹茶","董以宁","杂言",["落花风里绿烟轻。","听来细细涛声。","凭携方曲向茶铛。","蟹眼时烹。","洗处轻攒素笋，尝时小破朱樱。","定瓷亲捧更盈盈。","仙掌初倾。"],0,51,"清"],["画堂春•挥扇","董以宁","杂言",["满庭花影日光烘。","芳姿挟扇偏慵。","唤来珠汗正融融。","细舀荷风。","拂去篆烟缥缈，捉来玉指菁葱。","淡红耙袜映酥胸。","微样轻容。"],0,51,"清"],["画堂春•侍浴","董以宁","杂言",["堕鬟初卸拭轻纨。","绿云回手重盘。","笑郎新沐髻如丸。","何日弹冠。","半晌劳挼澡豆，几回羞倚阑干。","待穿犊鼻好同看。","月挂林端。"],0,51,"清"],["画堂春•拂簟","董以宁","杂言",["冰丝簟子出蕲州。","铺来湘水平流。","为郎拂拭向纱帱。","凉沁如秋。","每到宵来重展，却怜晓起偏羞。","臂痕人讶细纹留。","今夜拚休。"],0,51,"清"],["喜迁莺•染甲","董以宁","杂言",["拈金凤，捣朱砂。","纤指染红葩。","殷勤捧得玉瓯茶。","光映绿沉瓜。","莫轻弹，休更剪。","夜半搔时谁见。","落霞琴上不曾差。","流水泛桃花。"],0,51,"清"],["海棠春•闺词，补和程村阮亭韵 晓妆","董以宁","杂言",["画楼檐马琤琮响。","花几片、乱飘蛛网。","日射水晶帘，影动波纹漾。","牡丹松髻梳新样。","为镜里、人儿心赏。","薄帨贮犀帘，娇额风前敞。"],0,51,"清"],["海棠春•午睡","董以宁","杂言",["夜来花睡何曾足。","把往事、欲抛心曲。","欹枕小钗横，软衬芙蓉褥。","衣痕细细肌匀肉，半醒处、咳成珠玉。","唤煮鹧鸪茶，烟漾纱窗竹。"],0,51,"清"],["海棠春•晚浴","董以宁","杂言",["梧桐月暗人无影。","私瞰处、旧愁都醒。","灯晃背湘帘，玉堕春波冷。","金钗卸向银华镜。","拂拭久、绿云犹整。","箫局漫熏衣，几度添宫饼。"],0,51,"清"],["海棠春•夜坐","董以宁","杂言",["芭蕉却报黄昏雨。","听不断、莲花双杵。","拥膝更支颐，趺坐浑无语。","冶游试问谁边去。","全不听、城头谯鼓。","应教短辕中，挥秃琅琊麈。"],0,51,"清"],["庆春时•日长","董以宁","杂言",["半窗阁绣，幺弦罢曲，漫火馀香。","玉人此际，妆成无事，才觉日初长。","银骢何处，等闲嘶过红墙。","莺簧吹转，柳绵飞起，尽日好思量。"],0,51,"清"],["摊破浣溪纱•晓起","董以宁","杂言",["晓拥香篝意惘然。","祇因芳梦记难全。","起向药栏浑独立，倩谁圆。","倭堕髻垂遮领字，水沉香透结衣船。","闲整新妆还自顾，惜娟娟。"],0,51,"清"],["眼儿媚•江上鸳鸯","董以宁","杂言",["初春嫩绿染香溪。","鸳鸯作阵飞。","迷香曲处，双双三六，若个情痴。","新来怕见离愁事，镇日并头栖。","韩朋冢下，窦家机上，不肯相依。"],0,51,"清"],["桃源忆故人•拟代","董以宁","杂言",["鸳鸯枕上青山誓。","话得十分容易。","不料有头无尾。","枉受他调戏。","知他又把前翻计。","别院应还重试。","暗笑那人知未。","薄幸从前既。"],0,51,"清"],["烛影摇红•偶笔","董以宁","杂言",["到得而今，须眉已逐簪笄嫁。","应知孝弟力田科，却是东陵跖。","消受酒晨花夜。","便游侠、不将名借。","青蝇休吊，龙泉太阿，汝知我者。"],0,51,"清"],["鬲溪梅令•赋得卧房阶下插鱼竿","董以宁","杂言",["帘前绿水映云屏。","自盈盈。","敲得银针独向、画栏凭。","粉郎归未曾。","粉郎空有许多情。","未均匀。","好似帘钩偏重、帐钩轻。","鱼钩只几分。"],0,51,"清"],["西地锦•同三五女伴道小名","董以宁","杂言",["不合相携斗草。","把小名轻告。","邻娃便说，而今输却，把小名争叫。","万一侬家输了。","宁可酬花钞。","怕他帘外，侍儿窃语，并檀郎知道。"],0,51,"清"],["极相思•赋得有约不来过夜半","董以宁","杂言",["玉箫阁在花茵，留记月波痕。","朱扉半掩，青灯半灭，作意销魂。","半晌月痕移旧处，风淅淅、几度微闻。","明知不是，伊家屧响，聊且开门。"],0,51,"清"],["留春令•浣手绣观音","董以宁","杂言",["兰汤浴手，窗前先就，红莲娇片。","须记他原少凌波，休错配、鸳鸯线。","绣着金身须半面。","似向侬青眼。","春笋纤纤近慈云，疑紫竹、林中现。"],0,51,"清"],["瑶池燕•开帘引燕","董以宁","杂言",["当年曾僭。","昭阳殿。","燕燕。","移家新到珠院。","双双见。","蕙花半箭。","衔来健。","妒双双、画阁穿遍。","将帘掩。","雌雄暂教违面。","心休蹇。","三生今欠。","须方便。"],0,51,"清"],["思越人•高轩过","董以宁","杂言",["避车尘，调蟋蟀，甘称闭户先生。","多事乘轩还过访，方知人重功名。","黄金不与侬厮认。","原是床头冰冷。","何物误人田二顷。","散与酒徒须尽。"],0,51,"清"],["杏花天•忆梦","董以宁","杂言",["云眠月醉青山卧。","把好梦、背他偷做。","杏笺方欲双题和。","忽被寒涛鼓破。","奈未梦、心情犹可。","到梦后、凄凉怎过。","呼奴好伴挑灯坐。","今夜梦来须躲。"],0,51,"清"],["双调望江南•闺夜","董以宁","杂言",["和郎坐，闲话说东家。","小鸭漫烧宫里饼，香涛滚泼雨前茶。","春去且由他。","和郎坐，妆卸玉簪斜。","戏谱新诗题册叶，轻移小盏护灯花。","迟迟入帐纱。"],0,51,"清"],["江月晃重山•初避人","董以宁","杂言",["几片桃花𫖃面，一围蝶翅披肩。","当初生小在人前。","游郎到，回避只今年。","饮笑央人索扇，低眸唤婢垂帘。","犹飘红袖出屏间。","还偷觑，轻踢凤鞋尖。"],0,51,"清"],["鹧鸪天•忆","董以宁","杂言",["豆蔻香含正未笄。","三年嫣笑手长携。","羽衾熨处分龙脑，罗幞缝成索麝脐。","花并蒂，燕双栖。","合欢犹卜紫姑乩。","傍人已道成连理，惹得春山翠黛低。"],0,51,"清"],["鹧鸪天•绣苑","董以宁","杂言",["绣苑晴光尽日佳。","更无愁思望天涯。","名花结果春前定，小鸟姻缘枝上谐。","缠锦带，脱金钗。","秋千架子近香街。","彩绳握处开裙衩，多少香风正入怀。"],0,51,"清"],["鹧鸪天•别","董以宁","杂言",["赋得将离向绮窗。","桃花流水送游艭。","柔肠乍结先回九，小字亲钩定取双。","同玉案，伴银缸。","惯来一晌不惊尨。","多情恐逐浮萍去，发愿拈针绣佛幢。"],0,51,"清"],["鹧鸪天•寄","董以宁","杂言",["两小无猜直到今。","丙寅鹊脑惯同斟。","鸳鸯向午常交颈，豆蔻多时始见心。","曾赋别，几嗣音。","天涯南北雁难寻。","归来朱鸟窗前看，应有蛛丝网画琴。"],0,51,"清"],["鹧鸪天•叹","董以宁","杂言",["是处常来好当家，惯从明镜看朝霞。","梦中犹认崔娘枕，扇底难披温令纱。","人忽别，思无涯。","归来空讶七香车。","迎风一笑回头望，䯼髻双簪并蒂花。"],0,51,"清"],["鹧鸪天•慰","董以宁","杂言",["何处春风着柳斜。","深深庭院绿阴遮。","每弹指处闻花叹，自抵牙时为曲差。","频减膳，漫呼茶。","莫将惆怅饯年华。","门前流水蓝桥锁，犹度当初金犊车。"],0,51,"清"],["鹧鸪天•昨夜","董以宁","杂言",["昨夜天孙罢锦梭。","轻槎无恙到明河。","几经私语全珍重，再试真心薄谴诃。","羞月姊，避鹦哥。","玉人频问夜如何。","最怜蝴蝶惊魂骤，输与庄生晓梦多。"],0,51,"清"],["虞美人•临风寄语","董以宁","杂言",["花阴空覆鸳鸯寝。","寒入红衾凛。","早知好事付秋风。","何似当初索性不相逢。","闻伊别后思量意。","窃自沾沾喜。","累伊憔悴倍心伤。","又望伊家索性不思量。"],0,51,"清"],["虞美人•限韵咏池上杨妃海棠","董以宁","杂言",["马嵬坡上杨妃血。","洒遍枝和节。","依稀犹是旧檀心。","却似唐宫睡去夜初深。","梅妃应笑胭脂重。","欲唤从前梦。","临池照处映鱼茵。","疑向三郎传语倩双鳞。"],0,51,"清"],["南乡子•舟次集唐","董以宁","杂言",["疏雨过春城。","夹岸桃花锦浪生。","复有楼台衔暮景，新晴。","树里南湖一片明。","噭噭夜猿鸣。","野渡无人舟自横。","蝴蝶梦中家万里，三更。","行尽江南数十程。"],0,51,"清"],["南乡子•客舍集唐","董以宁","杂言",["回首一伤神。","暮雨千家薜荔村。","燕子不来花着雨，黄昏。","寂寞山窗掩白云。","归思欲沾巾。","雨过山城见月新。","独在异乡为异客，思亲。","断续鸿声到晓闻。"],0,51,"清"],["一斛珠•佳人剧马掉","董以宁","杂言",["团𪢮有对，小花兜肚殊堪爱。","而今多放金钗在。","天女散花，贺倒须教倍。","小姑乱掉全无谓。","三叶风旗都扯碎。","侬家更有鸳鸯背。","不喜金钗，私喜名儿美。"],0,51,"清"],["东坡引•十赍词示婢还九首 其一 湖镜","董以宁","杂言",["苕溪前岁住。","曾把银华铸。","玉台犹恐尘埃驻。","须将珍重贮。","须将珍重贮。","伊家自信，倾城无侣。","试照向、帘前去。","个中人也将人觑。","肯教他让汝。","肯教他让汝。"],0,51,"清"],["东坡引•十赍词示婢还九首 其二 杭粉","董以宁","杂言",["粉丸铅雪冶。","捻就和兰麝。","几年西子湖头买。","开函香尚惹。","开函香尚惹。","慇勤赠与，料应称谢。","却留向、湘帘下。","道侬真色何曾借。","不堪珠汗洒。","不堪珠汗洒。"],0,51,"清"],["东坡引•十赍词示婢还九首 其三 济宁油胭脂","董以宁","杂言",["朱唇何待染。","刺绣怜香腕。","不龟手药任城换。","簪来挑与看。","簪来挑与看。","剔开寸纸，腥红腻软。","偏半晌、沉吟玩。","问郎原碟多应满。","是谁分一半。","是谁分一半。"],0,51,"清"],["东坡引•十赍词示婢还九首 其四 如皋篦","董以宁","杂言",["如皋人射雉。","曾把湘篦寄。","匀排密比多坚致。","与谁除发腻。","与谁除发腻。","记他枕上，兰膏微滓。","便唤向、风前试。","原来背后无人倚。","腕伸怜玉臂。","腕伸怜玉臂。"],0,51,"清"],["东坡引•十赍词示婢还九首 其五 六合肥皂","董以宁","杂言",["才梳云髻亸。","旋把新羹做。","药垆茶灶时时课。","恐教纤手涴。","恐教纤手涴。","雄州皂荚，捣成百和。","涴手处、挼挲过。","夜深推枕钩郎卧。","馀香犹在么。","馀香犹在么。"],0,51,"清"],["东坡引•十赍词示婢还九首 其六 馀东手巾","董以宁","杂言",["香巾何细洁。","云是馀东织。","见他珠汗融融湿。","换他红耙袜。","换他红耙袜。","绣床闲挂，有时轻折。","将素手、频频拭。","拭时莫把双银脱。","应防侬欲窃。","应防侬欲窃。"],0,51,"清"],["东坡引•十赍词示婢还九首 其七 建宁香袋","董以宁","杂言",["缝成红素绢。","妆就鸳鸯线。","双双蟢子双双燕。","一双图半面。","一只图半面。","系他裙衩，氤氲堪羡。","愿翠管、郎亲捻。","翻来覆去教郎见。","这边题欲遍。","这边题欲遍。"],0,51,"清"],["东坡引•十赍词示婢还九首 其八 川扇","董以宁","杂言",["泥金叠扇子。","别样成都纸。","盘来双凤云如绮。","藏时曾见未。","藏时曾见未。","偶然检出，携来花底。","早捉向、纤纤指。","轻摇莫便心儿喜。","秋风明日起。","秋风明日起。"],0,51,"清"],["东坡引•十赍词示婢还九首 其九 蕲簟","董以宁","杂言",["簟纹冰玉润。","独有侬床衬。","伊家臂上微微印。","怕人容易认。","怕人容易认。","当初买向，田家古镇。","遣长物、应难吝。","与伊铺在纱帷近。","银灯将欲晕。","银灯将欲晕。"],0,51,"清"],["临江仙•昨夜","董以宁","杂言",["昨夜玉人迎笑处，石榴花压重墙。","湘帘垂遍郁金堂。","筹分双陆局，帖较十三行。","韵事好消清昼永，旧欢无奈思量。","轻魂销在镜台旁。","缘随骰采卜，酒带口脂尝。"],0,51,"清"],["一剪梅•酒兰歌示程村","董以宁","杂言",["与君诗酒两相于。","座有红于。","尊有青于。","湘兰不并草轩于。","山鸟刑于。","山花友于。","夜阑联袂鼓绵于。","舞罢神于。","吹罢茵于。","徐徐卧去觉于于。","一石淳于。","一梦淳于。"],0,51,"清"],["一剪梅•如词","董以宁","杂言",["惯得相携花下游。","苏大风流。","苏小风流。","而今别况冷于秋。","燕去南楼。","人去西楼。","等闲平判十分愁。","侬在心头。","卿在眉头。","少年心事总悠悠。","一曲扬州。","一梦苏州。"],0,51,"清"],["后庭宴•谴燕","董以宁","杂言",["紫燕双依，雕梁并语。","拴帘不放伊飞去。","问伊昨夜过香溪，见郎那里花间住。","一回卷上帘儿，放去寻郎何处。","待晚归来，街得黏泥絮。","似诉画楼前，薄幸人如许。"],0,51,"清"],["蝶恋花•落拓","董以宁","杂言",["身是暮春风里絮。","浮蚁呼卢，到便牵留住。","弦索笙箫声乱处。","一围红袖争诗句。","以客为家家似寓。","偶尔来家，收拾闲情绪。","阿妇惊疑前致语。","问郎何不归家去。"],0,51,"清"],["渔家傲•黄鹤楼边渔艇","董以宁","杂言",["孤篷渔艇烟中驾。","晴川自写吴绫帕。","渔子不知身是画。","呼妇骂。","问钱昨夜存多寡。","网得巨鱼惊又诧。","复呼阿妇欢然话。","黄鹤楼边闲去耍。","沽酒罢。","归来月上山头乍。"],0,51,"清"],["苏幕遮•帘外听堕钗声","董以宁","杂言",["玉钩垂，犀箔护。","肯递春风，偏断游丝路。","内里暗闻钗响度。","掷地金声，抵得天台赋。","望明妆，遮薄雾。","闹扫虽松，窣堕知何故。","难道拔时纤手误。","倘为侬来，忽地回头顾。"],0,51,"清"],["苏幕遮•花间听弹指声","董以宁","杂言",["绿初回，红渐出。","树树春交，把手轻来折。","为底关心攀又歇。","无语无言，自把螺纹画。","爪才修，琴罢拨。","啮遍纤痕，独向东风剔。","毕竟思量春可惜。","待问分明，瞥去屏山隙。"],0,51,"清"],["苏幕遮•窗下听咳声","董以宁","杂言",["粉罘罳，金屈戌。","花影交加，昨夜扶行处。","欲嗽还惊兰玉饫。","低锁轻喉，不放随风去。","怪重来，偏未遇。","窗外蒙蒙，立尽三更雨。","不是嗽声能听取。","便认衣香，难捉迷藏住。"],0,51,"清"],["苏幕遮•回廊听鞋底声","董以宁","杂言",["月初沉，星欲滴。","一带回廊，曲曲犹能觅。","暗数栏杆应六七。","听遍行踪，不是伊家屧。","步偏那，行转怯，似待如迎，却是来时节。","半晌消停怜窄窄。","两瓣轻莲，晓起看无迹。"],0,51,"清"],["苏幕遮•屏边听浴声","董以宁","杂言",["兔华轻，萤照冷。","瞰浴潜来，转傍湘帘等。","谁料银屏遮凤胫。","小玉娇憨，枉赚黄金饼。","粉应消，珠定映。","唤取汤添，冷热心头省。","豆蔻方挼知未竟。","半晌才看，秃袖来花径。"],0,51,"清"],["苏幕遮•楼前听骰子声","董以宁","杂言",["凤箫停，鸾幕启。","十二楼高，结遍春风绮。","今夜玉人慵不倚。","骰子逡巡，掷向纤纤指。","似无愁，如有思。","漫想闲猜，卜甚心头事。","转忆前宵楸局里。","观点牙筹，赌喝双双雉。"],0,51,"清"],["苏幕遮•房中听唤婢声","董以宁","杂言",["绮窗明，金屋暖。","香篆浮帘，脉脉垂银蒜。","翠幔欲搴行又缓。","生怕鸦鬟，闲话长和短。","茗须烹，花待灌。","檀口轻圆，频把兰香唤。","唤久不来谁作伴。","知造伊家，独坐床台畔。"],0,51,"清"],["苏幕遮•灯下听剪刀声","董以宁","杂言",["紫纹绫，红锦缎。","裁向灯前，响杂黄金钏。","应恐鸳鸯分背面。","钿尺频移，停处商量遍。","晃还移，人未倦。","叠股并刀，运处分明见。","万缕愁肠萦莫遣。","欲断仍连，试倩萧娘剪。"],0,51,"清"],["苏幕遮•隔幛听梦魇声","董以宁","杂言",["穗煤昏，莲漏杳。","只隔重帏，远似蓬莱岛。","魂梦知他何处绕。","欲醒频呼，话觉糊涂好。","养娘痴，香婢小。","憨睡瞢腾，只索将伊叫。","狂梦魇来应未料。","试问伊家，可唤江郎觉。"],0,51,"清"],["苏幕遮•帐畔听流苏响声","董以宁","杂言",["枕珊瑚，床玳瑁。","悬蛤初收，帐底容难照。","忘却流苏能转掉。","漫揭轻罗，傍动银钩了。","响原轻，声渐俏。","睡熟鹦哥，定不惊他觉。","和月和云和被抱。","一夜春风，散尽愁多少。"],0,51,"清"]]