[["句","耶律夫人","残句",["挑灯教子哦新句，冷淡生涯乐有馀。"],0,32,"元"],["句","暨氏","残句",["多情樵牧频簪髻，无主峰莺任宿房。"],0,243,"元"],["句","段明","残句",["方今天下平犹易，自古云南守独难。"],0,43,"元"],["句","陈日照","残句",["池鱼便作鹍鹏化，燕雀安知鸿鹄心。"],0,202,"元"],["句","世子","残句",["自顾不才惭锡土，只缘多病欠朝天。"],0,126,"元"],["句","陈秀峻","残句",["三世八丧千古痛，一身万里百年孤。"],0,248,"元"],["句","阮圣训","残句",["巢鸟寄林休伐木，蚁封在地未耕田。"],0,212,"元"],["句","圆照","残句",["篱下重阳菊，枝头淑气樱。"],0,191,"元"],["句","柳淑","残句",["不是忠衰诚意薄，大名之下久居难。"],0,119,"元"],["春日田园杂兴","子问","残句",["驱却馀寒碎土牛，田园生计又从头。"],0,248,"宋"],["春日田园杂兴","老农","残句",["幸存耕雨地，况值养花天。"],0,111,"宋"],["春日田园杂兴","双涧","残句",["雨露桑麻晴夜话，清明花柳少年心。"],0,79,"宋"],["春日田园杂兴","白云人","残句",["犊外醉分芳草卧，莺边吟踏落花行。"],0,176,"宋"],["春日田园杂兴","缺名","残句",["社近记穿黄茧子，雨前趱摘紫枪茶。"],0,243,"元"],["春日田园杂兴","山野人","残句",["莺藏杨柳金歌舞，蝶宿梨花雪梦魂。"],0,110,"宋"],["春日田园杂兴","廷云","残句",["蛙鸣暮夜官何为，蝶恋芳菲梦不知。"],0,117,"宋"],["句","翁某","残句",["地下修文同父子，人间读传各君臣。"],0,8,"元"],["句","镇江郡人","残句",["亿千万劫山长在，一百八声天未明。"],0,78,"元"],["句","康衢遗民","残句",["桑麻已接东西亩，禾麦相连上下田。"],0,221,"元"],["句","张某","残句",["草中人不见，空外鹤先知。"],0,115,"宋"],["句","某神童","残句",["分得两头轻与重，世间何事不担当。"],0,15,"元"],["春帖残句","吴朝进","残句",["儿辈功名来铁定，老夫安乐直钱多。"],0,57,"元"],["画壁诗残句","陈大娘","残句",["百年尘事浑如梦，留与丹心照汗青。"],0,139,"元"],["元谶","佚名","残句",["大元之后有庚申。"],0,"x217","元"],["马氏铁券谶","佚名","残句",["至元十五六，狗儿坏我屋。"],0,"x217","元"],["信州路谶","佚名","残句",["水打巷村园，永丰出状元。"],0,"x217","元"],["颂程雪楼","佚名","残句",["闽中有雪方为贵，天下无楼如此高。"],0,"x217","元"],["至治间占","佚名","残句",["天狗坠地为赤犬，其下有大军覆境。"],0,"x217","元"],["李好文谚","佚名","残句",["目耕夜分李好文。"],0,"x217","元"],["绍兴乡人语","佚名","残句",["欲学孝妇，当学俞母。"],0,"x217","元"],["浙西谚","佚名","残句",["年年防火起，夜夜防贼来。"],0,"x217","元"],["无锡谶","佚名","残句",["无锡平，天下宁。"],0,"x217","元"],["三险谚","佚名","残句",["馩香吸髓倚阑干。"],0,"x217","元"],["巴豆黄连谚","佚名","残句",["巴豆未开花，黄连先结子。"],0,"x217","元"],["金银珠谣","佚名","残句",["活银病金死珠子。"],0,"x217","元"],["元统间谣","佚名","残句",["天雨牦，事不齐。"],0,"x217","元"],["京师童谣","佚名","残句",["白雁望南飞，马札望北跳。"],0,"x217","元"],["至正中谚","佚名","残句",["李如黄瓜，民皆无家。"],0,"x217","元"],["石人谣","佚名","残句",["莫道石人一只眼，此物一出天下反。"],0,"x217","元"],["嘲三宝奴","佚名","残句",["茶盐酒醋都提举，僧道医工总相公。"],0,"x217","元"],["上海县谣","佚名","残句",["鸡啼不拍翅，鸦鸟不转更。"],0,"x217","元"],["方国珍谣","佚名","残句",["杨氏青，出贼精。"],0,"x217","元"],["绩溪歌","佚名","残句",["前有苏黄门，后有叶令君。"],0,"x217","元"],["题张奂墓残句","佚名","残句",["易启先天秘，琴弹太古声。"],0,"x217","元"],["南恩州古谣","佚名","残句",["汀洲青草连，南恩出状元。"],0,"x217","元"]]