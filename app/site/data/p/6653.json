[["海棠果赞","区大相","四言",["海棠色殊，纷披曜日。","不芬其葩，而香其实。","香或掩味，文乃逾质。","园陵之珍，佩充兰室。"],0,"x294","明"],["木瓜赞","区大相","四言",["垂垂木瓜，诗人所咏。","酸本我心，香亦吾性。","人之好我，或忘其病。","无劳琼报，忝此嘉命。"],0,"x294","明"],["崇德诗七章","区大相","四言",["翼翼旧京，作配丰芑。","济济庶士，爰来爰止。","孰茂厥程，硕人君子。","龙潜南国，凤览江汜。","惟此硕人，德音孔硕。","克廉以孝，百行允迪。","爰孚有众，升闻奕奕。","其廉可风，其孝惟则。","人之好名，是能让国。","苟非其人，箪豆见色。","硕人介特，靡诱靡惕。","千金之却，亦在报德。","今之孝者，是谓能养。","不敬何别，菽水非凉。","硕人爱敬，允格穹壤。","终身之慕，亦自少壮。","我闻天道，常与善人。","如种斯获，靡屈弗伸。","既丰其德，或啬其身。","尔身弗享，爰及后昆。","硕人有子，邦之司直。","在帝左右，罔或不即。","汝明汝听，有孝有德。","用锡帝赉，衍兹世泽。","世泽克衍，先问孔扬。","既显于世，亦祀于乡。","肃肃判宫，笾豆有常。","是依是崇，儒道其光。"],0,"x294","明"],["续刺谗诗 其一","区大相","四言",["天监下民，正直是与。","孰任奸慝，而司世矩。","周周之族，亦衔其羽。","乃如之人，不恤其侣。"],0,"x294","明"],["续刺谗诗 其二","区大相","四言",["缉缉谗夫，实善中人。","中藏𪫺贼，外示密亲。","如虿斯螫，如犬斯狺。","皇天祸淫，孰逃尔身。"],0,"x294","明"],["续刺谗诗 其三","区大相","四言",["施施谗夫，胡言之厚。","甘言谀辞，亦孔之丑。","君子攸行，遭汝疾诟。","邦家之覆，亦在利口。"],0,"x294","明"],["续刺谗诗 其四","区大相","四言",["毁玉为珉，诬舜为跖。","云胡不造，负此谗慝。","在昔有训，顽谗是堲。","奈何邦家，长此蟊贼。"],0,"x294","明"],["续刺谗诗 其五","区大相","四言",["俨斯恪斯，我仪孔嘉。","惕斯勤斯，我德靡瑕。","爰敕我躬，日闲我家。","庶几夙夜，以保靡他。"],0,"x294","明"],["续刺谗诗 其六","区大相","四言",["天之方蹶，良士祚之。","民之多艰，良士阜之。","四国有难，良士辅之。","祁祁良士，谗人恶之。"],0,"x294","明"],["续刺谗诗 其七","区大相","四言",["道之丧矣，谗人是命。","俗之讹矣，谗言是听。","夫惟仁人，去谗远佞。","放之流之，四国是正。"],0,"x294","明"],["续刺谗诗 其八","区大相","四言",["嗟余小子，不早是图。","傲此正直，玩彼奸谀。","毁防延盗，世谓之愚。","比之匪人，不亦伤乎。"],0,"x294","明"],["续刺谗诗 其九","区大相","四言",["高林致风，盛德来毁。","云胡否德，而蒙谤诽。","我仲我季，正直是履。","恶佞嫉邪，为端是轨。"],0,"x294","明"],["续刺谗诗 其十","区大相","四言",["昔在公车，偕我仲季。","邂逅三汪，声同气契。","剖文析义，其言孔惠。","久要不忘，眷尔离袂。"],0,"x294","明"],["续刺谗诗 其十一","区大相","四言",["有鸟在梁，亦曰在原。","煌煌哲兄，急难斯存。","彼美汪生，汝亦昌言。","谁谓友朋，不如弟昆。"],0,"x294","明"],["井井亭","湛若水","四言",["有亭井井，山下出泉。","以静而清，浚发天源。","汲之不勤，德之日新。","唯德日新，以济渴人。"],0,"x295","明"],["石潭","湛若水","四言",["水行石上，用柔破刚。","涓涓成渊，蛟龙是藏。"],0,"x295","明"],["翩翩者棣三章赠潘希召之弟归辰阳","湛若水","四言",["翩翩者棣，花萼相及。","夫我不见，兄弟异邑。","兄弟异邑，相送于南，涕泪以泣。","翩翩者棣，花萼相成。","夫我不如，兄弟异京。","兄弟异京，相送于野，涕泪沾缨。","翩翩者棣，花萼瞱瞱。","庇兹本根，永以为惬。","言抚其根，言采其花。","道远莫致，掷之长嗟。"],0,"x295","明"],["赠徐曰仁守祁州三物三章章六句","湛若水","四言",["有徂怀人，赠之纨扇。","辟元规尘，助清谈衍。","以除民热，以蔽大暵。","有徂怀人，赠之长鞭。","慎数马尾，勇著争先。","以起民罢，以驱蹊田。","有徂怀人，赠之缄书。","圯下之帙，寔帝者师。","毋咀其皮，而哜其胔。"],0,"x295","明"],["习古斋","湛若水","四言",["习之习之，古自我作。","习乎自然，学而不学。","化工在手，天机可握。","误笔成蝇，运斤去垩。"],0,"x295","明"],["恐斋","湛若水","四言",["临深履薄，匪曰觳觫。","震不丧匕，心非槁木。","上帝若临，天君自靖。","有所于恐，不得其正。"],0,"x295","明"],["命吴生?字泳中诗四章章八句","湛若水","四言",["厥初生民，昊天降极。","如冰斯寒，如火斯炽。","相协尔居，日用饮食。","尔识尔知，莫匪尔德。","物有挠之，遂淫其则。","其则不远，民用僣忒。","鸡犬其心，见鹄思射。","先民有言，不有博弈。","眇兹寡陋，学也不力。","若存或忘，终罔有得。","汨汨厥灵，桑榆日逼。","告尔同志，毋忘夕惕。","上帝其临，兢兢翼翼。","敬恭尔思，戒尔颇僻。","载锄其骄，灵根其植。","涵而泳之，河浸膏泽。"],0,"x295","明"],["古劳二章章十二句","湛若水","四言",["古劳之下，有川洋洋。","洋洋曷以，可濯可航。","泛彼兰舟，与子同行。","时届重阳，朗天清霜。","临流怀旧，伊人云亡。","俛仰今昔，云胡不伤。","古劳之上，云山霅霅。","霅霅曷以，以跻以悬。","乘此柴车，与子同联。","峍乎郁葱，于葵之根。","登高望远，伊人不存。","爰卜幽宅，以慰精魂。"],0,"x295","明"],["藤江雨中","湛若水","四言",["腊月既望，我徂自藤。","云木翳翳，零雨其冥。","有山如戟，有石如城。","云餐雨立，仆夫于征。","联我兰舟，与子同行。","念彼室处，感兹靡宁。"],0,"x295","明"],["平南遣兴","湛若水","四言",["渔渊水深，采芝云迷。","寄怀云水，抗志高栖。","严霜陨木，归鸿背飞。","天寒日短，途长行迟。","岁云暮矣，我心则悲。","神游八极，身囿两仪。","宇宙为旅，万物为徒。"],0,"x295","明"],["爱日二章章十句","湛若水","四言",["瞻彼爱日，实慰我心。","自我室处，天光下临。","我行千里，弥月霾阴。","仆夫痡矣，修途阻深。","我行不辰，昊天何心。","爱日熙熙，实系我思。","于盘之子，尔暄尔曦。","自我弥旬，风雨凄凄。","我心忧矣，阻于涂泥。","实命不偶，昊天何私。"],0,"x295","明"],["敬止","湛若水","四言",["风云自天，龙蛇起陆。","君子敬止，渊渊穆穆。"],0,"x295","明"],["𪾢睆二章章六句","湛若水","四言",["𪾢睆黄鸟，遗音千山。","怀我良朋，声闻其先。","我之思矣，矧兹德言。","黄鸟𪾢睆，响传千岑。","怀我好友，弗思德音。","我之忧矣，矧彼盍簪。"],0,"x295","明"],["赋东山","湛若水","四言",["瞻彼东山，巍巍南极。","我怀君子，于山之侧。","有渰其云，不雨而泽。","秪以淹望，永言思德。","将哦将思，陈侯是式。","谁其赋之，少师无斁。"],0,"x295","明"],["西征凯旋雅","湛若水","四言",["皇天眷德，全畀所覆。","至于海隅，薄广左右。","惟兹两广，实惟荒遐。","顽氓聚啸，互相爪牙。","屡廑南顾，屡简重臣。","顺抚逆戮，均之圣仁。","韩公用武，以严厥始。","朱公用文，克和厥中。","文武并济，将在今公。","既和而玩，治久而隳。","习为姑息，如病痿痹。","天子神圣，天子曰嘻。","顾兹不振，畴克振之。","惟尔萧卿，懋兹六德。","仁信智勇，文武是克。","惟兹六德，乃懋厥功。","率时六馆，奏尔鼎镛。","公拜稽首，对扬天休。","臣罔于家，聿来胥谋。","惟时桂林，爰始兴事。","贼方跳梁，将骄卒敝。","公始下车，不遑煖席。","亲秉旄钺，勇气有激。","智以先之，仁以结之。","信以成之，我军张威。","六月于征，载穷其巢。","俘获十千，凯旋告劳。","广人有言，昔若奄奄。","中丞是作，顽懦有廉。","广人有言，昔尚萎靡。","萧公来严，士皆作气。","文武严和，成自公今。","侯谁记之，守臣周任。","周侯记之，太史文之。","以奏成功，以告鼎彝。"],0,"x295","明"],["题画二首 其一 圯桥进履","湛若水","四言",["进履之心，可以授道。","惜哉师传，未闻何奥。"],0,"x295","明"],["题画二首 其二 希夷睡图","湛若水","四言",["不醒是梦，醒亦是梦。","既同是梦，长年何用。"],0,"x295","明"],["高氏祖庙诗 其一","湛若水","四言",["奕奕大族，世于乐清。","维诗维礼，维以簪缨。","匪维缨也，维礼维诗。","维彼瓜瓞，胤庆无期。","奕奕令族，世于高奥。","维孝维弟，勿替尔祚。","匪伊祚矣，维以孝弟。","维以慈让，于庆千祀。"],0,"x295","明"],["示诸学者","湛若水","四言",["心无一物，天理见前。","何为天理，本体自然。","廓乎浑兮，四时行焉。","勿忘勿助，圣则同天。"],0,"x295","明"],["潘生子嘉姑母贞节诗","湛若水","四言",["忘独忘寡，忘寡忘贫。","七十六春，忘厥女身。","贞一不分，乃通于神。","是谓圣善，奚节之云。","姥如未信，询尔舅孙。"],0,"x295","明"],["题金芝呈瑞卷","湛若水","四言",["煌煌金芝，维山之辉。","云谁之瑞，玉厓维祺。","玉厓巍巍，金芝离离。","金玉交映，君子以之。","我有灵根，先天地春。","美斯毓斯，维天维人。","光于宇宙，瑞于无垠。","思遗怀人，道远奚因。"],0,"x295","明"],["朔风","湛若水","四言",["朔风飕飕，送子归舟。","出饯于江，写我离忧。","虽则离忧，匪厉则逸。","人亦有言，召命不日。"],0,"x295","明"],["答侍御朱君诗 其一","湛若水","四言",["陟彼泉山，其山崇崇。","其崇曷以，坯土之丛。","坯土之受，坯土之积。","于千万仞，维以崇德。","崇德曷以，忠信其址。","谁学此山，子朱子礼。"],0,"x295","明"],["感忠楼诗 其一","湛若水","四言",["奕奕钜汪，司马昌之。","嗣子胤孙，无匮其祺。","昭昭越王，生而前知。","神明日发，不可测思。","不可测思，矧可忘思。"],0,"x295","明"],["感忠楼诗 其二","湛若水","四言",["视彼牛尾，牧者骇异。","威慑六州，六州控制。","有而不有，于唐之世。","留守九宫，王号是畀。","矧可忘斯，念兹厥始。"],0,"x295","明"],["感忠楼诗 其三","湛若水","四言",["登源之茔，萎木再荣。","千春枯槁，谓匪神功。","氓曰神哉，曷感而通。","鞠哉冢宰，树此感忠。","树此感忠，念祖无忘。"],0,"x295","明"],["感忠楼诗 其四","湛若水","四言",["其忠维何，岭表寔多。","积十馀稔，经略威和。","亦职海道，朗机扬波。","公乘长风，夺其长技。","曷不怀嗟，曷不怀嗟，念此荣柯。"],0,"x295","明"],["感忠楼诗 其五","湛若水","四言",["何以怀云，视尔赤心。","贼濠逆天，奋戈入擒。","言誓妻子，告尔有神。","所不如愿，宁殒厥身。","宁殒厥身，顾念忠勋。"],0,"x295","明"],["感忠楼诗 其六","湛若水","四言",["忠勋念兹，何日忘之。","君尔忘身，公尔忘私。","摅谋决策，坐亡群疑。","惟此忠悃，惟帝眷知。","感兹眷忠，无忝孝思。"],0,"x295","明"],["感忠楼诗 其七","湛若水","四言",["思彼槁木，犹感忠诚。","矧伊人矣，云胡不灵。","感忠以劝，联楼峥嵘。","拄地撑天，聿怀永宁。","聿怀永宁，勿替休征。"],0,"x295","明"],["偶笔示张廷佐都司马金挥使","湛若水","四言",["天地合德，为阴为阳，为雨为霜。","圣人合德，为喜为怒，为文为武。","或以揖让，或以毅果。","如人一身，弛张在我。","在我弛张，文武一道。","一道在我，无施不可。"],0,"x295","明"],["寿宝安任君砚斋先生华诞诗","湛若水","四言",["我怀铁江，宝安之阳，隔水汤汤。","有美一人，水中之央。","水中之奇，中气粹之。","何彼德星，生宁馨儿。","其馨维谁，柱也之材。","黄堂之祯，邦家之维。","亦治九华，寿祝无涯。","维以大耋，维德之遐。","维神斯听，竹实是征。","颍川之治，凤凰来鸣。","遐以寿昌，遐以显扬。","寿斯永斯，君子之光。"],0,"x295","明"],["寿张母封太孺人华诞","湛若水","四言",["陈乐高堂，华筵广张。","寿山为俎，北海引觞。","贞哉圣善，笃生二郎。","维孟有轲，维范有滂。","伯供戏彩，仲捧翟裳。","伯氏吹埙，仲氏吹篪。","乐从天来，人自不知。","宛宛王母，宴于瑶池。","三千之实，偷桃之儿。","昭昭圣善，亦严亦慈。","既寿且荣，封章有辉。","自兹古希，万寿无期。"],0,"x295","明"],["昔我三章章六句","湛若水","四言",["昔我视尔，兄弟不犹。","今尔既立，视我如雠。","虽则如雠，我心不尤。","事我之心，转而他人。","凡今之人，薄如秋云。","虽如秋云，我心贞珉。","昔操我戈，今入我室。","匪则入室，道命不一。","其一不一，我心中实。"],0,"x295","明"],["候官黄孝子兰坡 其三","湛若水","四言",["君子孝思，兰之辉辉。","兰既坡矣，神之歆之。","非神之私，精诚之几。","我其颂之，实子之师。"],0,"x295","明"],["高氏祖庙诗 其二","湛若水","四言",["于穆大宗，本支太尉。","继继其传，迨于五世。","维行营公，扈驾而南。","聿来于温，厥家且蕃。","是曰世则，高奥之始。","维木载根，维源斯水。"],0,"x295","明"],["高氏祖庙诗 其三","湛若水","四言",["于昭堂庙，堂庙盘谷。","维屿维茗，山水之蓄。","其蓄维何，维茗维水。","维有苹蘩，以荐嘉祉。","厥荐曷加，有田黍稷。","维兹馨香，以昭明德。"],0,"x295","明"],["高氏祖庙诗 其四","湛若水","四言",["于潭宗会，时思著存。","左昭右穆，祔祧有伦。","维伦笃恩，富贫壹义。","尔子尔姓，来燕来祀。"],0,"x295","明"],["高氏祖庙诗 其六","湛若水","四言",["延月斯沼，受泉于岩。","尔涤尔器，尔洗尔心。","爰渡桥矣，爰陟望云。","君子孝思，维孝斯存。"],0,"x295","明"],["高氏祖庙诗 其七","湛若水","四言",["于弘有庙，有庙孔贲。","厥孙维谁，秋卿之贰。","秋卿之贰，大都之宪。","维贤孔嘉，厥品维二。","都宪曰嘻，匪则友机。","维祖华亭，维考光禄。","维述庵公，是训是廓。"],0,"x295","明"],["答侍御朱君诗 其二","湛若水","四言",["酌彼泉水，其泉泚泚。","其泚维何，有源其涘。","其源维何，众卑之归。","卑以受善，维天下溪。","其善其察，涓涓始达。","漙博渊泉，渊深天阔。"],0,"x295","明"],["九龙颂 其一","湛若水","四言",["一龙乘云，九龙在田。","一龙全身，九龙潜渊。","龙德之潜，其潜正中，吁嗟乎龙。"],0,"x295","明"],["九龙颂 其二","湛若水","四言",["一龙将雨，九龙处处。","一龙来宇，九龙避所。","龙德之让，其让正中，吁嗟乎龙。"],0,"x295","明"],["即席送陈梓卿归省携侄来山","湛若水","四言",["太丘子弟，从宝潭来。","来时一念，自天先开。","河源涓治，到海不回。"],0,"x295","明"],["谗谮二章","湛若水","四言",["彼谮妇妾，多言谍谍。","乃心如刀，乃口如蜜。","虽则如蜜，我心则一。","凡操我戈，毋入我室。","彼谮婆娑，长舌实多。","听听国狗，一吠百和。","虽则百和，我心靡他。","凡入我室，毋操我戈。"],0,"x295","明"],["显陵五章送严介溪宗伯","边贡","四言",["于穆献考，睿哲维则。","宅兹郢方，以莅王国。","笃生我后，膺符受历。","奕世丕承，下土是式。","滔滔江汉，翼轸之墟。","我后龙翔，奄正中区。","诞基骏命，聿绍鸿图。","赫赫明明，肇阐徽谟。","帝念孝思，继序不忘。","位号既崇，复我天常。","有严新庙，祠礿烝尝。","是典是彝，诞告多方。","乃命司空，伐石京师。","郁郁我陵，大建厥规。","载经载营，竹花卜厘。","立极考度，备物多仪。","帝属其文，经纬七曜。","贞观崇封，勒我纯孝。","亿万斯年，汤孙是诏。","天人肃肃，卫兹隧道。"],0,"x297","明"],["朝涉篇六章","边贡","四言",["朝涉洪流，夕步江皋。","凯风吹衣，游子心劳。","岸则有藻，江则有鱼。","我钓我采，荐之中厨。","昔曳里布，以献以舞。","今也则亡，敢曜斯组。","繄祭五鼎，厥养乃三。","禄不逮存，哀哀孰堪。","上冢𦶟黄，下冢回首。","嗟嗟游子，行役已久。","暧暧暮光，萧萧白杨。","永怀二人，曷也可忘。"],0,"x297","明"],["泉之滨哀隐士也 其一","边贡","四言",["泉之滨兮，白石磷兮。","以饮以濯，育吾真兮。"],0,"x297","明"],["泉之滨哀隐士也 其二","边贡","四言",["泉之浒兮，锡之土兮。","载浚载渠，溉之溥兮。"],0,"x297","明"],["泉之滨哀隐士也 其三","边贡","四言",["人之坠矣，泉之匮矣。","瞻言跂兮，众之喟兮。"],0,"x297","明"],["杜蒉","边贡","四言",["旷饮调饮，臣蒉亦饮。","酒生微波，天风凛凛。","子卯不乐，君臣始终。","爵亡言存，千古无穷。"],0,"x297","明"],["石祁子","边贡","四言",["冠佩则兆，吾弗敢知。","吾所知者，吉凶异仪。","或兆或否，偶邪非偶。","大哉礼云，臣子常守。"],0,"x297","明"],["和陶停云赠芋岩五十初度四首 其一","王夫之","四言",["蒸蒸良稼，涤涤灵雨。","滋湑以荣，炎威莫阻。","君子不遐，如琴在抚。","无念古人，空尔延伫。"],0,"x298","清"],["和陶停云赠芋岩五十初度四首 其二","王夫之","四言",["道延今者，爰如鸿蒙。","靡明靡日，靡流靡江。","如彼暗室，召晖于窗。","匪君子任，其孰能从。"],0,"x298","清"],["和陶停云赠芋岩五十初度四首 其三","王夫之","四言",["有梅有梅，霜裛其荣。","人恤尔寒，尔怡予情。","不愆日迈，不负月征。","维仁引年，以保尔生。"],0,"x298","清"],["和陶停云赠芋岩五十初度四首 其四","王夫之","四言",["乔乔豫章，执彼斧柯。","匪不日劳，许许维和。","天期不假，物望实多。","蘧生知化，日益云何。"],0,"x298","清"],["杂诗","王夫之","四言",["清夕始澄，孤月出林。","繁阴绎绎，今我乍歆。","昔者驱车，适彼四野。","求我友生，赠以瑶斝。","昔者乘舟，顺彼中流。","解我冲牙，以赠同仇。","迢迢南山，崔崔峻峦。","暮云群飞，谷风泻湍。","阳雁差池，矧彼鹰鹯。","余生不再，余命不双。","短襟自寒，朔风摇缸。","岁暮薇枯，饥谁与同。"],0,"x298","清"],["来日大难","王夫之","四言",["来日大难，毛凋羽残。","不知今者，谁为妙颜。","醇酒肥牛，何用解忧。","仙人王乔，足可遨游。","黄金可作，尘世可度。","鳅游浊水，龙上天角。","没命黄泉，志存偓佺。","遗物独往，杳若孤烟。","轩辕乘龙，髣髣云中。","天老操辔，髣髴云内。","精魂相存，生死同门。","千秋万岁，乐以忘言。"],0,"x298","清"],["石流篇","王夫之","四言",["石上流水，渐彼蒲英。","涤根孤弱，植芳不倾。","抚我平昔，居然既往。","揽景无及，何用追赏。","水无旋流，卉木有方。","冬春屡易，天故不常。","一善可师，万端方迷。","授我坎坷，天故不齐。","浩浩方隅，茫茫圆轨。","有命艰贞，繄惟今始。","愠不可长，逸不可终。","含默难言，孤置我躬。","乌元鹤白，其辨易知。","分芒析微，何者忌疑。"],0,"x298","清"],["短歌行","王夫之","四言",["临觞不辞，当歌不悲。","明月迟空，天汉离离。","南有玉衡，北有营室。","明明两间，达者自逸。","鸿雁惊霜，飞必有乡。","𫛩雀栖迟，东西回翔。","登山善疑，临水善忆。","古人有心，千秋不测。","东望碣石，大海环之。","横波施楫，谁能代持。","陈馀绝交，冯衍悲老。","佩玦千金，轻丧其宝。","剖臆出心，与天而游。","回风在御，何用繁忧。"],0,"x298","清"],["读易赠熊体贞孙倩 其一","王夫之","四言",["澄宇既涤，清霜欲飞。","天地居然，云胡以窥。","勿庸遐瞩，道岂远而。","物生必偶，心动则奇。","物无不应，心无不几。","遇成秩叙，否必参差。","雷风日月，载此为仪。","孰敢自康，吉凶不违。"],0,"x298","清"],["读易赠熊体贞孙倩 其二","王夫之","四言",["油云在天，舒卷不齐。","随风而东，歘尔还西。","或飞甘雨，或散虹霓。","君子攸行，不害先迷。","经历纷纠，如取如携。","比干殉殷，夷吾相齐。","昏旦殊星，燕粤殊蹊。","移之分寸，徙宅忘妻。","哀哉群动，莫之能稽。","百草陨芳，𫛸鴂先啼。","所以灵氛，告尔天倪。"],0,"x298","清"],["读易赠熊体贞孙倩 其三","王夫之","四言",["自我徂冬，元夜其修。","晨光警曙，肃肃衾裯。","我身则痡，我心则悠。","潜与化寻，敢侈天游。","遂历韶春，言迄凛秋。","物不我遐，化不我浮。","俄顷有枢，谁云迁流。","六龙之辔，遍乎九州。","因之致远，抑又何求。"],0,"x298","清"],["读易赠熊体贞孙倩 其四","王夫之","四言",["大圜如规，旦昏各半。","道枢不留，气毂时转。","理随象宣，通于一贯。","如镜取影，但窥其面。","坤不外生，干非中窜。","其去非亡，其来非幻。","屯隐四阳，鼎阴未现。","非有有无，唯征舒卷。","静言念之，即经为变。","险易盈虚，穷通萃涣。","岂不我繇，何为外眩。"],0,"x298","清"],["读易赠熊体贞孙倩 其五","王夫之","四言",["文王既没，文其在兹。","赫赫明明，有彖有辞。","志非所问，义著于蓍。","日不可炀，天不可帷。","宵人窃烛，不照须眉。","周道茂草，别趋路歧。","弄方如砌，画圆如规。","星历相窜，巫觋是师。","天化地产，玩如行棋。","以谋羹炙，以询淫嬉。","神所不告，覆讥其违。","修吉悖凶，天鉴在斯。","皇天弗尚，吾为尔危。"],0,"x298","清"],["读易赠熊体贞孙倩 其六","王夫之","四言",["昨日之日，为今日先。","荏苒来兹，仰今为缘。","有象皆后，理亦无前。","华山有叟，胎息密传。","谓天为后，别有先天。","秘相授受，玩弄清元。","划破乾坤，符火争权。","我无羽翰，乘风而仙。","居天之后，奚用此焉。","雒阳看花，天津闻鹃。","归之气数，莫匪自然。","人用以废，天枢不圆。","采苓首阳，其尚舍旃。"],0,"x298","清"],["读易赠熊体贞孙倩 其七","王夫之","四言",["脂我神舆，游于太虚。","太虚匪虚，充塞无馀。","火来阳燧，水赴方诸。","水火无间，况道之储。","荠麦夏成，款冬冻舒。","摩荡无方，各含道腴。","匪车何轴，匪户何枢。","六龙并辔，互惜其珠。","行地无疆，良哉骏驹。","哂彼曲学，谓之乘除。","心不可游，道不可拘。","庶几夙夜，警我顽愚。"],0,"x298","清"],["读易赠熊体贞孙倩 其八","王夫之","四言",["悠悠我生，去日巳长。","怀我友朋，墓草芸黄。","父兮生我，罔极昊苍。","莫宝匪命，含柔含刚。","干龙坤马，历历肾肠。","日用不知，虽哲而狂。","不耕之农，蚀彼稻粱。","崦嵫既迫，朽骨空藏。","亦既邂逅，矧敢斁忘。","荆棘是芟，庶显康庄。","多言为尤，自疚不臧。","惟抒我忱，荐其悚惶。"],0,"x298","清"],["耿耿二章","释函可","四言",["耿耿双瞳，游于面间。","瞩人则易，瞩己则难。","勿谓无非，无非非至。","勿谓无知，人将瞩尔。","己非毋匿，人非毋刻。","躬厚薄责，大人之特。","突如其来，突如其已。","念生无根，与物为至。","纷纭不辍，毋用遏绝。","知幻即离，空明如月。"],0,"x299","明"],["佛不在木一章章十句","释函可","四言",["佛不在木，念不在珠。","绵绵不断，无欠无馀。","厥色维紫，厥质维樗。","渠今即我，我不是渠。","永言数之，渠我如如。"],0,"x299","明"],["山鬼四章章四句","释函可","四言",["明月在天，塔影在地。","北风凄凄，惟吾与尔。","塔影在地，明月在天。","汝不我处，人谁汝怜。","汝惟一舌，我惟一脚。","我啸汝歌，汝歌我跃。","天地草草，山河落落。","霜老星残，云胡不乐。"],0,"x299","明"],["善哉行 其一","释函可","四言",["日月烛照，民多纰缪。","川岳流峙，民用搆斗。","揖让在前，征诛在后。","世无伯夷，刬薇种豆。","匪知何寇，匪庸何富。","冯道登仙，云中稽首。","白凤就烹，素麟出走。","载沉载浮，以永厥寿。","稼穑既教，生乃弗谷。","百草既尝，疾乃弗救。","星斗在胸，江河在口。","松柏丸丸，斧斤祇候。"],0,"x299","明"],["善哉行 其二","释函可","四言",["南有佳人，颜色静好。","爱而不见，郁我怀抱。","昨日犹壮，今日已老。","何以却之，出门刈稻。","心洞雨晴，目开天扫。","悠哉悠哉，孰知大道。","仰掇玄露，俯拾瑶草。","薄言置之，无求是宝。","树下一宿，日中一饱。","古之圣贤，无他谬巧。","众荣亦荣，众槁亦槁。","瞻彼蚩蚩，惄焉如捣。"],0,"x299","明"],["短歌行","释函可","四言",["前后左右，四面八方。","忧愁骈集，我何可当。","欲寄天上，虑天弗禁。","欲埋地下，恐地将沉。","不如收拾，置我怀抱。","寝之食之，于焉终老。","沧海何阔，蓬莱何高。","世无黄鹄，乘我游翱。","古之侠士，尘视生死。","凡今之人，畏首畏尾。","好谋弗终，时命终穷。","东南失利，西北多凶。","黄沙为棺，白云为椁。","我则如是，千秋寥落。"],0,"x299","明"],["长歌行","释函可","四言",["我歌我歌，旧民犹可，新民奈何。"],0,"x299","明"],["来日大难","释函可","四言",["来日大难，风雨在门。","今日有客，且共盘桓。","精卫衔木，东海必填。","匹夫立志，金石匪坚。","葛洪熟识，贻我大丹。","不愿长久，顾世多艰。","白雪充腹，敝絮遮寒。","咄咄罪夫，在天地间。","冥冥何用，栖栖亦戆。","沮溺弗为，何况孔孟。","朝歌亦入，盗泉亦饮。","下士笑之，上士同哂。"],0,"x299","明"],["放歌行","释函可","四言",["斫却孤桐，凤或来止。","堙却颍川，由或来洗。","古无天地，高下何论。","古无江河，清浊何分。","我有素琴，无弦一曲。","秋风乍来，声出林木。","亦盗亦廉，非夷非惠。","知我则希，我则何贵。","泰山一拳，沧溟一勺。","天日明明，亦胡能烛。"],0,"x299","明"],["陇头歌 其一","释函可","四言",["陇头流水，或西或东。","哀此飞蓬，瞻望旧丛。","旧丛久空，忧心忡忡。"],0,"x299","明"],["陇头歌 其二","释函可","四言",["陇头流水，声惨以凄。","落叶从之，永辞故枝。"],0,"x299","明"],["修竹篇三章","陆深","四言",["瞻彼修竹，薄言眷之。","依依庭除，托植在兹。","我悦我亲，以况其仪。","竹之苞矣，以慰我思。","瞻彼修竹，其色如玉。","眷言顾之，岂曰空谷。","出则尔恭，入则尔复。","君子之居，清风穆穆。","瞻彼修竹，凤凰于飞。","岁聿云莫，泥泥有辉。","崇是正直，以保中虚。","君子万年，神明所依。"],0,"x301","明"],["恭拟太祖高皇帝孝慈高皇后上册乐章 其一 迎神","陆深","四言",["惟皇高祖，英灵在天。","神功大化，裕后光前。","寝庙俨若，音容僾然。","竭我孝思，以格于重。","玄云车龙，驭髣髴盘。","旋与乾元，同运何万。","斯年肃以，跂予若有。","见焉永佑，予小子对。"],0,"x301","明"],["恭拟太祖高皇帝孝慈高皇后上册乐章 其二 初献","陆深","四言",["俎豆既陈，酒醴维清。","既戒既栗，明德允升。","孝孙始奠，庶展精诚。","鸿称徽号，听于无声。","昭格可冀，绥我思成。"],0,"x301","明"],["恭拟太祖高皇帝孝慈高皇后上册乐章 其三 亚献","陆深","四言",["载酌载献，惟圣顾歆。","庭陈万舞，乐备八音。","端冕有恪，以表予一。","心灵风习，习祗拜钦。","钦大礼斯，举有壬有。"],0,"x301","明"],["恭拟太祖高皇帝孝慈高皇后上册乐章 其四 终献","陆深","四言",["神降伊迩，终秩有严。","三爵既右，百礼具瞻。","惠我多福，以让以谦。","罔极难报，感惧载兼。","洋洋皇祖，如见兮厌。"],0,"x301","明"],["恭拟太祖高皇帝孝慈高皇后上册乐章 其五 彻馔","陆深","四言",["奠献既备，敬彻不迟。","亦有馀休，默鉴在兹。","肃雍显相，益秉孝思。","我祖我妣，惠我恩慈。","仰德无替，终事有仪。"],0,"x301","明"],["恭拟太祖高皇帝孝慈高皇后上册乐章 其六 还宫","陆深","四言",["祀事孔明，神休滋锡。","孝孙有庆，法宫云适。","心虔体和，礼严境寂。","景云祥风，荏苒翚翟。","抚此瑶图，永膺宝历。","于万斯年，过庙必惕。"],0,"x301","明"]]