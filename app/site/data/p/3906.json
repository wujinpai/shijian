[["李陵录别诗二十一首 其十六","佚名","魏晋",["许由不洗耳。","后世有何征。"],{"ad":"魏晋"},"x238","魏晋"],["李陵录别诗二十一首 其十七","佚名","魏晋",["童童孤生柳，寄根河水泥。","连翩游客子，于冬服凉衣。","去家千里馀，一身常渴饥。","寒夜立清庭，仰瞻天汉湄。","寒风吹我骨，严霜切我肌。","忧心常惨戚，晨风为我悲。","瑶光游何速，行愿去何迟。","仰视云间星，所若割长帷。","低头还自怜，盛年行已衰。","依依恋明世，怆怆难久怀。"],{"ad":"魏晋"},"x238","魏晋"],["李陵录别诗二十一首 其十八","佚名","魏晋",["双凫俱北飞，一凫独南翔。","子当留斯馆，我当归故乡。","一别如秦胡，会见何讵央。","怆悢切中怀，不觉泪沾裳。","愿子长努力，言笑莫相忘。"],{"ad":"魏晋"},"x238","魏晋"],["李陵录别诗二十一首 其十九","佚名","魏晋",["清凉伊夜没，微风动单帱。","招摇西北驰，天汉东南流。","严父潜长夜，慈母去中堂。","行行且自割，无令五内伤。"],{"ad":"魏晋"},"x238","魏晋"],["古诗二首 其一","佚名","魏晋",["采葵莫伤根，伤根葵不生。","结交莫羞贫，羞贫友不成。"],{"ad":"魏晋"},"x238","魏晋"],["古诗二首 其二","佚名","魏晋",["甘瓜抱苦蒂，美枣生荆棘。","利傍有倚刀，贪人还自贼。"],{"ad":"魏晋"},"x238","魏晋"],["古诗一首","佚名","魏晋",["青青陵中草，倾叶晞朝日。","阳春布惠泽，枝叶可缆结。","草木为恩感，况人含气血。"],{"ad":"魏晋"},"x238","魏晋"],["古五杂俎诗","佚名","魏晋",["五杂俎，冈头草。","往复还，车马道。","不获已，人将老。"],{"ad":"魏晋"},"x238","魏晋"],["古两头纤纤诗","佚名","魏晋",["两头纤纤月初生。","半白半黑。","眼中睛。","腷腷膊々鸡初鸣。","磊磊落落向曙星。"],{"ad":"魏晋"},"x238","魏晋"],["古诗 其一","佚名","魏晋",["啼呼哭泣，如吹胡笳。"],{"ad":"魏晋"},"x238","魏晋"],["古诗 其二","佚名","魏晋",["有客从南来，赠我一抱笔。"],{"ad":"魏晋"},"x238","魏晋"],["古诗 其四","佚名","魏晋",["离家千里客，戚戚多思复。"],{"ad":"魏晋"},"x238","魏晋"],["古诗 其五","佚名","魏晋",["日暮途且远，游子悲故乡。"],{"ad":"魏晋"},"x238","魏晋"],["古诗 其六","佚名","魏晋",["屡见流芳歇。"],{"ad":"魏晋"},"x238","魏晋"],["古诗 其七","佚名","魏晋",["石门通越井。"],{"ad":"魏晋"},"x238","魏晋"],["古游仙诗","佚名","魏晋",["带我琼瑶佩，飧我沆?浆。"],{"ad":"魏晋"},"x238","魏晋"],["陇头歌","佚名","魏晋",["陇头流水，流离四下。","念我行役，飘然旷野。","登高望远，涕零双堕。"],{"ad":"魏晋"},"x238","魏晋"],["陇头歌辞 其三","佚名","魏晋",["陇头流水，鸣声幽咽。","遥望秦川，心肠断绝。"],{"ad":"魏晋"},"x238","魏晋"],["邺人金凤旧歌","佚名","魏晋",["凤阳门南天一半。","上有金凤相飞唤。","欲去不去著锁绊。"],{"ad":"魏晋"},"x238","魏晋"],["徐干引古人歌","佚名","魏晋",["相彼玄鸟，止于陵阪。","仁道在近，求之无远。"],{"ad":"魏晋"},"x238","魏晋"],["徐州为王祥歌","佚名","魏晋",["海沂之康，实赖王祥。","邦国不空，别驾之功。"],{"ad":"魏晋"},"x238","魏晋"],["荥阳令歌","佚名","魏晋",["荥阳令。","有异政。","修立学校人易性。","令我子弟耻斗讼。"],{"ad":"魏晋"},"x238","魏晋"],["襄阳民为胡烈歌 其一","佚名","魏晋",["美哉明后，俊哲惟嶷。","陶广乾坤，周孔是则。","文武播畅，威振遐域。"],{"ad":"魏晋"},"x238","魏晋"],["襄阳民为胡烈歌 其二","佚名","魏晋",["譬春之阳，如冬之日。","耕者让畔，百姓丰溢。","惟我胡父，恩惠难置。"],{"ad":"魏晋"},"x238","魏晋"],["行者歌","佚名","魏晋",["青槐夹道多尘埃。","龙楼凤阙望崔嵬。","清风细雨杂香来。","土上出金火照台。"],{"ad":"魏晋"},"x238","魏晋"],["太和中京师歌","佚名","魏晋",["其奈汝曹何。"],{"ad":"魏晋"},"x238","魏晋"],["明帝时宫人谣","佚名","魏晋",["不服辟寒金，那得帝王心。","不服辟寒钿，那得帝王怜。"],{"ad":"魏晋"},"x238","魏晋"],["明帝景初中童谣","佚名","魏晋",["阿公阿公驾马车。","不意阿公东渡河。","阿公东还当奈何。"],{"ad":"魏晋"},"x238","魏晋"],["正始中时人谣","佚名","魏晋",["何邓丁。","乱京城。"],{"ad":"魏晋"},"x238","魏晋"],["嘉平中谣","佚名","魏晋",["白马素羁西南驰。","其谁乘者朱虎骑。"],{"ad":"魏晋"},"x238","魏晋"],["蒋济为护军时谣言","佚名","魏晋",["欲求牙门。","当得千匹。","百人督。","五百匹。"],{"ad":"魏晋"},"x238","魏晋"],["曹操引谚","佚名","魏晋",["失晨之鸡，思补更鸣。"],{"ad":"魏晋"},"x238","魏晋"],["曹操引里谚","佚名","魏晋",["让礼一寸，得礼一尺。"],{"ad":"魏晋"},"x238","魏晋"],["曹丕引里语","佚名","魏晋",["家有敝帚，享之千金。"],{"ad":"魏晋"},"x238","魏晋"],["曹丕引里语","佚名","魏晋",["汝无自誉。","观汝作家书。"],{"ad":"魏晋"},"x238","魏晋"],["曹植引谚","佚名","魏晋",["相门有相。","将门有将。"],{"ad":"魏晋"},"x238","魏晋"],["徐干引古语","佚名","魏晋",["至德之贵，何往不遂。","至德之荣，何往不成。"],{"ad":"魏晋"},"x238","魏晋"],["陈琳引谚","佚名","魏晋",["掩目捕雀。"],{"ad":"魏晋"},"x238","魏晋"],["王昶引谚","佚名","魏晋",["救寒莫如重裘。","止谤莫如自修。"],{"ad":"魏晋"},"x238","魏晋"],["王昶引语","佚名","魏晋",["如不知足。","则失所欲。"],{"ad":"魏晋"},"x238","魏晋"],["鱼豢引谚","佚名","魏晋",["贫不学俭，卑不学恭。"],{"ad":"魏晋"},"x238","魏晋"],["沮授引语","佚名","魏晋",["一兔走衢，万人逐之。","一人获之，贪者悉止。"],{"ad":"魏晋"},"x238","魏晋"],["曹囧引语","佚名","魏晋",["百足之虫，至死不僵。"],{"ad":"魏晋"},"x238","魏晋"],["林恕引谚","佚名","魏晋",["使口如鼻，至老不失。"],{"ad":"魏晋"},"x238","魏晋"],["军中为典韦语","佚名","魏晋",["帐下壮士有典君。","手把双戟八十斤。"],{"ad":"魏晋"},"x238","魏晋"],["军中为夏侯渊语","佚名","魏晋",["典军校尉夏侯渊。","三日五百。","六日一千。"],{"ad":"魏晋"},"x238","魏晋"],["军中为徐晃语","佚名","魏晋",["不得饷。","属徐晃。"],{"ad":"魏晋"},"x238","魏晋"],["军中为卢洪赵达语","佚名","魏晋",["不畏曹公，但畏卢洪。","卢洪尚可，赵达杀我。"],{"ad":"魏晋"},"x238","魏晋"],["鸿胪中为韩暨韩宣语","佚名","魏晋",["大鸿胪。","小鸿胪。","前后治行相曷如。"],{"ad":"魏晋"},"x238","魏晋"],["时人为曹洪骏马谚","佚名","魏晋",["凭空虚跃。","曹家白鹤。"],{"ad":"魏晋"},"x238","魏晋"],["众人为贾洪严危语","佚名","魏晋",["州中晔晔贾叔业，辨论汹汹严文通。"],{"ad":"魏晋"},"x238","魏晋"],["时人称邢颙语","佚名","魏晋",["德行堂堂邢子昂。"],{"ad":"魏晋"},"x238","魏晋"],["京师为邓飏语","佚名","魏晋",["以官易富邓玄茂。"],{"ad":"魏晋"},"x238","魏晋"],["时人为李丰等谤语","佚名","魏晋",["曹爽之势热如汤。","太傅父子冷如浆。","李丰兄弟如游光。"],{"ad":"魏晋"},"x238","魏晋"],["时人为何晏邓飏丁谧曹爽谤语","佚名","魏晋",["台中有三狗。","二狗崖柴不可当。","一狗凭默作疸囊。"],{"ad":"魏晋"},"x238","魏晋"],["时人为陈群陈泰语","佚名","魏晋",["公惭卿，卿惭长。"],{"ad":"魏晋"},"x238","魏晋"],["博昌人为蒋任二姓语","佚名","魏晋",["蒋氏翁。","任氏童。"],{"ad":"魏晋"},"x238","魏晋"],["时人为杨阿若号","佚名","魏晋",["东市相斫杨阿若。","西市相斫杨阿若。"],{"ad":"魏晋"},"x238","魏晋"],["时人为张氏兄弟语","佚名","魏晋",["张氏十龙。","儒雅温恭。"],{"ad":"魏晋"},"x238","魏晋"],["魏鼓吹曲十二曲 其一 楚之平","佚名","魏晋",["楚之平，义兵征。","神武奋，金鼓鸣。","迈武德，扬洪名。","汉室微，社稷倾。","皇道失，桓与灵。","阉宦炽，群雄争。","边韩起，乱金城。","中国扰，无纪经。","赫武皇，起旗旌。","麾天下，天下平。","济九州，九州宁。","创武功，武功成。","越五帝，邈三王。","兴礼乐，定纪纲。","普日月，齐辉光。"],{"ad":"魏晋"},"x238","魏晋"],["魏鼓吹曲十二曲 其二 战荥阳","佚名","魏晋",["战荥阳。","汴水陂。","戎士愤怒。","贯甲驰。","陈未成。","退徐荥。","二万骑。","堑垒平。","戎马伤。","六军惊。","势不集。","众几倾。","白日没。","时晦冥。","顾中牟。","心屏营。","同盟疑。","计无成。","赖我武皇万国宁。"],{"ad":"魏晋"},"x238","魏晋"],["魏鼓吹曲十二曲 其三 获吕布","佚名","魏晋",["获吕布。","戮陈宫。","芟夷鲸鲵。","驱骋群雄。","囊括天下运掌中。"],{"ad":"魏晋"},"x238","魏晋"],["魏鼓吹曲十二曲 其四 克官渡","佚名","魏晋",["克绍官渡由白马。","僵尸流血被原野。","贼众如犬羊。","王师尚寡沙堆傍。","风飞扬。","转战不利士卒伤。","今日不胜后何望。","土山地道不可当。","卒胜大捷震冀方。","屠城破邑。","神武遂章。"],{"ad":"魏晋"},"x238","魏晋"],["魏鼓吹曲十二曲 其五 旧邦","佚名","魏晋",["旧邦萧条心伤悲。","孤魂翩翩当何依。","游士恋故涕如摧。","兵起事大令愿违。","传求亲戚在者谁。","立庙置后魂来归。"],{"ad":"魏晋"},"x238","魏晋"],["魏鼓吹曲十二曲 其六 定武功","佚名","魏晋",["定武功。","济黄河。","河水汤汤。","旦暮有横流波。","袁氏欲衰。","兄弟寻干戈。","决漳水。","水流滂沱。","嗟城中如流鱼。","谁能复顾室家。","计穷虑尽求来连和。","和不时心中忧戚。","贼众内溃。","君臣奔北。","拔邺城奄有魏国。","王业艰难。","览观古今。","可为长叹。"],{"ad":"魏晋"},"x238","魏晋"],["魏鼓吹曲十二曲 其七 屠柳城","佚名","魏晋",["屠柳城。","功诚难。","越度陇塞路漫漫。","北逾冈平。","但闻悲风正酸。","蹋顿授首。","遂登白狼山。","神武慹海外。","永无北顾患。"],{"ad":"魏晋"},"x238","魏晋"],["魏鼓吹曲十二曲 其八 平南荆","佚名","魏晋",["南荆何辽辽。","江汉浊不清。","菁茅久不贡。","王师赫南征。","刘琮据襄阳。","贼备屯樊城。","六军庐新野。","金鼓震天庭。","刘子面缚至。","武皇许其成。","许与其成抚其民。","陶陶江汉间。","普为大魏臣。","大魏臣。","向风思自新。","思自新。","齐功古人。","在昔虞与唐。","大魏得与均。","多选忠义士。","为喉唇。","天下一定。","万世无风尘。"],{"ad":"魏晋"},"x238","魏晋"],["魏鼓吹曲十二曲 其九 平关中","佚名","魏晋",["平关中，路向潼。","济浊水，立高墉。","斗韩马，离群凶。","选骁骑，纵两翼。","虏崩溃，级万亿。"],{"ad":"魏晋"},"x238","魏晋"],["魏鼓吹曲十二曲 其十 应帝期","佚名","魏晋",["应帝期。","于昭我文皇。","历数承天序。","龙飞自许昌。","聪明昭四表。","恩德动遐方。","星辰为垂耀。","日月为重光。","河洛吐符瑞。","草木挺嘉祥。","麒麟步郊野。","黄龙游津梁。","白虎依山林。","凤凰鸣高冈。","考图定篇籍。","功配上古羲皇。","羲皇无遗文。","仁圣相因循。","期运三千岁。","一生圣明君。","尧授舜万国。","万国皆附亲。","四门为穆穆。","教化常如神。","大魏兴盛。","与之为邻。"],{"ad":"魏晋"},"x238","魏晋"],["魏鼓吹曲十二曲 其十一 邕熙","佚名","魏晋",["邕熙。","君臣念德。","天下治。","登帝道。","获瑞宝。","颂声并作。","洋洋浩浩。","吉日临高堂。","置酒列名倡。","歌声一何纡馀。","杂笙簧。","八音谐。","有纪纲。","子孙永建万国。","寿考乐无央。"],{"ad":"魏晋"},"x238","魏晋"],["魏鼓吹曲十二曲 其十二 太和","佚名","魏晋",["惟太和元年。","皇帝践阼。","圣且仁。","德泽为流布。","灾蝗一时为绝息。","上天时雨露。","五谷滋田畴。","四民相率遵轨度。","事务澄清。","天下狱讼察以情。","元首明。","魏家如此。","那得不太平。"],{"ad":"魏晋"},"x238","魏晋"],["时人为张飞玉追马歌","佚名","魏晋",["人守有张飞。","马中有玉追。"],{"ad":"魏晋"},"x238","魏晋"],["襄阳乡里为诸葛亮谚","佚名","魏晋",["莫作孔明择妇。","止得阿承丑女。"],{"ad":"魏晋"},"x238","魏晋"],["襄阳乡里为马良谚","佚名","魏晋",["马氏五常。","白眉最良。"],{"ad":"魏晋"},"x238","魏晋"],["乡里为李严谚","佚名","魏晋",["难可狎。","李鳞甲。"],{"ad":"魏晋"},"x238","魏晋"],["谯周引谚","佚名","魏晋",["射幸数跌。","不如审发。"],{"ad":"魏晋"},"x238","魏晋"],["时人语","佚名","魏晋",["前有何句。","后有张廖。"],{"ad":"魏晋"},"x238","魏晋"],["百姓谚","佚名","魏晋",["死诸葛走生仲达。"],{"ad":"魏晋"},"x238","魏晋"],["时人为刘巴语","佚名","魏晋",["生居三湘头，死葬三湘尾。"],{"ad":"魏晋"},"x238","魏晋"],["诸葛亮引语论光武","佚名","魏晋",["曲突徙薪为彼人，焦头烂额为上客。"],{"ad":"魏晋"},"x238","魏晋"],["吴歌曲","佚名","魏晋",["仙人赍持何等。","前谒海童。"],{"ad":"魏晋"},"x238","魏晋"],["时人为周瑜谣","佚名","魏晋",["曲有误。","周郎顾。"],{"ad":"魏晋"},"x238","魏晋"],["黄龙中童谣","佚名","魏晋",["行白者君。","追汝句骊马。"],{"ad":"魏晋"},"x238","魏晋"],["孙亮初童谣","佚名","魏晋",["吁汝恪。","何若若。","芦苇单衣篾钩络。","于何相求杨子阁。"],{"ad":"魏晋"},"x238","魏晋"],["孙亮初白鼍鸣童谣","佚名","魏晋",["白鼍鸣。","龟背平。","南郡城中可长生。","守死不去义无成。"],{"ad":"魏晋"},"x238","魏晋"],["建衡中寿春童谣","佚名","魏晋",["吴天子，当西上。"],{"ad":"魏晋"},"x238","魏晋"],["使者为妖祠诗诗","佚名","魏晋",["楚九州渚。","吴九州都。","扬州士。","作天子。","四世治。","太平始。"],{"ad":"魏晋"},"x238","魏晋"],["孙皓天纪中童谣","佚名","魏晋",["阿童复阿童，衔刀游渡江。","不畏岸上虎，独畏水中童。"],{"ad":"魏晋"},"x238","魏晋"],["广陵谚","佚名","魏晋",["解结理烦。","我国陆君。"],{"ad":"魏晋"},"x238","魏晋"],["时人语","佚名","魏晋",["支郎。","眼中黄。","形躯虽细是智囊。"],{"ad":"魏晋"},"x238","魏晋"],["黄武中产儿语","佚名","魏晋",["天方明，河欲清。","鼎折脚，金乃生。"],{"ad":"魏晋"},"x238","魏晋"],["时人为殷礼语","佚名","魏晋",["奇才强记殷往嗣。"],{"ad":"魏晋"},"x238","魏晋"],["永安中南郡儿语","佚名","魏晋",["三公锄。","司马如。"],{"ad":"魏晋"},"x238","魏晋"],["诸葛恪引里语","佚名","魏晋",["明镜所以照形，古事所以知今。"],{"ad":"魏晋"},"x238","魏晋"],["沈莹引谚","佚名","魏晋",["宁负千石之粟。","不愿负人猴头羹。","宁去累世田宅。","不去䱥鱼额。"],{"ad":"魏晋"},"x238","魏晋"],["杨桃谚","佚名","魏晋",["杨桃无蹙，一岁二熟。"],{"ad":"魏晋"},"x238","魏晋"],["吴鼓吹曲十二曲 其一 炎精缺","佚名","魏晋",["炎精缺，汉道微。","皇纲弛，政德违。","众奸炽，民冈依。","赫武烈，越龙飞。","陟天衢，耀灵威。","鸣雷鼓，抗电麾。","抚干衡，镇地机。","厉虎旅，骋熊罴。","发神听，吐英奇。","张角破，边韩羁。","宛颍平，南土绥。","神武章，渥泽施。","金声震，仁风驰。","显高门，启皇基。","统冈极，垂将来。"],{"ad":"魏晋"},"x238","魏晋"],["吴鼓吹曲十二曲 其二 汉之季","佚名","魏晋",["汉之季。","董卓乱。","桓桓武烈应时运。","义兵兴。","云旗建。","厉六师。","罗八阵。","飞鸣镝。","接白刃。","轻骑发。","介士奋。","丑虏震。","使众散。","劫汉主。","迁西馆。","雄豪怒。","元恶偾。","赫赫皇祖功名闻。"],{"ad":"魏晋"},"x238","魏晋"],["吴鼓吹曲十二曲 其三 摅武师","佚名","魏晋",["摅武师。","斩黄祖。","攘夷凶族。","革平西夏。","炎炎大烈震天下。"],{"ad":"魏晋"},"x238","魏晋"],["吴鼓吹曲十二曲 其四 伐乌林","佚名","魏晋",["曹操北伐拔柳城。","乘胜席卷遂南征。","刘氏不睦。","八郡震惊。","众既降。","操屠荆。","舟车十万扬风声。","议者狐疑虑无成。","赖我大皇发圣明。","虎臣雄烈周与程。","破操乌林。","显章功名。"],{"ad":"魏晋"},"x238","魏晋"]]