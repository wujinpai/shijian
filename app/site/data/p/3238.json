小王，书写副、神荼郁垒。"],0,"x115","宋"],["失调名 其三","佚名","失调名",["捏个牛儿体态。","按年令，旋拖五彩。","鼓乐相迎，红裙捧拥，表一个、胜春节届。"],0,"x115","宋"],["失调名 其四","佚名","失调名",["彩缕旛儿花枝小。","凤钗上、轻轻斜袅。"],0,"x115","宋"],["木兰花 其五","佚名","失调名",["金吾不禁元宵，漏声更莫催晓。"],0,"x115","宋"],["木兰花 其六","佚名","失调名",["况今宵好景，金吾不禁，玉漏休催。"],0,"x115","宋"],["失调名 其七","佚名","失调名",["金铺翠、蛾毛巧。","是工夫不少。","闹蛾儿拣了蜂儿卖，卖雪柳、宫梅好。"],0,"x115","宋"],["木兰花 其八","佚名","失调名",["灯球儿小，闹蛾儿颤。","又何须头面。"],0,"x115","宋"],["失调名","佚名","失调名",["角黍厅前，祭天神、妆成异果。"],0,"x115","宋"],["失调名","佚名","失调名",["旋酌菖蒲酒，灵气满芳尊。"],0,"x115","宋"],["失调名","佚名","失调名",["自结成同心百索。","祝愿子、更亲自系著。"],0,"x115","宋"],["失调名","佚名","失调名",["双凤钗头，争带御书符。"],0,"x115","宋"],["失调名","佚名","失调名",["才向兰汤浴罢，娇羞簪云髻，正雅称鸳鸯会。"],0,"x115","宋"],["失调名","佚名","失调名",["才向兰汤浴罢，娇羞困、𣨼人未忺梳掠。","艾虎衫儿，轻衬素肌香薄。"],0,"x115","宋"],["失调名","佚名","失调名",["御符争带。","斜插交枝艾。"],0,"x115","宋"],["失调名","佚名","失调名",["从前浪荡休整理。","钉赤口、防猜忌。","而今魔难管全无，一似粽儿黏腻。"],0,"x115","宋"],["失调名","佚名","失调名",["天上佳期。","九衢灯月交辉。","摩□孩儿，斗巧争奇。","戴短檐珠子帽，披小缕金衣。","嗔眉笑眼，百般地、敛手相宜。","转晴底、工夫不少，引得人爱后如痴。","快输钱，须要扑，不问归迟。","归来猛醒，争如我、活底孩儿。"],0,"x115","宋"],["失调名","佚名","失调名",["月到中秋偏莹。","乍团圆、早欺我孤影。","穿帘共透幕，来寻趁。","钩起窗儿，里面故把、灯儿扑烬。","看尽古今歌咏。","状玉盘、又拟金饼。","谁花言巧语、胡厮胫。","我只道、尔是照人孤眠，恼杀人，旧都名业镜。"],0,"x115","宋"],["失调名","佚名","失调名",["手拈茱萸簪髻，一枝聊记重阳。"],0,"x115","宋"],["失调名","佚名","失调名",["插黄花、对尊前，且看茱萸好。"],0,"x115","宋"],["失调名","佚名","失调名",["明年此□，□知谁健，且尽黄花酒。"],0,"x115","宋"],["失调名","佚名","失调名",["奈愁又、愁无避处，愁随一线□长。"],0,"x115","宋"],["失调名","佚名","失调名",["万户与千门，驱傩鼎沸。"],0,"x115","宋"],["失调名","佚名","失调名",["兽炭共围，通宵不寐，守尽残更待春至。"],0,"x115","宋"],["失调名","佚名","失调名",["东南妩媚，雌了男儿。"],0,"x115","宋"],["失调名","佚名","失调名",["惜花心性。"],0,"x115","宋"],["失调名","佚名","失调名",["东君去后花无主。"],0,"x115","宋"],["失调名","佚名","失调名",["须信道、颜色如花，命如秋叶。"],0,"x115","宋"],["失调名 其二 古秋千词","佚名","失调名",["但入新年，愿百事、皆如意。"],0,"x115","宋"],["失调名","佚名","失调名",["雨后轻寒。"],0,"x115","宋"],["失调名 其一 古柳词","佚名","失调名",["柳丝柔无力。"],0,"x115","宋"],["失调名","佚名","失调名",["伤怀长是蹙双眉。","怎禁持。"],0,"x115","宋"],["失调名","佚名","失调名",["杨花飞絮。","搅乱少年情绪。"],0,"x115","宋"],["失调名","佚名","失调名",["天气阴阴。"],0,"x115","宋"],["失调名","佚名","失调名",["倚遍阑干十二楼。"],0,"x115","宋"]]