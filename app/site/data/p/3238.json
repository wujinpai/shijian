[["失调名","佚名","失调名",["千里伤行客。"],0,"x115","宋"],["失调名","佚名","失调名",["黄叶无风自落，彩云不雨空归。"],0,"x115","宋"],["失调名","佚名","失调名",["喜则喜、得入手。","愁则愁、不长久。","忻则忻、我两个斯守。","怕则怕、人来破斗。"],0,"x115","宋"],["失调名","佚名","失调名",["送千里蟾宫客。"],0,"x115","宋"],["失调名","佚名","失调名",["来春高步过南宫，更答取龙头策。"],0,"x115","宋"],["失调名","佚名","失调名",["恐伊不信是龙头，和书寄与三题草。"],0,"x115","宋"],["失调名","佚名","失调名",["问醉吟今夜，何处凤楼偏好。"],0,"x115","宋"],["失调名","佚名","失调名",["光生里闬，荣破天荒。"],0,"x115","宋"],["失调名","佚名","失调名",["君是园中杨柳，能得几时青。","趁金明、春光尚好，尊酒赏闲情。","他年归去，强山阴处，一枕晓霞清。"],0,"x115","宋"],["失调名","佚名","失调名",["华宫瑶馆游毕。","却返绛节、回鸾翼。","荷殷勤、三斝香醪，供养我、上真仙客。","赤霭浮空，祥云远布，是我来时节。","且频修，同泛舸、上云秋碧。"],0,"x115","宋"],["失调名","佚名","失调名",["平地一声雷。"],0,"x115","宋"],["失调名","佚名","失调名",["休休得也□，云深处、高卧斜阳。"],0,"x115","宋"],["失调名 休休得也□，云深处、高卧斜阳 又","佚名","失调名",["单于若问君家世，说与教知。","便是红窗迥底儿。"],0,"x115","宋"],["失调名","佚名","失调名",["说与教知。","便是中朝一汉儿。"],0,"x115","宋"],["失调名","佚名","失调名",["便是监商孟客儿。"],0,"x115","宋"],["失调名","佚名","失调名",["妙手庖人，搓得细如麻线。","面儿白、心下黑，身长行短。","蓦地下来后，吓出一身冷汗。","这一场欢会，早危如累卵。","便做羊肉燥子，勃推饤碗。","终不似、引盘美满。","舞万遍。","无心看。","愁听弦管。","收盘盏。","寸肠暗断。"],0,"x115","宋"],["失调名","佚名","失调名",["瘦得脸儿两指大。"],0,"x115","宋"],["失调名","佚名","失调名",["柳丝只解风前舞。","诮系惹、那人不住。"],0,"x115","宋"],["失调名","佚名","失调名",["做园子，得数载。","栽培得、那花木，就中堪爱。","特将一个、保义酬劳，反做了、今日殃害。","诏书下来索金带。","这官告、看看毁坏。","放牙笏、便担屎担，却依旧种菜。"],0,"x115","宋"],["失调名","佚名","失调名",["叠假山、得保义。","幞头上、带著百般村气。","做模样、偏得人憎，又识甚条例。","今日伏惟安置。","官诰又来索气。","不如更叠个盆山，卖八文十二。"],0,"x115","宋"],["失调名","佚名","失调名",["欲折花枝斜插鬓。"],0,"x115","宋"],["失调名","佚名","失调名",["薰风时送芰荷香。"],0,"x115","宋"],["失调名","佚名","失调名",["花有重开月再圆。"],0,"x115","宋"],["失调名 其一 咏纸钱谑词","佚名","失调名",["你自平生行短，不公正、欺物瞒心。","交年夜、将烧毁，犹自昧神明。","若还替得，你可知好里，争奈无凭。","我虽然无口，肚里清醒。","除非阎家大伯，一时间、批判昏沈。","休痴呵，临时恐怕，各自要安身。"],0,"x115","宋"],["鹊桥仙 其二 琵琶行大曲","佚名","失调名",["别有暗愁深意。"],0,"x115","宋"],["失调名","佚名","失调名",["晓风吹人，酒醒时候。"],0,"x115","宋"],["失调名","佚名","失调名",["海棠花谢清明后。"],0,"x115","宋"],["失调名","佚名","失调名",["郎马频嘶竟不来。"],0,"x115","宋"],["失调名","佚名","失调名",["轻暖轻寒，正是赏花天气。"],0,"x115","宋"],["失调名","佚名","失调名",["盻盻秋波。"],0,"x115","宋"],["失调名","佚名","失调名",["春色恼人眠不得。"],0,"x115","宋"