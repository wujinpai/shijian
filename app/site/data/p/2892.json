[["偈颂九十三首 其二十六","释梵琮","四言",["百丈野狐，石女无夫。","一回泪下，沧海干枯。"],0,100,"宋"],["祭九鼎十二首 其六 亚、终献用《成安》。","郊庙朝会歌辞","四言",["黄流在中，惟馨香祀。","于荐于神，爰祗厥事。","礼从多仪，以进为文。","尊斝三献，昭示孔勤。"],0,"x207","宋"],["杨岐和尚赞","释宗杲","四言",["异类中行，拖犁拽耙。","栗棘金圈，是何言话。"],0,"x112","宋"],["东山图赞 谢安石","叶梦得","四言",["韫玉于山，烨然不枯。","我观此容，非山泽儒。","却顾何为，东山之陟。","如何淮淝，乃折此屐。"],0,4,"宋"],["汉诏郡县行乡饮酒礼颂诗 其十一","洪遵","四言",["绵𫈵无传，莫克用人。","孰播其馨，孝明是似。"],0,18,"宋"],["殉节诗  其三","方氏","四言",["妾身邀隠，君志尽忠。","愿学仲连，甘蹈海东。"],0,228,"宋"],["祫飨回升楼 其三","郊庙朝会歌辞","四言",["涣号爰发，皇敷至仁。","幽隐尽达，洪德日新。","国容肃穆，天宇晏温。","惠浃四远，富寿无垠。"],0,"x207","宋"],["景德以后祀五方帝十六首 其十四 黑帝降神用《高安》。","郊庙朝会歌辞","四言",["隆冬戒序，岁历顺成。","一人有庆，万物由庚。","有旨斯酒，有硕斯牲。","报功崇德，正直聪明。"],0,"x207","宋"],["彼莲之美  其一","曾丰","四言",["彼莲之美，心乎爱矣。","所爱与直，渊乎其似。"],0,"x193","宋"],["皇祐亲享明堂六首 其六 送神用《诚安》。","郊庙朝会歌辞","四言",["我将我享，辟公显助。","献终豆彻，礼成乐具。","饰驾上游，升烟高骛。","神保聿归，介兹景祚。"],0,"x207","宋"],["御赐真赞师演成四偈 其三","释宗杲","四言",["圆觉空明，胡来汉现。","一点灵光，万化千变。"],0,"x112","宋"],["皇雅十首  其二六","尹洙","四言",["在汉世宗，抗威北戎。","暴农算商，经用弗充。","中土震骚，汉南始空。","降及后世，犹称厥功。"],0,108,"宋"],["偈二首 其一","释弥光","四言",["梦幻空花，何劳把捉。","得失是非，一时放却。"],0,122,"宋"],["建隆干德朝会乐章二十八首 第四盏用《嘉禾》。","郊庙朝会歌辞","四言",["嘉彼合颖，致贡升平。","异标南亩，瑞应西成。","德至于地，皇祇效灵。","和同之象，焕发祥经。"],0,"x207","宋"],["偈颂十三首 其二","释智愚","四言",["居必择邻，鉴非止水。","明暗相凌，言犹在耳。"],0,"x153","宋"],["复古颂","徐积","四言",["其难其难，道亦大艰，或缺或完。","战国盗窃，嬴秦暴孽，遗风馀烈。","所存几何，枯株之柯，填源之波。","汉得天下，方有学者，其徒盖寡。","孝文孝武，稍稍复古。","仲舒之伍，巉岩峥嵘。","穷先王经，道乃大明。","西汉之风，与三代同，实儒之功。","晋魏寇雠，学者寖浮，不源而流。","齐梁之闲，斧斫刀剜，大朴益残。","隋唱唐和，元气尽破，为斯文祸。","学者皇皇，赋道大光，六经逃藏。","冶容艳肤，绣衣红襦。","众奔群趋，若大有为。","谓之背驰，终身寒饥。","物不终盛，皇帝有命，万口齐庆。","复明经科，大张网罗，海隅山阿。","麟之奔奔，凤之轩轩，龙之蜿蜿。","会稽之竹，昆仑之玉，牛山之木。","逢蒙执射，伯乐进马，造父御驾。","琴瑟既更，韶音游声，复还于今。","唐虞之谟，夏商之书，其庶几乎。","天下之赋，摧缩消沮，迷失道路。","革万世弊，兴万世利，繄我皇帝。","臣敢不歌，流为大和，百世不磨。"],0,"x123","宋"],["偈颂六十五首 其十二","释咸杰","四言",["天上月圆，人间月半。","槌鼓升堂，理旧公案。","车不横推，理无曲断。"],0,92,"宋"],["古怨诗  其一","刘敞","四言",["鸿鴈飞矣，邕邕其族。","孰是人斯，惸惸其独。"],0,"x51","宋"],["绍熙四年加上寿圣皇太后尊号八首 其四","郊庙朝会歌辞","四言",["熙辰礼备，济济雍雍。","言奉斯册，重亲之宫。","宫帷既敞，协气感通。","皇仪亲展，寿祉无穷。"],0,"x207","宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其二十一","郊庙朝会歌辞","四言",["晨趋慈幄，佳气郁葱。","受帝之祉，配天其崇。","璧华金精，礼敷乐充。","天子是若，欢声融融。"],0,"x207","宋"],["文宣王及其弟子赞 其四十四","赵构","四言",["仰止狄皙，抱负渊通。","游泳德化，扬厉素风。","伟识既异，持教乃隆。","厥志茂焉，毖祀无穷。"],0,249,"宋"],["三教赞","释居简","四言",["此三胜流，一笑聚头。","其道不同，曷相为谋。","至哉儒先，问礼于李。","李从竺乾，逮真实际。","商隐于李，白眉最良。","曰师师师，其来自唐。","车适大方，万里一辙。","差之毫厘，肝胆楚越。"],0,"x94","宋"],["宋江三十六赞 其二十四 先锋索超","龚开","四言",["行军出师，其锋必先。","汝勿锐进，天兵在前。"],0,103,"宋"],["孔平子书合所藏石菖蒲","释道潜","四言",["寒溪之滨，沙石之窦。","产此灵苗，蔚然而秀。","有美君子，采持而归。","文石相并，滀涵清漪。","根盘九节，霜雪不槁。","置之幽斋，永以为好。"],0,"x148","宋"],["文宣王及其弟子赞 其七十一","赵构","四言",["伯彼临淄，左行称贤。","睎踪十哲，秀颖三千。","心悦诚服，家至户传。","乐只君子，文声益宣。"],0,249,"宋"],["虾子和尚赞","释智愚","四言",["清溪影寒，以虾为目。","无柄笊篱，东摝西摝。"],0,"x153","宋"],["升堂颂古五十二首 其四十二","释怀深","四言",["般若无知，无所不知。","般若无见，无所不见。","无知之知，是为真知。","无见之见，是为真见。"],0,"x134","宋"],["偈颂十五首 其三","释慧方","四言",["山河大地，灯笼露柱。","厨库三门，皆是光境。"],0,45,"宋"],["宋颂九首 其五 皇祖","石介","四言",["筠胡予违，进胡不随。","予匪汝诛，汝自取之。"],0,105,"宋"],["偈颂一百零三首 其六十五","释月涧","四言",["真正法要，玄极秘密。","言语道断，心行处灭。"],0,91,"宋"],["偈颂一百二十三首 其十五","释祖钦","四言",["群阴剥尽，一阳复来。","万顷清湘，寒冰发焰。","千年古柏，枯干花开。"],0,64,"宋"],["汉诏郡县行乡饮酒礼颂诗 其四","洪遵","四言",["爰敕方国，礼行于乡。","稽经诹律，属民横堂。"],0,18,"宋"],["青山二章章四句  其二","王奕","四言",["山之青青，策蹇来经。","千古一日，二公之灵。"],0,148,"宋"],["高宗祀明堂前朝享太庙二十一首 其二十一 还大次用《干安》。","郊庙朝会歌辞","四言",["神明既交，恍若有承。","钦翼齐庄，福禄具膺。","王业是兴，祖武是绳。","佑我亿年，以莫不增。"],0,"x207","宋"],["淳化中朝会二十三首 其二 上寿用《和安》。","郊庙朝会歌辞","四言",["一阳应候，万国同文。","天正纪节，太史书云。","凝旒在御，列叙爰分。","寿觞斯荐，祝庆明君。"],0,"x207","宋"],["太常乐章三十首 其十七 皇帝奠玉币奏隆安之曲","杨亿","四言",["定位毖祀，告于神明。","嘉玉量币，享于克诚。"],{"yz":[]},"x47","宋"],["水旱吟 其二","邵雍","四言",["九年洪水，七年大旱。","非尧与汤，民死过半。"],0,"x57","宋"],["殉节诗  其五","方氏","四言",["有女贞洁，有男才良。","素解大义，不负纲常。"],0,228,"宋"],["神功盛德诗  其一三","华镇","四言",["岩岩太山，升于天中。","鸾舆戾止，玉检金封。","汾脽千里，亲飞六龙。","上下昭报，神明以通。"],0,"x106","宋"],["神功盛德诗  其一四","华镇","四言",["在昔图书，出于河洛。","有龙有龟，前圣之作。","惟天无亲，德侔斯格。","我躬受之，宝符神䇲。"],0,"x106","宋"],["神功盛德诗  其一五","华镇","四言",["上天之载，引之惟逸。","原民之生，天子之职。","我安其止，弗扰弗刻。","厥德罔愆，宜符帝则。"],0,"x106","宋"],["神功盛德诗  其一六","华镇","四言",["我征既宽，我役不烦。","息我干矛，审尔刑冤。","井饮田食，日舒以闲。","鸿化何为，淳风载还。"],0,"x106","宋"],["神功盛德诗  其一九","华镇","四言",["世德之渊，庆流弥弥。","笃生哲后，在宗之子。","其积弥新，有闻不已。","文考受之，以肖以似。","人之攸归，天命爰止。"],0,"x106","宋"],["神功盛德诗  其二○","华镇","四言",["天命靡常，惟德惟功。","神圣有作，历数在躬。","正位东朝，遂成大宗。","协和万邦，万邦以雍。"],0,"x106","宋"],["神功盛德诗  其二一","华镇","四言",["沈沈神机，其动其时。","和柔以刚，克爱以威。","肃之振之，俾无或隳。","功则未既，思有宏规。"],0,"x106","宋"],["神功盛德诗  其二二","华镇","四言",["皇有大猷，其成落落。","文武不世，千载无作。","圣人勃兴，积厚施博。","作之新之，以底远略。"],0,"x106","宋"],["筠州圣祖殿诗 其三","苏辙","四言",["如日在天，靡国不临。","筠虽小邦，其有不歆。","东庑西向，谁昔营之。","民昏不知，神以不怀。"],0,"x135","宋"],["沩山轼禅师赞","惠洪","四言",["天骨岩岩，美髯玉颊。","冰雪在躬，霹雳为舌。","轩昂万僧，众星中月。","视其心胸，山包海容。","大沩小兴，振其家风。","丛林百世，见者肃恭。"],0,"x42","宋"],["东山图赞 王逸少","叶梦得","四言",["翰墨之娱，以写万变。","不偿一姥，笑蕺山扇。","袖手纵观，我行故迟。","岂以怀祖，乐此逶迤。"],0,4,"宋"],["颂古三首 其三","释从瑾","四言",["玄沙驴前，云门马后。","更问如何，合取狗口。"],0,7,"宋"],["颂古五十七首 其九","释道昌","四言",["担东过西，移前作后。","马首千差，佛面百丑。"],0,23,"宋"],["祭崇福肇老","释善珍","四言",["兄主两山，无顷刻暇。","踆踆走俗，类古普化。","人始不识，睢盱猜讶。","徐察情真，有朴无诈。","翕然同声，真本色者。","未几废宇，耽耽大厦。","昔瓶无粟，今廪多稼。","松弯易地，筋力已谢。","犹命肩舆，日谒百舍。","车殆马烦，途远将夜。","一身破甑，万事飘瓦。","追惟何及，抚事悲咤。","飞书别我，历举昔话。","云何良友，天不少借。","一香永诀，老泪盈把。"],0,45,"宋"],["祫飨太庙 其十四","郊庙朝会歌辞","四言",["灵其顾思，降福来萃。","天子受之，馂尔在位。","神既享矣，福既均矣。","豆斯彻矣，礼之成矣。"],0,"x207","宋"],["景祐祭文宣王庙六首 奠币用《明安》。","郊庙朝会歌辞","四言",["一王垂法，千古作程。","有仪可仰，无德而名。","齐以涤志，币以达诚。","礼容合度，黍稷非馨。"],0,"x207","宋"],["筠州圣祖殿诗 其六","苏辙","四言",["九峰之杉，逍遥之楠。","易直且修，弗斫而堪。","新堂有严，四星在南。","朝廷之仪，万民所祗。"],0,"x135","宋"],["升堂颂古五十二首 其四十五","释怀深","四言",["达磨西来，单传心印。","不立文字，直指人心。"],0,"x134","宋"],["偈二十首 其一","释鼎需","四言",["隈严遁谷，败种焦牙。","应物随形，拖泥带水。"],0,10,"宋"],["初荣  其三","曾丰","四言",["艿艿者兰，三月初荣。","于王之庭，有颖有泓。","主德孔宏，骾其直声。","之子初荣，与郡为馨。","匪郡之馨，惟国之馨。"],0,"x193","宋"],["故陈氏画像赞","黄庭坚","四言",["女归能妇，义止宜家。","谁其向道，探深见遐。","入古人室，立妙法句。","自履实地，告人悟处。","忽尔心疾，累岁狂痴。","为忘我难，使人厌之。","迨其解化，庄语告戒。","堂堂夫人，凌郑同派。"],0,"x66","宋"],["景祐上辛祈谷二首 其一 太宗配位奠币用《仁安》。","郊庙朝会歌辞","四言",["天祚有开，文德来远。","祈谷日辛，侑神礼展。"],0,"x207","宋"],["偈五十三首 其五十四","释克勤","四言",["干茆近火，理合先燋。","滴水生冰，事不相涉。"],0,143,"宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其二十三","郊庙朝会歌辞","四言",["黼黻其文，金玉其相。","永寿于万，合德无疆。","福绪祥源，厥后克昌。","天维格斯，祚我圣皇。"],0,"x207","宋"],["农父 其二","刘敞","四言",["鸟飞不远，暮还其宅。","我独匪人，去从兵籍。","释弃耒耜，顾贪朝夕。","转徙异方，终世为客。"],0,"x51","宋"],["汉诏郡县行乡饮酒礼颂诗 其二","洪遵","四言",["阳礼教逊，诰誓上仪。","降周迄秦，淟涊弗治。"],0,18,"宋"],["偈颂八十七首 其六十九","释慧开","四言",["开炉半月，火种全无。","冷灰豆爆，惊动江湖。"],0,65,"宋"],["乾道七年恭上太上皇帝太上皇后尊号十一首 其十 太上皇后出阁升御坐用《坤安》。降同。","郊庙朝会歌辞","四言",["帝膺永福，功靡专有。","既尊圣父，亦燕寿母。","怡怡在宫，大典时受。","彤管纪之，天长地久。"],0,"x207","宋"],["云庵和尚赞三首 其三","惠洪","四言",["三玄铨量，设选佛科。","邪师坏之，付授外讹。","以陷虎机，击其颓波。","不动声气，怖走天魔。"],0,"x42","宋"],["颂古三十一首 其二十九","释安永","四言",["电光影里，缁素区分。","纤毫不犯，总教灭门。"],0,145,"宋"],["筠州圣祖殿诗 其四","苏辙","四言",["深山之间，野水之滨。","礼乐声明，孰见孰闻。","祖庙之严，君臣则存。","失而不图，民以罔观。"],0,"x135","宋"],["绍熙四年加上寿圣皇太后尊号八首 其五","郊庙朝会歌辞","四言",["既肃琨庭，载升金戺。","乃导乃陪，威仪济济。","天步继临，孝诚备矣。","声容孔昭，中外悦喜。"],0,"x207","宋"],["淳熙十五年上高宗徽号三首 其三 上徽号用《显安》。","郊庙朝会歌辞","四言",["中兴之烈，高掩商宗。","揖逊之美，放勋比隆。","字十有六，拟诸形容。","威灵在天，裕后无穷。"],0,"x207","宋"],["方丘乐歌 其八","郊庙朝会歌辞","四言",["修理方丘，吉蠲是宜。","笾豆静嘉，登于有司。","芬芬馨香，来享来仪。","郊仪将终，声歌彻之。"],0,"x207","宋"],["朝日载升","苏洵","四言",["朝日载升，薨薨伊氓。","于室有绩，于野有耕。","于涂有商，于边有征。","天生斯民，相养以宁。","嗟我何为，踽踽无营。","初孰与我，今孰主我。","我将往问，安所处我。"],0,70,"宋"],["周礼赞","赵禥","四言",["肇建六典，条章焕明。","万世之则，太平之基。"],0,42,"宋"],["吕文靖亭候帖赞","岳珂","四言",["嘉定乙亥，珂丞军器，居于宝莲。","邻有善士，曰范择能，实祖太史。","百年相承，文献攸萃。","暇日启钥，抉奇出秘。","有三轴者，实公程艺。","捧玩再拜，始识公字。","丁丑禾兴，刻置官寺。","枣肥失态，莫尽体势。","粤来维扬，岁在癸未。","客出公帖，相示叹喟。","如昔所见，毫发毕似。","于翰墨间，更著风谊。","客谓此书，伐木无愧。","亟以归我，备名臣体。","琼函锦缲，明窗棐几。","时一展玩，若锵剑佩。","是岁七月，日维乙巳，淮海堂下，清阴蔽芾。","我时受藏，午暑犹炽。","月纪岁合，时又其位。","于日之吉，与初览对。","载见载识，若合符契。","岂非天耶，尚勿失坠。"],0,"x202","宋"],["今日何夕  其四","曾丰","四言",["今夕何夕，景风其飏。","于明之朝，维月既望。","有祯其象，我后无相，我公直上。"],0,"x193","宋"],["绍熙四年加上寿圣皇太后尊号八首 其三","郊庙朝会歌辞","四言",["煌煌册宝，天子受之。","言徐其行，肃展乃仪。","其仪维何，剑佩黄麾。","鸾驾清跸，耸瞻九逵。"],0,"x207","宋"],["偈四首 其一","释思慧","四言",["妙高山顶，云海茫茫。","少室岩前，雪霜凛凛。","齐腰独立，徒自苦疲。","七日不逢，一场懡㦬。","别峰相见，落在半途。","只履西归，远之还矣。"],0,103,"宋"],["农父 其一","刘敞","四言",["入水作田，上山伐薪。","人世几何，终岁苦贫。","安有灵药，化为羽人。","呼吸光景，为君外臣。"],0,"x51","宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十二","郊庙朝会歌辞","四言",["尧门叠瑞，姒幄齐辉。","重坤靖夷，丽册华徽。","天子仁圣，礼文弗违。","福寿康宁，同燕层闱。"],0,"x207","宋"],["畴依  其二一","王柏","四言",["流泽未远，口耳复迷。","纂组断碎，倚托媚时。","大本斲丧，扰扰胡为。","渊源微矣，予将畴依。"],0,"x137","宋"],["偈颂一百三十三首 其八","释法薰","四言",["莲花荷叶，意在言前。","神仙妙诀，父子不传。"],0,31,"宋"],["高宗祀明堂前朝享太庙二十一首 其四 迎神用《兴安》。","郊庙朝会歌辞","四言",["涓选休成，祖考是享。","夙夜专精，求诸惚恍。","洋洋在上，惟神之仰。","鬯矣清明，应之如响。"],0,"x207","宋"],["偈五十三首 其三","释克勤","四言",["病遇良医，饥逢王鳝。","酱里得盐，雪中送炭。"],0,143,"宋"],["偈","释岩","四言",["乾坤肃静，海晏河清。","风不鸣条，雨不破块。","春生夏长，秋收冬藏。"],0,5,"宋"],["文宣王及其弟子赞 其四十六","赵构","四言",["刚毅近仁，志操莫渝。","性匪祝𬶍，面岂子都。","有一于此，刚名可图。","云欲则柔，盖生之徒。"],0,249,"宋"],["颂古四十八首 其四","释慧开","四言",["痴人面前，不可说梦。","胡子无须，惺惺添懵。"],0,65,"宋"],["颂古四十八首 其六","释慧开","四言",["拈起花来，尾巴已露。","迦叶破颜，人天罔措。"],0,65,"宋"],["颂古四十八首 其八","释慧开","四言",["机轮转处，达者犹迷。","四维上下，南北东西。"],0,65,"宋"],["六句偈六首 其四 后念非圣","释清远","四言",["后念非圣，万象明镜。","不假薰修，本来清净。"],0,116,"宋"],["彼莲之美  其二","曾丰","四言",["厥根玲珑，庶乎屡空。","厥干洞然，同乎大通。"],0,"x193","宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十五","郊庙朝会歌辞","四言",["宋有明德，天保佑之。","以寿继寿，以慈广慈。","声文宣昭，福祉茂绥。","神孙之休，燕及华夷。"],0,"x207","宋"],["代冯似宗寿楼文昌  其三","杨简","四言",["云归星驾，持麾东下。","乘流御风，琳宫燕暇。","山水清晖，亲戚情话。","不间遐贱，如某某者。"],0,118,"宋"],["偈颂一百零二首 其四十八","释绍昙","四言",["路透清波，山横翠壁。","楼阁门开，从这里入。"],0,"x108","宋"],["偈颂一一二首 其五十二","释清远","四言",["龙门潦倒，告报诸人。","既然如是，何故因循。"],0,116,"宋"],["师自作真赞 其一","释守卓","四言",["锥扎不入，顽皮太煞。","自无一文，随方买卖。","淮田神州，酬还宿债。"],0,42,"宋"],["偈颂一百二十三首 其六十五","释祖钦","四言",["南薰入奏，殿阁生凉。","西来祖意，切忌商量。","向下文长。"],0,64,"宋"],["汉诏郡县行乡饮酒礼颂诗 其一","洪遵","四言",["天生蒸民，曷其有识。","维圣摩励，规闲矩饬。"],0,18,"宋"],["汉诏郡县行乡饮酒礼颂诗 其十","洪遵","四言",["昔在建武，大圣载营。","有臣曰湛，示我汉行。"],0,18,"宋"],["汉诏郡县行乡饮酒礼颂诗 其十二","洪遵","四言",["允哉帝德，侯其伟而。","矢诗不多，维后之诒。"],0,18,"宋"]]