[["代冯似宗寿楼文昌  其四","杨简","四言",["肆筵设席，获教蒙益。","缱绻绸缪，问遗不息。","万金良药，再生大德。"],0,118,"宋"],["明堂庆成颂  其六","徐鹿卿","四言",["皇在原庙，推迹本始。","锡庆储祥，仙源演迤。"],0,73,"宋"],["喜王秀才见过小酌玩月","徐俯","四言",["君家近市，所见天咫。","庭户之间，容光能几。","莼蒲之中，江湖之涘。","云碧万顷，长空千里。"],0,156,"宋"],["景祐飨先农五首 其二 升降用《同安》。","郊庙朝会歌辞","四言",["居德之厚，厥祀攸陈。","土膏初脉，农事先春。","铿然金奏，俨若华绅。","陟降于阼，福禄惟神。"],0,"x207","宋"],["明堂庆成颂  其八","徐鹿卿","四言",["皇升玉辂，斋庄中御。","一尘不惊，六飞如舞。"],0,73,"宋"],["偈二十首 其四","释鼎需","四言",["欲得现前，莫存顺逆。","屙屎送尿，多少省力。"],0,10,"宋"],["颂古十五首 其六","释慧远","四言",["三唤三应，更饶贴称。","月逗寒窗，水归巨浸。","负汝负吾，全锋敌胜。"],0,154,"宋"],["庆元二年皇后册宝十三首 其九","郊庙朝会歌辞","四言",["肃肃壶彝，雍雍阴教。","险诐自防，警戒是效。","中闱端委，列御胥告。","其思辅顺，永翼帝孝。"],0,"x207","宋"],["崧高诗为九江赵使君寿  其八","杨冠卿","四言",["万亿及秭，物其旨矣。","此邦之人，云胡不喜。"],0,61,"宋"],["绍兴亲享明堂二十六首 其七 太祖位奠币用《广安》。","郊庙朝会歌辞","四言",["推尊太元，重屋为盛。","谁其配之，我祖齐圣。","开基握符，正位凝命。","于万斯年，孝孙有庆。"],0,"x207","宋"],["建隆以来祀享太庙十六首 其九 翼祖室用《大顺》。","郊庙朝会歌辞","四言",["明明我祖，积德攸宜。","肇继瓜瓞，将隆本支。","爰资庆绪，式昭帝基。","于穆清庙，永洽重熙。"],0,"x207","宋"],["偈颂一百五十首  其一○一","释心月","四言",["天高地迥，海阔山遥。","秋风袭衣，拄杖𨁝跳。"],0,188,"宋"],["偈颂七十六首 其五十九","释子益","四言",["伏暑未收，金风渐作。","弹指声中，门开楼阁。"],0,63,"宋"],["宝祐二年皇子冠二十首 其七","郊庙朝会歌辞","四言",["吉圭休成，其日南至。","天子有诏，冠尔皇嗣。","为国之本，隆邦之礼。","拜而受之，式共敬止。"],0,"x207","宋"],["宝祐二年皇子冠二十首 其八","郊庙朝会歌辞","四言",["兹惟阼阶，厥义有在。","历阶而升，敬谨将冠。","经训昭昭，邦仪粲粲。","正𫄥宾筵，寿考未艾。"],0,"x207","宋"],["代冯似宗寿楼文昌  其五","杨简","四言",["阳复之望，惟公诞辰。","何以贶之，秉国之钧。","何以寿之，南山之椿。"],0,118,"宋"],["偈颂一百零二首 其六十六","释慧远","四言",["长连床上，北俱卢洲。","吃粥吃饭，遍界冤雠。"],0,154,"宋"],["建隆以来祀享太庙十六首 其八 顺祖室用《大宁》。","郊庙朝会歌辞","四言",["元钟九千，生于仲吕。","崇台九层，起于累土。","赫日之升，明夷为主。","孝孙作帝，式由祖武。"],0,"x207","宋"],["偈颂一百三十六首 其六十九","释惟一","四言",["德山推倒，云门打杀。","黄檗烧香，殷人以柏。"],0,143,"宋"],["高宗郊祀前朝享太庙三十首 其二十一 亚献用《正安》。","郊庙朝会歌辞","四言",["威神在天，享于克诚。","申以贰觞，式昭德馨。","笾豆孔嘉，乐舞具陈。","庶几是听，福禄来成。"],0,"x207","宋"],["次赵判宗送李象山韵","陈造","四言",["邑政易堕，我方在行。","挽袖柅车，交游至情。","两君玉峙，表表国士。","下榻倾倒，有贤公子。","我介三子，匪同而和。","提衡掖挽，交口孰何。","月堂之评，罙久未改。","匿瑕振过，兹焉有待。","卜夜之饮，辍骊驹章。","顾虽情钟，河鱼未康。","作吏则疏，羡人报政。","彼益者友，工药我病。","低昂达穷，冥心所遭。","独喜故人，往偕仙曹。","摇摇修程，烱烱初度。","眷言顾之，矫首云路。","胡不小留，共颓醉山。","胡不更仆，共谭孔颜。","西睇归帆，徙倚凄切。","去留之间，仙凡斯别。"],0,"x178","宋"],["赞护教 其五 五通","释印肃","四言",["契那一通，方全六用。","护持般若，法身不动。"],0,"x121","宋"],["偈颂七十六首 其十七","释子益","四言",["世事悠悠，不如山丘。","卧藤萝下，块石枕头。","许由洗耳，巢父饮牛。"],0,63,"宋"],["亲耕藉田七首 其五 群官耕藉。","郊庙朝会歌辞","四言",["畟畟良耜，我田既臧。","土膏其动，春日载阳。","执事有恪，于此中邦。","农夫之庆，栖亩馀粮。"],0,"x207","宋"],["乾道七年册皇太子四首 其二","郊庙朝会歌辞","四言",["雕珉瑳瑳，篆金煌煌。","对扬于庭，是承是将。","星重其晖，日重其光。","观瞻以怿，国有元良。"],0,"x207","宋"],["种药苗二首 种甖粟 其四","苏辙","四言",["三年杜门，莫适往还。","幽人衲僧，相对忘言。","饮之一杯，失笑欣然。","我来颍川，如游庐山。"],0,"x135","宋"],["偈颂一百四十一首 其七十三","释师范","四言",["克期取证，系缚盲驴。","休夏自陈，且莫鬼语。"],0,"x155","宋"],["庆元二年皇后册宝十三首  其四","郊庙朝会歌辞","四言",["帟旒云舒，金秀充庭。","璇卫銮华，蒨佩垂𦀚。","皇容熙备，柔仪顺承。","三宫齐懽，万福昭膺。"],0,"x207","宋"],["高宗郊祀前朝享太庙三十首 其十六 哲宗室用《重光》。","郊庙朝会歌辞","四言",["明哲煌煌，照临无疆。","绍述先志，寔宣重光。","诒谋燕翼，率由旧章。","苾芬孝祀，降福穰穰。"],0,"x207","宋"],["绣释迦像并十八罗汉赞 第十一罗怙罗尊者","惠洪","四言",["闲提数珠，背坐危石。","捉锡山童，越树而剧。","象衔藕花，来献法供。","六根妙同，鼻能致用。"],0,"x42","宋"],["牛山之木四章  其一","赵友直","四言",["牛山之木，于彼空谷。","悠悠我思，孰云勿谷。"],0,49,"宋"],["静而善应 其一","释重显","四言",["觌面相见，不在多端。","龙蛇易辨，衲子难瞒。","金槌影动，宝剑光寒。","直下来也，急著眼看。"],0,"x156","宋"],["绍兴以后祀感生帝十六首 感生帝位奠玉币用《光安》。","郊庙朝会歌辞","四言",["肃肃严祀，神幽必闻。","骋驾临飨，将歆𫗣芬。","嘉玉陈币，钦恭无文。","永绥多祜，国祚何垠。"],0,"x207","宋"],["治乱吟","邵雍","四言",["君子小人，亦常相半。","时止时行，或治或乱。"],0,"x57","宋"],["偈二首 其二","释端裕","四言",["易填巨壑，难满漏卮。","若有操持，了无难易。","拈却大地，宽绰有馀。","放出纤毫，碍塞无中。"],0,50,"宋"],["颂古四十八首 其四十三","释慧开","四言",["拈起竹篦，行杀活令。","背触交驰，佛祖乞命。"],0,65,"宋"],["绍兴十三年发皇后册宝十三首 其四","郊庙朝会歌辞","四言",["朝阳已升，薰风习至。","乐奏既成，礼容亦备。","玉佩锵鸣，帝徐举趾。","壶政穆宣，以听内治。"],0,"x207","宋"],["绍兴十三年发皇后册宝十三首 其九","郊庙朝会歌辞","四言",["礼既行兮，厥位孔安。","母仪正兮，容止可观。","奉东朝兮，常得其欢。","求淑女兮，岂乐多般。"],0,"x207","宋"],["治心吟","邵雍","四言",["心亲于身，身亲于人。","不能治心，焉能治身。","不能治身，焉能治人。"],0,"x57","宋"],["祫飨回升楼 其一","郊庙朝会歌辞","四言",["飨于宗祧，维圣之孝。","骖腾素虬，还归自庙。","端闱百常，耸环七校。","万邦倾瞻，天若覆焘。"],0,"x207","宋"],["颂古四十八首 其三十","释慧开","四言",["青天白日，切忌寻觅。","更问如何，抱赃叫屈。"],0,65,"宋"],["偈颂七十二首 其六十九","释祖钦","四言",["一有多种，二无两般。","钩头识取，莫认定盘。"],0,64,"宋"],["建隆郊祀八首 其四 奉俎用《丰安》。","郊庙朝会歌辞","四言",["笙镛备乐，茧栗陈牲。","乃迎芳俎，以荐高明。"],0,"x207","宋"],["偈十九首 其十一","释守卓","四言",["付法传心，将错就错。","立雪断臂，随邪逐恶。","本色衲僧，如何评溥。","达磨大师，露出一膊。"],0,42,"宋"],["牛山之木四章  其二","赵友直","四言",["牛山之木，欣欣其荣。","我有好爵，君子攸宁。"],0,49,"宋"],["建隆干德朝会乐章二十八首 第二盏用《甘露》。","郊庙朝会歌辞","四言",["天德冥应，仁泽载濡。","其甘如醴，其凝若珠。","云表潜结，颢英允敷。","降于竹柏，永昭瑞图。"],0,"x207","宋"],["临化作","陈景元","四言",["昔之委和，今之蜕质。","非化非生，复吾真宅。"],0,212,"宋"],["颂古三十三首 其五","释师观","四言",["汉既不管，秦亦不收。","人平不语，水平不流。"],0,210,"宋"],["庆元二年皇后册宝十三首 其五","郊庙朝会歌辞","四言",["骖翟崇容，袆鞠陈衣。","戾止兰殿，夙兴椒闱。","淑正宣华，粹明腾𪸩。","钦若有承，嗣音之徽。"],0,"x207","宋"],["临终偈","释崇岳","四言",["来无所来，去无所去。","瞥转玄关，佛祖罔措。"],0,222,"宋"],["颂古一百首 其九十二","释智愚","四言",["坑坑坎坎，崄崄巇巇。","一言易出，驷马难追。"],0,"x153","宋"],["绍兴淳熙两朝内禅颂","曾丰","四言",["维尧则天，与天同大。","俯视九州，细于一芥。","挈以畀舜，超然自迈。","维舜则尧，与尧同高。","俯视四海，细于一毫。","挈以畀禹，熙然自陶。","尧舜之禅，允矣嘉躅。","若稽厥龄，或髦攸趣。","洪惟高宗，才五十六。","遽行尧事，有断于独。","洪惟寿皇，才六十三。","遽行舜事，不谋于佥。","未倦于勤，先养其恬。","功成身退，道与天参。","圣人视天，递退递进。","进退俱休，尧舜之运。","于赫两朝，德宏业峻。","铢较寸量，宁啻尧舜。","尧七十六，治水云初。","咨岳试鲧，不遑宁居。","高宗时则，斯庆寿馀。","久与道息，心实若虚。","舜六十三，即真云始。","咨岳相禹，不遑宁止。","寿皇时则，斯巽位已。","新与道休，心豁若洗。","凡退政几，等与大徽。","此退之蚤，彼退之迟。","迟容可及，蚤孰逾斯。","凡传国玺，等谓大美。","彼传之贤，此传之子。","贤容可求，子孰获只。","传子若贤，一出于天。","天固与子，尤人所便。","便而遂者，荣具庆全。","退蚤若迟，一关于数。","数固与蚤，尤人所慕。","慕而得之，荣全庆具。","蚤于尧舜，三十三年。","独不一后，独不一先。","两朝吻合，时乃自然。","舜后于尧，七岁而禅。","胡为尔稽，匪有攸恋。","不欲与尧，匹休齐善。","寿皇禅意，盖与舜俱。","所后七年，匪迹是拘。","不期而同，自然之符。","高宗禅时，久旸忽雨。","雨应云何，恩洽以溥。","寿皇禅时，久雨忽旸。","旸应云何，德辉以光。","得天之应，诞彰孔盛。","新皇丕承，合为三圣。","用牲于庙，靡灵弗歆。","式昭新皇，上合天心。","决政于堂，靡怀弗畅。","式昭新皇，下符人望。","天人同归，欲逃莫从。","虽父传子，亶为至公。","汉唐岂无，揖逊之主。","非出本心，未为盛举。","猗三圣君，真尧舜禹。","三圣一家，累洽重华。","前未之有，后无以加。","小臣献颂，大而非夸。"],0,"x193","宋"],["淳化乡饮酒三十三章  其三","郊庙朝会歌辞","四言",["鹿鸣呦呦，在彼高冈。","宴乐嘉宾，吹笙鼓簧。","币帛戋戋，礼仪蹡蹡。","乐只君子，利用宾王。"],0,"x207","宋"],["偈三十五首  其二七","释祖珍","四言",["眼若不睡，诸梦自除。","心若不异，万法一如。"],0,155,"宋"],["绍兴十三年发皇后册宝十三首 其五","郊庙朝会歌辞","四言",["猗欤贤后，德本性成。","承天致顺，溯日为明。","作配俪极，王化以行。","万有千岁，奉祀宗祊。"],0,"x207","宋"],["绍兴十三年发皇后册宝十三首 其八","郊庙朝会歌辞","四言",["镂苍玉兮，盛德载扬。","铸南金兮，作镇椒房。","虔受赐兮，有烨有光。","宜室家兮，朱芾斯皇。"],0,"x207","宋"],["赵平甫幽居八操 其八 龟潭操","杨万里","四言",["风耆其武，波赫斯怒。","油然者渊，未遽如许。"],0,"x54","宋"],["嘉泰三年皇后册宝十三首 其七","郊庙朝会歌辞","四言",["瑶殿清閟，玉墄坦夷。","袆衣副珈，陟降不迟。","宝册聿至，载肃载祗。","礼仪昭备，福履永绥。"],0,"x207","宋"],["嘉泰三年皇后册宝十三首 其九","郊庙朝会歌辞","四言",["宝玺瑶册，既祗既承。","绣裀藻席，载跻载升。","柔仪肃穆，瑞命端凝。","永膺多福，如川方增。"],0,"x207","宋"],["鸣雁二章  其一","张玉娘","四言",["鸣雁征征，白露既零。","猗嗟清兮，怀彼春冰。"],0,210,"宋"],["雨师雷神七首 其六 亚、终献。曲同初献。","郊庙朝会歌辞","四言",["作解之德，形声一兮。","爰展献侑，酌则三兮。","我兴有假，云胡有私。","下土是冒，庶其远而。"],0,"x207","宋"],["忧梦吟","邵雍","四言",["至人无梦，圣人无忧。","梦为多想，忧为多求。","忧既不作，梦来何由。","能知此说，此外何修。"],0,"x57","宋"],["偈十九首 其十","释守卓","四言",["释迦掩室，过犯弥天。","维摩杜词，自救不了。","如何如何，口门太小。"],0,42,"宋"],["颂","释真慈","四言",["拨尘见佛，佛亦是尘。","问了答了，直下翻身。"],0,42,"宋"],["御书草圣千文赞","李纲","四言",["伏羲画卦，人文以成。","书契之作，以代结绳。","篆籀而降，秦隶乃兴。","规摹楷法，有真有行。","众妙且美，萃于兹草。","畴克工之，心悟笔到。","芝靖羲献，主盟此道。","自昔英主，鲜不自好。","惟汉光武，投戈讲艺。","有唐太宗，笔迹奇秘。","底绥大业，实资勇智。","游戏翰墨，乃其馀事。","于穆天子，允武允文。","武定祸乱，文该典坟。","万机之馀，纵笔怡神。","作此草圣，前无古人。","人亦有言，心正笔正。","妙哉心画，本乎湖静。","银钩铁纽，蟠屈刚劲。","云汉昭回，奎壁辉映。","如鸟行沙，如虫蚀木。","鸾鹄停峙，龙蛇起陆。","飞电绕枢，垂虹饮谷。","千变万态，荡耀心目。","一人之贵，犹或勤斯。","咨尔多士，胡可怠而。","学问积躬，功名济时。","其则不远，瞻之仰之。","载摹宸翰，勒之嘉石。","龛于殿阴，如鲁屋壁。","天威在望，得所矜式。","微臣作赞，垂示无极。"],0,"x136","宋"],["偈七首 其一","释守端","四言",["鸟有双翼，飞无远近。","首出一隅，行无前后。"],0,58,"宋"],["宋江三十六赞 其二十二 插翅虎雷横","龚开","四言",["飞而食肉，有此雄奇。","生入玉关，岂伤令姿。"],0,103,"宋"],["法眼禅师真赞","叶梦得","四言",["八万四千，大悲宝目。","问此多目，孰为正观。","惟阿那律，无目而视。","问此真目，毕竟安在。","是法眼者，犹为金屑。","有法无眼，有眼无法。","稽首导师，五蕴皆寂。","悲观慈观，等大圆镜。","颓然方床，如梦中事。","山河大地，一切消陨。"],0,4,"宋"],["圣号雅二篇 其八","赵湘","四言",["皇道靡彻，载昭载晰。","克彼有截，万国是悦。","皇矣圣朝，绵尔瓜瓞。","是崇是洁，万世贻厥。"],0,126,"宋"],["绍兴十三年发皇后册宝十三首 其十二","郊庙朝会歌辞","四言",["宝字煌煌，册书粲粲。","副笄加饰，袆褕有烂。","祗若帝休，委蛇乐衎。","亿万斯年，永膺宸翰。"],0,"x207","宋"],["绍兴十三年发皇后册宝十三首 其七","郊庙朝会歌辞","四言",["温惠之德，袆翟之衣。","行中采荠，礼无或违。","降于丹陛，有容有仪。","委委蛇蛇，谁其似之。"],0,"x207","宋"],["绵  其五","王梦应","四言",["酒醴维醹，殽核维旅。","吹笙鼓篁，和乐且孺。","式序在位，以速诸父。"],0,254,"宋"],["颂古十七首 其四","释师观","四言",["青出于蓝，而青于蓝。","坐筹帷幄，锻圣镕凡。"],0,210,"宋"],["颂古四十八首 其三十二","释慧开","四言",["剑刃上行，冰棱上走。","不涉阶梯，悬崖撒手。"],0,65,"宋"],["偈颂七十六首 其七十","释师范","四言",["一夏已满，无事不办。","遂府钵盂，邛州磁碗。"],0,"x155","宋"],["牛山之木四章  其四","赵友直","四言",["木之瘁矣，益厚其根。","我之怀矣，匪善奚敦。"],0,49,"宋"],["偈十首 其十","释道行","四言",["依经解义，三世佛冤。","离经一字，即同魔说。"],0,75,"宋"],["熙宁祀皇地祇十二首 其三 奠币用《厘安》。","郊庙朝会歌辞","四言",["纯诚昭融，芳美嘉荐。","肃将二精，以享以奠。","休光四充，灵祇来燕。","其祥伊何，永世锡羡。"],0,"x207","宋"],["四方观练深心诀","晁迥","四言",["性之生情，为梦为想。","性之生缘，如影如响。","不有古圣，愚将安仰。","不有妙道，愚将安仿。","爰得智刃，决开疑网。","人不同心，超然独往。","明融日新，率由天奖。"],0,199,"宋"],["绣释迦像并十八罗汉赞 第十五阿氏多尊者","惠洪","四言",["蛮奴鹤立，盆花置前。","倚杖屈足，颔髭虬然。","了世间空，独游理窟。","石上军持，是吾长物。"],0,"x42","宋"],["示徒三戒 其三","释原妙","四言",["举足动步，无益于人，戒之莫行。"],0,137,"宋"],["大观闻喜宴六首 其二","郊庙朝会歌辞","四言",["明明天子，率由旧章。","思乐泮水，光于四方。","薄采其芹，用宾于王。","我有好爵，寘彼周行。"],0,"x207","宋"],["畦蔬一首","周紫芝","四言",["猗嗟老人，如水中槎。","携壶挈榼，泛宅浮家。","飘然北来，寓此一蜗。","食无畎亩，衣无桑麻。","藜苋满腹，杂以蚬虾。","以鼓我腹，妻孥笑哗。","旅人之食，岂曰不腆。","不足则求，我颜亦腼。","乃即舍隅，蒿莱是剪。","艺此春蔬，侵畦覆畹。","雨叶风枝，忽其满眼。","撷之掇之，以芼以烹。","聊以当肉，亦足彭亨。","摇喉泽吻，茹菹啜羹。","如天酥酡，饭在家僧。","彼哉膏粱，孰为重轻。","安得长江，载扬我舲。","买地五亩，抱瓮躬耕。","驾言聿归，以毕馀生。"],0,"x139","宋"],["补乐府十篇 其三 帝有熊氏之乐歌","曹勋","四言",["于昭上帝，灵命有赫。","其命维何，卿云五色。","翩如游龙，萃如山崇。","来临来止，惕然有颙。","惟钦惟畏，乃祗乃庸。","肇建官师，神民肃雍。"],0,"x103","宋"],["僧问四宾主因而有颂颂之 其二","释重显","四言",["宾中之宾，少喜多瞑。","丈夫壮志，当付何人。"],0,"x156","宋"],["偈颂一百四十二首 其二十二","释广闻","四言",["马祖升堂，百丈卷席。","净慈看来，寸不如尺。"],0,10,"宋"],["高宗郊祀前朝享太庙三十首 其二十 文舞退、武舞进用《正安》。","郊庙朝会歌辞","四言",["八音谐律，缀兆充庭。","进旅退旅，肃恭和平。","盛荐祖宗，灵监昭升。","象功崇德，遹观厥成。"],0,"x207","宋"],["达磨茎芦赞","释慧开","四言",["脚下茎芦，到岸也未。","随流入流，浮逼逼地。"],0,65,"宋"],["灾来吟","邵雍","四言",["灾自外来，犹可消除。","灾自内来，何由支梧。","天人之间，内外察诸。"],0,"x57","宋"],["梁溪四友赞序 其四 粲华赞","李纲","四言",["我有佳友，粲粲其华。","金英炜煌，翠叶交加。","风露洒濯，色香相知。","宛如美人，象服逶迤。","可以忘忧，莫如旨酒。","泛此粲华，益我眉寿。","渊明一樽，子美三嗅。","永结清欢，相从白首。"],0,"x136","宋"],["偈颂七十六首 其五十九","释师观","四言",["孤云野鹤，何天不飞。","这一句子，同道方知。"],0,210,"宋"],["赞护教 其六 梵王","释印肃","四言",["卓立奇功，回光识性。","宇宙恢彰，一身清净。"],0,"x121","宋"],["崧高诗为九江赵使君寿  其七","杨冠卿","四言",["黍稷彧彧，去其螟螣。","实维丰年，我庾维亿。"],0,61,"宋"],["偈颂五首 其二","释文礼","四言",["万松关迥，九陇烟横。","谷风传响，涧水流声。"],0,108,"宋"],["和陶劝农韵勉吾乡之学者 其二","吴芾","四言",["譬如田家，所仰黍稷。","要当早夜，勤于种植。","惰而自安，不稼不穑。","岁云暮矣，何由足食。"],0,"x95","宋"],["和陶劝农韵勉吾乡之学者 其四","吴芾","四言",["奈何人性，易流难久。","才及长成，即求配耦。","稍得其资，复营南亩。","自暴自弃，有同游手。"],0,"x95","宋"],["淳化乡饮酒三十三章  其二","郊庙朝会歌辞","四言",["鹿鸣呦呦，在彼中林。","宴乐嘉宾，式昭德音。","德音愔愔，既乐且湛。","允矣君子，实慰我心。"],0,"x207","宋"],["绍兴以后祀感生帝十六首 僖祖位奠币用《皇安》。","郊庙朝会歌辞","四言",["于穆文献，景炎发祥。","启兹皇运，垂庆无疆。","篚币有陈，式昭肃庄。","神之格思，如在洋洋。"],0,"x207","宋"],["偈颂三十四首 其六","释如净","四言",["大地平沈，此座高广。","千变万化，无功受赏。"],0,105,"宋"],["鸣雁二章  其二","张玉娘","四言",["鸣雁嗥嗥，凉风飘飖。","猗嗟娈兮，怀彼春宵。"],0,210,"宋"]]