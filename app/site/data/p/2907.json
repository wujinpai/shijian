[["闵雨诗 其十三","刘敞","四言",["天子之庆，视雨之积。","自天降康，时万时亿。","眉寿无疆，以靖四国。"],0,"x51","宋"],["绍兴祀岳镇海渎四十三首 其二十九 西岳位酌献用《成安》。","郊庙朝会歌辞","四言",["屹削厥方，风云斯所。","阴邑有宫，侐侐俣俣。","清酤在尊，灵眷在下。","于俎献兮，则莫我吐。"],0,"x207","宋"],["景祐祀社稷三首 其三 奉俎用《丰安》。神州地祇、皇地祇与社稷通用。","郊庙朝会歌辞","四言",["礼崇明禋，维馨斯酒。","洁粢丰盛，杀时犉牡。","齐庄严祗，升燎于槱。","其报伊何，如山如阜。"],0,"x207","宋"],["李西台退居诗帖赞","岳珂","四言",["以退藏心，邀丘壑老。","唱酬之间，意已足考。","我以倦翼，故应知还。","高躅凛然，庶几是攀。"],0,"x202","宋"],["赠张彊赴曲江教","赵汝腾","四言",["圣人立教，以中为常。","不得中行，取獧取狂。","未见狂者，吾里有张。","议论杰然，名压上庠。","恶彼佞臣，请剑尚方。","使终天彝，蚕绩蟹筐。","天鉴其忠，策名颜行。","筮仕分教，九龄之乡。","惟九龄公，非血气刚。","忧深虑远，性端行良。","禄山尚微，测其陆梁。","国忠林甫，恶未披猖。","公预窥之，知其乱唐。","仁必有勇，令名无疆。","彼元忠辈，初志激昂。","一遇摈抑，尽敛锋铓。","媕娿喑哑，不敢否臧。","自谓得计，爵禄之场。","丧已丘山，得不毫芒。","士辨薰莸，与道存亡。","何以臻兹，惟学问将。","弱翁懋哉，以保令芳。"],0,47,"宋"],null,["楚州阻水涨怀汪信民吕居仁二士四言","洪炎","四言",["大江北理，长淮西逝。","厥隩射阳，城邑岳峙。","凿渠而漕，首淮江尾。","舳舻岢峨，连樯千里。","青雀翩翩，彩虹嶷嶷。","梁局舟蹐，限兹潢水。","昔我至止，得二国士。","箪瓢相乐，汪吕氏子。","于今几年，乖隔生死。","梗泛萍飘，乃复于此。","菱花净吐，鹭羽徐起。","如欲我留，盼睐以喜。","俯仰山川，感念成毁。","一瞬千古，寓非予耻。"],0,110,"宋"],["宁宗朝享三十五首 亚献用《正安》。","郊庙朝会歌辞","四言",["尊斝星陈，罍幂云舒。","来贰鸾觞，玉佩琼琚。","相予严祀，秉德有初。","对扬王休，何福不除。"],0,"x207","宋"],null,["绍兴以后时享二十五首 太祖室酌献用《皇武》。","郊庙朝会歌辞","四言",["赫赫艺祖，受天明命。","威加八纮，德垂累圣。","祀事孔明，有严笙磬。","对越在天，延休锡庆。"],0,"x207","宋"],["熙宁蜡祭十三首 其十 奠币用《吉安》。","郊庙朝会歌辞","四言",["于穆明祀，莫如报功。","灵之利泽，惠我无穷。","斋以涤志，币以达衷。","抚宁四极，永锡登丰。"],0,"x207","宋"],null,["崇恩太后升祔十四首 入门用《显安》。","郊庙朝会歌辞","四言",["伣天生德，作配元符。","仪刑壶则，辅佐帝图。","登崇庙祏，勒号璠玙。","烝尝亿载，皇极之扶。"],0,"x207","宋"],["熙宁蜡祭十三首 其二 升降用《肃安》。","郊庙朝会歌辞","四言",["惟蜡有祭，报神之功。","合聚万物，来享来宗。","承诏摄事，不忘肃雍。","灵之格思，福禄来崇。"],0,"x207","宋"],["谢风伯","陈舜俞","四言",["晨风飘兮，弗疾弗暴。","我舟泛兮，以安且蹈。","云谁之赐，神伯予报。","莫阻乎淮，如彼行奡。","莫远乎泗，曾不日到。","我谗不淑，我辞靡好。","伯其怜汝，其还寿考。","伯实神圣，善人是悼。","鼓动万物，永辅有昊。","我歌我诗，以荐行潦。"],0,133,"宋"],["祗奉天书六首 其二 奉香酌献用《瑞安》。","郊庙朝会歌辞","四言",["地届兴王，祥开图箓。","典礼昭成，祺祥交属。","大辂逶迤，卿云纷郁。","祐我含灵，锡兹介福。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 白帝酌献用《祐安》。","郊庙朝会歌辞","四言",["徂商肇祀，灵盖孔飨。","恭承嘉禧，湛澹秬鬯。","监此馨香，灵其安留。","畴惠下民，匪灵之休。"],0,"x207","宋"],["高宗郊祀前朝享太庙三十首 其三 盥洗用《干安》。","郊庙朝会歌辞","四言",["维皇齐精，鬷假于庙。","观盥之初，惟以洁告。","衎承祖宗，恤祀昭孝。","诚心有孚，介福斯报。"],0,"x207","宋"],null,["咸平亲郊八首 其四 奉俎用《丰安》。","郊庙朝会歌辞","四言",["有牲斯纯，有俎斯陈。","进于上帝，昭报深仁。"],0,"x207","宋"],["僧雍野堂赞","陈著","四言",["野堂之野，大千世界。","野堂之堂，匪茅一把。","也无籓篱，也无闲架。","风月往来，云壑上下。","空空洞洞，规模广大。","是真非真，是假非假。","善哉善哉，无成无坏。"],0,"x92","宋"],["淳化中朝会二十三首 四举酒用《白龟》。","郊庙朝会歌辞","四言",["稽彼灵物，允昭圣皇。","浮石可蹑，巢莲益光。","金方正色，介族殊祥。","信书永耀，帝德无疆。"],0,"x207","宋"],["祠南海神","陈之方","四言",["汤汤南溟，百川所潴。","有赫其灵，有严其居。","神宅于幽，诚格者应。","其应维何，皇帝仁圣。","幢旄鼓铙，畴往祇祠。","揭揭程公，神之听之。","祀事之既，神明欢喜。","飙驰龙翔，一息万里。","衍涸濡焦，既盈既优。","庙社亿年，血食均休。"],0,21,"宋"],["绍兴祀太社太稷十七首 太社位酌献用《嘉安》。春社太稷、土正、后稷通用。","郊庙朝会歌辞","四言",["封土崇祀，有烈在民。","千载不昧，福此人群。","洗爵奠斝，有酒其芬。","神具醉止，恺乐欣欣。"],0,"x207","宋"],["宁宗朝享三十五首 捧俎用《丰安》。","郊庙朝会歌辞","四言",["簋豆荐牲，铏笾实馈。","其俎孔庶，吉蠲为饎。","惟德达馨，以忱以贵。","神既佑享，祉贶来暨。"],0,"x207","宋"],["河北都转运使王公","《靖康小雅》作者","四言",["建炎绍统，锐于中兴。","乃得贤辅，食檗饮水。","责君尧舜，良哉股肱。","苟用其言，不难丕承。","时相巨蠹，忌嫉才能。","群邪翼之，如彼鹯鹰。","公奋不顾，忠勇日增。","瞻之维何，垂天之鹏。","琐琐潜善，陋比蛙蝇。","贤死奸寿，何戒何惩。"],0,91,"宋"],["绍兴以后蜡祭四十二首 后稷位酌献用《穆安》。","郊庙朝会歌辞","四言",["维后之功，配天其大。","祀而稷之，万世如在。","黄冠野服，骏奔皇皇。","自古有年，神其降康。"],0,"x207","宋"],["孝宗明堂前朝献景灵宫八首 其五 再诣盥洗用《干安》。","郊庙朝会歌辞","四言",["华灯荧煌，瑞烟氤氲。","威神如在，蠲洁必亲。","再盥于罍，再帨于巾。","皇心肃祗，其敢惮勤。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其二十二 中岳位酌献用《成安》。","郊庙朝会歌辞","四言",["与天齐极，伊嵩之高。","显灵效异，神休孔昭。","饬我祀事，实俎鸾膋。","以侑旨酒，其馨有椒。"],0,"x207","宋"],["熙宁祀皇地祇十二首 其八 饮福用《禔安》。","郊庙朝会歌辞","四言",["载登坛阼，载酌尊彝。","牲酒嘉旨，福禄纯熙。","其福维何，万物咸宜。","其禄维何，永承神禧。"],0,"x207","宋"],["景德祀九宫贵神三首 其一 降神用《高安》。","郊庙朝会歌辞","四言",["倬彼垂象，照临下土。","躔次运行，功德周普。","九宫既位，惟德是辅。","神之至上，皇皇斯睹。"],0,"x207","宋"],["绍兴二十八年祀圜丘 太祖皇帝位酌献用《彰安》。","郊庙朝会歌辞","四言",["于赫皇祖，创业立极。","肃肃灵命，荡荡休德。","嘉觞精洁，雅奏金石。","丕显神谟，惟后之则。"],0,"x207","宋"],["绍兴祀九宫贵神十首 奉俎用《丰安》。","郊庙朝会歌辞","四言",["灵鉴匪远，诚心肃祗。","是烝是享，俎实孔时。","礼行乐奏，肸蚃是期。","云车风马，神其燕娭。"],0,"x207","宋"],["绍兴以后时享二十五首 光宗室用《大和》。","郊庙朝会歌辞","四言",["维宋洽熙，帝继于理。","万姓厚生，三辰顺轨。","对时天休，以燕翼子。","肃唱和声，神其有喜。"],0,"x207","宋"],["真宗告飨六首 其三 东封毕躬谢酌献用《封安》。","郊庙朝会歌辞","四言",["奕奕清庙，锡羡诒谋。","升中神岳，显允皇猷。","归格艺祖，昭报灵休。","奉先追远，盛德益修。"],0,"x207","宋"],null,["高宗郊祀前朝享太庙三十首 其七 僖祖室酌献用《基命》。","郊庙朝会歌辞","四言",["思文僖祖，基德之元。","皇武大之，受命于天。","积厚流光，不已其传。","曾孙笃之，于万斯年。"],0,"x207","宋"],["绍兴亲享明堂二十六首 其二十二 彻豆用《歆安》。","郊庙朝会歌辞","四言",["工祝告休，笙镛云阕。","酒茅既除，牲俎斯彻。","幽明罔恫，中外咸悦。","礼成伊何，天地同节。"],0,"x207","宋"],["哲宗上太皇太后册宝五首 其三 太皇太后升坐用《干安》。","郊庙朝会歌辞","四言",["总裁庶政，拥佑嗣皇。","金书玉简，烂其文章。","众歌警作，筦磬将将。","保安四极，降福无疆。"],0,"x207","宋"],["绍兴朝日十首 奠玉币用《嘉安》。","郊庙朝会歌辞","四言",["物之备矣，以交于神。","时惟炎精，不忘顾歆。","经纬之文，璆琳之质。","灿然相辉，其仪秩秩。"],0,"x207","宋"],["朝谒太清宫九首 其三 降神用《真安》。","郊庙朝会歌辞","四言",["犹龙之圣，降生厉乡。","教流清净，道符混茫。","大君肃谒，盛仪允臧。","森罗羽卫，躬荐萧芗。","簪绂济济，钟石洋洋。","高真至止，介福诞祥。"],0,"x207","宋"],["崇恩太后升祔十四首 送神用《兴安》。","郊庙朝会歌辞","四言",["黍稷维馨，虡业充庭。","既钦既戒，灵心是承。","顾予烝尝，言从之迈。","申锡无疆，是用大介。"],0,"x207","宋"],["绍兴二十八年祀圜丘 皇帝入中壝用《干安》。","郊庙朝会歌辞","四言",["帝出于震，巽惟齐明。","律曰姑洗，以示洁清。","我交于神，蠲意必精。","既盥而往，祈鉴斯诚。"],0,"x207","宋"],["绍兴祀皇地祇十五首 正位酌献用《光安》。","郊庙朝会歌辞","四言",["祗事坤元，饬躬敢惮。","爰洁粢盛，载严圭瓒。","清明内融，嘉旨外粲。","介我繁厘，时亿时万。"],0,"x207","宋"],["绍兴祀太社太稷十七首 捧俎用《丰安》。","郊庙朝会歌辞","四言",["嘉承天和，黍稷翼翼。","默相农功，繄神之德。","俎实牺牲，旧章是式。","嗣有丰年，我庾维亿。"],0,"x207","宋"],["宁宗郊祀二十九首 皇帝盥洗用《干安》。","郊庙朝会歌辞","四言",["皇帝俭勤，盥用陶瓦。","礼神颂祗，奠币献斝。","月鉴阴肃，醴液融冶。","挹彼注兹，礼无违者。"],0,"x207","宋"],["绍兴以后时享二十五首 英宗室酌献用《治隆》。","郊庙朝会歌辞","四言",["炎基克巩，赫赫英宗。","绍休前烈，仁化弥隆。","笃生圣子，尧汤比踪。","烝尝万世，福禄来崇。"],0,"x207","宋"],["绍兴享先农十一首 其十一 送神用《静安》。","郊庙朝会歌辞","四言",["神之来止，风驶云翔。","神之旋归，有迎有将。","歌以送之，磬筦锵锵。","何以惠民，丰年穰穰。"],0,"x207","宋"],["干德以后祀感生帝十首 饮福用《广安》。","郊庙朝会歌辞","四言",["三阳戒律，万汇腾精。","既苏昆虫，毕达勾萌。","具陈牺象，式荐诚明。","锡以蕃祉，永保咸平。"],0,"x207","宋"],["登仕郎张武来求一言因记衰颜就以勉之","周必大","四言",["德人之容，如玉其温。","参前倚衡，以瞻以仪。","我愧于是，将焉取斯。","所贵者三，归有馀师。"],0,"x76","宋"],["绍兴祀祚德庙八首 其二 初献升降用《同安》。","郊庙朝会歌辞","四言",["庙宇更新，轮奂丰敞。","神灵如在，英姿飒爽。","执事进趋，降升俯仰。","威仪翼翼，虔祈歆飨。"],0,"x207","宋"],["绍兴祀太社太稷十七首 太社位酌献用《嘉安》。秋社、腊太稷、土正、后稷通用。","郊庙朝会歌辞","四言",["叶气嘉生，年谷顺成。","万亿及秭，如坻如京。","奉时犉牡，告于神明。","歌此良耜，于昭德馨。"],0,"x207","宋"],["高宗郊祀前朝享太庙三十首 其十五 神宗室用《大明》。","郊庙朝会歌辞","四言",["烝哉维后，继明体神。","稽古行道，文物一新。","润色鸿业，垂裕后人。","灵斿沛然，来燕来宁。"],0,"x207","宋"],["上邓宪生辰  其二","杨简","四言",["维江之东，有贤使者。","惠德似之，溥泽润下。"],0,118,"宋"],["熙宁以后祀高禖六首 其六 送神用《理安》。","郊庙朝会歌辞","四言",["礼奠蠲衷，祭仪竣事。","丕拥灵休，蕃衍皇嗣。"],0,"x207","宋"],["宁宗朝享三十五首 真宗室用《熙文》。","郊庙朝会歌辞","四言",["天地熙泰，跻时升平。","阐符建坛，声容文明。","君臣赓载，夷夏肃清。","本支百世，持盈守成。"],0,"x207","宋"],["皇后庙十五首 其五 孝惠皇后室用《奉安》。","郊庙朝会歌辞","四言",["初阳作配，内助惟贤。","柔顺中积，英徽外宣。","神宫有侐，明祀惟虔。","歆诚降祐，于万斯年。"],0,"x207","宋"],["景德中朝会十四首 再举酒毕用《天下大定》。 其二","郊庙朝会歌辞","四言",["偃伯灵台，功成作乐。","以昭德容，以清戎索。","万邦会同，邪慝销铄。","尽善尽美，侔彼韶箾。"],0,"x207","宋"],["上邓宪生辰  其一","杨简","四言",["维彼岷源，维深且长。","是为大江，润泽南方。"],0,118,"宋"],["谱乐歌","赵由济","四言",["悠悠我祖，始于轩辕。","既历高阳，秩秩大猷。","爰自伯益，舜赐皂斿。","中衍仕商，造父御周。","征彼徐方，营营有功。","邑于赵城，大河之东。","建仕晋国，耿光其封。","成宣谕日，畏夏爱冬。","岸贾作难，婴臼立孤。","襄子始大，常山得符。","于赫烈侯，懋建丕图。","肃侯武灵，兆配有虞。","西汉子都，生长河间。","暨于唐末，今族居燕。","卜迁大梁，世系绵绵。","厚德丰功，宜永其传。","中罹多难，西历江沱。","眷焉吾族，丰水居多。","百川有源，众条有柯。","庸修家牒，克俾无讹。","顾及伯仲，忧患更多。","瞻叹古烈，自怜其生。","厥生岂偶，三辰垂精。","德业未进，敢不战兢。","我心伊何，当念于初。","感彼霜露，怆然踌躇。","奉先如在，宗戚相依。","椿台萱草，高堂可娱。","惟忠惟孝，立身有本。","嗟尔后进，勖哉自勉。","万有能销，期道无泯。","温恭朝夕，云胡不谨。","显亲扬名，俾昌俾炽。","善保家声，期于不替。","尚念前人，留心谱系。","受天之庆，爰及苗裔。"],0,99,"宋"],["绍兴以后时享二十五首 徽宗室酌献用《承元》。","郊庙朝会歌辞","四言",["天锡神圣，徽柔懿恭。","垂衣拱手，遵制扬功。","配天立极，体道居中。","佑我烈考，万福攸同。"],0,"x207","宋"],["绍兴祀神州地祇十六首 望瘗用《正安》。","郊庙朝会歌辞","四言",["神罔怨恫，燕其有喜。","蒇事告成，爰修瘗礼。","乐阕仪备，休气四起。","尚谨不愆，念终如始。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 奠币用《吉安》。","郊庙朝会歌辞","四言",["百室机杼，衣褐具宜。","民以卒岁，神实惠之。","言举祀典，答神之厘。","有篚斯陈，振古如兹。"],0,"x207","宋"],["咸平御楼四首 降坐用《隆安》。","郊庙朝会歌辞","四言",["肆眚云毕，淳熙溥将。","雷雨丽泽，云物效祥。","礼容济济，天威皇皇。","大赉四海，富寿无疆。"],0,"x207","宋"],["景祐常祀二首 其一 太祖配位奠币用《定安》。","郊庙朝会歌辞","四言",["翕受骏命，震叠群方。","侑祀上帝，德厚流光。"],0,"x207","宋"],["明道亲享先农十首 其八 亚献用《正安》。","郊庙朝会歌辞","四言",["豆笾虽荐，黍稷非馨。","惠我丰岁，歆兹至诚。"],0,"x207","宋"],["上钦成皇后册宝六首 其四 升降用《熙安》。","郊庙朝会歌辞","四言",["苾苾其芳，殽核维旅。","陟降孔时，有秩斯所。","雍容内化，维神之明。","明则不渝，绥我思成。"],0,"x207","宋"],["绍兴淳熙分命馆职定撰十七首 上帝位奠玉币用《嘉安》。","郊庙朝会歌辞","四言",["大享季秋，百执扬厉。","明明太宗，赫赫上帝。","祗荐忱诚，式严圭币。","祚我明德，锡兹来裔。"],0,"x207","宋"],["绍兴享先农十一首 其四 尚书奉俎用《丰安》。","郊庙朝会歌辞","四言",["柔毛刚鬣，或剥或烹。","为俎孔硕，登荐厥诚。"],0,"x207","宋"],["绍兴朝日十首 初献升殿用《正安》。","郊庙朝会歌辞","四言",["天宇四霁，嘉坛聿崇。","肃祗严祀，登降有容。","仰瞻曜灵，位居其中。","既安既妥，沛哉丰融。"],0,"x207","宋"],["汾阴十首 其一 降神用《靖安》。","郊庙朝会歌辞","四言",["茫茫坤载，粤惟太宁。","资生光大，品物流形。","瞻言汾曲，允宅神灵。","圣皇躬享，明德惟馨。"],0,"x207","宋"],["绍兴祀九宫贵神十首 送神用《景安》。","郊庙朝会歌辞","四言",["荐献有序，降登无违。","礼乐备举，昭格燕娭。","云车缥缈，神曰还归。","报以景贶，翊我昌期。"],0,"x207","宋"],["宁宗郊祀二十九首 出小次用《干安》。","郊庙朝会歌辞","四言",["孝奏展成，熙仪毕荐。","光流桂俎，祥衍椒奠。","风管晨凝，云容天转。","拜贶于郊，右序诒燕。"],0,"x207","宋"],["明道亲享先农十首 其七 退文舞、进武舞用《正安》。","郊庙朝会歌辞","四言",["羽葆有奕，文武交相。","周旋合度，福禄无疆。"],0,"x207","宋"],["进仰山瑞禾诗宋大雅十三章  其一○","张商英","四言",["帝宅中天，何知其然。","四方郡国，咸奏丰年。","丰年之象，何以昭宣。","爰有异粟，八节如鞭。"],0,116,"宋"],["高宗祀明堂前朝享太庙二十一首 其十一 真宗室用《熙文》。仁宗室曲同郊祀，送神亦同。","郊庙朝会歌辞","四言",["于皇真宗，体道之崇。","游心物外，应迹寰中。","四方既同，化民以躬。","清净无为，盛德之容。"],0,"x207","宋"],["雨师雷神七首 其三 奠币用《容安》。","郊庙朝会歌辞","四言",["霈兮隐兮，蹶其阴威。","相我有终，胡宁不知。","我币有陈，我邸斯圭。","岂维有陈，于以奠之。"],0,"x207","宋"],["绍兴祀祚德庙八首 其六 启佑公位酌献用《成安》。","郊庙朝会歌辞","四言",["于皇时宋，永祚有基。","始繄覆护，扶而立之。","敢忘昭答，牲分酒酾。","灵其燕飨，益相本支。"],0,"x207","宋"],null,["绍兴朝日十首 酌献用《嘉安》。","郊庙朝会歌辞","四言",["匏爵斯陈，百味旨酒。","勺以献之，再拜稽首。","钟鼓在列，灵方安留。","眷然加荐，惟时之休。"],0,"x207","宋"],["魏京诗 其二十二","刘敞","四言",["显显天子，孝德自躬。","率是休烈，覃之北戎。"],0,"x51","宋"],["绍兴祀太社太稷十七首 送神用《宁安》。","郊庙朝会歌辞","四言",["乃粒烝民，功昭万古。","国有常祀，荐献式叙。","肃肃雍雍，旧章咸举。","神保聿归，介我稷黍。"],0,"x207","宋"],["熙宁以后享庙五首 其一 酌献英宗室用《大英》。","郊庙朝会歌辞","四言",["在宋五世，天子嗣昌。","躬发英断，若干之刚。","声容沄沄，被于八荒。","垂千万年，永烈有光。"],0,"x207","宋"],["绍兴朝日十首 送神用《礼安》。","郊庙朝会歌辞","四言",["羲和驾兮，其容杲杲。","将安之兮，言归黄道。","光赫万物，无古无今。","人君之表，咸仰照临。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 奉俎用《承安》。","郊庙朝会歌辞","四言",["享以精禋，馨非稷黍。","工祝致告，孔硕为俎。","执事骏奔，绳绳具举。","神之嘉虞，介福是与。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 奉俎用《承安》。","郊庙朝会歌辞","四言",["时和岁登，物亡疾瘯。","实俎间膏，报神之福。","匪神福之，曷成且丰。","肥腯咸有，惟神之功。"],0,"x207","宋"],["大观三年释奠六首 其六 送神用《凝安》。","郊庙朝会歌辞","四言",["肃庄绅緌，吉蠲牲牺。","于皇明祀，荐登惟时。","神之来兮，肸蚃之随。","神之去兮，休嘉之贻。"],0,"x207","宋"],["大观蜡祭二首 其二 南郊升降用《穆安》。","郊庙朝会歌辞","四言",["穆如薰风，敷舒文藻。","气蒸消除，丰予黍稻。","神之听之，钟鼓咸考。","于万斯年，惟皇之报。"],0,"x207","宋"],["景祐释奠武成王六首 其六 送神用《凝安》。","郊庙朝会歌辞","四言",["圣朝稽古，崇兹武经。","礼交乐举，于神之庭。","嘉栗旨酒，既飨芳馨。","永严列象，剑舄簪缨。"],0,"x207","宋"],null,["绍兴以后蜡祭四十二首 初献盥洗、升降用《穆安》。","郊庙朝会歌辞","四言",["有帨其新，有匜其洁。","言念清祀，弗简弗亵。","诚意既交，品物斯列。","是用告虔，靡神不说。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 初献盥洗、升降用《穆安》。","郊庙朝会歌辞","四言",["齐诚揭虔，敬恭祀事。","维俨之容，维洁之器。","雍雍乐成，肃肃礼备。","神其燕娭，锡祉庶类。"],0,"x207","宋"],["宁宗朝享三十五首 降殿用《干安》。","郊庙朝会歌辞","四言",["黼幄蝉蜎，飙斿宁燕。","尊彝献祼，瑚簋陈荐。","视仪天旋，淳音韶变。","遹求厥宁，福禄流羡。"],0,"x207","宋"],["宁宗朝享三十五首 降殿用《干安》。","郊庙朝会歌辞","四言",["圣有谟训，诒谋燕翼。","奉天酌祖，万世维则。","维皇孝熙，干干夕惕。","礼既式旋，惟福之锡。"],0,"x207","宋"],["诸遂良枯树赋帖赞","岳珂","四言",["开禧之元，予仕军庾。","偕朋命驾，尝即甘露。","慨怀海岳，赋诗吊古。","朅予再来，乘轺兹土。","复登多景，乃得斯赋。","江山几案，风月樽俎。","俯仰迹陈，卧临意寓。","维赋之作，自庾开府。","殷叹婆婆，桓怀雄据。","染翰行墨，自唐摹褚。","苏印储录，魏藏米谱。","后百馀载，见我诗句。","又二十年，真迹斯睹。","地有显閟，物遂散聚。","抑人与对，非鉴奚取。","独惭予者，莫踵遐武。","谁其后先，传此缣素。","朝猿暮鹤，秋霓春雾。","是书其存，尚想吞吐。"],0,"x202","宋"],["绍兴祀岳镇海渎四十三首 其二十六 西方迎神用《凝安》。","郊庙朝会歌辞","四言",["有岌斯安，有涵斯洽。","聿相厥成，允祀是答。","爰饬乃奏，乃奏既协。","于昭降止，是遵是接。"],0,"x207","宋"],["淳熙二年发太上皇帝太上皇后册宝十一首 其十 太上皇后出阁升御坐用《坤安》。","郊庙朝会歌辞","四言",["重翟出房，袆衣被躬。","委委佗佗，河润山容。","圣皇临轩，圣母在宫。","并受鸿名，与天无穷。"],0,"x207","宋"],["理宗朝享三首 其二 迎神用《兴安》。九奏。","郊庙朝会歌辞","四言",["秬鬯既将，黄钟具奏。","瞻望真游，僾若有慕。","于皇列圣，在帝左右。","云车具来，以妥以侑。"],0,"x207","宋"],["题苏端明书乳泉赋后","尤煓","四言",["万籁既寂，一气孔神。","吸彼沆瀣，沃此肺膺。","至阳之精，天一所生。","钦哉此词，展也大成。"],0,166,"宋"],["高宗明堂前朝献景灵宫十首 其二 升殿用《干安》。","郊庙朝会歌辞","四言",["帝既临享，龙驭华耀。","孝孙承之，陟降在庙。","诚意上交，庆阴下冒。","天休骈至，千亿克绍。"],0,"x207","宋"]]