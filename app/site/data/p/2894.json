[["雨师雷神七首 其五 雷神位酌献。曲同雨师。","郊庙朝会歌辞","四言",["瞻彼南山，有虺其出。","维蛰之奋，维疠之息。","眷焉顾飨，在夏之日。","觞豆匪报，皇忍忘德。"],0,"x207","宋"],["升堂颂古五十二首 其三十八","释怀深","四言",["云笼大野，迦叶攒眉。","雨洒长天，空生下泪。"],0,"x134","宋"],["明日大夫  其二","曾丰","四言",["明日大夫，何嘉贶兮。","老火亢兮，白露降兮。","公生与俱，凝骨相兮。","寖蔼蔼然，朝之望兮。"],0,"x193","宋"],["绍兴祀神州地祇十六首 文舞退、武舞进用《文安》。","郊庙朝会歌辞","四言",["奕奕缀兆，咸池孔彰。","丕阐文德，靡忘发扬。","进退有节，乃容之常。","乐备尔奏，烨烨荣光。"],0,"x207","宋"],["偈颂一百三十三首 其九十七","释居简","四言",["八表归仁，一人有庆。","樵唱渔歌，拍拍是令。"],0,"x94","宋"],["充善堂为吴氏题","陈杰","四言",["厥初生人，禀性受中。","不患不善，患不能充。","血气既刚，物我交战。","不患不充，又患不善。","充而善者，可鸾可凰。","匪善而充，化为豺狼。","其充为何，勿助勿害。","鸡鸣而兴，善与利对。","申严界限，审察毫厘。","诚内伪外，理公欲私。","充无穿窬，义不胜用。","彼充孔扬，傲诞是从。","故得其正，泉达火然。","一有弗协，履冰临渊。","呜呼道微，志远瞻卓。","子如充之，明善守约。"],0,174,"宋"],["高宗郊前朝献景灵宫二十一首 其四 盥洗用《干安》。","郊庙朝会歌辞","四言",["斋居皇皇，琼琚锵锵。","承祭之初，其如在旁。","挹彼注兹，储禧迎祥。","神之听之，欣欣乐康。"],0,"x207","宋"],["太常乐章三十首 其七 酌献第三室奏大顺之舞曲","杨亿","四言",["明明我祖，积德累仁。","居晦匿曜，迈种惟勤。","帝图天锡，辉光日新。","寝庙绎绎，昭事同寅。"],0,"x47","宋"],["偈颂六十五首 其三十五","释普济","四言",["一新一旧，嘉熙淳祐。","皇天大历，岁在辛丑。"],0,73,"宋"],["偈颂一百三十三首 其十七","释法薰","四言",["东弗于逮，西瞿耶尼。","清清之水，游鱼自迷。"],0,31,"宋"],["南郊大礼庆成诗五首 其一 朝享景灵宫","苏颂","四言",["惟宋五世，将郊泰玄。","祗若前典，钦崇道尊。","其日吉午，天时薄寒。","帝出斋寝，朝神紫垣。","降辂就次，被龙搢山。","礼荐苍玉，乐歌太安。","酌以琼醴，羞以灵飧。","飙御来格，上诚益虔。","思我基命，系于帝轩。","真祖膺符，锡类贻孙。","皇继其志，受祉弥繁。","炎炎景历，亿万斯年。"],0,"x85","宋"],["偈颂一百二十三首 其十九","释祖钦","四言",["丁一卓二，见三下三。","和盘掇转，地覆天翻。"],0,64,"宋"],["治平皇太后皇后册宝三首 其三 皇帝降坐用《干安》。","郊庙朝会歌辞","四言",["衮衣绣裳，严威肃庄。","八音具张，簨虡龙骧。","玉简瑶章，金书煌煌。","寿千万年，与天比长。"],0,"x207","宋"],["偈颂一百四十一首 其九十四","释师范","四言",["凤凰台畔，玉几峰前。","筑著磕著，夙世生冤。"],0,"x155","宋"],["偈六首 其二","释净端","四言",["章惇章惇，请我看坟。","我却吃素，汝却吃荤。"],0,190,"宋"],["绍兴淳熙分命馆职定撰十七首 捧俎用《丰安》。","郊庙朝会歌辞","四言",["备物昭陈，工祝告具。","维羊维牛，孔硕孔庶。","有嘉维馨，加食宜饫。","敛时五福，永膺丰胙。"],0,"x207","宋"],["停云诗 其二","舒岳祥","四言",["千山月白，露气蒙蒙。","四顾惝慌，素霭成江。","飞萝扫屋，悬泉挂窗。","之子不至，世孰吾从。"],0,"x161","宋"],["西竺净长老请赞","释心月","四言",["色见声求，二俱不是。","离声色外，转没巴鼻。","石火光中，掣电影里。","要见石溪，且莫瞌睡。"],0,188,"宋"],["畴依  其六","王柏","四言",["汤聘莘尹，五进就桀。","天命人归，鸣条自葛。","以义制事，以礼制心。","日新厥德，鉴此盘铭。"],0,"x137","宋"],["送关都官致仕 其一","陈襄","四言",["鸿鸟于飞，归戾于泽。","君子于田，亦适维则。","旅力不愆，曷云其极。"],0,50,"宋"],["传衣阁赞","惠洪","四言",["达磨信衣，转相传付。","四传至今，今以付汝。","受授惟艰，命如悬絮。","法遍沙界，此衣乃住。","想见峰前，父子相语。","唯僧行月，以阁其处。","坐令朱栏，环绕云雨。"],0,"x42","宋"],["云庵和尚赞三首 其一","惠洪","四言",["于自住境，见与见缘。","如梦能所，如蜜中边。","帷具正眼，入此三昧。","如妙莲华，出缘生海。","祖师活意，如来密机。","成就众生，如鹍鹏飞。","使其自化，不由他悟。","秀出丛林，光于佛祖。","趋灭陕右，诞生江南。","暗中五色，天下云庵。"],0,"x42","宋"],["魏京诗 其三","刘敞","四言",["天监在上，既有明德。","乃命于下，罔有不服。"],0,"x51","宋"],["颂古一百二十一首 其十六","释宗杲","四言",["入门便喝，全无巴鼻。","引得儿孙，弄粥饭气。"],0,"x112","宋"],["绍兴祀岳镇海渎四十三首 其十六 南渎位。","郊庙朝会歌辞","四言",["四渎之利，经营中国。","南曰大江，险兮天设。","维尔有神，隃其庙食。","望秩孔时，我心翼翼。"],0,"x207","宋"],["曾逢原待制真赞","惠洪","四言",["冠冕道德，被服文武。","所临有声，最宜荆楚。","果于去恶，发奸破柱。","为国金汤，折冲尊俎。","广平南海，乖崖西蜀。","如雪中春，和而严肃。","名闻乳儿，威被草木。","能作丰年，茂我百谷。","笔下烟云，胸次丘壑。","风流馀韵，与世酬酢。","至于谈禅，气压诸衲。","戏以法界，玩于掌握。","补衮之线，调鼎之手。","笑而不言，置之怀袖。","咨尔邦民，再拜稽首。","潭非久留，归相明后。"],0,"x42","宋"],["皇雅十首  其二七","尹洙","四言",["於穆圣考，德无与偕。","匪勤于兵，北人遂来。","逮是三纪，远俗以怀。","生民休息，呜呼仁哉。"],0,108,"宋"],["示寂颂","释法忠","四言",["六十六年，游梦幻中。","浩歌归去，撒手长空。"],0,222,"宋"],["明日大夫  其四","曾丰","四言",["明日大夫，何日卿兮。","有苍其佩，礼官清兮。","匪朝伊夕，九繁缨兮。","名遂身退，绵千龄兮。"],0,"x193","宋"],["偈颂一百零一首 其七十三","释慧性","四言",["喝散白云，穿开碧落。","须弥灯王，无处摸索。"],0,46,"宋"],["偈颂一百四十二首 其一二一","释广闻","四言",["秘魔擎杈，鲁祖面壁。","官路不行，拗曲作直。","一日不作，一日不食。"],0,10,"宋"],["丰干赞","释如珙","四言",["人心既无，虎心亦无。","骑来骑去，是汝是吾。","松门杳杳，朗月轮孤。"],0,255,"宋"],["上耿泉生朝  其一","杨简","四言",["瞻彼云台，有那其武。","祝阿发迹，中兴元辅。"],0,118,"宋"],["太常乐章三十首 其二十二 皇帝御殿迎升御座奏隆安之曲","杨亿","四言",["金奏在悬，群后在位。","天威煌煌，向明负扆。","玄览穆清，弁冕端委。","盛德日新，礼容有炜。"],0,"x47","宋"],["栽松道者真身赞","惠洪","四言",["生死变灭，如沤在海。","无有处所，浩然茫昧。","而此老人，游戏自在。","出死入生，初无限碍。","譬如壮士，脱袍著铠。","令铠与袍，俨然相对。","是故山中，两身俱在。","凡夫众生，为眼所盖。","为抉其膜，使生光彩。"],0,"x42","宋"],["偈颂三十首 其二十五","释慧晖","四言",["春梦朦胧，秋月玲珑。","夏凉寂寂，冬寒空空。"],0,194,"宋"],["皇帝上太上皇帝寿乐曲 三举酒用瑞鹤之曲","崔敦诗","四言",["彼肃者羽，名纪仙经。","芝田下啄，容止安停。","引吭警露，响彻青冥。","圣德格物，来仪帝庭。"],0,93,"宋"],["偈二十首 其二","释鼎需","四言",["奔流度刃，未是作家。","疾燄过风，犹为钝汉。"],0,10,"宋"],["淳化中朝会二十三首 三举酒用《河清》。","郊庙朝会歌辞","四言",["沔彼泾渎，澄明鉴如。","清应宝运，光涵帝居。","洞分沈璧，彻见游鱼。","圣祚无极，神休伟与。"],0,"x207","宋"],["绣释迦像并十八罗汉赞 第十六注茶半托迦尊者","惠洪","四言",["心花开敷，行象明洁。","翛然宴坐，秀目丰颊。","万象之语，六根之功。","以手搏取，置不言中。"],0,"x42","宋"],["美李颐老易","赵汝腾","四言",["易之广大，无方无体。","河图授羲，斯文天启。","爰画以象，是陈八物。","演六十四，阖辟伸屈。","文系繇辞，二千爻旨。","孔绝韦编，十翼备矣。","后来濂洛，发明几尽。","万世学者，于此取信。","弘毅李君，以身体易。","消长验气，吉凶考德。","方初学时，四载忘寐。","感苍筤竹，至产于地。","盖三十年，然后成书。","其语不费，其趣有馀。","予得其稿，日置书案。","熟视厥履，为之三叹。","道无隐显，形上繇下。","修辞立诚，穷神知化。"],0,47,"宋"],["达磨祖师赞","释师观","四言",["手提金锡，银山铁壁。","对朕者谁，还云不识。","透过玄关，青天白日。"],0,210,"宋"],["偈颂七十六首 其三十五","释师观","四言",["目顾四方，法中之王。","将何报德，一杓香汤。"],0,210,"宋"],["颂古一百二十一首 其五十八","释宗杲","四言",["睦州担板，那容眨眼。","阔狭短长，不须增减。"],0,"x112","宋"],["颂古三十一首 其十九","释安永","四言",["见兔放鹰，因邪打正。","脚未跨门，直须猛省。"],0,145,"宋"],["标指六偈 见闻","释清远","四言",["见极垂光，听圆含响。","若谓见闻，法成尘想。","光流大千，响传沙界。","对现全彰，无在不在。","声不是声，色不是色。","非色非声，山高水急。","眼不可见，耳不可闻。","非见非闻，宛尔见闻。","见色闻声，脱出根尘。","水月镜像，梦幻施陈。","文殊宝刹，观音普门。","周罗法界，唯子一人。","身土交映，妙绝凡圣。","本有天真，非病不病。","长歌且唱，妙舞更夸。","东西南北，示现空花。","生死去来，去来生死。","若不如是，多过多咎。","兹言未谛，此语皆宗。","标指若示，古人同风。"],0,116,"宋"],["赠饶仲信静镜","包恢","四言",["干不一动，静专动直。","坤不一静，静翕动辟。","艮不一止，动静以时。","本体如是，偏主则非。","惟学初机，贵以静入。","以至终养，贵以静习。","本体既然，动静一如。","乾坤合德，无二无馀。","心为天君，尊无伦比。","圣贤言心，初无论拟。","心比于镜，佛说云然。","镜虽有光，孰拟心天。","镜光则死，心光则活。","活则不滞，死则不豁。","佛法寂灭，匪干匪坤。","若复本心，非彼能昏。","人以欲动，非动之性。","所以贵静，自动自静。","其道光明，无物可并。","惟省尽伦，是为全人。","眼高四海，至此乃真。"],0,127,"宋"],["偈颂八十七首 其八十四","释慧开","四言",["针芥相投，体用俱全。","衲僧门下，十万八千。"],0,65,"宋"],["淳化乡饮酒三十三章  其一八","郊庙朝会歌辞","四言",["崇丘巍巍，动植其依。","高大之性，各极尔宜。","王道坦坦，皇猷熙熙。","仁寿之域，烝民允跻。"],0,"x207","宋"],["淳化乡饮酒三十三章  其一九","郊庙朝会歌辞","四言",["关雎于飞，洲渚之湄。","自家刑国，乐且有仪。"],0,"x207","宋"],["淳化乡饮酒三十三章  其二五","郊庙朝会歌辞","四言",["苹蘩芳滋，同谁掇之。","愿言贤德，靡日不思。"],0,"x207","宋"],["淳化乡饮酒三十三章  其三二","郊庙朝会歌辞","四言",["伊鹊成巢，珍禽戾止。","婉彼佳人，配于君子。"],0,"x207","宋"],["示林宗辰劝学数语","赵汝腾","四言",["青出于蓝，冰寒于水。","立言劝学，荀卿氏子。","卿不如轲，醇乎醇矣。","谓学无他，求其放心。","存则圣贤，舍则犊禽。","差只毫发，隔逾丈寻。","必有事焉，所言何事。","而勿正心，正亦何累。","勿忘勿助，持敬之意。","于此习察，是之谓学。","于此而劝，其进罔觉。","勉哉宗辰，说博守约。"],0,47,"宋"],["停云诗 其一","舒岳祥","四言",["我怀同人，如暵望雨。","天地崩裂，干戈间阻。","陈编孤哦，槁梧自抚。","思而不见，援桂延伫。"],0,"x161","宋"],["赵州和尚赞","释智愚","四言",["眼似鼓椎，头如木杓。","欲识赵州，八十行脚。"],0,"x153","宋"],["妙湛大师求颂","释正觉","四言",["妙则不粗，湛则不浑。","妙湛而照，莹然亡痕。","云山是主，水月无根。","瘦坐一默，虚融六门。","窍作风籁，华含春恩。","相承个事，子子孙孙。"],0,"x88","宋"],["偈颂一一二首 其一","释清远","四言",["世尊拈花，迦叶微笑。","亲切亲切，省要省要。","眼目定动，料料掉掉。","为报先生，莫打之绕。"],0,116,"宋"],["平寇上史君王潜斋","严羽","四言",["治平改元，有盗于建。","昔犯我鄙，狼蹂豕践。","于时王侯，维民之忧。","爰整我军，式遏虔刘。","侯励将士，无哗听我。","进退勇怯，死生福祸。","侯出府库，啖勋赏馘。","前无坚敌，后无捷策。","乃有奇士，据鞍请行。","袒裼入阵，贼莫能婴。","亦有贤僚，争先跋涉。","屡摧贼锋，月奏三捷。","侯曰嘻哉，盗本王臣。","殪而歼旃，伤天地仁。","赤子弄兵，如鱼游釜。","投戈归田，新汝生路。","孰谓反复，绐我行人。","既弛我备，薄奄我军。","我军少却，丑类鸱张。","环数百里，奔播仓皇。","侯曰嗟哉，其不可恕。","驰赤白囊，亟请淮旅。","淮旅未来，阽危如毁。","淮旅既来，稚耋失喜。","侯谓淮将，次舍良苦。","休士秣马，我有清酤。","淮将曰吁，剪此朝食。","不介而驰，直捣其穴。","群丑来聚，亘野弥山。","淮旅整暇，徐诱之前。","弓不虚彀，矢不妄激。","发数步内，应弦而踣。","或戈其喉，或殳其胫。","若乌获力，笞乳臭婴。","党类周章，途殚命窄。","鱼惊鸟散，影不返迹。","淮旅拗怒，虿芥髬髵。","搜林刮莽，远讨穷追。","淮旅拗怒，火烈具举。","沸泽焦崖，窟穴无所。","自相蹈藉，十杀八九。","丧魄亡精，食不知口。","原膏野赤，谷臭川腥。","燐火不燄，殇鬼残形。","乃求元凶，已缢岩阻。","执彼馀魁，入而振旅。","其魁伊何，缁服髡首。","一群纵观，万夫欢走。","炮烙剔腐，以警叛者。","前后献俘，复以百数。","荡涤污垢，宥贷胁从。","收霜卷雹，和气融融。","侯飨淮将，加笾折俎。","庖骑酒车，饮均众伍。","何以赠之，筐篚荧煌。","战功曰多，告成于王。","嗟我妇子，若翁若妪。","安逸怡愉，匪侯何俟。","侯曰此捷，诸将之功。","虽有诸将，实侯指踪。","雠在藩篱，疾居心腹。","急缓安危，若手反复。","匪侯勤请，蔓实难图。","谓予不信，往有覆车。","君子作歌，以颂侯绩。","谁其采诗，顾备简策。"],0,37,"宋"],["送关都官致仕 其二","陈襄","四言",["庶民之耋，职自为愚。","君子之耋，其德有濡。","旅力不愆，曷云其劬。"],0,50,"宋"],["江氏家藏仁宗皇帝墨迹赞","黄庭坚","四言",["昭陵仁圣，与天同功。","不刻不雕，万国文明。","日月照临，无有隐侧。","一滴之雨，泽及万物。","简言易从，易言易知。","皇祖有训，信如四时。","雷声不作，天地渊默。","遗黎怀仁，𫕥泣翰墨。"],0,"x66","宋"],["永明禅师真赞二首 其一","惠洪","四言",["三界种性，有万妍丑。","生顺死逆，梦夜想昼。","往复无间，声度垣牖。","皆依末那，戏论成就。","而末那体，无作无受。","譬如空花，实无而有。","一念了知，光明通透。","我如是见，无有错谬。","是为心宗，祖佛授手。","孰振颓纲，秀杰奇茂。","稽首永明，月临星斗。"],0,"x42","宋"],["永明禅师真赞二首 其二","惠洪","四言",["以公风神，为我律度。","交神见之，是真保护。"],0,"x42","宋"],["景祐孟冬祭神州地祇二首 其一 太宗位奠币用《化安》。","郊庙朝会歌辞","四言",["削平伪邦，嗣兴鸿业。","礼乐交修，仁德该洽。","柔祇荐享，量币攸摄。","侑坐延灵，神休允答。"],0,"x207","宋"],["最明寺殿真像赞","释普宁","四言",["掌持国土，天下安堵。","信向佛法，运心坚固。","德重丘山，名播寰宇。","清白传家，望隆今古。","参透吾宗，眼眉卓竖。","末后一机，超佛越祖。","汝辜负吾，吾辜负汝。"],0,119,"宋"],["绍兴二十八年祀圜丘 文舞退、武舞进用《正安》。","郊庙朝会歌辞","四言",["泰元尊临，富媪繁祉。","于皇祖宗，既昭格止。","奏舞象功，灵其有喜。","永言孝思，尽善尽美。"],0,"x207","宋"],["淳化乡饮酒三十三章  其七","郊庙朝会歌辞","四言",["瞻彼南陔，时物嘉良。","有泉清泚，有兰馨香。","晨饮是汲，夕膳是尝。","慈颜未悦，我心靡遑。"],0,"x207","宋"],["淳化乡饮酒三十三章  其八","郊庙朝会歌辞","四言",["嬉嬉南陔，眷眷慈颜。","和气怡色，奉甘与鲜。","事亲是宜，事君是思。","虔勖忠孝，邦家之基。"],0,"x207","宋"],["哲宗发皇后册宝三首 其二","郊庙朝会歌辞","四言",["我礼嘉成，我驾言旋。","降坐而跸，奏鼓渊渊。","景命有仆，保佑自天。","永锡祚嗣，何千万年。"],0,"x207","宋"],["洴溪桥","赵渥","四言",["油井小聚，洴溪之滨。","夏秋雨集，沟浍皆盈。","众水所汇，实病于行。","谁作斯桥，庞君守真。","宁瘠一己，而利他人。","此心与桥，为世通津。","我观地水，如车转轮。","陵谷变迁，成毁有因。","桥不足恃，所恃者仁。","仁者之心，与石不磷。","矢我铭诗，刻此坚珉。"],0,225,"宋"],["再次四言韵二首 其二","洪炎","四言",["鲁兄卫弟，虞齿虢唇。","倚伏相因，否泰惟匀。","履兹艰虞，慎厥笑颦。","水清见石，天定胜人。"],0,110,"宋"],["六世祖师画像赞 五祖","惠洪","四言",["观前后身，两镜一面。","左右对之，三者顿现。","今非昔是，增金以黄。","昔非今是，谤沉无香。","已绝死生，岂缠老少。","全机现前，常明而妙。","夜江佐舟，吾今渡汝。","句中之眼，如水有乳。"],0,"x42","宋"],["题梅四首 其一","袁甫","四言",["占断春光，水边横枝。","欲识生意，未著花时。"],0,229,"宋"],["停云诗 其三","舒岳祥","四言",["小园宛宛，水木鲜荣。","子念及此，我宁忘情。","曩岁中都，我归子征。","以子出处，用观我生。"],0,"x161","宋"],["方丘乐歌 其五","郊庙朝会歌辞","四言",["四阶秩仪，坛于方泽。","昭事皇祇，即阴以墌。","洁肆于祊，孔嘉且硕。","神其福之，如几如式。"],0,"x207","宋"],["耕甫归书约信二字为别二首 其一","杜范","四言",["水失其防，一决莫止。","人心惟危，殆亦若此。","曾子之守，传习在是。","以约失之，盖亦鲜矣。"],0,115,"宋"],["耕甫归书约信二字为别二首 其二","杜范","四言",["实之谓信，言巽行果。","言有不实，自丧厥我。","谁其掩之，不善已播。","人而无信，不知其可。"],0,115,"宋"],["魏京诗 其九","刘敞","四言",["天子来止，士增其喜。","孰偷其生，以不奋兴。"],0,"x51","宋"],["见石火省彻颂","释自回","四言",["用尽工夫，浑无巴鼻。","火光迸散，元在这里。"],0,36,"宋"],["南郊大礼庆成诗五首 其四 赐赦宣德门","苏颂","四言",["帝陟圜丘，天降之祜。","嘉与士民，均承福祚。","还御端闱，躬布皇度。","鸡星验占，鹄书胪句。","庆浃天渊，恩霏雨露。","涤垢弃瑕，蠲租薄赋。","三泉靡封，五刑几措。","太和充塞，群心率吁。","自古无赦，孰除诖误。","我朝本仁，实清弊斁。","赦匪其私，仁则有裕。","万民以怀，邦基巩固。"],0,"x85","宋"],["辞世偈","释慧开","四言",["虚空不生，虚空不灭。","证得虚空，虚空不别。"],0,65,"宋"],["绍兴祀岳镇海渎四十三首 其七 东渎位。","郊庙朝会歌辞","四言",["我祀伊何，于彼长淮。","导源桐柏，委注蓬莱。","捍齐护楚，宣威示怀。","豆笾列陈，亦孔之偕。"],0,"x207","宋"],["许国公生辰 其四","彭龟年","四言",["恭自内出，俭非外饰。","恭俭而实，是之谓德。","作德日休，心广体逸。","何以曰寿，由是而积。"],0,223,"宋"],["宝祐二年皇子冠二十首 其十二","郊庙朝会歌辞","四言",["复爻肇祥，震维标德。","乃共皮弁，其仪不忒。","体正色齐，维民之则。","璇霄眷佑，国寿箕翼。"],0,"x207","宋"],["淳化乡饮酒三十三章  其一","郊庙朝会歌辞","四言",["鹿鸣呦呦，命侣与俦。","宴乐嘉宾，既献且醻。","献醻有序，休祉无疆。","展矣君子，邦家之光。"],0,"x207","宋"],["淳化乡饮酒三十三章  其六","郊庙朝会歌辞","四言",["鹿鸣相应，聚山之荆。","我燕嘉宾，鼓簧吹笙。","我命旨酒，以逢以迎。","何以荐之，扬于王庭。"],0,"x207","宋"],["淳化乡饮酒三十三章  其二二","郊庙朝会歌辞","四言",["郁郁芳兰，雨露滋之。","温温恭人，圭组縻之。"],0,"x207","宋"],["淳化乡饮酒三十三章  其二七","郊庙朝会歌辞","四言",["洁其粢盛，中心匪宁。","荐于宗庙，助君德馨。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 少昊氏位奠币用《嘉安》。","郊庙朝会歌辞","四言",["西颢肃清，群生茂遂。","有严报典，孔明祀事。","圭币告虔，神灵燕喜。","赉我丰年，以锡民祉。"],0,"x207","宋"],["畴依  其一八","王柏","四言",["于时张子，崛起关中。","虎皮端坐，多士景从。","瞻彼洛矣，道淳所宗。","订顽揭牖，表表正蒙。"],0,"x137","宋"],["元旦训孙","徐经孙","四言",["咨尔潭生，今岁十六。","弃汝幼志，企慕老宿。","收汝放心，归就检束。","业必精思，书必勤读。","敬事父母，出入必告。","钦奉师模，传习必熟。","友爱同气，如手如足。","珍重自身，如圭如玉。","非礼勿视，祇污青目。","非礼勿听，祇乱心曲。","非礼勿言，言必招辱。","非礼勿动，动必非福。","翁作箴言，尔其佩服。","念哉敬哉，中有天禄。"],0,232,"宋"],["绍兴祀岳镇海渎四十三首 其二十三 中镇位。","郊庙朝会歌辞","四言",["禹画九州，河内曰冀。","霍山崇崇，作镇积势。","我祀如何，百末旨味。","承神燕娭，诸神毕至。"],0,"x207","宋"],["高宗建炎初祀昊天上帝 皇帝盥洗用《正安》。","郊庙朝会歌辞","四言",["灵承上帝，厉意专精。","设洗于阼，罍水以清。","盥以致洁，感通神明。","无远弗届，其飨兹诚。"],0,"x207","宋"],["赞崇禧丈室二仙图","张矩","四言",["鹿皮槲叶，容颜枯槁。","青巾白袍，飘然气貌。","不同者形，所同者道。","金丹一丸，天地同老。"],0,12,"宋"],["御赐真赞师演成四偈 其四","释宗杲","四言",["随物现处，廓清寰宇。","不动神情，气吞项羽。"],0,"x112","宋"],["绍定三年寿明仁福慈睿皇太后册宝九首 其四","郊庙朝会歌辞","四言",["金坚玉纯，文郁礼缛。","来从帝所，作瑞王国。","天开地辟，日熙春燠。","兹谓盛事，永燕茀禄。"],0,"x207","宋"],["绍定三年寿明仁福慈睿皇太后册宝九首 其六","郊庙朝会歌辞","四言",["寿为福先，明烛物表。","仁沾动植，福齐穹昊。","曰慈与睿，并崇丕号。","演而申之，万世永保。"],0,"x207","宋"],["偈颂一百三十三首 其十","释居简","四言",["黄梅七百，如龙争珠。","因甚今日，劫在这里。","争之不足，让之有馀。"],0,"x94","宋"],["常思惟大士赞 其十二","释居简","四言",["为散乱人，现如是相。","方其定时，孰为此像。","定乱一如，此像亦无。","若言无像，天地悬隔。"],0,"x94","宋"],["偈颂三十二首 其九","释宗演","四言",["凡圣体真，犹存见隔。","见存即凡，情亡即佛。"],0,49,"宋"],["南郊大礼庆成诗五首 其二 荐享于太庙","苏颂","四言",["天命有宋，系轩纂唐。","祖武宗文，积厚流光。","奕奕清庙，八祏同堂。","五祀备飨，百顺储祥。","皇帝孝思，明发不忘。","躬执圭瓒，再荐嘉觞。","公卿陟降，鼎俎芬芳。","广乐九变，群神迪尝。","昭我先烈，缉熙万方。","永思继述，成不敢康。","始朝于庙，诗歌嗣王。","烈圣在天，保佑我皇。"],0,"x85","宋"]]