[["送驾部刘侯赴阙诗","赵湘","四言",["帝有天命，四方是宣。","祥有时数，元极则传。","爱物在皇，恶盈在天。","惟彼庐墟，安宁有年。","土沃无蠹，民骄且专。","穷侈勿度，宄猾相肩。","彼孽既盈，厥兆斯绵。","天子眷之，丞相竦然。","佥曰畴当，刘侯其贤。","帝命钦哉，布教甚玄。","俭以示之，信以布之。","侈焉猾焉，禁之制之。","惟公拳拳，是民咨咨。","惟民未知，其恶去迟。","公恐公惧，吾知天时。","将及弗度，明年果饥。","雨师不顾，其岁莫支。","回禄仍怒，公豫其知。","虽凶虽燄，弗祷弗祈。","厥民既羸，爰求其私。","始恻天变，相议而辞。","公始俭我，我莫肯随。","公始廉我，谓公启威。","公实爱我，而莫之知。","洎禀公教，里闾相师。","易侈以俭，猾庸悔追。","逮夫次岁，百物咸宜。","雨奋于毕，火藏于离。","民歌且谣，四郊怡怡。","教民肃祗，功德流滋。","史臣弗遗，后世是资。","孝绩未彰，征于帝畿。","腹心肾肠，帝将布其。","民之怀仁，亦孔之微。","公不我留，赍咨涕洟。","来既云暮，去惟是思。","湘采民谣，播于声诗。"],0,126,"宋"],["题梅四首 其三","袁甫","四言",["花勿尽开，尽开香歇。","勿待月圆，才圆即缺。"],0,229,"宋"],["米积外科僧照源堂","洪咨夔","四言",["潜山尽头，孤峰嶭嵲。","布宝鬘云，雨玉珂雪。","中有医禅，碧眼电掣。","人以病求，一岁几𨵚。","开方便门，出广长舌。","病从心起，当从心灭。","方起于心，汹汹烈烈。","不冰而寒，不火而热。","寒热交战，内外症结。","瘰疬疽瘤，痀瘘蹩躠。","汤熨针砭，色察脉切。","不如治心，心和气悦。","如凝斯泮，如壅斯决。","勿药有喜，匪涣其血。","凡浊恶海，万病一辙。","大摩尼珠，一照万彻。","是珠在裓，无有差别。","名九转丹，字千金诀。","为安心竟，寒水秋月。","维摩无病，文殊无说。"],0,"x128","宋"],["颂古一百二十一首 其九十七","释宗杲","四言",["日日日日，时时时时。","违时失候，个老古锥。"],0,"x112","宋"],["维摩居士赞 其二","释师范","四言",["示疾毗耶，平地风波。","医不得处，病在口多。"],0,"x155","宋"],["出火祀大辰十二首 大辰位奠玉币用《嘉安》。","郊庙朝会歌辞","四言",["维莫之春，五阳发舒。","日之夕矣，三星在隅。","莫量匪币，莫嘉匪玉。","明荐孔时，神光下瞩。"],0,"x207","宋"],["偈颂六十首 其二十六","释昙华","四言",["佛祖正印，衲僧藞苴。","有眼如盲，有口如哑。","更问如何，可知礼也。"],0,47,"宋"],["偈颂六十五首  其六","释普济","四言",["浄法界身，馿腮马面。","本无出没，万化千变。"],0,73,"宋"],["宋江三十六赞 其十七 九文龙史进","龚开","四言",["龙数肖九，汝有九文。","盍从东皇，驾五色云。"],0,103,"宋"],["代诸生送蒋守 其一","徐积","四言",["明明楚侯，为国之光。","王明是选，王命是将。","皇皇者华，六辔如濡。","辔且如濡，其德可孚。","其孚维何，洁不可污。","皇皇者华，六辔沃若。","辔且沃若，其德可度。","其度维何，清不可浊。","洁也不污，清也不浊。","德则不渝，泽则不涸。","民则宜之，民则乐之，神亦作之。"],0,"x123","宋"],["伯夷","舒岳祥","四言",["士如圭璋，自然廉隅。","一日无耻，不可以居。","上帝降衷，毁败是虞。","迁史作传，爰首饿夫。"],0,"x161","宋"],["宋颂九首 其六 明道","石介","四言",["图任哲艾，拔崇贤能。","旌贲忠臣，死生光荣。","洗刷敝风，宫阙清明。"],0,105,"宋"],["祥符长老智华写余真求赞","周必大","四言",["五蕴皆空，四大和合。","昔者逢场，东涂西抹。","今兹面壁，有问无答。","似耶非耶，任师指拨。"],0,"x76","宋"],["北窗伊吾 其六","赵戣","四言",["北窗伊吾，吾谁与俱。","融融沂风，怀哉舞雩。"],0,237,"宋"],["运有荣枯行","释文珦","四言",["运有荣枯，道有隆污。","吉凶福祸，相为乘除。","历览旧载，变灭纷如。","或以贪残，或以逼诛。","莫知其端，为之长吁。","予少愚蠢，不能奔趋。","翛然物表，与古为徒。","彼是两忘，乃道之枢。","庶几中庸，匪疾匪徐。","不事王侯，不游国都。","高尚其事，猗那其居。","烟霞冲澹，松竹扶疏。","来往忘机，山泽之癯。","荷裳芰制，可曳可娄。","竺坟鲁诰，可卷可舒。","逍遥林壑，宁畏简书。","临清坐茂，洽比禽鱼。","自守玄默，死生弗渝。","安时处顺，其乐只且。"],0,"x80","宋"],["洪觉范画赞","王庭珪","四言",["谓公为佛，乃工文章。","谓公为儒，乃是和尚。","非佛非儒，是虚空藏。","画虽逼真，实非真相。","作如是见，亦未离妄。","水在瓶中，月在天上。"],0,"x198","宋"],["肱维那求赞","释清远","四言",["识余者谁，请观端的。","孰云丹青，谩劳寻觅。","断云架𪩘，皎月在壁。","昭尔惺惺，悟兹寂寂。"],0,116,"宋"],["善慧大士赞","释智愚","四言",["万派同源，三教一舌。","咄者尊慈，弄巧成拙。"],0,"x153","宋"],["题锦织回文图","方回","四言",["𫄥笄宵衣，古士妇服。","高髻云鬟，叔季之俗。","繄是丹青，间以冠髽。","孰为主妇，果苏蕙耶。"],0,"x59","宋"],["上许州吕相公嗣崧许康诗二首 许康诗 其二","宋祁","四言",["公之相攸，孔乐于许。","其原膴膴，其川𬣙𬣙。","有芃禾麻，有京稷黍。","薮焉麋麕，渚焉鲂𫚈。","有李有桃，有柘有檀。","树我之园，令居则安。"],0,"x49","宋"],["绣释迦像并十八罗汉赞 第七迦理迦尊者","惠洪","四言",["身如蕉虚，心如兔止。","师慈如和，侍者笑视。","毒龙难降，我试弹指。","便升钵中，喜见脊尾。"],0,"x42","宋"],["宋颂九首 其九 明道","石介","四言",["宋承大纪，八十年矣。","明道之政，独为粹美。"],0,105,"宋"],["写真自赞五首 其五","黄庭坚","四言",["似僧有发，似俗无尘。","作梦中梦，见身外身。"],0,"x66","宋"],["高宗皇帝蹙龙手札御书赞","岳珂","四言",["辛伯有言，并后乱本。","惟圣齐家，知益知损。","臣得此书，反其三隅。","一卷之藏，于昭宸谟。"],0,"x202","宋"],["上许州吕相公嗣崧许康诗二首 嗣崧诗 其二","宋祁","四言",["公迈厥德，祗祗翼翼。","柔嘉而直，模我彝伦。","揉我方国，施于夷貊。","百度是毗，庶绩允熙。","罔敢不恪，惟公是若。"],0,"x49","宋"],["感秋诗 其一","许琮","四言",["风动苹起，云光在水。","荇藻有心，清我眸子。","白露在衣，秋心易微。","冠兮佩兮，君子当饥。"],0,6,"宋"],["偈二首 其一","释法因","四言",["天上月圆，人间月半。","七八是数，事却难算。"],0,80,"宋"],["孟君复仲春来杭相聚三月馀一日必三胥会忽焉告去直叙离怀为四言一首","方回","四言",["九年三见，昔疏未亲。","一日三见，今也何频。","有来者马，于霅之滨。","有柳未絮，时维仲春。","岂无可交，华屋朱轮。","接膝握手，岂无他人。","眷焉陋巷，总是累臣。","孟献忘势，王翰愿邻。","嗟子之意，孔厚且真。","揣我所有，阒无一珍。","英英令节，穆穆良辰。","泛彼清涟，出其阇𬮱。","和风吹衣，芳露滴巾。","载听其嘤，载采其辛。","乃馔我鲜，乃酌我醇。","我酣子谑，子吟我呻。","我无子阋，子无我颦。","厥月三团，百笑弗嗔。","积潦满道，朝炊无薪。","系鞍于门，致此嘉宾。","我窥子胸，万卷横陈。","目电舌雷，笔圣诗神。","锻以一字，衡之千钧。","吉甫史克，蒙庄灵均。","出其下者，诅楚过秦。","等而上之，清庙生民。","子逾立年，我登七旬。","顾影自怜，发秃肤皴。","衰颜槁悴，老语谵谆。","送子此谣，肝胆轮囷。","子之家世，凌烟麒麟。","子之爵位，曲逆平津。","我幸未死，山林食贫。","两不相忘，云鸿水鳞。"],0,"x59","宋"],["唐史惟则篆千文帖赞","岳珂","四言",["籀学在唐，阳冰一夔。","彼秩八音，各有工师。","斯帖之奇，体微而具。","何以譬之，磬襄鼗武。"],0,"x202","宋"],["龙眠居士画十六大阿罗汉赞 其六","李纲","四言",["老矣衰疲，背依禅板。","读经可为，聊用遮眼。","植膝垂足，狮子衔花。","杜其德机，岂有斯耶。"],0,"x136","宋"],["晨入东寺阅藏行香","仇远","四言",["明星未高，繁霜已肃。","娟娟落月，犹挂茅屋。","我马遑遑，我车仆仆。","晨入缁林，坐阅梵牍。","字奇义奥，了不可读。","空元无象，奚事耳目。","简书期程，轩冕桎梏。","顾影自哂，未能免俗。","名教真乐，言语谷粟。","何时式微，知足不辱。"],0,"x84","宋"],["宝祐二年皇子冠二十首 其十五","郊庙朝会歌辞","四言",["席于宾阶，礼义以兴。","受爵执爵，多福以膺。","匪惟服加，德加愈升。","匪惟德加，寿加愈增。"],0,"x207","宋"],["宝祐二年皇子冠二十首 其十八","郊庙朝会歌辞","四言",["青社分封，前星启燄。","繁弱绥章，厥光莫掩。","容称其德，蓄学之验。","芳誉敷华，大圭无玷。"],0,"x207","宋"],["皇帝上太上皇帝寿乐曲 五举酒用老人星见之曲","崔敦诗","四言",["奕奕南极，应期曜灵。","祥晖昭衍，次丙躔丁。","事垂汉史，名著甘经。","锡符祚圣，亿万斯龄。"],0,93,"宋"],["汾阴十首 其八 亚、终献用《正安》。","郊庙朝会歌辞","四言",["至哉柔祇，滋生蕃锡。","涤濯静嘉，寅恭夕惕。","金奏纯如，万舞有奕。","立我烝民，莫匪尔极。"],0,"x207","宋"],["龙眠居士画十六大阿罗汉赞 其三","李纲","四言",["叉指膝间，目视霄汉。","意象轩举，邈无畔岸。","刚大之气，塞于天渊。","俯仰无怍，纵心浩然。"],0,"x136","宋"],["偈颂五十一首 其二十七","释大观","四言",["一见便见，临崖浒眼。","一得永得，坐井观天。"],0,181,"宋"],["颂古四十八首 其十四","释慧开","四言",["赵州若在，倒行此令。","夺却刀子，南泉乞命。"],0,65,"宋"],["题梅四首 其四","袁甫","四言",["竹外一枝，啸傲东风。","许多真趣，在有无中。"],0,229,"宋"],["高宗祀明堂前朝享太庙二十一首 其五 捧俎用《丰安》。","郊庙朝会歌辞","四言",["来相于庭，鸣𫓶锵锵。","奉牲而告，登彼雕房。","非牲之备，民庶是康。","神依民听，上帝斯皇。"],0,"x207","宋"],["续琴操哀江南 兴言自古四之四","谢翱","四言",["兴言自古，使我速老。","麋鹿是游，姑苏荒草。","起秣我马，裴回旧乡。","江山不改，风景忘亡。","谁触尘埃，不见日月。","梨园云散，羽林鸟没。","吞声踯躅，悲风四来。","尔非遗民，胡独不哀。"],0,222,"宋"],["李氏绣佛赞 其二","刘跂","四言",["巍巍堂堂，妙庄严聚。","一念现前，非针非缕。","文闻已彰，何妨金露。","满月当空，谁知在处。"],0,94,"宋"],["龙眠居士画十六大阿罗汉赞 其一","李纲","四言",["佛所印可，大阿阇黎。","隐几合爪，泊然无为。","恳请何人，投地作礼。","不起于坐，应供千里。"],0,"x136","宋"],["偈颂十二首 其八","释道璨","四言",["不拨一境，不露一机。","锦包特石，绵裹秤椎。"],0,93,"宋"],["绣释迦像并十八罗汉赞 第六跋陀罗尊者","惠洪","四言",["两鬼投书，与僧聚语。","师窃闻之，抱膝回顾。","我心均平，等视诸趣。","一念舍心，即离五怖。"],0,"x42","宋"],["偈颂一百六十首 其三十九","释宗杲","四言",["如天普盖，似地普擎。","一念相应，一时清净。"],0,"x112","宋"],["龙眠居士画十六大阿罗汉赞 其五","李纲","四言",["藕花满缶，莲房自拆。","神通妙用，在于举拂。","童子何知，跪观戏龟。","六用不藏，使之者谁。"],0,"x136","宋"],["龙眠居士画十六大阿罗汉赞 其八","李纲","四言",["本无戒持，何尝有破。","方便为说，三世因果。","服饰炜然，王者之妃。","前跪谛听，善思念之。"],0,"x136","宋"],["礼大梅常禅师塔","释智愚","四言",["鼯鼠声中，颠来倒去。","马颔驴腮，不须解注。"],0,"x153","宋"],["停云诗 其四","舒岳祥","四言",["俯仰换世，昨梦蚁柯。","故交零落，屈指无多。","孔时尹任，夷清惠和。","各言尔志，夫也如何。"],0,"x161","宋"],["摄事十三首 其二 太尉行用《正安》。","郊庙朝会歌辞","四言",["祼鬯溥将，宾尸在位。","帝德升闻，孝思光被。","公卿庶正，傅御师氏。","至诚感神，福禄来暨。"],0,"x207","宋"],["龙眠居士画十六大阿罗汉赞 其四","李纲","四言",["华林扰虎，手举数珠。","驯彼郁屈，亦用兹乎。","巨颡修鳞，能怖童子。","慈眼视之，毒心自弭。"],0,"x136","宋"],["宝祐二年皇子冠二十首 其十六","郊庙朝会歌辞","四言",["命服煌煌，跬步中度。","庆辑皇闱，化行海宇。","礼具乐成，惕若戒惧。","宝璐厥躬，有秩斯祜。"],0,"x207","宋"],["龙眠居士画十六大阿罗汉赞 其九","李纲","四言",["龙鱼秘怪，各有佛性。","散花投经，出没游泳。","具大悲心，平等施之。","往因妙力，人天之资。"],0,"x136","宋"],["绍兴二十八年祀圜丘 昊天上帝位酌献用《禧安》。御制。","郊庙朝会歌辞","四言",["谒款坛陛，祗祀泰禋。","丘圜自然，可格至神。","桂尊登酌，嘉荐芳新。","靡福菲眇，敷佑下民。"],0,"x207","宋"],["祭果南涧南叔凯","释善珍","四言",["我憩闽北，叔凯枉顾。","出南涧书，剧谈至暮。","言昔之夜，得梦怪奇。","当与藏叟，会阿耨池。","想耶因耶，一笑眇邈。","执手告戒，义均骨肉。","心平行粹，爱南涧翁。","人百忤之，而无愠容。","凯病且贫，户满客屦。","翁常解衣，骚骚治具。","嘉翁风致，古人所难。","鄙夫悭啬，拔毫如山。","吁嗟衰年，失二益友。","耨池西方，游必俱不。","昼诗绝吟，永帖罢挥。","猿哀鹤怨，金环不归。","吊既后时，奠复不早。","瓣香忏悔，泪湿春草。"],0,45,"宋"],["洪文惠盍簪帖赞","岳珂","四言",["公作隶古，与先汉侔。","发为书翰，顺涂挟辀。","公相孝宗，曾不少留。","归安一丘，始终休休。","我护淮饷，祖公前修。","登华信亭，步得江楼。","摩挲石题，瞻睇银钩。","风静鹊巢，月明沙鸥。","意公其来，偕造物游。","迹则不磨，心兮焉求。"],0,"x202","宋"],["转轮八花诗 钩枝上四十八句左旋阳字韵右旋昊字韵","项安世","四言",["缟夜李积，炫昼桃缃。","皓梨斗雪，金柳敷黄。","杲日天丽，和风海翔。"],0,"x55","宋"],["四先生像赞 象山陆文安公","刘黻","四言",["卓学迈伦，居超径诣。","观我灵龟，以烛来世。","展矣君子，克广厥居。","澄然自得，春风咏归。"],0,247,"宋"],["酬寺簿劝农追和渊明见贻","罗愿","四言",["江汉之会，中具五民。","见异而迁，乃丧厥真。","相彼樊山，我行所因。","有闲其壤，问彼居人。","方时清明，家自为稷。","其薮其浸，其动其植。","孰为使民，有田不穑。","亦惟蒲鱼，恃此鲜食。","岁运周回，景躔西陆。","帝籍重开，天颜逾穆。","耕事将起，毋荒游逐。","凡我农官，戒民宜宿。","戒民伊何，美成在久。","譬彼射侯，则求其耦。","驱率慵堕，转缘南亩。","数耘疾收，在而心手。","农亦有书，匪藏金匮。","盍耕如莘，盍馌如冀。","桑荫清好，浊醪日至。","已勤而食，则无所愧。","勿谓此州，远连边鄙。","我疆西北，尽其四履。","风雨顺时，日星循轨。","屡丰作颂，以致归美。"],0,84,"宋"],["上许州吕相公嗣崧许康诗二首 许康诗 其一","宋祁","四言",["许丽而康，岳孙奠之。","曰公之屏，实维似之。","公徒增增，朱綅绿縢。","不戁不惊，钩膺镂锡。","称娖颜行，哕焉绥章。","总我列侯，式时南疆。"],0,"x49","宋"],["和冯济川题枯髅图","释妙喜","四言",["只此形骸，即是其人。","一灵皮袋，皮袋一灵。"],0,4,"宋"],["钟离仙赞","李昴英","四言",["衣兮木叶，髯戟面铁。","所执何书，愿闻其说。"],0,124,"宋"],["三衢效周雅作鹿鸣宴诗三章  其一","袁甫","四言",["鹿鸣鹿鸣，呦呦之声。","我有嘉宾，柯山之英。","来燕公堂，天府是升。","同我乡老，遹观厥成。"],0,229,"宋"],["偈颂二十五首 其二十二","释智愚","四言",["说如建瓴，坐如山岳。","就下平高，咬牙爆爆。"],0,"x153","宋"],["偈颂十二首 其七","释道璨","四言",["临济一喝，德山一棒。","霹雳电光，宁容近傍。"],0,93,"宋"],["偈颂三十首 其三十一","释慧晖","四言",["不夜真灯，破夜心月。","穿日玄谈，不日妙诀。","一句了然，不涉途辙。"],0,194,"宋"],["沈睿达昭君诗帖赞","岳珂","四言",["玉徽十三，维以寓声。","支郎何心，写脂粉情。","汉冢春青，塞霜晓白。","千年之悲，表此遗墨。"],0,"x202","宋"],["绍兴以后祀五方帝六十首 青帝奠玉币用《嘉安》。","郊庙朝会歌辞","四言",["物之熙熙，胡为其然。","蒙神之休，乃敢报旃。","有邸斯圭，有量斯币。","于以奠之，格此精意。"],0,"x207","宋"],["摄事十三首 其十二 彻豆用《丰安》。","郊庙朝会歌辞","四言",["鼎俎既陈，豆笾既设。","金石在庭，工师就列。","备物有严，著诚致洁。","孝惟时思，礼以雍彻。"],0,"x207","宋"],["淳熙二年发太上皇帝太上皇后册宝十一首 其二 中书令、侍中奉册宝诣殿下用《正安》。","郊庙朝会歌辞","四言",["受命既长，福禄既康。","如日之升，如月之常。","追琢其章，金玉其相。","君子万年，保其家邦。"],0,"x207","宋"],["宋颂九首 其八 明道","石介","四言",["十年深宫，不有其权。","今日南面，退奸进贤。"],0,105,"宋"],["上许州吕相公嗣崧许康诗二首 嗣崧诗 其一","宋祁","四言",["彼岳惟崧，天作其神。","嗣生我公，我公斤斤。","嘉猷矢陈，柄国之均。","帝亲命之，纂成前人。","不显其道，惟申是保。"],0,"x49","宋"],["淳熙十二年加上太上皇帝太上皇后尊号十一首 其八 太傅、中书令、侍中奉太上皇后册宝升殿用《圣安》。","郊庙朝会歌辞","四言",["坤载有元，干行是顺。","施生万汇，厥德弥盛。","翼翼母道，赞我皇训。","相维群公，奉典斯敬。"],0,"x207","宋"],["鄂忠武王出师疏帖赞","岳珂","四言",["于惟绍兴，扶危支倾。","揠校涖戎，不识一丁。","先王奋呼，起自诸生。","经通谊明，笔妙墨精。","翠微之诗，五岳之盟。","祁阳整旅，东松纪行。","迹遍九州，气凌三精。","粤时出师，首兹抗旌。","规模弗愆，忠愤莫撄。","上心载嘉，奎章式形。","谓朕何忧，惟尔责成。","以百万师，观我甲兵。","仅四十里，复我旧京。","日却阳侯，星陨中营。","苌血遂碧，狐史漫青。","天不诱衷，曷其底宁。","伤哉离骚，坐此修能，冰镂芷馨。","惟帝鉴忠，惟人与诚。","烈并褒鄂，志恢幽并。","有奕龙迹，遹昭骏声。","遗墨既刊，大猷是经。","对于庙祧，岂惟云仍。"],0,"x202","宋"],["和陶劝农韵勉吾乡之学者 其六","吴芾","四言",["纵得美官，人亦见鄙。","若博群书，更坚素履。","虽处常流，亦超尘轨。","一旦进为，必兼众美。"],0,"x95","宋"],["宝陀三句 其二","释普济","四言",["宝陀一玄，掣臂揎拳。","打失鼻孔，苍天苍天。"],0,73,"宋"],["绍兴以后祀五方帝六十首 神农氏奠币用《嘉安》。","郊庙朝会歌辞","四言",["练以𫄸黄，有篚将之。","肸蚃斯答，有神昭之。","维神于民，实始货食。","归德报功，敢怠王国。"],0,"x207","宋"],["大慧赞","释师范","四言",["僧中之龙，法中之王。","赞不及处，衡阳梅阳。"],0,"x155","宋"],["偈颂六十五首 其七","释咸杰","四言",["有句无句，如藤倚树。","石裂崖崩，毒蛇当路。","树倒藤枯，悉哩苏𠰷。"],0,92,"宋"],["程伊川赞","陈长方","四言",["道如皎日，丝毫不隔。","人自迷之，转南为北。","寥寥千载，𧥄𧥄百家。","精罢力惫，言多道遐。","惟吾夫子，神交累圣。","一念全德，千差尽正。","发古关键，推与人同。","学焉得此，作圣之功。","浩乎无倪，体之甚迩。","力扶斯文，仆而复起。","我瞻遗像，非没非存。","传之后裔，愈久弥尊。","有功生民，不下神禹。","非知道者，将谁告语。"],0,142,"宋"],["绍兴祀岳镇海渎四十三首 其四十 北海位。","郊庙朝会歌辞","四言",["八裔皆水，此一会同。","沄沄天墟，洞荡洪蒙。","至哉维坎，不有斯功。","所秩伊何，黄流在中。"],0,"x207","宋"],["龙眠居士画十六大阿罗汉赞 其二","李纲","四言",["倚杖于肩，屈指近喙。","废经不读，思第一义。","大狮子吼，真狮子儿。","转秘密藏，其谁能知。"],0,"x136","宋"],["颂古九十八首 其二十九","释印肃","四言",["仰之弥高，钻之弥坚。","瞻之在后，忽然在前。","石头重举，隐峰无言。","若更不会，三千大千。"],0,"x121","宋"],["赠吕公侍讲","徐积","四言",["我敬吕公，以其德齿。","敬之爱之，何时已已。","美哉吕公，文在其中。","见乎外者，古人之风。","维贤有德，神相其祉。","何以祝公，勿药有喜。"],0,"x123","宋"],["金刚经偈寄示西林总长老","白玉蟾","四言",["以字不成，八字不是。","如是我闻，早落第二。"],0,"x77","宋"],["续南有嘉鱼  其二","曾丰","四言",["维夏之时，维孟之月。","谁浪尔迹，于哺于歠。","惟物是訹，与潏俱出。","莫税其罼，亦孔之拙。"],0,"x193","宋"],["汾阴十首 其三 奉俎用《丰安》。","郊庙朝会歌辞","四言",["博硕者牲，载纯其色。","体荐登俎，聿崇坤德。"],0,"x207","宋"],["偈颂一百四十二首 其三十七","释广闻","四言",["炎炎普热，纷纷下雪。","百丈耳聋，黄檗吐舌。"],0,10,"宋"],["赞文公朱先生像","陈宓","四言",["貌温而严，德刚而粹。","春融秋肃，渊澄岳峙。","道光二程，识高百氏。","生遇明时，进难退易。","天假之间，斯文大备。","伟哉夫子，教垂万祀。"],0,"x124","宋"],["感秋诗 其二","许琮","四言",["小草在砌，颜色常好。","岂无严霜，先彼长栲。","寄言青松，斧斤自从。","子不在山，真节安庸。"],0,6,"宋"],["宋颂九首 其一 金陵","石介","四言",["金陵峨峨，长江万里。","谁为巢穴，养此蛇豕。","天岂作限，而险而恃。","不顺不臣，敢亢天子。"],0,105,"宋"],["万岁通天帖赞","岳珂","四言",["洛石赤心，以出宝图。","燕涎鸡晨，即瑞制书。","有奕王门，南土华腴。","献其家珍，陈于玉除。","笔法之神，匪临伊摹。","史馆之储，尚其不诬。"],0,"x202","宋"],["南陔五章二章章八句三章章四句  其四","郑刚中","四言",["瞻彼禽鸟，亦哺其母。","养而弗驩，于孝奚取。"],0,"x99","宋"],["傲暑栖霞洞","李彦弼","四言",["嵌窦栖霞，𪜎𧇠转杓。","左骖鸾翼，右耳凤箫。","爽排酷烈，境邈氛嚣。","静者多妙，于焉消摇。"],0,23,"宋"],["绣释迦像并十八罗汉赞 释迦佛","惠洪","四言",["指以心运，茸以针通。","针针是佛，佛佛皆茸。","十分月满，万国春同。","稽首真慈，生女巧中。"],0,"x42","宋"],["绍兴以后蜡祭四十二首 神农位酌献。曲同夜明。","郊庙朝会歌辞","四言",["荡荡鸿明，称秩群祀。","配以昔帝，式重农事。","洁我圭瓒，黄流在中。","灵其监兹，肸蚃丰融。"],0,"x207","宋"],["朝阳穿破衲赞","释可湘","四言",["寸铁在手，横穿竖穿。","劄不入处，日轮升天。"],0,158,"宋"],["果州团练使何公","《靖康小雅》作者","四言",["巍巍京师，帝王之泽。","临制华夏，宪相紫极。","边尘涨天，雨坠矢石。","千雉摧毁，公死于敌。","欃枪舒芒，万象变色。","独垂忠烈，以光载籍。"],0,91,"宋"],["南城吴氏记予七十三岁之颜","周必大","四言",["蟠木离奇，病鹤摧颓。","以若形骸，而卜襟怀。","无才无能，不竞不猜。","十目所视，人焉廋哉。"],0,"x76","宋"]]