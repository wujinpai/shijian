[["偈一百二十首 其一○三","释怀深","四言",["身心一如，身外无馀。","便恁么会，缘木求鱼。"],0,"x134","宋"],["淳熙三年发皇后册宝十三首 其二","郊庙朝会歌辞","四言",["卜月惟良，练辰斯臧。","臣工在庭，剑佩玱玱。","来汝疑丞，明命是将。","有淑其仪，无或怠遑。"],0,"x207","宋"],["颂古九首 其八","释思岳","四言",["天魔谤佛，桀犬吠尧。","巍巍大人，圣德可昭。"],0,63,"宋"],["皇帝冬至御大庆殿举第一盏酒奏庆云之曲","王珪","四言",["乾坤顺夷，皇有嘉德。","爰施庆云，承日五色。","轮囷下垂，万物皆饰。","维天祚休，长被无极。"],0,"x35","宋"],["贵贱吟","邵雍","四言",["系自我者，可以力行。","系自人者，难乎力争。","贵为万乘，亦莫之矜。","贱为匹夫，亦莫之凌。"],0,"x57","宋"],["三月十三日夜五更闻杜鹃时成父欲入浙因赋六章章四句以送之  其五","赵蕃","四言",["不如归去，载丁载宁。","劝子勿去，子宁我听。"],0,"x36","宋"],["偈","释惟简","四言",["莫离盖缠，莫求佛祖。","去此二图，以何依怙。","江淹梦笔，天龙见虎。","古老相传，月不跨五。"],0,67,"宋"],["偈颂七十六首 其二十七","释师范","四言",["一阳来复，万汇发生。","寒谷回春，冰河解冻。"],0,"x155","宋"],["文宣王及其弟子赞 其二十二","赵构","四言",["乐善哲士，伯于汧阳。","传道克正，垂名久臧。","执德以洪，用心必刚。","袤广业履，式赞素王。"],0,249,"宋"],["惠门寺钟铭","王庭珪","四言",["万动俱寂，如大虚空。","虚空无椎，何物为钟。","傍震万壑，高闻九穹。","声缘何起，吾知所从。","钟邪椎耶，莫尸其功。","隐如雷霆，在大千中。"],0,"x198","宋"],["偈颂一百三十三首 其二","释法薰","四言",["高峰方丈，内外皆空。","垂钩四海，只钓狞龙。"],0,31,"宋"],["有美人兮四章  其三","赵友直","四言",["有美人兮，在天之南。","思之勿得，我心惔惔。"],0,49,"宋"],["寄三山彭鹤林","白玉蟾","四言",["瞻彼鹤林，在彼无诸。","鼓山之下，螺江之隅。","瞻彼鹤林，在彼长乐。","嵩山之上，螺江之角。","一别鹤林，春聿云杪。","青山之外，落花啼鸟。","一望鹤林，回首千里。","斜阳之外，白云流水。","日复一日，思我鹤林。","雁断鱼沉，实伤我心。"],0,"x77","宋"],["止堂铭","释守卓","四言",["旨哉斯堂，全观全止。","是止亦止，应现何已。","法尔而然，不默则病。","必尔之归，渊默生定。","妙定圆极，心精发光。","不出户牖，灵鉴十方。","既超动静，无住者存。","居之而安，左右逢原。"],0,42,"宋"],["观音大士赞","释普济","四言",["空如来藏，立大圆镜。","水落石出，月明云净。","瞻之仰之，群机普应。"],0,73,"宋"],["补乐府十篇 其四 帝少昊氏之乐歌","曹勋","四言",["鸟飞于天，鱼跃于渊。","侯其尸之，其然而然。","物之生矣，时其殖矣。","职其宜矣，安其居矣。","神之降依，昭假左右。","霜露所沾，罔不在宥。"],0,"x103","宋"],["智贤上人","释祖钦","四言",["智者必贤，正者不偏。","平坦性地，朗我心天。","折旋俯仰，诸佛现前。","一光同照，万象枞然。"],0,64,"宋"],["九月 其四","曾丰","四言",["八月撷葵，十月撷梨。","匪蚤伊迟，菊在中兮，有神有奇。","于以却艾，宁复云耆。","八月撷枣，十月撷稻。","匪迟伊蚤，菊在中兮，有化有造。","于以却老，宁复云耄。"],0,"x193","宋"],["颂古四十四首 其十一","释师范","四言",["金毛狮子，生铁秤锤。","浑仑无缝，切忌针锥。"],0,"x155","宋"],["六句偈六首 其三 前念非凡","释清远","四言",["前念非凡，语正言谗。","天高海阔，毛羽毵毵。"],0,116,"宋"],["转轮八花诗 其七","项安世","四言",["皞皞情适，熙熙俗康。","媪富流形，物阜舆方。","造回坱圠，元化施张。"],0,"x55","宋"],["偈十首 其九","释道行","四言",["问问不差，答答不错。","问答去来，龟毛兔角。"],0,75,"宋"],["和君时十章章四句  其四","彭汝砺","四言",["温凊匪偕，云如之何。","得彼失兹，得失孰多。"],0,"x143","宋"],["得老龙见和复呈","陈渊","四言",["是渠白芽，聚为黑块。","方讶墨坚，复如粉碎。","生灭灭已，元非内外。","说性说形，又说一味。","急点一杯，扶居士醉。"],0,"x154","宋"],["偈颂一百六十首 其一五五","释宗杲","四言",["千灵万圣，万圣千灵。","莫顺人情，吉凶上卦。"],0,"x112","宋"],["偈六十九首 其四十一","释道宁","四言",["宗门奥旨，祖室玄枢。","不遇当人，翻成影响。"],0,119,"宋"],["采蕺 其一","王十朋","四言",["陟彼越山，言采其蕺。","我思古人，中心悒悒。","维国有耻，吴弗遑粒。","胆于坐隅，霸勋以集。"],0,"x61","宋"],["谢李自明","徐积","四言",["养以其久，真以其积。","维积维久，是以为德。","德而德之，或表而失。","德而弗德，然后能造。","孰为斯施，孰为斯报。","德其德者，伐干以斧。","弗德其德，培以根土。","德乎斯乎，其孰御乎。"],0,"x123","宋"],["精卫诗","吕本中","四言",["西山有鸟，其状如乌。","名曰精卫，其名自呼。","精卫堙海，不堙不止。","问谁之报，云帝之子。","帝子女娃，往游不还。","精卫求之，不敢有安。","海流不改，汝堙不迁。","嗟哉精卫，志则可怜。","我昔读书，惟圣之求。","竭力从之，以春及秋。","老人宴居，审吾之学。","惟时友朋，日就雕琢。","圣言甚微，吾意则近。","近以识微，退或有进。","三年于曹，惟罪之恐。","人虽甚厌，子亦不勇。","舒舒其云，沄沄其水。","子不与归，而曰有以。","豕羊在牢，刍秣之恋。","烹庖及之，抑又谁怨。","予学日远，子道日疏。","有愧精卫，其谁与居。","精卫之飞，不必戾天。","子之不如，宁有智焉。","惟作与否，愚智之择。","小人作诗，惟一劝百。"],0,"x83","宋"],["解空居士赞","惠洪","四言",["空若不解，即是断空。","解若不空，即是法执。","是故居士，独号解空。","窠臼不立，凡圣岂存。","是谁宗旨，临济仍云。"],0,"x42","宋"],["送江倅","徐积","四言",["昔之别驾，则有王祥。","其民歌之，海隅称焉。","今亦有人，能绍厥后。","民之悦之，称不容口。","庶民所见，乃其皮肤。","见察情伪，见敏簿书。","见法平恕，见狱空虚。","事见无留，才见有馀。","己不敢肆，人安厥居。","其所见者，止于君子。","良士大夫，谓其所性。","得之刚毅，所以能断。","所以无蔽，所以敢为，所以勇义。","决遣簿书，是其馀事。","汉之朱博，赵张龚尹。","抚恤大众，何独古人。","王祥虽贤，失在宝刀。","正而平者，心则不摇。","人或赠之，则弗受之。","借曰受之，何佩有之。","弗佩曰正，曰平维平，宜于朝廷。","用之一方，一方之纲。","在我者正，是谓为政。"],0,"x123","宋"],["天地无穷行","释文珦","四言",["天地无穷，人处于中。","三才既兆，庶类皆通。","至圣立极，万方所宗。","如星拱北，如水朝东。","垂衣而治，天下为公。","孝慈道广，是谓大同。","自兹而降，谋用是崇。","兵由此起，彊弱相攻。","上下分乱，莫知适从。","匪兹礼义，曷能靖共。","顺之者吉，逆之者凶。","不能率此，斯曰颛蒙。","穷通得丧，实维降衷。","巧愚不与，系于遭逢。","毋肆小智，以菑厥功。","安时处顺，于焉考终。"],0,"x80","宋"],["寄君时四章章四句  其四","彭汝砺","四言",["仲兮仲兮，曷日汝偕。","以事以游，以慰予怀。"],0,"x143","宋"],["题毛霆甫诗集 其一","文天祥","四言",["英英白云，在涧之𣸣。","彼美人兮，其德孔纯。"],0,"x53","宋"],["有美人兮四章  其二","赵友直","四言",["有美人兮，在天之西。","见之勿遂，我心凄凄。"],0,49,"宋"],["自赞 其三","释文准","四言",["我已是妄，尔更妄写。","妄我妄写，两重虚假。","欲传吾真，须泯见闻。","声色不碍，相似十分。"],0,254,"宋"],["颂古三首 其一","释可封","四言",["阿魏无真，水银无假。","老倒南泉，可知礼也。"],0,22,"宋"],["颂古三十一首 其二十三","释如本","四言",["家世拄杖，佛祖付嘱。","沩山寄来，香严发哭。","父子投机，阳春雪曲。","不是知音，大难相续。"],0,205,"宋"],["文宣王及其弟子赞 其二十九","赵构","四言",["伯兹雩娄，务学实著。","三千之位，七十是预。","匪善莫行，惟德乃据。","纪干前书，式彰厥誉。"],0,249,"宋"],["和君时十章章四句  其七","彭汝砺","四言",["凡人逐物，其力则倍。","苟知其养，是用无悔。"],0,"x143","宋"],["又求胡忠简公赞","周必大","四言",["春秋尊王，外攘夷狄。","幼学壮行，终始惟一。","凛然英气，尚父是匹。","揭之徂征，可却回纥。"],0,"x76","宋"],["宋江三十六赞 其二十三 神行太保戴宗","龚开","四言",["不疾而速，故神无方。","汝行何之，敢离大行。"],0,103,"宋"],["和陶时运四首，并引 其三","苏轼","四言",["我视此邦，如洙如沂。","邦人劝我，老矣安归。","自我幽独，倚门或挥。","岂无亲友，云散莫追。"],0,"x67","宋"],["文宣王及其弟子赞 其九","赵构","四言",["升堂惟光，千乘惟权。","陵暴知非，委质可贤。","折狱言简，结缨礼全。","恶言不耳，仲尼赖焉。"],0,249,"宋"],["治乱吟五首 其一","邵雍","四言",["乱多于治，害多于利。","悲多于喜，恶多于美。","一阴一阳，奈何如此。"],0,"x57","宋"],["口诀颂","周无所住","四言",["意到心诚，湛然若凝。","昼夜无间，效验自应。"],0,69,"宋"],["颂古六首  其三","释士珪","四言",["劈面三拳，连腮七掌。","尽大地人，不知痛痒。"],0,232,"宋"],["颂古二十七首 其三","释昙贲","四言",["六月上伏，八月中秋。","人平不语，水平不流。"],0,80,"宋"],["山行见月作 其四","赵蕃","四言",["恨我无酒，负尔一醉。","酌兹寒泉，兀尔忘睡。"],0,"x36","宋"],["文宣王及其弟子赞 其十七","赵构","四言",["猗尔子上，鲁邦之望。","以德则贵，惟道是唱。","师聪师明，友直友谅。","伯于祝阿，儒风斯畅。"],0,249,"宋"],["太常乐章三十首 其二十一 皇帝回仗乾元殿奏采茨之曲","杨亿","四言",["礼成于郊，迎日之至。","时乘六龙，天旋象魏。","端门九重，虎贲万骑。","四夷来王，群后辑瑞。"],0,"x47","宋"],["法度颂","周无所住","四言",["清净药材，密意为丸。","十二时中，无念火煎。"],0,69,"宋"],["人我","张伯端","四言",["我不异人，人心自异。","人有亲疏，我无彼此。","水陆飞行，等观一体。","贵贱尊卑，首足同己。","我尚非我，何尝有你。","彼此俱无，众泡归水。"],0,152,"宋"],["临济赞","释崇岳","四言",["一棒一喝，倾湫倒岳。","凌蔑吾宗，这白拈贼。"],0,222,"宋"],["寄君时四章章四句  其二","彭汝砺","四言",["我帆我舟，泛彼大江。","母也吾忧，匪食或皇。"],0,"x143","宋"],["寄君时四章章四句  其二","彭汝砺","四言",["我游我庭，有菊之苗。","于以芼之，既旨且时。"],0,"x143","宋"],["遗偈","释庆闲","四言",["露质浮世，奄质浮灭。","五十三岁，六七八月。","南岳天台，松风涧雪。","珍重知音，红炉优钵。"],0,3,"宋"],["书亡弟殡所","邵雍","四言",["后乎吾来，先乎吾往。","当往之初，殊不相让。"],0,"x57","宋"],["天道虽远行","释文珦","四言",["天道虽远，人心匪殊。","内直不欺，与天为徒。","对越无愧，陟降恒俱。","祝史陈言，曾非矫诬。","桑林之祷，金縢之书。","至诚感通，如鼓应桴。","神人以和，大信以孚。","不勉不思，自止于符。","天有常道，人无异涂。","志斯一矣，天其远诸。","大道既漓，人心日渝。","背天从欲，覆族亡躯。","作善降祥，为恶速辜。","圣言孔彰，是训是谟。","一念之差，千里而迂。","惟当自修，以反厥初。"],0,"x80","宋"],["内外吟 其一","邵雍","四言",["衣冠严整，谓之外修。","行义纯洁，谓之内修。","内外俱修，何人不求。"],0,"x57","宋"],["和君时十章章四句  其二","彭汝砺","四言",["猗彼君子，克诚其身。","匪禄是荣，日以养亲。"],0,"x143","宋"],["疏山仁禅师赞","惠洪","四言",["三支习气，其毒炽然。","熏烝识心，盘屈纠缠。","众生不明，横生疑怖。","忽然见之，辄自惊仆。","空花世间，本离生灭。","廓然十方，露其窘穴。","唯矬师叔，是大幻师。","与夺万法，自在娱嬉。","乃知大千，皆公戏具。","手中木蛇，是曹家女。"],0,"x42","宋"],["偈颂三十首 其二十三","释印肃","四言",["显老明禅，入理深渊。","文殊为体，妙用普贤。","凤山得旨，妙契南源。","三株树下，坐断云烟。","金刚作眼，鼻孔辽天。","言谈讽咏，草木皆鲜。","钦风久矣，偶睹惠然。","如天甘露，沃我心田。","希有希有，世外金仙。","老婆心切，示我窥鞭。","自知本有，久被尘缠。","普光明殿，海印俱全。","弥勒阁中，了了何言。","常在不欠，触目无边。","一毫头上，妙绝偏圆。","含融法界，本体现前。"],0,"x121","宋"],["颂古三十二首 其八","释明辩","四言",["冤憎会苦，爱别离苦。","钝置瞿昙，一场莽卤。"],0,141,"宋"],["祖机上人","释祖钦","四言",["灵妙之机，佛祖莫知。","疾则蹉过，迟非所宜。","灵在自己，妙在日用。","吃饭著衣，一静一动。","动静两忘，波停岳耸。"],0,64,"宋"],["神功盛德诗  其二三","华镇","四言",["既发我明，既达我聪。","合变体经，神化无穷。","长毓儒雅，蓄砺兵戎。","无思不服，物有其容。","夙夜不怠，济我丰功。"],0,"x106","宋"],["偈四首 其二","释法秀","四言",["秋云秋水，看山满目。","这里明得，千足万足。"],0,145,"宋"],["当断吟","邵雍","四言",["断以决疑，疑不可缓。","当断不断，反受其乱。"],0,"x57","宋"],["赠武夷旅人","徐积","四言",["武夷旅人，而有气节。","不肯琐琐，亦不屑屑。","持此守身，归慰其亲。","既慰其亲，亦告乡人。"],0,"x123","宋"],["文宣王及其弟子赞 其七十","赵构","四言",["温温子里，入闻至圣。","揽道之华，秉德之柄。","深造阃域，不乖言行。","全齐之封，竹素为盛。"],0,249,"宋"],["穷达吟","邵雍","四言",["穷不能卷，达不能舒。","谓之知道，不亦难乎。"],0,"x57","宋"],["临终偈","释祖先","四言",["末后一句，已成忉怛。","写出人前，千错万错。"],0,54,"宋"],["和陶停云四首，并引 其一","苏轼","四言",["停云在空，黯其将雨。","嗟我怀人，道修且阻。","眷此区区，俯仰再抚。","良辰过鸟，逝不我伫。"],0,"x67","宋"],["诧嗟吟","邵雍","四言",["昨日炙手，今日张罗。","人间常事，何诧何嗟。"],0,"x57","宋"],["盘居六章  其六","项安世","四言",["行止盘盘，其乐孔多。","请以是居，子如之何。"],0,"x55","宋"],["无妄吟","邵雍","四言",["耳无妄听，目无妄顾，口无妄言，心无妄虑。","四者不妄，圣贤之具。","予何人哉，敢不希慕。"],0,"x57","宋"],["偈颂十三首 其一","释智愚","四言",["不劳弹指，岂涉思惟。","现成门户，到者方知。"],0,"x153","宋"],["示寂偈","释真如","四言",["昨夜三更，风雷忽作。","云散长空，前溪月落。"],0,168,"宋"],["所居三章二章章八句一章章十句  其三","洪皓","四言",["人亦有言，祸福无门。","忠孝弗著，淫侈实繁。","天其罚我，我又奚怨。","傥谨言行，或反邱园。","作为此诗，以告同阍。"],0,68,"宋"],["偈颂一百零二首 其五","释绍昙","四言",["山舍春深，生涯日贫。","桃花烂熳，不见灵云。"],0,"x108","宋"],["义利吟","邵雍","四言",["意不若义，义不若利。","利之使人，能忘生死。","利不若义，义不若意。","意之使人，能动天地。"],0,"x57","宋"],["义利吟","邵雍","四言",["贲于丘园，束帛戋戋。","义既在前，利在其间。","舍尔灵龟，观我朵颐。","义既失之，利何能为。","尚义必让，君子道长。","尚利必争，小人道行。"],0,"x57","宋"],["圭首座求赞","释清远","四言",["如圭如璋，惟子非我。","且陋且拙，在余是可。","子今传余，拙则成奇。","物感神会，形动心随。","凝云不飞，寒月下映。","孰谓之凡，孰谓之圣。","余犹尔也，奇拙同贯。","嘻嘻期文，大朴未散。"],0,116,"宋"],["宋江三十六赞 其三十六 扑天雕李应","龚开","四言",["鸷禽雄长，惟雕最狡。","毋扑天飞，封狐在草。"],0,103,"宋"],["和君时十章章四句  其六","彭汝砺","四言",["尔旋尔车，不知其期。","我陟其冈，祇益我思。"],0,"x143","宋"],["三月十三日夜五更闻杜鹃时成父欲入浙因赋六章章四句以送之  其一","赵蕃","四言",["不如归去，苍山茂树。","独胡为乎，空此号謼。"],0,"x36","宋"],["送赵守","徐积","四言",["齐有高密，有沂有沐。","旁有泰山，莒鲁郊关。","粤有人焉，气清神耸。","立节以高，处义而重。","维节维义，肇自布衣。","根本渊源，所养可知。","以义为文，洪畅精微。","以义持守，隐如坚城。","以义作为，动如精兵。","面有正色，口无谀声。","赤心可割，肝胆可倾。","以义接物，不矜不骄。","以义临民，实庇汝曹。","实康实济，实恺实悌。","民实宜之，实受其惠。","方今天下，虽曰治安。","正在所恤，民有饥寒。","公所往居，岂肯草草。","戒吏侵渔，欲民温饱。","言者为准，行者为表。","维恕维平，除烦去扰。","狼摧其牙，虎缩其爪。","父子室家，足以相保。","作此诗者，岂徒然乎。","庶使其民，传告欢呼。"],0,"x123","宋"],["和陶停云四首，并引 其三","苏轼","四言",["凛然清臞，落其骄荣。","馈奠化之，廓兮忘情。","万里迟子，晨兴宵征。","远虎在侧，以宁先生。"],0,"x67","宋"],["拈古十四首 其六","释法薰","四言",["来风可辨，驷马难追。","若无后语，讨甚大悲。"],0,31,"宋"],["雨师雷神七首 其七 送神。曲同迎神。","郊庙朝会歌辞","四言",["阴旄载旋，鼓车其鞭。","问神安归，冥然而天。","皇有正命，祀事孔蠲。","其临其归，亿万斯年。"],0,"x207","宋"],["寄君时六章章四句  其二","彭汝砺","四言",["我处于中，而舍其偏。","我弃其零，而取其全。"],0,"x143","宋"],["和君时十章章四句  其五","彭汝砺","四言",["吾斯未信，吾颜之厚。","重轻惟法，于尔何有。"],0,"x143","宋"],["金丹大药诀","白玉蟾","四言",["离府龙飞，坎宫虎跃。","金木混融，水火击搏。","刑德主宝，浮沉清浊。","一百日胎，二八两药。","白雪虚无，黄芽圆觉。","乌兔夫妻，龟蛇根萼。","朱砂不动，水银无著。","铅鼎纯干，紫霄云约。"],0,"x77","宋"],["和陶命子韵示津调官 其二","吴芾","四言",["又岂不知，道否晚周。","天纵将圣，独有孔丘。","卒老于行，靡惮周流。","胡为洁己，耻事王侯。"],0,"x95","宋"],["偈颂一百二十三首 其十一","释祖钦","四言",["黄面老子，六载辛勤。","寻得鼻孔，打失眼睛。"],0,64,"宋"],["送直禅人","释宗杲","四言",["直出直入，直行直坐。","直禅上人，直须恁么。","本自圆成，不立功课。","饥来吃饭，寒来向火。","不在瞿昙，非干达磨。","拟心思量，返遭殃祸。","我说是言，已招口过。","明眼人前，一场话堕。","请事斯语，无忘骨剉。"],0,"x112","宋"],["和陶劝农六首，并引 其六","苏轼","四言",["逸谚戏侮，博弈顽鄙。","投之生黎，俾勿冠履。","霜降稻实，千箱一轨。","大作尔社，一醉醇美。"],0,"x67","宋"],["碧泉兴作即事有感因续魏武之诗","胡宏","四言",["对酒当歌，人生几何。","往者如江，来者如何。","往来无尽，弗移弗那。","奉身理物，何少何多。","天长地久，我生靡它。","乐此泉兮，于山之阿。"],0,58,"宋"],["白云端和尚赞","释清远","四言",["纲纪著明，不忘付授。","净空无际，如日处昼。","欲究根源，瞻之龙岫。"],0,116,"宋"],["丁宁吟","邵雍","四言",["人无忽略，事贵丁宁。","忽略近薄，丁宁近诚。"],0,"x57","宋"]]