[["渔歌子 锦湖四时渔歌四首 其二","王士禄","词",["系缆青邱万柳东。","荷花面面午时风。","悬箬笠，枕笼?。","卧待宵凉理钓瞳。"],0,147,"清"],["渔歌子 锦湖四时渔歌四首 其三","王士禄","词",["细雨浽溦湿绿蓑。","白苹香里断鸿过。","持蟹饮，扣舷歌。","向夕渔灯炙紫螺。"],0,147,"清"],["渔歌子 锦湖四时渔歌四首 其四","王士禄","词",["认簖敲冰下短叉。","北风猎猎背蓬遮。","炊荻叶，蔽芦花。","拥妇呼雏醉晚舣。"],0,147,"清"],["调笑令 春闺二首 其一","王士禄","词",["花树。","花树。","幂历一窗红雾。","月明寥落金樽。","锦瑟年华断魂。","魂断。","魂断。","厌煞春宵银汉。"],0,147,"清"],["调笑令 春闺二首 其二","王士禄","词",["金雁。","金雁。","历历斜行筝面。","红弦素手萦愁。","迟日凝妆上楼。","楼上。","楼上。","南浦渌波晴漾。"],0,147,"清"],["如梦令 其一 白沙江上送贻上之金陵","王士禄","词",["沙尾孤舟潮拥。","手底离觞酒重。","忽忽恼云帆，不似青骢堪控。","如梦。","如梦。","昨夜短篷相共。"],0,147,"清"],["如梦令 其二 欲别","王士禄","词",["欲别玉人归去。","细雨廉纤薄暮。","红烛静愔愔，好共绿窗幽语。","且住。","且住。","衾润紫沉浓炷。"],0,147,"清"],["如梦令 初夏二首 其三","王士禄","词",["正是夏头春尾。","芍药酡颜红靡。","向晚琐窗风，怅绝玉人孤倚。","还喜。","还喜。","梦里灯花几蕊。"],0,147,"清"],["如梦令 初夏二首 其四","王士禄","词",["风捻杨丝碧老。","雨簸荷钱青小。","何日草堂边，卧听一林黄鸟。","堪懊。","堪懊。","误被软红相嬲。"],0,147,"清"],["如梦令 其五 忆柳庵山寺","王士禄","词",["忆住柳庵山寺。","幽兴随心无次。","支枕敞晴窗，卧选万山紫翠。","清吹。","清吹。","我爱涧松妩媚。"],0,147,"清"],["天仙子 本意","王士禄","词",["拨棹春溪深几曲。","桃花红蘸清波绿。","渔郎怪事忆人间，归去迟。","闭仙谷。","俯仰青山身碌碌。"],0,147,"清"],["江城子 闲庭","王士禄","词",["秋千摇影月微明。","到闲庭。","绝人声。","一点红灯，依约绿窗楞。","敲遍阑干佯不应，拨兰烬，倦盈盈。"],0,147,"清"],["长相思 本意","王士禄","词",["风半廊。","月半廊。","凤胫灯青玉簟黄。","别时秋乍凉。","苹已霜。","蓼已霜。","碣石潇湘尚渺茫。","关河较梦长。"],0,147,"清"],["相见欢 赠季弟","王士禄","词",["若为歌管销愁。","荡离忧。","忆逐残秋，征雁问扬州。","意中漫，怜东阁，少淹留。","谁识到来，翻送秣陵舟。"],0,147,"清"],["河满子 效何凝体二首 其一","王士禄","词",["最是春风情绪，无聊无赖无端。","枕瑟孤眠思好梦，被池虚绣双鸾。","争似蕊黄花子，朝朝贴向眉弯。"],0,147,"清"],["河满子 效何凝体二首 其二","王士禄","词",["仿佛玉人情态，桃花浅醉春风。","咫尺女床仙树远，漫云宋玉墙东。","争似猩红宝袜，朝朝约向酥胸。"],0,147,"清"],["调笑令 其一 成公智琼","王士禄","词",["相见。","鱼山畔。","五载精诚重会面。","云𫐌霞靷神仙伴。","心感多情弦掾。","同车还许同心绾。","洛水春波婉娈。"],0,147,"清"],["调笑令 其二 天台二女","王士禄","词",["仙侣。","溪边女。","笑倚桃花相向语。","绛帏双结同心苣。","婉态幽欢难举。","鸟啼乡思茫无主。","轻别玉娥归去。"],0,147,"清"],["调笑令 其三 洛神","王士禄","词",["难赋。","凌波步。","心寄君王魂定赴。","遗情想像悲灵遇。","斜日蘅皋空暮。","独携遗枕循归路。","愁逐洛川东注。"],0,147,"清"],["调笑令 其四 杜兰香","王士禄","词",["相迟。","真灵配。","侍女重来遥寄意。","玉盂曾作登真记。","更付黄麟仙帔。","墉城归去心期遂。","云路双翔翡翠。"],0,147,"清"],["调笑令 其五 织女","王士禄","词",["霄汉。","情难断。","抚抱临歧空恋恋。","紫房遥寄青缣怨。","别后灵期汗漫。","枕香衣泪留相伴。","寂寂玉颜难见。"],0,147,"清"],["调笑令 其六 玉卮娘子","王士禄","词",["回首。","辞箕帚。","殊绝苕颜惊阿母。","玉卮难复为君妇。","逻谷旧缘空有。","遗君玉合君怜取。","肠断仙都别后。"],0,147,"清"],["调笑令 其七 云英","王士禄","词",["何夕。","蓝桥驿。","百日为期难自惜。","心坚玉臼终须得。","共践玉峰仙宅。","裴郎阿姊还相识。","湘汉新诗重绎。"],0,147,"清"],["醉太平 邮夜","王士禄","词",["星前角声。","风前笛声。","恼人日夕逢迎。","问王程几程。","别边酒醒。","归边梦醒。","忧来如月明明。","问秋更几更。"],0,147,"清"],["生查子 其一 艳情","王士禄","词",["窗晓露微明，未醒双文睡。","辗转玩琼颜，爱煞斜鬟腻。","睡浅为郎羞，拥损重楼被。","后夜却防郎，只枕郎君臂。"],0,147,"清"],["生查子 其二 别怨","王士禄","词",["紫栈已停熏，银蜡仍销焰。","共影守残更，相惜还相厌。","蕉萃此时心，郎定无由见。","独有夜啼乌，仿佛闻微叹。"],0,147,"清"],["生查子 其三 次女郎紫竹韵","王士禄","词",["阶怜好月痴，窗厌孤灯惨。","无味夜来风，空逗帘犀飐。","莫检枕函书，旧泪痕痕黮。","都得几丝愁，萦损春山点。"],0,147,"清"],["酒泉子 小院","王士禄","词",["细雨愔愔。","寂历红薇小院。","殷轻雷，却纨扇。","绿屏深。","涎涎紫燕亸双尾。","无语梁畔睡。","簟痕孤，香气靡。","暮寒侵。"],0,147,"清"],["醉公子 其一 街鼓","王士禄","词",["街鼓传三四。","不见萧郎至。","何物对裴回。","玉香独见鞋。","锦衾空艳艳。","沉水薰来厌。","休自听更筹。","鸦啼金井头。"],0,147,"清"],["醉公子 其二 次顾夐韵","王士禄","词",["梳里朝来淡。","羞对移春槛。","斜倚绿牙屏。","梨花小院扃。","独坐流光慢。","迟日窥门限。","蓬鬓乱双蝉。","心慵又一年。"],0,147,"清"],["昭君怨 楼外","王士禄","词",["楼外夕阳牢落。","倚损危栏一角。","何处见天涯。","碧山遮。","那似合欢双枕。","解使潇湘路近。","回梦惜馀欢。","觑屏山。"],0,147,"清"],["春光好 秋千","王士禄","词",["红索软，锦旗平。","蝶裙轻。","一倍春光照眼明。","𣨼初莺。","人是如云如月，天看非雨非晴。","仿佛似闻花影里，坠钗声。"],0,147,"清"],["点绛唇 其一 闺情","王士禄","词",["雨嬲空庭，梦回失却桐庐路。","春愁相赴。","又是红窗暮。","卜损金钗，怕见芳园树。","微寒度。","水沉销炷。","且伴春风住。"],0,147,"清"],["点绛唇 其二 梦馀","王士禄","词",["蹴踏闲愁，先生被却拘墟也。","梦馀醒暇。","叉手槐凉下。","树畔驴儿，有似邯郸野。","归去者。","炊成潇洒。","莫道黄梁哑。"],0,147,"清"],["诉衷情 次魏承班韵","王士禄","词",["蹙惯双蛾翠损长。","犀帘静暮堂。","新梦断，乱蝉凉。","慵续午馀香。","宛转簟纹光。","似回肠。","清宵好更梦横塘。","学鸳鸯。"],0,147,"清"],["浣溪沙 夏闺二首 其一","王士禄","词",["琼砌阴浓暑渐收。","梦回楼角夕阳幽。","晚花香里上帘钩。","绿堕鸦鬟金雀隐，红斜宝袜玉肤柔。","风边小立只低头。"],0,147,"清"],["浣溪沙 夏闺二首 其二","王士禄","词",["茉莉风凉沁洞房。","琐窗斜月坠清光。","玉人枕畔卸衣裳。","细语低迷防婢觉，幽情宛约恼郎狂。","暗中无奈绣鞋香。"],0,147,"清"],["浣溪沙 其三 次少游韵","王士禄","词",["半下流苏罥绿霞。","缓歌捉搦按红牙。","春风先到泰娘家。","选梦正宜衾鸭暖，昵人偏是鬓蝉斜。","莫将销恨属名花。"],0,147,"清"],["浣溪沙 其四 别来","王士禄","词",["锦水文鸳宿处同。","别来魂梦镇惺忪。","分携记在绿屏东。","执手凄凄还脉脉，回头昵昵苦匆匆。","横波低揾一双红。"],0,147,"清"],["浣溪沙 春闺三首 其五","王士禄","词",["妩媚风光二月过。","轻衫不爱绣银鹅。","蜻蜓浅碧缬文罗。","小倦非缘思梦睡，柔情却似为春酡。","红襟燕子又来么。"],0,147,"清"],["浣溪沙 春闺三首 其六","王士禄","词",["风乱湘桃午倦时。","双鬟好为掩罘罳。","怕来春梦似游丝。","种得碧兰怜露蕊，写成朱竹惜歌枝。","为他情态也差差。"],0,147,"清"],["浣溪沙 春闺三首 其七","王士禄","词",["情思恹恹厌袜罗。","起来红日玉台多。","关心残梦怎腾那。","瘦损腰围如弱柳，梳成髻子是翻荷。","当窗自惜态娥娥。"],0,147,"清"],["浣溪沙 艳情二首 其八","王士禄","词",["笑倚秦筝理钿蝉。","午窗兰气绝清妍。","昵人脉脉亸香肩。","秾李风情谁得似，破瓜年纪最堪怜。","黑犀合子赠缠绵。"],0,147,"清"],["浣溪沙 艳情二首 其九","王士禄","词",["柳叶眉长惯似愁。","当欢微敛越风流。","双文小玉总仙俦。","梦浅羞郎还闭目，慵多唤婢代梳头。","此乡真个是温柔。"],0,147,"清"],["清商怨 和欧公韵","王士禄","词",["银床梧叶落渐满。","怅流光欲晚。","平楚高楼，连朝劳望眼。","画屏潇湘漫展。","恨梦破、雁和人远。","心上秋来，问秋秋不管。"],0,147,"清"],["菩萨蛮 其一 露筋祠","王士禄","词",["船头暮笛吹寒浪。","苹黄芦折怜遥望。","野岸出空祠。","灵期飏晚飔。","无郎歌莫误。","不是青溪路。","夜夜对重湖。","魂归片月孤。"],0,147,"清"],["菩萨蛮 其二 梦破","王士禄","词",["邯郸梦破抽身急。","掉头怕近长安日。","便跨白驴归。","重寻旧钓矶。","是非书几卷。","失学从儿懒。","带索好行歌。","无劳春梦婆。"],0,147,"清"],["菩萨蛮 闺晓二首 其三","王士禄","词",["春魂带梦扶难起。","玉欹翠弱妆慵理。","不用郁金油。","鬟云腻欲流。","一双罗袜瘦。","小凤娇红咮。","著罢立盈盈。","兰阶无限情。"],0,147,"清"],["菩萨蛮 闺晓二首 其四","王士禄","词",["玉阶浥露缃钩小。","拗来豆蔻含清晓。","何处惜芳菲。","春光绣蝶衣。","却归妆镜畔。","伫立成微叹。","还理乱衾窝。","怜他伴梦多。"],0,147,"清"],["菩萨蛮 其五 有寄","王士禄","词",["抛侬几尺烟波路。","断桥难断魂来去。","何处望全迷。","西陵更向西。","欲知情郑重。","验取宵来梦。","可耐不成眠。","乌啼又曙天。"],0,147,"清"],["诉衷情 曾记","王士禄","词",["白云不恋恋温柔。","曾记卧红楼。","玉奴笑回莲脸，亲为试箜篌。","云影散，雨香收。","漫凝眸。","几棂淡月，半臂浓香，一寸眉头。"],0,147,"清"],["卜算子 其一 不寐","王士禄","词",["暗烛影疑冰，饥鼠声如雀。","窗隙寒风和漏来，梦又成耽阁。","归计尚蹉跎，春事全萧索。","此际殷勤觅睡方，欲下真无药。"],0,147,"清"],["卜算子 其二 送春","王士禄","词",["春欲赋归欤。","饯汝青门路。","咄汝能偕愁共来，好拉愁同去。","春谓君良误。","愁与君何杵。","此日幽拘除却愁，谁与君同住。"],0,147,"清"],["采桑子 其一 有赠","王士禄","词",["宜人最是横波慢，睡态融融。","红烛微蒙。","杜牧清狂也到侬。","愁君姓字偏难忘，耳畔东东。","他日车中。","怅绝轮边断续风。"],0,147,"清"],["采桑子 其二 春闺","王士禄","词",["流苏不闭三春梦，宛转梨云。","一霎氤氲。","洛水湘波在宋邻。","醒来无事消长昼，卧损秾春。","莫问芳辰。","春絮春花惯恼人。"],0,147,"清"],["减字木兰花 其一 羁所七忆","王士禄","词",["竹西清署。","昨岁称觞曾暂去。","慈母缝衣。","又逐寒枫草草归。","湘累新愁。","二老遥闻魂应断。","念此如何。","梦溯清淮夜夜波。"],0,147,"清"],["减字木兰花 其二 羁所七忆","王士禄","词",["早年似陆。","夜夜书灯还接屋。","中岁如苏。","雨驿梧声怨索居。","只期暮齿。","下泽同驱吾共尔。","谁意而今。","洒泪题诗寄卯君。"],0,147,"清"],["减字木兰花 其三 羁所七忆","王士禄","词",["谢家小女。","少日红闺深处贮。","嫁与黔娄。","画匠金钗廿载愁。","甘同终窭。","未忘牛衣中夜语。","只为梭巡。","偕隐心惭举案人。"],0,147,"清"],["减字木兰花 其四 羁所七忆","王士禄","词",["桃花𫖃雪。","掌里双珠光似月。","几载身傍。","次第鸠车看绕床。","堪怜弱岁。","𫗴橐崎岖为汝累。","莫事诗书。","殷鉴于今近在余。"],0,147,"清"],["减字木兰花 其五 羁所七忆","王士禄","词",["谁云弄瓦。","绣褓相怜无异者。","弱女非男。","也与陶公慰醉颜。","还思卖犬。","笥屐他年亲嫁遣。","此意悠悠。","面壁娇啼我欲愁。"],0,147,"清"],["减字木兰花 其六 羁所七忆","王士禄","词",["紫囊曾赌。","早日阶兰欣在睹。","昨岁于菟。","乍见牵衣更捋须。","经时离别。","频梦芜城耏水月。","羯末封胡。","此日幽忧倍忆渠。"],0,147,"清"],["减字木兰花 其七 羁所七忆","王士禄","词",["单车宵引。","铁网珊瑚思采尽。","深院梧桐。","红烛三条见至公。","玉壶秋月。","人道欧公清鉴别。","我罪伊何。","默默凭谁讯汨罗。"],0,147,"清"],["减字木兰花 其八 寄内","王士禄","词",["还知别后。","人工炉烟宛转瘦。","灯底风前。","憔悴苕华只自怜。","凭谁寄语。","莫为藁砧徒自苦。","有日归兮。","携手同君赋五噫。"],0,147,"清"],["后庭花 咏燕","王士禄","词",["浥尘小雨清明近。","几番花信。","重来玉剪双双趁。","玳梁堪认。","故巢新补芹泥润。","落红相衬。","流黄机畔人回瞬。","陡添娇晕。"],0,147,"清"],["好事近 忆柳庵旧隐，次放翁韵","王士禄","词",["回首碧山栖，四面远天为壁。","窗启俯临层𪩘，看偃松苍积。","花关长昼不曾开，猿鸟共休息。","卓午聒回幽梦，是衙蜂喧日。"],0,147,"清"],["谒金门 和冯延巳韵","王士禄","词",["晨睡起。","倦眼微𥆧秋水。","且散娇慵春径里。","露桃开几蕊。","亸态风前如倚。","扑乱杨花斜坠。","正忆桐庐人未至。","蛛丝轻送喜。"],0,147,"清"],["谒金门 和尤悔庵寒夜韵","王士禄","词",["深宵寂。","暗烛晕成愁色。","小婢开帘寒侧侧。","梅花明夜黑。","雪片风边瑟瑟。","带个雁声凄历。","孤枕愁听莲漏滴。","枕痕朝看湿。"],0,147,"清"],["金蕉叶 咏雁，用蒋竹山秋夜不寐韵。","王士禄","词",["晴空淡幕。","远飞来、互鸣似索。","鱼鳞云影断续，斜河正络角。","几个疏星作作。","井梧飘、酒怀乍恶。","楚天秋水浩渺，寒沙几处落。"],0,147,"清"],["忆秦娥 次少游韵","王士禄","词",["秋眉碧。","月明几夜流黄织。","流黄织。","谁家阑角，乍飘风笛。","锦机羞镊鹣鹣翼。","远书漫说长相忆。","长相忆。","玉笼愁绝，相思声只。"],0,147,"清"],["眼儿媚 和徐野君赠人韵","王士禄","词",["个侬名字似东东。","记曲又红红。","眉月幽幽，鬟烟约约，肤雪蒙蒙。","缥缈风情看不定，几处认巫峰。","帘底樽前，花边竹外，掌上图中。"],0,147,"清"],["惜分飞 其一 湖上有赠","王士禄","词",["泪眼非如潮有信。","话到离愁便晕。","此际看尤俊。","横波那为多啼损。","家住西泠还较近。","苏小同心试问。","莫忘相思分。","却教油壁全无准。"],0,147,"清"],["惜分飞 有寄二首 其二","王士禄","词",["共子真同魂与魄。","不道轻轻便坼。","无奈离魂急。","独留残魄谁相匹。","检点屏帷寻旧迹。","印臂钗痕未失。","立尽窗儿黑。","愁来那辨阡和陌。"],0,147,"清"],["惜分飞 有寄二首 其三","王士禄","词",["忆得相逢春欲暮。","油壁西陵乍度。","缥缈花和雾。","风流欲压陈王赋。","卖眼灯前回一顾。","脉脉幽情早付。","好月当窗处。","背人却把心期诉。"],0,147,"清"],["南歌子 其一 鸦鬟","王士禄","词",["箫局晨香袅，流苏晓梦还。","十三小女绿鸦鬟。","情似十三明月，未全圆。","花影红屏午，春光碧户传。","抱来雁柱十三弦。","已觉一弦一柱，思华年。"],0,147,"清"],["南歌子 其二 次湘真春月韵","王士禄","词",["琼树蒙蒙映，红窗漫漫流。","雪儿好为唱无愁。","休负一规亲切，照藏钩。","珠露从教湿，金樽莫遣收。","余光潋滟小眉头。","不似清秋楚楚，咽箫楼。"],0,147,"清"],["浪淘沙 其一 次李后主韵","王士禄","词",["愁似水潺潺。","百意阑珊。","几棂风做晚来寒。","倩酒浇愁愁不顾，醉也无欢。","岸帻倚疏栏。","愧负青山。","试歌行路古来难。","何似随僧闲洗钵，溪畔松间。"],0,147,"清"],["浪淘沙 其二 次宋尚木忆昔韵","王士禄","词",["绣幕晚来重。","怪底香浓。","丁香如梦月胧胧。","红烛𣨼人耽笑语，过了疏钟。","倦眼玩酥胸。","脂肉芙蓉。","娇羞银蒜罥青虫。","往事临风休更忆，吹乱心蓬。"],0,147,"清"],["南乡子 其一 初夏忆草堂，次曹顾庵初夏韵","王士禄","词",["游屐息春忙。","著雨幽墀似曲塘。","砌外三桐层碧引，过墙。","接叶愔愔覆草堂。","摇日夕窗凉。","破梦棋声静曲房。","入夜流萤依竹见，还藏。","簟展方流玉水长。"],0,147,"清"],["南乡子 其二 午日","王士禄","词",["愁剧意模糊。","粽子还能益智无。","且碾朱砂浮药玉，胡卢。","图得闲愁半日逋。","醉里惜幽拘。","吟罢怀沙日又徂。","记得弇州诗句好，非诬。","信有人间屈左徒。"],0,147,"清"],["木兰花令 其一 茫茫","王士禄","词",["茫茫交集情谁织。","谓驱愁去愁仍蛰。","放来屈赋就怀沙，腐后迁书传货殖。","诗书赢得妻孥泣。","孺仲妻贤真莫及。","蓬头历齿任痴儿，有目何烦知六七。"],0,147,"清"],["木兰花令 其二 遣愁","王士禄","词",["三春日日和愁住。","愁汝来前与汝语。","连朝愧汝太殷勤，我醉欲眠君且去。","麾之不去愁良误。","心已厌君君好喻。","不然便觅一丸泥，封却汝愁来往路。"],0,147,"清"],["鹊桥仙 醉罢","王士禄","词",["只须冷笑，无烦细说，世事尽多鹘突。","楚囚莫更泣南冠，教达者、嗤人录录。","且酣醇酒，试弹长剑，醉罢一歌独漉。","庄生齐物有遗篇，说千古、觞延彭促。"],0,147,"清"],["踏莎行 用少游韵","王士禄","词",["瑞脑烘猊，素筝排雁。","绿窗深处新妆淡。","娇春偏觉眼波慵，宜人更是心情慢。","佩响微风，琴鸣幽涧。","还疑天女将花散。","春光秾日惜分携，碧城缥缈愁无限。"],0,147,"清"],["临江仙 忆东堂花树","王士禄","词",["最惜东堂花树好，几枝掩雪骄霞。","春宵胜引酒情赊。","共倾银凿落，细玩玉夭斜。","群季惠连真不让，新诗同竞妍华。","十年踪迹似风花。","赤栏楼角月，应解忆天涯。"],0,147,"清"],["蝶恋花 其一 次韵少游二乔观书图","王士禄","词",["倾鬓颓云肩亸玉。","髹几光凝，双映修蛾绿。","仿佛风光屏外足。","摊书停却寻春躅。","炉里双烟青断续。","玉砌红帘，不似牵萝屋。","公瑾伯符皆不俗。","知无一事萦心曲。"],0,147,"清"],["蝶恋花 其二 和汉川卢令女题泥溪驿韵","王士禄","词",["翠幰红帘晴少翳。","花驿风香，渐觉秾春至。","漫道鹃声堪坠泪。","木棉红照人颜腻。","江路盘回山路细。","谢女吟成，旅思清如水。","彤管自怜多画意。","幽修分得浮岚翠。"],0,147,"清"],["蝶恋花 其三 咏萤","王士禄","词",["雨后桐阴清似沐。","苔色盈阶，淡月明于玉。","此际流萤飞簌簌。","穿廊黏砌纷空曲。","才堕花梢还入竹。","欲下仍高，偏旁池边屋。","巧入风帘轻扑扑。","幽光凉映须眉绿。"],0,147,"清"],["渔家傲 其一 赵北口作","王士禄","词",["渔屋低低茅作瓦。","几湾碧柳真潇洒。","此地风尘原不惹。","渔父者。","于中结个持竿社。","乐事常年殊未寡。","扁舟不系随波写。","濯足舷边刚没髁。","言不假。","垂鞭笑煞先生马。"],0,147,"清"],["渔家傲 其二 用王介甫韵","王士禄","词",["湖岸渔村周似抱。","家家门径开芳草。","向背渔罾殊窈窕。","凌晓到。","晴矶已有垂杨扫。","坐看点头行水鸟。","近家何用收纶早。","两桨一舟堪送老。","波面好。","宽闲不与欧争道。"],0,147,"清"],["金蕉叶 昔游","王士禄","词",["昔游记向西陵去。","回油壁、个人曾遇。","一笑灯前，春心暗掷幽情注。","顿使情愁如滤。","柳枝带结同心屡。","尚惆怅、乌啼窗曙。","可堪别后，云中无复来香雨。","忍看玉炉双炷。"],0,147,"清"],["解佩令 酒怀","王士禄","词",["淡妆轻裹。","柳慵花堕。","畅幽情、鸱夷仙舸。","茉莉风凉，泊向段家桥左。","悄窥人、月痕星颗。","别来无那。","魂销梦伙。","寄离愁、雁儿难逻。","烛烬宵深，独有单衾同我。","问何时、酒怀能妥。"],0,147,"清"],["品令 寓亭竹","王士禄","词",["砌外一林竹。","爱萧散、供幽独。","闲窗拂戛，昼长卧听，音和笙筑。","雨重风轻，姿韵看来难足。","露晞烟晓，受初日、开寒绿。","夜深还又，月浮乱碧，宛然空谷。","那得湖州，图取变态千幅。"],0,147,"清"],["淡黄柳 新柳","王士禄","词",["阳春三月。","袅袅东风急。","陌上桥头吹不息。","渲得短丝成碧。","看嬉春黄鹂恰恰。","怜娇色。","晓日红楼辟。","似有个、盈盈立。","敛修蛾、且罢流黄织。","灞岸条垂，玉关梦杳，袖向晴光暗湿。"],0,147,"清"],["行香子 别恨","王士禄","词",["别恨曾谙，往事重拈。","记临歧、暮色红帘。","牵衣回抱，细语喃喃。","见眉痕重，泪痕滴，酒痕咸。","峡云归后，雨来空识，只宵阑、梦断魂黏。","孤眠无赖，回忆何堪。","是炉香歇，发香腻，被香甘。"],0,147,"清"],["锦缠道 用宋子京韵","王士禄","词",["落拓心情，寂寂难销长昼。","看罗巾、合欢双绣。","殷红知是啼痕透。","梦里蘅芜，往事空回首。","记楼头细语，暗萦纤手。","态盈盈、脸红宜酒。","怅萍踪雨落青天信，芳心一寸，恩怨应双有。"],0,147,"清"],["青玉案 用贺方回韵","王士禄","词",["清宵盼盼银河路。","只惆怅、华年去。","密约芳期经几度。","红弦翠管，风帘月簟，并与人何处。","别时夏杪春还暮。","燕燕莺莺漫成句。","旧事萦心还几许。","微酣曾访，短篷相遇，荷叶西陵雨。"],0,147,"清"],["两同心 和韵宗梅岑咏鸳鸯","王士禄","词",["沙畔文禽，双双锦羽。","依绿萍、妥梦芳洲，唼红杜、寻欢遥浦。","那还羡、紫燕交飞，青鸾偕舞。","冷觑绣床娇女。","抛残针镂。","散娇慵、水槛闲凭，照宛约、玉台空妩。","晚归去、凝视红衾，黯然无语。"],0,147,"清"],["天仙子 其一 和湘真春夜韵","王士禄","词",["淡淡双眉萦远岫。","草草凉襟还小袖。","曲廊深处为侬来，随夜漏。","乌栖后。","枕臂啼痕红欲透。","抚抱纤腰春更瘦。","凝怨横波娇不溜。","如思如懊转宜人，看巾绣。","嗔相扣。","痛惜肯教衾浪皱。"],0,147,"清"],["天仙子 其二 用张子野韵","王士禄","词",["河满不堪临别听。","别酒醉来容易醒。","持侬只问几时来，频揽镜。","怜光景。","此意料君能暗省。","离绪最愁窗色暝。","明月又还窥只影。","空房应是怯孤眠，风欲定。","钟初静。","踏遍合欢廊下径。"],0,147,"清"],["江城子 用少游韵","王士禄","词",["游春梦好𣨼元郎。","恼侬狂。","昵侬狂。","燕子莺儿，底事送春忙。","花露未晞云影散，痕在臂，泪沾裳。","锦屏仿佛剩春光。","枕馀香。","簟馀香。","髹几文奁，无复映晨妆。","小叠红笺书恨字，凭谁寄，向伊行。"],0,147,"清"]]