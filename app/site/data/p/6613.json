[["应天长","杨荣","词",["星驰一线，宝炬腾空，千花一时开遍。","万斛金莲，恍似红妆映波面。","香风转，云半卷。","见舞袖、翩翻轻旋。","想胜景、即是仙宫，蓬莱阆苑。","欢乐意留恋。","岁岁年年，长沐赐宴。","五色红云，瑞气祥氛互葱茜。","移銮辂，开雉扇。","仙仗拥、九华春殿。","向黼扆、更祝南山，寿觞频劝。"],0,"x390","明"],["醉蓬莱","杨荣","词",["近天阶咫尺，云拥千官，动摇环佩。","仙乐声高，似飘飖天外。","罗绮香秾，珠㙨光粲，看红妆千队。","银汉低徊，月临仙掌，星垂华盖。","睹此繁华，古今应最，禁苑中此，夕同欢会。","海上三山，与金茎相对。","宝马香车，九街驰逐，遍五城欣快。","圣寿齐天，年年岁岁，嵩呼罗拜。"],0,"x390","明"],["画堂春","杨荣","词",["春空云尽月华明。","雪消才放新晴。","元宵游赏遍都城。","处处欢声。","丹禁九重宫阙，彩鳌三岛蓬瀛。","万方玉帛会瑶京。","同乐升平。"],0,"x390","明"],["十六字令 闺雪","梁清标","词",["花六出，凝妆绣幕前。","春纤冷，懒整玉钗偏。"],0,"x400","清"],["望江南 蕉林","梁清标","词",["风习习，小院午阴稠。","鸦带斜阳清影乱，梦回疏簟碧烟浮。","疑坐晚山秋。"],0,"x400","清"],["望江南 其一","梁清标","词",["春昼永，烂漫赏花时。","风动紫英双蝶绕，香凝翠幄早莺知。","人立夕阳迟。"],0,"x400","清"],["望江南 其二","梁清标","词",["栅初引，清露缀枝斜。","黄鸟啼残窥画槛，玉蟾影转上窗纱。","偏称一阑花。"],0,"x400","清"],["望江南 其三","梁清标","词",["秋满阁，蹑屐望遥空。","赵苑烟花城阙柳，玉屏山色佛楼钟。","半在月明中。"],0,"x400","清"],["望江南 其四","梁清标","词",["朝卷幔，红日照前楹。","窗色弄晴来燕子，檐花飞片落棋枰。","竹里沸泉声。"],0,"x400","清"],["望江南 其五","梁清标","词",["云漠漠，怪石碧苔斑。","长揖颠来同海岳，解酲贵不数平泉。","秋入小湖山。"],0,"x400","清"],["望江南 其六","梁清标","词",["罗浮梦，寒夜醉春杯。","高士雪中疏影瘦，美人月下暗香来。","东阁几枝开。"],0,"x400","清"],["望江南 其七","梁清标","词",["斋似舫，窗外雨潇潇。","仿佛棹移湘水曲，溟蒙客渡洞庭潮。","一半在芭蕉。"],0,"x400","清"],["潇湘神 其一 春日","梁清标","词",["春水流。","春水流。","岭南雨气似深秋。","苦忆故园花事好，寒云片片夜猿愁。"],0,"x400","清"],["潇湘神 其二 春日","梁清标","词",["春草肥。","春草肥。","越王台畔布帆归。","何处酒旗堪醉客，晓莺声里一花飞。"],0,"x400","清"],["潇湘神 其三 春日","梁清标","词",["春日晴。","春日晴。","海天回首绿烟平。","箫鼓千船牵锦缆，几番花醉五羊城。"],0,"x400","清"],["潇湘神 其四 春日","梁清标","词",["春岫齐。","春岫齐。","素馨丛里鹧鸪迷。","游女踏歌花外去，双双罗袜蹴香泥。"],0,"x400","清"],["谢秋娘 舟中女","梁清标","词",["谁家女，十四正妑头。","临水窥窗分黛色，惊人却步褪莲勾。","怕惹燕莺愁。"],0,"x400","清"],["忆王孙 春雨","梁清标","词",["寒烟暝色乱清樽。","呖呖虚窗旅雁闻。","暮角声催断客魂。","一灯昏。","细雨孤城尽闭门。"],0,"x400","清"],["甘州子 夜坐","梁清标","词",["夜凉人静小庭空。","花影乱，碧阴重。","披襟消受晚槐风。","往事叹匆匆。","贪露坐，斜月转梧桐。"],0,"x400","清"],["如梦令 其一 秋夜","梁清标","词",["露下秋宵方永。","睡起残妆犹靓。","携手步虚檐，人面月华相映。","绝胜。","绝胜。","小立满身花影。"],0,"x400","清"],["如梦令 其二 题画扇","梁清标","词",["一夜西风轻剪。","小院幽花初绽。","芳沼立蜻蜓，掠水飞来庭畔。","闲盼。","闲盼。","秋到江南深浅。"],0,"x400","清"],["如梦令 其三 朝回","梁清标","词",["翡翠衾寒拖逗。","恼煞鸡声偏骤。","带得御香归，犹喜晓妆才就。","生受。","生受。","正是画眉时候。"],0,"x400","清"],["如梦令 其四 家弟送蝶至","梁清标","词",["蝴蝶东家交映。","捉送蕉林三径。","惊醒老庄周，来弄碧阴晴景。","偏胜。","偏胜。","点缀竹篱秋影。"],0,"x400","清"],["如梦令 其五 夜雨","梁清标","词",["清簟琅玕初展。","残角数声风断。","不寐检新诗，雨打芭蕉零乱。","人倦。","人倦。","一夕荷花缸满。"],0,"x400","清"],["如梦令 其六 女汲","梁清标","词",["屋角银涛千顷。","纤手携将修绠。","素足傍清流，溅湿凌波不整。","矶冷。","矶冷。","风动半江花影。"],0,"x400","清"],["归自谣 惜春","梁清标","词",["春梦诧。","零落乱红花卖罢。","游丝飞絮春归乍。","欲留无计眉慵画。","帘钩亚。","莺儿苦把东风骂。"],0,"x400","清"],["连理枝 闺情","梁清标","词",["暮霭生虚幌。","雪片飘如掌。","蝉鬓微松，水沉香冷，帘旌休敞。","望远游孤客。","蜡媒消尽，金钗坠响。"],0,"x400","清"],["生查子 其一 春闺","梁清标","词",["河梁别妾时，落叶纷庭榭。","春草已芊芊，不见嘶骢马。","鹦鹉未知愁，絮语将人骂。","小步怨东风，掩泪秋千下。"],0,"x400","清"],["生查子 其二 夏夜","梁清标","词",["兰汤浴罢时，箫局沉烟缕。","偷取远山青，描作眉儿谱。","茉莉几枝开，小摘还频数。","香汗等闲消，一阵黄昏雨。"],0,"x400","清"],["春光好 旅况","梁清标","词",["茶铛沸，篆烟收。","伴春愁。","天气宜晴宜雨，弄轻柔。","子野闻歌添恨，仲宣漫赋登楼。","怅望所思人不见，水空流。"],0,"x400","清"],["点绛唇 其一 偶赠","梁清标","词",["歌按凉州，灯前喜识春风面。","傍谁庭院。","碧玉闺中怨。","淡服新妆，无语频凝盼。","思量遍。","幽情一线。","付与闲花片。"],0,"x400","清"],["点绛唇 其二 初秋","梁清标","词",["急雨空阶，西风乍入帘栊晓。","秋葵开了。","掩映疏篱小。","梦醒黄梁，万斛愁如扫。","长安道。","驱驰人老。","都付闲花草。"],0,"x400","清"],["点绛唇 其三 闺情","梁清标","词",["帘阁春温，匆匆待漏缘何事。","香馀翠被。","不惯孤眠味。","坐数残更，窗外风儿细。","鸦声碎。","寒侵半臂。","悔嫁金闺婿。"],0,"x400","清"],["点绛唇 其四 春霁","梁清标","词",["昨夜冥冥，开窗霁色帘栊晓。","海棠绽了。","过雨红偏好。","横笛高楼，几许人嚬笑。","莺声老。","落英多少。","何处寻芳草。"],0,"x400","清"],["点绛唇 其五 忆旧","梁清标","词",["帘押风柔，伤心往事斜阳里。","当年花底。","芍药栏同倚。","依旧芳菲，岁月看流水。","春残矣。","乱红如绮。","草绿人千里。"],0,"x400","清"],["点绛唇 其六 闺情","梁清标","词",["春困恹恹，斜风细雨寒吹阁。","银屏珠箔。","苦把花枝缚。","虚倚薰笼，旧事思量著。","情差错。","海棠零落。","对下秋千索。"],0,"x400","清"],["点绛唇 其七 悼亡","梁清标","词",["玉冷秦台，凤箫响绝闲萧史。","芙蓉落矣。","璧月怜秋水。","谁与温存，小阁香肩倚。","孤眠里。","画笳声起。","偏到愁人耳。"],0,"x400","清"],["浣溪沙 其一 春闺","梁清标","词",["深院秋千绣带轻。","衣沾香汗玉钗横。","最怜节气近清明。","怕见落英春欲暮，倦开翠幌梦频惊。","碧桃花下戏调莺。"],0,"x400","清"],["浣溪沙 其二 春怀","梁清标","词",["郊外提壶籍草茵。","桃花春涨水粼粼。","暖风吹散隔溪云。","柳色暗催羁客泪，莺声愁煞画楼人。","两般心事总沾巾。"],0,"x400","清"],["菩萨蛮 其一 花间双蝶","梁清标","词",["人闲清昼抛书立。","绿阴深处蝉声急。","一树紫薇开。","翩翩引蝶来。","篱边相逐舞。","摹作滕王谱。","槐老入新秋。","西风蝶也愁。"],0,"x400","清"],["菩萨蛮 其二 悼亡","梁清标","词",["玳梁当日栖双燕。","碧桃花下看人面。","往事耐思量。","银灯照晚妆。","宝钿空瑟瑟。","愁煞西堂客。","肠断只三声。","长更与短更。"],0,"x400","清"],["菩萨蛮 其三 春闺","梁清标","词",["乱鸦啼处春风晓。","流苏香暖金钩小。","晴影入窗纱。","街头卖杏花。","鸳鸯初睡足。","偏堕云鬟绿。","拂镜试新妆。","低回问粉郎。"],0,"x400","清"],["菩萨蛮 其四 题画扇","梁清标","词",["板桥流水湖山靓。","桃花人面红相映。","唤婢采芳兰。","妆成小步看。","苔侵罗袜湿。","爱向春风立。","莫问落花香。","当年误阮郎。"],0,"x400","清"],["菩萨蛮 其五 春雨","梁清标","词",["家山漠漠思千缕。","杏花零落廉纤雨。","燕语恨春归。","河桥柳絮飞。","游骢何处驻。","野水棠梨路。","泥滑阻郊行。","芳堤误早莺。"],0,"x400","清"],["菩萨蛮 其六 暮春雨中十五弟归里","梁清标","词",["可怜九十春光尽。","南窗疏竹生新笋。","榆荚雨潇潇。","花寒夜寂寥。","河桥垂柳折。","柳絮飞如雪。","茅店闭黄昏。","孤灯何处村。"],0,"x400","清"],["菩萨蛮 其七 宿伏城驿","梁清标","词",["伏城明月浑如昔。","往来照尽长征客。","今日我重过。","其如孤影何。","遥看云外树。","总是来时路。","莫喜到家乡。","乡愁到更长。"],0,"x400","清"],["菩萨蛮 其八 旅怀","梁清标","词",["驿亭秋尽寒风起。","离人今夜思千里。","刻烛几踟蹰。","南来少雁书。","酒樽聊独对。","半是闺中泪。","且莫盼书来。","音书乱客怀。"],0,"x400","清"],["菩萨蛮 其九 大店驿","梁清标","词",["泥墙草屋鸡声咽。","二千里外看明月。","地已入江淮。","风沙何倍来。","乡愁人似醉。","强伴昏灯睡。","雁到怪无书。","连朝并雁无。"],0,"x400","清"],["菩萨蛮 其十 赠伎","梁清标","词",["斜风细雨清宵永。","徘徊忽见灯前影。","命薄每伤神。","偏怜薄命人。","轻罗回小扇。","省识如花面。","百媚坐来生。","无情若有情。"],0,"x400","清"],["菩萨蛮 其十一 立秋","梁清标","词",["高城月上阴云敛。","芙蕖远送清香满。","一叶井梧秋。","西风吹鬓愁。","笙箫华馆沸。","搅得蝉声碎。","乍觉晚凉多。","闻歌唤奈何。"],0,"x400","清"],["菩萨蛮 其十二 赠女伶","梁清标","词",["樽前若个歌金缕。","盈盈十五芳如许。","笑靥半含羞。","骄憨不解愁。","眉痕青尚浅。","秋水双眸剪。","何处耐人思。","歌停掩袖时。"],0,"x400","清"],["菩萨蛮 其十三 寒食","梁清标","词",["皇州一夕传宫烛。","五侯宅里烟凝绿。","何处最关愁。","佳人倚画楼。","水边萦醉客。","金犊驱油壁。","乡思黯黄昏。","梨花深闭门。"],0,"x400","清"],["菩萨蛮 其十四 春暮","梁清标","词",["散衙晴暖茅斋小。","落花寂寂鸣山鸟。","白昼放春闲。","那堪春又阑。","往时春酒社。","系马垂杨下。","今日任东风。","羞看寂寞红。"],0,"x400","清"],["菩萨蛮 其十五 题画","梁清标","词",["空岩漠漠溪云起。","人家茅屋泉声里。","谁为写沧洲。","当年顾虎头。","冥蒙潭上黑。","波涌鱼龙泣。","好作卧游看。","江南雨后山。"],0,"x400","清"],["菩萨蛮 其十六 夏夜","梁清标","词",["火云飞下三千尺。","我思赤脚层冰立。","待得月昏黄。","轻风拂体凉。","短篱微带露。","两两流萤度。","乍喜却齐纨。","一帘花影寒。"],0,"x400","清"],["菩萨蛮 其十七 春暮有感","梁清标","词",["奈何有梦频惊醒。","落花如雨闲阶冷。","憔悴为疼花。","凭阑日又斜。","空帘栖薄雾。","仿佛凝妆处。","谁料可怜春。","新莺唤煞人。"],0,"x400","清"],["菩萨蛮 其十八 秋日观邗郎演剧","梁清标","词",["晶帘雨过空天碧。","芙蓉笑靥斜阳立。","花影正重重。","人从花底逢。","月高丝管沸。","溜出歌声脆。","对此意茫茫。","偏怜秋夜长。"],0,"x400","清"],["菩萨蛮 其十九 送春","梁清标","词",["远峰历历青如髻。","驿亭几缕墟烟细。","西望凤城遥。","山空夜寂寥。","杏花三月雨。","眼见春如许。","无计挽东皇。","怜他蝶翅忙。"],0,"x400","清"],["诉衷情 其一 忆家","梁清标","词",["绿杨影里子规啼。","催得鬓丝丝。","撩人暮春天气，画阁晚妆时。","新柳困，远山低。","思依依。","五更细雨，半夜归鸿，一片花飞。"],0,"x400","清"],["诉衷情 其二 咏莲","梁清标","词",["猩红弓样试风流。","贴地软香浮。","凌波巧笼纤笋，锦幄倍清幽。","莲折瓣，月微钩。","玉温柔。","苔痕池上，泥印花间，尘迹楼头。"],0,"x400","清"],["诉衷情 其三 旅怀","梁清标","词",["夕阳古道敛残霞。","南雁数行斜。","何缘人却如雁，迢递驿程赊。","回首处，凤城遐。","乱云遮。","灯寒香阁，风起邮亭，人去天涯。"],0,"x400","清"],["诉衷情 其四 无题","梁清标","词",["雪儿十载罢歌喉。","一纸远相投。","为伊暗想当日，牵动几般愁。","银烛夜，彩云留。","笑回眸。","三更幽梦，千里风烟，何处红楼。"],0,"x400","清"],["卜算子 其一 闺晓","梁清标","词",["宝鸭被重薰，茉莉香先透。","两两鸳鸯宿碧纱，私语人知否。","夜雨袅残灯，朝露沾罗袖。","怪煞开奁促晓妆，好梦浓如酒。"],0,"x400","清"],["卜算子 其二 喜雨","梁清标","词",["晨起火云生，棋罢珠帘午。","暗送墙头夜合香，粉蝶双飞去。","汗滴透罗衣，手倦挥纨素。","乍喜风来似故人，几点榴花雨。"],0,"x400","清"],["巫山一段云 春宵","梁清标","词",["箫局微温候，灯篝乍剪时。","端相带笑又佯推。","欲睡故迟迟。","银蒜垂帘悄，金钗落枕欹。","淡红耙袜映唇脂。","低问小名儿。"],0,"x400","清"],["减字木兰花 其一 斋中微雨","梁清标","词",["绿窗才启。","雨过苔青阶似洗。","咫尺烟霞。","风动朱栏芍药花。","梦回如醉。","人语惊残鹦鹉睡。","三径谁开。","篱外多应二仲来。"],0,"x400","清"],["减字木兰花 其二 冯庄看海棠","梁清标","词",["垂杨别馆。","矗矗高楼当翠𪩘。","草绿闲阶。","蛱蝶寻芳自往来。","主人何处。","客醉金卮愁日暮。","燕入谁家。","落尽东风第一花。"],0,"x400","清"],["减字木兰花 其三 立秋","梁清标","词",["西风暗换。","秋到碧梧金井畔。","人立斜曛。","望见家山一片云。","香闺病后。","小槛疏兰花影瘦。","蟋蟀声催。","似为多情宋玉来。"],0,"x400","清"],["减字木兰花 其四 偶忆","梁清标","词",["疏烟暮霭。","人在斜阳秋草外。","梦绕天涯。","知是当垆第几家。","舞裙歌扇。","犹忆遏云花底宴。","楚客愁多。","欲采芙蓉奈远何。"],0,"x400","清"],["减字木兰花 其五 雨后","梁清标","词",["秋葵带露。","红满窗纱蝉满树。","不管闲愁。","倚仗浮云度画楼。","雨丝风片。","消受新凉深小院。","蝶过谁家。","闲煞墙头野合花。"],0,"x400","清"],["减字木兰花 其六 夕阳","梁清标","词",["风吹禾黍。","几阵潇潇山市雨。","秋色三分。","让与渔家水竹村。","藓阶独立。","万户声催双杵急。","柳外寒塘。","牛背归来正夕阳。"],0,"x400","清"],["减字木兰花 其七 秋夜露坐","梁清标","词",["秋宵凉乍。","淡月疏星清露下。","剪剪风来。","茉莉当檐几枝开。","竹篱绿满。","往事追寻人已远。","帘影霏微。","叶底流萤自在飞。"],0,"x400","清"],["减字木兰花 其八 邯郸遣兴","梁清标","词",["短檠孤馆。","锦幄温存天际远。","澹扫铅华。","半在邯郸侠少家。","多情耽误。","一笑姻缘艰陌路。","马上墙头。","不见当时旧画楼。"],0,"x400","清"],["减字木兰花 其九 题画扇","梁清标","词",["遥汀疏柳。","画舫兰桡沙岸口。","小坐篝灯。","堤外青骢嘶未曾。","黄昏有约。","明月芦花无定着。","茗碗香炉。","十样蛮笺薛校书。"],0,"x400","清"],["好事近 归途","梁清标","词",["草短马蹄轻，乱踏落红归去。","遥指杏花村里，问酒家何处？","一溪春水浸春寒，犹是来时路。","闰月东风未老，天亦怜迟暮。"],0,"x400","清"],["谒金门·新浴 其一","梁清标","词",["人新沐。","波溅一枝寒玉。","半著轻罗香馥馥。","妆残重结束。","桃簟凉生绣缛。","小立漏声偏速。","换緉鞋儿刚一掬。","奈何郎又促。"],0,"x400","清"],["谒金门 其二 感怀","梁清标","词",["春寂寂。","鸿雁几行归北。","谁道家山浑咫尺。","层层云树碧。","十载伤心泪滴。","往事不堪重忆。","欲扫旧愁新又积。","风柔难借力。"],0,"x400","清"],["忆秦娥 其一 上谷怀古","梁清标","词",["涛声咽。","萧萧亭照金台月。","金台月。","千年易水，为谁寒热。","狗屠燕市风流绝。","荒田督亢飞残雪。","飞残雪。","悲风落日，今古销歇。"],0,"x400","清"],["忆秦娥 其二 茉莉","梁清标","词",["香风飏。","黄昏院落花初放。","花初放。","银灯试照，别来无恙。","美人奁镜偏宜傍。","珠簪金络增新样。","增新样。","珊瑚枕畔，绿云鬟上。"],0,"x400","清"],["清平乐 西村","梁清标","词",["场空禾黍。","终岁田家苦。","脱却朝衣耕瘠土。","闲逐樵歌渔鼓。","溪翁提挈儿孙。","骑驴买醉前村。","野外人家如画，柴扉灯火黄昏。"],0,"x400","清"],["海棠春 夜雨","梁清标","词",["寂寥春院思千缕。","陌上柳、新黄才吐。","暝色入西楼，雁影沉南浦。","黄昏灯火无情绪。","遗梦到、家山犹阻。","惆怅打梨花，点点飞窗雨。"],0,"x400","清"],["山花子 春愁","梁清标","词",["谩道春风不世情。","愁中吹上鬓边星。","归雁带来云外恨，断肠声。","日暖平芜晴牧马，月明绮阁夜调笙。","无限韶光多少泪，共谁评。"],0,"x400","清"],["罗敷媚 偶见","梁清标","词",["春江艇子看人面，脸晕生霞。","鬓影堆鸦。","艳似孤村二月花。","深藏生怕蜂窥见，懒扫铅华。","悄映窗纱。","借问当垆第几家。"],0,"x400","清"],["阮郎归 登楼酹月","梁清标","词",["碧天无际近中秋。","台高树影稠。","雪儿一曲韵悠悠。","箫声出画楼。","银箭促，暮云流。","娟娟月似钩。","寒消酒力兴偏幽。","佳人翠袖愁。"],0,"x400","清"],["阳台梦 悼亡","梁清标","词",["深秋院落房栊暮。","倚栏细数经行处。","浓香画幔挂珊瑚，锁疏烟薄雾。","空阶风飒飒，吹散芳魂几缕。","一帘灯火又昏钟，疼煞黄花雨。"],0,"x400","清"],["更漏子 梦寤","梁清标","词",["夜儿长，风儿细。","吹入孤眠春思。","青镜畔，玉楼中。","枕函有路通。","横空雁，黄昏雨。","梦里不知客苦。","情脉脉，意迟迟。","迷离乍醒时。"],0,"x400","清"],["眼儿媚 春昼","梁清标","词",["日射晴窗静无哗。","风袅柳枝斜。","有人深院，凝妆独坐，门掩桃花。","追思往日重回首，心事付啼鸦。","隔墙笑语，却疑春色，只在邻家。"],0,"x400","清"],["柳梢青 春日","梁清标","词",["小雨才收。","平沙细草，绿满西畴。","柳眼青归，桃腮红晕，人倚高楼。","家家绣幕帘钩。","春不管、斜阳旅愁。","罗绮风前，秋千影里，马上墙头。"],0,"x400","清"],["少年游 春愁","梁清标","词",["啼莺恰恰到窗纱。","几缕晓烟斜。","此日春城，汉宫传蜡，散入五侯家。","三分春色愁中度，一半在梨花。","肠断黄昏，酒醒残月，门外即天涯。"],0,"x400","清"],["醉花阴 其一 临济村赏蔷薇","梁清标","词",["临水柴门槐影护。","只合幽人住。","篱落带斜阳，一架蔷薇，习习香风度。","绿阴碧藓开樽处。","客醉忘归去。","远树杜鹃啼，溪静林深，疑是江南路。"],0,"x400","清"],["醉花阴 其二 瓶梅","梁清标","词",["疏影一枝风袅袅。","暗送寒香小。","浅水照横斜，高士山中，春色生多少。","黄昏孤枕江声悄。","新月窥人好。","遥忆绮窗前，晴雪霏霏，银蒜垂帘早。"],0,"x400","清"],["探春令 闺情用晏叔原韵","梁清标","词",["琐窗黄鸟，傍人啼逗，恹恹天气。","送离愁、一寸柔肠里。","偏不分、鹦哥睡。","画阑风雨催花坠。","欹枕非关醉。","算春光九十，匆匆过了，多少闺中泪。"],0,"x400","清"],["杏花天 花朝过金鱼池","梁清标","词",["莺声曲岸轻阴乍。","春水涨城南台榭。","谁家高结秋千声架。","人在卖花帘下。","踏青鞋、旧游重话。","记挟弹、芳原试马。","杏花小雨西村社。","放了东风宽假。"],0,"x400","清"],["双调望江南 秋夜小饮","梁清标","词",["秋色好，檐外晚凉天。","弈罢一樽携翠袖，绿窗纤手弄冰弦。","二八正韶年。","秋色好，莫问夜何其。","风月蹉跎人老大，十年心事鹭鸥知。","灯灺酒阑时。"],0,"x400","清"],["浪淘沙 闺词","梁清标","词",["日影旧窗纱。","昼静藏鸦。","东风谨护牡丹芽。","珠箔深深垂绮户，便是儿家。","娇小鬓云斜。","暗度韶华。","春愁不减脸边霞。","绣得双鸳新画谱，并蒂荷花。"],0,"x400","清"],["鹧鸪天 春雨","梁清标","词",["满载离愁听晓鸡。","一天风雨昼凄凄。","朝来画艇春波滑，云暗遥峰黛色低。","魂欲断，路还迷。","山深恼煞鹧鸪啼。","镜中珍重朱颜好，指日帆悬楚水西。"],0,"x400","清"],["金凤钩 其一 燕来","梁清标","词",["忽闻燕，来何处。","向树底、双双小语。","一春消息，故人情重，不爽佳期唯汝。","自怜每被多情误。","频劝取、不须飞去。","絮泥衔得，为谁辛苦。","空傍人家门户。"],0,"x400","清"],["金凤钩 其二 上巳","梁清标","词",["春偷减，赊无计。","怪非雨、非晴天气。","梨花开落，情多生怨，难向芳草修禊。","长安水畔新蒲细。","可更有、佳人拾翠。","兰房徙倚，梦回窥镜试。","验朱颜凋未。"],0,"x400","清"],["一斛珠 题扇头扑蝶图","梁清标","词",["抛残线帖。","金钿巧衬芙蓉颊。","花间小步香生屧。","凤子蜻蛉，觅遍闲枝叶。","画眉人远肠千结。","满园秋色同谁说。","笑携女伴风前瞥。","扇扑轻罗，恼煞双飞蝶。"],0,"x400","清"],["玉楼春 其一 送春","梁清标","词",["花飞南陌东风暮。","肠断王孙芳草路。","绿槐影里雨初晴，黄鸟声中春暗去。","乱山叠叠看无数。","故国遥遮云外树。","一年佳景等闲抛，好梦欲寻无觅处。"],0,"x400","清"]]