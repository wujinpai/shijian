[["解佩令","屈大均","词",["芙蓉不好。","荼蘼不好。","是桃花、桃叶都好。","来自秦淮，□似比，流莺娇小。","怎消他、一枝袅袅。","吴绫裁了。","越罗裁了。","怕鸳鸯、一对颠倒。","刺绣多闲，尽一十二时调笑。","写兰葩、未嫌太少。"],0,"x265","清"],["虞美人","屈大均","词",["灯花并蒂红蕖似。","博得佳人喜。","门帘尽下怕风惊，催把兰膏添满到天明。","双双暖玉围棋子。","赌取松花绮。","横陈直待汝南鸡。","才上牙床却又月沉西。"],0,"x265","清"],["十六字令","屈大均","词",["花。","见尔如何不忆家。","花虽好，争似脸边霞。"],0,"x265","清"],["金菊对芙蓉  本意","屈大均","词",["香沁疏篱，菊英谁伴，芙蓉千瓣含烟。","与鹅黄相映，弄粉争妍。","朱颜一日能三醉，向白衣，笑更嫣然。","九华佳色，玉杯共泛，不觉忘天。","折取插鬓翩翩。","向酒家乱掷，胜似金钱。","与新辞芳艳，分付婵娟。","长红小白同低唱，更一朵、当锦双缠。","拒霜辛苦，因公晚景，一倍相怜。"],0,"x265","清"],["花犯","屈大均","词",["恨炎天，梅花少雪，凝脂未肥白。","玉寒珠热，似倒挂南枝，幺凤无力。","古人欲寄春消息。","踯躅那忍摘。","怕蛱蝶、食残黄蕊，团香归粉翼。","仙姿亦复苦愁侵，怜他消受甚，神伤姑射。","膏沐少。","天然好、免污颜色。","飞琼女、月中不辨，缟衣冷、相要同片石。","唤翠羽、啾嘈歌罢，天明愁寂寂。"],0,"x265","清"],["眉妩  新月","屈大均","词",["喜纤纤钩挂，淡淡痕生，初试素娥手。","未作瑶台镜娟娟影，新眉随意描就。","短长漫斗。","想玉葱、殊未消瘦。","最堪爱、宛转画楼前，半规映珠斗。","仙样唐宫那有。","叹玉蜍独处，金兔无偶。","不死虽偷药，凄凉甚、教人翻恨王母。","素娥未久，更两宵、弓影全彀。","看三两，天狼、光坠贯他左肘。"],0,"x265","清"],["九张机","屈大均","词",["春罗。","蝶红蝶白各花窠。","鲜花食尽难成茧，何如蚕子，雌雄食叶，三日即成蝶。"],0,"x265","清"],["霜天晓角  二首 其一","屈大均","词",["翠楼明月。","此夕应如雪。","三两玉人相倚，香露沁、湿云屧。","一叠还一叠。","瑶琴弹不辍。","恨与素娥同寡，蟾兔外。","共寒绝。"],0,"x265","清"],["霜天晓角  二首 其二","屈大均","词",["此情良苦。","况复潇潇雨。","长夜苦寒难睡，虫唧唧、似儿女。","岁去穷不去。","埋忧那有处。","白首不堪家累，无计甚、向谁语。"],0,"x265","清"],["侍香金童","屈大均","词",["雪瘦冰肥，淡淡含春色。","喜香暗、清寒入未识。","蝶子偷将新蕊食。","剩粉残酥，为留瑶席。","怕乱飞、片片随风难自力。","更寄语、多情休弄笛。","一朵鬓边簪亦得。","未许全枝。","玉纤多摘。"],0,"x265","清"],["声声慢  闻乘上吹螺","屈大均","词",["东西雁翅，两作飞楼，江间一片沉浮。","四角呜呜，螺声飒起高秋。","凄凉尉佗台上，恨边声，飞满炎州。","风吞吐，尽秦关汉塞，处处含愁。","绝对似金笳催泪，与明妃、诸曲哀怨同流。","未曙频吹，匆匆人马难留。","无边战魂惊起，逐行营、朝暮啾啾。","那管得，一军中、人尽白头。"],0,"x265","清"],["真珠帘  送杜十五不党返淮安","屈大均","词",["南来不惮蛮天路。","笑风流、解作琼州香估。","多食女槟榔，蚤已消蚕蛊。","废著随人殊不富。","问几时、挥金如土。","迟暮。","恨多日佯狂，功名难取。","筋力枉负熊罴。","悔英雄未结，淮阴无伍。","且向钓鱼台，更一竿烟雨。","天饿王孙应有意，教识得、城东仙妪。","君去。","看年少屠中，有谁欺汝。"],0,"x265","清"],["应天长","屈大均","词",["江南九熟清明近。","红有樱桃松有粉。","瑰花调，珠叶衬。","多谢当垆人不吝。","下香蔬，兼细笋。","食到畔心争忍。","消受自惭过分。","金钱教莫进。"],0,"x265","清"],["菩萨蛮","屈大均","词",["一春融暖无多日。","愁花怨草都含泣。","烟雨解欺人。","貂裘典莫频。","清明看渐近。","鸳燕来相问。","风已几多番。","春残尚恁寒。"],0,"x265","清"],["甘草子","屈大均","词",["香好，香辣香甜，滋味从郎取。","但得一星含，自有双烟吐。","结得伽南心还苦，向欲暖、犹寒窗户。","长把山炉𦶟朝暮。","任一天阴雨。"],0,"x265","清"],["摸鱼儿  柬友","屈大均","词",["送春帆、圣湖归好，苦寒还欲君驻。","消魂一路多烟草，况复乱丝风絮。","谁为主。","蒹菼际、雕胡但向渔人取。","流莺未老。","且花卧浮丘，月吟香濑，嬉尔小儿女。","王孙志，一剑纵横未许。","屠沽休说欺汝。","江山一任无人管，自有几只鸥鹭。","君莫去。","还就我、扶胥北岸题诗处。","低斟桂露。","待兰畹编成，玉杯书毕，始问庾关路。"],0,"x265","清"],["霜天晓角  二首 其一","屈大均","词",["镜中人老。","镜外人难好。","阶下紫兰红蕙，须教变，长生草。","蝶香多在粉，拾来和药捣。","多取异花薰炙，料得使、朱颜保。"],0,"x265","清"],["霜天晓角  二首 其二","屈大均","词",["飞飞榆荚。","片片连花叶。","欲买旧愁新恨，频移步、风前拾。","拾来眉上贴，勾引双双蝶。","多少碧桃红杏，不得上、胭脂靥。"],0,"x265","清"],["菩萨蛮","屈大均","词",["状成未肯离明镜。","嫌他镇日含花影。","轻罩海人纱。","休令生片霞。","鬓边空战叶。","免惹双蝴蝶。","忘上口脂来。","菱花行又开。"],0,"x265","清"],["河渎神","屈大均","词",["祠口对浮罗。","攀枝红映红波。","女蛮春赛祝融多。","数声铜鼓相和。","潮去潮来兰桨便。","龙气时时惊见。","蚬?鱼篮朝散。","斗歌风外难断。"],0,"x265","清"],["露华  白牡丹","屈大均","词",["素妆淡淡。","喜绝代琼姿，皎皎难染。","路入庾关，能见梅花无忝。","一枝不必姚黄，已夺越娘光艳。","炎天热、琼台夜深，牖户休掩。","盈盈半压朱槛。","正浣出天香，珠露微点。","笑谢洛阳花估，国色长占。","想暖稍展氍毹，更使玉人匀脸。","当影坐，衔杯共对不厌。"],0,"x265","清"],["渔家傲  水仙花","屈大均","词",["远自姑苏来药市。","茎茎抽出凌波子。","六瓣冰开寒若水。","纯黄蕊。","相中微带人间腻。","朵大梅花应不似。","叶长只为多泥滓。","月有京华都与尔。","清泠里。","衣裳一一生霜气。"],0,"x265","清"],["点绛唇  素馨花灯","屈大均","词",["忙杀珠娘，未开已上花田渡。","鬓边分取。","灯作玲珑去。","人气添香，香在光多处。","天休曙。","熟花方吐。","朵朵成烟雾。"],0,"x265","清"],["临江仙  花灯","屈大均","词",["香篆氤氲帘影内，兰缸正作重台。","双心合作一心开。","芙蓉无种，春自火中来。","光暗不将银箸剔，贪他再结仙胎。","殷勤拾取落花煤。","油污玉指，小印定瓷杯。"],0,"x265","清"],["东风第一枝  桃花","屈大均","词",["宿雨初晴，林烟尚湿，旧花又吐新蕊。","尽他人面争红，莫道艳妆未似。","露华凝满，是西华、明星浆水。","爱玉盏、盛取芳馨，暖处自成沉醉。","将数朵、分他媚子。","和叶叶、半簪云髻。","𫖃馀儿女娇容，更染细绫绣被。","黄莺休掠，令片片、香沾泥滓。","向屋角、更种多株，灌溉恐烦乡里。"],0,"x265","清"],["点绛唇  淡红梅","屈大均","词",["背有微红，绛桃一半为根蒂。","幼姿偏丽。","种得才三岁。","漏泄年光，心吐香难制。","花虽细。","弄人多计。","不惜胭脂泪。"],0,"x265","清"],["怨三三  鹿葱","屈大均","词",["三山港口掣花蓝。","只买宜男。","朵朵凌朝喜半含。","髻鬟上、可双簪。","休教鹿子来衔。","这萱草、根茎总甘。","好黛色重添。","和伊争绿。","掩映江南。"],0,"x265","清"],["惜秋华  木芙蓉","屈大均","词",["莫拒秋霜，任重台独瓣，红衣都染。","乍得露华，新幢更添娇艳。","凌晨已作酡颜，醉滴滴、天浆未厌。","堪念。","念芙蓉制裳，湘累得占。","朵朵暮还敛。","待明朝酲解，把薄胭脂点。","恨水浅。","照不彻、镜云微掩。","何人见尔关情。","折数朵、寄来相赚。","那敢。","怕鸳鸯、露栖蒹菼。"],0,"x265","清"],["五彩结同心  答黄位北见饷姑苏酒浸杨梅","屈大均","词",["包山始熟，玄墓初垂，炙得太湖全赤。","载向闾门去，把三白，一一和枝深渍。","甜酸得酒皆成蜜，随十幅、蒲帆为客。","玉颜好、尽生红晕，绝胜夏时鲜食。","炎洲荔枝谁敌。","且莫教郁水，织绡人识。","更有萧然白。","湘湖上，香共紫莼茎摘。","烧春相伴方长命，看岁岁、丹砂容色。","愧满盘，火珠滴滴。","欲报琼瑶无力。"],0,"x265","清"],["长相思  落花","屈大均","词",["一枝低。","两枝低，黄鸟飞东蛱蝶西。","双双尚自啼。","朝烟迷。","暮烟迷。","紫燕衔时已作泥。","纷纷衬马蹄。"],0,"x265","清"],["琴调相思引  素馨花","屈大均","词",["笑掷金钱买几升。","半穿璎珞作珠灯。","一家纤手，细细贯丝绳。","暮上翠鬟方吐蕊，晓辞罗帐尚含冰。","梦魂清绝，多恐冷香凝。"],0,"x265","清"],["卖花声  鹧鸪","屈大均","词",["两两对啼闲。","声似人蛮。","多情唤得玉骢还。","何处春深行不得，楚水吴山。","南翥向梅关。","苦竹丛间。","隋阳不似北禽寒，衔叶未教霜露湿，日映花斑。"],0,"x265","清"],["如梦令  二首 其一","屈大均","词",["顶上三毛摇曳。","个是华山冠制。","遍体锦文圆，妒杀画堂羽翠。","无计。","无计。","大尾更须三岁。"],0,"x265","清"],["如梦令  二首 其二","屈大均","词",["尾上金钱如许。","终日开屏劳汝。","只为雨来时。","欲置珠毛无处。","飞去。","飞去。","合浦尽多高树。"],0,"x265","清"],["瑞鹧鸪","屈大均","词",["山鸡锦翼许相同。","双双那肯嫁边鸿。","欺汝南禽，生长梅花里，日守蛮烟白一丛。","梅花最爱梅𫓶岭，雌雄各占高峰。","空愁霜露沾衣。","望断罗浮日，蚤生东。","暖向平芜唤玉骢。"],0,"x265","清"],["杨柳枝","屈大均","词",["小小珍禽似画眉。","是相思。","钗头偷立已多时。","未曾知。","郎处不须红豆子。","殷勤寄。","双双取得系红丝。","到天涯。"],0,"x265","清"],["醉花阴  翡翠","屈大均","词",["雄缥雌青相掩映。","爱杀银塘镜。","日夕浣清波，春羽秋毛，个是佳人命。","珍珠一一皆穿竟，无尔妆难靓。","点缀九鸾钗，叶淡花浓，要与春光竞。"],0,"x265","清"],["齐天乐  比翼鸟","屈大均","词",["南禺有鸟皆称凤，鹣鹣乃是蛮子。","碧树交栖，青衣两比，长唤归飞难已。","时穿烟水，与白练红绡，竞餐花蕊。","却恨鸳鸯，恁生多了一双翅。","袭胸谁得辨汝。","似迦陵共命，鸟鼠同体，暮不相思。","朝非独寐，伉俪人中无比。","闺人思苦，倩好手边鸾，画成遥寄。","鲽也灵鱼，更圆三四尾。"],0,"x265","清"],["蝶恋花  题唐宫扑蝶图","屈大均","词",["凤子翩翩纷似雪。","画扇低飏，惊入深深叶。","博得君王开笑靥。","闻香忽复穿裙褶。","秦女剩鸾颠倒绝。","捉得黄须，腻粉教轻捻。","收向镜奁成媚蝶。","承恩好待华清月。"],0,"x265","清"],["醉落魄","屈大均","词",["飞花如许。","无多紫燕难衔汝。","春归谁作婵娟主。","愿似游丝，长绊郎风絮。","韶光误尽因烟雨。","并刀已剪愁千缕。","情多恐化相思树。","人可催归，会逐啼鹃去。"],0,"x265","清"],["渔家傲","屈大均","词",["白首夫妻双打桨。","春来最喜西江涨。","日日鳜鱼争入网。","笼且养。","香粳欲换需官舫。","鸥鹭哪分三与两。","年年共在沙洲上。","白小纷纷君不让。","飞荡漾。","窥人岂为梨花酿。"],0,"x265","清"],["画堂春","屈大均","词",["天青染得一江青。","烟波雪后逾明。","片帆冲破白云屏。","荡漾鸥汀。","芳草茫茫天际，罗裙直接空冥。","看黄成绿是愁凝。","春色难胜。"],0,"x265","清"],["贺圣朝","屈大均","词",["休憎春色如浓酒。","纵醉人难久。","愁心搅乱任莺声，更丝丝垂柳。","歌长歌短，总催白发，但瑶琴在手。","飞花片片解相依，到天涯犹有。"],0,"x265","清"],["虞美人","屈大均","词",["青山渐渐围天尽。","峡口春难认。","渺茫烟树带渔村。","愁见白云红叶又黄昏。","沙鸥贴水随波远。","吹笛教飞断。","炊烟欲湿雨来时。","恨尔衔鱼高下不曾知。"],0,"x265","清"],["感皇恩  煎香","屈大均","词",["熟结水沉同，煎宜火细。","不取香烟取香气。","氤氲一缕，不作巫云苍翠。","味生空里令人醉。","日暖尚熏，夜深难睡。","四下风帘恐凉吹。","鸪斑半烬，片片总留芳蜕。","岕茶再浴惊精在。"],0,"x265","清"],["渔歌子 二首 其一","屈大均","词",["开到棠梨不是花。","莺啼莫忆旧繁华。","朝雨急，暮风斜。","出光催去去谁家。"],0,"x265","清"],["渔歌子 二首 其二","屈大均","词",["夹浦夭桃树树斜。","一湾不见一湾花。","云带岸，水侵沙。","白鸥多处有人家。"],0,"x265","清"],["海棠春","屈大均","词",["清箫未弄肠先绝。","正槛外、朦胧帘月。","露冷雁声沉，水湿萤光灭。","柳枝难作同心结。","但有絮、纷纷似雪。","莫傍画裙飞，片片成蝴蝶。"],0,"x265","清"],["酒泉子  二首 其一","屈大均","词",["不恨啼鹃，苦苦只催春日去，春来只是作春阴。","冷难禁。","生憎泥陷马蹄深。","尽是紫霞红雪□，得归香垒也甘心。","燕须寻。"],0,"x265","清"],["酒泉子  二首 其二","屈大均","词",["最恨蘼芜，消受罗裙双带影，暖风吹去复吹来。","在苍苔。","踏青争上越王台。","蝴蝶不因朝雨散，鹧鸪休为夕阳催。","且徘徊。"],0,"x265","清"],["浣溪沙","屈大均","词",["欲使绯桃嫁碧桃。","瓶中交插两枝高。","朝朝对取酌香醪。","白发不须求大药，红颜自可解离骚。","并州那有剪愁刀。"],0,"x265","清"],["浣溪沙 桃溪","屈大均","词",["榕叶阴阴又木棉。","芭蕉黄映一溪烟。","人家半在峡门边。","虾菜未残三月市，鱼花争上九春船。","愁同百丈尽情牵。"],0,"x265","清"],["点绛唇 二首 其一","屈大均","词",["分付东风，卷愁西向秦天去。","瓮翁香乳。","旧解貂衣处。","那日花开，持取歌金缕。","鞍难驻。","泪和红雨。","半湿关门树。"],0,"x265","清"],["点绛唇 二首 其二","屈大均","词",["看杀春山，翠眉何必长如许。","黛边烟雨。","莫使人描取。","掩映高楼，花缺偏窥汝。","斑枝树。","令栽无数。","遮尽芙蓉路。"],0,"x265","清"],["荷叶杯  二首 其一","屈大均","词",["图取玉颜酡甚。","多饮。","吹醒畏东风。","桃花要与尔相同。","红么红。","红么红。"],0,"x265","清"],["荷叶杯  二首 其二","屈大均","词",["春日春人惟又。","春酒。","朵朵照琼枝。","山茶花被海棠催。","开么开。","开么开。"],0,"x265","清"],["南乡子","屈大均","词",["琵琶尾，凤凰头。","相逢识是柳城舟。","双双桂楫摇纤玉。","沙鸥逐。","思得湔裙香水浴。"],0,"x265","清"],["临江仙","屈大均","词",["前镜那知侬影好，怜人更有菱花。","研制忘作脸边霞。","春来无力，日日髻鬟斜。","不使香貂为抹额，天寒尚束轻纱。","海棠簪罢又山茶。","恨伊双燕，衔去向西家。"],0,"x265","清"],["醉春风  友人饷金陵雪酒","屈大均","词",["春色如眉黛。","𥬠成香可爱。","梅花三白总将来，赛。","赛。","赛。","花里封泥，柳边开瓮。","客愁全解。","叹尔情如海。","红友频相赉。","可能移得惠山泉，再。","再。","再。","频使溪翁，玉杯长满，玉颜长在。"],0,"x265","清"],["减字木兰花","屈大均","词",["梨花未绝。","朵朵沾泥犹是雪。","欲嫁东风。","自有蜂媒送落红。","连朝烟雨。","一见春光都欲语。","斟酌庭前。","忍舍莺声去昼眠。"],0,"x265","清"],["天仙子  二首 其一","屈大均","词",["双鬓但将蝴蝶赛。","露花油好嫌香大。","吴阊学得牡丹头，钗不戴。","珠不爱。","只有一枝兰作态。"],0,"x265","清"],["天仙子  二首 其二","屈大均","词",["自织纤纤娇女葛。","露花蝉翼同轻滑。","裁为夫婿夏时衣，风莫绉。","汗莫透。","管取清凉长似旧。"],0,"x265","清"],["捣练子","屈大均","词",["春欲去，去天涯。","片片残红似落霞。","蝴蝶飞过蝴蝶草，鹧鸪啼上鹧鸪花。"],0,"x265","清"],["苏幕遮  题盘斋","屈大均","词",["虎头云，狮口水。","风卷虚无，飞入疏帘里。","古木阴阴凉不已。","无数蝉嘶，又送松声起。","荔成花，蕉有子。","多种丫兰，分我茎茎紫。","甘蔗还教甜到尾。","抱瓮相从，我亦忘机矣。"],0,"x265","清"],["江城子","屈大均","词",["春魂如雨复如烟。","暗吹断，落天边。","无情花片，相逐又明年。","人笑海棠消受尽，明镜好，尚相怜。","软同人柳只多眠。","怕啼鹃、到帘前。","愁压春山，不使黛云妍。","枕簟为谁寒欲绝。","教宝鸭，断沉笺。"],0,"x265","清"],["清平乐","屈大均","词",["海棠丝短，不遣风吹断。","一朵依然红玉软。","留与妆楼寄远。","杨花未作浮萍。","枝间交映青青。","拾絮殷勤作枕，郎归定爱芬馨。"],0,"x265","清"],["洞仙歌  赠潘季子花烛","屈大均","词",["开年几日，喜蛮花香杂。","未尽春寒尚重祫。","正佳期、十五明月团圆，初一度，蟾兔阴阳开合。","王郎题赋罢，盼睐双星，冉冉仙人下云阁。","自有板桥长，灵鹊殷勤，休环绕、绛河三匝。","问七夕、何如上元时，有处处、张灯火花烟蜡。"],0,"x265","清"],["诉衷情  小妓","屈大均","词",["开唇只唱月儿高。","未熟小樱桃。","雏鹰身似琵琶，短短绣花袍。","能劝客，白酥醪。","绿葡萄。","娥眉教画，鸟爪教搔，莫弄檀槽。"],0,"x265","清"],["阮郎归","屈大均","词",["春来莫使杜鹃知。","杜鹃花已飞。","海棠更是泪红时。","片片付游丝。","琴不弄，酒空持。","愁心尽在眉。","裙边蛱蝶怕风吹。","房帘深自垂。"],0,"x265","清"],["雨中花慢  越王台下怀古","屈大均","词",["雁翅三城，龙荒十郡，秋来不减边沙。","恨牛羊有地，鸡犬无家。","虽少诸军浴铁，还馀几队吹笳。","口朝台试望，天似穹庐，直接京华。","赵佗箕踞，南武称雄，遗墟问取栖鸦。","谁得似、斑骓汉使，才藻纷葩，汤沐千年锦石，文章五岭梅花。","彩丝女子，争看旌节，色映朝霞。"],0,"x265","清"],["行香子  渔歌","屈大均","词",["第一鱼鲳。","第二鱼?。","第三鱼是马膏?。","潮咸潮淡，一任鱼郎。","喜春风来，黄花短，白花长。","江水鱼香。","鱼子滋阳。","大罾船、满载盐霜。","罛公罛姥，两两开洋。","更鲚鱼寒，鲈鱼热，脍皆良。"],0,"x265","清"],["万年欢  为百有五岁梁淳儒翁寿","屈大均","词",["绿随青瞳，好眉华发，八公推尔年尊。","膝下公沙龙子，一一多孙。","一百春秋又五，奇龄好，天与东园。","东方妾，大小鸳鸯。","蚌胎新产珠媛。","凝脂滑肤作枕，与辟寒燕玉，日夜春温。","玉女明星浆水，两乳相喷。","不使张苍齿落，多饮取、孩笑同喧。","茶枝杖，扶过花村，寿星人喜临门。"],0,"x265","清"],["燕归梁","屈大均","词",["几片春光燕嘴边。","红湿露啼鲜。","海棠丝短也相牵。","残梦后，断魂前。","粉馀飞雪，香消沉水，无计更留仙。","东风好，送向花田。","花麝土，早成烟。"],0,"x265","清"],["一斛珠   二首 其一","屈大均","词",["媚儿开袖。","芙蕖花出樱桃口。","多生定念莲经否。","欲吐芳香，辄自含辞久。","荷叶不离双玉手。","朝朝暮暮来擎酒。","半酣方肯歌红豆。","不信娇莺，似尔春声溜。"],0,"x265","清"],["一斛珠   二首 其二","屈大均","词",["海棠丝短。","输他杨柳丝难断。","流莺系得枝枝满。","莫只贪眠，不耐腰身软。","花絮无情风自乱。","眉痕一任春深浅。","生憎一树含烟暖。","每共芭蕉，片片心舒倦。"],0,"x265","清"],["一斛珠  乞某子作树","屈大均","词",["古肥今瘦。","三真六草多仙授。","银钩趸尾人争购。","一幅鹅溪，为写兰亭就。","笔虎如今谁怒手。","天门龙跳争驰骤。","墨涛翻处蛟螭斗。","更乞惊鸾，字字教如斗。"],0,"x265","清"],["更漏子","屈大均","词",["无数落花人不惜，拾红浴向清溪。","胭脂不使作香泥。","莺掠去东西。","休絮乱，与丝齐。","牵人只似柔荑。","无情枉作有情啼。","杜鹃声且低。"],0,"x265","清"],["罗敷媚  碧桃","屈大均","词",["洗红尽褪夭夭色，雪粉犹多。","不肯颜酡。","浓淡胭脂总笑他。","看朱成碧朦胧甚，只为相思。","不见红儿。","化作瑶华怎得知。"],0,"x265","清"],["蝶恋花  春情","屈大均","词",["似雨如晴春乍暖。","漠漠烟青，未肯含愁浅。","怅望不知人已远。","踏红似向花间转。","乱落杜鹃馀几片。","付与游丝，莫被风吹断。","紫燕衔香知有怨。","怨他情与东风短。"],0,"x265","清"],["天仙子","屈大均","词",["翡翠兰开如翡翠。","朵朵教人日长醉。","玉壶无酒又春愁。","因柳色，怕登楼。","一任年光逐水流。"],0,"x265","清"],["诉衷情","屈大均","词",["为爱腰肢多种柳，拂朱桥。","垂绣户。","双舞。","当妖娆。","看煞落花朝。","摇摇。","流莺花外招。","向长条。"],0,"x265","清"],["河传","屈大均","词",["芳草。","芳草。","萋萋官道。","恨尔如烟。","一春相逐夕阳边。","扬鞭。","趁晴天。","天愁却比人愁重。","雨如梦。","暗把韶光送。","东风休作花落媒。","吹来。","含啼向酒杯。"],0,"x265","清"],["醉花阴  以竹节大斗为元兄寿","屈大均","词",["一节琅玕开大斗。","斟汝满春酒。","金老饱风霜，磨用阴山，玉爪清光透。","龙公早向罗浮取。","光怪像灵寿。","叶大似芭蕉，倦作荷筒，更可娱黄耇。"],0,"x265","清"],["东风第一枝  送张君携假返杭州","屈大均","词",["荔蕊初含，棉花欲吐，春光渐与膏沐。","乳莺催意香泾，旅雁引辞槛曲。","兰桡荡漾，羡归客，鸳鸯相逐。","漫计程，想到明湖，尚未藕肥菱熟。","知佩又、大红媚蝠。","么凤子、再看羽绿。","早从奔月灵娥，乞得兔儿在腹。","罗孚曾至，怎忘得、芝甘如肉。","待宦成，散带重游，肯作洞天梅福。"],0,"x265","清"],["木兰花慢  竹业符","屈大均","词",["向笼葱摘取，问虫篆、是谁书。","似蠹绣丹经，鱼餐绿子，巧出仙馀。","麻姑。","戏将凤爪，印龙纹、一晕一河图。","更缀阴阳小押，辟邪留在冲虚。","研朱。","箨陨亦沾濡。","掩映雪消初。","笑带鱼与露，腻香春粉，总赠芳姝。","林于。","洞庭万树，奈斑斑、只有泪如珠。","那得双钩片片，惊鸾迹遍萧疏。"],0,"x265","清"],["水龙吟  五色雀","屈大均","词",["洞天偏是朱明，凤凰生长纷孙子。","更多五色，绛翎作长，绿兄红姊。","大石楼边，锦屏峰际，群飞相比。","与碧鸡丹翠，雌雄三两，教王母、长驱使。","又有鹲䴀越翅。","粪奇香，水沉真似。","䴔䴖对对，捣馀灵药，连声呼尔。","解识仙儒，洞门遥迓，导归花市。","爱回翔逐我，彩衣儿女，作高堂喜。"],0,"x265","清"],["粉蝶儿  本意","屈大均","词",["兰出朱明，翩翩凤凰孙子。","笑麻姑、绣裙难似。","触飞丝，穿落粉，尽他春戏。","更谁人，逍遥漆园如尔。","莺捎不去，缠绵一生花底。","与风流、绿毛丁髻。","共收香，到静夜，方开双翅。","怕娇娥，轻罗扑伤金翠。"],0,"x265","清"],["七娘子","屈大均","词",["愁来又路从烟草。","东风不把蘼芜扫。","丝短丝长，将愁萦绕，萋萋一片先春老。","紫骝娇向香泥倒。","绿干红湿多行潦。","欲问萝村，无人知道。","茫茫不觉山花好。"],0,"x265","清"],["少年游  芭蕉","屈大均","词",["水蕉心老苦难开。","春作剪刀催。","油罗衫影，冰消裙影，荡漾拂帘来。","猩红花蕊层层卷，愁拘束、待轻雷。","最怕秋声，冷含风雨，且莫折苞胎。"],0,"x265","清"],["南乡子  蓬松果","屈大均","词",["一树蓬松。","身如井上两梧桐。","雄树生花雌结子。","鸳鸯似。","不是多情争有此。"],0,"x265","清"],["一落索  落花二首 其一","屈大均","词",["消受春光无几。","流莺催尔。","无端开落太匆匆，枉去争红紫。","苦被东皇驱使。","梦中相似，行云行雨总无情，教宋玉、空悲泪。"],0,"x265","清"],["一落索  落花二首 其二","屈大均","词",["多谢燕儿衔汝。","嘴粘红雨。","纷纷青冢画梁间，栖宿多香土。","两两呢喃相语。","粉含脂吐。","巢成即是玉钩斜，魂片片，恁为主。"],0,"x265","清"],["琴调相思引","屈大均","词",["怕见春山不上楼。","烟含春恨雨含愁。","茫茫归思，不共夕阳收。","海燕多情偏易去，边鸿无主总难留。","凄凄孤馆，苦住更何求。"],0,"x265","清"],["茶瓶儿","屈大均","词",["正峭寒时人独卧。","雪吹乱、纷纷风簸。","花细难成朵。","锦衾空冷，一片层冰裹。","天遣多情真苦我。","更白发、催人无那。","草草青春过。","酒慵花惰，但掩窗儿坐。"],0,"x265","清"],["南乡子二首 其一","屈大均","词",["个个香囊。","中多叶叶叠鸳鸯。","咸水槟榔那少汁。","樱唇湿。","纵传胭脂唇不入。"],0,"x265","清"],["南乡子二首 其二","屈大均","词",["注满香螺。","白椰心小玉浆多。","饮去教郎长似醉。","花中睡。","却笑槟榔无酒味。"],0,"x265","清"],["渔歌子","屈大均","词",["素馨红，素馨绿。","素馨红绿看难足。","穿茉莉，贯芙蓉，持作玲珑花屋。","旖旄香，宜新浴，荔枝膏滑惭非玉。","捐麝片，屏笺沉，怕乱冰肌真馥。"],0,"x265","清"],["春光好","屈大均","词",["花似笑，柳如愁。","总风流。","独有伤春人不好，雪盈头。","憎他乳燕鸣鸠。","一个个、双栖画楼。","不肯拆开飞教子，趁风柔。"],0,"x265","清"],["江城子","屈大均","词",["滩头乘雨放鸬鹚。","水生时。","一篙迟。","鲤鱼三尺，惊出碧涟漪。","方便可能将尺素，千里外，寄相思。"],0,"x265","清"],["荷叶杯 雁二首 其一","屈大均","词",["又见边鸿飞至。","归未。","嘹呖一声秋。","衔书不忍过高楼。","愁么愁。","愁么愁。"],0,"x265","清"]]