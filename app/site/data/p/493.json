[["郊庙歌辞 享文敬太子庙乐章 送神","张荐","四言",["三献具举，九旗将旋。","追劳表德，罢享宾天。","风引仙管，堂虚画筵。","芳馨常在，瞻望悠然。"],0,5,"唐"],["补乐歌十首  二","元结","四言",["猗太帝兮，其功如天。","均四时兮，成我丰年。"],0,63,"唐"],["郊庙歌辞 五郊乐章 青帝角音 雍和","魏征","四言",["大乐稀音，至诚简礼。","文物棣棣，声明济济。","六变有成，三登无体。","乃眷丰洁，恩覃恺悌。"],0,152,"唐"],["郊庙歌辞 祭汾阴乐章 顺和","源光裕","四言",["方丘既膳，嘉飨载谧。","齐敬毕诚，陶匏贵质。","秀毕丰荐，芳俎盈实。","永永福流，其升如日。"],0,173,"唐"],["郊庙歌辞 禅社首乐章 雍和","贺知章、源乾曜","四言",["夙夜宥密，不敢宁宴。","五齐既陈，八音在县。","粢盛以洁，房俎斯荐。","惟德惟馨，尚兹克徧。"],0,126,"唐"],["倬彼我系 其五","王勃","四言",["爰述帝制，大搜王道。","曰天曰人，是祖是考。","礼乐咸若，诗书具草。","贻厥孙谋，永为家宝。"],0,239,"唐"],null,["郊庙歌辞 禅社首乐章 太和","贺知章、源乾曜","四言",["肃我成命，于昭黄祇。","裘冕而祀，陟降在斯。","五音克备，八音聿施。","缉熙肆靖，厥心匪离。"],0,126,"唐"],["郊庙歌辞 禅社首乐章 太和","贺知章、源乾曜","四言",["昭昭有唐，天俾万国。","列祖应命，四宗顺则。","申锡无疆，宗我同德。","曾孙继序，享神配极。"],0,126,"唐"],null,["享太庙乐章","萧倣","四言",["于铄丕嗣，惟帝之光。","羽籥象德，金石荐祥。","圣系无极，景命永昌。","神降上哲，维天配长。"],0,180,"唐"],["中和乐九章 歌东军第三","卢照邻","四言",["遐哉庙略，赫矣台臣。","横戈碣石，倚剑浮津。","风丘拂箨，日域清尘。","岛夷复祀，龙伯来宾。","休兵宇县，献馘天𬮱。","旆海凯入，耀辉震震。"],0,250,"唐"],["郊庙歌辞 仪坤庙乐章 雍和","员半千","四言",["孝享云毕，维彻有章。","云感玄羽，风凄素商。","瞻望神座，祗恋匪遑。","礼终乐阕，肃雍锵锵。"],0,219,"唐"],["鹡鸰颂","李隆基","四言",["伊我轩宫，奇树青葱，蔼周庐兮。","冒霜停雪，以茂以悦，恣卷舒兮。","连枝同荣，吐绿含英，曜春初兮。","蓐收御节，寒露微结，气清虚兮。","桂宫兰殿，唯所息宴，栖雍渠兮。","行摇飞鸣，急难有情，情有馀兮。","顾惟德凉，夙夜兢惶，惭化疏兮。","上之所教，下之所效，实在予兮。","天伦之性，鲁卫分政，亲贤居兮。","爰游爰处，爰笑爰语，巡庭除兮。","观此翔禽，以悦我心，良史书兮。"],0,63,"唐"],["郊庙歌辞 祭[太]社乐章 雍和","褚亮","四言",["美报崇本，严恭展事。","受露疎坛，承风启地。","絜粢登俎，醇牺入馈。","介福远流，群生毕遂。"],0,150,"唐"],["江有归舟三章 一","萧颖士","四言",["江有归舟，亦乱其流。","之子言旋，嘉名孔修。","扬于王庭，允焯其休。"],0,199,"唐"],["讲古文联句","皎然","四言",["帝出于震，文明始敷。","山岳降气，龟龙负图。","爰有书契，乃立典谟。","先知孔圣，飞步天衢。","汉承秦弊，尊儒尚学。","百氏六经，九流七略。","屈宋接武，班马继作。","或颂燕然，或赞麟阁。","降及三祖，始变二雅。","仲宣闲和，公干萧洒。","士衡安仁，不史不野。","左张精奥，嵇阮高寡。","暨于江表，其文郁兴。","绮丽争发，繁芜则惩。","词晔春华，思清冬冰。","景纯跌宕，游仙独步。","青云其情，白璧其句。","灵运山水，实多奇趣。","远派孤峰，龙腾凤翥。","陶令田园，匠意真直。","春柳寒松，不凋不饰。","江淹杂体，方见才力。","拟之信工，似而不逼。","鲍昭从军，主意危苦。","气胜其词，雅愧于古。","隐侯似病，创制规矩。","时见琳琅，惜哉榛楛。","谢朓秀发，词理翩翩。","孤标爽迈，深造精研。","惠休翰林，别白离坚。","有会必惬，无惭曩贤。","吴均颇劲，失于典裁。","竟乏波澜，徒工边塞。","彼柳吴兴，高视时辈。","汀洲一篇，风流寡对。","何逊清切，所得必新。","缘情既密，象物又真。","江总征正，未越常伦。","时合风兴，或无淄磷。","二杜繁俗，三刘琐碎。","陈徐之流，阴张之辈。","伊数公者，阃域之外。","吁此以还，有固斯郐。"],0,"x22","唐"],null,["江有归舟三章 三","萧颖士","四言",["彼游惟帆，匪风不扬。","有彬伊父，匪学不彰。","予其怀而，勉尔无忘。"],0,199,"唐"],null,["郊庙歌辞 祀圜丘乐章 寿和","褚亮","四言",["八音斯奏，三献毕陈。","宝祚惟永，晖光日新。"],{"yz":["魏徵"]},150,"唐"],["郊庙歌辞 享太庙乐章 大顺舞","郑𬘡","四言",["于穆时文，受天明命。","允恭玄默，化成理定。","出震嗣德，应干传圣。","猗欤缉熙，千亿流庆。"],0,18,"唐"],["郊庙歌辞 祀圜丘乐章 雍和","褚亮","四言",["钦惟大帝，[载]仰皇穹。","始命田烛，爰启郊宫。","云门骇听，雷鼓鸣空。","神其介祀，景祚斯融。"],0,150,"唐"],["江有归舟三章 二","萧颖士","四言",["舟既归止，人亦荣止。","兄矣弟矣，孝斯践矣。","称觞燕喜，于岵于屺。"],0,199,"唐"],["重联句一首","皎然","四言",["肃肃清院，翛翛碧鲜。","已见心远，何关地偏。","自公退食，升堂草玄。","纷纷已隔，云心澹然。"],0,"x22","唐"],null,null,["中和乐九章 歌明堂第二","卢照邻","四言",["穆穆圣皇，雍雍明堂。","左平右墄，上圆下方。","调均风雨，制度阴阳。","四窗八达，五室九房。","南通夏火，西瞰秋霜。","天子临御，万玉锵锵。"],0,250,"唐"],["郊庙歌辞 中宗祀昊天乐章 太和","佚名","四言",["恭临宝位，肃奉瑶图。","恒思解网，每轸泣辜。","德慙巢燧，化劣唐虞。","期我良弼，式赞嘉谟。"],0,"x14","唐"],["郊庙歌辞 仪坤庙乐章 永和","祝钦明","四言",["閟宫实实，清庙微微。","降格无象，馨香有依。","式昭纂庆，方融嗣徽。","明禋是享，神保聿归。"],0,175,"唐"],["祝牛宫辞","陆龟蒙","四言",["四牸三牯，中一去乳。","天霜降寒，纳此室处。","老农拘拘，度地不亩。","东西几何，七举其武。","南北几何，丈二加五。","偶楹当闲，载尺入土。","太岁在亥，馀不足数。","上缔蓬茅，下远官府。","耕耨以时，饮食得所。","或寝或卧，免风免雨。","宜尔子孙，实我仓庾。"],0,"x24","唐"],["春昼","韩偓","四言",["春融艳艳，大醉陶陶。","漏添迟日，箭减良宵。","藤垂戟户，柳拂河桥。","帘幕燕子，池塘[伯]劳。","肤清臂瘦，衫薄香销。","楚殿衣窄，南朝髻高。","河阳县远，清波地遥。","丝缠露泣，各自无憀。"],0,34,"唐"],["中和乐九章 歌公卿第八","卢照邻","四言",["蹇蹇三事，师师百僚。","群龙在职，振鹭盈朝。","丰金辉首，佩玉鸣腰。","青蒲翼翼，丹地翘翘。","歌云佐汉，捧日匡尧。","天工人代，邈邈昭昭。"],0,250,"唐"],["郊庙歌辞 武后明堂乐章 皇帝行","武则天","四言",["仰膺历数，俯顺讴歌。","远安迩肃，俗阜时和。","化光玉镜，讼息金科。","方兴典礼，永戢干戈。"],0,96,"唐"],["郊庙歌辞 周宗庙乐舞辞 咸顺","佚名","四言",["万舞咸列，三阶克清。","贯珠一倡，击石九成。","盈觞虽酌，灵坐无形。","永怀我祖，达其孝诚。"],0,"x14","唐"],["郊庙歌辞 雩祀乐章 雍和","褚亮","四言",["绀筵分彩，珤图吐绚。","风管晨凝，云歌晓啭。","肃事兰羞，虔申桂奠。","百谷斯登，万箱攸荐。"],0,150,"唐"],["咏方圆动静示李泌","张说","四言",["方如棋局，圆如棋子。","动如棋生，静如棋死。"],0,133,"唐"],["菊荣一篇五章 四","萧颖士","四言",["采采者菊，于宾之馆。","既低其枝，又弱其干。","有斐君子，是焉披玩。","良辰旨酒，宴饮无算。","怆其仳别，终然永叹。"],0,199,"唐"],["郊庙歌辞 仪坤庙乐章 坤贞","薛稷","四言",["乾道既亨，坤元以贞。","肃雍攸在，辅佐斯成。","外睦九族，内光一庭。","克生睿哲，祚我休明。","钦若徽范，悠哉淑灵。","建兹清宫，于彼上京。","缩茅以献，絜秬惟馨。","实受其福，斯乎亿龄。"],0,67,"唐"],null,["菊荣一篇五章 二","萧颖士","四言",["采采者菊，于邑之城。","旧根新茎，布叶垂英。","彼美淑人，应家之祯。","有弦既鸣，我政则平。","宜尔栋崇，必复其庆。"],0,199,"唐"],["江有枫一篇十章 五","萧颖士","四言",["粤东可居，彼吴之墟。","有田有庭，有朋有书。","有莼有鱼，君子居焉。","惟以宴醑，其乐徐徐。"],0,199,"唐"],["菊荣一篇五章 三","萧颖士","四言",["采采者菊，于邦之府。","阴槐翳柳，迩楹近宇。","彼劳者子，喧卑是处。","慨其莫知，蕴结谁语。","企彼高人，色斯遐举。"],0,199,"唐"],["江有枫一篇十章 八","萧颖士","四言",["我思震泽，菱芡幕幕。","寤寐如觌，我思剡谿。","杉筿萋萋，寤寐无迷。"],0,199,"唐"],["江有枫一篇十章 四","萧颖士","四言",["东可游矣，会之丘矣。","于山于水，于庙于寺。","于亭于里，君子游焉。","于以宴喜，其乐亹亹。"],0,199,"唐"],["嫁女诗 其九","嵩岳诸仙","四言",["上清神女，玉京仙郎。","乐此今夕，和鸣凤凰。","凤凰和鸣，将翱将翔。","与天齐休，庆流无央。"],0,109,"唐"],["郊庙歌辞·后唐宗庙乐舞辞·永平舞","崔居俭、卢文纪","四言",["庆传瓒祚，位正瑶图。","功宣四海，化被八区。","静彰帝道，动合干符。","千秋万祀，永荷昭苏。"],0,101,"唐"],["江有枫一篇十章 七","萧颖士","四言",["我友于征，彼郑之子。","如琇如英，德音孔明。"],0,199,"唐"],["赠皇甫侍御赴都八首 二","元希声","四言",["猗嗟众珍，以况君子。","公侯之胄，必复其始。","利器长材，温仪峻峙。"],0,87,"唐"],["菊荣一篇五章 五","萧颖士","四言",["岁方晏矣，霜露残促。","谁其荣斯，有英者菊。","岂微春华，懿此贞色。","人之侮我，混于薪棘。","诗人有言，好是正直。"],0,199,"唐"],["空馆夜歌 一","夷陵女郎","四言",["明月清风，良宵会同。","星河易翻，欢娱不终。","绿樽翠杓，为君斟酌。"],0,6,"唐"],["赠皇甫侍御赴都八首 其一","元希声","四言",["东南之美，生于会稽。","牛斗之气，蓄于昆溪。","有瑶者玉，连城是齐。","有威者凤，非梧不栖。"],0,87,"唐"],["郊庙歌辞 祭汾阴乐章 凯安","蒋挺","四言",["维岁之吉，维辰之良。","圣君绂冕，肃事坛场。","大礼已备，大乐斯张。","神其醉止，降福无疆。"],0,65,"唐"],["郊庙歌辞 武后享清庙乐章十首 第五饮福","佚名","四言",["爰陈玉醴，式奠琼浆。","灵心有穆，介福无疆。"],0,"x14","唐"],["赠皇甫侍御赴都八首 其六","元希声","四言",["载怀朋情，尝接闲宴。","好洽昆弟，官联州县。","如彼松竹，春荣冬蒨。","柯叶蔼然，不渝霜霰。"],0,87,"唐"],["赠皇甫侍御赴都八首 其八","元希声","四言",["金石其心，芝兰其室。","言语方间，音徽自溢。","肃子风威，严子霜质。","赠言岁暮，以保贞吉。"],0,87,"唐"],null,["池州夫子庙麟台","韦表微","四言",["二仪既闭，三象乃乖。","圣道埋郁，人心不开。","上无文武，下有定哀。","吁嗟麟兮，孰为来哉。","周虽不纲，孔实嗣圣。","诗书既删，礼乐大定。","劝善惩恶，奸邪乃正。","吁嗟麟兮，克昭符命。","圣与时合，化行位尊。","苟或乖戾，身穷道存。","于昭鲁邑，栖迟孔门。","吁嗟麟兮，孰知其仁。","运极数残，德至时否。","楚国寖广，秦封益侈。","墙仞迫阨，崎岖阙里。","吁嗟麟兮，靡有攸止。","世治则麟，世乱则麕。","出非其时，麋鹿同群。","孔不自圣，麟不自祥。","吁嗟麟兮，天何所亡。"],0,117,"唐"],["菊荣一篇五章 一","萧颖士","四言",["采采者菊，芬其荣斯。","紫英黄萼，照灼丹墀。","恺悌君子，佩服攸宜。","王国是维，大君是毗。","贻尔子孙，百禄萃之。"],0,199,"唐"],["赠皇甫侍御赴都八首 其五","元希声","四言",["绰绰夫君，是膺柱下。","准绳有望，名器无假。","宠盖伯山，气雄公雅。","立朝正色，俟我能者。"],0,87,"唐"],["郊庙歌辞 享太庙乐章 象德舞","段文昌","四言",["肃肃清庙，登显至德。","泽周八荒，兵定四极。","生物咸遂，群盗灭息。","明圣钦承，子孙千亿。"],0,235,"唐"],["赠皇甫侍御赴都八首 其四","元希声","四言",["粤在古昔，分官厥初。","刺邪矫枉，非贤勿居。","棱棱直指，烈烈方书。","苍玉鸣珮，绣衣登车。"],0,87,"唐"],null,["郊庙歌辞 祭汾阴乐章 太簇角","卢从愿","四言",["坤元载物，阳乐发生。","播植资始，品汇咸亨。","列俎棋布，方坛砥平。","神歆禋祀，后德惟明。"],0,90,"唐"],["郊庙歌辞 周朝飨乐章 康顺","佚名","四言",["鸿钧广运，嘉节良辰。","列辟在位，万国来宾。","干旌屡舞，金石咸陈。","礼容既备，帝履长春。"],0,"x14","唐"],["空馆夜歌 其三","夷陵女郎","四言",["[玉]户金缸，愿陪君王。","邯郸宫中，金石丝簧。","卫女秦娥，左右成行。","纨缟缤纷，翠眉红妆。","王欢顾盼，为王歌舞。","愿得君欢，常无灾苦。"],0,6,"唐"],["和马郎中画鹤赞","卢纶","四言",["高高华亭，有鹤在屏。","削玉点漆，乘轩姓丁。","暮云冥冥，双垂雪翎。","晨光炯炯，一直朱顶。","含音俨容，绝粒遗影。","君以为真，相期缑岭。"],0,106,"唐"],["郊庙歌辞 祭汾阴乐章 太和","王晙","四言",["於穆圣皇，六叶重光。","太原刻颂，后土疎场。","宝鼎呈符，歊云孕祥。","礼乐备矣，降福穰穰。"],0,158,"唐"],["与独孤穆冥会诗 其六 县主请迁葬诗","临淄县主","四言",["露草芊芊，颓茔未迁。","自我居此，于今几年。","与君先祖，畴昔恩波。","死生契阔，忽此相过。","谁谓佳期，寻当别离。","俟君之北，携手同归。"],0,166,"唐"],["与独孤穆冥会诗 其七 穆荅县主","临淄县主","四言",["伊彼维扬，在天一方。","驱马悠悠，忽来异乡。","情通幽显，获此相见。","义感畴昔，言存缱绻。","清江桂洲，可以遨游。","惟子之故，不遑淹留。"],0,166,"唐"],null,["郊庙歌辞 享太庙乐章 长发舞","魏征","四言",["濬哲惟唐，长发其祥。","帝命斯祐，王业克昌。","配天载德，就日重光。","本枝百代，申锡无疆。"],0,152,"唐"],null,["郊庙歌辞 封泰山乐章 太和","张说","四言",["孝敬中发，和容外彰。","腾华照宇，如升太阳。","贞璧就奠，玄灵垂光。","礼乐具举，济济洋洋。"],0,133,"唐"],["赠皇甫侍御赴都八首 其七","元希声","四言",["会合非我，关山坐违。","离鸿晓引，别叶秋飞。","𬴂骖徐动，尊饯相依。","远情超忽，岐路光辉。"],0,87,"唐"],null,["郊庙歌辞 享太庙乐章 大明舞","魏征","四言",["五纪更运，三正逓升。","勋华既没，禹汤勃兴。","神武命代，灵睠是膺。","望云彰德，察纬告征。","上纽天维，下安地轴。","征师涿野，万国咸服。","偃伯灵台，九官允穆。","殊域委赆，怀生介福。","大礼既饰，大乐已和。","黑章扰囿，赤字浮河。","功宣载籍，德被咏歌。","克昌厥后，百禄是荷。"],0,152,"唐"],["郊庙歌辞 享太庙乐章 金奏","佚名","四言",["肃肃清庙，巍巍盛唐。","配天立极，累圣重光。","乐和管磬，礼备烝尝。","永惟来格，降福无疆。"],0,"x14","唐"],null,["郊庙歌辞 享太庙乐章 永和","魏征","四言",["於穆烈祖，弘此丕基。","永言配命，子孙保之。","百神既洽，万国在兹。","是用孝享，神其格思。"],0,152,"唐"],["郊庙歌辞 享太庙乐章 永和","魏征","四言",["肃肃清祀，烝烝孝思。","荐享昭备，虔恭在兹。","雍歌撤俎，祝嘏陈辞。","用光武志，永固鸿基。"],0,152,"唐"],["郊庙歌辞 梁郊祀乐章 庆肃","张衮","四言",["笾豆簠簋，黍稷非馨。","懿兹彝器，厥德惟明。","金石匏革，以和以平。","由此无疆，期乎永宁。"],0,68,"唐"],["大蜀皇帝寿春节进尧铭舜颂二首 舜颂","贯休","四言",["高高历山，有黍有粟。","皇皇大舜，合尧玄德。","五典克从，四门伊穆。","大道将行，天下为公。","临下有赫，选贤用能。","吾皇则之，无斁无逸。","绥厥品汇，光光得一。","千辐临顶，十在随跸。","大哉大同，为光为龙。","吾皇则之，圣谋隆隆。","纳隍孜孜，攷攷切切。","六宗是禋，五瑞斯列。","排麟环凤，披香立雪。","四夷纳賮，九围有截。","昔救世师，降生竺乾。","寿春亦然，万年万年。"],0,"x30","唐"],["郊庙歌辞 祭方丘乐章 顺和","褚亮","四言",["阴祇协赞，厚载方贞。","牲币具举，箫管备成。","其礼惟肃，其德惟明。","神之听矣，式鉴虔诚。"],0,150,"唐"],["郊庙歌辞 享惠昭太子庙乐章 迎俎酌献","李逢吉","四言",["既洁酒醴，聿陈熟腥。","肃将震念，昭格储灵。","展矣礼典，薰然德馨。","愔愔管磬，亦具是听。"],0,62,"唐"],["大蜀皇帝寿春节进尧铭舜颂二首 尧铭","贯休","四言",["金册昭昭，列圣孤标。","仲尼有言，巍巍帝尧。","承天眷命，罔厥矜骄。","四德炎炎，堦蓂不凋。","永孚于休，垂衣飘飖。","吾皇则之，小心翼翼。","秉阳亭毒，不遑暇食。","土堦苔绿，茅茨雪滴。","君既天赋，相亦天锡。","德辀金镜，以圣继圣。","汉高将将，太宗兵柄。","吾皇则之，日新德盛。","朽索六马，罔坠厥命。","熙熙蓼萧，块润风调。","舞擎干羽，囿入𫇴荛。","既玉其叶，亦金其枝。","叶叶枝枝，百工允厘。","享国如尧，不疑不疑。"],0,"x30","唐"],null,["郊庙歌辞 武后大享拜洛乐章 禋和","佚名","四言",["百礼崇容，千官肃事。","灵降无兆，神凝有粹。","奠享咸周，威仪毕备。","奏夏登列，歌雍彻肆。"],0,"x14","唐"],["郊庙歌辞 善胜舞","佚名","四言",["圣祖累功，福钟来裔。","持羽执干，舞文不废。"],0,"x14","唐"],["赠皇甫侍御赴都八首 其三","元希声","四言",["道心惟微，厥用允塞。","德辉不泯，而映邦国。","静以有神，动而作则。","九臯千里，其声不忒。"],0,87,"唐"],["郊庙歌辞 后唐宗庙乐舞辞 武成舞","崔居俭","四言",["艰难王业，返正皇唐。","先天在造，却日重光。","汉绍世祖，夏资少康。","功成德茂，率祀无疆。"],0,87,"唐"],null,["郊庙歌辞 朝日乐章 雍和","佚名","四言",["晨仪式荐，明祀惟光。","神物爰止，灵晖载扬。","玄端肃事，紫幄兴祥。","福履攸假，于昭允王。"],0,"x14","唐"],["郊庙歌辞 后唐宗庙乐舞辞 文明舞","崔居俭、卢文纪","四言",["帝业光扬，皇图翕赫。","圣德孔彰，神功不测。","信及豚鱼，恩沾动植。","懿范鸿名，传之万亿。"],0,101,"唐"],["郊庙歌辞 明堂乐章 雍和","褚亮","四言",["八牖晨披，五精朝奠。","雾凝璇篚，风清金县。","神涤备全，明粢丰衍。","载絜彝俎，陈诚以荐。"],0,150,"唐"],["铸镜歌","龙护老人","四言",["盘龙盘龙，隐于镜中。","分野有象，变化无穷。","兴云吐雾，行雨生风。","上清仙子，来献圣聪。"],0,42,"唐"],null,null,["郊庙歌辞 太清宫乐章 冲和","佚名","四言",["虚无结思，钟磬和音。","歌以颂德，香以达心。","礼殊祼鬯，义感昭临。","云车至止，庆垂愔愔。"],0,"x14","唐"],["中和乐九章 歌诸王第七","卢照邻","四言",["星陈帝子，岳列天孙。","义光带砺，象著乾坤。","我有明德，利建攸存。","苴以茅社，锡以牺尊。","藩屏王室，翼亮尧门。","八才两献，夫何足论。"],0,250,"唐"]]