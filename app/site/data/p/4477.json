[["清心镜 道友问修行","马钰","杂言",["云朋询，霞友答。","性命事大，自当救拔。","免轮回、决在今生，可细搜细刷。","青莲开，白莲发。","莲花帐内，姹婴仰观俯察。","向蓬莱、路上前行，舞六么十八。"],0,"x262","元"],["清心镜 蒲城陆先生","马钰","杂言",["叹个人，破旧罐。","不顾危亡，更把道门相玩。","尚由自、不悟前愆，怎免他大难。","听予言，休著绊。","恩爱尘情，一刀两段。","销旧业、再做修持，博马风照管。"],0,"x262","元"],["清心镜 薄待诏求问","马钰","杂言",["薄待诏，能捏塑。","夸妙手奇功，不曾停住。","骋精神、漉水拖泥，为养家之故。","心还省，性还悟。","闲闲供养，本真父母。","净清中、结就神丹，跨青鸾归去。"],0,"x262","元"],["清心镜 赠小李仙","马钰","杂言",["李宜僧，僧学道。","道要玄机，日常寻讨。","讨论得、常净常清，清心意最好。","好降心，心尘扫。","扫除净，自是通明秘奥。","奥旨在、走玉飞金，金玉结丹宝。"],0,"x262","元"],["清心镜 赠马先生","马钰","杂言",["好爽利，好豁畅。","坐卧住行，逍遥坦荡。","细寻思、名利之人，怎知此味况。","向闲中，搜修养。","锻炼一颗，神珠晃朗。","算三次、海变桑田，是仙家一饷。"],0,"x262","元"],["清心镜 赠马守清","马钰","杂言",["马姑姑，后归去。","日用无为，清闲养素。","休讲论、女姹婴娇，更虎龙斗处。","屏尘缘，得真趣。","火灭烟消，气神坚固。","内云游、功满三田，上蓬莱仙路。"],0,"x262","元"],["清心镜 赠马彦寿","马钰","杂言",["两亲家，各开悟。","把从前爱底，观如猛虎。","认无为、清净家风，并无些作做。","不悭贪，不喜怒。","调息均匀，绵绵内补。","待一朝、行满功成，共携云归去。"],0,"x262","元"],["清心镜 赠王庵主","马钰","杂言",["养家时，甚情况。","被妻男逼得，有如心恙。","竞利名、来往奔波，忒劳嚷劳嚷。","学道来，常坦荡。","除性命二字，别无妄想。","占清闲、自在逍遥，好豁畅豁畅。"],0,"x262","元"],["清心镜 赠长安李先生","马钰","杂言",["李先生，忒执拗。","全真堂下，最难训教。","学修行、不尚扶犁，道我咱偏好。","再三劝，再四告。","认取五色祥云，自然耕道。","种紫芝、灿烂灵光，便得归蓬岛。"],0,"x262","元"],["清心镜 赠韦先生","马钰","杂言",["公清，火戏虚。","寂寂虎随龙憩。","莲绽、胜似群花，缘行周济。","悟回头，真自喜。","诀无为清净，自然通秘。","自得、休别追求，人免不讳。"],0,"x262","元"],["清心镜 赠刘小官","马钰","杂言",["一青牛，二条尾。","三双眼儿，仰观俯视。","四个蹄、雪白如银，五方中嬉戏。","六欲七情俱总废。","八味琼浆，饮来光明遍体。","九鼎内、变作神丹，十分功圆备。"],0,"x262","元"],["清心镜 赠刘先生","马钰","杂言",["个青牛，引白犊。","向曹溪深处，往来相逐。","更时时、卧月眠云，疏凡间草木。","餐三阳，投九畜。","子母温柔，免劳看牧。","待一朝、得赴蓬瀛，显本来面目。"],0,"x262","元"],["清心镜 赠华亭十殿试","马钰","杂言",["尹虞卿，樊祖训。","明仲季蒙，子恂子润。","汉卿共、信仲官人，乃清河一姓。","程德容，李汉臣。","十个吾侪，尽皆文俊。","劝诸公、名利灰心，早修完性命。"],0,"x262","元"],["清心镜 赠孙可道","马钰","杂言",["孙先生，能放下。","兀兀腾腾，通真弃假。","处心与、万物无私，略无些谄诈。","乐清贫，得清雅。","逗引灵童，惺惺洒洒。","到如今、好结善缘，水云游行化。"],0,"x262","元"],["清心镜 赠老程先生","马钰","杂言",["这程公，顿然悟。","家有六子，六贼之数。","细寻思、总是冤家，便不宜团聚。","弃纱巾，冠戴取。","捉住马猿，易调龙虎。","待一朝、丹药灵灵，跨祥鸾归去。"],0,"x262","元"],["清心镜 赠严先生","马钰","杂言",["大丈夫，真烈士。","斩钉截铁，一心无二。","做修行、誓不还乡，遇危难发志。","清净中，玄妙至。","日月交光，虎龙参时。","饮刀圭、保养神丹，应重阳奥旨。"],0,"x262","元"],["清心镜 赠灵一子","马钰","杂言",["何先生，听仔细。","未到蓬头，且梳丫髻。","亦未至、求乞残馀，待悟来许你。","得定慧，入初地。","凭仗无染无著，无为活计。","心清净、通妙通玄，得永成仙契。"],0,"x262","元"],["清心镜 赠灵阳子李大乘","马钰","杂言",["灵阳子，来告别。","送行不似，相迎时节。","听予嘱、游必有方，待孀毋紧切。","我人除，烟火灭。","莫忘初志，旋添决烈。","行大道、开阐亘初，邀清风明月。"],0,"x262","元"],["清心镜 赠京兆周七官","马钰","杂言",["周官人，家豪富。","长安通检，最为上户。","十年间、兴废何如，无札锥去处。","叹利名，不坚固。","使我灰心，转生开悟。","行大道、一志无移，修不来不去。"],0,"x262","元"],["清心镜 赠侯明一","马钰","杂言",["侯姑姑，心开悟。","六旬有九，才方修补。","众人言、晚了时光，马风道未暮。","气不断，神可固。","先把马猿，用功擒住。","自然得、性命停停，管成仙归去。"],0,"x262","元"],["清心镜 赠益都府李进","马钰","杂言",["陇西公，名去病。","表德去华，道号去尘最紧。","待悟来、去尽般般，当修完性命。","心常清，意常净。","法名更作，谷神相应。","号通一、亦是相宜，字仙卿相称。"],0,"x262","元"],["清心镜 赠铁李先生","马钰","杂言",["陇西公，苦得别。","六月炉头，掉锤打铁。","养浑家、都要清闲，独自受炙熁。","火烧疮，汗滴血。","万苦千辛，何时是彻。","马风风、诱引回头，向道门中休歇。"],0,"x262","元"],["清心镜 赠寂然子","马钰","杂言",["修行人，听子细。","斋食不可，美之又美。","更何须、异馔多般，但一味而已。","恬淡中，常遂意。","万神调畅、姹婴欢喜。","得自然、结就金丹，占蓬瀛仙位。"],0,"x262","元"],["清心镜 赠鄠县小杨仙","马钰","杂言",["修行人，先禁眼，见他妇女，不宜顾盼。","牢擒捉、意马心猿，休缓缦缓缦。","我人除，事情简。","清贫柔弱，逍遥散诞。","谨遵依、国法天条，永不犯不犯。"],0,"x262","元"],["清心镜 赠裴大器","马钰","杂言",["修行人，要心善。","奈业障相魔，裂他不转。","十二时、马劣猿颠，没巴避恶念。","办坚志，常锻炼。","剿除绝迹，永无征战。","气神和、清净丹成，得胎仙出现。"],0,"x262","元"],["清心镜 赠薛道清","马钰","杂言",["做修行，细搜刷。","清净家风，便是大乘妙法。","下无为、无作真功，心镜上𢫬抹。","自然明，自然达。","把九玄七祖，尽行救拔。","向蓬瀛、坦荡逍遥，冠裳似菩萨。"],0,"x262","元"],["清心镜 赠鞠得一","马钰","杂言",["河州鞠，听予说。","把般般术法，便当一撇。","论自然、大道无为，岂在乎细捏。","清心镜，常莹彻。","照破万缘，无生无灭。","这本来、一点元明，便朗如秋月。"],0,"x262","元"],["清心镜 赠魏害风","马钰","杂言",["风姑姑，怀秘奥。","意净心清，头头是道。","自然得、真乐真欢，并无些烦恼。","不谄诈，不倨傲。","玉花丛里，结成金宝。","便等候、紫诏来宣，应通明仙号。"],0,"x262","元"],["黄鹤洞中仙","马钰","杂言",["终日驾盐车，鞭棒时时打。","自数精神久屈沉，如病马。","怎得优游也。","伯乐祖师来，见后频嗟呀。","巧计多方赎了身，得志马。","须报师恩也。"],0,"x262","元"],["黄鹤洞中仙 咏瓦罐继重阳韵","马钰","杂言",["瓦罐真真实，须假良工造。","十二时中下火烧。","自有三光照。","大肚物能容，圆正通明道。","清净法身牢护持，不敢破坏了。"],0,"x262","元"],["黄鹤洞中仙 俗卜算子继重阳韵","马钰","杂言",["得遇无思算。","自是能明彖。","极谢风仙特地来，把我专专唤。","要脱轮回难，锻炼神光灿。","真乐真欢永没愁，愿作云霞伴。"],0,"x262","元"],["黄鹤洞中仙 继重阳韵","马钰","杂言",["因遇出嚣尘，终日常颠耍。","狂舞狂歌任自然，无意马。","收得灵灵帕。","真水涌来高，真火降来下。","黄鹤洞中仙要成，扶风马。","两曜交光射。"],0,"x262","元"],["黄鹤洞中仙 继重阳韵","马钰","杂言",["清将功夫做，自是生玄露。","密洒灵苗溉紫芝，渐觉气神住。","谨谨须当诉。","决定参随去。","物外勤修大药成，同上蓬莱路。"],0,"x262","元"],["黄鹤洞中仙 继重阳韵","马钰","杂言",["大悟明明也。","大智闲闲也。","大道行行应自然，风风马。","永永逍遥也。","大水高高也。","大火炎炎也。","大药辉辉晃宝瓶。","真真马。","得得长生也。"],0,"x262","元"],["黄鹤洞中仙 继重阳韵","马钰","杂言",["一个本来容，妙手应难尽。","风貌清严神彩英，无意马。","永永安闲也。","浮利与浮名，心上何曾挂。","黄鹤洞中仙子成，乘云马。","出入常游冶。"],0,"x262","元"],["黄鹤洞中仙 继重阳韵","马钰","杂言",["不敢心狂走。","极谢师真守。","芋栗今番六次餐，美味常甘口。","不作东牟叟。","不恋东风柳。","参从风仙物外游，共饮长生酒。"],0,"x262","元"],["黄鹤洞中仙 继重阳韵","马钰","杂言",["拯救扶风活。","逗引扶风耍。","故遣扶风颠更狂。","扶风马。","家累扶风舍。","业火扶风洒。","云鹤扶风跨。","这个扶风灵更灵，扶风马。","真称扶风也。"],0,"x262","元"],["黄鹤洞中仙 继重阳韵","马钰","杂言",["传得清虚剑。","心内深深点。","木上金丝来往牵。","马风占。","更把风摇飐。","卦象常推渐。","功行时时检。","黄鹤沿中仙要成，马风赡。","日有真灵验。"],0,"x262","元"],["黄鹤洞中仙 继重阳韵","马钰","杂言",["火院须当远。","尘事难为染。","因遇风仙弃冤亲，做个投真马，得得超彼岸。","既达逍遥岸。","炼气如素练。","专下工夫分假真，做个惺惺马。","悟道何愁晚。"],0,"x262","元"],["黄鹤洞中仙 继重阳韵","马钰","杂言",["身是精神店。","无个人曾叹。","舍漏垣颓主翁行，也不见他马，怎得闻嘶喊。","我悟尘头偃。","富贵无心羡。","离坎相交玄更玄，搬运动也马，来往如同战。"],0,"x262","元"],["黄鹤洞中仙 继重阳韵","马钰","杂言",["知味又闻香，因得非凡遇。","更说祖师两个来，教我修行赋。","一志访秦川，乡井宁回觑。","火灭烟消心死灰，名挂神仙簿。"],0,"x262","元"],["黄鹤洞中仙 继重阳韵前后各喝马一声","马钰","杂言",["癸卯到人间，本是非凡兔。","因为玲珑罚下来，马氏住。","愿再修行做。","复遇害风仙，传得深深趣。","黄鹤洞中仙道成，马风去。","直指蓬莱路。"],0,"x262","元"],["黄鹤洞中仙 继重阳韵藏头","马钰","杂言",["里悟传灯，炼真如镜。","把光辉，满载驱风省。","视风轮莹。","内显琼釭面。","灵童静。","肯婪尘复载驰。","风惺月仙家景。"],0,"x262","元"],["黄鹤洞中仙 继重阳韵藏头","马钰","杂言",["日风仙活。","我惺惺洒。","去关西阐妙玄，么马。","宅须当舍。","利子无价。","事心难挂。","德方而著德圆，口马。","月齐高下。"],0,"x262","元"],["登仙门","马钰","杂言",["难也难也。","舍家难也。","绝爱憎，屏尘难也。","处无为清静，有始终难也。","譬如死，又何难也。","论玄元，谈微妙，要人听也。","但小童，肯来询也。","便须当，开言路，与其进也。","我不能，保其往也。"],0,"x262","元"],["登仙门","马钰","杂言",["师也师也。","重阳师也。","处玄机，静中清也。","起金莲，玉花社，有谁知也。","化人人，渐归道也。","这扶风，非开悟，亦非愚也。","辨假真，稍能明也。","细寻思，心豁畅，略无疑也。","想师范，没人过也。"],0,"x262","元"],["超彼岸 继重阳韵","马钰","杂言",["家缘不藉。","遇风仙传得，修补清虚之架。","懒里寻慵，慵里更寻闲暇。","上街来，除我相，先乞化。","木人箭指云溪射。","觉正中周，天通明八卦。","见粒神丹，灿烂果然无价。","水云游，访秦川，行教化。"],0,"x262","元"],["遇仙亭 继重阳韵","马钰","杂言",["喜喜蓬头。","达达根由。","永永誓不贪求。","渐渐归于正觉，申申燕处优游。","万万尘缘识破，专专志做持修。","遇遇风仙传口诀，疑疑涤尽更何搜。","灿灿不昏幽。","玉玉金光结，心心愿做渡人舟。","累累功成行满，真真去访瀛洲。"],0,"x262","元"],["道成归","马钰","杂言",["阮郎归改道成归。","修行人喜知。","松峰影里乐希夷。","何须唱艳词。","姹婴动，虎龙随。","云耕坎与离。","三千功满