[["望江南 啜茶十咏 其一","董元恺","词",["茶坞胜，阳羡郁层峦。","月峡涧流生雀舌，石岩雾晓出龙团。","仙掌片峰寒。"],0,"x435","清"],["望江南 啜茶十咏 其二","董元恺","词",["茶笋别，罗岕胜乌程。","庙后结花垂绿脚，渚前分露种红英。","秀色带烟轻。"],0,"x435","清"],["望江南 啜茶十咏 其三","董元恺","词",["茶籯满，叶叶占先春。","翠霭撷齐双鬓冷，青丝笼就两枪新。","衣惹暗香尘。"],0,"x435","清"],["望江南 啜茶十咏 其四","董元恺","词",["茶舍小，石径卧云斜。","斑驳苔生青嶂影，婆娑树老绿阴遮。","竹里看煎茶。"],0,"x435","清"],["望江南 啜茶十咏 其五","董元恺","词",["茶灶冷，溪鸟逐烟光。","瑟瑟波沉霞脚碎，轻轻色泛乳花香。","翠釜合先尝。"],0,"x435","清"],["望江南 啜茶十咏 其六","董元恺","词",["茶焙暖，沆瀣碧波融。","编竹候随文武火，开缄叶里建城笼。","一纸隔春风。"],0,"x435","清"],["望江南 啜茶十咏 其七","董元恺","词",["茶泉沸，第二擅中泠。","旋沫翻成鱼眼动，腾波声作老龙听。","涧底觅樵青。"],0,"x435","清"],["望江南 啜茶十咏 其八","董元恺","词",["茶瓯洁，碧碗醉春醪。","翠影香浮卢氏碗，素瓷圆胜谢家窑。","丝柳拂长条。"],0,"x435","清"],["望江南 啜茶十咏 其九","董元恺","词",["茶品绝，缀玉复含珠。","三十绫文酬博士，两篇《茶录》问君谟。","疏月下庭梧。"],0,"x435","清"],["望江南 啜茶十咏 其十","董元恺","词",["茶候静，帘卷日初长。","片甲味分蝉翼薄，丹丘阴益簟纹凉。","应唤醒羲皇。"],0,"x435","清"],["望江南 其十一 红桥春游词","董元恺","词",["红桥好，联骑出城𬮱。","映日游丝萦曲径，扑天飞絮惹香尘。","胜地占芳辰。"],0,"x435","清"],["望江南 其十二 红桥春游词","董元恺","词",["虹桥好，挈伴踏青游。","紫陌骄嘶金勒马，碧波斜蘸绿杨楼。","高会尽风流。"],0,"x435","清"],["望江南 其十三 红桥春游词","董元恺","词",["虹桥好，潋滟画栏明。","曲折湘文摇簟縠，玲珑梵字漾帘旌。","高下渌波平。"],0,"x435","清"],["望江南 其十四 红桥春游词","董元恺","词",["虹桥好，万树带垂杨。","新笋穿泥云覆屋，疏篱列障竹为墙。","魂断旧雷塘。"],0,"x435","清"],["望江南 其十五 红桥春游词","董元恺","词",["虹桥好，摇曳酒旗红。","小立垂丝人语细，低回促坐笑声浓。","莫放绿樽空。"],0,"x435","清"],["望江南 其十六 红桥春游词","董元恺","词",["红桥好，野店擅行厨。","细切银丝盐下豉，新调玉鲙笋如酥。","𫗦醊足欢呼。"],0,"x435","清"],["望江南 其十七 红桥春游词","董元恺","词",["虹桥好，画舫树中移。","万缕轻黄珠户映，半篙柔绿绣帘垂。","春昼日迟迟。"],0,"x435","清"],["望江南 其十八 红桥春游词","董元恺","词",["虹桥好，听曲和鸾箫。","舞榭丝牵傀儡动，兰舟风送管弦遥。","翠袖暗相招。"],0,"x435","清"],["望江南 其十九 红桥春游词","董元恺","词",["虹桥好，绕径印苍苔。","纨扇慢摇遮鬓影，玉纤小摘落青梅。","伫立共徘徊。"],0,"x435","清"],["望江南 其二十 红桥春游词","董元恺","词",["虹桥好，懊恼是言归。","好鸟啼春相唤住，浓花对酒欲争飞。","客思正依依。"],0,"x435","清"],["望江南 其二十一 青墩初夏词","董元恺","词",["青墩好，别业号苍梧。","万树浓荫含雾雨，满园空翠映菰蒲。","一幅辋川图。"],0,"x435","清"],["望江南 其二十二 青墩初夏词","董元恺","词",["青墩好，四面一溪遥。","丝缕风垂青卷幔，玻瓈水涨绿平桥。","楼阁晕春潮。"],0,"x435","清"],["望江南 其二十三 青墩初夏词","董元恺","词",["青墩好，一苇放中流。","星渚频移天上坐，岸花飞送镜中游。","诗酒任沉浮。"],0,"x435","清"],["望江南 其二十四 青墩初夏词","董元恺","词",["青墩好，乐事胜花朝。","旁舍煆泥载茉莉，小鬟敲竹护樱桃。","长日尽逍遥。"],0,"x435","清"],["望江南 其二十五 青墩初夏词","董元恺","词",["青墩好，曲院扇和风。","玫瑰斜簪云鬓紫，蔷薇高架锦屏红。","裁剪夺天工。"],0,"x435","清"],["望江南 其二十六 青墩初夏词","董元恺","词",["青墩好，绝胜浣花溪。","绕砌翅翻蝴蝶舞，映山血染杜鹃啼。","烟景忽凄迷。"],0,"x435","清"],["望江南 其二十七 青墩初夏词","董元恺","词",["青墩好，趺坐荫休篁。","种擅乌椑收柿叶，丝牵青蔓种菱塘。","拂袖满幽香。"],0,"x435","清"],["望江南 其二十八 青墩初夏词","董元恺","词",["青墩好，杖履入平芜。","旧雨一枝鸠唤妇，新巢千尺鹤将雏。","相劝倒琼苏。"],0,"x435","清"],["望江南 其二十九 青墩初夏词","董元恺","词",["青墩好，对景且衔杯。","粉节新涂抽紫箨，红盐初下摘青梅。","怀抱一时开。"],0,"x435","清"],["望江南 其三十 青墩初夏词","董元恺","词",["青墩好，荇藻积空明。","跃入锦鳞堪上箸，网来文雉足调羹。","肠断一声莺。"],0,"x435","清"],["潇湘神 其一 四女祠","董元恺","词",["四女祠。","四女祠。","白发红颜未嫁时。","但使宁亲成孝子，不愁天下少男儿。"],0,"x435","清"],["潇湘神 其二 四女祠","董元恺","词",["杨柳枝。","杨柳枝。","碧瓦飘风散雨丝。","一树棠梨春社后，千年留得几行诗。"],0,"x435","清"],["捣练子 其一 和内寄原韵","董元恺","词",["愁脉脉，水盈盈。","握手临歧无限情。","揾着啼痕双袖泪，笑从花里送郎行。"],0,"x435","清"],["捣练子 其二 和内寄原韵","董元恺","词",["江树隔，岭云开。","历尽东风未遣回。","惆怅五更孤枕上，与卿刚在梦中来。"],0,"x435","清"],["捣练子 其三 和内寄原韵","董元恺","词",["消永夜，剔残缸。","暖语分明向绮窗。","留得别时千点泪，罗衣犹未浣春江。"],0,"x435","清"],["忆王孙 其一 江上","董元恺","词",["一江江水阅兴亡。","花月春江事渺茫。","江上风吹雁两行。","泪沾裳。","江北江南总断肠。"],0,"x435","清"],["忆王孙 其二 小鬟捧茶","董元恺","词",["二泉初汲碾旗枪。","火沸松声路沁香。","郑重双鬟手自将。","敢先尝。","春风滋味怯萧郎。"],0,"x435","清"],["如梦令 其一 梦后","董元恺","词",["枝上啼鹃如诉。","唤起离愁无数。","曲径古云深，隔岸梦中来路。","回顾。","回顾。","月约花阴西度。"],0,"x435","清"],["如梦令 其二 闺情，和李易安韵","董元恺","词",["忽地披衣起坐。","梦也分明真个。","梦后更凄凉，生怕梦来难躲。","无那。","无那。","守着影儿伴我。"],0,"x435","清"],["如梦令 其三 闺别，和王修微韵","董元恺","词",["半枕别时残梦。","一纸离愁新咏。","昨夜月明中，几处小桥霜冻。","相送。","相送。","泪湿轻衫寒重。"],0,"x435","清"],["归自谣 归梦","董元恺","词",["东风急。","携手罗帏情脉脉。","分明悄语莺花夕。","梦回依旧关山隔。","空相忆。","春云遮断春归迹。"],0,"x435","清"],["定西番 春暮，集唐词","董元恺","词",["隐映画屏开处，莺对语，蝶飞狂。","惜韶光。","罗袂从风轻举，波影满池塘。","高卷水晶帘额，衬斜阳。"],0,"x435","清"],["长相思 其一 闺忆","董元恺","词",["梅花风。","楝花风。","二十四番花信风。","花开花落中。","吴江东。","楚江东。","潮落春江东复东。","春魂一点通。"],0,"x435","清"],["长相思 其二 闺忆","董元恺","词",["晓云峰。","暮云峰。","郎处云深第几峰。","愁来簇两峰。","水连空。","月横空。","刚得相逢总是空。","相逢怕梦中。"],0,"x435","清"],["相见欢 鸳鸯","董元恺","词",["珍禽两两回翔。","狎芳塘。","惹得多情儿女，绣罗裳。","嗔伊并，惊伊散，忽分行。","刚到荷花深处，又双双。"],0,"x435","清"],["望梅花 岭南至日，梅花盛开","董元恺","词",["何事粤东无雪。","万树垂垂先白。","一线初添疏影夕。","零乱冷烟残月。","瘐岭经年驿使隔。","谁寄江南消息。"],0,"x435","清"],["醉太平 其一 旧游","董元恺","词",["红楼卧游。","青楼梦游。","旧游重倚楼头。","卷东风上钩。","春山欲浮。","秋波欲流。","妆成春影横秋。","对花枝坐愁。"],0,"x435","清"],["醉太平 其二 花间","董元恺","词",["花奴雁奴。","花姑鼠姑。","花间鸟唤提壶。","倩花间酒沽。","龙刍鹿庐。","麟符象弧。","酣来斫地歌呼。","识人间故吾。"],0,"x435","清"],["醉太平 其三 钱歌","董元恺","词",["榆钱绿钱。","苔钱碧钱。","圆如锦石青钱。","弄芙蕖小钱。","流钱雨钱。","连钱影钱。","小斋夜落金钱。","值东风几钱。"],0,"x435","清"],["醉太平 其四 钱歌","董元恺","词",["郑钱沈钱。","缗钱侧钱。","诗书争似囊钱。","看空囊一钱。","床头百钱。","杖头百钱。","张公万选青钱。","选刘公大钱。"],0,"x435","清"],["生查子 其一 闺怨","董元恺","词",["送郎上车轮，车远郎亦远。","愿作车后尘，处处随郎转。","郎行辙不归，妾泪不离眼。","看取眼泪痕，与辙谁深浅。"],0,"x435","清"],["生查子 其二 闺情，集唐诗","董元恺","词",["欲试一寸心，试妾与君泪。","寄向故园流，空望去时水。","不消出门行，想君发扬子。","错认几人船，日暮情何已。"],0,"x435","清"],["生查子 其三 闺情，集唐诗","董元恺","词",["应为别离多，愁眠罗帐晓。","是妾断肠时，谁知妾怀抱。","娇郎痴若云，夜夜梦中到。","春意罢帘栊，暗飞萤自照。"],0,"x435","清"],["生查子 其四 闺情，集唐诗","董元恺","词",["悲妾似花身，能得几时好。","空将泪见花，花落知多少。","不复理残机，织锦心草草。","频放剪刀声，双眉灯下扫。"],0,"x435","清"],["醉公子 其一 闺情，集唐诗","董元恺","词",["独坐裁新锦。","天寒剪刀冷。","方觉泪难裁。","丹心一寸灰。","晓卧半床月。","月落子规歇。","归在落花前。","春风正可怜。"],0,"x435","清"],["醉公子 其二 闺情，集唐诗","董元恺","词",["破得东风恨。","畏人相借问。","还恐是愁中。","银床一半空。","倘随明月去。","月满门前路。","犹有万重思。","归心梦独知。"],0,"x435","清"],["醉公子 其三 闺情，集唐诗","董元恺","词",["落花相与恨。","即是春风尽。","不敢怨春风。","细看枝上红。","遥将一点泪。","两处滴池水。","池水晓来深。","长悬零落心。"],0,"x435","清"],["醉公子 其四 闺情，集唐诗","董元恺","词",["袅袅城边柳。","骀荡郎知否。","争取最长条。","相思一水遥。","相思杳如梦。","莫引西风动。","剪蜡泪争流。","残灯照卧幽。"],0,"x435","清"],["春光好 过沉香亭址","董元恺","词",["荒亭北，夕阳空。","晚烟笼。","倾国名花何处，只春风。","自是羽衣尘土，采苹休怨楼东。","一样梨花寒食夜，翠微中。"],0,"x435","清"],["昭君怨 昭君塞外命重制琵琶，曰浑不似","董元恺","词",["莫谓汉宫人巧。","便有琵琶难肖。","毳帐草萧萧。","梦魂遥。","薄命玉容如此。","值得一声情死。","边月下祈连。","影堪怜。"],0,"x435","清"],["抛球乐 美人蹴鞠","董元恺","词",["香阁妆成约伴来。","斜穿鞠域映楼台。","红巾吹向红帮乱，波影轻摇鬓影开。","猛被檀奴觑，潜匿花阴去不回。"],0,"x435","清"],["女冠子 其一 登穹窿山，赠施炼师","董元恺","词",["穹窿飘渺。","碧海三山瑶草。","剑光寒。","玉斧滋晴露，琼花护醮坛。","灵随龙竹引，香逐凤箫残。","隐现金天掌，是毫端。"],0,"x435","清"],["女冠子 其二 闺人礼佛","董元恺","词",["宝莲幢畔。","清晓纤纤频盥。","到香台。","唵叭随烟结，菩提带树开。","粉痕侵贝叶，心字印炉灰。","更把鹦哥教，念如来。"],0,"x435","清"],["点绛唇 其一 春归","董元恺","词",["杜宇年年，声声只唤春归去。","春归何处。","且把帘垂住。","帘卷东风，春竟穿帘去。","留难住。","放春归去。","来岁春来处。"],0,"x435","清"],["点绛唇 其二 闺人语燕，和李清照韵","董元恺","词",["燕子双双，阿谁系得红丝缕。","妆台衔去。","落尽香泥雨。","好向郎边，细语相思绪。","归来处。","潇湘烟水，珍重江南路。"],0,"x435","清"],["浣溪沙 其一 春闺","董元恺","词",["莺语听残春院晴。","屏云倚其晚寒凝。","黛痕愁入远峰青。","庭满落花香寂寂，声和玉漏夜清清。","轻红拂萝晓来醒。"],0,"x435","清"],["浣溪沙 其二 回前调","董元恺","词",["醒来晓梦拂红轻。","清清夜漏玉和声。","寂寂香花落满庭。","青峰远入愁痕黛，凝寒晚共倚云屏。","晴院春残听语莺。"],0,"x435","清"],["浣溪沙 其三 春闺，集唐词","董元恺","词",["绮陌春深翠袖香。","水纹簟冷画屏凉。","月窗花径梦悠飏。","将见客时微掩敛，几回拼却又思量。","此情谁会倚斜阳。"],0,"x435","清"],["菩萨蛮 闺情，集唐诗","董元恺","词",["闲倚绣帘吹柳絮。","已成残梦随君去。","明月为谁圆。","情教细语传。","春风别有意。","凭添两行泪。","怅望此何时。","只应君自知。"],0,"x435","清"],["卜算子 秋闺，集唐诗","董元恺","词",["花点石榴裙，虫响灯光薄。","心怯空房不忍归，风动秋千索。","望月想蛾眉，菊露凄罗幕。","几度金刀试剪裁，红泪双双落。"],0,"x435","清"],["减字木兰花 其一 浴温泉","董元恺","词",["九龙汤沸。","范阳水设鱼龙戏。","洗罢奚儿。","翻作奚儿洗马池。","仓皇西幸。","马嵬坡下长生竟。","河水汤汤。","南内无人有寿王。"],0,"x435","清"],["减字木兰花 其二 浴温泉","董元恺","词",["夜深清影。","芳草不生泉欲冷。","绣岭花开。","尽逐东流去不回。","梨园按曲。","羯鼓声中鼙鼓蹙。","红粉成灰。","村笛还吹阿滥堆。"],0,"x435","清"],["巫山一段云 悼友","董元恺","词",["雨洒空床笛，风号败壁琴。","泉台一别信沉沉。","肠断到而今。","把酒魂应绝，题诗涕不禁。","孤灯悄向梦中寻。","路隔小窗阴。"],0,"x435","清"],["诉衷情 金陵春望","董元恺","词",["孝陵衰草下牛羊。","春风绕建康。","一片降帆过眼，短笛倚斜阳。","君莫问，石头冈。","寝园荒。","铁锁沉沉，金凫寂寂，玉树茫茫。"],0,"x435","清"],["谒金门 湖舫同内泛雨","董元恺","词",["烟舫织。","荡破满湖轻碧。","一片楼台空翠滴。","两峰连树失。","帘外荷香堪裛。","槛底鱼游争识。","钗漾菱花鬟影湿。","镜里随风入。"],0,"x435","清"],["好事近 薰笼","董元恺","词",["数缕气氤氲，微透玲珑湘竹。","小玉频添鹊脑，比衔花箫局。","半薰绣幔半笼裙，尽放馀烟续。","一任帘前被底，长共香奁宿。"],0,"x435","清"],["一落索 咏风鸢","董元恺","词",["鸷鸟凭空而起。","云霄堪致。","青春一线上青天，禁得无声堕地。","怪底轻狂可喜。","欲飞还止。","十年前事忆儿童，此日依然故纸。"],0,"x435","清"],["忆秦娥 其一 湖楼和内","董元恺","词",["妆楼悄。","锦塘风送闻啼鸟。","闻啼鸟。","湖光如梦，乱云缭绕。","六桥裙带飘芳草。","两峰高画春山小。","春山小。","珠帘初卷，画船多少。"],0,"x435","清"],["忆秦娥 其二 不归","董元恺","词",["伤心极。","年年惯作天涯客。","天涯客。","留他不住，送他不得。","不如归去啼声咽。","不归休记归时节。","归时节。","未容言语，又成离别。"],0,"x435","清"],["更漏子 其一 寄忆","董元恺","词",["旧愁人，新愁月。","同是黄昏时节。","人不见，月偏明。","除非倩梦寻。","寒衾拥。","愁难送。","不到四更无梦。","莲漏滴，乳鸦啼。","梦儿能几时。"],0,"x435","清"],["更漏子 其二 闺情，集唐词","董元恺","词",["雨初晴，帘半卷。","叠损罗衣金线。","绡幌碧，粉屏空。","灯花结碎红。","思无穷，情未了。","一炷后庭香袅。","春如剪，雨如丝。","风摇夜合枝。"],0,"x435","清"],["更漏子 其三 闺情，集唐词","董元恺","词",["绣帘垂，幽沼渌。","倚遍阑干几曲。","苹叶软，草烟低。","绿窗残梦迷。","玉纤轻，凤箫歇。","梦觉半床残月。","兰烛灺，柳条空。","此情千万重。"],0,"x435","清"],["更漏子 其四 闺情，集唐词","董元恺","词",["晚妆残，春态浅。","远岫参差迷眼。","千万恨，在心头。","秋波横欲流。","燕双双，人悄悄。","残月光沉树杪。","烟雾冷，画屏幽。","吴山点点愁。"],0,"x435","清"],["清平乐 端午闺中词  其一 健人","董元恺","词",["缕丝裁绢。","小小人名健。","但得一心常缱绻。","两好时时对面。","临风故作娉婷。","看花想像仪形。","任取钗横鬓乱，年年祝向芳龄。"],0,"x435","清"],["清平乐 其二 茧虎","董元恺","词",["冰蚕细茧。","纤手亲裁剪。","刻画爪牙眉与眼。","一笑从风细转。","有时彩笔描真。","何须插艾为人。","飘向玉钗头上，儿童竞取相亲。"],0,"x435","清"],["清平乐 其三 长命缕","董元恺","词",["谁能续命。","五色交相映。","浪说辟兵还压胜。","茧馆珠囊堪赠。","不须绕户高悬。","料应妆臂同缠。","愿取一丝一岁，与郎情绪绵绵。"],0,"x435","清"],["清平乐 其四 辟兵符","董元恺","词",["心前笑抚。","神印穿金缕。","销得五兵刚二五。","好共钗头艾虎。","依依插鬓宜春。","翩翩佩带宜人。","全仗赤符厮守，不教胆怯空庭。"],0,"x435","清"],["清平乐 其五 绫包角黍","董元恺","词",["萦丝楚粽。","巧借针神缝。","杂俎轻镂花影动。","却比菰蒲郑重。","陋他九子殊名。","随他百索殊形。","好是餐他秀色，鬓边袅袅婷婷。"],0,"x435","清"],["清平乐 其六 菖蒲葫芦","董元恺","词",["花阴午直。","旋把菖蒲刻。","依样雕锼纤指劈。","细认灵根九节。","五丝撷向霓裳。","一樽醉泛瑶觞。","共喜兰汤浴罢，携来倍觉芬芳。"],0,"x435","清"],["误佳期 湖楼月夜，和龚芝麓先生韵","董元恺","词",["月色初穿帘幕。","掩映玉人绰约。","满身花影倩扶持，几处清砧作。","香销玉臂寒，雾冷金钗落。","醉擘银筝信手弹，一曲秋云薄。"],0,"x435","清"],["相思引 烧香曲","董元恺","词",["暖语红窗体自芬，笑添沉水更氤氲。","语香花气，常共夜深闻。","一缕轻烟遮不住，剪来银叶衬还薰。","炙成心字，双守鹊炉温。"],0,"x435","清"],["忆少年 春闺","董元恺","词",["春尘如雨，春风如醉，春光如梦。","春花独对也，只春波微动。","剪破春阴春色好，更春情落红催送。","萋萋春草碧，恰补春愁空。"],0,"x435","清"],["阮郎归 窗前","董元恺","词",["簸钱年纪只些些。","垂鬟鬓未鸦。","别来几度海桐花。","窗前细认他。","奁镜畔，绣帘遮。","妆成覆额纱。","一枝春色落谁家。","眉边散晓霞。"],0,"x435","清"],["画堂春 其一 蝴蝶花","董元恺","词",["春烟春雨染浓芳。","丝丝绣出春光。","映阶碧草学轻狂。","舞遍东墙。","栩栩欲迷庄子，翩翩胜拓滕王。","穿花潜入此花藏。","细认钗梁。"],0,"x435","清"],["画堂春 其二 十姊妹","董元恺","词",["天然一色绮罗丛。","妆成并倚东风。","秦姨总与虢姨同。","玉质烟笼。","馥馥幽香密蕊，姗姗淡白轻红。","相携竞入翠薇宫。","不妒芳容。"],0,"x435","清"],["画堂春 其三 荷花蔷薇","董元恺","词",["东风无力锦屏遮。","依稀露软烟斜。","繁华满径拂窗纱。","翠剪明霞。","高处牵衣欲语，低边弄影交加。","一帘月色浸荷花。","绿水人家。"],0,"x435","清"],["海棠春 闺词，和王阮亭先生韵 其一 晓妆","董元恺","词",["枕棱斜溜金钗响。","人倦起、日高朱网。","揽镜怯梳头，一点情波漾。","牡丹新髻翻时样。","怪陌上、游郎争赏。","鬌试残妆，日暖云鬟敞。"],0,"x435","清"],["海棠春 其二 午睡","董元恺","词",["海棠花下春风足。","停针线、忽萦心曲。","晓梦未分明，还向鸳鸯褥。","簟纹碧映红生肉。","𥆧睡眼、醉花柔玉。","惊认是朝晖，影落湘妃竹。"],0,"x435","清"],["海棠春 其三 晚浴","董元恺","词",["玉盘水浸金钿影。","清波映、红潮微醒。","娇艳体生香，露湿梨花冷。","起来唤婢移奁镜。","忙掩敛、罗裙先整。","风袅水沉烟，更𦶟龙涎饼。"],0,"x435","清"],["海棠春 其四 夜坐","董元恺","词",["空阶碎滴芭蕉雨。","听叶叶、愁和砧杵。","剪泪问灯花，泪落花无语。","夜寒还倩飞鸿去。","空望断、天边河鼓。","暗忆碧窗南，玉柄同挥麈。"],0,"x435","清"]]