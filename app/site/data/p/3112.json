[["句 其四","孙升","残句",["来书占喜鹊，落日听鸣蛩。"],0,61,"宋"],["句 其十","王随","残句",["地回暖脉冰先觉，梅吐新香蝶未知。"],0,57,"宋"],["句 其三","许庚","残句",["花尽辜啼鸟，麻深没过人。"],0,26,"宋"],["句 其二","陈傅良","残句",["玉龙十二蓬山顶，宝髻三千汉殿中。"],0,"x180","宋"],["句 其六","杨徽之","残句",["浮花水入瞿塘峡，带雨云归越巂州。"],0,88,"宋"],["句 其一","徐宝之","残句",["炊熟风瓢动，吟归雪砚枯。"],0,253,"宋"],["句 其九","李邴","残句",["东湖同住水云家。"],0,140,"宋"],["句 其一","欧阳詹","残句",["啼猿非有恨，行客自多悲。"],0,96,"宋"],["句","洪兴祖","残句",["愿公十袭勿浪出，六丁取将飞辟历。"],0,109,"宋"],["句","无机老农","残句",["名利有危机，老于农圃宜。"],0,127,"宋"],["句 其四","晁公武","残句",["铜梁山昏岚翠重，石镜水落滩声迟。"],0,11,"宋"],["句  其二","吴说","残句",["越山长青水长白，越人长家山水国。"],0,126,"宋"],["句 其一","张俞","残句",["高光如有嗣，吴魏岂胜诛。"],0,177,"宋"],null,["句 其五","陈轩","残句",["寒树似添新喜色，野猿犹听旧吟声。"],0,3,"宋"],["句 其五","仇远","残句",["风雨不出户，儿孙共读书。"],0,"x84","宋"],null,["句 其五","钱易","残句",["子美无情甚，都官著意频。"],0,58,"宋"],["句 其六","钱易","残句",["好开今日太平基，万里山河归掌握。"],0,58,"宋"],["句 其十六","释祖可","残句",["有时罗袜步微月，想见江妃相与娱。"],0,72,"宋"],["句","赵以夫","残句",["片云不隔梅花月。"],0,124,"宋"],["句 其十二","朱敦儒","残句",["而今心服陶元亮，作得人间第一流。"],0,58,"宋"],["句 其十八","释祖可","残句",["乱山争夕阳。"],0,72,"宋"],["句 其一","吴淑","残句",["浴殿夜凉初阁笔，渚宫秋晚得悬车。"],0,37,"宋"],["句 其六","欧阳修","残句",["秋花不落春花落，为报诗人子细看。"],0,"x70","宋"],["句  其二","利州路运判","残句",["蜀道万里险，黎城千古荒。"],0,85,"宋"],["句  其一三","夏倪","残句",["碧嶂云初合。"],0,232,"宋"],["句 其七","吴光","残句",["日长人静闻风佩，雨久堂空生水衣。"],0,174,"宋"],["句 其二","吴氏","残句",["纷纷事如麻。"],0,81,"宋"],["句  其二","彭耜","残句",["家为买琴添旧债，厨因养鹤减晨炊。"],0,58,"宋"],["句","刘跂","残句",["急雨欲来先暑气，凉风过后却秋声。"],0,94,"宋"],["句 其十八","陈轩","残句",["对面心千里，藏机势万般。"],0,3,"宋"],["句 其一","吴光","残句",["檐头清响银匙动，阶下寒光玉碗翻。"],0,174,"宋"],["句 其二","徐宝之","残句",["尽日飞花急，隔溪芳草深。"],0,253,"宋"],["句 其一","释惠崇","残句",["阴井生秋早，明河转曙迟。"],0,69,"宋"],["句 其四","仇远","残句",["割蒲分坐具，贮瀑入军持。"],0,"x84","宋"],["句 其十六","杨亿","残句",["好把长鞭便一挥。"],0,"x47","宋"],["句  其一四","张耒","残句",["空林挂夕阳。"],0,"x71","宋"],["句 其六","朱敦儒","残句",["过时不语莺解事，怕客深藏鱼见机。"],0,58,"宋"],["句 其七","王禹偁","残句",["草屦布裘轻紫绶，角冠纱帽换朝簪。"],0,"x91","宋"],["句  其二一","陈克","残句",["苍颜白髪不时新。"],0,118,"宋"],["句 其六","王随","残句",["候馆虚窗晴月色，野桥疏树暮蝉声。"],0,57,"宋"],["句","伍乔","残句",["积霭沈诸壑，微阳在半峰。"],0,151,"宋"],["句  其二四","陈克","残句",["郊原空阔净无尘。"],0,118,"宋"],["句 其十六","徐俯","残句",["往事湖阴曲，浮生水上萍。"],0,156,"宋"],["句","刘卓","残句",["傍人未必知心事。"],0,221,"宋"],["句 其四","孙何","残句",["飞泉落翠𪩘，爽籁生寒空。"],0,123,"宋"],["句","苏坚","残句",["我梦扁舟浮震泽。"],0,221,"宋"],["句 其三","欧阳经","残句",["小桃斜映绿杨丝，激水泠泠漾日晖。"],0,133,"宋"],["句","吕颐浩","残句",["草履便将为幸舄。"],0,11,"宋"],["句 其一","李新","残句",["在昔岷峨神，龙文而马首。"],0,"x163","宋"],["句 其二","范成大","残句",["上覆白玉盂，下盛白玉盂。"],0,"x52","宋"],["句 其四","王禹偁","残句",["山州过夏如山寺，销尽机尘见道心。"],0,"x91","宋"],["句 其二十八","丁谓","残句",["天门九重开，终当掉臂入。"],0,131,"宋"],["句 其三","李新","残句",["山外浮云云外城，江边羌角水中声。"],0,"x163","宋"],["句 其二十八","钱惟演","残句",["刘伶醉夜梅花地，海客仙槎粉水天。"],0,175,"宋"],["句  其六","李若水","残句",["夜静竹藏风。"],0,167,"宋"],["句 其三十","王禹偁","残句",["惟有南宫窦员外，为予垂泪合门前。"],0,"x91","宋"],["句 其三","梁安世","残句",["蕃马步衔青苜蓿，羌儿卧唱白铜鞮。"],0,54,"宋"],["句 其四","赵佶","残句",["选饭来时不喜餐，御厨空费八珍盘。"],0,"x109","金"],["句  其一七","释祖可","残句",["茅簷欹送晚，苔径曲邀春。"],0,72,"宋"],null,["句 其十五","曾几","残句",["猩血染罗欣入手，冰肌饮露欲濡唇。"],0,"x43","宋"],["句 其十一","王禹偁","残句",["一回酒渴思吞海。"],0,"x91","宋"],["句 其二","余靖","残句",["时人花卉眼，谁共岁寒看。"],0,214,"宋"],["句","唐仲友","残句",["万斛出时非择地，一泓澄处本无心。"],0,181,"宋"],["句 其十三","欧阳修","残句",["酒粘衫袖重，花压帽檐偏。"],0,"x70","宋"],["句","常秩","残句",["冻杀汝阴常处士，也来骑马听朝鸡。"],0,184,"宋"],["句 其三","王铚","残句",["杜宇啼时花正开。"],0,32,"宋"],["句 其五","孙何","残句",["欲谒元戎无介绍，薛能诗版在雕堂。"],0,123,"宋"],["句","贾收","残句",["洄洄流水抱横塘，兰芷无风也自香。"],0,229,"宋"],["句","袁韶","残句",["宴堂联族子，讲席后诸生。"],0,230,"宋"],["句 其一","孙升","残句",["漏残馀一榻，曾不为黄金。"],0,61,"宋"],["句 其三","杨徽之","残句",["新霜染枫叶，皓月借芦花。"],0,88,"宋"],["句 其三","左纬","残句",["禽巢先觉晓，蚁穴未知霜。"],0,185,"宋"],["句 其九","张耒","残句",["清霜夜漠漠，佳食晓累累。"],0,"x71","宋"],["句  其五","王大受","残句",["江平不见滩。"],0,155,"宋"],["句 其七","李壁","残句",["莫令归往地，翻作杀胡林。"],0,80,"宋"],["句  其八","林逋","残句",["已作归心即自宽。"],0,210,"宋"],["句 其六十","高似孙","残句",["沙冷雁三二，天长帆有无。"],0,181,"宋"],["句 其十五","宋祁","残句",["于今尚未好，漠漠宜秋雨。"],0,"x49","宋"],["句  其二二","陈克","残句",["诗孱无奈陈桥月。"],0,118,"宋"],["句","桑世昌","残句",["翠添邻堑竹，红照屋山花。"],0,147,"宋"],["句","蒋璨","残句",["正索解人那复得，其谁知我固无从。"],0,64,"宋"],["句","倪思","残句",["玉历初颁第一春。"],0,248,"宋"],["句 其四","谢逸","残句",["细雨来时麋角解，春风归去马蹄香。"],0,154,"宋"],["句 其五","刘光","残句",["归路夕阳收，山翠染襟袖。"],0,7,"宋"],["句 其七","李师中","残句",["兜鍪不胜任，犹可冠貂蝉。"],0,163,"宋"],["句 其一","刘光","残句",["满地残红惊不见，晓风吹上石榴枝。"],0,7,"宋"],["句 其二","陈尧佐","残句",["莫愁调鼎事无功。"],0,103,"宋"],["句 其三","钱惟演","残句",["厅前捉到须依法，合内盛来定付厨。"],0,175,"宋"],["句","苏舜钦","残句",["沿桥待金鲫，竟日独迟留。"],0,196,"宋"],["句","黄彦平","残句",["湘江东西中浯溪，云埋雨洗三吾碑。"],0,178,"宋"],["句 其十","宋白","残句",["梅雪初销腊酒香，嘉州属县且寻芳。"],0,187,"宋"],["句 其八","张载","残句",["春菰牙露翠，水荇叶连青。"],0,93,"宋"],["句","魏庆之","残句",["今宵方对月，何日结忘年。"],0,52,"宋"],["句","陆秀夫","残句",["曾闻海上铁斗胆，犹见云中金甲神。"],0,120,"宋"],["句 其一","蔡沈","残句",["游鱼顾影惊寒月，宿鹭迷群下夕阳。"],0,128,"宋"],["句 其四","严中和","残句",["画扇题诗鸾背湿，铜彝煎脑鸭心香。"],0,125,"宋"],["句 其二","刘光","残句",["仙馆无人春寂寂，一林红日炼樱丹。"],0,7,"宋"]]