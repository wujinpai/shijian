[["六幺令 其一","赵尊岳","词",["柳眠花亸，绿意暗芳阁。","画屏远山眉蹙，巧向晚妆学。","已忍残寒料峭，那更愁边觉。","带宽围匝。","琵琶曲怨，苦忆檀痕旧谁掐。","别恨凭谁诉与，影问惟形答。","怕见华月团𪢮，绣幕耽银押。","兰夜苕苕玉漏，底事流光霎。","泪珠销蜡。","青鸾无信，几盼佳期误张角。"],0,"x236","近现代"],["六幺令 其二","赵尊岳","词",["柳条初展，阑畔晚风息。","日迟暖熏芳草，草亸玉阶碧。","叶样眉妆巧缀，扫黛安檀的。","暂来歌席。","遏云一曲，绛爉烧残赋狂客。","银汉西流月上，絮絮鳞云拆。","别后孤负闲庭，夜合花堪摘。","比似阳关更苦，怕听宁歌笛。","梦余岑寂。","欢悰逝水，总付明朝醉时忆。"],0,"x236","近现代"],["六幺令 其三","赵尊岳","词",["宝钿琼佩，晚镜靓妆束。","回眸桃靥红晕，越恁娇娆足。","烟约湘裙浅翠，步步香风逐。","鬓轻蛾绿。","尊前小立，为唱韩娥驻云曲。","一向低鬟亸裒，软语偎红烛。","生怕莲漏忽忽，晓梦流莺促。","珍重云屏半折，曾是欹香玉。","旧欢重续。","麝熏褥绣，看取金鸳也双宿。"],0,"x236","近现代"],["更漏子 其一","赵尊岳","词",["暖烟稠，芳草遍。","帘卷绿阴深院。","莺款语，燕嫞飞。","还疑春未归。","短长愁，深浅意。","都付一年花事。","才薄暖，似新凉。","销香昼渐长。"],0,"x236","近现代"],["更漏子 其二","赵尊岳","词",["海棠眠，蝴蝶醉。","帘外落英刬地。","偷晕浅，学颦轻。","如眉杨柳青。","鸟惊心，花溅泪。","争识个侬芳意。","催暗绿，妒残红。","疏棂料峭风。"],0,"x236","近现代"],["更漏子 其三","赵尊岳","词",["碧阴圆，娇燕小。","画阁不堪重到。","愁暂遣，泪初晴。","啼鹃声复声。","恨时少，欢事少。","梦肯留人长好。","鸾柱涩，雁书迟。","相逢知几时。"],0,"x236","近现代"],["更漏子 其四","赵尊岳","词",["梦寻难，人去远。","帘为恨春迟卷。","梨雨后，杏花嫞。","半庭香雪浓。","靥红残，鬟翠重。","依约梦中相送。","催暝色，入离愁。","相思云外楼。"],0,"x236","近现代"],["更漏子 其五","赵尊岳","词",["血啼鹃，丝织柳。","愁绝问伊知否。","传笑语，逗娇颦。","梦中无限春。","恨如烟，身似客。","忍说有花须折。","狂杜牧，瘦东阳。","萦回百结肠。"],0,"x236","近现代"],["更漏子 其六","赵尊岳","词",["意中人，笺上字。","消受别离滋味。","如梦里，忆年时。","柔肠说与知。","絮风愁，花月怨。","何日玉台重见。","情不尽，恨难禁。","烧残红烛心。"],0,"x236","近现代"],["御街行 其一","赵尊岳","词",["琼枝倚立凝香露。","如怨韶光暮。","晓莺惊觉玉楼人，一抹翠阴笼树。","镜奁愁照，绣帷嫞卷，苦忆关情处。","柔丝不系东风住。","一霎成歧路。","映花门巷梦魂中，恰似玉骢轻去。","清明过却，将离开遍，惆怅佳期误。"],0,"x236","近现代"],["御街行 其二","赵尊岳","词",["新萍总是风中絮。","迢递横塘路。","画船回首碧云西，约略茜纱朱户。","一奁明镜，数声柔橹，又过长亭树。","流云不作无情去。","却作留人雨。","绿波总是接天涯，春色几分能驻。","骊歌易阕，鸾肠禁续，掩袂伤离处。"],0,"x236","近现代"],["浪淘沙 其一","赵尊岳","词",["丝柳拂银塘。","摇曳烟光。","梦魂依约旧潇湘。","莺语似含清瑟怨，空诉残阳。","波路九回肠。","山作眉妆。","罗衣犹惹去年香。","苦恨东风花落后，一例能狂。"],0,"x236","近现代"],["浪淘沙 其二","赵尊岳","词",["飞燕蹴香红。","小立芳丛。","韶华锦样去年同。","祇有芳心嫞不展，寸碧春空。","相见几时重。","犹记初逢。","隔花烟语小窗中。","百计无聊从别后，孤负番风。"],0,"x236","近现代"],["浪淘沙 其三","赵尊岳","词",["容易梦游仙。","锦瑟冰弦。","沉香亭北醉青莲。","冉冉香云腾宝鸭，璧月琼筵。","一向换华年。","醒眼愁边。","啼莺犹似劝觥船。","打叠新欢成旧恨，楝子风前。"],0,"x236","近现代"],["浪淘沙 其四","赵尊岳","词",["画阁绮筵张。","有恨须忘。","窥人小燕在雕梁。","记取春秾花亸处，纤手传觞。","余事付荒唐。","消得回肠。","晚来云淡露华凉。","月到圆时人意好，端的思量。"],0,"x236","近现代"],["诉衷情 其一","赵尊岳","词",["珍珠手卷暗香来。","帘外几枝梅。","镜奁春意先暖，含萼未全开。","扶缟袂，下瑶台。","费诗才。","那堪愁里，莫惜花前，吟绕千回。"],0,"x236","近现代"],["诉衷情 其二","赵尊岳","词",["春青剪叶妒妆眉。","风流些子儿。","折花嫞理双袖，芳意总相宜。","闲体态，倦腰肢。","自寻思。","杏花藏笑，杨柳含颦，得似心期。"],0,"x236","近现代"],["诉衷情 其三","赵尊岳","词",["柳塘波绿漾残红。","此景别时同。","别愁长是千里，无赖又东风。","花艳艳，月胧胧。","旧情浓。","那堪回首，梦怯啼莺，望极征鸿。"],0,"x236","近现代"],["诉衷情 其四","赵尊岳","词",["苹风荻雪作深秋。","极目水东头。","寒云弄影天末，年事逐云流。","波宛宛，梦悠悠。","合成愁。","玉容安否，筝尘画阁，笛语高楼。"],0,"x236","近现代"],["诉衷情 其五","赵尊岳","词",["红灯翠袖映娇娆。","微酲晕粉消。","珠歌一串尘簌，歌外驻云遥。","萦洛浦，度湘皋。","梦迢迢。","芳时弹指，满目青山，何处蓝桥。"],0,"x236","近现代"],["诉衷情 其六","赵尊岳","词",["金鸳绣蹙藕丝裙。","浓香草眼熏。","花蹊步拾兰翠，楼阁未黄昏。","纤屐齿，印苔痕。","怯心魂。","娉婷自惜，红粉青娥，见说如云。"],0,"x236","近现代"],["诉衷情 其七","赵尊岳","词",["软风摇漾郁金裙。","香罗更麝熏。","双鸾浅移娇步，犹自惜苔纹。","搴带草，撷书芸。","最思君。","忽忽芳节，脉脉幽怀，付与行云。"],0,"x236","近现代"],["诉衷情 其八","赵尊岳","词",["暖风迟日敞琼筵。","彩袖拨湘弦。","飞花掠鬓回袖，芳物媚韶年。","香雾重，紫霞鲜。","艳阳天。","扶酲归去，花碍罗衣，柳拂丝鞭。"],0,"x236","近现代"],["碧牡丹","赵尊岳","词",["字密题团扇。","花亸娇新燕。","梦里春秾，不道惊回春远。","十二回阑，罥绿阴将遍。","萧条斜日深院。","恨无限。","倦倚芳阁晚。","心期岁华同换。","欲寄相思，字问去程长短。","未必婵娟，千里知人愿。","凝情空伫归雁。"],0,"x236","近现代"],["行香子","赵尊岳","词",["漾碧流红。","烟路忽忽。","舣兰桡、前度曾同。","玉箫声里，惆怅惊鸿。","几伫行云，吟落月，倚东风。","画帘深下，茸窗静掩，费低徊、情味何穷。","天涯芳草，庭院梧桐。","也宿妆残，罗袖薄，翠眉空。"],0,"x236","近现代"],["点绛唇 其一","赵尊岳","词",["双燕来时，落红门巷浑如旧。","最怜人瘦。","忍折风前柳。","锦瑟无端，谁共心魂守。","分携后。","梦痕消酒。","和泪盈双袖。"],0,"x236","近现代"],["点绛唇 其二","赵尊岳","词",["兰夜华灯，麝薰一缕肠千折。","自从离别。","此际真愁绝。","花近窗前，云掩窗前月。","圆还缺。","落花时节。","旧恨凭谁说。"],0,"x236","近现代"],["点绛唇 其三","赵尊岳","词",["花落花开，妒花风里春如寄。","不成芳意。","倦倚屏山翠。","偶忆年时，罗袖沾新泪。","愁无计。","为谁拌醉。","醉也和愁睡。"],0,"x236","近现代"],["点绛唇 其四","赵尊岳","词",["春近阑干，淡黄杨柳抽新缕。","旧情何许。","莫放游丝去。","极目南云，迢递钿车路。","留难住。","片风丝雨。","苦忆伤离处。"],0,"x236","近现代"],["点绛唇 其五","赵尊岳","词",["开到将离，谢娘池馆春先老。","玉骢芳草。","烟景无多好。","杜宇声中，忍见春归了。","云涯渺。","贮愁多少。","珍重眉痕小。"],0,"x236","近现代"],["少年游 其一","赵尊岳","词",["茜纱窗外，微云丝雨，春意逗芳红。","飞来燕子，关情底事，软语诉东风。","星期月约，年年虚度，容易梦中逢。","游丝千缕，横波一霎，何似莫忽忽。"],0,"x236","近现代"],["少年游 其二","赵尊岳","词",["螺鬟高耸，蝉钗倦亸，眉叶翠初匀。","帘波浅约，屏风轻叠，赪脸晕娇颦。","蓦然相见，惺忪薄困，依约画中人。","别后情怀，梦余滋味，惆怅隔年春。"],0,"x236","近现代"],["少年游 其三","赵尊岳","词",["秋阴院落，侧寒天气，帘下乍相逢。","人家深巷，兽镮微动，丝雨寂寥中。","横波无那，凝情欲伫，珍重意千里。","遍写乌丝，谁传鱼素，除是梦魂中。"],0,"x236","近现代"],["少年游 其四","赵尊岳","词",["碧梧清夜，桃笙荐爽，楼上月华明。","阑干倚遍，微云弄影，枨触别离情。","锦书难寄，罗衣空换，孤负雁南征。","别时能得几叮咛。","无数短长亭。"],0,"x236","近现代"],["少年游 其五","赵尊岳","词",["平沙岸曲，垂虹桥下，双桨划清流。","云山未改，烟波无恙，不似去年秋。","去年近日，茜窗深话，低控玉帘钩。","祇今衰柳夕阳楼。","谁与诉新愁。"],0,"x236","近现代"],["虞美人 其一","赵尊岳","词",["垂杨织遍吹笙路。","绿意新帘户。","隔帘依约玉娟娟。","最忆年时红袖捧金船。","攀条惜别年年惯。","几度斜阳晚。","晚风双燕入帘时。","尽意呢喃如话旧相思。"],0,"x236","近现代"],["虞美人 其二","赵尊岳","词",["梦醒人远销魂地。","玉倦钩斜坠。","玉钩随意挂闲愁。","一任柳绵飞雪上层楼。","楼高望极伤情怨。","云袅春空遍。","落霞犹是旧时红。","祇是别来心眼不相同。"],0,"x236","近现代"],["虞美人 其三","赵尊岳","词",["秋河似泻银瓶水。","遥夜阑干倚。","绿章乞与展星期。","为问填桥灵鹊忍轻归。","银云漏处蟾钩在。","月转花阴改。","云涯有恨托鹍弦。","生怕一声河满到尊前。"],0,"x236","近现代"],["虞美人 其四","赵尊岳","词",["篆烟销尽沈馢缕。","愁坐清无语。","宫罗软绣曲屏风。","移向花间应解护香红。","红英落尽春无信。","莺燕归期近。","伊行能得共归无。","看取缃桃瘦损要人扶。"],0,"x236","近现代"],["虞美人 其五","赵尊岳","词",["春风飘拂长亭路。","又送兰船去。","归来临镜怯颦眉。","从此一春长是别伊时。","无心更惜春光好。","春去凭迟早。","梦中欢会醒分飞。","却见画帘娇燕一双归。"],0,"x236","近现代"],["虞美人 其六","赵尊岳","词",["花秾柳亸韶容好。","不信春将老。","珠帘斜搭玉阑干。","何事落红飞不到屏山。","啼鹃为说春犹在。","祇是芳期好。","芳期那得是归期。","此际万千心绪一颦眉。"],0,"x236","近现代"],["虞美人 其七","赵尊岳","词",["双鸿未有归来信。","已是秋风近。","夫容容易绕池开。","冷艳相看能得几人来。","夜凉珠露如清泪。","寥泬成霜意。","玉阑凭瘦玉楼人。","便是远山眉翠亦含颦。"],0,"x236","近现代"],["虞美人 其八","赵尊岳","词",["玉珰缄札珍珠字。","不尽心中事。","若教双鲤肯来时。","便似番风有信怕花迟。","花新不似情依旧。","此恨年年有。","一回花褪一春阑。","帘卷绿阴如画妒眉山。"],0,"x236","近现代"],["虞美人 其九","赵尊岳","词",["红牙按拍翻新乐。","巧向韩娥学。","绕梁依宛遏云深。","才信当筵一曲直千金。","歌残金缕花时怨。","消得回肠断。","天涯难得是知音。","越恁称人心处系人心。"],0,"x236","近现代"],["采桑子 其一","赵尊岳","词",["当筵彩袖殷勤甚，态冶情闲。","舞罢歌阑。","不负宵深玉漏残。","门前金勒休催去，蜡泪初干。","料峭微寒。","酒晕霞生子细看。"],0,"x236","近现代"],["采桑子 其二","赵尊岳","词",["东风珍重吴侬意，帘外芳梅。","筵上深杯。","忍付昭华玉笛吹。","新𥬠拨尽翻成怨，锦字嫞裁。","甚日重来。","见说文无取次开。"],0,"x236","近现代"],["采桑子 其三","赵尊岳","词",["梦中依约凌波影，佩结瑶珍。","香裛梨云。","残月啼雅苦唤人。","梦魂悠飏如轻絮，一向前尘。","便抵飘茵。","咽尽铜壶悄恨春。"],0,"x236","近现代"],["采桑子 其四","赵尊岳","词",["落花巧缀泥金幕，料峭东风。","社燕匆匆。","飞向邻家院落中。","杏梢犹怯余寒重，无语芳红。","自惜妖嫞。","写入猩屏那得同。"],0,"x236","近现代"],["采桑子 其五","赵尊岳","词",["玉钩银蒜春阴羃，深院微风。","梦语惺忪。","幻作柔云漾碧空。","垂杨画罨秋千索，惹翠萦红。","芳意千重。","扶上仙裙更不同。"],0,"x236","近现代"],["采桑子 其六","赵尊岳","词",["红窗燕子呢喃语，似说归期。","却忆年时。","未到将离已别离。","凭渠锦字殷勤寄，纵赋新诗。","不尽相思。","惆怅杨花满院飞。"],0,"x236","近现代"],["采桑子 其七","赵尊岳","词",["机中长恨鱼中素，倦拨炉香。","愁倚眉妆。","袖薄天寒掩泪行。","游春总是愁春处，弱腕丝缰。","恨缕垂杨。","翠驿红亭路更长。"],0,"x236","近现代"],["采桑子 其八","赵尊岳","词",["侧风趖日杨花乱，孤负芳期。","燕子楼西。","那得残红更上枝。","玉笼鹦鹉惟忺睡，燕子来迟。","诉与伊谁。","心事低颦彊笑时。"],0,"x236","近现代"],["采桑子 其九","赵尊岳","词",["等闲过也芳菲节，小院红稀。","镇日相思。","凄绝遥山翠罨时。","凝情怕说当年事，后约难知。","昨梦都非。","纵有花笺得到伊。"],0,"x236","近现代"],["采桑子 其十","赵尊岳","词",["夜遥桦烛消红泪，罨鬓颦眉。","翠袖双垂。","舞倦歌阑月上迟。","笼纱嘶马催归急，欲语期期。","最耐人思。","握手相看半向时。"],0,"x236","近现代"],["采桑子 其十一","赵尊岳","词",["银钩画箔闲朱阁，篆袅香浓。","渐入空蒙。","偶逐游丝缱绻同。","云翘拥髻霞生脸，猩色屏风。","看取嫣红。","莫道佳期是梦中。"],0,"x236","近现代"],["采桑子 其十二","赵尊岳","词",["桃根双楫分苹叶，明月团圆。","人劝金船。","醉去和衣一向眠。","夜凉诗思清于水，写遍花笺。","却忆当年。","艳曲江南听采莲。"],0,"x236","近现代"],["采桑子 其十三","赵尊岳","词",["双鱼不寄归来信，底事迟留。","负了扁舟。","玉露殷勤浣素秋。","闹红双桨年时约，赌酒藏钩。","旧梦新愁。","都付离人唱石州。"],0,"x236","近现代"],["采桑子 其十四","赵尊岳","词",["茜窗闲煞丹青笔，画稿嫞临。","薄怯罗襟。","秋入屏帷问浅深。","渐深秋似春犹浅，最是而今。","孤负春心。","残梦都随断续砧。"],0,"x236","近现代"],["采桑子 其十五","赵尊岳","词",["宵来赢得凉如水，青琐朱楼。","玉腻香柔。","月影偎人故故留。","诗成绿蚁倾须满，漏箭银虬。","疏幌萤流。","倚笛谁家各自愁。"],0,"x236","近现代"],["采桑子 其十六","赵尊岳","词",["秋千院落蔷薇架，花絮忽忽。","帘幕重重。","总在鹃啼蝶梦中。","等闲佳景蹉跎了，容易相逢。","瘦损西风。","一日三秋两地同。"],0,"x236","近现代"],["采桑子 其十七","赵尊岳","词",["嘶骢门巷寻芳陌，雏凤知名。","人月双清。","霓曲人间第一声。","无端唱彻阳关叠，云散离情。","水咽长亭。","莺语春来未忍听。"],0,"x236","近现代"],["采桑子 其十八","赵尊岳","词",["年时玉简酬芳约，靥杏脂匀。","眉柳烟颦。","彩笔安排记会真。","浮云西北堪回首，酒涴衫春。","歌涩筝尘。","楼上花枝莫笑人。"],0,"x236","近现代"],["采桑子 其十九","赵尊岳","词",["厌厌三月长如醉，怨宇啼春。","斜照含颦。","花信忽忽记不真。","枨枨帘幕深深院，红剩香尘。","绿作浓云。","柳外楼高望远人。"],0,"x236","近现代"],["采桑子 其二十","赵尊岳","词",["西风消息啼螀急，一夜新凉。","底费商量。","玉漏争如绮恨长。","素娥宛宛移花影，影绕回廊。","香袭茸窗。","香影缠绵欲断肠。"],0,"x236","近现代"],["采桑子 其二十一","赵尊岳","词",["小红亭外垂丝柳，烟景依稀。","送别斜溪。","掠鬓东风絮乱飞。","踏青拾翠嬉游处，香雾霏微。","行乐年时。","草眼晴熏袭画衣。"],0,"x236","近现代"],["采桑子 其二十二","赵尊岳","词",["斜风淡日帘垂地，酒黯离襟。","旧谱嫞寻。","闲煞红囊绿绮琴。","雨余花落知多少，最是关心。","不道而今。","泪与残红较浅深。"],0,"x236","近现代"],["采桑子 其二十三","赵尊岳","词",["别来无计消长日，晚岫匀螺。","秋水凝波。","一抹斜晖恨许多。","试倾新酿欢娱减，莫更闻歌。","往事蹉跎。","纤月笼云蹙怨蛾。"],0,"x236","近现代"],["采桑子 其二十四","赵尊岳","词",["宿酲初解琼钩上，晓色帘栊。","人意新嫞。","网户朝暾罨镜红。","镜奁双凤多情甚，总与春逢。","丽日妍风。","宛宛行云在碧空。"],0,"x236","近现代"],["采桑子 其二十五","赵尊岳","词",["秋心不放愁心展，一曲尊前。","唤起闲眠。","露浥凉蟾分外圆。","听歌看舞游情懒，写遍红笺。","弹彻冰弦。","别恨难凭雁与传。"],0,"x236","近现代"],["采桑子 其二十六","赵尊岳","词",["回阑那角珠帘影，蜂蝶殷勤。","柳绽黄金。","昨梦如烟记未真。","是真是梦浑难问，低草迷春。","高柳窥邻。","满目韶华苦赚人。"],0,"x236","近现代"],["踏莎行 其一","赵尊岳","词",["风絮飘残，烟丝低尽。","愔愔院落寻芳信。","小颦窥镜去年时，不堪重向啼莺问。","锦字情长，碧云天近。","蓬山祇在灵犀寸。","西楼昨夜月胧明，欢尘坠处凭谁认。"],0,"x236","近现代"],["踏莎行 其二","赵尊岳","词",["檐马喧晴，林鸦绕暝。","无情寒暖浑无定。","因风起絮作牵萦，游丝肯为相思静。","去日华笺，年时粉镜。","高楼何处传归信。","回环心字玉炉熏，倦余惆怅还成醒。"],0,"x236","近现代"],["踏莎行 其三","赵尊岳","词",["暝霭如愁，年涯似水。","绿芜不尽相思地。","倚阑生怕见遥岑，向人犹学眉痕翠。","何计酬春，无聊拌醉。","醉余苦忆欢娱事。","欢娱能几醉还醒，㩻斜泪墨吴笺字。"],0,"x236","近现代"],["踏莎行 其四","赵尊岳","词",["奁远云开，橹柔波重。","扁舟容与双凫共。","水荭花外有轻寒，斜阳罨画钟初动。","千里婵娟，双飞彩凤。","无情一碧天如梦。","梦中犹记去时情，搴裾南浦花前送。"],0,"x236","近现代"],["留春令 其一","赵尊岳","词",["绿阴楼外，夕阳多处，旧痕烟水。","听彻啼莺落花深，忆前度、欢娱事。","十二阑干能几倚。","更笙歌邻里。","如许韶华不成欢，只怀远、凝清泪。"],0,"x236","近现代"],["留春令 其二","赵尊岳","词",["絮阶虫咽，打窗叶响，满庭霜意。","欲摘金英附瑶华，道人瘦、花相似。","暂遣闲愁须?醉。","念楚腰纤细。","锦瑟华年恁忽忽，最惜起、花时事。"],0,"x236","近现代"],["留春令 其三","赵尊岳","词",["夜长衾冷，月移帘悄，炉熏烬半。","更忍银灯照窗纱，傍镜影、愁中看。","往事魂销尊酒畔。","是鲛绡偷换。","千里从教共婵娟，也寸寸、回肠断。"],0,"x236","近现代"],["清商怨","赵尊岳","词",["愁深春水较浅。","负花风妍暖。","送别经时，天涯魂梦远。","垂杨翠缕漫剪。","付杜宇、一枝春晚。","盼煞归期，离亭长更短。"],0,"x236","近现代"],["长相思","赵尊岳","词",["长相思。","长相思。","欲寄相思未可期。","雁来知几时。","长相思。","长相思。","满目韶华付与谁。","缄愁只自知。"],0,"x236","近现代"],["醉落魄 其一","赵尊岳","词",["晚塘新月。","玉箫声里晶奁彻。","鸥鹭于人知款切。","却笑人人，长是长亭别。","长亭去日花如雪。","惆怅容易芳菲歇。","垂杨翠缕禁攀折。","缕织成愁，欲结浑无说。"],0,"x236","近现代"],["醉落魄 其二","赵尊岳","词",["月圆还缺。","云涯怅望音书绝。","愁边荏苒芳菲节。","千里相思，一寸灵犀结。","兔走鸟飞无暂歇。","华年弦柱伤心彻。","素娥忍见多情别。","碧海青天，心事和谁说。"],0,"x236","近现代"],["醉落魄 其三","赵尊岳","词",["天寒袖薄。","一春中酒情怀恶。","辛苦梦痕何处著。","切莫惊回，更于啼莺约。","钿金衾铁都成错。","怜花心事怜花落。","落花犹得浮君酌。","看取花浮，拌醉君休却。"],0,"x236","近现代"],["醉落魄 其四","赵尊岳","词",["从今更莫。","从今莫怨东风恶。","东风尽意催花著。","不分春人，几误花前约。","芳期一向成今昨。","酬春祇办觥筹错。","倚阑极目春云薄。","极目云涯，多少春闲却。"],0,"x236","近现代"],["西江月 其一","赵尊岳","词",["绣幕低垂院静，金炉悄拨香残。","流莺劝我惜春闲。","可奈扶头意懒。","柳色能将远恨，梨云惯作轻寒。","游丝欲罥落花难。","燕子归来太晚。"],0,"x236","近现代"],["西江月 其二","赵尊岳","词",["玳瑁梁间燕乳，沉香槛外莺稀。","新桐初引拂墙枝。","杨柳三眠似醉。","池水暗浮花涨，屏山静掩春归。","绿阴如梦忆人时。","消损春魂剩几。"],0,"x236","近现代"],["武陵春 其一","赵尊岳","词",["卷起珍珠钩起恨，新月素光流。","不尽遥天不尽秋。","更不尽离愁。","金钗钿合虚前约，魂梦误欢游。","重系斑骓翠陌头。","不似旧扬州。"],0,"x236","近现代"],["武陵春 其二","赵尊岳","词",["浅醉人扶花绰约，蜂蝶恋芳丛。","花信频番春更浓。","瑶斝泛东风。","?它醉懒如云态，云不驻春空。","花下何时一醉同。","春在小庭中。"],0,"x236","近现代"],["武陵春 其三","赵尊岳","词",["别后愁长心字短，宝鸭蕙烟销。","画阁愔愔人去遥。","魂梦逐轻桡。","瑶珰不付新来雁，目断碧云遥。","莫更寻春弟几桥。","双袖泪红绡。"],0,"x236","近现代"],["解佩令","赵尊岳","词",["夕阳难系，春光老去。","绿阴中、芳阁愁无绪。","紫蝶黄蜂，也解惜、脂香铅素。","更何论、茜窗儿女。","文无开遍，荼䕷满院，忍重寻、玉骢嘶处。","录曲阑干，恁禁得、疏烟丝雨。","付鹍弦、替人深诉。"],0,"x236","近现代"],["泛清波摘遍","赵尊岳","词",["眉青隐岫，额雪窥帘，犹记那时风韵好。","解人春意，绰约枝头放花早。","宁知道。","银笺恨字，玉笛离声，一霎雨情云梦了。","侧帽轻衫，杜牧而今俊游少。","去尘渺。","千里沧波接天，一抹冷烟黏草。","过尽征帆都非，倚楼昏晓。","伫鸿杳。","辛苦问讯断云，玉珰甚时能到。","几许闲愁都付，醉和衣倒。"],0,"x236","近现代"],["归田乐","赵尊岳","词",["倦把番风数。","万缕已、忍新愁绪。","赚得莺声吐。","更离梦忽断，芳景难住。","荏苒去。","愁凭屏山成独语。","亸袖余寒春念否。","画帘残照，燕子凄凉侣。","梦余尚道得，旧分携处。","绿暗长亭怨花絮。"],0,"x236","近现代"],["河满子 其一","赵尊岳","词",["锦瑟长闲玉柱，绣帘懒上琼钩。","乍寒轻暖春正好，年时记省欢游。","柳叶才胜约指，花枝解恋搔头。","是处韶华如梦，者回芳约都休。","系情可奈游丝软，倚阑多少闲愁。","得似画图依旧，云山尽意当楼。"],0,"x236","近现代"],["河满子 其二","赵尊岳","词",["蹙黛谁知深意，横波自惜荣光。","背人私系双绣带，花时懒去寻香。","锁梦遥怜巫峡，流愁欲付潇湘。","绵邈一春望眼，萦回九曲柔肠。","碧云容易斜阳暮，遥山也倦眉妆。","那更残红簌簌，桃花苦忆连昌。"],0,"x236","近现代"],["于飞乐","赵尊岳","词",["映额窥帘，海棠依约红腮。","春阴画罨楼台。","雾笼香，风泥醉，软绣屏开。","仙人萼绿，妒玉容、著意修梅。","絮果难论，苕华如梦，三生月地云阶，蕊珠宫，青鸟使，无限情怀。","天花伫久，东风里、万一飞来。"],0,"x236","近现代"],["破阵子","赵尊岳","词",["月到团𪢮十五，花如佳丽三千。","得似阿侬娇俊否，看取将歌未舞前。","妆梅妒脸莲。","有约云涯青鸟，相思被底红绵。","占断韶光能几日，懊恨无端锦瑟弦。","春光泄绮年。"],0,"x236","近现代"],["好女儿 其一","赵尊岳","词",["皱碧奁池。","丝雨晴时。","听藏花、坐柳娇莺语，似殷勤说道，踏青天气，妍暖香泥。","祇是归来惆怅，者烟景、耐寻思。","伫黄昏、院宇霏香雪，几凝颦不语，空教添了，懊恼心期。"],0,"x236","近现代"],["好女儿 其二","赵尊岳","词",["解佩殷勤。","芳约酬春。","记前番、笑并璚窗影，恰花阴深静，麝熏妍暖，著个人人。","不道经年憔悴，坐虚阁、恨常新。","倦黄莺、掠过墙东路，也空劳问讯，题红深巷，罨翠良辰。"],0,"x236","近现代"],["两同心","赵尊岳","词",["试探芳信，便梦仙源。","茜霞影、齐飞孤骛，翠茵路、净拭纤尘。","东风里、皱水浮花，新绿当门。","此际浪漫开尊。","跌宕心魂。","酹红紫、直须千万，𣨼莺燕、莫负朝昏。","醉眠也，惨绿春衫，宜称苔痕。"],0,"x236","近现代"],["满庭芳","赵尊岳","词",["帘押轻寒，庭柯暝霭，倦余幽恨千重。","碧桃深处，多事是相逢。","苦忆情芳婉娩，帕罗题字画楼东。","蓦回首，神光一瞥，影倩失惊鸿。","兰成憔悴损，恨随芳草，泪咽丝桐。","更帘卷黄花，省识西风。","送尽来鸿去雁，天涯路、云水屏中。","销魂处，回阑一角，残照驻斜红。"],0,"x236","近现代"],["风入松 其一","赵尊岳","词",["翠萝筛影覆莓墙。","又送斜阳。","绿窗倦绣纤眉敛，蕙炉烬、百和余香。","天末锦书无据，眼中铅泪潜行。","冰弦玉指拨伊凉。","不尽衷肠。","绿阴红雨寻常事，祇花间、芳约难忘。","误我情深款款，付它春去堂堂。"],0,"x236","近现代"]]