[["真宗汾阴礼毕亲谢元德皇后室三首 其二 奉俎用《丰安》。","郊庙朝会歌辞","四言",["乐铿金石，俎奉牺牲。","九成斯奏，五教爰行。"],0,"x207","宋"],["熙宁祭风师五首 其五 送神用《欣安》。","郊庙朝会歌辞","四言",["奠献纷纷，灵心欣欣。","超然而返，众御如云。","其施伊何，多黍多稌。","其祥伊何，不愆厥叙。"],0,"x207","宋"],["偈颂七十六首 其六十四","释师观","四言",["问讯烧香，闲行静坐。","与么分明，是个什么。"],0,210,"宋"],["高宗明堂前朝献景灵宫十首 其九 送真用《太安》。","郊庙朝会歌辞","四言",["高飞安翔，持御阴阳。","幽赞圆穹，监观四方。","元精回复，奄虞孔良。","毕觞降嘏，偃蹇于骧。"],0,"x207","宋"],["真宗奉圣祖玉清昭应宫十一首 其十 彻馔用《吉安》。","郊庙朝会歌辞","四言",["雕俎在御，飙驾闻声。","真游斯降，旨酒斯盈。","大乐云阕，大礼云成。","彻彼常荐，罄此明诚。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 彻馔用《吉安》。","郊庙朝会歌辞","四言",["房铏陈列，室簋登奉。","告飨具歆，展彻惟拱。","祥光奕奕，嘉气蒙蒙。","受嘏不愆，燕天之宠。"],0,"x207","宋"],["大观祭风师六首 其三 奠币用《容安》。","郊庙朝会歌辞","四言",["吹嘘于喁，披拂氤氲。","众窍咸作，潜运化钧。","恩大功丰，酬神维恭。","嘉赠盈箱，于物有容。"],0,"x207","宋"],["紫溪庄舍读癸丑壁间旧题转眼忽十八年同游十不存一滋兰弟亦作古人拂拭洒涕几不能去因诵欧公诗云人昔共游今有几树犹如此我何堪以是为韵感怀成十四章庚午四月中澣  其九","刘学箕","四言",["兴念陈迹，梦寐吾犹。","植杖风雩，某水某丘。","日居月诸，循环靡休。","迭尔遄迈，曾不我留。"],0,98,"宋"],["绍兴以后蜡祭四十二首 亚、终献用《曼安》。","郊庙朝会歌辞","四言",["丰年孔多，百礼以洽。","匪极神欢，何以昭答。","载酌之酒，用申其勤。","神具醉止，与物交欣。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 亚、终献用《曼安》。","郊庙朝会歌辞","四言",["兰生百末，申以贰觞。","神具醉止，烂其容光。","遗我丰年，万亿及秭。","俾民驩康，以洽百礼。"],0,"x207","宋"],["大中祥符封禅十首 其六 终献用《顺安》。","郊庙朝会歌辞","四言",["浩浩元精，无臭无声。","临下有赫，得一以清。","备物致享，荐兹至诚。","泰尊奠献，夙夜齐明。"],0,"x207","宋"],["皇后庙十五首 其十 庄怀皇后室用《永安》。","郊庙朝会歌辞","四言",["淑德昭著，至乐和平。","登豆在列，膋香荐诚。","六变合礼，八音谐声。","穰穰景福，佑我休明。"],0,"x207","宋"],["绍兴朝会十三首 皇帝初举酒用《瑞木成文》。","郊庙朝会歌辞","四言",["厚地效珍，嘉木纪瑞。","匪刻匪雕，具文见意。","三登太平，允协圣治。","诗雅咏歌，有光既醉。"],0,"x207","宋"],["明道亲享先农十首 其一 迎神用《静安》。","郊庙朝会歌辞","四言",["稼政之本，民食惟天。","甫田兆岁，后稷其先。","灵坛既祀，黛耜攸虔。","乃圣能享，亿万斯年。"],0,"x207","宋"],["熙宁望祭岳镇海渎十七首 其九 中望迎神用《凝安》。","郊庙朝会歌辞","四言",["维土作德，维帝御行。","含养载育，万物以成。","有严祀典，荐我德馨。","神其歆止，永用亿宁。"],0,"x207","宋"],["真宗告飨六首 其五 圣祖降亲告用《瑞安》。","郊庙朝会歌辞","四言",["于赫圣祖，景灵在天。","神游来暨，睟容穆然。","诲言昭示，帝胄开先。","齐明钦若，延鸿亿年。"],0,"x207","宋"],["雨师雷神七首 其二 初献盥洗、升降用《钦安》。","郊庙朝会歌辞","四言",["言言祠宫，爰考我礼。","维西有罍，维东有洗。","爰洁爰涤，载荐其醴。","神在何斯，匪远具迩。"],0,"x207","宋"],["雍熙享先农六首馀同祈谷 其二 奠玉币用《敷安》。","郊庙朝会歌辞","四言",["亲耕展祀，明灵来格。","九有骏奔，百司庇职。","献奠肃肃，登降翼翼。","祈彼丰穰，福流万国。"],0,"x207","宋"],["侍辂院叔过山庐意行甚适夜过半乃知醉卧山中而亲友或去或留因借渊明时运暮春篇一笑 其二","牟𪩘","四言",["摩肩趋利，市门之朝。","夷然抱关，市也亦郊。","一念静躁，悬隔壤霄。","旱火禾焚，实焮我苗。","饮冰内热，其何能濯。","大播眯昧，近或弗瞩。","我有至境，反观内足。","寂寞宽闲，自得其乐。","茫茫禹迹，海岱淮沂。","游子倦矣，故乡如归。","牛羊在野，举肱一挥。","既入其苙，夫又何追。","八荒我闼，天地我庐。","六凿何有，一席晏如。","西风篱落，剥枣断壶。","静以观复，闭户者予。"],0,"x188","宋"],["宁宗朝享三十五首 徽宗室用《承元》。","郊庙朝会歌辞","四言",["帝抚熙运，晏粲协期。","礼明乐备，文恬武嬉。","道光授受，谋深燕诒。","骏命不易，子孙保之。"],0,"x207","宋"],["绍兴二十八年祀圜丘 太祖皇帝位奠币用《广安》。御制。","郊庙朝会歌辞","四言",["明明翼祖，并侑泰坛。","肇造绵宇，王业孔艰。","表正封略，上际下蟠。","躬以大报，亦止于燔。"],0,"x207","宋"],null,null,["绍兴祀大火十二首 荧惑位奠玉币用《嘉安》。","郊庙朝会歌辞","四言",["馨香接神，肸蚃恍惚。","求神以诚，荐诚以物。","有藉斯玉，有篚斯币。","是用荐陈，昭兹精意。"],0,"x207","宋"],null,["真宗奉圣祖玉清昭应宫十一首 其九 饮福用《庆安》。","郊庙朝会歌辞","四言",["明明始祖，诞启庆基。","翼翼后嗣，虔奉孝思。","精洁斯达，祉福咸宜。","于以报贶，于以受厘。"],0,"x207","宋"],["上明达皇后册宝五首 其二 酌献用《明安》。","郊庙朝会歌辞","四言",["清宫有严，广乐在庭。","钟鼓筦磬，九变既成。","缩茅以献，洁秬惟馨。","灵游可想，来燕来宁。"],0,"x207","宋"],["宣和丁酉太夫人终天墓庐中读金光明经见摩诃萨埵投身饲虎因缘尝以颂赞叹之绍兴庚午临封又得是经诵读复成一偈","郑刚中","四言",["虎有爪距，如刀兵利。","佛岂欲人，置身其喙。","惟见前法，欢喜怖畏。","猛火销金，观汝难易。","大慈悲父，持戒定慧。","作汝津梁，无有障蔽。","瞿夷非虎，冤亲无异。","虎七子者，比丘等是。"],0,"x99","宋"],["高宗郊前朝献景灵宫二十一首 其九 再盥洗用《干安》。","郊庙朝会歌辞","四言",["有严大礼，对时休明。","情文则粲，蠲洁必清。","再临观盥，以专以精。","真游来格，永观厥成。"],0,"x207","宋"],["绍兴祭风师六首 其三 奠币用《容安》。","郊庙朝会歌辞","四言",["物之流形，甚畏瘥疠。","八风平矣，嘉生以遂。","丝缕之积，有量斯币。","惟本之报，匪物之贵。"],0,"x207","宋"],["干德以后祀感生帝十首 太保行用《保安》。","郊庙朝会歌辞","四言",["衣冠俨若，步武有容。","公卿济济，率礼惟恭。"],0,"x207","宋"],["理宗明堂前朝享二首 其二 酌献用《考安》。","郊庙朝会歌辞","四言",["假哉皇考，必世后仁。","嘉靖我邦，与物皆春。","之纯之德，克配穹旻。","馀庆渊如，佑我后人。"],0,"x207","宋"],["绍兴祀先农摄事七首 其二 初献升殿用《同安》。盥洗同。","郊庙朝会歌辞","四言",["率职咸涖，礼容睟然。","澡身端意，陟降靡愆。","神心嘉虞，飨兹洁蠲。","敷锡纯佑，屡登丰年。"],0,"x207","宋"],["大晟府拟撰释奠十四首 邹国公位酌献用《成安》。","郊庙朝会歌辞","四言",["道之由兴，于皇宣圣。","惟公之传，人知趋正。","与飨在堂，情文实称。","万年承休，假哉天命。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 还位用《干安》。圣祖位酌献用《祖安》，高宗御制，见前。","郊庙朝会歌辞","四言",["皇帝瑞庆，长发其祥。","纂系悠远，溯源灵长。","德之克明，休烈有光。","配天作极，孝飨是将。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 送真用《太安》。","郊庙朝会歌辞","四言",["云车风马，灵其来游。","天门轶荡，神其莫留。","遗庆阴阴，祉发祥流。","康我有宋，与天匹休。"],0,"x207","宋"],["祗奉天书六首 含芳园用《瑞安》。","郊庙朝会歌辞","四言",["运格熙盛，将封介丘。","礼神之域，瑞命殊尤。","灵文荐降，丕显皇猷。","圣心肃奉，永洽鸿休。"],0,"x207","宋"],["上明达皇后册宝五首 其五 送神用《歆安》。","郊庙朝会歌辞","四言",["备成熙事，虚徐翠楹。","神保聿归，云车夙征。","鉴我休德，神交惚恍。","留祉降祥，千秋是享。"],0,"x207","宋"],["宁宗朝享三十五首 哲宗室用《重光》。","郊庙朝会歌辞","四言",["于皇我宋，世有哲明。","元祐用人，遹骏有声。","绍述先志，思监于成。","受天之祜，王配于京。"],0,"x207","宋"],["黎解元庄严观音像见而赞之","郑刚中","四言",["端严净妙，具慈悲相。","广大智慧，具慈悲心。","菩萨之心，如月在水。","水性无边，照亦不已。","我同众生，恭仰相貌。","誓同一切，行菩萨道。"],0,"x99","宋"],["淳祐祭海神十六首 亚、终献用《飨安》。","郊庙朝会歌辞","四言",["笾豆有楚，贰觞斯旅。","神其醉饱，式燕以序。","百灵秘怪，蜿蜒飞舞。","锡我祺祥，有永终古。"],0,"x207","宋"],["熙宁祀皇地祇十二首 其十二 送神用《阜安》。","郊庙朝会歌辞","四言",["神兮来下，享此苾芬。","酌献雍雍，执事孔勤。","神之还矣，忽乘飞云。","遗我祺祥，物象忻忻。"],0,"x207","宋"],["景祐释奠武成王六首 其二 太尉升降用《同安》。","郊庙朝会歌辞","四言",["上公摄事，衮服斯皇。","礼容济济，佩响锵锵。","灵斿惚恍，嘉荐令芳。","神具醉止，降福穰穰。"],0,"x207","宋"],["景祐元年亲享景灵宫二首 其一 降真用《太安》。","郊庙朝会歌辞","四言",["真馆奉币，洁齐致馨。","灵因斯格，社稷庆宁。"],0,"x207","宋"],["景祐元年亲享景灵宫二首 其二 送真用《太安》。","郊庙朝会歌辞","四言",["椒浆尊享，珍馔精祈。","睟容杳邈，瑶辂霞飞。"],0,"x207","宋"],["皇太后回銮颂","吴𣓨","四言",["于皇睿明，运符中兴。","绵宇肃清，干夷坤宁。","孝思兢兢，交三圣灵。","惟我文母，远征朔土。","苍旻眷顾，显持阴护。","爰居爰处，储降祉祜。","睿明绍休，匪豫匪游。","人谋鬼谋，迎亲是求。","夜靡安席，昼靡安几。","宸心窃至，迎亲是议。","皇帝曰咨，命尔辅臣。","朕有大计，储思唯亲。","辅臣稽首，对扬圣志。","惟断乃成，愿破群议。","皇穹隆赫，鉴兹至德。","风行万国，耸动蛮貊。","诞扬天声，四征弗克。","敌人震惊，稽颡寻盟。","遣使旁午，愿旋銮辂。","稽考旷古，且未曾睹。","帝曰休哉，大庆鼎来。","喧传九垓，疾如惊雷。","迺严法驾，迺饰次舍。","千舆万马，出疆以迓。","文母在远，雷剥曰舒。","六龙驾辇，陟𪩘嵩呼。","济彼洪流，天星翼舟。","微波聿收，瑞气横秋。","文母遄临，千官则仪。","欢声戴驰，霆震风飞。","銮车至止，幅璬咸喜。","丕照盛美，实天所启。","有汉高祖，安忍无亲。","与言分羹，实忝前闻。","有唐德宗，求之莫获。","莫享天心，实有惭德。","惟我皇上，圣孝绝伦。","念兹在兹，虞舜周文。","韪哉鸿休，卓绝殊尤。","二圣重欢，亿万斯秋。","究观自昔，发挥伟绩。","有颂有诗，以诏无极。","睠兹日月，宁容图绘。","小臣献颂，乐府是配。"],0,61,"宋"],["宁宗郊前朝献景灵宫二十四首 亚献用《冲安》。","郊庙朝会歌辞","四言",["光𤈶紫幄，神流玉房。","秉文侑仪，嘉虞贰觞。","震澹醉喜，彷佛迪尝。","璇源之休，地久天长。"],0,"x207","宋"],["绍兴祀大火十二首 宣明王位酌献用《祐安》。","郊庙朝会歌辞","四言",["谁其祀神，知神嗜好。","阏伯祀火，为神所劳。","眷言配食，既与火俱。","于乐旨酒，承神嘉虞。"],0,"x207","宋"],["紫溪庄舍读癸丑壁间旧题转眼忽十八年同游十不存一滋兰弟亦作古人拂拭洒涕几不能去因诵欧公诗云人昔共游今有几树犹如此我何堪以是为韵感怀成十四章庚午四月中澣  其一一","刘学箕","四言",["少生四方，游紫之水。","每有良朋，见止遇止。","长哦伐木，求友乎此。","乐以忘忧，云胡不喜。"],0,98,"宋"],["祭九鼎十二首 其四 春分，苍鼎亚、终献用《成安》。","郊庙朝会歌辞","四言",["法干刚兮，铸鼎奠方。","涓嘉旦兮，齐明迎祥。","胡为持币，维箱及筥。","胡为和羹，有锜维釜。"],0,"x207","宋"],null,null,["淳祐祭海神十六首 西海位奠玉币用《润安》。","郊庙朝会歌辞","四言",["蒲昌之泽，派引天潢。","羲娥出入，浩渺微茫。","盖高斯覆，犹隔封疆。","我思六合，肇正吉昌。"],0,"x207","宋"],["淳祐祭海神十六首 北海位奠玉币用《瀚安》。","郊庙朝会歌辞","四言",["瀚海重润，地纪亦归。","吞受百渎，限制北陲。","一视同仁，我心则怡。","嘉荐玉币，神其格思。"],0,"x207","宋"],["真定府路兵马都钤辖刘公","《靖康小雅》作者","四言",["将军死绥，古人所长。","有如刘公，与城俱亡。","兵挐常山，公以身当。","生竭其勇，力挫戎行。","天未悔祸，敌势益张。","公虽瞑目，万古传芳。"],0,91,"宋"],["淳祐祭海神十六首 东海位酌献用《熙安》。","郊庙朝会歌辞","四言",["沧溟之德，东南具依。","熬波出素，国计攸资。","石臼却敌，济我王师。","神其享锡，益畀燕绥。"],0,"x207","宋"],["高宗郊祀前朝享太庙三十首 其十七 徽宗室用《承元》。御制。","郊庙朝会歌辞","四言",["于皇烈考，道化圣神。","尧聪舜孝，文恬武忻。","命子出震，遗骏上宾。","罔极之哀，有古莫伦。"],0,"x207","宋"],["真宗汾阴礼毕亲谢元德皇后室三首 其三 送神用《理安》。","郊庙朝会歌辞","四言",["鸾骖复整，鹤驾难留。","白云缥缈，紫府深幽。","庙虽载止，神无不游。","垂佑皇宋，以永鸿休。"],0,"x207","宋"],["冬至孟春孟夏季秋四祀上公摄事七首 饮福用《广安》。","郊庙朝会歌辞","四言",["簠簋既陈，吉蠲登荐。","洗心防邪，肃祗祭典。","陟降惟寅，笾豆有践。","百福咸宜，淳耀丕显。"],0,"x207","宋"],["崇恩太后升祔十四首 罍洗用《嘉安》。","郊庙朝会歌辞","四言",["列爵陈俎，芬芳和羹。","𪭢金击石，洋洋和声。","礼行伊始，我德惟明。","既盥而往，于昭斯诚。"],0,"x207","宋"],["绍兴释奠武成王七首 其四 正位酌献用《成安》。","郊庙朝会歌辞","四言",["赫赫尚父，时维鹰扬。","神潜韬略，襟抱帝王。","谈笑致主，竹帛流芳。","国有严祀，载稽典常。"],0,"x207","宋"],["真宗御制二首 其二 亚献、终献用《平晋乐》。","郊庙朝会歌辞","四言",["五代衰替，六合携离。","封疆窃据，兵甲竞驰。","天顾黎献，涂炭可悲。","帝启灵命，浚哲应期。","皇祖丕变，金钺俄麾。","率土执贽，犷俗来仪。","瞻彼大卤，窃此馀基。","独迷文告，莫畏天威。","神宗继统，璇图有辉。","尚安蠢尔，罔怀格思。","六飞夙驾，万旅奉辞。","徯来发咏，不阵行师。","云旗先路，壶浆塞岐。","天临日照，宸虑通微。","前歌后舞，人心悦随。","要领自得，智力何施。","风移僭冒，政治淳熙。","书文混一，盛德咸宜。","干戈倒载，振振言归。","诞昭七德，永定九围。"],0,"x207","宋"],["高宗郊前朝献景灵宫二十一首 其十五 饮福用《报安》。","郊庙朝会歌辞","四言",["嘉荐既终，神贶斯复。","赉我思成，灵光下烛。","孝孙承之，载祗载肃。","敷锡庶民，函蒙祉福。"],0,"x207","宋"],["淳祐祭海神十六首 北海位酌献用《溥安》。","郊庙朝会歌辞","四言",["倏忽会同，裴回安留。","牲肥酒香，晨事聿修。","惟德之凉，曷奄九州。","帝命是祗，多福自求。"],0,"x207","宋"],null,["熙宁蜡祭十三首 其十二 亚、终献用《曼安》。","郊庙朝会歌辞","四言",["林林生民，含哺而嬉。","教之稼穑，实神之为。","图报厚德，万祀无期。","以假以享，锡我繁禧。"],0,"x207","宋"],["得梁溪家问足慰远怀因和渊明答庞参军之作","李纲","四言",["剥啄叩门，梁溪有书。","发函读之，远怀以娱。","长少童稚，咸安其居。","森然满前，如返我庐。","一书可宝，万金非珍。","契阔寤叹，乃兹相亲。","鹊不吾欺，鸣以告人。","载询仆夫，以及其邻。","嗟我诸季，鸡鸣孜孜。","左图右书，中心好之。","山川修阻，贻我以诗。","三复佳句，实慰所思。","翩翩鸿雁，暂聚亟分。","岂无他人，非我所欣。","清宵步月，白日看云。","无遐迩心，好音数闻。","昔我之来，𫛸鴂将鸣。","今也岁晏，霜露载零。","言念沙漠，有怀玉京。","终夕不寐，群生未宁。","怅望东吴，慨临西风。","愿化独鹤，烟霄可冲。","敬慎威仪，惟以令终。","黄发为期，其爱尔躬。"],0,"x136","宋"],["五龙六首 其六 送神用《登安》。","郊庙朝会歌辞","四言",["灵之来下，以雨先驱。","灵之旋驭，五云结车。","操环应夏，发匣瑞虞。","真人在御，来献珍符。"],0,"x207","宋"],["高宗郊前朝献景灵宫二十一首 其十八 送真用《太安》。","郊庙朝会歌辞","四言",["雍歌既彻，熙事备成。","神夕奄虞，忽乘青冥。","灵心回眷，监我精禋。","诞降嘉祉，休德昭清。"],0,"x207","宋"],["绍兴释奠武成王七首 其二 初献升殿用《同安》。","郊庙朝会歌辞","四言",["肃肃庙中，有严阶墄。","匪棘匪徐，进退可则。","冕服是仪，环佩有节。","神之鉴观，率履不越。"],0,"x207","宋"],null,["玉清昭应宫上尊号三首 其三 二圣殿奉绛纱袍用《登安》。","郊庙朝会歌辞","四言",["赫赫列圣，盛德巍然。","彤彤灵宇，睟仪在焉。","奉以龙衮，被之象天。","重庆宗稷，亿万斯年。"],0,"x207","宋"],["先蚕六首 其二 升降用《翊安》。","郊庙朝会歌辞","四言",["掩抑笙箫，铿谹金石。","神来宴娭，嘉我休德。","奉祀之臣，洗心翊翊。","锡兹福禧，以惠四国。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 奠币用《吉安》。配位同。","郊庙朝会歌辞","四言",["神宅于幽，𣅺𣅺沈沈。","至和塞明，考我德音。","神听静嘉，俨乎若临。","币以荐诚，敢有弗钦。"],0,"x207","宋"],["高宗郊前朝献景灵宫二十一首 其二十 望燎用《干安》。","郊庙朝会歌辞","四言",["奕奕灵宫，有严毖祀。","燔燎具扬，礼仪既备。","帝心肃祗，天步旋止。","对越在天，永膺蕃祉。"],0,"x207","宋"],["大观祭风师六首 其四 酌献用《雍安》。","郊庙朝会歌辞","四言",["牺尊斯陈，清酤盈中。","芬芬苾苾，馨香交通。","明灵来思，歆我精衷。","维千万祀，品物芃芃。"],0,"x207","宋"],["大晟府拟撰释奠十四首 升殿用《同安》。","郊庙朝会歌辞","四言",["诞兴斯文，经天纬地。","功加于民，实千万世。","笙镛和鸣，粢盛丰备。","肃肃降登，歆兹秩祀。"],0,"x207","宋"],["紫溪庄舍读癸丑壁间旧题转眼忽十八年同游十不存一滋兰弟亦作古人拂拭洒涕几不能去因诵欧公诗云人昔共游今有几树犹如此我何堪以是为韵感怀成十四章庚午四月中澣  其一","刘学箕","四言",["维昔旧游，十有八春。","中间往来，合散风尘。","词翰在壁，瞻之愈新。","忆我仲弟，眇然怀人。"],0,98,"宋"],["紫溪庄舍读癸丑壁间旧题转眼忽十八年同游十不存一滋兰弟亦作古人拂拭洒涕几不能去因诵欧公诗云人昔共游今有几树犹如此我何堪以是为韵感怀成十四章庚午四月中澣  其二","刘学箕","四言",["吁嗟人生，年不满百。","天地囿形，百代过客。","去日苦多，来日苦窄。","我曷不乐，慨念畴昔。"],0,98,"宋"],["紫溪庄舍读癸丑壁间旧题转眼忽十八年同游十不存一滋兰弟亦作古人拂拭洒涕几不能去因诵欧公诗云人昔共游今有几树犹如此我何堪以是为韵感怀成十四章庚午四月中澣  其一○","刘学箕","四言",["忆自束发，兹焉寓居。","载思载瞻，宛不异初。","极目遐眺，清风穆如。","抚事怀人，悲来感余。"],0,98,"宋"],["紫溪庄舍读癸丑壁间旧题转眼忽十八年同游十不存一滋兰弟亦作古人拂拭洒涕几不能去因诵欧公诗云人昔共游今有几树犹如此我何堪以是为韵感怀成十四章庚午四月中澣  其一三","刘学箕","四言",["念昔考槃，硕人之薖。","琴豆觞酒，寤寐笑歌。","逝者弗返，涕泗滂沱。","念彼不乐，伤如之何。"],0,98,"宋"],["紫溪庄舍读癸丑壁间旧题转眼忽十八年同游十不存一滋兰弟亦作古人拂拭洒涕几不能去因诵欧公诗云人昔共游今有几树犹如此我何堪以是为韵感怀成十四章庚午四月中澣  其一四","刘学箕","四言",["贤乎仲弟，和乐且湛。","自我不见，岁籥换三。","百感交集，忧心如惔。","山凝暮云，回首不堪。"],0,98,"宋"],["淳祐祭海神十六首 南海位酌献用《贵安》。","郊庙朝会歌辞","四言",["南溟浮天，旁通百蛮。","风樯迅疾，琛舶来还。","民商永赖，坐消寇奸。","荐兹嘉觞，弭矣惊澜。"],0,"x207","宋"],["宁宗郊祀二十九首 还内用《干安》。","郊庙朝会歌辞","四言",["八神呵跸，千官景从。","回轸还衡，祲威盛容。","妥饰芝凤，御朝云龙。","归寿慈闱，敷时民雍。"],0,"x207","宋"],["祭九鼎十二首 其九 秋分，皛鼎亚、终献用《成安》。","郊庙朝会歌辞","四言",["神宫巍巍，庭燎有辉。","声谐备乐，物陈丰仪。","清酤既载，酌言献之。","惟神醉止，聿来蕃厘。"],0,"x207","宋"],["行者了宽等题钱买度牒疏四章 其一","李昴英","四言",["已办僧心，未圆僧相。","才得方兄，便成和尚。"],0,124,"宋"],["高宗明堂前朝献景灵宫十首 其五 圣祖位酌献用《祖安》。","郊庙朝会歌辞","四言",["裴回若留，灵其有喜。","荐我馨香，挹兹酒醴。","我祖在天，执道之纪。","申佑无疆，奏神称礼。"],0,"x207","宋"],["高宗郊前朝献景灵宫二十一首 其十七 彻馔用《吉安》。","郊庙朝会歌辞","四言",["普淖既荐，苾芬孔时。","神嗜而顾，有来燕娭。","飨矣将彻，载钦载祗。","展诗以侑，益臻厥熙。"],0,"x207","宋"],["真宗汾阴礼毕亲谢元德皇后室三首 其一 迎神用《肃安》。","郊庙朝会歌辞","四言",["閟宫奕奕，韶乐洋洋。","牲币虔布，几筵肃张。","醴泉淳美，嘉肴洁香。","俟神来格，降彼帝乡。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 北方百神迎神用《简安》。","郊庙朝会歌辞","四言",["荡荡阃决，气清泬寥。","彷佛象舆，丽于穹霄。","蹇其来下，肃然风票。","神乎安留，于焉消摇。"],0,"x207","宋"],["五龙六首 其四 酌献用《恺安》。","郊庙朝会歌辞","四言",["练吉日兮，进神之堂。","牲既陈兮，粢盛既香。","奠桂酒兮，容与嘉觞。","灵安留兮，锡我福祥。"],0,"x207","宋"],["枢相宣抚虞公寿雅 汉清 其一○","王质","四言",["公发勿华，我生则遐。","吁彼苍天，佑我皇家。"],0,"x37","宋"],["真宗奉圣祖玉清昭应宫十一首 其七 太宗位酌献用《庆安》。","郊庙朝会歌辞","四言",["明明文考，储精上苍。","礼乐明备，溥率宾王。","功德累洽，历数会昌。","孝思罔极，丕祐无疆。"],0,"x207","宋"],["太极观奉册宝一首 《登安之曲》。","郊庙朝会歌辞","四言",["荐号穹冥，登名祖祢。","陟配阳郊，协宣典礼。","感电灵区，诞圣鸿懿。","册宝斯陈，福禄来暨。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 夜明位奠玉币用《钦安》。","郊庙朝会歌辞","四言",["穆穆太阴，礼严姊事。","璧玉华光，推以裒对。","十二周天，岁乃有终。","尽我备物，莫报元功。"],0,"x207","宋"],["余筑室梁溪之上三年而后成手植花木甚众遭值世故未尝得安居其间岁暮羁旅慨然念之因和渊明时运诗以见意","李纲","四言",["卜宅梁溪，成非一朝。","面山枕冈，远市近郊。","修竹茂林，翠连烟霄。","松桂吐香，杞菊长苗。","旁临清流，尘缨可濯。","小阁崷然，九峰远瞩。","岂无华宇，于我自足。","兄弟埙篪，于焉相乐。","春服既成，如浴乎沂。","风乎舞雩，咏啸而归。","自我离群，潜然涕挥。","拊心念旧，电往莫追。","今夕何夕，梦还我庐。","稚子候门，两发髧如。","携幼入室，浊酒倾壶。","慨我寤叹，谁复如余。"],0,"x136","宋"],["绍兴祀大火十二首 荧惑位酌献用《祐安》。","郊庙朝会歌辞","四言",["皇念有神，介我戬谷。","登时休明，有此美禄。","酌言献之，有𫗣其香。","神兮燕娭，醉此嘉觞。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 南方百神迎神用《简安》。","郊庙朝会歌辞","四言",["维物之精，散乎太空。","维索之飨，合聚而同。","乃击土鼓，于岁之终。","格彼幽矣，肸蚃其通。"],0,"x207","宋"],["明道元年章献明肃皇太后朝会十五首 皇太后升坐用《圣安》。","郊庙朝会歌辞","四言",["圣母有子，重光类禋。","圣皇事母，感极天人。","百辟在庭，九仪具陈。","礼容之盛，万国咸宾。"],0,"x207","宋"],["明道元年章献明肃皇太后朝会十五首 公卿入门用《礼安》。","郊庙朝会歌辞","四言",["帝率四海，承颜尽恭。","端闱肃设，群后来同。","玉佩锵鸣，衣冠有容。","英韶节步，磬管雍雍。"],0,"x207","宋"]]