[["新渠诗 其二","苏轼","四言",["新渠之田，在渠左右。","渠来奕奕，如赴如凑。","如云斯积，如屋斯溜。","嗟唐之人，始识粳稌。"],0,"x67","宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其三","郊庙朝会歌辞","四言",["太任媚姜，涂山翼禹。","慈祥曼衍，鸿仪迭举。","宝章奕奕，祲宫俣俣。","帝用将之，于彼宫所。"],0,"x207","宋"],["六句偈六首 其二 后念是圣","释清远","四言",["后念是圣，一拳打正。","干戈丛里，拾得性命。"],0,116,"宋"],["祭双杉塔","释善珍","四言",["甲午之冬，一笑分袂。","交游累千，名字难记。","公虽它乡，常在眼底。","公今隔世，犹见梦寐。","念昔与公，情同昆弟。","老离闽山，再饮吴水。","三十年间，死尽流辈。","顾瞻浮图，洪木翳翳。","丛林凋疏，变习日异。","愿起公死，为砭为剂。","为师为承，为祥为瑞。","千载追难，百年满易。","意长景促，人往物是。","春寒野阴，感慨歔欷。"],0,45,"宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其四","郊庙朝会歌辞","四言",["东朝层邃，端闱靖深。","列仗节銮，镂玉绳金。","来奉来崇，载祗载钦。","曾孙之庆，世世徽音。"],0,"x207","宋"],["淳熙十六年皇后册宝十三首 其四","郊庙朝会歌辞","四言",["鼓钟喤喤，磬筦锵锵。","剑佩充庭，济济洋洋。","礼典告备，皇心乐康。","于万斯年，受福无疆。"],0,"x207","宋"],["嘉泰三年皇后册宝十三首 其十","郊庙朝会歌辞","四言",["服焕盛仪，班分华致。","九嫔妇职，六寝内治。","参差荇菜，求勤寤寐。","烝然来思，相礼赞祭。"],0,"x207","宋"],["偈颂五十一首 其一","释道冲","四言",["我此一门，全无肯路。","是汝诸人，如何进步。"],0,206,"宋"],["偈","释慧昌","四言",["担板老翁，性本虚空。","永劫不死，明月清风。"],0,19,"宋"],["自适吟","邵雍","四言",["郏鄏城中，凤凰楼下；","风月庭除，莺花台榭。","时和岁丰，闲行静坐；","朋好身安，清吟雅话。"],0,"x57","宋"],["太常乐章三十首 其十 酌献第六室奏大盛之舞曲","杨亿","四言",["穆穆太宗，与天合德。","昧旦丕显，干干翼翼。","敷祐下民，时帝之力。","永怀圣神，孝思罔极。"],0,"x47","宋"],["陈尊宿赞","惠洪","四言",["云门临济，一龙一夔。","嗣存参运，皆公使之。","丛林米岭，众不满百。","佥一典客，觉有难色。","即袖手去，古寺闲房。","织屦养母，自含其光。","钦其遗风，秋满须发。","唯不少贬，是真宏法。"],0,"x42","宋"],["有客","林季仲","四言",["有客有客，托于空谷。","问何以乐，乐彼幽独。","矫矫其松，藋藋其竹。","微风过之，泠然成曲。","岁曰莫止，霰雪交挥。","谁与晤语，怀我人斯。","我之怀矣，褰裳从之。","泥淖伊阻，中心怅而。","岂无他人，以翱以翔。","意气所亲，不能弭忘。","遥遥遗绪，久矣弗扬。","之子之秀，吾宗之光。","我有薄酒，子试歠兮。","雪霁江明，共此月兮。","企焉新诗，到蛰窟兮。","老子鬅鬙，正愁绝兮。"],0,160,"宋"],["华药英禅师赞","惠洪","四言",["以铁作喙，名无有双。","老住回雁，道冠湘江。","神机之妙，如钟在撞。","为功德林，为精进幢。","不动声气，天魔自降。","怀我云庵，黄龙的嗣。","说法如云，纵横放肆。","孰知此老，胆气相似。","大法付授，良亦在此。","是名关西，克家之子。"],0,"x42","宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其六","郊庙朝会歌辞","四言",["神人和怿，天日淑清。","王母来燕，必寿而名。","琨庭璈音，五云佩声。","勉勉我皇，遹昭厥成。"],0,"x207","宋"],["偈颂一百六十九首 其一","释智朋","四言",["不立孤危，了无藏覆。","掉臂因行，推门入臼。"],0,18,"宋"],["皇帝冬至御大庆殿举第二盏酒奏嘉禾之曲","王珪","四言",["太平之符，昭发众瑞。","爰有嘉禾，异陇合穗。","大田如云，既获既刈。","野人愉愉，不亦有岁。"],0,"x35","宋"],["新渠诗 其三","苏轼","四言",["新渠之民，自淮及潭。","挈其妇姑，或走而颠。","王命赵侯，宥我新民。","无与王事，以讫七年。"],0,"x67","宋"],["偈颂一百六十九首 其三","释智朋","四言",["北郁单越，西瞿耶尼。","有利无利，不离行市。"],0,18,"宋"],["庆历圣德颂","石介","四言",["于维庆历，三年三月。","皇帝龙兴，徐出闱闼。","晨坐太极，昼开阊阖。","躬揽英贤，手锄奸蘖。","大声沨沨，震摇六合。","如干之动，如雷之发。","昆虫蹢躅，妖怪藏灭。","同明道初，天地嘉吉。","初闻皇帝，戚然言曰。","予父予祖，付予大业。","予恐失坠，实赖辅弼。","汝得象殊，重慎徽密。","君相予久，予嘉君伐。","君仍相予，笙镛斯协。","昌朝儒者，学问该洽。","与予论政，傅以经术。","汝贰二相，庶绩咸秩。","惟汝仲淹，汝诚予察。","太后乘势，汤沸火热。","汝时小臣，危言嶪嶪。","为予司谏，正予门𫔶。","为予京兆，堲予谗说。","贼叛于夏，为予式遏。","六月酷日，大冬积雪。","汝暑汝寒，同于士卒。","予闻辛酸，汝不告乏。","予晚得弼，予心弼悦。","弼每见予，无有私谒。","以道辅予，弼言深切。","予不尧舜，弼自笞罚。","谏官一年，奏疏满箧。","侍从周岁，忠力尽竭。","契丹亡义，梼杌饕餮。","敢侮大国，其辞慢悖。","弼将予命，不畏不慑。","卒复旧好，民得食褐。","沙碛万里，死生一节。","视弼之肤，霜剥风裂。","观弼之心，炼金锻铁。","宠名大官，以酬劳渴。","弼辞不受，其志莫夺。","惟仲淹弼，一夔一契。","天实赉予，予其敢忽。","并来弼予，民无瘥札。","曰衍汝来，汝予黄发。","事予二纪，毛秃齿豁。","心如一兮，率履弗越。","遂长枢府，兵政毋蹶。","予早识琦，琦有奇骨。","其器魁櫑，岂视扂楔。","其人浑朴，不施剞劂。","可属大事，敦厚如勃。","琦汝副衍，知人予哲。","惟修惟靖，立朝𪩘𪩘。","言论磥砢，忠诚特达。","禄微身贱，其志不怯。","尝诋大臣，亟遭贬黜。","万里归来，刚气不折。","屡进直言，以补予阙。","素相之后，含忠履洁。","昔为御史，几叩予榻。","至今谏疏，在予箱匣。","襄虽小臣，名闻予彻。","亦尝献言，箴予之失。","刚守粹悫，与修俦匹。","并为谏官，正色在列。","予过汝言，无钳汝舌。","皇帝明圣，忠邪辨别。","举擢俊良，扫除妖魃。","众贤之进，如茅斯拔。","大奸之去，如距斯脱。","上倚辅弼，司予调燮。","下赖谏诤，维予纪法。","左右正人，无有邪孽。","予望太平，日不逾浃。","皇帝嗣位，二十二年。","神武不杀，其默如渊。","圣人不测，其动如天。","赏罚在予，不失其权。","恭己南面，退奸进贤。","知贤不易，非明不得。","去邪惟难，惟断乃克。","明则不贰，断则不惑。","既明且断，惟皇之德。","群下踧踖，重足屏息。","交相告语，曰惟正直。","毋作侧僻，皇帝汝殛。","诸侯危栗，坠玉失舄。","交相告语，皇帝神明。","四时朝觐，谨修臣职。","四夷走马，坠镫遗策。","交相告语，皇帝神武。","解兵修贡，永为属国。","皇帝一举，群臣慑焉。","诸侯畏焉，四夷服焉。","臣愿陛下，寿万千年。"],0,105,"宋"],["皇雅十首  其二三","尹洙","四言",["帝制万邦，罔有弗宾。","蛮夷戎狄，羁而勿臣。","威格三方，稽颡献珍。","单于革心，愿交使人。"],0,108,"宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其二十","郊庙朝会歌辞","四言",["天地清宁，日月华光。","归尊慈极，嵩呼未央。","庆函百嘉，寿跻八荒。","上皇万岁，俾炽俾昌。"],0,"x207","宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其八","郊庙朝会歌辞","四言",["徽光宣华，仁声流文。","旷仪合沓，泰和𬘡缊。","慈颜有喜，祚我圣君。","珠宫含饴，坐阅来云。"],0,"x207","宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其九","郊庙朝会歌辞","四言",["缛仪既登，宝册既膺。","喜洽祥流，云烝川增。","天子万年，鸣玉慈庭。","惠我无疆，诜诜绳绳。"],0,"x207","宋"],["偈颂一百四十一首 其一","释师范","四言",["前三后三，今日明日。","达磨不会，九年面壁。"],0,"x155","宋"],["娶妻吟","邵雍","四言",["人之娶妻，容德威仪。","傥或生子，不皋则夔。"],0,"x57","宋"],["赞三祖","释守卓","四言",["白衣受道，瘥病非药。","无欠无馀，有锤有凿。","觅解脱门，汝为谁缚。"],0,42,"宋"],["太常乐章三十首 其四 迎俎奏丰安之曲","杨亿","四言",["丽碑割牲，以炰以烹。","博硕肥腯，荐羞神明。","祖考来格，享于克诚。","如闻謦欬，式燕以宁。"],0,"x47","宋"],["太常乐章三十首 其十八 迎俎奏丰安之曲","杨亿","四言",["有牲斯纯，有俎斯陈。","柔嘉登荐，昭事惟寅。"],0,"x47","宋"],["流水  其三","黄庭坚","四言",["汤汤流水，可以休兮。","嗟行之人，则濯足兮。"],0,"x66","宋"],["颜鲁公画像赞","李纲","四言",["英英鲁公，人中之龙。","为唐宗臣，见危纳忠。","巨盗起燕，朔部风从。","独婴孤城，以抗其锋。","功虽不终，志实可则。","间关造朝，号为耆德。","纠缪绳愆，毅然正色。","奸邪媚之，摈使去国。","蹇蹇匪躬，险夷一节。","迨其耄年，奉使希烈。","气沮凶逆，诚贯金铁。","身虽可陨，名不可灭。","岩岩高堂，榜曰忠义。","非公遗像，其孰当置。","登斯堂者，宜仰而畏。","师友其人，无公是愧。"],0,"x136","宋"],["君子吟","邵雍","四言",["君子与义，小人与利；","与义日兴，与利日废。","君子尚德，小人尚力；","尚德树恩，尚力树敌。","君子作福，小人作威；","作福福至，作威祸随。","君子乐善，小人乐恶；","乐恶恶至，乐善善归。","君子好誉，小人好毁；","好毁人怒，好誉人喜。","君子思兴，小人思坏；","思兴召祥，思坏召怪。","君子好与，小人好求；","好与多喜，好求多忧。","君子好生，小人好杀；","好生道行，好杀道绝。"],0,"x57","宋"],["君子吟","邵雍","四言",["君子之去，亦如其来。","小人之来，亦如其去。","既有恩情，且无怨怒。","既有憎嫌，且无思慕。"],0,"x57","宋"],["多多吟","邵雍","四言",["天下居常，害多于利。","乱多于治，忧多于喜。","奈何人生，不能免此。","奈何予生，皆为外事。"],0,"x57","宋"],["偈颂六十八首 其二","释法薰","四言",["有路可行，更高也上。","须弥灯王，退身合掌。"],0,31,"宋"],["桐花散翁挽诗","王柏","四言",["瀫水之西，巍然一峰。","是曰道坚，翔舞而东。","林峦蓊蔚，丘壑浑融。","雍雍聚落，惟金之宗。","五世积累，钟此散翁。","散翁颀颀，生有异质。","学敏而博，心广而实。","乃孝乃睦，乃大其识。","教子一经，维宽而栗。","教人尽己，维久无斁。","选举法坏，取士以文。","决于一夫，升沈遂分。","良才美德，所甘隐沦。","负我求我，负人非人。","两语垂训，风俗反淳。","我之识翁，因翁二子。","典刑是亲，翼翼亹亹。","曾不几见，翁遽不起。","我来哭翁，亦已晚矣。","匍匐之义，真可愧死。","我既哭翁，亦相佳城。","千嶂矗矗，万壑沄沄。","一丘永閟，昭明上征。","万壑沄沄，千嶂矗矗。","子子孙孙，载昌载毓。"],0,"x137","宋"],["盛衰吟","邵雍","四言",["克肖子孙，振起家门。","不肖子孙，破败家门。","猗嗟子孙，盛衰之根。"],0,"x57","宋"],["五方帝 其十","郊庙朝会歌辞","四言",["白炜方肃，合宫孔硕。","琥以象象，神惟飨德。","升配有序，虔恭无斁。","降福穰穰，永安邦国。"],0,"x207","宋"],["偈颂六十八首 其一","释法薰","四言",["无门之门，七通八达。","入之一字，也不消得。"],0,31,"宋"],["偈颂十首 其四","释德光","四言",["世尊拈花，迦叶微笑。","一对铁槌，浑无孔窍。"],0,208,"宋"],["赞二祖","释守卓","四言",["断臂求师，平田失脚。","三拜依位，诚人得谑。","稽首高深，少峰伊洛。"],0,42,"宋"],["淳熙十六年皇后册宝十三首 其十","郊庙朝会歌辞","四言",["掖庭颁官，于位有四。","嘒彼小星，抚以德惠。","熙焉如春，育焉如地。","庆礼聿成，靡弗咸喜。"],0,"x207","宋"],["偈颂一百四十一首 其二","释师范","四言",["祖师巴鼻，衲僧巴鼻。","有些巴鼻，全没巴鼻。"],0,"x155","宋"],["偈颂一百二十三首 其一二○","释崇岳","四言",["端居丈室，青天白日。","窦八布衫，云门念七。"],0,222,"宋"],["淳熙十六年皇后册宝十三首 其五","郊庙朝会歌辞","四言",["懿范柔容，如月斯辉。","驾厥翟辂，被以袆衣。","九御从之，如云祁祁。","典册是承，心焉肃祗。"],0,"x207","宋"],["采菊  其一","黄庭坚","四言",["南山有菊，于采其英。","谁从汝往，视我惸惸。","伊时之人，谁适有比。","不与我谋，不知其已。"],0,"x66","宋"],["病起","释慧空","四言",["老僧头风，一月两发。","见粥便呕，见饭便哕。","死又不死，活又不活。","使他诸人，冷地忙杀。","观音势至，候饥候渴。","文殊普贤，左提右掇。","才方起来，便翻著袜。","不问是非，乃棒乃喝。","呵呵云门，君子可入。"],0,"x118","宋"],["堂成","苏辙","四言",["筑室三年，堂成可居。","我初不知，诸子劳劬。","父母老矣，风雨未除。","橐装几何，勿问有无。","伐木于山，因此旧庐。","不约不丰，燕处无馀。","堂开六楹，南北四筵。","昼明廓然，夜冥黯然。","四邻无声，布被粗毡。","身非蚌螺，一睡经年。","夜如何其，趺坐燕安。","善恶不思，此心自圆。","东厢靖深，以奉尝烝。","老佛之庐，朝香夜灯。","西厢千卷，图书之林。","先人所遗，子孙是承。","杖屦经行，直如引绳。","顾视而笑，此如我心。","诸子之室，左右吾背。","将食击板，一击而会。","瓜畦芋区，分布其外。","锄去瓦砾，壤而不块。","废井重浚，泉眼仍在。","辘轳雷鸣，甘雨时霈。","园夫能勤，家足于菜。","有客叩门，贺我堂成。","揖客而笑，念我平生。","三世读书，粗免躬耕。","明窗修竹，惟我与兄。","荫映茅茨，吐论峥嵘。","猖狂妄行，以得此名。","老而求安，匪以为荣。"],0,"x135","宋"],["示道光及安大师","王安石","四言",["春日载阳，陟彼高冈。","乐彼之园，维水泱泱。","维笋及蒲，既生既育。","拚飞维鸟，集于灌木。","嘤其鸣矣，乱我心曲。","有怀二人，在彼空谷。","既往既来，独寐寤宿。","陟则在𪩘，或降于阿。","瞻望弗及，伤如之何。"],0,"x48","宋"],["淳熙十六年皇后册宝十三首 其六","郊庙朝会歌辞","四言",["华榱璧珰，有馨椒殿。","备物来陈，多仪式焕。","曰册曰宝，是刻是瑑。","并举以行，皇矣懿典。"],0,"x207","宋"],["偈一百二十首 其五十六","释怀深","四言",["吾有一言，绝虑忘缘。","巧说不得，祇要心传。"],0,"x134","宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其一","郊庙朝会歌辞","四言",["天拥帝家，泽流子孙。","三宫燕胥，四海崇尊。","声谐韶濩，辉烛瑶琨。","维皇缉熙，耀德乾坤。"],0,"x207","宋"],["偈颂七十一首 其三十","释了惠","四言",["旧岁已去，去不可追。","新岁当来，来不可拒。"],0,62,"宋"],["绍兴祀岳镇海渎四十三首 其十七 亚、终献，酌献。","郊庙朝会歌辞","四言",["神之游兮，洋洋对越。","澹乎容与，肸蚃斯答。","乃奏既备，八音攸节。","重觞申陈，百礼以洽。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其二十四 亚、终献，酌献。","郊庙朝会歌辞","四言",["礼乐既成，肃容有常。","奄留消摇，申毕重觞。","仰胪所求，降福滂洋。","师象山则，以况皇章。"],0,"x207","宋"],["祫飨太庙 其二","郊庙朝会歌辞","四言",["皇矣烈祖，次于僖宫。","燕贻凭厚，德远而隆。","尊昭缀穆，合食惟丰。","孝孙奠爵，福嘏来同。"],0,"x207","宋"],["太常乐章三十首 其二十四 皇帝正冬御殿文舞第一","杨亿","四言",["八佾具陈，万邦有奕。","既以象功，又以观德。","进旅退旅，执籥秉翟。","玄化怀柔，远人来格。"],0,"x47","宋"],["猎较诗","王安石","四言",["猎较猎较，谁禽我有。","国人之惏，君子所丑。","猎较猎较，祭占其祥。","国人之序，君子何伤。"],0,"x48","宋"],["皇雅十首  其一一","尹洙","四言",["耆武定功，时惟二方。","淮服其乂，海南遂荒。","孰孱而盭，孰暴而猖。","自底不𬤝，乃终灭亡。"],0,108,"宋"],["宝祐二年皇子冠二十首 其十","郊庙朝会歌辞","四言",["帝子惟贤，懋昭厥德。","跪冠于房，玄冠有特。","鼓钟喤喤，威仪抑抑。","百礼既洽，祚我王国。"],0,"x207","宋"],["经世吟","邵雍","四言",["羲轩尧舜，汤武桓文；","皇王帝伯，父子君臣。","四者之道，理限于秦。","降及两汉，又历三分。","东西俶扰，南北纷纭。","五胡十姓，天纪几焚。","非唐不济，非宋不存。","千世万世，中原有人。"],0,"x57","宋"],["中原吟","邵雍","四言",["中原之师，仁义为主。","仁义既无，四夷来侮。"],0,"x57","宋"],["祫飨太庙 其三","郊庙朝会歌辞","四言",["清庙有严，观德惟祖。","裕典时修，亲尊并序。","以祼以献，礼交乐举。","灵其醉止，笃我纯祐。"],0,"x207","宋"],["明堂乐章二首 皇帝还大次憩安之曲","王安石","四言",["有奕明堂，万方时会。","宗予圣考，作帝之配。","乐酌虞典，礼从周制。","厘事既成，于皇来塈。"],0,"x48","宋"],["宝祐二年皇子冠二十首 其二十","郊庙朝会歌辞","四言",["爱始于亲，圣尽伦兮。","元子冠字，邦礼成兮。","天步舒徐，皇心宁兮。","家人之吉，亿万春兮。"],0,"x207","宋"],["嘉泰三年皇后册宝十三首 其三","郊庙朝会歌辞","四言",["瑶册玉宝，烂然瑞辉。","旁翼绛节，上承紫微。","璆鸣朝佩，徐出兽扉。","登进坤极，益彰典徽。"],0,"x207","宋"],["偈","僧某","四言",["因山见水，见水忘山。","山水俱忘，理归何所。"],0,42,"宋"],["贺刘仓使生朝  其二","曾丰","四言",["眷此良月，协此良序。","水德溥溥，羽音诩诩。","金曜在郑，对烛于鲁。","儒风妆鼓，乾坤煦妪。","武夷裒湑，生申及甫，且持汉斧。"],0,"x193","宋"],["太常乐章三十首 其十五 南郊降神奏高安之曲","杨亿","四言",["爰卜吉土，在国之阳。","肆类于帝，锡羡无疆。","备物致享，嘉生阜昌。","纯嘏昭答，长发其祥。"],0,"x47","宋"],["禅人并化主写真求赞 其四○二","释正觉","四言",["默成其性，慧润其定。","虚应六窗，观通三径。","善巧开权，触机堕阱。","怪杀者僧，药多成病。"],0,"x88","宋"],["偈颂一百四十一首 其三","释师范","四言",["灵山话月，曹溪指月。","递代相传，证龟成鳖。"],0,"x155","宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其二","郊庙朝会歌辞","四言",["祖后重寿，亲闱并崇。","骈庆联休，申景铺鸿。","叠璧交辉，多仪焕丛。","亿万斯年，福禄攸同。"],0,"x207","宋"],["水石图赞","赵文","四言",["故园松菊，归步月明。","萧然独往，百世之英。"],0,123,"宋"],["偈颂一百四十一首 其二十","释师范","四言",["谷熟豆熟，粥足饭足。","仰面看天，两手扪腹。"],0,"x155","宋"],["偈颂一百四十一首 其七十","释师范","四言",["纵无所畏，说大脱空。","虽有希求，辨最上供。"],0,"x155","宋"],["偈颂七十一首 其四十五","释了惠","四言",["石溪怒发，势不可遏。","大地平沈，虚空惨怛。"],0,62,"宋"],["太常乐章又七首 其四 朝日迎神","杨亿","四言",["阳德之母，羲御寅宾。","得天久照，首兹三辰。","正辞备物，肃肃振振。","沦精降鉴，克享明禋。"],0,"x47","宋"],["绍兴祀岳镇海渎四十三首 其八 亚、终献，酌献。四位并同。","郊庙朝会歌辞","四言",["我祀孔肃，神其安留。","容与裴回，若止若浮。","洽此重觞，申以百羞。","无我斁遗，万邦之休。"],0,"x207","宋"],["多事吟","邵雍","四言",["多事招忧，多疑招闷。","多与招吝，多取招损。"],0,"x57","宋"],["颂古十首 其三","释慧空","四言",["动弦别曲，叶落知秋。","拟议不来，休休休休。"],0,"x118","宋"],["流水  其二","黄庭坚","四言",["一溪之水，不杠而涉。","濡首中流，汝嗟何及。"],0,"x66","宋"],["力穑吟","邵雍","四言",["春时耕种，夏时耘耨。","秋时收治，冬时用受。","雨露不愆，既苗既秀。","水旱为灾，尚罹其咎。"],0,"x57","宋"],["雷亭四言","孔武仲","四言",["雷震于天，石陨于山。","石则何罪，龙殛石间。","容而不拒，石则有愆。","毋谓恢广，不察神奸。","想方震时，大雨溢川。","万里晦冥，风霆后先。","独恨不及，徙倚纵观。","睨而不惊，知神之全。","余后过之，间四十年。","乃记其始，以永其传。"],0,"x117","宋"],["偈颂一百二十三首 其一二二","释崇岳","四言",["两刃交锋，略通一线。","有耳者闻，有眼者见。"],0,222,"宋"],["题毛霆甫诗集 其三","文天祥","四言",["白云英英，涧水泱泱。","彼美人兮，硕大且昌。"],0,"x53","宋"],["李太白赞","李之仪","四言",["龙不可收，虎不可缚。","矫矫世路，彼自清浊。","醉遣脱靴，孰贵孰贱。","弄月沧波，万顷一线。","图画如好，虽曰糟粕。","对之超然，鲸尾欲捉。"],0,"x203","宋"],["和陶停云四首，并引 其二","苏轼","四言",["飓作海浑，天水溟蒙。","云屯九河，雪立三江。","我不出门，寤寐北窗。","念彼海康，神驰往从。"],0,"x67","宋"],["宋江三十六赞 其十一 船火儿张横","龚开","四言",["大行好汉，三十有六。","无此火儿，其数不足。"],0,103,"宋"],["偈颂二百零五首 其一九三","释正觉","四言",["诸见若尽，慎勿追寻。","才有是非，纷然失心。"],0,"x88","宋"],["盘居六章  其四","项安世","四言",["山之营营，众流所经。","彼盘之人，亦溥厥成。"],0,"x55","宋"],["园樱伤老也 其一","司马光","四言",["园有繁樱，圃有肥菁。","我酒既清，我殽既馨。","我友戾止，聊以娱情。","今我不乐，日月其径。","园有秾李，圃有肥杞。","我酒既旨，我殽既美。","我友戾止，改忧为喜。","今我不乐，年其有几。"],0,"x40","宋"],["中岩圜老像赞","陆游","四言",["我游中岩，拜师于床。","巍巍堂堂，凤举龙骧。","公住无为，访我成都。","雄辩纵横，玉色敷腴。","别未十日，梁木告摧。","我如飞蓬，万里南来。","孰谓穷山，乃瞻仪形。","墙壁说法，况此丹青。"],0,"x41","宋"],["偈颂一百四十一首 其八","释师范","四言",["瞿昙瞬目，迦叶破颜。","山僧闻得，咬定牙关。"],0,"x155","宋"],["土木偶人","邵雍","四言",["土木偶人，慎无相笑。","天将大雨，止可相吊。"],0,"x57","宋"],["和陶命子韵示津调官 其一","吴芾","四言",["我爱二龚，绝胜二唐。","克著清节，终始有光。","夫岂不知，伊傅在商。","相汤洎高，俱致明昌。"],0,"x95","宋"],["文武吟","邵雍","四言",["既为文士，必有武备。","文武之道，皆吾家事。"],0,"x57","宋"],["四偈 其一","惠洪","四言",["妒忌之火，焚烧善根。","增恶果报，坏好名闻。","以著我故，见慢增胜。","瞋所盖缠，心不清净。","大则坏国，小则杀身。","从古至今，数如沙尘。","既会爱憎，当衣慈忍。","如是进者，名真随顺。"],0,"x42","宋"],["皇雅十首  其三","尹洙","四言",["淮潞弗虔，卒污叛迹。","戎辂戒严，皇威有赫。","彼寇诖民，吾勇其百。","殄厥渠魁，贷其反侧。"],0,108,"宋"],["皇雅十首  其二八","尹洙","四言",["皇底其治，钦哉惟刑。","在疑而宥，罔察为明。","爱怒弗肆，孰为重轻。","毋一弗辜，惟典之平。"],0,108,"宋"],["思归操","薛季宣","四言",["彼美鸠雏，归晡呜呜。","所哺伊何，曰父母且。","匪生何父，匪育何母。","历山之居，居庸可久。","念念思归，不归何俟。"],0,"x194","宋"]]