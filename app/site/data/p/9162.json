[null,null,null,["送春日潘亚日黄农父陈元孝过饮南园","梁宪","五言律诗",["林静落黄梅，迟花应候开。","昼长闲睡足，酒熟故人来。","把袂忘言笑，看云共举杯。","醉歌惊鸟散，月上更登台。"],0,87,"明"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["都昌怀旧隐二首 其一","魏观","五言律诗",["西斋风月好，庭草到阶前。","春服趋童冠，秋声杂诵弦。","题诗黄叶上，拄笏白云边。","俯仰成今古，离愁为黯然。"],0,46,"明"]]