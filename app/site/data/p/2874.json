[["疏古","释重显","四言",["我有面镜，到处悬挂。","凡圣不来，谁上谁下。"],0,"x156","宋"],["不同吟","邵雍","四言",["求者不得，辞者不能。","二者相去，其远几程。"],0,"x57","宋"],["太常乐章三十首 其二 皇帝行奏隆安之曲","杨亿","四言",["祼鬯漙将，宾尸在位。","玄德升闻，孝思光被。","公卿庶政，傅御师氏。","至𫍯感神，福禄来暨。"],0,"x47","宋"],["太常乐章三十首 其十六 皇帝行奏隆安之曲","杨亿","四言",["礼备乐成，干健天行。","帝容有穆，佩玉锵鸣。"],{"yz":[]},"x47","宋"],["不同吟","邵雍","四言",["君子之人，与己非比。","闻善则乐，见贤则喜。","小人之人，与己非恶。","闻善则憎，见贤则怒。"],0,"x57","宋"],["不知吟","邵雍","四言",["不知阴阳，不知天地。","不知人情，不知物理。","强为人师，宁不自愧。"],0,"x57","宋"],["流水  其一","黄庭坚","四言",["一溪之水，可涉而航。","人不我直，我犹力行。"],0,"x66","宋"],["偈颂二十九首 其十一","释清了","四言",["刹尘一扫，大小量空，念劫两融。","前后际断，不离当处，圆应无穷。","安住是中，周施不怠。"],0,233,"宋"],["偶书 其二","邵雍","四言",["贤德之人，所居之处。","如芝如兰，使人爱慕。","凶恶之人，所居之处。","如虎如狼，使人怕怖。"],0,"x57","宋"],["观棋，并引","苏轼","四言",["五老峰前，白鹤遗址。","长松荫庭，风日清美。","我时独游，不逢一士。","谁欤棋者，户外屦二。","不闻人声，时闻落子。","纹枰坐对，谁究此味。","空钩意钓，岂在鲂鲤。","小儿近道，剥啄信指。","胜固欣然，败亦可喜。","优哉游哉，聊复尔耳。"],0,"x67","宋"],["送李推官","徐积","四言",["物有所兴，因人而就。","其人维何，所性忠厚。","能谋而果，能明而究。","身任其责，力成厥构。","既成之法，可继于后。","入门而东，自南而北。","如污斯隆，如枉斯直。","如塞斯通，如隘斯辟。","如翼斯张，如衡斯举。","如蔀斯赫，如阒斯睹。","室有明窗，墙有坚堵。","地无游蚁，穴无伏鼠。","既完既成，既安既处。","师乎师乎，岂可苟然。","心为道本，身为义先。","心之所无，道不可传。","身之所无，口不可宣。","唯正唯直，求己以全。","以义以命，如耕平田。","处心积虑，贯通神明。","无忝乡校，勿负朝廷。","成人子弟，慰人父兄。","二三职事，其亦警戒。","欲善诸外，先治诸内。","存诚防邪，集义养气。","作伪心劳，作德心逸。","如此两句，守而勿失。","谨佐尔师，各修其职。","庶乎诸生，其则不远。","已修加修，已善加善。","不率者从，不类者变。","子弟如此，父兄所愿。","可慰乡人，可成学风。","可酬其劳，可称厥功。"],0,"x123","宋"],["朝会 其一","郊庙朝会歌辞","四言",["湛湛露斯，其甘如饴。","清宁鉴德，和气应之。","神云播液，冰玉凝姿。","是为仁瑞，万寿维祺。"],0,"x207","宋"],["朝会 其一","郊庙朝会歌辞","四言",["华滋凝气，灵粹发祥。","紫盖轮囷，金跗炜煌。","阳蓼三秀，甘泉九房。","瑞图休证，君王寿昌。"],0,"x207","宋"],["邪正吟","邵雍","四言",["贤人好正，奸人好邪。","好邪则竞，好正则和。"],0,"x57","宋"],["四公子吟","邵雍","四言",["时去三王，事归五霸。","七雄既争，四子乃诧。","孟尝居先，信陵居亚。","平原居中，春申居下。"],0,"x57","宋"],["兴一","释崇岳","四言",["只这一脉，人间显赫。","妙转绵绵，甚生标格。"],0,222,"宋"],["朝会 其二","郊庙朝会歌辞","四言",["太平之符，昭发众瑞。","爰有嘉禾，异垄合穗。","大田如云，既获既刈。","野人愉愉，不亦有岁。"],0,"x207","宋"],["久雨","方回","四言",["云胡不出，积雨予尼。","意弥八纮，膝此一席。","谁具蒸徒，假予楫航。","一往沧海，观彼茫洋。","掩关昼眠，胡宁不暇。","鲁叟攸戒，敢视为夜。","寂寂疏帘，幽幽空阶。","鸟下碎藓，伤予之怀。","悠悠古道，溢溢行潦。","岂无岑楼，送目遥草。","心之忧矣，莫或予知。","彼其之子，谓予寒饥。"],0,"x59","宋"],["转轮八花诗 其一","项安世","四言",["昊芒布政，律吕旋阳。","草衰化绿，木瘁回苍。","老惊岁换，少喜年芳。"],0,"x55","宋"],["太常乐章三十首 其十二 退文舞出奏正安之曲","杨亿","四言",["左手执籥，右手秉翟。","进旅退旅，万舞有翼。"],0,"x47","宋"],["朝会 其三","郊庙朝会歌辞","四言",["地效珍物，时维兹禾。","秀标四颖，祥掩并柯。","嘉生绝拟，善应为多。","光溢图谍，宣用登歌。"],0,"x207","宋"],["朝会 其三","郊庙朝会歌辞","四言",["毓粹乾坤，储休阴阳。","氤氲馥郁，纷炜煌煌。","融为和气，发为祥光。","瑞牒昭纪，万寿无疆。"],0,"x207","宋"],["和陶劝农六首，并引 其二","苏轼","四言",["天祸尔土，不麦不稷。","民无用物，珍怪是直。","播厥熏木，腐馀是穑。","贪夫污吏，鹰挚狼食。"],0,"x67","宋"],["偶书","邵雍","四言",["天生万物，各遂其一。","唯人最灵，万物能并。","芝兰芬芳，麒麟凤凰。","此类之人，鲜有不臧。","狼毒冶葛，枭鸩蛇蝎。","此类之人，鲜有不孽。","臧唯思安，孽唯思残。","日夜无息，相代于前。","天无私覆，地无私载。","俱能含养，始知广大。"],0,"x57","宋"],["偈二首 其一","释显","四言",["吃粥了也，头上安头。","洗钵盂去，为蛇画足。","更问如何，自纳败阙。"],0,92,"宋"],["太常乐章三十首 其二十六 武舞第一","杨亿","四言",["武功既成，缀兆有翼。","以节八音，以象七德。","俣俣蹲蹲，朱干玉戚。","发扬蹈厉，其仪不忒。"],{"yz":[]},"x47","宋"],["偈颂二十九首 其二十五","释清了","四言",["纯清绝点，似镜长明。","照不失虚，万像体妙。","细中之细，雪尽冰消。","功就之功，任运现成。"],0,233,"宋"],["转轮八花诗 其二","项安世","四言",["藻动鱼戏，泥衔燕忙。","早莺喜谷，回雁惊湘。","缫敷丽苑，和风海翔。"],0,"x55","宋"],["能寐吟","邵雍","四言",["大惊不寐，大忧不寐，大伤不寐，大病不寐，大喜不寐，大安能寐。","何故不寐，湛于有累。","何故能寐，行于无事。"],0,"x57","宋"],["毛女赞","惠洪","四言",["不嗅梨花，而撚紫芝。","不穿云袖，而披槲衣。","何以风神，洞如冰雪。","使人见之，眼寒心折。","如麝有香，以缶覆焉。","透尘透风，种性则然。","又如烟雨，过孤山宅。","于荒寒中，微见春色。","图之壁间，是真过秦。","季子好德，白发日新。"],0,"x42","宋"],["何公桥","苏轼","四言",["天壤之间，水居其多。","人之往来，如鹈在河。","顺水而行，云驰鸟疾。","维水之利，千里咫尺。","乱流而涉，过膝则止。","维水之害，咫尺千里。","沔彼滥觞，蛙跳倏游。","溢而怀山，神禹所忧。","岂无一木，支此大坏。","舞于盘涡，冰折雷解。","坐使此邦，画为两州。","鸡犬相闻，胡越莫救。","允毅何公，甚勇于仁。","始作石梁，其艰其勤。","将作复止，更此百难。","公心如铁，非石则坚。","公以身先，民以悦使。","老壮负石，如负其子。","疏为玉虹，隐为金堤。","直栏横槛，百贾所栖。","我来与公，同载而出。","欢呼填道，抱其马足。","我叹而言，视此滔滔。","未见刚者，孰为此桥。","愿公千岁，与桥寿考。","持节复来，以慰父老。","如朱仲卿，食于桐乡。","我作铭诗，子孙不忘。"],0,"x67","宋"],["所学吟","邵雍","四言",["人之所学，本学人事。","人事不修，无学何异。"],0,"x57","宋"],["太常乐章又七首 其三 送神理安曲","杨亿","四言",["飙轮戾止，光烛灵坛。","金奏绎如，白露漙漙。"],0,"x47","宋"],["江郊","苏轼","四言",["江郊葱昽，云水茜绚。","埼岸斗入，洄潭轮转。","先生悦之，布席闲燕。","初日下照，潜鳞俯见。","意钓忘鱼，乐此竿线。","优哉悠哉，玩物之变。"],0,"x67","宋"],["嘉泰二年恭上太皇太后尊号八首 其一","郊庙朝会歌辞","四言",["思齐太任，嫔于周京。","至哉坤元，万物资生。","不可仪测，矧可强名。","镂玉绳金，昭哉号荣。"],0,"x207","宋"],["题画兰","郑思肖","四言",["求则不得，不求或与。","老眼空阔，清风万古。"],0,"x98","宋"],["上下吟","邵雍","四言",["自下观上，无限富贵。","自上观下，无限贱贫。","自心观物，何物能一。","自物观心，何心不均。"],0,"x57","宋"],["四可吟","邵雍","四言",["可勉者行，可信者言。","可委者命，可托者天。"],0,"x57","宋"],["嘉泰二年恭上太皇太后尊号八首 其二","郊庙朝会歌辞","四言",["鼓钟喤喤，仪物载陈。","仪物陈矣，烂其瑶琨。","咨尔上公，相予文孙。","勿亟勿徐，奉我重亲。"],0,"x207","宋"],["辞众偈","释从悦","四言",["四十有八，圣凡尽杀。","不是英雄，龙安路滑。"],0,47,"宋"],["赤城六章章四句  其三","释居简","四言",["念昔三辅，湖独纷委。","逮公来斯，苕霅泾渭。"],0,"x94","宋"],["山行见月四言","苏轼","四言",["吟哦傲兀，仰晤岩月。","遇𪩘迎崖，银刓玉啮。","源鱼𪡋喁，岸雁臲卼。","卧玩我语，聱牙岌嶪。"],0,"x67","宋"],["嘉泰二年恭上太皇太后尊号八首 其三","郊庙朝会歌辞","四言",["荡荡天门，金铺玉户。","采旄翠旌，流苏葆羽。","千官影从，乃导乃辅。","都人纵观，填道呼舞。"],0,"x207","宋"],["仓颉","王安石","四言",["仓颉造书，不诂自明。","于乎多言，祇误后生。"],0,"x48","宋"],["书江氏芝草记后","徐积","四言",["天门嶪嶪，洞达通彻。","地虽幽阴，明白昭晰。","有来即应，无往弗答。","或旋其日，或逾厥月。","或降吉祥，或出妖孽。","或生美好，或产丑缺。","或使合并，或令分裂。","凡皆若此，其故可说。","人之所喜，神则欢悦。","和气流畅，精粹凝结。","草木受之，形类孤绝。","其无所苟，而不徒设。","爰有江氏，世载其德。","子子孙孙，能敬勿失。","其叔有令，如出诸意。","戮力同心，道路相继。","二十六丧，收敛聚会。","在圉之北，同日俱痤。","乃有二物，以彰厥美。","其一维何，是曰灵芝。","如盖上设，如杠下持。","其色黄紫，其光陆离。","其肉坚厚，弗柯弗衰。","其二维何，是曰连理。","巨干修枝，贯通骨髓。","物不可间，人不得披。","以类考之，不必异本。","其奇若此，其吉勿问。","其恍其惚，其惚其恍。","必寓诸物，以来神贶。","维神之贶，如冈如陵。","有德者胜，德虽可胜。","其心兢兢，则亦可承。","维神之贶，必以其类。","或大其家，或大其世。","敬之戒之，永终厥义。"],0,"x123","宋"],["偶书 其三","邵雍","四言",["妻强夫殃，奴强主殃，臣强君殃。","尾大于身，冰坚于霜。","辩之不早，国破家亡。"],0,"x57","宋"],["原酒","项安世","四言",["惟天降命，造此芳醇。","以养老疾，以奉祭宾。","少壮强艾，学仕耕耘。","食焉不暇，何酒之云。","世衰道降，礼丧法沦。","以酒为膳，每食必陈。","童稚拟老，闺闼僣神。","心钳废虑，体缓妨勤。","业荒弗竟，行毁弗成。","俊才中画，毅志早惛。","勿谓有常，异于湎沉。","亵天慢性，其罪则均。","作此自谕，谕我子孙。","恐干众怒，勿示外人。"],0,"x55","宋"],["和陶劝农六首，并引 其一","苏轼","四言",["咨尔汉黎，均是一民。","鄙夷不训，夫岂其真。","怨愤劫质，寻戈相因。","欺谩莫诉，曲自我人。"],0,"x67","宋"],["和陶劝农六首，并引 其三","苏轼","四言",["岂无良田，膴膴平陆。","兽踪交缔，鸟喙谐穆。","惊麇朝射，猛豨夜逐。","芋羹𫉄糜，以饱耆宿。"],0,"x67","宋"],["嘉泰二年恭上太皇太后尊号八首 其五","郊庙朝会歌辞","四言",["文物备矣，三事其承。","崇牙高张，乐充宫庭。","耽耽广殿，左墄右平。","敬尔威仪，摄齐以登。"],0,"x207","宋"],["天人吟","邵雍","四言",["天学修心，人学修身。","身安心乐，乃见天人。","天之与人，相去不远。","不知者多，知之者鲜。","身主于人，心主于天。","心既不乐，身何由安。"],0,"x57","宋"],["嘉泰二年恭上太皇太后尊号八首 其四","郊庙朝会歌辞","四言",["煌煌宝书，玉篆金缕。","曷为来哉，自天子所。","自天子所，以燕文母。","婉嬗祥云，日正当午。"],0,"x207","宋"],["颂古二十一首 其一","释正觉","四言",["如今推也，是子是贼。","买帽相头，食鱼去骨。"],0,"x88","宋"],["颂古二十一首 其四","释居简","四言",["弥满清净，终不容他。","山河大地，万象森罗。"],0,"x94","宋"],["偈颂一百六十九首 其一二九","释智朋","四言",["造化寒暑，有来有往，衲僧火炉，有开有闭。","寒暑往来，火炉开闭。","非实非虚，非如非异。"],0,18,"宋"],["来梦","梅尧臣","四言",["忽来梦我，于水之左，不语而坐。","忽来梦余，于山之隅，不语而居。","水果水乎，不见其逝。","山果山乎，不见其途。","尔果尔乎，不见其徂。","觉而无物，泣涕涟如，是欤非欤。"],0,"x65","宋"],["太常乐章三十首 其三十 皇帝御楼毕奏隆安之曲","杨亿","四言",["肆类云毕，淳熙漙将。","雷雨丽泽，云物效祥。","礼容济济，天威煌煌。","大赉四海，富寿无彊。"],0,"x47","宋"],["和陶劝农韵勉吾乡之学者 其一","吴芾","四言",["士农工商，古有四民。","惟儒最贵，但患非真。","诚能力学，进必有因。","傥或中辍，岂能为人。"],0,"x95","宋"],["南山 其三","李涛","四言",["彼美人兮，悠悠我思。","何以予之，琼瑰玉佩。"],0,67,"宋"],["六句偈六首 其一 前念是凡","释清远","四言",["前念是凡，短布裁衫。","长亭送客，落日张帆。"],0,116,"宋"],["颂","释慧远","四言",["雪霁长空，迥野飞鸿。","段云片片，向西向东。"],0,154,"宋"],["太常乐章又七首 其二 奉币嘉安曲","杨亿","四言",["博硕肥腯，以炰以烹。","嘉栗旨酒，有弥斯盈。","殽蓛维旅，肃肃蒸蒸。","吉蠲备物，享于克诚。"],0,"x47","宋"],["嘉泰二年恭上太皇太后尊号八首 其六","郊庙朝会歌辞","四言",["维寿伊何，圣德日新。","维慈伊何，祐于后人。","乃范斯金，乃镂斯珉。","皇举玉趾，从于尧门。"],0,"x207","宋"],["一言感人","邵雍","四言",["为女不嫁，为士不官，齐人一言，田子辞焉。"],0,"x57","宋"],["六句偈六首 其五 前念即凡","释清远","四言",["前念即凡，凡不能测。","若人要知，终不指划。"],0,116,"宋"],["偈十二首 其一","释本才","四言",["上封一句，海墨难诠。","墙壁瓦砾，昼夜流传。","若住听莹，鹞子冲天。"],0,159,"宋"],["嘉泰二年恭上太皇太后尊号八首 其七","郊庙朝会歌辞","四言",["侍中版奏，办外严中。","出自玉房，袆褕被躬。","我龙受之，祲威盛容。","皇帝圣孝，其乐融融。"],0,"x207","宋"],["偈","释法如","四言",["乾坤之内，宇宙之间。","中有一宝，秘在形山。"],{"yz":["释智愚"]},181,"宋"],["狗子无佛性","释妙总","四言",["铁壁银山，一箭穿过。","潦倒赵州，口能招祸。"],0,213,"宋"],["贤监院求赞","释清远","四言",["遍界不藏，毫端独妙。","纵未嚬呻，已先微笑。","吾子识也，水月斯照。","纤尘不遗，是为宗要。"],0,116,"宋"],["九月 其三","曾丰","四言",["彼女华者，有都其色。","公所养兮，亦孔之泽。","彼女华者，有都其香。","公所立兮，亦孔之芳。","彼女华者，有都其味。","公所调兮，亦孔之旨。"],0,"x193","宋"],["善人吟","邵雍","四言",["良如金玉，重如丘山。","仪如鸾凤，气如芝兰。"],0,"x57","宋"],["偈颂一百四十二首 其三十","释广闻","四言",["丛林纪纲，衲僧巴鼻。","词锋若差，乡关万里。"],0,10,"宋"],["天命吟","邵雍","四言",["可委者命，可凭者天。","人无率尔，事不偶然。"],0,"x57","宋"],["偈二首 其二","释方会","四言",["杨歧一句，急著眼觑。","长连床上，拈匙把箸。"],0,244,"宋"],["采菊  其三","黄庭坚","四言",["江汉滔滔，有楫有杭。","谁以济此，中流且风。","嗟尔君子，时处时默。","微云反复，无伤尔足。"],0,"x66","宋"],["利害吟","邵雍","四言",["兔犬俱毙，蚌鹬相持。","田渔老父，坐而利之。"],0,"x57","宋"],["偈","释本","四言",["五峰家风，南北西东。","要用便用，以橛钉空。"],0,166,"宋"],["缘识 其二十","赵炅","四言",["体道前贤，礼乐为先。","纵横逸豫，言发自然。","多知博物，文德心悬。","孰能若此，宇宙推迁。"],0,"x63","宋"],["偈二首 其一","释方会","四言",["杨歧一要，千圣同妙。","布施大众，果然失照。"],0,244,"宋"],["明教禅师五种不坏赞 其一","释居简","四言",["顶骨峣然，隐若伏犀。","于烈火中，凄其廪而。","古铁铮铮，烬馀不热。","击石拊石，迭中音节。","舍利团缀，素魄囧如。","湛湛凝露，累累贯珠。","岂无他人，欲见其顶。","月行太空，蛙沉坎井。"],0,"x94","宋"],["四言诗一章","赵顼","四言",["五季失图，猃狁孔炽。","艺祖造邦，意有惩艾。","爰设内府，基以募士。","曾孙保之，敢忘厥志。"],0,46,"宋"],["碧云 其二","赵蕃","四言",["翳翳村巷，遥遥犬声。","肃肃庭树，啾啾鸟鸣。","所期不来，实关我情。"],0,"x36","宋"],["明堂乐章二首 歆安之曲","王安石","四言",["穆穆在堂，肃肃在庭。","于显辟公，来相思成。","神既歆止，有闻惟馨。","锡我休嘉，燕及群生。"],0,"x48","宋"],["题毛霆甫诗集  其二","文天祥","四言",["英英白云，在涧之阿。","彼美人兮，其思孔多。"],0,"x53","宋"],["偈二首 其一","释本才","四言",["达磨未来，怀藏至宝，顶髻有珠。","达磨既来，卞和刖足，杨朱途穷。","拟议之间，知君罔措。"],0,159,"宋"],["碧云 其一","赵蕃","四言",["碧云散舒，合且复离。","皓月涌照，圆而不亏。","嗟我所期，曷云不来。"],0,"x36","宋"],["颂古九首 其四","释了演","四言",["沩山得体，仰山得用。","体用俱全，梦中说梦。"],0,235,"宋"],["颂古二十一首 其六","释居简","四言",["翻手为云，覆手为雨。","业识忙忙，无本可据。"],0,"x94","宋"],["绍兴祭风师六首 送神。曲同迎神。","郊庙朝会歌辞","四言",["荃其止乎，禗禗其容。","奄横四海，蹇莫之穷。","时不骤得，礼焉有终。","荃其行乎，余心𢥞𢥞。"],0,"x207","宋"],["息壤诗，并叙","苏轼","四言",["帝息此壤，以藩幽台。","有神司之，随取而培。","帝敕下民，无敢或开。","惟帝不言，以雷以雨。","惟民知之，幸帝之怒。","帝茫不知，谁敢以告。","帝怒不常，下土是震。","使民前知，是役于民。","无是坟者，谁取谁干。","惟其的之，是以射之。"],0,"x67","宋"],["颂古 其二十六","释道颜","四言",["劈回三拳，连腮七掌。","尽大地人，不知痛痒。"],0,47,"宋"],["自作真赞","邵雍","四言",["松桂操行，莺花文才。","江山气度，风月情怀。","借尔面貌，假尔形骸。","弄九馀暇，闲往闲来。"],0,"x57","宋"],["颂古四十八首 其十","释慧开","四言",["贫似范丹，气如项羽。","活计虽无，敢与斗富。"],0,65,"宋"],["缘识 其二十二","赵炅","四言",["造化等齐，不分高低。","神笔才智，海岳凄凄。","稀代为宝，举意东西。","毫端万象，沃荡狂迷。"],0,"x63","宋"],["不肖吟","邵雍","四言",["不肖之人，志在游荡。","身在屋下，心在屋上。","不肖之子，志在浮夸。","身尚不保，焉能保家。"],0,"x57","宋"],["小人吟","邵雍","四言",["小人无节，弃本逐末。","喜思其与，怒思其夺。"],0,"x57","宋"],["小人吟","邵雍","四言",["小人无耻，重利轻死。","不畏人诛，岂顾物议。"],0,"x57","宋"],["偈","释慧远","四言",["至道无难，唯嫌拣择。","但莫憎爱，洞然明白。","毫厘有差，天地悬隔。"],0,154,"宋"],["偈颂二十九首 其四","释清了","四言",["穷微丧本，体妙失宗。","一句截流，渊源及尽。"],0,233,"宋"]]