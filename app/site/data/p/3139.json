[["句 其十四","元绛","残句",["花阴转午清风细，玉燕钗头艾虎轻。"],0,98,"宋"],["句 其一","邵伯温","残句",["屈原宅畔蕙兰怨，神女祠边云雨愁。"],0,137,"宋"],["句","崔暨","残句",["居占梅仙里。"],0,99,"宋"],["句","狄咸","残句",["旃檀归象魏，窣堵卧烟霞。"],0,49,"宋"],null,["句","何藗","残句",["不使翠分旁牖去，却缘清甚畏人知。"],0,171,"宋"],["句","孔文仲","残句",["一茎青竹初出水，数个黄蜂占作窠。"],0,97,"宋"],["句  其一六","夏倪","残句",["冰玉入诗肠。"],0,232,"宋"],["句 其二","蔡卞","残句",["莫学饥鹰饱便飞。"],0,96,"宋"],["句 其二","赵鼎臣","残句",["古来此景叹经岁，今夜谁家不倚楼。"],0,126,"宋"],["句 其一","张孝芳","残句",["三十六峰天与寄，云间只欠我题诗。"],0,9,"宋"],["句 其三","岑硕","残句",["极目又芳草，卷帘非故山。"],0,72,"宋"],["句","刘玄英","残句",["抛离火宅三千指，屏去门兵十万家。"],0,241,"宋"],["句 其三十三","张舜民","残句",["既非扶险阻，何必问年龄。"],0,209,"宋"],["句 其十七","晁迥","残句",["凤驾都门晓，凉风苑树秋。"],0,199,"宋"],["句  其一○五","释晓莹","残句",["倒拄乌藤乘逸兴。"],0,182,"宋"],["句 其二","赖仙翁","残句",["巧妙四山云岫落，玲珑双甑月灯明。"],0,179,"宋"],["句 其一","杨巽斋","残句",["自有娇红间苍叶，不随凡卉待春回。"],0,165,"宋"],["句 其一","赵彦端","残句",["新梢渐变鹅黄色，浅水遥添鸭绿纹。"],0,53,"宋"],["句  其一二","张镃","残句",["空对烂银盘。"],0,"x107","宋"],["句 其六","蒋之奇","残句",["雄豪何止压南州，天下临观应第一。"],0,62,"宋"],["播大唐辞世偈云","释慧开","残句",["书偈毕跏趺而逝都知王太尉随即敷。"],0,65,"宋"],["句 其一","释从垣","残句",["泉石天象转，花月地痕虚。"],0,168,"宋"],["句 其一","张仲时","残句",["太平功业属男儿，虹蜺万丈云中气。"],0,34,"宋"],["句 其三","王安中","残句",["不见牛医黄叔度，即寻马磨许文休。"],0,52,"宋"],["句 其二","薛昂","残句",["欢声如凤来衔诏，喜气如鸡去揭竿。"],0,173,"宋"],["句 其六","徐似道","残句",["一带拒霜三十里，又催箫鼓作秋声。"],0,139,"宋"],["句 其二","刘摰","残句",["阴阴佳木发城齐，襟袖迎风弄晚晖。"],0,12,"宋"],["句 其三","李畋","残句",["银山云出海，练水涧分冈。"],0,20,"宋"],["句 其十一","高似孙","残句",["水生奔蟹簄，树杂荫鱼床。"],0,181,"宋"],["句  其一五","张耒","残句",["沙边微雨湿孤蓬。"],0,"x71","宋"],["句 其十四","王安国","残句",["宫殿影摇河汉外，江湖梦断鼓钟边。"],0,224,"宋"],["句 其四十七","释惠崇","残句",["古路随岗起，秋帆转浦斜。"],0,69,"宋"],["句 其九十二","释惠崇","残句",["云阴移汉塞，石色入秦天。"],0,69,"宋"],["句  其一九","元绛","残句",["小雨疎疎向晚晴。"],0,98,"宋"],["句 其二","张潞","残句",["策勋蓑笠上，自是一云台。"],0,35,"宋"],["句  其一二","陈尧佐","残句",["相逢吟未足。"],0,103,"宋"],null,["句 其五","张舜民","残句",["义帝凭祠宇，梅真隐市廛。"],0,209,"宋"],["句  其三一","张釜","残句",["知渠已富江山句。"],0,194,"宋"],["句 其七","阳枋","残句",["白云无心闲渡水，清风何意自开花。"],0,243,"宋"],["句 其四","刘师道","残句",["金谷路尘埋国艳，武陵溪水泛天香。"],0,209,"宋"],["句 其十九","刘筠","残句",["刘伶醉席梅花地，海客仙槎粉水天。"],0,152,"宋"],["句 其一","姚镛","残句",["痴云蔽岳行人远，淫雨摧花白发生。"],0,119,"宋"],["句 其二","张商英","残句",["湖上青山一抹高，烟中草木细如毫。"],0,116,"宋"],["句 其六十二","释惠崇","残句",["惊蝉移古柳，斗雀堕寒庭。"],0,69,"宋"],["句 其十二","陶弼","残句",["曾观工部集，中载赤沙湖。"],0,254,"宋"],["句 其二","元绛","残句",["过庐都失眼前人。"],0,98,"宋"],["句","赵彦迈","残句",["风俗连巴楚，封疆接播溱。"],0,196,"宋"],["句 其七","徐似道","残句",["叶从秋后变，色向晚来红。"],0,139,"宋"],["句 其二","杨巽斋","残句",["如龙化作青藜焰，宁用窗前设短檠。"],0,165,"宋"],["句 其二","寇准","残句",["苍芷溪烟晻霭山，翛然城角起天端。"],0,12,"宋"],["句 其七","李彭","残句",["章江之水抱城流。"],0,"x111","宋"],["句 其四十二","陶弼","残句",["玉英金实碧琳枝。"],0,254,"宋"],["句","释皓","残句",["楚雁传归信，吴鸥候过船。"],0,252,"宋"],["句","高遵惠","残句",["上林供王宴，圣母赐金钱。"],0,86,"宋"],["句 其九十四","释惠崇","残句",["江花凌霰发，山溜入池深。"],0,69,"宋"],["句 其十九","晁迥","残句",["期月政成当事简，不妨游燕楚宫春。"],0,199,"宋"],["句  其一○九","释晓莹","残句",["几回相送复相迎。"],0,182,"宋"],["句 其一","张商英","残句",["天连远水三吴阔，人倚危楼万象低。"],0,116,"宋"],["句 其二十一","晁迥","残句",["心如莲花不著水，身似翔鸿不可笼。"],0,199,"宋"],["句 其一","范致虚","残句",["回首阳台汉川路，隔江烟雨暗渔蓑。"],0,175,"宋"],["句","邵雍","残句",["始信画前原有易，自从删后更无诗。"],0,"x57","宋"],["句 其八","郑文宝","残句",["失意惯中迁客酒，多年不见侍臣花。"],0,109,"宋"],["句 其十八","刘筠","残句",["荥河带绕中天阁，空乐星悬大士居。"],0,152,"宋"],["句 其一","唐子真","残句",["卷衣更上前岩去，别有云山千万重。"],0,3,"宋"],["句","邓远举","残句",["翠云卧石千岩冷，黄叶呼风万里秋。"],0,39,"宋"],["句 其二十九","楼楚材","残句",["着马轻鞍重，随僧皂衲斑。"],0,96,"宋"],["句  其四","孔夷","残句",["杨柳不遮春已断，一枝红杏出墙头。"],0,163,"宋"],["句  其二三","蒋之奇","残句",["野径得闲行。"],0,62,"宋"],["句 其五十二","陶弼","残句",["阴微辨樵火，霁早误僧钟。"],0,254,"宋"],["句 其二","罗椿","残句",["春消千嶂雪，清逼五湖秋。"],0,86,"宋"],["句 其六","范镇","残句",["先生已何处，依旧白云飞。"],0,245,"宋"],["句 其十六","元绛","残句",["五日看花怜并叶，今朝斗草得宜男。"],0,98,"宋"],["句 其二","赵禥","残句",["尧舜传心惟以一，禹汤受命本乎中。"],0,42,"宋"],["句 其七","楼楚材","残句",["从来把得坚牢处，不是晴明不肯飞。"],0,96,"宋"],["句 其三","寇准","残句",["青草湖平两岸水，岳阳楼对三吴州。"],0,12,"宋"],["句 其三","李拱","残句",["雨后有人耕绿野，月明无犬吠花村。"],0,128,"宋"],["句 其二","吕希纯","残句",["久矣抠衣阙过庭。"],0,65,"宋"],["句 其一","何英","残句",["羊肠有路地多险，马脊无人天一隅。"],0,25,"宋"],["句 其五","邵博","残句",["池边诗觅郑都官。"],0,169,"宋"],["句 其九","楼楚材","残句",["一株种外无遗种，九个花间有细花。"],0,96,"宋"],["句","张进彦","残句",["缚虎敢辞山路险，斩鲸终见海波澄。"],0,246,"宋"],["句 其一","李邴","残句",["柳老抛绵后，梅酸著骨时。"],{"yz":[]},140,"宋"],["句  其二六","张釜","残句",["飞花满眼句纵横。"],0,194,"宋"],["春日田园杂兴","林泉生","残句",["桃李公门者，将芜胡不归