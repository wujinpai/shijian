[["古像赞二百零五首 其三十一 子产","孙承恩","四言",["郑国听政，贤者惟子。","辞令之善，酬酢之智。","以礼治国，诸侯莫加。","君子道四，圣人所嘉。"],0,"x290","明"],["古像赞二百零五首 其三十二 吴季子","孙承恩","四言",["见礼知政，闻乐知德。","观风列国，无子精识。","让国全义，挂剑酬心。","怀哉高风，无古无今。"],0,"x290","明"],["古像赞二百零五首 其三十四 颜子","孙承恩","四言",["才优王佐，德跻圣域。","既见卓尔，亦几无迹。","明哲天纵，纯粹性成。","发孔之蕴，后学式程。"],0,"x290","明"],["古像赞二百零五首 其三十五 曾子","孙承恩","四言",["道悟一贯，功密三省。","大学一书，圣学要领。","笃实之资，弘毅之德。","易箦数言，可验学力。"],0,"x290","明"],["古像赞二百零五首 其三十六 子游","孙承恩","四言",["所长擅科，知本之学。","我思其人，简易宏廓。","礼乐为政，弦歌成音。","学道之论，实契圣心。"],0,"x290","明"],["古像赞二百零五首 其三十七 伍大夫","孙承恩","四言",["尽孝雪耻，竭忠死谮。","忠孝之心，子则无恨。","忍小就大，功立名成。","古烈丈夫，史迁实评。"],0,"x290","明"],["古像赞二百零五首 其三十八 子思","孙承恩","四言",["学本心传，道原性命。","唐虞授受，父师讲论。","三十三篇，广大精深。","继往开来，非子孰任。"],0,"x290","明"],["古像赞二百零五首 其三十九 孟子","孙承恩","四言",["圣远道塞，异端并兴。","岩岩子舆，三圣是承。","命世大才，平治之具。","用宁齐安，三代可致。"],0,"x290","明"],["古像赞二百零五首 其四十 庄子","孙承恩","四言",["其心廓廓，其气浩浩。","万古瞬息，八荒堂奥。","厌薄仁义，狎侮孔周。","曲说之雄，异端之尤。"],0,"x290","明"],["古像赞二百零五首 其四十一 屈大夫","孙承恩","四言",["薰莸殊器，泾渭异途。","以子洁修，岂容群污。","义合有权，子弗忍恝。","此志皎然，争光日月。"],0,"x290","明"],["古像赞二百零五首 其四十二 汉高祖","孙承恩","四言",["皇矣高祖，天锡神武。","一剑兴戎，光登九五。","坦乎其真，廓乎其容。","包括英豪，范围之中。"],0,"x290","明"],["古像赞二百零五首 其四十三 项王","孙承恩","四言",["勇力拔山，猛气盖世。","经营大业，谓可力致。","倍义贼弑，攻略肆屠。","灭德者凶，天亡匪诬。"],0,"x290","明"],["古像赞二百零五首 其四十四 汉文帝","孙承恩","四言",["穆穆太宗，躬修玄默。","抚世以柔，化民以德。","其俗肫肫，其功泯泯。","三代之后，孰如帝仁。"],0,"x290","明"],["古像赞二百零五首 其四十五 汉景帝","孙承恩","四言",["帝也维贤，克遵先志。","谦恭俭朴，恪守无替。","轻刑薄税，民俗阜康。","比隆成周，汉道以昌。"],0,"x290","明"],["古像赞二百零五首 其四十六 汉武帝","孙承恩","四言",["盛气当阳，雄才御世。","嘉乐唐虞，狭小汉制。","振举百度，征伐四裔。","烨烨明明，恢我王治。"],0,"x290","明"],["古像赞二百零五首 其四十七 汉宣帝","孙承恩","四言",["中宗强明，励精图治。","布德振威，柔远能迩。","皇灵赫奕，呼韩来庭。","配商高宗，汉道复兴。"],0,"x290","明"],["古像赞二百零五首 其四十八 萧酂侯","孙承恩","四言",["佐时兴王，根本重任。","式赞治平，画一之政。","谦谦其退，翼翼其恭。","一代元臣，高朗令终。"],0,"x290","明"],["古像赞二百零五首 其四十九 张留侯","孙承恩","四言",["报韩徇义，辅汉乘时。","诛秦蹙项，从容指挥。","功成身退，愿追赤松。","大雅卓识，令名无穷。"],0,"x290","明"],["古像赞二百零五首 其五十 韩淮阴侯","孙承恩","四言",["定伯雄图，登坛数辞。","用兵制胜，霆击风驰。","成功既高，执义亦固。","忘期赤松，英雄悔悟。"],0,"x290","明"],["古像赞二百零五首 其五十一 曹静侯","孙承恩","四言",["少而才能，豪吏健将。","晚而谦恭，醇德雅量。","清净为治，刻深匪名。","配萧并贤，百世尔称。"],0,"x290","明"],["古像赞二百零五首 其五十二 董江都","孙承恩","四言",["秦火初熄，典籍尚湮。","子也杰出，倡始斯文。","独抱麟经，潜心大义。","天人三策，治道攸寓。"],0,"x290","明"],["古像赞二百零五首 其五十三 东方朔","孙承恩","四言",["傲忽玩世，浮沉随时。","不清不和，匪惠匪夷。","滑稽自贤，俳优是视。","讽谏时益，吾差有取。"],0,"x290","明"],["古像赞二百零五首 其五十四 司马迁","孙承恩","四言",["博极群书，综统千古。","豪气孤骞，阔视无伍。","发为文章，凌高厉空。","一代奇才，史学之宗。"],0,"x290","明"],["古像赞二百零五首 其五十五 霍博陆侯","孙承恩","四言",["子孟忠实，顾命是承。","光辅幼帝，赞治太平。","屹然如山，不震不侧。","废昏立明，功著汉室。"],0,"x290","明"],["古像赞二百零五首 其五十六 扬子云","孙承恩","四言",["扬子好学，研精覃思。","法言僻涩，太玄深奇。","著述良勤，拟圣则缪。","美新何为，名节斯疚。"],0,"x290","明"],["古像赞二百零五首 其五十七 汉光武","孙承恩","四言",["白水龙兴，光膺宝历。","日月重明，乾坤再辟。","慎德勤政，身致太平。","巍巍成功，匹休西京。"],0,"x290","明"],["古像赞二百零五首 其五十八 汉明帝","孙承恩","四言",["于惟显宗，亦世其烈。","宪章慎守，幽枉必雪。","崇儒养老，文教聿兴。","增光前人，汉道允升。"],0,"x290","明"],["古像赞二百零五首 其五十九 汉章帝","孙承恩","四言",["肃宗恺悌，长者之风。","政厌苛刻，论从雍雍。","综缉艺文，服膺帝道。","厚泽深仁，简册有耀。"],0,"x290","明"],["古像赞二百零五首 其六十 严子陵","孙承恩","四言",["名节丘山，轩冕尘壒。","怀仁负义，蕴畜亦大。","汉室九鼎，桐江一丝。","凛然清风，悠悠我思。"],0,"x290","明"],["古像赞二百零五首 其六十一 邓高密侯","孙承恩","四言",["杖策从君，际时风云。","少年秉钺，克树大勋。","将略既优，内行亦备。","名高云台，光辅汉治。"],0,"x290","明"],["古像赞二百零五首 其六十二 马伏波","孙承恩","四言",["君择臣使，臣择主从。","舍彼虺蝮，来依真龙。","西伐南征，老志愈烈。","铜柱高标，人仰英杰。"],0,"x290","明"],["古像赞二百零五首 其六十三 郭有道","孙承恩","四言",["贞不绝俗，隐不违亲。","言论风旨，贤愚倾心。","和不辱身，巽不降志。","我惟其人，夷惠之似。"],0,"x290","明"],["古像赞二百零五首 其六十四 徐孺子","孙承恩","四言",["徐子高士，居贫食力。","贞介益固，明哲允迪。","君子道丧，群邪煽凶。","我怀其人，冥冥飞鸿。"],0,"x290","明"],["古像赞二百零五首 其六十五 蔡中郎","孙承恩","四言",["孝行纯备，经学邃深。","旷世逸才，博物洽闻。","箴规时政，忠谠恳恻。","晚节依违，贤者之惜。"],0,"x290","明"],["古像赞二百零五首 其六十六 汉昭烈帝","孙承恩","四言",["贤矣昭烈，宽厚弘毅。","崎岖立国，仗信履义。","推诚任贤，肝胆孚契。","顾命数词，可训后世。"],0,"x290","明"],["古像赞二百零五首 其六十七 诸葛武侯","孙承恩","四言",["文武长才，出处大义。","俊伟光明，掀揭天地。","伊吕作配，管晏匪伦。","三代之后，惟公一人。"],0,"x290","明"],["古像赞二百零五首 其六十八 关寿亭侯","孙承恩","四言",["勇若一国，敌号万人。","义气忠肝，贯日凌云。","英威所加，华夏震仰。","百世钦崇，神留天壤。"],0,"x290","明"],["古像赞二百零五首 其六十九 张翼德","孙承恩","四言",["姿貌瑰奇，才具粗猛。","神矛飙发，万众独骋。","委质授命，死生靡他。","国士之风，百世尔夸。"],0,"x290","明"],["古像赞二百零五首 其七十 魏太祖","孙承恩","四言",["老瞒奸雄，才具明略。","威加海宇，力振山岳。","魏业巳固，汉鼎潜移。","比迹文王，吾将谁欺。"],0,"x290","明"],["古像赞二百零五首 其七十一 钟太傅","孙承恩","四言",["元常伟才，开达理干。","委身魏朝，禆益庙算。","拳拳肉刑，复古之规。","纷纷之言，迄无所归。"],0,"x290","明"],["古像赞二百零五首 其七十二 司马宣王","孙承恩","四言",["仲达足智，用兵独优。","殄渊擒达，算无遗谋。","仁胜不仁，遇亮则靡。","巾帼之受，英雄之耻。"],0,"x290","明"],["古像赞二百零五首 其七十三 吴大帝","孙承恩","四言",["仲谋强明，委任才智。","听言能断，业乃鼎峙。","倍义负汉，屈身事曹。","传世四君，霸图亦消。"],0,"x290","明"],["古像赞二百零五首 其七十四 周公瑾","孙承恩","四言",["矫矫公瑾，实吴良臣。","雄姿英发，筹策迈伦。","老瞒长驱，志无江表。","一战蹙之，功莫与绍。"],0,"x290","明"],["古像赞二百零五首 其七十五 晋武帝","孙承恩","四言",["帝资弘裕，明达好谋。","纂述先志，混一九州。","礼优三恪，忠厚之道。","贻谋弗臧，识者所少。"],0,"x290","明"],["古像赞二百零五首 其七十六 晋元帝","孙承恩","四言",["晋失中土，元起江东。","皇天眷德，群贤效忠。","冲虚性成，恭德纯至。","雄武未优，中兴犹愧。"],0,"x290","明"],["古像赞二百零五首 其七十七 王司徒","孙承恩","四言",["江左夷吾，忠实体国。","云雷方屯，急贤辅翼。","建学明教，宏议远识。","约巳夷淡，人服清德。"],0,"x290","明"],["古像赞二百零五首 其七十八 谢文靖公","孙承恩","四言",["谢子贤辅，沉敏有文。","和靖御物，从容解纷。","逸志高情，日短途促。","召埭悲思，西州恸哭。"],0,"x290","明"],["古像赞二百零五首 其七十九 王右军","孙承恩","四言",["风节雅尚，清真自如。","超出风气，规切浮虚。","忧国忠诚，识治通达。","翰墨风流，秪见其末。"],0,"x290","明"],["古像赞二百零五首 其八十 陶彭泽","孙承恩","四言",["渊明气象，五斗弗屑。","三径艺菊，相看晚节。","朝市非故，门庭依然。","千古高风，我怀其贤。"],0,"x290","明"],["古像赞二百零五首 其八十一 谢康乐","孙承恩","四言",["山水性僻，绳墨靡拘。","高才傲物，谋身则疏。","彭泽天然，子亦洵美。","声诗并休，静躁殊矣。"],0,"x290","明"],["古像赞二百零五首 其八十二 宋武帝","孙承恩","四言",["徒步仗剑，荡残除凶。","沉毅才略，一时之雄。","震主功高，终膺宝历。","清俭严正，可谓君德。"],0,"x290","明"],["古像赞二百零五首 其八十三 宋文帝","孙承恩","四言",["恭俭德纯，元嘉政美。","守法不苛，容物无弛。","内清外宴，文教亦举。","谋泄房帷，祸成商竖。"],0,"x290","明"],["古像赞二百零五首 其八十四 檀永兴公","孙承恩","四言",["永兴桓桓，将才汝嘉。","勇见决战，智征量沙。","作帝股肱，为国藩屏。","自戕谓何，邻敌之庆。"],0,"x290","明"],["古像赞二百零五首 其八十五 魏高祖","孙承恩","四言",["睿性夙成，君德纯备。","外扬武功，内饬文治。","礼乐修举，民物阜丰。","蔚然可观，太平之风。"],0,"x290","明"],["古像赞二百零五首 其八十六 齐武帝","孙承恩","四言",["宋既讫符，齐乃受历。","简静为治，宽大御物。","崇俭屏奢，澄流塞源。","金土同价，斯言未然。"],0,"x290","明"],["古像赞二百零五首 其八十七 梁武帝","孙承恩","四言",["著述浩穰，齐鲁宿儒。","性行简俭，山泽之臞。","梵典徒勤，帝纪不立。","反噬弯弧，皇图遂讫。"],0,"x290","明"],["古像赞二百零五首 其八十八 昭明太子","孙承恩","四言",["睿资天启，令德夙闻。","恭俭自居，仁柔爱人。","纂辑辞章，博涉典籍。","潜文梵教，兹其蔽惑。"],0,"x290","明"],["古像赞二百零五首 其八十九 程忠壮公","孙承恩","四言",["侯氏乱梁，江左荼毒。","惟忠壮公，保障南服。","孰我胁诱，我斩以徇。","大义茂功，百世犹信。"],0,"x290","明"],["古像赞二百零五首 其九十 陈武帝","孙承恩","四言",["英资杰气，胜算雄图。","荡除凶残，如拉朽枯。","政从宽仁，志尚节俭。","功名之盛，江左之冠。"],0,"x290","明"],["古像赞二百零五首 其九十一 周高祖","孙承恩","四言",["率履勤俭，操执纪纲。","雄图远略，匹休前王。","鞭笞四夷，混一区宇。","有志未酬，英雄巳矣。"],0,"x290","明"],["古像赞二百零五首 其九十二 隋文帝","孙承恩","四言",["勤俭兴邦，法律御世。","功就混一，俗几康乂。","猜刻习胜，夺宗计行。","酿成厉阶，王祚遂倾。"],0,"x290","明"],["古像赞二百零五首 其九十三 文中子","孙承恩","四言",["进欲为周，上策君门。","退欲为孔，著书河汾。","疏爽通达，志尚亦伟。","格言良多，称隐君子。"],0,"x290","明"],["古像赞二百零五首 其九十四 韩新义公","孙承恩","四言",["韩公虎臣，猛气横骛。","徂征江南，疾卷径渡。","执彼国君，若缚狐兔。","为时干城，恢我王祚。"],0,"x290","明"],["古像赞二百零五首 其九十五 唐高祖","孙承恩","四言",["真人天生，隐见随时。","忽而泥蟠，忽而云飞。","扫涤隋昏，光启唐祚。","礼贤纳谏，大君之度。"],0,"x290","明"],["古像赞二百零五首 其九十六 唐太宗","孙承恩","四言",["显允太宗，聪明英武。","龙奋晋阳，雨泽九土。","安夏攘夷，雪耻酬古。","文德武功，卓冠无伍。"],0,"x290","明"],["古像赞二百零五首 其九十七 武后","孙承恩","四言",["力乘阳刚，才济阴慝。","运用四海，驱使百辟。","今古大变，宇宙穷凶。","虐焰一时，秽名无穷。"],0,"x290","明"],["古像赞二百零五首 其九十八 唐玄宗","孙承恩","四言",["廓清内难，光践天位。","推诚任贤，励精图治。","四海宁谧，兆民阜成。","开元之政，百世犹存。"],0,"x290","明"],["古像赞二百零五首 其九十九 唐德宗","孙承恩","四言",["畴咨惟勤，志意亦锐。","斤斤其明，彊幸自遂。","忌刻于始，姑息于终。","弊源在兹，多言何庸。"],0,"x290","明"],["古像赞二百零五首 其一○○ 唐宪宗","孙承恩","四言",["志感时艰，治慕祖烈。","好谋惟明，成功惟决。","强梗效顺，纪纲遂张。","允毅允臧，中兴煌煌。"],0,"x290","明"],["古像赞二百零五首 其一○一 唐武宗","孙承恩","四言",["君得臣兴，臣得君行。","君臣道合，事乃有成。","裕既贤弼，帝亦英主。","会昌之功，卓然可纪。"],0,"x290","明"],["古像赞二百零五首 其一○二 唐宣宗","孙承恩","四言",["法无偏颇，志尚勤俭。","惜赏慎官，好贤纳谏。","我思大中，亦汔小康。","忌刻害治，卒以弗昌。"],0,"x290","明"],["古像赞二百零五首 其一○三 长孙赵公","孙承恩","四言",["决谋辅主，定策立储。","武事非长，忠恳有馀。","辅治永徽，人多汝绩。","孽后肆屠，天下共惜。"],0,"x290","明"],["古像赞二百零五首 其一○四 房梁公","孙承恩","四言",["梁公善谋，神机朗彻。","推毂群材，翊赞大业。","端委宅揆，寅亮天工。","定制作则，一代元功。"],0,"x290","明"],["古像赞二百零五首 其一○五 杜蔡公","孙承恩","四言",["蔡公睿姿，明决果断。","辅相真主，戡定祸乱。","相资共济，协恭和衷。","治登太平，令名无穷。"],0,"x290","明"],["古像赞二百零五首 其一○六 李英公","孙承恩","四言",["矫矫英公，为时良将。","料敌制变，敌莫与抗。","荡定海宇，实多武功。","孽后祸基，乃亏臣忠。"],0,"x290","明"],["古像赞二百零五首 其一○七 李卫公","孙承恩","四言",["于惟卫公，雄武沉毅。","掌帝九伐，扫荡氛翳。","氛翳既清，泰阶以平。","铁山峣峣，武功并高。"],0,"x290","明"],["古像赞二百零五首 其一○八 魏郑公","孙承恩","四言",["蹇蹇郑公，维古遗直。","补衮纳忠，危言正色。","诋黜霸杂，敷陈义仁。","贞观治效，功无与伦。"],0,"x290","明"],["古像赞二百零五首 其一○九 褚河南公","孙承恩","四言",["河南蹇蹇，王魏之伦。","在太宗时，谠言屡闻。","牝鸡祸成，徒切忠谏。","主德则昏，公节愈见。"],0,"x290","明"],["古像赞二百零五首 其一一○ 尉迟鄂公","孙承恩","四言",["烈烈猛气，纠纠雄力。","崩围摧阵，前无坚敌。","刚毅木讷，庶几其人。","于古孰似，绛灌之伦。"],0,"x290","明"],["古像赞二百零五首 其一一一 虞永兴公","孙承恩","四言",["识综群儒，博冠当代。","考究典章，熙帝之载。","乃缉礼乐，乃开辟雍。","文教肆行，维公之功。"],0,"x290","明"],["古像赞二百零五首 其一一二 狄梁公","孙承恩","四言",["妖后乱唐，王祚欲绝。","批龙扼虎，几蹈祸烈。","拨乱反正，捧日再升。","社稷之功，孰能与争。"],0,"x290","明"],["古像赞二百零五首 其一一三 姚梁公","孙承恩","四言",["于惟姚公，才实经济。","遇主乘时，应变成治。","约束官职，修举章程。","四海以安，一人仰成。"],0,"x290","明"],["古像赞二百零五首 其一一四 宋文贞公","孙承恩","四言",["抗颜伪武，合志闻元。","挺挺谔谔，切论危言。","清介之守，刚正之气。","卓哉相业，吁其难继。"],0,"x290","明"],["古像赞二百零五首 其一一五 元鲁山","孙承恩","四言",["元子大雅，制行纯笃。","孝友配古，清介绝俗。","浑朴外著，英华内韬。","人接眉宇，鄙吝自消。"],0,"x290","明"],["古像赞二百零五首 其一一六 张曲江公","孙承恩","四言",["立朝謇谔，大臣之节。","制作尔雅，词林之杰。","识达治本，逆睹胡孽。","一代贤辅，式慕风烈。"],0,"x290","明"],["古像赞二百零五首 其一一七 郭汾阳王","孙承恩","四言",["尚父功高，再造唐室。","力扫妖氛，忠贯白日。","完名全节，福禄永终。","人臣师表，流芳无穷。"],0,"x290","明"],["古像赞二百零五首 其一一八 李临淮王","孙承恩","四言",["气盖三军，威摄群将。","法令严明，莫我或抗。","纳谏励士，麾旗破敌。","中兴之功，令名有赫。"],0,"x290","明"],["古像赞二百零五首 其一一九 颜鲁公","孙承恩","四言",["乌合抗胡，白首陷贼。","秉执节义，甘蹈鼎镬。","坐斥降奴，视若蚁虱。","劲气孤忠，严霜烈日。"],0,"x290","明"],["古像赞二百零五首 其一二○ 张睢阳","孙承恩","四言",["百炼刚心，千锤义骨。","应变出奇，风云倏忽。","手障长淮，气吞逆胡。","天道人伦，百世不诬。"],0,"x290","明"],["古像赞二百零五首 其一二一 贺季真","孙承恩","四言",["季真何如，性行夷旷。","士钦风韵，帝许高尚。","黄老寄迹，曲蘖逃真。","镜湖一曲，流风至今。"],0,"x290","明"],["古像赞二百零五首 其一二二 杜工部","孙承恩","四言",["诗圣惟甫，崇雅镇浮。","力敌元化，手遏颓流。","宗社隐忧，稷契素志。","一时旅人，令名百世。"],0,"x290","明"],["古像赞二百零五首 其一二三 李翰林","孙承恩","四言",["天才踔发，逸气横出。","龙骧鹏抟，不可控执。","友视万乘，奴使贵珰。","采石捉月，神游不忘。"],0,"x290","明"],["古像赞二百零五首 其一二四 陆宣公","孙承恩","四言",["颠沛从君，恳恻献替。","练达古今，本祖仁义。","唐室不竞，公用不终。","遗言若丹，人仰休风。"],0,"x290","明"],["古像赞二百零五首 其一二五 李西平王","孙承恩","四言",["烈烈西平，社稷是寄。","讨定叛逆，一雪国耻。","巍巍柱天，赫赫盖世。","钟鼎勒勋，山河存誓。"],0,"x290","明"],["古像赞二百零五首 其一二六 裴晋公","孙承恩","四言",["功在王室，名闻外夷。","柱石三朝，系时安危。","晚节优游，大雅明哲。","全德始终，永仰风烈。"],0,"x290","明"],["古像赞二百零五首 其一二七 韩文公","孙承恩","四言",["道丧文衰，子克振起。","排斥老佛，发挥洙泗。","并包百家，源委六经。","北斗泰山，百世尔承。"],0,"x290","明"],["古像赞二百零五首 其一二八 柳柳州","孙承恩","四言",["才气颖敏，莫邪干将。","制作彪炳，凌跞班扬。","锐进速成，爰致玷缺。","文场擅宗，令名不没。"],0,"x290","明"],["古像赞二百零五首 其一二九 孟东野","孙承恩","四言",["雕肝镂心，苦吟浚索。","句联韩豪，才配白敌。","诗非穷人，惟穷乃工。","风雅百篇，将无是同。"],0,"x290","明"],["古像赞二百零五首 其一三○ 贾浪仙","孙承恩","四言",["冥思犯尹，夺册忤君。","寄兴清苦，刊落华纷。","人亦有言，士附青云。","识拔昌黎，子乃有闻。"],0,"x290","明"],["古像赞二百零五首 其一三一 白少傅","孙承恩","四言",["早登王朝，忠谠屡闻。","再逐江州，与时浮沉。","鸡林声价，香山踪迹。","宠利淡然，可谓达识。"],0,"x290","明"]]