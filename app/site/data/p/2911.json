[["元符亲享明堂十一首 其二 上帝位奠玉币用《镇安》。","郊庙朝会歌辞","四言",["圣能享帝，孝克事亲。","于皇宗祀，盛节此陈。","何以荐虔，二精有炜。","何以致祥，上天鉴止。"],0,"x207","宋"],["熙宁祀皇地祇十二首 其四 太祖用《肇安》。","郊庙朝会歌辞","四言",["于皇烈祖，维帝所兴。","光辉宗祀，如日之升。","告灵作配，孝享烝烝。","锡兹祉福，百世其承。"],0,"x207","宋"],["大中祥符封禅十首 其八 皇地祇坐酌献用《禅安》。","郊庙朝会歌辞","四言",["坤德直方，博厚无疆。","秉阴得一，静而有常。","宝藏以发，乃育百昌。","肃祗禅祭，锡祉穰穰。"],0,"x207","宋"],["海滨石有根茎而生类于芝者俗呼为石花已为作记今日敷设花座严置净室普奉十方用结山斋净缘为此偈曰","郑刚中","四言",["幻化无穷，天巧难觑。","诸香妙华，种种呈露。","都随春来，亦随春去。","缤纷颠倒，与空同处。","此华希有，周流四序。","雨风雾烟，盈虚朝暮。","以何因缘，其体坚固。","无颜色染，无开落故。"],0,"x99","宋"],["司中司命五首 其二 升降用《钦安》。","郊庙朝会歌辞","四言",["绅緌舒舒，佩环铿铿。","陟降上下，坛燎光明。","有盥于罍，有帨于巾。","不吴不敖，庶以安神。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其三 奠玉币用《明安》。","郊庙朝会歌辞","四言",["司历告时，惟孟之春。","爰举时祀，旅于有神。","鼓钟既设，圭帛具陈。","阜蕃庶物，以福我民。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其十二 奠玉币用《明安》。","郊庙朝会歌辞","四言",["我祀我享，仪物孔周。","一纯斯举，二精聿修。","璞兮其温，丝兮其紑。","是荐洁蠲，神兮安留。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其二十一 奠玉币用《明安》。","郊庙朝会歌辞","四言",["练日有望，高灵来下。","何以告诚，心惟物假。","有篚斯实，有宝斯籍。","于以奠之，神光烛夜。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其二十八 奠玉币用《明安》。","郊庙朝会歌辞","四言",["彼林有庪，彼泽有沈。","猗与西望，弗菲弗淫。","乃追斯邸，乃㡛斯寻。","卬礼既卒，是用是歆。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其三十七 奠玉币用《明安》。","郊庙朝会歌辞","四言",["相予阴威，厥功浩浩。","一岁之功，何以为报。","府有圭币，我其敢私。","肃肃孔怀，于以将之。"],0,"x207","宋"],["高宗郊祀前朝享太庙三十首 其二十四 皇帝再升位诣饮福位用《干安》。","郊庙朝会歌辞","四言",["维皇亲享，至再至三。","礼备乐奏，层陛森严。","粢盛芳洁，酒醴旨甘。","云车风马，从卫观瞻。"],0,"x207","宋"],["华之高寿鲁斋先生七十  其一○","金履祥","四言",["百里何为，亦显其君。","武公九十，懿戒维新。"],0,83,"宋"],["宁宗朝享三十五首 皇帝入门用《干安》。","郊庙朝会歌辞","四言",["王假有庙，四极骏奔。","鼎俎宵严，簴簨云屯。","积厚流广，德隆庆蕃。","是则是绳，保我子孙。"],0,"x207","宋"],["皇后庙十五首 其十一 元德皇后室用《兴安》。","郊庙朝会歌辞","四言",["为太宗后，为天下母。","诞圣继明，膺干作主。","玉振金相，兰芬桂芳。","于万斯年，永奉烝尝。"],0,"x207","宋"],["熙宁蜡祭十三首 其八 南北方迎神用《简安》。","郊庙朝会歌辞","四言",["美若休德，民和岁丰。","稼穑云施，其积如墉。","惠我四国，先啬之功。","祭之百种，来享来宗。"],0,"x207","宋"],["乾道别庙乐歌三首 其三 懿节皇后室酌献用《歆安》。","郊庙朝会歌辞","四言",["丕显文母，厚德维坤。","仙驭虽邈，徽音固存。","瑟彼玉瓒，酌此郁尊。","简简穰穰，裕我后昆。"],0,"x207","宋"],["华之高寿鲁斋先生七十  其四","金履祥","四言",["东人之子，其来秩秩。","是追是琢，是进是服。"],0,83,"宋"],["绍兴以后时享二十五首 宣祖室酌献用《天元》。","郊庙朝会歌辞","四言",["天启炎历，集我大命。","长发其祥，笃生上圣。","夷乱芟荒，乾坤以定。","时祀聿修，孝孙有庆。"],0,"x207","宋"],["绍兴释奠武成王七首 其六 亚、终献用《正安》。","郊庙朝会歌辞","四言",["道助文德，言为世师。","功名不泯，祀事无遗。","旨酒惟馨，具醉在兹。","有嘉累献，神其燕娭。"],0,"x207","宋"],["宋初祀神州地祇三首 其三 送神用《静安》。","郊庙朝会歌辞","四言",["献奠云毕，纯嘏祁祁。","威灵藏用，邈矣何之。"],0,"x207","宋"],["韩氏周宣王时为侯尝入觐而归显父饯之尹吉甫作诵今司空康国公既老元祐丁卯朝京师戊辰春还许天子赐燕某赋是诗","彭汝砺","四言",["在昔韩侯，受命有周。","绍嗣禹功，以续祖考。","韩侯入觐，玄衮介圭，有淑其旆。","韩侯归止，显父是饯。","笾豆有践，奏鼓衎衎。","韩侯燕喜，既多受祉。","施于子孙，为宋柄臣。","有子且贤，长则上公。","亦似前人，有赫厥庸。","公老许田，载见式时。","朝有大疑，公为蓍龟。","公去不留，天子是思。","薄言维之，旟旐有辉。","都人咸喜，祝之千岁。","国有元老，邦家是赖。","康公之德，寅亮孔硕。","利泽在民，功在社稷。","孰能诗之，以继韩奕。","诞发其声，施于罔极。"],0,"x143","宋"],["淳祐祭海神十六首 升降用《钦安》。","郊庙朝会歌辞","四言",["灵之来至，垂庆阴阴。","灵之已坐，饬兹五音。","坛殿聿严，陟降孔钦。","灵宜安留，鉴我德心。"],0,"x207","宋"],["大晟府拟撰释奠十四首 奠币用《明安》。","郊庙朝会歌辞","四言",["自生民来，谁底其盛。","惟王神明，度越前圣。","粢币具成，礼容斯称。","黍稷非馨，惟神之听。"],0,"x207","宋"],["黄草道衣赞","刘一止","四言",["何草不黄，谁其纺绩。","持以售人，得不偿力。","居士少贱，组丽是饰。","力贫作奢，终愧于色。","居士老愚，山泽放逸。","下泽有车，登山着屐。","被此草衣，相羊自适。","倦鹄依林，野麋卧石。","维此草黄，不失士职。","不以本然，随彼染习。","戒哉居士，服之无斁。","馀年几何，以永厥德。"],0,239,"宋"],null,["绍兴祀神州地祇十六首 太宗位酌献用《化安》。","郊庙朝会歌辞","四言",["宗德含洪，方祇可儗。","辟土开疆，八埏同轨。","是用作配，有永无纪。","祼献以享，茂格蕃祉。"],0,"x207","宋"],["大观三年朝献景灵宫二首 其二 奉馔用《吉安》。","郊庙朝会歌辞","四言",["尔牲既充，是烹是肆。","尔肴既具，是羞是馈。","非物之重，惟德之备。","神之格思，歆我精意。"],0,"x207","宋"],["明道亲享先农十首 其四 奉俎用《丰安》。","郊庙朝会歌辞","四言",["将迎景福，乃荐嘉牲。","籍于千亩，用此精诚。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其十一 初献盥洗、升降用《同安》。","郊庙朝会歌辞","四言",["爰熙嘉坛，揭虔毖祀。","郁人沃盥，赞我祼事。","于降于登，以作以止。","莫不肃雍，告灵飨矣。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其二十 初献盥洗、升降用《同安》。","郊庙朝会歌辞","四言",["思来感格，肃雍不忘。","礼仪既备，济济跄跄。","洁蠲致敬，往荐其芳。","交若有承，神兮孔飨。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其二十七 初献盥洗、升降用《同安》。","郊庙朝会歌辞","四言",["靡实不新，靡陈不濯。","人之弗蠲，矧敢将酌。","载晞之帨，载濡之勺。","洗仪告备，陟降时若。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其三十六 初献盥洗、升降用《同安》。","郊庙朝会歌辞","四言",["寿宫𪸩煌，聿修时祀。","缤其临矣，吉蠲以俟。","居乎昂昂，行乎遂遂。","敬尔攸司，展采错事。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 升殿用《干安》。","郊庙朝会歌辞","四言",["帝居瑶图，璇题玉京。","日月经振，列宿上荧。","桂簋𫗣芬，瑚器华晶。","夤承禋祀，用戒昭明。"],0,"x207","宋"],["宁宗郊祀二十九首 入小次用《干安》。","郊庙朝会歌辞","四言",["听惟飨德，监惟棐忱。","顾𬤊思明，灵承思钦。","永言端莅，肃对下临。","上帝是皇，毋贰尔心。"],0,"x207","宋"],["绍兴祀皇地祇十五首 太祖位用《定安》。","郊庙朝会歌辞","四言",["毖祀泰折，柔祇是承。","于赫艺祖，道格三灵。","式严配侑，厚德惟宁。","爰昭荐币，享于克诚。"],0,"x207","宋"],["大中祥符朝会五首 其三 三举酒用《庆云》。","郊庙朝会歌辞","四言",["惟帝佑德，卿云发祥。","纷纷郁郁，五色成章。","奉日逾丽，回风载翔。","歌荐郊庙，播厥无疆。"],0,"x207","宋"],["唐彦猷谈奉得达二帖赞","岳珂","四言",["公于国史，以好砚称。","石焉取斯，盖协其能。","遒媚之观，在此尺纸。","善工利器，予鉴如此。"],0,"x202","宋"],["绍兴祀皇地祇十五首 太祖位酌献用《英安》。","郊庙朝会歌辞","四言",["皇矣艺祖，九围是式。","至哉柔祇，万汇允殖。","保兹嘉邦，介我黍稷。","酌鬯告虔，作配无极。"],0,"x207","宋"],["熙宁望祭岳镇海渎十七首 其四 酌献用《成安》。","郊庙朝会歌辞","四言",["肇兹东土，含润无疆。","维时发春，嘉荐令芳。","祭用薶沈，顺性含藏。","不涸不童，诞降祺祥。"],0,"x207","宋"],["熙宁望祭岳镇海渎十七首 其七 酌献用《成安》。","郊庙朝会歌辞","四言",["景风应律，朱鸟开辰。","肃肃明祀，嘉笾列陈。","牲用牷物，乐奏蕤宾。","克绥永福，祐此下民。"],0,"x207","宋"],["熙宁望祭岳镇海渎十七首 其十 酌献用《成安》。","郊庙朝会歌辞","四言",["高广融结，实维中央。","宣气报功，利彼一方。","坎坛以祀，六乐锵锵。","灵其有喜，酌以大璋。"],0,"x207","宋"],["熙宁望祭岳镇海渎十七首 其十三 酌献用《成安》。","郊庙朝会歌辞","四言",["西颢沆砀，执矩司秋。","诹言协灵，时祀孔修。","礼有荐献，爰视公侯。","秩而祭之，百福是遒。"],0,"x207","宋"],["熙宁望祭岳镇海渎十七首 其十六 酌献用《成安》。","郊庙朝会歌辞","四言",["凄寒凝阴，陨箨涤场。","百物顺成，黍稷馨香。","款于北郊，爰因其方。","何以侑神，荐此嘉觞。"],0,"x207","宋"],["宁宗郊祀二十九首 升坛用《干安》。","郊庙朝会歌辞","四言",["崇台穹窿，高灵下堕。","庆阴彷佛，从坐嶪峨。","宵升于丘，时通权火。","维天之命，百禄是荷。"],0,"x207","宋"],["偈颂一百二十三首 其九十五","释普度","四言",["用𨱄斧子，非重非轻。","拈起放下，肘后符灵。"],0,144,"宋"],["朝谒太清宫九首 其五 奉馔用《吉安》。","郊庙朝会歌辞","四言",["金奏以谐，飙游斯格。","灵监章明，皇心励翼。","肃奉雕俎，来升彩席。","享德有孚，凝禧无斁。"],0,"x207","宋"],["淳祐祭海神十六首 西海位酌献用《类安》。","郊庙朝会歌辞","四言",["积流疏派，被于流沙。","布润施泽，功均迩遐。","我秩祀典，四海一家。","祗荐令芳，灵其享嘉。"],0,"x207","宋"],["明道亲享先农十首 其三 奠玉币用《嘉安》。","郊庙朝会歌辞","四言",["将躬黛耜，先陟灵坛。","嘉玉量币，乐举礼殚。","神既至止，福亦和安。","千斯积咏，万国多欢。"],0,"x207","宋"],["祭九鼎十二首 其十二 冬至，宝鼎奠币用《明安》。","郊庙朝会歌辞","四言",["秉心齐明，奉牲博硕。","匏丝铿陈，冠佩俨饰。","其肆其将，明神来格。","执奠维何，猗欤币帛。"],0,"x207","宋"],["景祐以后乐章六首 其三 章懿皇太后室奠瓒用《报安》。","郊庙朝会歌辞","四言",["青金玉瓒，祼将于京。","永怀罔极，夙夜齐明。"],0,"x207","宋"],["宋初祀神州地祇三首 其一 降神用《静安》。","郊庙朝会歌辞","四言",["膴膴郊原，茫茫宇县。","画野分疆，禹功疏奠。","灵祇是臻，豆笾祗荐。","幽赞皇图，视之不见。"],0,"x207","宋"],["华之高寿鲁斋先生七十  其二","金履祥","四言",["维王及何，文公孙子。","天子是师，斯文之纪。"],0,83,"宋"],["上仁宗英宗徽号一首 入门升殿用《显安》。","郊庙朝会歌辞","四言",["于穆仁祖，宠绥万方。","执竞英考，迄用成康。","图徽宝册，有烈其光。","庶几亿载，与天无疆。"],0,"x207","宋"],["崇恩太后升祔十四首 酌献用《兹安》。","郊庙朝会歌辞","四言",["雍雍玉佩，清酤惟良。","粢盛具列，有𫗣其香。","怀其徽范，德洽无疆。","于兹燕止，降福穰穰。"],0,"x207","宋"],["绍兴祀先农摄事七首 其五 后稷位酌献用《成安》。","郊庙朝会歌辞","四言",["有周膺历，实起后稷。","相时丰功，率由稼穑。","振古称祀，先农并食。","阜我昌我，时万时亿。"],0,"x207","宋"],["绍兴祀太社太稷十七首 盥洗用《正安》。","郊庙朝会歌辞","四言",["祭重齐肃，神格专精。","沃洗于阼，涓洁著诚。","清明鬯矣，熙事备成。","以似以续，如坻如京。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 还位用《干安》。","郊庙朝会歌辞","四言",["烝哉我皇，继天毓圣。","逆厘玄都，对越灵庆。","如天斯久，如日斯盛。","瑶图浚邈，永隆骏命。"],0,"x207","宋"],["绍兴祀高禖十首 奠玉币用《嘉安》。","郊庙朝会歌辞","四言",["青律载阳，有鳦颉颃。","祈我繁祉，立子生商。","三牲既荐，玉帛是将。","克禋克祀，有嘉其祥。"],0,"x207","宋"],["绍兴祀大火十二首 捧俎用《丰安》。","郊庙朝会歌辞","四言",["火遵其令，无物不长。","视此牲牢，务得其养。","豢以祀神，有腯其肥。","非神之宜，其将曷归。"],0,"x207","宋"],["华之高寿鲁斋先生七十  其一五","金履祥","四言",["明明天子，宅此四国。","寤寐幽人，旌旄币帛。"],0,83,"宋"],["祫享八首 光宗室酌献用《大承》。","郊庙朝会歌辞","四言",["于皇光宗，握符御极。","昭哉嗣服，惟仁与德。","勤施于民，靡有暇逸。","万年之思，永奠宗祏。"],0,"x207","宋"],["大中祥符封禅十首 其三 太祖配坐酌献用《封安》。","郊庙朝会歌辞","四言",["于穆圣祖，肇开鸿业。","我武惟扬，皇威有晔。","四隩混同，百灵震叠。","陟配高穹，明灵是接。"],0,"x207","宋"],["大中祥符封禅十首 其四 太宗配坐酌献用《封安》。","郊庙朝会歌辞","四言",["祗若封祀，神宗配天。","礼乐明备，奠献精虔。","景灵来格，休祥蔼然。","于昭垂庆，亿万斯年。"],0,"x207","宋"],["绍兴祀先农摄事七首 其七 送神用《凝安》。","郊庙朝会歌辞","四言",["熙事成兮，始终洁齐。","笾豆彻兮，撙节靡垂。","灵有嘉兮，降福孔皆。","票然逝兮，我心孔怀。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 亚、终献用《庆安》。","郊庙朝会歌辞","四言",["申以贰觞，百味且旨。","礼告三终，神具醉止。","旌容骑沓，扬光纷委。","降福穰穰，被大丰美。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 亚、终献用《庆安》。","郊庙朝会歌辞","四言",["歌磬胪驩，膋萧激香。","飙御奄留，申以贰觞。","相与震澹，告灵其醉。","庶几听之，成我熙事。"],0,"x207","宋"],null,["出火祀大辰十二首 宣明王位酌献用《祐安》。","郊庙朝会歌辞","四言",["周设司爟，虽列夏官。","仍袭孔易，闿端实难。","相彼商丘，永怀初造。","不腆桂椒，匪以为报。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 降殿用《干安》。","郊庙朝会歌辞","四言",["璇庭烂景，紫殿流光。","礼洽干回，福应日昌。","圣系厖鸿，景命溥将。","德茂功成，率祀无疆。"],0,"x207","宋"],null,["淳熙十五年上高宗徽号三首 其二 册宝升殿用《显安》。","郊庙朝会歌辞","四言",["有瑑斯宝，有编斯册。","导以麾仗，奏以金石。","祲威盛容，煌煌赫赫。","巨工奉之，高灵来格。"],0,"x207","宋"],["大中祥符五岳加帝号祭告八首 其三 酌献东岳用《嘉安》。","郊庙朝会歌辞","四言",["节彼岱宗，有严庙貌。","惟辟奉天，依神设教。","帝典焜煌，嘉荐普淖。","至灵格思，殊祥是效。"],0,"x207","宋"],["宁宗郊祀二十九首 降坛用《干安》。","郊庙朝会歌辞","四言",["天容澄谧，景气晏和。","瓒斝荐醇，𫓶璆叶歌。","帝降庭止，夜其如何。","神助之休，宜尔众多。"],0,"x207","宋"],["宁宗郊祀二十九首 降坛用《干安》。","郊庙朝会歌辞","四言",["天锡多祉，皇受五福。","言瞻瑶坛，迄奉瑄玉。","昭星炳耀，元气回复。","帝仪载旋，有嘉穆穆。"],0,"x207","宋"],["大观三年释奠六首 其五 配位酌献用《成安》。","郊庙朝会歌辞","四言",["俨然冠缨，崇然庙庭。","百王承祀，涓辰惟丁。","于牲于醑，其从予享。","与圣为徒，其德不爽。"],0,"x207","宋"],["理宗明堂前朝献景灵宫二首 其二 亚献宫架《冲安》。","郊庙朝会歌辞","四言",["庆云郁郁，鸣璆琅琅。","澹其容与，申荐贰觞。","奉承若宥，神其乐康。","锡以多祉，源深流长。"],0,"x207","宋"],["绍兴二十八年祀圜丘 皇地祇位奠玉币用《嘉安》。御制。","郊庙朝会歌辞","四言",["至哉坤厚，𬯎然止静。","柔载动植，资始成性。","玉光币色，璨若其映。","式恭禋祀，有邦之庆。"],0,"x207","宋"],["元符祭神州地祇二首 其二 送神用《宁安》。","郊庙朝会歌辞","四言",["都邑浩穰，民物富盛。","主以灵祇，昭乃丕应。","玉帛牲牷，鼓钟筦磬。","祗荐攸歆，归于至静。"],0,"x207","宋"],["绍兴祀九宫贵神十首 太一位奠玉币用《嘉安》。","郊庙朝会歌辞","四言",["煌煌九宫，照临下土。","阴骘庶类，功施周普。","恪修祀典，礼备乐举。","嘉玉量币，馨非稷黍。"],0,"x207","宋"],["北山之高寿北山何先生  其四","金履祥","四言",["咨尔夫子，设教于乡。","即命于家，长此泮宫。"],0,83,"宋"],["唐侯仲友之守台为浮梁于江象山令蒋鹗考叔赋江有济三章以献余时官于台见而陋之作江有梁  其四","孙应时","四言",["我梁既成，我民既平。","侯智不矜，侯心载宁。","帝曰汝归，其车宵征。","予欲济川，邦国是经。","民留我侯，敢与帝争。","我帝我侯，眉寿无疆。"],0,"x196","宋"],null,["观水磨牌文有省","释法忠","四言",["转大法轮，目前包裹。","更问如何，水推石磨。"],0,222,"宋"],["大中祥符封禅十首 其十 太宗配坐酌献用《禅安》。","郊庙朝会歌辞","四言",["毖祀柔祇，报功厚载。","思文太宗，侑神严配。","钟石斯和，笾豆咸在。","永锡坤珍，资生为大。"],0,"x207","宋"],["大中祥符朝会五首 其五 五举酒用《瑞木》。","郊庙朝会歌辞","四言",["天生五材，木曰曲直。","维帝顺天，厚其生植。","连理效祥，成文表德。","总萃坤珍，永光秘刻。"],0,"x207","宋"],["绍兴享先农十一首 其三 神农、后稷位奠币用《嘉安》。","郊庙朝会歌辞","四言",["制为量币，厚意是将。","求之以类，各因其方。","于以奠之，精诚允彰。","神其享止，惠我无疆。"],0,"x207","宋"],["宁宗郊祀二十九首 还大次用《干安》。","郊庙朝会歌辞","四言",["福方流胙，祈方钦柴。","卤簿载肃，球架允谐。","帝祉具临，皇灵允怀。","遄御于次，降福孔皆。"],0,"x207","宋"],["北山之高寿北山何先生  其二","金履祥","四言",["翼翼夫子，令德在躬。","道广心平，不外以衷。","北山之阳，盘溪之将。","以处以安，不骄不亢。"],0,83,"宋"],["北山之高寿北山何先生  其三","金履祥","四言",["昔在理宗，维道之崇。","既表程朱，亦跻吕张。","谓尔夫子，纉程朱绪。","卿士率连，百辟咸誉。"],0,83,"宋"],["熙宁蜡祭十三首 其六 亚、终献用《庆安》。","郊庙朝会歌辞","四言",["礼文备矣，肃肃无哗。","金石谐节，圭璧光华。","粢以告丰，醴以告嘉。","锡兹福祉，以泽幽遐。"],0,"x207","宋"],["绍兴亲享明堂二十六首 其十二 昊天上帝位酌献用《庆安》。","郊庙朝会歌辞","四言",["日在东陆，维时上辛。","肇开阳馆，恭礼尊神。","苍玉辉夜，紫烟炀晨。","祖宗并配，天地同禋。"],0,"x207","宋"],["出火祀大辰十二首 大辰位酌献用《祐安》。","郊庙朝会歌辞","四言",["孰为大辰，维北有斗。","曾是彗星，斯名孔有。","幽荣报功，洁齐敢后。","容与嘉觞，式歆旨酒。"],0,"x207","宋"],["高宗明堂前朝献景灵宫十首 其四 奉馔用《吉安》。","郊庙朝会歌辞","四言",["琼琚锵锵，玄衣绣裳。","荐嘉升香，粢盛芬芳。","礼仪莫愆，鼓钟喤喤。","曾孙之常，绥福无疆。"],0,"x207","宋"],["绍兴二十九年显仁皇后祔庙一首 酌献用《歆安》。","郊庙朝会歌辞","四言",["恭惟圣母，跻祔孔时。","陈羞宗祏，徼福坤仪。","钟鼓惟序，牲玉载祗。","于皇来格，永介丕基。"],0,"x207","宋"],["雍熙享先农六首馀同祈谷 其三 奉俎用《丰安》。","郊庙朝会歌辞","四言",["肃陈韶舞，祗荐牺牲。","乃逆黄俎，以率躬耕。"],0,"x207","宋"],["北山之高寿北山何先生  其五","金履祥","四言",["夫子曰辞，辞是好爵。","玉几导扬，燕翼是托。"],0,83,"宋"],["北山之高寿北山何先生  其六","金履祥","四言",["明明天子，丕承皇考。","曰求多闻，曰咨有道。","天子曰都。","咨尔夫子，为世宗儒。","来游来歌，东观石渠。"],0,83,"宋"],["北山之高寿北山何先生  其七","金履祥","四言",["夫子曰止，臣非索隠。","士各有志，亦既耄只。","天子曰猷。","咨尔夫子，汝予交修。","讲殿维帷，尔优尔游。"],0,83,"宋"],["华之高寿鲁斋先生七十  其一四","金履祥","四言",["毋信其言，省其退私。","毋晦其明，而左右咨。"],0,83,"宋"],["大中祥符封禅十首 其二 昊天上帝坐酌献用《奉安》。","郊庙朝会歌辞","四言",["皇天上帝，阴骘下民。","道崇广覆，化洽鸿钧。","灵文诞锡，宝命惟新。","增高钦事，式奉严禋。"],0,"x207","宋"]]