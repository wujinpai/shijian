[["添声杨柳枝","王哲","杂言",["一息来时衮气球，骋风流。","不来一息破胞抽，这回休。","若要依前常建贩，复从头。","胞儿里面气重收，再㑩偻。"],0,"x263","元"],["系云腰 自咏","王哲","杂言",["终南山顶重阳子，真自在。","最逍遥。","清风明工为伴，响灵呶，空外愈，韵偏饶。","蓬莱稳路频频往，只能访，古王乔。","丹霞翠雾常攒簇，弄轻飙。","系云腰。","上青霄。"],0,"x263","元"],["豆叶黄（北曲）","王哲","杂言",["奉报英贤，早些出路。","卜灵景，清凉恬淡好住。","开阐长生那门户。","便下手修持，真功真行，真性昭著。","姹女骑龙，婴儿跨虎。","把珠玉琼瑶，颠倒换取。","正是逍遥自在处。","结一粒明珠，金丹金镜，金耀攒聚。"],0,"x263","元"],["刮鼓社","王哲","杂言",["刮鼓社，这刮鼓食中饱。","我看豌豆将来后，且圌起须入窖。","莫收多、不须收少。","上头自有三光照。","似象棋何劳打炮。","有几个人知道。","有几个人知道。"],0,"x263","元"],["刮鼓社","王哲","杂言",["会戏谑。","正洽真欢乐。","显现玲珑，玎珰了了。","遍体缨络。","遂引下、满空鸾鹤。","迎来接去同盘礴。","共舞出、九光丹药。","蓬莱路有期约。"],0,"x263","元"],["宜靖三台 化丹阳","王哲","杂言",["有限形躯，无涯火院，刹那催促光阴。","想人生、有似当风烛，整日家、昼忙夜惊。","有等愚迷，千思万想，家缘逼迫浑沉。","爱子怜妻，被冤家、系缆萦身。","猛悟回头，名缰割断，恩山推倒重重。","将爱海跳出，清闲乐道逍遥，半张纸，一张琴。","土榻安眠，牢拴意马，莫教斗乱身心。","慧剑挥时，斩群魔、万神自宁。","二气相交，龙奔虎走，金乌玉兔相迎。","入玉炉、金鼎丹砂，炼阳神、出朝玉京。","此个家风，冰清玉洁，点头多谢知音。","欲要成双全后，价值千金。"],0,"x263","元"],["河传令","王哲","杂言",["竹冠顶按。","更竹作水瓶，至今常将手盥。","竹杖竹篮，竹笠竹车竹钻。","竹林中，竹笛鸣，声自唤。","木鞋衬脚真热暖。","木做盘儿，镜磨明圆满。","木箸木匙，木杓木盔木碗。","木阴间，木牛耕，田三段。"],0,"x263","元"],["河传令","王哲","杂言",["害风落魄。","便飘蓬信任，到处并无篱落。","游历水云，管甚身躯零落。","觅残馀，傍人家。","闲院落。","众皆笑我贫沦落。","教他骨头，无福长流落。","看你不知，将来何方下落。","免伊忧，恁时节，超碧落。"],0,"x263","元"],["河传令","王哲","杂言",["营躯手段。","这饥寒未免，上街须当唱唤。","提个净清，了了惺惺铁罐。","觅残馀，声声叫，道摄乱。","极承贵府人悯叹。","唯愿诸公，心怀常照管。","选甚冷吃，将来腹中煎□。","炼重阳，方堪看，害风汉。"],0,"x263","元"],["河传令 知县董德夫小","王哲","杂言",["德夫知县。","坐上将余便。","索河传令。","堂下落花，你咱分明亲见。","稍知空，这攀缘，都不恋。","争如修取来生善。","早悟光阴，急急同飞箭。","足爱前亲，好心长行方便。","若回头，随我访，神仙面。"],0,"x263","元"],["河传令 赠京兆赵公","王哲","杂言",["心合眼莹，耳聪意静，鼻通舌辩。","说山头，一派清流落涧。","中烹，焰儿，紧不慢。","西金解东方版片，便令虎龙，同打扮得明珠，诸般不教兴贩。","春来，金生，花复绽。"],0,"x263","元"],["河传令 赠京兆席句押","王哲","杂言",["衫败易处。","俗情正好，知白守黑。","院脱离，好把明珠怜惜。","年时，因缘，怎生积。","心约已为规则。","圭一粒。","细思非难觅。","性识真，便是神仙端的。","明公，专上，都押席。"],0,"x263","元"],["转调丑奴儿","王哲","杂言",["苦苦劝愚人。","被财色、投损精神。","利缰名锁休贪恋。","韶华迅速如流箭。","不可因循。","早早出迷津。","乐清闲、养就天真。","性圆丹结，方知道、蓬莱异景、元来此处，别有长春。"],0,"x263","元"],["转调斗鹌鹑北曲","王哲","杂言",["一个灵明，作仙子材。","响彻瑶宫，蕊金自开。","为忒玲珑出蓬莱。","降下来。","谪在凡间，托生俗胎。","只恐身便，酒色气财。","混一回。","风流此心便灰。","复悟前真免轮回。","没甚灾。","看看却得，重上玉台。"],0,"x263","元"],["金花叶","王哲","杂言",["名利牵缠怎彻。","谁肯把、善缘总结。","在火宅、居常炙□。","尚穿聊恶业。","斗巧争如守拙。","早离了、机心切切。","稍能悟、三教秘诀。","也无生无灭。"],0,"x263","元"],["金鸡叫 警刘公","王哲","杂言",["占得虚空呈俊俏。","玄中玄，妙中绝妙。","自然五彩通灵照。","一颗明珠，万道霞光罩。","净净清清，泠泠晓晓。","昏昏默默，冥冥窈窈。","森罗万象辉辉耀。","月里蟾鸣，日里金鸡叫。"],0,"x263","元"],["金鸡叫 宁海军结金莲社","王哲","杂言",["社结金莲都不晓。","金盘献、七珠明了。","金陵河里知多少。","要现金光，须得金匙搅。","牵过般密妙。","金风内，好香笼罩。","金枝玉叶同成俏。","唤出金翁，便做金鸡叫。"],0,"x263","元"],["金鸡叫 警刘公","王哲","杂言",["识得希夷方见妙。","自然是、无烦无恼。","妻男孙女长缭绕。","爱狱恩山，把身躯紧缚抓。","苦要玲珑于已俏。","把慧刀、快磨频挑。","万斤铁索都碎了。","奉报刘公，省悟我金鸡叫。"],0,"x263","元"],["金莲堂 俗惜黄花藏头","王哲","杂言",["家自悟。","今观睹。","扶风安手脚，未知门户。","鬼作乖疏，下如何做。","人来、金相觑。","里为谁主。","风语汝。","还婴儿复姹，宝瓶牢固。","圣说因缘，系能结慕。","真洪登云路。"],0,"x263","元"],["金鼎一溪云","王哲","杂言",["对月成词句，临风写颂章。","一枝银管瑞中祥。","随山染清凉。","玉洞门开深浅，宝树花分香篆，蓬莱仙岛是吾乡。","宴罢后琼堂。"],0,"x263","元"],["青莲池上客","王哲","杂言",["元初一得从初遇。","便端正、昭彰著。","转作重阳晨彩煦。","晴空来往。","碧霄堪住。","琼马驸。","引入长生步。","灵光不动神光聚。","便攒簇、银霞护。","满插金花频返顾。","青衣鸾鹤，共同来赴。","瑶马驻。","般在清凉路。"],0,"x263","元"],["青莲池上客","王哲","杂言",["亘初独许能骑坐。","这骏驷、从牵拖。","直走盘旋双庆贺。","三山骨健，力筋偏大。","马辅佐。","万丈洪崖过。","谢伊驼出深坑祸。","衒玉辔，金缨亸。","喊雾嘶风游水火。","月华前面，四蹄轻锁。","马负荷。","也我成因果。"],0,"x263","元"],["青莲池上客 上元看辊灯球","王哲","杂言",["上元景致真堪看。","更片片、行云散。","现出天如青玉案。","放开心月，慧灯明照，两曜交光灿。","球妆七宝玲珑焕。","把性烛、当中按。","一对金童呈手段。","琼杆推转，顺风归去，辊入蓬莱观。"],0,"x263","元"],["青莲池上客 俗青玉案攒三拆字","王哲","杂言",["锁户真成也。","百朝惺洒。","冰餐非苟且。","玄妙，就中超□。","马眸粘惹。","恩爱俱齐舍。","闲游冶。","教余同幽雅。","仙子，共成修写。","马明星下。"],0,"x263","元"],["俊蛾儿 劝吏人","王哲","杂言",["见个惺惺真脱洒，堪比大丈夫字儿。","莫睎灯下俊蛾儿。","坏了命儿。","早早回头搜密妙，营养姹女婴儿。","道袍换了皂衫儿。","与太上做儿。"],0,"x263","元"],["恨欢迟","王哲","杂言",["名哲排三本姓王。","字知明、子号重阳。","似菊花、如要清香吐，缓缓等浓霜。","学易年高便道装。","遇渊明、语我嘉祥。","指蓬莱、云路如归去，慢慢地休忙。"],0,"x263","元"],["挂金灯 刘蒋庵","王哲","杂言",["好池亭，华丽于中莹。","善修外景。","装成内景。","这两事、谁能省。","谨按黄庭缉整。","表里通贤圣。","水心炎炎，火焰猛劲。","溉炼出真清净。"],0,"x263","元"],["祝英台 咏骷髅","王哲","杂言",["无事闲行郊野过。","见棺函板破。","里头白白一骷髅。","独潇洒愁愁。","为甚因缘当路卧。","往来人诽谤，在生昧昧了真修。","这回却休休。"],0,"x263","元"],["神光灿","王哲","杂言",["金关叩户，玉锁扃门，闲里不做修持。","杳默昏冥，谁会舞弄婴儿。","睡到擒猿捉马，醒来后、复采琼芝。","每依时，这功夫百日，只许心知。","自在逍遥做就，唯舒展红霞，光彩敷披。","罩定灵明，方见本有真葱。","一粒神丹结正，三重焰、紧紧相随。","过瑶池。","透青霄，顶上无为。"],0,"x263","元"],["耍蛾儿","王哲","杂言",["不会修行空养肚。","肾肺心肝脾祖。","五团臭肉怎为主。","先把黄婆咄去。","赶退青龙兼白虎。","不用婴儿姹女。","诸公要觅长生路。","别有一般门户。"],0,"x263","元"],["耍蛾儿","王哲","杂言",["如会修行寻捷路。","开阐全真门户。","汞知铅见作宗祖。","管取性停命住。","便是阴阳颠倒数。","今日分明说谕。","只依四个字儿做。","指日得归仙去。"],0,"x263","元"],["恣逍遥","王哲","杂言",["气全神神燕坐。","来与四方聚课。","说灵根坤对过。","平恁么。","么妙自无人我。","戟锋交，平相贺。","中宝结成一颗。","是惺惺，清没和。","津负荷。","须用这个那个。"],0,"x263","元"],["恣逍遥","王哲","杂言",["若要修行，须当子细，把金关玉门牢闭。","上下冲和，位交溉济。","得来后，惺惺又同猜谜。","混入虚空，却投根蒂。","亳光在、烂饮霞际。","五彩新鲜，真灵莹腻。","分明彻，净清阒然细细。"],0,"x263","元"],["恣逍遥","王哲","杂言",["物物拈来，般般打破。","惺惺用、玉匙金锁。","沥沥澄源，炎炎焰火。","盈盈处，上下倒颠换过。","妙妙神机，玄玄性果。","清清做、静中堪可。","现现虚空，灵灵真个，明明衮，光莹宝珠一颗。"],0,"x263","元"],["恣逍遥","王哲","杂言",["摆脱浊醪，凭传清水。","这滋味、香甜真美。","过得重楼，全无滓秽。","五门开、浇淋就中忒锐。","七宝滋荣，三田溉济。","十分用、刀圭和秘。","结作真晶，明明殊丽。","山峰上、风月共邀出世。"],0,"x263","元"],["恣逍遥 承杜先生传语","王哲","杂言",["识攒上身憔悴。","难解怎生远体。","元固壮还养气。","精麦髓。","骰润任缘欢喜。","诵经书，捐名利。","圭法且休整理。","锤金锁，窠紧闭。","关要洗。","须认分中闲贵。"],0,"x263","元"],["悟南柯","王哲","杂言",["芋栗今番彻，贤愚两共餐。","一能阳气做团圆。","一个沉沦阴魄，愈摧残。","来者归清净，迷人俗冗盘。","通全跳入好仙坛。","恰恰同居。","吉吉永相看。"],0,"x263","元"],["换骨骰","王哲","杂言",["幼慕清闲，长年间、便登道岸。","上高坡细搜修炼。","遇明师，授秘诀，分开片段。","堪赞。","真性灵灿灿。","也兀底。","功行双全，占逍遥、出尘看玩。","睹长天、化成仙观。","向云中，有一个，青童来叫唤。","风汉。","凡骨骰换换。","也兀底。"],0,"x263","元"],["换骨骰 叹贪婪","王哲","杂言",["叹彼人生，百岁七旬已罕。","皆不悟、光阴似箭。","每日家，只造恶，何曾作善。","难劝。","酒色财气恋。","也兀底。","福谢身危，忽尔年龄限满。","差小鬼、便来追唤。","当时间，领拽到，阎王前面。","憨汉。","和骨骰软软。","也兀底。"],0,"x263","元"],["换骨骰 叹脱祸不改过","王哲","杂言",["昨遇饥年，为甚累增劝教。","怎奈向、人人忒□。","越贪心，生狠妒，百端奸巧。","计较。","骋风流卖俏，也兀底。","忽尔临头，却被阎王来到。","问罪过、讳无谈矫。","当时间，令小鬼，将业镜前照。","失尿。","和骨骸软了。","也兀底。"],0,"x263","元"],["换骨骰 赠道友王十四郎","王哲","杂言",["一斩红崖，按阔狭、方能及丈。","横染架、细如秆杖。","在中间，谁做下，柴窝圆样。","被拉浪。","里面把龟儿放。","也兀底。","拟欲前行，恐失脚、怎生敢向。","退后来、全无抵当。","谩摇头。","空摆尾，万般惆怅。","转悒怏。","和壳儿软胀。","也兀底。"],0,"x263","元"],["桃园忆故人","王哲","杂言",["琉璃枝上琼花皓。","蓓蕾间成玛瑙。","乌玉叶儿偏好。","四件谁能讨。","静中认得真家宝。","艳彩诚非草草。","唯有个人知道。","共得归蓬岛。"],0,"x263","元"],["特地新","王哲","杂言",["天地人生，同来相遇。","应将甚、昭彰显务。","道门开，释门阐，儒门堪步。","识元初，习元本，睹元辰，元阳自固。","日月星辰，齐旋躔度。","唯临莅、虚空照布。","精关扃，气关达，神关超露。","禀三才，立三教，得三光，三丹宝聚。"],0,"x263","元"],["特地新 劝世","王哲","杂言",["骋俏多能，身呈体段。","把衣衫、频频脱换。","穿茶枋，入酒店，总夸好汉。","蓦然遇天高，这精神早减了一半。","奉劝风流，惺惺早断。","保元阳、休教紊乱。","稍回头，开道眼，金莲长看。","玉花放，异香来，吐光明，满宽炳焕。"],0,"x263","元"],["真欢乐","王哲","杂言",["便把户门安锁钥。","内更蕴、最奇略。","安炉灶、锻炼金精，养元神、修完丹药。","二粒圆成光灼灼。","虚空外，往来盘礴。","五彩总扶持。","也无施无作。","冥冥杳杳非投托。","占盈盈，赴盟约。","蓬莱路、永结前期，定长春、瑶芳琼萼。","等接清凉光偏烁。","放馨香、自然雯作。","里面礼明师，现真欢真乐。"],0,"x263","元"],["莫思乡 赠丹阳","王哲","杂言",["栗子味堪收。","更出馨香是芋头。","今后吃时思想定，追求。","为甚般般各六筹。","细认细寻搜。","芋有青苗栗有□。","空外地中归一处，休休。","说破玄玄你越愁。"],0,"x263","元"],["郭郎儿慢","王哲","杂言",["自在逍遥，清静恣闲行走。","拄灵杖、慢垂宽袖。","任彩霞、缭绕紧相随，更远远香风，翠雾同来诱。","忽昂头，蓦观莹景添秀。","见青衣、半空召手。","便唤余、休更别追寻，指白云深处，这里神仙有。"],0,"x263","元"],["郭郎儿慢","王哲","杂言",["日放银霞，甘雨滴成珠露。","昭清风、气神同助。","便致令、相守镇相随，更宝种三田，九转灵丹聚。","碧虚前，遍生玉芝金树。","绽瑶花、满空无数。","烂熳开、琼蕊吐馨香。","正馥郁当中，一点光明住。"],0,"x263","元"],["望蓬莱","王哲","杂言",["修炼事，子细好铺陈。","外做四肢安乐法，内观五脏倒颠因。","便是得全真。","坚守定，营壳要申申。","二气合和开本性，三田搬运助灵神。","只此唤仙人。"],0,"x263","元"],["望蓬莱","王哲","杂言",["回首处，便要识希夷。","锻炼须将情来尽，修行紧与世相违。","勘破是归依。","蟾玉走，认取个金飞。","交位东西通地髓，冲和上下合天机。","方得妙中微。"],0,"x263","元"],["望蓬莱","王哲","杂言",["重阳子，饮水得良因。","洗涤尘劳澄净至，灌浇根本甲芽伸。","滋养气精神。","恬淡好，甘露味投真。","滴滴润开三教理，涓涓传透四时春。","流转一清新。"],0,"x263","元"],["望蓬莱","王哲","杂言",["猿马住，性命自然知。","一粒刀圭开四象，两般枪法杀三尸。","神水溉华池。","公看取，便是坎和离。","土马赶回金虎子，铁牛耕出玉龙儿。","方见遇明师。"],0,"x263","元"],["望蓬莱","王哲","杂言",["未入道，休要执中迷。","先且牢擒劣马子，切须缚住耍猿儿。","款款做修持。","如省悟，勘破女男妻。","自在假身常锻炼，逍遥真性得推移。","应是上瑶池。"],0,"x263","元"],["望蓬莱","王哲","杂言",["真大药，要见甚昭然。","二气包囊三叠妙，双关封锁九重玄。","自晓岂相传。","古仙颂，两句最精研。","凡骨渡河诚用筏，圣功到岸不须船。","越越害风颠。"],0,"x263","元"],["望蓬莱","王哲","杂言",["词意悟，就上好修修。","意马心猿都捉住，攀缘爱念一齐休。","善事莫迟留。","三教好，妙理最深幽。","摆脱浮生并世事，这回前路赴蓬洲。","此个是归头。"],0,"x263","元"],["望蓬莱","王哲","杂言",["逢九变，逢九变，须用宝刀裁。","阴魄莫随魔鬼转，阳魂合赶好梨来。","今已免轮回。","公听取，公听取，道眼正堪开。","四假身躯宜锻炼，一灵真性细详猜。","有分看蓬莱。"],0,"x263","元"],["望蓬莱","王哲","杂言",["醴泉好，风物雅幽幽。","须把恶缘如省悟，宜将善事争持修。","闹里莫投头。","予省也，遂把内丹收。","对景摅情横写字，有时归去倒骑牛。","道号号无忧。"],0,"x263","元"],["望蓬莱","王哲","杂言",["真大道，滋味不相饶。","明月光中腾莹莹，清风飙上出么么。","从此见芝苗。","无狭阔，又岂有迢辽。","圆现圆成成自在，一能一得得逍遥。","方显见彰昭。"],0,"x263","元"],["望蓬莱","王哲","杂言",["真锻炼，驱惑去迷昏。","踏碎月明通正路，劈开风景入玄门。","方显道家尊。","无把捉，一点出昆仑。","复住空中超造化。","得归物外越乾坤。","那论若亡存。"],0,"x263","元"],["望蓬莱","王哲","杂言",["能下手，便晓这元元。","为甚得通三一法，都缘悟彻五千言。","立起本根源。","重著脚，跳入水晶盘。","唤出那人人不识，至今有自自扬掀。","越越害风虔。"],0,"x263","元"],["望蓬莱","王哲","杂言",["重阳子，物物不追求。","云水闲游真得得，茅庵烧了事休休。","别有好归头。","存基址，决有后人修。","便做玲珑真决烈，怎生学得我风流。","先已赴瀛洲。"],0,"x263","元"],["望蓬莱","王哲","杂言",["修炼者，四事倒颠论。","地水火风应化去，色声香味怎生存。","方是显良因。","全得得，窈默与冥昏。","慧性来回清净路，真灵出入妙玄门。","空外九光浑。"],0,"x263","元"],["望蓬莱","王哲","杂言",["修炼者，须要觅前程。","窈窈冥冥除我相，昏昏默默绝人情。","真里正中贞。","方晓悟，闲至净中清。","物物般般都打破，头头脚脚便分明。","圆曜自然成。"],0,"x263","元"],["望蓬莱","王哲","杂言",["真大道，能结坎和离。","认取五行不到处，须知父母未生时。","此理勿难知。","须速省，下手便修持。","上有三光常照耀，中包二秉气莫分离。","采得玉灵芝。"],0,"x263","元"],["望蓬莱","王哲","杂言",["词谨劝，见在好持修。","浮名浮利何日了，劳神劳气几时休。","尘世莫淹留。","须早悟，三教理玄幽。","摆脱恩山祛爱海，得归蓬岛赴瀛洲。","只在此心头。"],0,"x263","元"],["望蓬莱","王哲","杂言",["听我劝，公莫谩风流。","猿马不闲空践野，光阴虚过度春秋。","怎得免荒丘。","如省悟，急急把心收。","对景直须抛妄想，于身若是少贪求。","何用道人头。"],0,"x263","元"],["望蓬莱 纸旗上书","王哲","杂言",["边境静，乞觅得便宜。","战鼓复为韶乐鼓，征旗还作化缘旗。","便见太平时。","那减舍，第一莫迟迟。","王哲害风无忧子，当三折二小钱儿。","伏愿认真慈。"],0,"x263","元"],["望蓬莱 咏劝道友","王哲","杂言",["赵公好，伟貌正青春。","莫把光阴虚度却，愿将功行宝相亲。","与我作比邻。","清闲在，认得出迷津。","稍悟浮生除爱念，如知幻化绝贪嗔。","便是洞中人。"],0,"x263","元"],["望蓬莱 咏馎饦","王哲","杂言",["食店好，馎饦最奇瑰。","玉屑无穷抟作块，琼瑶一片细匀开。","须使宝刀裁。","呈妙手，用意稳安排。","碗内梨花新贴样，箸头银线稳挑来。","餐了趁蓬莱。"],0,"x263","元"],["望蓬莱 题杏花","王哲","杂言",["春景好，艳杏吐红腮。","笑日仙姿真美丽，倚风嫩脸最奇瑰。","不羡腊前梅。","人岂识，唯许对予开。","折得一枝应在手。","馨香满袖任还回。","携汝到蓬莱。"],0,"x263","元"],["望蓬莱 醴泉觅钱","王哲","杂言",["醴泉好，偏爱养贫儿。","为破殚虚华□业，余从捉住傻猿儿。","无女又无儿。","街两面，愿助小钱儿。","同共买成金麦饭，三时喂饱铁牛儿。","耕种老婴儿。"],0,"x263","元"],["绿头鸭","王哲","杂言",["叹平生，景光奔走万遄。","得名牵。","休空劳攘，不须频苦孜煎。","这荣耀、趁时显现，似风烛终勿牢坚。","走玉常催，飞金每促，更兼愁恼紧缠绵。","睹浮世、推来暂处，四序换流年。","齐捐舍、争如善根，结取良缘。","慧刀开、劈回猛烈，智锋举、刺转英贤。","自家声、能调雅趣，旧奇韵、堪应斯弦。","认取元初，搜寻本有，幽微密妙总投玄。","得归一、长春景致，还也任如然。","无来去、蓬莱岛中，做个神仙。"],0,"x263","元"],["菊花天","王哲","杂言",["此药神功别有欢。","专医生命完全。","名唤紫金丹。","服之一粒，永保康安。","宝结三田搬运过，明珠透出泥丸。","五彩九霞光共，并攒并攒。","捧入仙坛。"],0,"x263","元"],["菊花天","王哲","杂言",["又是春来虚不空。","今朝斗撮和风。","使我得飘蓬。","前游云水，大路长通。","虽是心慵身莫懒，但予好药名芎。","服了身轻体健，积功积功。","须上穹窿。"],0,"x263","元"],["菊花天","王哲","杂言",["苦劝伊家省自煎。","须知每每居廛。","赢取日高眠。","卖花天气，别有玄玄。","这个元来滋味好，自然灭火消烟。","要入无生路上，赵仙赵仙。","只在心田。"],0,"x263","元"],["菊花天","王哲","杂言",["肉衒花糕酒衒油。","肥躯润已那休。","儿女共嬉游。","金银财宝，垒似山丘。","何不道前程将不去，限终鬼使来勾。","方悟平生总错，点头点头。","悔恨无由。"],0,"x263","元"],["菊花天 风","王哲","杂言",["此药神功别有华。","专医遍体顽麻。","下事是三家。","不拘漫酒，选甚盐茶。","服了便令筋骨换，亦教结就丹砂。","顿觉神清气爽。","最嘉最嘉。","步步云霞。"],0,"x263","元"],["菊花天 食","王哲","杂言",["此药神功别有方。","专医五脏膏肓。","一服下随汤。","即时传透，便得安康。","更便真玄推妙诀，诸公子细消详。","养气全神保固。","寿长寿长。","永处清凉。"],0,"x263","元"],["菊花天 眼","王哲","杂言",["此药神功别有名。","专医两目多情。","一点变澄清。","自然仰面，认得前程。","更用金篦轻掠刮，便教换了尘睛。","观俗缘空朗照，至精至精。","三辉腾明。"],0,"x263","元"],["菊花天 嗽","王哲","杂言",["此药神功别有情。","专医肺里讴吟。","治正水中金。","教公免了，分外声音。","伤重寒风并热冷，五般无复重侵。","节色减财摄养，古今古今。","性命来寻。"],0,"x263","元"],["雪梅春","王哲","杂言",["睹尘世，人人尽总斗芳容。","衒珠珍金玉，绫罗锦乡情悰。","儿女妻孥共团聚，管弦歌舞趁时从。","没休歇，昨夜今宵，来晚重重。","颙颙□□。","日常做，怎得回头省悟，深洒直待阴公。","取来恁则方忡。","千状悲颜钉心剑，百端愁思敛眉峰。","见追贴，慈番悔恨，难已藏踪。"],0,"x263","元"],["黄鹤洞中仙","王哲","杂言",["一匹好骅骝，精彩浑如画。","却被银鞍缚了身，著绊马。","怎得逍遥也。","不若骋颠狂，掣断缰无挂。","摆尾摇头厩枥违，做野马。","自在成游冶。"],0,"x263","元"],["黄鹤洞中仙","王哲","杂言",["修炼不烦忙，自有人来遇。","已与白云作伴俦，常作词和赋。","净里转恬然，欢喜回光觑。","一个青童立面前，捧出长生簿。"],0,"x263","元"],["黄鹤洞中仙","王哲","杂言",["此个真真也。","莹彻灵台也。","出入虚无缥缈间，骑风马。","信任飘飘也。","占得惺惺也。","光耀明明也。","来往晴空碧落中，乘云马。","自在逍遥也。"],0,"x263","元"],["黄鹤洞中仙","王哲","杂言",["夜宿山村店。","不觉频嗟叹。","独自寻思告他谁，只闻得那马，耳畔频嘶喊。","国泰兵戈偃。","顷亩农夫羡。","不动枪旗动酒旗，你不放他那马，两国无征战。"],0,"x263","元"],["黄鹤洞中仙","王哲","杂言",["你待坚心走。","我待坚心守。","栗子甘甜美芋头，翁母同张口。","开取四时花，绽取三春柳。","一性昭然全得他，玉液琼浆酒。"],0,"x263","元"],["黄鹤洞中仙","王哲","杂言",["信任水云游，忺放灵猿耍。","要去随霞恣害风，乘良马，稳坐香罗帕。","南北与东西，选甚高和下。","处处来回得自如，呈弓马。","会把明珠射。"],0,"x263","元"],["黄鹤洞中仙","王哲","杂言",["暗里修持做，不合名张露。","却使人人转敬钦，所以难停住。","谨对扶风诉。","结伴关西去。","卓个庵儿累行功，同步烟霞路。"],0,"x263","元"],["黄鹤洞中仙","王哲","杂言",["卜算词频话。","莫放猿儿耍。","疾速先须调姹婴，全道马，好把家缘舍。","一个真惺洒。","云路堪同跨。","自在逍遥永厮随，害风马，管取玲珑也。"],0,"x263","元"],["黄鹤洞中仙","王哲","杂言",["初见青钢剑。","尸内曾加点。","木上安来出一丝，干马占。","害后随风飐。","得此修行渐。","日日频频检。","暗喜欢时只自知，天马瞻。","与我长生验。"],0,"x263","元"],["黄鹤洞中仙 咏瓦罐","王哲","杂言",["瓦罐泥中宝。","巧匠功成造。","修炼之时向炉中，内有金光照。","有耳何曾晓。","有口何曾道。","携向街前叫一声，莫教抛撒了。"],0,"x263","元"],["黄鹤洞中仙 俗卜算子","王哲","杂言",["卜算词中算。","卦象分爻彖。","海岛专寻知友来，堪把扶风唤。","莫怪频磨难。","只要公明灿。","决定坚心没恼愁，永结长生伴。"],0,"x263","元"],["黄鹤洞中仙 俗喝马卜算子","王哲","杂言",["正被离家远。","衰草寒烟染。","水隔孤村两三家，你不牵上他马，独立沙汀岸。","叫得船离岸。","举棹波如练。","渔叟停船问行人，你不牵他上马，月照江心晚。"],0,"x263","元"],["黄鹤洞中仙 前后各喝马一声","王哲","杂言",["赶退日中乌，捉取月中兔。","便著晶光覆了身，金马住。","方是重阳做。","交位显真功，换质成真趣。","到此还知自在游，玉马去。","走入云霞路。"],0,"x263","元"],["黄鹤洞中仙 藏头","王哲","杂言",["算词中话。","上甘津洒。","养灵烟火养莲，意马。","院俱齐舍。","内丹无价。","在山边挂。","有屯蒙玉线缝，野马。","月同安下。"],0,"x263","元"],["黄鹤洞中仙 藏头","王哲","杂言",["兆看余灯，炼阳周镜。","照他人，返逼驱儿省。","下清中莹。","艳出银釭面。","菱花静。","似韬光不骋驰。","儿惺内观真景。"],0,"x263","元"],["登仙门","王哲","杂言",["归也归也。","本元归也。","两人没观瞻也。","被清风白云，全日常招也。","王害风此翻去也。","劝诸公、寻玄妙，更休思也。","看假躯、不如无也。","到今方超彼岸，我咱知也。","要重见这回难也。"],0,"x263","元"],["超彼岸","王哲","杂言",["凡躯莫藉。","把惺惺了了，自然明明构架。","行住坐卧，须要清清闲暇。","气神和，结成珠，堪教化。","张弓举箭能亲射。","红心正中，赶退周天卦。","垛贴中间，迸出霞光无价。","五行违，脱阴阳，超造化。"],0,"x263","元"],["遇仙亭","王哲","杂言",["急急回头。","得得因由。","物物更不追求。","见见分明把个，般般打破优游。","净净自然莹彻，清清至是真修。","妙妙中间通出入，玄玄里面细寻搜。","了了达冥幽。","稳稳拈银棹，惺惺驾、般若神舟。","速速去超彼岸，灵灵现住瀛洲。"],0,"x263","元"],["集贤宾","王哲","杂言",["仔细曾穷究。","想六地众生，强揽闲愁。","恰才得食饱，又思量、骏马轻裘。","有骏马，有轻裘。","又思量、建节封侯。","假若金银过北斗。","置下万顷良田，盖起百尺高楼。","儿孙自有儿孙福，莫与儿孙作马牛。","贪利禄。","竞虚名，惹机勾。","岂知身似、水上浮沤。","贪恋气财并酒色，不肯上、钓鱼舟。","荒尽丹田三顷，荆棘多稠。","宝藏库、偷盗了明珠，铁灯盏、渗漏了清油。","水银迸散难再收。","大丹砂甚日成就。","杀曾叮咛劝，劝著后，几曾偢。","苦海深，波浪流。","心闲无事却垂钩。","呜呼锦鳞终不省，摇头摆尾，姿纵来来，往戏波流。","愚迷子，省贪求。","只为针头上名利。","等闲白了少年头。"],0,"x263","元"]]