[null,null,null,null,null,null,null,null,null,["美人词 浣溪沙 美人","徐石麒","七言长篇",["酒渍胭脂共染唇。","盈盈一笑递香温。","绿篝光里拣情人。","胸帛交成花玉彩，腕阑简得柳金纹。","向来心事为谁春。","得意春来分外姿。","玉蝉娇趁海棠丝。","翠勾红引步迟迟。","好语暗猜风软款，韶颜争认柳参差。","养花天里试相思。","锦瑟红牙玉柱筝。","抱瓶花近美人行。","一杯春酒送娉婷。","笑指粉腮辞薄醉，暗挑丝鬓转柔情。","怨红愁绿一声声。","酒在尊中潋滟波。","泥人好句近人歌。","且推檀板捧金罗。","玉手斟时休道满，金莲约处不曾多。","此宵无醉奈情何。"],0,200,"清"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["谩兴 除夜","虞堪","七言长篇",["出门无路达天衢，谩拥寒衾咄咄书。","岁月又随更漏尽，半生孤愤不能除。","帝所新正尽早朝，万方无乃寸心劳。","野人空老江湖表，梦绕钧天日已高。","草堂人日倚吟筇，日出阴消见远峰。","但愿八荒春盎盎，尽无争斗即为农。","鳌山月在沧江冷，蛟室潮生贝阙寒。","闲却锦囊双凤琯，玉人何许夜漫漫。"],0,222,"明"]]