[["菩萨蛮 对雪忆亡女","沈宜修","词",["疏梅香吐西阑曲。","娟娟一片潇湘绿。","白雪绕庭飞。","彤云接树低。","谢娘何处去。","辜负因风句。","莫把旧诗看。","空怜花正寒。"],0,150,"明"],["忆秦娥 春雨","沈宜修","词",["风萧萧。","露桃井上嫣红飘。","嫣红飘。","清明近也，细雨连朝。","柳丝笼雨摇纤腰。","画帘飞燕愁春宵。","愁春宵。","淡烟草叶，薄霭花梢。"],0,150,"明"],["清平乐 代人闺怨","沈宜修","词",["王孙何处。","草遍羞回顾。","啼鸟帘笼吹日暮。","依旧春风空度。","泪流滴尽鲛绡。","月明吹断琼箫。","愁看楼前杨柳，倚栏独自魂消。"],0,150,"明"],["清平乐","沈宜修","词",["柔情如结。","著意凭谁说。","春去风翻帘外铁。","几度天涯明月。","无端故故思量。","绿窗梦远潇湘。","啼鸟不知人恨，数声唤落斜阳。"],0,150,"明"],["三字令 春暮","沈宜修","词",["花落尽，柳阴低。","雨丝飞。","香雾湿，彩云迷。","带愁飞，飞去也，武陵西。","新梦短，漏依依。","剩相思。","残月冷，晓烟凄。","蝶香浓，莺语碎，断肠时。"],0,150,"明"],["南乡子 晓起感怀","沈宜修","词",["细雨寂疏栊。","绣帐熏篝翠影重。","娇鸟数声香梦杳，芳红。","一片烟丝弄晓风。","小蕊长茸茸。","嫩柳轻桃染渐浓。","又是春愁萦不了，忡忡。","减尽容华玉镜中。"],0,150,"明"],["虞美人 闰 六月初七","沈宜修","词",["年年新月钩帘小。","鹊语星桥早。","鸳鸯楼上罢流黄。","正是香生碧簟、夜来凉。","今宵空惹回肠切。","数尽萤明灭。","双娥蹙泪湿娇愁。","拚取恨随槎影、再悠悠。"],0,150,"明"],["踏莎行 夜月感旧","沈宜修","词",["叶露浮青，草烟凝碧。","月明一片伤心色。","无端花影落西墙，看看移伴回廊寂。","往事堪嗟，闲愁重觅。","阑珊竹纸行行墨。","子规枝上自声声，可怜尽被风吹入。"],0,150,"明"],["蝶恋花 偶感","沈宜修","词",["昨夜月明花溅泪。","落尽寒英，心绪浑如醉。","风里烟丝将染翠。","纱窗晓鸟啼声碎。","蓦地愁来何处避。","百转思量，掉下全无计。","更被萋萋芳草𣨼。","悠悠长自相萦系。"],0,150,"明"],["江城子","沈宜修","词",["西风自古不禁愁。","奈穷秋。","思悠悠。","何似长江，滚滚只东流。","霁景萧疏催晚色，新月影，挂帘钩。","芙蓉寂寞水痕收。","淡烟浮。","冷芳洲。","断霭残云，犹自倚重楼。","纵有茱萸堪插鬓，须不是，少年头。"],0,150,"明"],["满庭芳 端午","沈宜修","词",["团扇裁冰，宫盘射粉，画帘不上银钩。","绣符艾虎，双绕玉搔头。","皓腕轻笼彩缕，蒲英泛、蚁绿金瓯。","雕栏外，桐花低映，红袖赏扶留。","香浮。","风淡淡、回廊转午，人倚重楼。","问当年菰黍，谁为飘流。","杨柳斜阳归晚，人去后、曲散梁州。","空馀下，暮云凄霭，长绕楚江秋。"],0,150,"明"],["满庭芳 七夕","沈宜修","词",["玉树香浮，金波彩泛，细风轻送云行。","桥边乌鹊，千古说多情。","何事欢娱易散，空怊怅、玉镜银屏。","堪怜处，年年芳草，青黛锁秋横。","盈盈。","增怅望、更更漏点，处处鸡声。","看疏星渐晓，珠露飞英。","肠断鲛绡帕上，休回首、枉自魂惊。","还须问，长河渺渺，流向几时平。"],0,150,"明"],["凤凰台上忆吹箫 代人恨别","沈宜修","词",["好事多磨，重云掩月，晓风惊梦难留。","又一番春色，恼乱枝头。","湘浦佩沉波冷，花影里、枉自凝眸。","添怊怅，燕来鸿去，锁尽闲愁。","休休。","楚台已远，生惹得情深，何处忘忧。","叹幽怀几许，总付东流。","那更栏前芳草，萦人思、恨满银钩。","空回首，从今风雨，两地悠悠。"],0,150,"明"],["声声慢 效旧人作韵用八声字","沈宜修","词",["春光难问，烟草忘情，凭将彩管新声。","宫额初消，雕梁紫燕声声。","湘帘半掩影碧，画阑干、几树鹃声。","杏花下，把琼箫低按，试学秦声。","绮陌香车竞艳，听清歌缓缓，是处春声。","小院人闲，飞花悄悄无声。","松风忽来绣户，韵生凉、吹作涛声。","更有那，杨柳外、莺语数声。"],0,150,"明"],["金菊对芙蓉 暮秋","沈宜修","词",["凉雨人清，悄寒夜静，片霞天际斜飞。","看青烟萦树，白月侵衣。","松梢露催残叶，碧苔上、花影参差。","雁应来早，怨虫喧砌，绣幕低垂。","自念独锁愁眉。","渐画栏影转，斗柄初迟。","又重阳去远，菊冷东篱。","芙蓉寂寞澄江晚，问姮嫦、乍耐凄其。","秋光又老，难留好景，莫负良时。"],0,150,"明"],["念奴娇 闺情","沈宜修","词",["莺啼燕语，正芳菲时候，红娇翠小。","日日东风吹细柳，缕缕似人烦恼。","径近花香，栏遮蝶梦，掩尽重门老。","清明近也，隔帘愁遍芳草。","枝上杜宇声残，纱窗向晚，天碧横空杳。","悄悄姮娥来伴我，沉水琼绡青鸟。","绣带垂裙，金钗坠枕，脉脉馀情绕。","起来惟有，画檐风马敲晓。"],0,150,"明"],["百字令 重五悼亡兼感怀","沈宜修","词",["伤心时候，又端阳景色，依然满目。","暗柳藏莺千百啭，声绕画帘风竹。","旧恨吟花，新愁泣梦，细雨凝蒲绿。","泪残芳草，断魂何处难续。","休说箫鼓年年，龙舟竞渡，玉盌倾醽醁。","今古兴衰多少事，不尽沅湘万曲。","明月山空，青松露寂，烟水飞云骛。","落霞影里，乍如数椽茅屋。"],0,150,"明"],["忆旧游 感怀思倩倩表妹","沈宜修","词",["叹无边景色，绿遍垂杨，红褪蔷薇。","寂寂湘帘晚，是东风过尽，燕子还飞。","画栏几曲慵倚，清露半烟肥。","怅旧恨惊心，闲愁蹙黛，带减罗衣。","云迷。","望何处，有宝镜银奁，筝雁依依。","想杏花梢下，把红桃玉笛，风月初吹。","故人别后深怨，螺冷绛仙眉。","更粉蝶双翻，阶前懒自纤履移。"],0,150,"明"],["霜叶飞 题君善祝发图","沈宜修","词",["闷怀难表。","西风弄、愁人踪迹颠倒。","笑拚华发付凄凉，露泣芙蓉老。","梦破柳烟胡蝶晓。","沈吟掷镜寒云扫。","世事总休休，但倩取、幽窗月影，夜半留照。","憔悴，动处非狂，愁时非醉，画里人应知道。","绕崖黄叶正纷纷，好共哀猿啸。","落蕊楚江君莫恼。","芳洲处处悲秋草。","自有闲云飞伴，松月山空，桂丛烟渺。"],0,150,"明"],["乌夜啼","沈宜修","词",["雨过暮蝉轻噪，天开远骛低飞。","清光原似当年好，人事古今非。","燕子尚留春恨，莲房又落秋衣。","斜阳休问愁多少，遮莫尽鸥矶。"],0,150,"明"],["乌夜啼","沈宜修","词",["天外云笼馀碧，窗前砌积残黄。","秋声弄出秋无数，总是一凄凉。","好月欲邀谁看，乱风吹向人忙。","江天黯淡催萧瑟，飞雁又河梁。"],0,150,"明"],["忆王孙","沈宜修","词",["芳笺题罢困红绡。","小梦无端过断桥。","月影江声送去潮。","漫魂劳。","帘外轻风到柳条。"],0,150,"明"],["忆王孙","沈宜修","词",["梨花梦转杏花寒。","碧叶琅玕玉佩珊。","零落春花恨远山。","倚阑看。","又见烟笼日半竿。"],0,150,"明"],["忆王孙","沈宜修","词",["银灯花谢酒初醒。","梦去愁来月半明。","玉漏沉沉夜色清。","翠生生。","芳草能消几许情。"],0,150,"明"],["忆王孙","沈宜修","词",["翩翻蝶粉落梅梢。","金井鸟啼隔绛绡。","春树迷津归路遥。","暗香消。","长把闲情逐水飘。"],0,150,"明"],["忆王孙","沈宜修","词",["芳菲谁向梦中怜。","杨柳长亭几处烟。","云断霞飞独黯然。","浪书传。","细草空连落日边。"],0,150,"明"],["忆王孙","沈宜修","词",["锦川珠浦忆仙游。","花落横江逐梦浮。","梦觉纱窗月半钩。","影悠悠。","依旧王孙桂树留。"],0,150,"明"],["如梦令 元夕感怀","沈宜修","词",["人静夜寒如昨。","两度春风萧索。","疏影月朦胧，依约半庭秋箨。","垂幕，垂幕。","窗外哪知梅落。"],0,150,"明"],["如梦令 夜月","沈宜修","词",["月晕天边常有。","心绪浑如中酒。","酒醒是何时，楼外乌啼杨柳。","依旧，依旧。","赢得梅花消瘦。"],0,150,"明"],["如梦令 秋暮","沈宜修","词",["平野遥连湘渚。","暮色凉生碧树。","待望月华明，愁听闲宵风雨。","无绪，无绪。","最是寒烟数缕。"],0,150,"明"],["如梦令 寒夕","沈宜修","词",["风月天边长美。","佳兴如之何矣。","萧瑟满疏林，惯与愁怀相倚。","何似，何似。","枫落年年流水。"],0,150,"明"],["长相思","沈宜修","词",["路漫漫，恨漫漫。","竹叶撩风送响繁。","凄清满画栏。","夜将阑，漏声残。","看尽馀灯伴晓寒。","愁怀欲遣难。"],0,150,"明"],["点绛唇 代人写恨","沈宜修","词",["满日秋光，厌听反舌啼声■。","泪流多少。","回望巫山杳。","几度思量，落得空烦恼。","须知道。","断肠难告。","总付平波渺。"],0,150,"明"],["点绛唇","沈宜修","词",["往事堪悲，断魂最是风光好。","又弹别调。","再续应休了。","待欲抛开，忍见双欢笑。","清灯悄。","黄花愁老。","恨逐西风晓。"],0,150,"明"],["浣溪沙","沈宜修","词",["飞絮江干雨乍晴。","风前密叶缀红英。","落霞偏映夕阳明。","不为春愁慵簇蝶，自多闲闷恼啼莺。","断肠魂梦两无凭。"],0,150,"明"],["浣溪沙","沈宜修","词",["槛外游丝树树穿。","断肠柳色最连天。","春分偏为闷婵娟。","细雨自留金钿梦，野花偏衬玉骢烟。","暮霞飞尽月明边。"],0,150,"明"],["水龙吟 冶城感旧","沈宜修","词",["西风昨夜吹来，闲愁唤起依然旧。","苔钱绣涩，蓉姿粉淡，悴丝摇柳。","烟褪馀香，露流初引，一番还又。","想秦淮故迹，六朝遗恨，江山不堪回首。","莫问当年秋色，琐窗长自帘垂绣。","淹留岁月，消残今古，落花波皱。","客梦初回，钟声半曙，雁飞归候。","便追寻、锦字春绡，多何与寒笳奏。"],0,150,"明"],["水龙吟","沈宜修","词",["砧声敲动千门，渡头斜日疏烟逗。","莲歌又罢，萸房将采，愁凝翠岫。","巫峡波平，蘅皋木脱，粉云凉透。","叹无端心绪，台城柳色，难禁许多消瘦。","古道长安漫说，小庭闲尽应怜否。","红绡雨细，碧栏天杳，三更银漏。","塞雁无书，清灯空蕊，但馀绿酒。","想当年、白傅青衫，还倩泪留双袖。"],0,150,"明"],["浣溪沙","沈宜修","词",["春思萦人引线添。","井梧初叶露馀沾。","荼蘼开到雨廉纤。","午枕梦听新乳燕，花筛日转旧垂帘。","无情风絮碧苔黏。"],0,150,"明"],["浣溪沙","沈宜修","词",["细雨浮烟隔绛纱。","银床寂寞锁寒花。","可堪秋思正无涯。","半渚西风催怨叶，一天落日送归笳。","奈教闲闷暮云赊。"],0,150,"明"],["浣溪沙","沈宜修","词",["桂蕊侵香树影斜。","平芜远映画阑遮。","洞庭秋望几人家。","蛩露湿残山夜月，雁风飞落暮天霞。","自怜妆镜减容华。"],0,150,"明"],["浣溪沙 闺情","沈宜修","词",["泛水浮红自在流。","风前花落思悠悠。","堤边杨柳弄轻柔。","细雨淡烟芳树寂，轻香浅梦画屏幽。","寸肠禁得许多愁。"],0,150,"明"],["浣溪沙 秋闺","沈宜修","词",["新月桐帘影上钩。","露寒庭院一天秋。","金风飒飒夜悠悠。","砧杵带愁敲远梦，雁声衔恨落高楼。","碧云流断暮江幽。"],0,150,"明"],["浣溪沙 时往金陵，赠别张倩倩表妹","沈宜修","词",["枫叶无愁绿正肥。","多情空自绕鸥矶。","今宵千里断肠时。","一棹青山人正远，半床红豆雨初飞。","别离无奈思依依。"],0,150,"明"],["浣溪沙","沈宜修","词",["春满帘栊不耐愁。","蔚蓝衫子趁身柔。","楚台风月那禁留。","画扇半遮微赩面，薄鬟推掠只低头。","觑人偷自溜双眸。"],0,150,"明"],["浣溪沙 春日","沈宜修","词",["细雨庭皋湿翠苕。","深红浅碧缀良宵。","东风惹得燕嗔娇。","杨柳丝摇春不定，梨花粉褪月无聊。","年年空自锁春饶。"],0,150,"明"],["浣溪沙 和仲韶寄韵","沈宜修","词",["春事阑珊可怨嗟。","愁看柳絮逐风斜。","碧云天际正无涯。","莫问燕台曾落日，休怜吴地有飞花。","春风总不属侬家。"],0,150,"明"],["浣溪沙 秋夜","沈宜修","词",["露滴梧桐叶叶黄。","流莺时度小回廊。","画屏愁掩是潇湘。","何处碧笙吹断月，此时玉钿𦶟清香。","消魂时候漏初长。"],0,150,"明"],["浣溪沙","沈宜修","词",["帘外青灯几缕斜。","天边寒色逗明霞。","疏梅点点缀琼葩。","冻蕊自教秦管咽，飞花还向蜀丝赊。","画楼窗上只馀纱。"],0,150,"明"],["浣溪沙 秋思","沈宜修","词",["尽日轻阴锁画阑。","横陈锦瑟曲声残。","一庭秋色半阑珊。","览卷意慵添睡思，凭■花落惜春寒。","篆烟聊拨袅屏山。"],0,150,"明"],["浣溪沙","沈宜修","词",["细草侵阶映碧阑。","薄云天际鸟飞残。","晚风庭院叶珊珊。","自是多情何处问，枉教魂断不知寒。","几回搔首杳如山。"],0,150,"明"],["浣溪沙 偶成","沈宜修","词",["日午庭皋一叶飞。","世间莫问是和非。","且看征雁傍云低。","苔上浅痕随步缓，阑前闲影任花移。","不须重论古今时。"],0,150,"明"],["浣溪沙 寒夜有怀","沈宜修","词",["藓碧莎平草■陈。","画阑十二月初新。","寥寥疏景一庭匀。","露冷半天迷极望，云■几树映寒津。","紫箫声里隔行人。"],0,150,"明"],["浣溪沙 咏雪","沈宜修","词",["昨夜银屏透峭寒。","朝来庭霰绕阑干。","天涯遥忆漫相看。","千里不分鸾袖色，三湘欲断雁书难。","碎琼杂佩舞珊珊。"],0,150,"明"],["浣溪沙","沈宜修","词",["细剪瑶华屑作尘。","梅花长怨柳花春。","梁园词客赋交陈。","淅沥半添修竹韵，纷纭偏作绿苔茵。","琼枝玉树一时新。"],0,150,"明"],["浣溪沙","沈宜修","词",["古蔓柴扉寂寂村。","六花飞遍净无痕。","催残丝草滞王孙。","几度映窗慵展卷，回看积路好关门。","羁人应自独销魂。"],0,150,"明"],["浣溪沙","沈宜修","词",["万里龙沙一望平。","月明芦管作边声。","征人何处不关情。","织尽回文俱白锦，落残珠泪伴青灯。","断肠脉脉夜寒凝。"],0,150,"明"],["浣溪沙","沈宜修","词",["潇洒幽窗彻夜明，飘飖散影积闲庭。","谢庄衣上点盈盈。","唤女欲将呵手𫖃，呼儿捻取作茶烹。","松风飒飒满帘生。"],0,150,"明"],["浣溪沙","沈宜修","词",["洛渚翻霙陇树幽，素华飘落树枝头。","风随白羽傍檐浮。","竹叶樽清疑匣粉，梨花梦冷入香篝。","长亭此日最生愁。"],0,150,"明"],["浣溪沙 雪霁","沈宜修","词",["万树苍茫尽夕烟，庭梅半吐小窗前。","星河耿耿月初悬。","寒漏声中消蕙草，腊花影里润芸蝉。","此时良夜更堪怜。"],0,150,"明"],["菩萨蛮 春闺回文","沈宜修","词",["絮莺啼梦春光曙。","曙光春梦啼莺絮。","迟日下帘垂。","垂帘下日迟。","看花凭玉腕。","腕玉凭花看。","红袖暖香笼。","笼香暖袖红。"],0,150,"明"],["菩萨蛮","沈宜修","词",["鸟啼怜遍春庭草。","草庭春遍怜啼鸟。","丝柳乍烟霏。","霏烟乍柳丝。","竹窗摇影绿。","绿影摇窗竹。","帘逗月纤纤。","纤纤月逗帘。"],0,150,"明"],["菩萨蛮 送仲韶北上回文","沈宜修","词",["碧烟凄绕愁行客。","客行愁绕凄烟碧。","肠断隔山长。","长山隔断肠。","晓风凄月小。","小月凄风晓。","楼倚奈人愁。","愁人奈倚楼。"],0,150,"明"],["菩萨蛮","沈宜修","词",["柳疏垂映长亭酒。","酒亭长映垂疏柳。","人去促飞尘。","尘飞促去人。","雁征愁信远。","远信愁征雁。","弹泪染绡纨。","纨绡染泪弹。"],0,150,"明"],["菩萨蛮","沈宜修","词",["叶飞愁别惊寒怯。","怯寒惊别愁飞叶。","流水送行舟。","舟行送水流。","乱鸦归树晚。","晚树归鸦乱。","樽酒对销魂，魂销对酒樽。"],0,150,"明"],["菩萨蛮","沈宜修","词",["旧容销尽寒梅瘦。","瘦梅寒尽销容旧。","新恨别伤人。","人伤别恨新。","杏林春醉景。","景醉春林杏。","嘶马听归期，期归听马嘶。"],0,150,"明"],["菩萨蛮 重午","沈宜修","词",["薄罗皓腕笼香结。","诗题纨扇初裁雪。","日影下重楼。","波浮菰黍流。","黄鹂啼乍歇。","绿柳吹新月。","芳草遍天涯。","王孙归正赊。"],0,150,"明"],["菩萨蛮 赠张倩倩表妹","沈宜修","词",["雁行吹乱云边字。","青衫拭遍天涯泪。","樽酒话愁长。","相看各断肠。","此番人意热。","不似前时节。","留语待王孙。","应思一饭恩。"],0,150,"明"],["菩萨蛮 暮秋夜雨时在金陵","沈宜修","词",["闲庭滴沥秋宵雨。","纱窗灯影愁无语。","明月几时来。","芙蓉何处开。","小楼应寂寞。","一夜江枫落。","雁唳碧天长。","残更敲断肠。"],0,150,"明"],["菩萨蛮 秋思回文","沈宜修","词",["荇风摇碧帘遮影。","影遮帘碧摇风荇。","凉月照宵长。","长宵照月凉。","暮云飞寂露。","露寂飞云暮。","幽思伴香篝。","篝香伴思幽。"],0,150,"明"],["菩萨蛮","沈宜修","词",["燕惊归候悲纨扇。","扇纨悲候归惊燕。","蕉雨隔窗绡。","绡窗隔雨蕉。","豆含花似瘦。","瘦似花含豆。","肠断正更长。","长更正断肠。"],0,150,"明"],["菩萨蛮","沈宜修","词",["碧天连渚秋云夕。","夕云秋渚连天碧。","山远共江寒。","寒江共远山。","素裙飘薄雾。","雾薄飘裙素。","明月映波平。","平波映月明。"],0,150,"明"],["菩萨蛮","沈宜修","词",["白苹凄影悲秋客。","客秋悲影凄苹白。","鱼渚恨无书。","书无恨渚鱼。","玉肌凉夜独。","独夜凉肌玉。","银枕梦花兰。","兰花梦枕银。"],0,150,"明"],["菩萨蛮","沈宜修","词",["古今流水愁南浦。","浦南愁水流今古。","清浅棹人行。","行人棹浅清。","问谁凭去信。","信去凭谁问。","多恨怯裁歌。","歌裁怯恨多。"],0,150,"明"],["菩萨蛮","沈宜修","词",["小屏萝荫馀香袅。","袅香馀荫萝屏小。","衣袖半烟霏。","霏烟半袖衣。","日斜弹怨瑟。","瑟怨弹斜日。","低柳挂蝉嘶。","嘶蝉挂柳低。"],0,150,"明"],["菩萨蛮","沈宜修","词",["曲阑凭遍看漪绿。","绿漪看遍凭阑曲。","流水去时愁。","愁时去水流。","井桐疏叶冷。","冷叶疏桐井。","横笛晚舟轻。","轻舟晚笛横。"],0,150,"明"],["菩萨蛮","沈宜修","词",["钏金松冷澄江练。","练江澄冷松金钏。","唇点罢桃匀。","匀桃罢点唇。","绣帘窥月逗。","逗月窥帘绣。","情寄楚山清。","清山楚寄情。"],0,150,"明"],["菩萨蛮","沈宜修","词",["落红催雨平阴薄。","薄阴平雨催红落。","烟树霭长川。","川长霭树烟。","捣衣惊梦悄。","悄梦惊衣捣。","哀雁暮归来。","来归暮雁哀。"],0,150,"明"],["菩萨蛮 咏怀","沈宜修","词",["唾壶击破心灰折。","旧游回首西风冽。","疏柳一丝丝。","夕阳长自垂。","画帘闲夜月。","霜冷凝珂雪。","云去碧天秋。","花含无限愁。"],0,150,"明"],["菩萨蛮 元夕","沈宜修","词",["疏风弄影梅初放。","月圆春树笼烟飏。","细雾拂灯华。","琼卮落彩霞。","轻云飞送碧。","寒雪凝光白。","一管紫琼箫。","声声出画绡。"],0,150,"明"],["菩萨蛮","沈宜修","词",["红飘满路春风扑。","柳丝绕烟云连阁。","香袅篆霏浮。","帘移影月流。","更随尘暗去。","人散飞霞处。","春露滴花来。","寒枝一半开。"],0,150,"明"],["菩萨蛮 元夕后送别长女昭齐","沈宜修","词",["画屏开宴烧银烛。","一樽重按阳关曲。","小院罢灯红。","落梅吹断风。","帘前今夜月。","明晚伤离别。","到得看花时。","依然愁独知。"],0,150,"明"],["菩萨蛮 春思","沈宜修","词",["轻分骤别伤情黯。","惜花闷月香消减。","愁缓缕金裳。","纤罗透薄凉。","轻蛾颦浅黛。","山远■■叆。","天碧晚来晴。","啼鸦更几声。"],0,150,"明"],["菩萨蛮","沈宜修","词",["蒙蒙细雨丝红落。","乱莺啼树春愁恶。","风絮舞闲庭。","花寒锁昼清。","雕阑凭独遍。","飞入双双燕。","春色与归期，归迟春去迟。"],0,150,"明"],["菩萨蛮 仲春望前夜景","沈宜修","词",["琅玕戛翠敲寒玉。","参差弄影回廊曲。","月色净无尘。","花含一半春。","轻烟弄嫩柳。","梅落疏风候。","横碧挂星稀。","闲云寂不飞。"],0,150,"明"],["忆秦娥 春雪","沈宜修","词",["东风劣。","芳菲酿出花朝节。","花朝节。","夜来微雨，海棠啼颊。","午窗人寂喧翻蝶。","闲愁闲闷何时歇。","何时歇。","鹧鸪声断，梨花飘雪。"],0,150,"明"],["忆秦娥 寒夜不寐忆亡女","沈宜修","词",["西风冽。","竹声敲雨凄寒切。","凄寒切。","寸心百折，回肠千结。","瑶华早逗梨花雪。","疏香人远愁难说。","愁难说。","旧时欢笑，而今泪血。"],0,150,"明"],["更漏子 寄君晦","沈宜修","词",["旧愁新，新梦去。","长恨画帘莺语。","堤草软，野花轻。","随帆送棹行。","鸾镜掩，翠蛾敛。","襟袖空馀泪点。","生别恨，伴销魂。","风吹月照门。"],0,150,"明"],["清平乐 为侍女随春作似仲韶","沈宜修","词",["凌波微步。","已入陈王赋。","薄命谁怜愁似雾。","恼乱灯前无数。","樱桃红雨难禁。","梨花白雪空吟。","落得春风消瘦，断肠泪滴瑶琴。"],0,150,"明"],["清平乐","沈宜修","词",["杨花无力。","拂袖怜春色。","长爱娇嗔人不识。","水剪双眸欲滴。","春风宝帐多情。","襄王空惹云行。","恼得东君怊怅，夜寒脉脉愁盈。"],0,150,"明"],["清平乐 春暮","沈宜修","词",["东风弄晓。","绿柳堤边袅。","何事丝丝垂缭绕。","惹尽空闲烦恼。","落花舞絮盈盈。","难禁春色飘零。","日暮云天碧外，那堪百啭莺声。"],0,150,"明"],["乌夜啼 秋思","沈宜修","词",["一树微花竞艳，半廊萝荫含秋。","秋风未冷江莼老，清怨锁高楼。","梦断碧云易散，花飞明月空留。","映阶细草茸茸绿，无意寄人愁。"],0,150,"明"],["乌夜啼","沈宜修","词",["黛埽何如修桂，肠销浑似娇棠。","新愁遍染罗巾泪，凉月坠琼珰。","脉脉笼残斜日，微微薰罢馀香。","绣窗花落潇湘雨，憔悴立西廊。"],0,150,"明"],["乌夜啼","沈宜修","词",["枕上细虫悄悄，窗前暗竹萧萧。","残灯酒醒还■旧，何处觅魂遥。","杨柳今宵斜挂，芙蓉昨夜初潮。","愁城日日随人锁，空怨碧琼箫。"],0,150,"明"],["乌夜啼","沈宜修","词",["一片雨声淅沥，半窗灯影凄其。","雨丝滴碎灯花坠，往事不胜悲。","天际湿云憔悴，人前干梦依稀。","薄罗凉透西风夜，春泪作秋漪。"],0,150,"明"],["乌夜啼","沈宜修","词",["南浦依然柳色，西园犹剩莺声。","无聊独向阑干倚，徙倚送云行。","树影长留夕照，镜花不似春情。","断肠时候难重省，忽■暗愁生。"],0,150,"明"],["乌夜啼","沈宜修","词",["心碎芭蕉悴绿，情随菡萏飘红。","无端不是寻怊怅，几度自忡忡。","正遇悲凉初候，可堪憀栗西风。","强将樽酒排闲闷，愁晕楚江枫。"],0,150,"明"],["乌夜啼","沈宜修","词",["风动月光欲溜，天空云影长摇。","寻凉暂起湘帘卷，人共竹萧条。","曙景休追残梦，断魂莫问良宵。","羞将愁镜临愁鬓，无语伴无聊。"],0,150,"明"],["乌夜啼","沈宜修","词",["人事何如昔日，月明犹似当时。","韶华本是无情物，过去不堪思。","一瞬漫教重忆，半生忽自凄悲。","鹿蛸拂落还萦网，休问几千丝。"],0,150,"明"],["柳梢青 初夏","沈宜修","词",["绿暗薇屏。","红飘荇镜，春付浮萍。","束素寒消，薄罗香细，数尽归程。","新篁翠径初成。","微雨后、荷珠溅倾。","玉管声沉，桐花影外，一段闲情。"],0,150,"明"]]