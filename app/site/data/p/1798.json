[null,null,null,["句","王钦若","七言长篇",["忆念西山玉隆友。","春渍苔纹沿石塔，月含松韵杂琴声。","石城松柏锁烟霞。","九重天阙梦掉臂，黄鸡白酒邻舍恩。","须知尧历初厘正，玉烛初从献岁来。","龙带晚烟归洞府，雁拖秋色入衡阳。"],0,231,"宋"],null,null,null,null,null,["白云楼","程之才","七言长篇",["鬻熊城郭绕苍苔，万叠烟岚亦壮哉。","平地窥觎心未惬，重楼徙倚眼初开。","据襟风月争新入，刮目江山破迥来。","日落三峨知处所，云浮双阙欲崔嵬。","胡床不愧庾公兴，奕簟还思杜老才。","更待携衾尽清景，夜深栏槛逼昭回。"],0,217,"宋"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["句","邵伯温","七言长篇",["屈原宅畔蕙兰怨，神女祠边云雨愁。","阆苑南边第一州，江山胜绝对城楼。","老守自惭无善政，衰公不称作遨头。","白头老守无风味，不解寻春只杜门。","楼外江山无限好，二年能得几回看。","自昔充城号奥区，蜀人唤作小成都。","今日行人去果州，倾城出送旧遨头。","充城繁盛冠东川。","春去秋来好风月，鹤楼端胜庾公楼。","秀近亭边回首处，郡城高插水云间。","江上危亭名四水，山头禅刹占三嵎。","千载登真谢自然，半山遗迹号金泉。","南充到日黄柑熟，待摘霜包寄远情。","霜后秋香千树橘，雨馀春色一川花。"],0,137,"宋"],null,null,null,null,null,null,null,["题阎立本十八学士图","郑炳","七言长篇",["阎公十八学士图，当时妙笔分锱铢。","惜哉名姓不题别，但可以意推形模。","十二匹马一匹驴，五士无马应直庐。","五鞍施狨乃禁从，长孙房杜王魏徒。","一人醉起小史扶，一人欠伸若挽弧。","一人观鹅凭栏立，一人运笔无乃虞。","树下乐工鸣瑟竽，八士环列按四隅。","笑谈散漫若饮彻，盘盂杯勺一物无。","坐中题笔清而癯，似是率更闲论书。","其中一著道士服，又一道士倚枯株。","三人傍树各相语，一人系带行徐徐。","后有一人丰而胡，独吟芭蕉立踟蹰。","一时登瀛客若是，贞观治效真不诬。","书林我曾昔曳裾，三局腕脱几百儒。","雄文大笔亦何有，餐钱但日靡公厨。","邦家治乱一无补，正论出口遭非辜。","时危玉石一焚扫，览画思古为嗟吁。"],0,142,"宋"],null,null,null,null,null,["翠微山居诗","释冲邈","七言长篇",["山水煎茶拗柳枝，禅衣百结任风吹。","看经只在明窗下，得失荣枯总不知。","任运腾腾作老颠，何须论道复论禅。","莫将闲事来相扰，妨我长伸两脚眠。","闲来石上卧长松，百衲袈裟破又缝。","今日不愁明日饭，生涯只在钵盂中。","老来欲觅人间物，须向红尘问世人。","莫怪山僧无扫帚，都缘行处不生尘。","莫向人间定是非，是非定得有何为。","而今休去便休去，若欲了时无了时。","朝见花开满树红，暮观落叶又还空。","若将花比人间事，花与人间事一同。","百计千般只为身，不知身是冢中尘。","莫欺白发无言语，此是黄泉寄信人。","早灰百念卧灵山，世路无心绝往还。","僧相祇宜林下看，不堪行到画堂前。","一池荷叶衣无尽，数树松花食有馀。","却被世人知去处，更移茅舍作深居。","高山远望石碐碐，叠嶂回峦数十层。","时人只识云生处，不见松萝岩下僧。","辞君莫怪归山早，为忆松萝对月宫。","台殿不将金锁闭，来时自有白云封。","独摇金锡出樊笼，便踏孤云上碧峰。","莫怪脚穿脱尘履，且图行处不留踪。","三界无家谁最亲，十方惟有一空身。","但随云水伴明月，到处名山是主人。","茅檐静对千山月，竹户闲楼一片云。","莫送往来名利客，阶前踏破绿苔纹。","踏石窗山一老僧，白云为伴水为朋。","通宵只在洞中宿，月上青山便是灯。","人生在世急如风，昨夜今朝事不同。","不信但看桃李树，花开能得几时红。","僧家无事最幽闲，近对青松远对山。","诗句不曾题落叶，恐随流水到人间。","霜飞峭壁夜猿惊，手把松枝叫月明。","知有石龛僧入定，朝来不作断肠声。","任性随缘一比丘，一生无喜亦无忧。","白云纵听飞来去，但得青山在即休。","高高峰顶恣情田，买断清闲不用钱。","堪笑白云无定止，被他风送出山前。"],0,52,"宋"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["水月亭","马辅","七言长篇",["阳来中坤坎波翻，月本于地仍东还。","谁为聚之古祗柏，涵碧湛湛琉璃盘。","珊瑚晶瑛澈凝湍，西风晚来觉秋宽。","海荡冰碎天飞旋，瞿昙指心以探禅。","魄死泽困与尔言，夜游倚声霓裳欢。","捉影或堕不可援，幻痴益多吾懔然。","明河绕衣吹佩环，毛发飘萧乱空寒。","颇欲乘槎此穷源，脱屣浊世抟林骞。","采华食叶为玉仙。"],0,25,"宋"],null,null,null,null,null,null,null,["题河南王氏所藏子敬帖","黄伯思","七言长篇",["君家大令书盈纸，笔势翩翩趣多媚。","虽云沓拖如少年，岂至拘挛同饿隶。","会稽七子五知名，此公风概尤超诣。","太极琁题犹重书，一时凛凛标英气。","半袖精裓众争求，数幅新裙世犹贵。","当时亲遇得已难，况复传今仅千岁。","龙珠归浦剑还津，此帖君藏真得地。","才披尺许目增明，鸾跂鸿惊欲飞逝。","硬黄响拓若传吾，完璧摹刊愿垂世。"],0,61,"宋"],null,null,null,null,null,null,null,null,null,null,null,null,null,["仙迹岩题诗二十三首 三清殿","佚名","七言长篇",["虚无混沌未分前，大道元居太极先。","自一而三同祖气，澄清高上积阳天。","挺锋镇北阐威权，剪伐魔精正法宣。","化育黎民臻大道，安宁家国享长年。","辨道焚修练性根，应时粥饭益真元。","斋馀有报君恩重，寿祝无疆帝道尊。","参稽道德本无言，不二门开阐古先。","多谢师尊传演教，要令后学悟真诠。","高敞山斋立乳巅，飘飖云驭聚群仙。","百灵听讲开坛夜，大法将临报语宣。","幽栖枹朴古先精，宴坐参同元化并。","一炷清香腾瑞霭，云端时透步虚声。","精思名扁列金题，冲素斋居与道齐。","德感天仙来听论，芝𫐌时降共参稽。","游幸名山德寿存，鼎新大殿显仁恩。","玉圭物物皆珍异，安奉严恭玉帝尊。","众圣环拱位中天，统济乾坤妙转旋。","高覆昆仑朝帝阙，注生回死福增延。","湍激清泉舞翠蛟，幽亭跨涧对岩坳。","我来憩此观嘉趣，一洗尘襟凡世抛。","重楼高耸丹霄外，深夜声摩碧落中。","神通无量鸿音远，永镇名山有显功。","圣像迁祠出禁扃，天恩遣使从神灵。","奉安钦敬祈民福，应感昭彰佑帝庭。","巍然垂象隐精思，著述丹书与世违。","真得紫文无上道，业成遗迹是题诗。","宝阁庄严金玄耀，风铃震响玉丁东。","甍飞杰出青霄上，道典珍藏在此中。","一片轮囷迹严存，无心出岫瑞腾坤。","不随风雨轻舒卷，触石凝然正性根。","大涤之西一穷生，源高樵者只闻声。","汲泉烹茗多甘味，内隐丹砂赤更清。","琳宫门外小桥东，石罅泉流细脉通。","清似玉壶承沆瀣，游人掬饮凛生风。","秀钟天柱产灵芝，造就仙芽发嫩旗。","采向先春烟露里，喊山凤尾岂为奇。","鲮鳗环绕井楯间，两目神光状类丹。","杖扑投渊阴雾锁，殿堂汹涌尽波澜。","仙芝灵术总芳妍，野草闲花各变迁。","古栎复荣松化石，药苗蕃植可延年。","覆石为亭武肃成，有仙来此变棋枰。","炷香五色祥光现，缥缈灵官朝玉京。","闲亭清憩觉情优，四顾岚光景色幽。","湍玉飞帘侵座冷，璇源本自接天流。"],0,"x115","宋"],null,null,null,null,null,["三月十三日夜五更闻杜鹃时成父欲入浙因赋六章章四句以送之","赵蕃","四言",["不如归去，苍山茂树。","独胡为乎，空此号謼。","归去来兮，斯言可师。","我今已归，胡能不知。","不如归去，春且云莫。","山中之乐，岂同岐路。","归去来兮，言发动随。","古之逸民，舍陶而谁。","不如归去，载丁载宁。","劝子勿去，子宁我听。","不如归去，子宁肯住。","归去来兮，早歌式微。"],0,"x36","宋"],null,["山行见月作","赵蕃","四言",["有风肃然，落于树巅。","使我沈疴，不药而痊。","意行何之，陟此云岭。","如梦而觉，如昏而醒。","东坡老翁，有言莫酬。","凉天佳月，即为中秋。","恨我无酒，负尔一醉。","酌兹寒泉，兀尔忘睡。"],0,"x36","宋"],["跋姜君弼课册","苏轼","四言",["云兴天际，歘若车盖。","凝𪾦未瞬，弥漫霮䨴。","惊雷出火，乔木麋碎。","殷地𦶟空，万夫皆废。","霤绠四坠，日中见昧。","移晷而收，野无完块。"],0,"x67","宋"],null,null,null,null,null,["迁善斋铭","王庭珪","四言",["击石出火，鼓钟得声。","不鼓不击，寂无声形。","人之有善，物中最灵。","揉以学问，其识乃明。","跛鼈千里，六骥不行。","玉不加琢，器何由成。","吾观成叔，挺挺有立。","学有渊源，家声爀熠。","深山大泽，龙蛇蟠蛰。","实无所迁，假迁而入。","犹天之升，不落阶级。","参辰殊途，追莫能及。"],0,"x198","宋"],["为黄仲宣赋山中四章章四句","方回","四言",["山中之朝，有溪可瓢。","饮我之水，亦逍以遥。","山中之暮，岂不风雨。","心与一灯，耿耿千古。","山中之人，耘夫耕民。","鲭厥五侯，其如子真。","于疏于𫏋，朋来其学。","彼恶知兹，山中之乐。"],0,"x59","宋"],["绍兴朝日十首 其二 降神用《高安》。","郊庙朝会歌辞","四言",["升晖丽天，阳德之母。","率无颇偏，兼烛下土。","恭事崇坛，礼乐具举。","顿御六龙，裴回容与。"],0,"x207","宋"],["夕月十首 其四 降神用《高安》。","郊庙朝会歌辞","四言",["穆穆流辉，太阴之精。","盈亏靡忒，寒暑以均。","克禋克祀，揆日涓辰。","牲硕酒旨，来燕来宁。"],0,"x207","宋"],["夕月十首 其三 降神用《高安》。","郊庙朝会歌辞","四言",["溯日著明，丽天作配。","洁诚以祠，礼行肃拜。","光凝冕服，气肃环佩。","庶几昭格，祗而不懈。"],0,"x207","宋"],["夕月十首 其二 降神用《高安》。","郊庙朝会歌辞","四言",["时维秋仲，夜寂天清。","实严姊事，用答阴灵。","坛壝斯设，黍稷惟馨。","云车来下，庶歆厥诚。"],0,"x207","宋"],["夕月十首 其一 降神用《高安》。","郊庙朝会歌辞","四言",["金行告遒，玉律分秋。","礼蒇西郊，毖祀聿修。","精意潜达，永孚于休。","神之听之，爰格飙斿。"],0,"x207","宋"],["大观祀社稷九首 其四 迎神用《宁安》。","郊庙朝会歌辞","四言",["笾豆斯陈，三牲告幽。","报本之礼，答神之休。","来歆芬香，丰登于秋。","仓箱千万，治符成周。"],0,"x207","宋"],["大观祀社稷九首 其三 迎神用《宁安》。","郊庙朝会歌辞","四言",["猗欤那欤，生养斯民。","家给人足，时底熙纯。","祗严明禋，于荐苾芬。","粢盛丰洁，神乃有闻。"],0,"x207","宋"],["大观祀社稷九首 其二 迎神用《宁安》。","郊庙朝会歌辞","四言",["惟谷之神，函育无穷。","百嘉蕃殖，民依厥功。","严饬坛壝，威仪肃雍。","神之来享，祈于登丰。"],0,"x207","宋"],["大观祀社稷九首 其一 迎神用《宁安》。","郊庙朝会歌辞","四言",["惟土之尊，民食资焉。","阴祀昭格，牲牢腥膻。","有功于民，告其吉蠲。","神之来享，云车翩翩。"],0,"x207","宋"],["大晟府拟撰释奠十四首 其四 迎神用《凝安》。","郊庙朝会歌辞","四言",["圣王生知，阐乃儒规。","诗书文教，万世昭垂。","良日惟丁，灵承不爽。","揭此精虔，神其来飨。"],0,"x207","宋"],["大晟府拟撰释奠十四首 其三 迎神用《凝安》。","郊庙朝会歌辞","四言",["巍巍堂堂，其道如天。","清明之象，应物而然。","时维上丁，备物荐诚。","维新礼典，乐谐中声。"],0,"x207","宋"],["大晟府拟撰释奠十四首 其二 迎神用《凝安》。","郊庙朝会歌辞","四言",["生而知之，有教无私。","成均之祀，威仪孔时。","维兹初丁，洁我盛粢。","永适其道，万世之师。"],0,"x207","宋"],["大晟府拟撰释奠十四首 其一 迎神用《凝安》。","郊庙朝会歌辞","四言",["大哉宣圣，道德尊崇。","维持王化，斯民是宗。","典祀有常，精纯并隆。","神其来格，于昭盛容。"],0,"x207","宋"],["出火祀大辰十二首 其三 降神用《高安》。","郊庙朝会歌辞","四言",["火在六气，独处其两。","感生维君，繄辰克相。","何以验之，占兹垂象。","腾驾苍虬，歘其来飨。"],0,"x207","宋"],["出火祀大辰十二首 其二 降神用《高安》。","郊庙朝会歌辞","四言",["乐音上达，粤惟出虚。","火性炎上，亦生于无。","我镛我磬，我笙我竽。","气同声应，昭哉合符。"],0,"x207","宋"],["出火祀大辰十二首 其一 降神用《高安》。","郊庙朝会歌辞","四言",["烨烨我宋，火德所畀。","用火纪时，允惟象类。","神以类歆，诚繇类至。","有感斯通，孚我阳燧。"],0,"x207","宋"],["纳火祀大辰十二首 其四 降神用《高安》。","郊庙朝会歌辞","四言",["明明我后，重祭钦祠。","有司肃事，式荐晨仪。","礼惟其称，物惟其时。","神之听之，福禄来为。"],0,"x207","宋"],["纳火祀大辰十二首 其三 降神用《高安》。","郊庙朝会歌辞","四言",["季秋之月，律中无射。","农事备收，火功告毕。","克禋克祀，有严有翼。","风马云车，尚其来格。"],0,"x207","宋"],["纳火祀大辰十二首 其二 降神用《高安》。","郊庙朝会歌辞","四言",["火星之躔，有烨其光。","表于辰位，伏于戌方。","时和岁稔，仁显用藏。","告尔万民，出纳有常。"],0,"x207","宋"],["纳火祀大辰十二首 其一 降神用《高安》。","郊庙朝会歌辞","四言",["赫赫皇图，炎炎火德。","侈神之赐，奄有方国。","粢盛既丰，俎豆有𫗣。","于万斯年，报祀无斁。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其四 赤帝降神用《高安》。","郊庙朝会歌辞","四言",["烨烨其光，炳炳其灵。","窅其如容，歘其如声。","扇以景风，导以朱斿。","我德匪类，神其安留。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其三 赤帝降神用《高安》。","郊庙朝会歌辞","四言",["八卦相荡，一气散施。","隆炽恢台，职神尸之。","肃肃飙御，神戾于天。","于昭神休，天子万年。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其二 赤帝降神用《高安》。","郊庙朝会歌辞","四言",["赤精之君，位于朱明。","茂育万物，假然长嬴。","我洁我盛，我蠲我诚。","神其下来，云车是承。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其一 赤帝降神用《高安》。","郊庙朝会歌辞","四言",["离明御正，德协于火。","有感其生，维帝是何。","帝图炎炎，贻福锡我。","鉴于妥虔，高灵下堕。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其四 黑帝降神用《高安》。","郊庙朝会歌辞","四言",["天地闭塞，盛德在水。","黑精之君，降福羡祉。","洋洋在上，若或见之。","齐庄承祀，其敢斁思。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其三 黑帝降神用《高安》。","郊庙朝会歌辞","四言",["北方之神，执权司冬。","三时务农，于焉告功。","礼备乐作，归功于神。","风马来游，永锡斯民。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其二 黑帝降神用《高安》。","郊庙朝会歌辞","四言",["良月盈数，四气推迁。","帝于是时，典司其权。","高灵下堕，降祉幅员。","神之听之，祀事罔愆。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其一 黑帝降神用《高安》。","郊庙朝会歌辞","四言",["吉日壬癸，律中应钟。","国有故常，北郊迎冬。","乃蒇祀事，必祗必恭。","明默虽异，感而遂通。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其四 白帝降神用《高安》。","郊庙朝会歌辞","四言",["执矩斯兑，实惟素灵。","受职储休，万宝以成。","飨于西郊，奠玉陈牲。","侑以雅乐，来歆克诚。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其三 白帝降神用《高安》。","郊庙朝会歌辞","四言",["昊天之气，揫敛万汇。","涓日洁齐，有严厥祀。","有牲维肥，有酒维旨。","神之燕娭，锡兹福祉。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其二 白帝降神用《高安》。","郊庙朝会歌辞","四言",["素精肇节，金行固藏。","气冲炎伏，明河翻霜。","功收有年，礼荐有章。","祇越眇冥，鸿基永昌。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其一 白帝降神用《高安》。","郊庙朝会歌辞","四言",["白藏启序，庶汇向成。","有严禋祀，用答幽灵。","风马云车，来燕来宁。","洋洋在上，休福是承。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其四 黄帝降神用《高安》。","郊庙朝会歌辞","四言",["澹兮抚琴，啾兮吹笙。","神之未来，肃穆以听。","缤纷羽旄，姣服在中。","神既来止，亦无惰容。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其三 黄帝降神用《高安》。","郊庙朝会歌辞","四言",["乐哉帝居，逝留无常。","尔信我宅，尔中我乡。","乃眷兹土，于赫君王。","翩然下来，去未遽央。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其二 黄帝降神用《高安》。","郊庙朝会歌辞","四言",["荪无不在，日与我居。","孰不可来，肸蚃斯须。","象服龙驾，渊渊鼓桴。","荪不汝多，多汝意孚。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其一 黄帝降神用《高安》。","郊庙朝会歌辞","四言",["维帝奠位，乃咸于时。","孰主张是，而枢纽之。","谷我腹我，比予于儿。","告我冠服，迨其委蛇。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其四 青帝降神用《高安》。","郊庙朝会歌辞","四言",["温然仁矣，熙然春矣。","龙驾帝服，穆将临矣。","我酒清矣，我肴烝矣。","我乐备矣，我神顾矣。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其三 青帝降神用《高安》。","郊庙朝会歌辞","四言",["神在途矣，习习以风。","百灵后先，敢一不恭。","奔走疠疫，祓除菑凶。","顾瞻下方，逍遥从容。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其二 青帝降神用《高安》。","郊庙朝会歌辞","四言",["神兮焉居，神在震方。","仁以为宅，秉天之阳。","神之来矣，道修以阻。","望神未来，使我心苦。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其一 青帝降神用《高安》。","郊庙朝会歌辞","四言",["于神何司，而德于木。","肃然顾歆，则我斯福。","我祀孔时，我心载祗。","匪我之私，神来不来。"],0,"x207","宋"],["绍兴以后祀感生帝十六首 其四 降神用《大安》。","郊庙朝会歌辞","四言",["惟神之安，方解羽銮。","赤旗霞曳，从以炎官。","居歆嘉荐，肸蚃灵坛。","神之格矣，民讫多盘。"],0,"x207","宋"],["绍兴以后祀感生帝十六首 其三 降神用《大安》。","郊庙朝会歌辞","四言",["于物司火，于方峙南。","璇霄来下，羽卫毵毵。","祠官祝厘，联佩合簪。","本支有衍，则百斯男。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 其四 西方百神降神用《熙安》。","郊庙朝会歌辞","四言",["丰年穰穰，美芳职职。","笾豆方圆，其仪孔硕。","风马在御，云车载饬。","来顾来飨，维俟休德。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 其三 西方百神降神用《熙安》。","郊庙朝会歌辞","四言",["神罔小大，奠方兹土。","祭列坊庸，礼迨猫虎。","有功斯民，祀乃其所。","非稷馨香，厥福周溥。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 其二 西方百神降神用《熙安》。","郊庙朝会歌辞","四言",["魄生自西，照望太阳。","下暨诸神，贶施万方。","节适风雨，富我囷箱。","共承嘉祀，惟以迪尝。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 其一 西方百神降神用《熙安》。","郊庙朝会歌辞","四言",["玄冬肇祀，始于伊耆。","岁事聿成，庸答蕃厘。","眷言西顾，匪神司之。","归功尔神，翩其下来。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 其四 东方百神降神用《熙安》。","郊庙朝会歌辞","四言",["日昱乎昼，容光必照。","肸蚃之交，惟人所召。","有监在下，视兹升燎。","肃若其承，云骈星曜。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 其三 东方百神降神用《熙安》。","郊庙朝会歌辞","四言",["三时不害，四方顺成。","酬功报始，以我齐明。","豳颂土鼓，乐此嘉平。","降祥幅员，惠于函生。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 其二 东方百神降神用《熙安》。","郊庙朝会歌辞","四言",["惟大明尊，实首三辰。","功赫庶物，光被广轮。","岁方索飨，咸秩群神。","灵斿来下，尸此明禋。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 其一 东方百神降神用《熙安》。","郊庙朝会歌辞","四言",["玄冥凌厉，岁聿其周。","天地闭藏，农且息休。","古大蜡礼，伊耆肇修。","爰荐𫗣馨，以迓飙游。"],0,"x207","宋"],["绍兴祀九宫贵神十首 其四 降神用《景安》。","郊庙朝会歌辞","四言",["练时吉良，聿崇明祀。","粢盛洁丰，牲硕酒旨。","肃唱和声，来燕来止。","嘉承天休，赉及含齿。"],0,"x207","宋"],["绍兴祀九宫贵神十首 其三 降神用《景安》。","郊庙朝会歌辞","四言",["于赫九宫，天神之贵。","煌煌彪列，下土是莅。","幽赞高穹，阴骘万类。","肃若旧典，有严祗事。"],0,"x207","宋"],["绍兴祀九宫贵神十首 其二 降神用《景安》。","郊庙朝会歌辞","四言",["载阳衍德，农祥孔昭。","赉兹元嘏，穰穰黍苗。","象舆眇冥，金奏远姚。","无阏厥灵，丹衷匪恌。"],0,"x207","宋"],["绍兴祀九宫贵神十首 其一 降神用《景安》。","郊庙朝会歌辞","四言",["紫阙幽宏，惟神灵尊。","辅成泰元，赞役乃坤。","曰雨曰旸，缊豫调纷。","享荐陨光，蒙祉如屯。"],0,"x207","宋"],["绍兴祀大火十二首 其四 降神用《高安》。","郊庙朝会歌辞","四言",["于赫我宋，以火德王。","永永丕图，繄神之相。","神之来矣，维其时矣。","礼备乐奏，神其知矣。"],0,"x207","宋"],["绍兴祀大火十二首 其三 降神用《高安》。","郊庙朝会歌辞","四言",["小大率礼，不愆于仪。","展采错事，秩祀孔时。","维今之故，阅我数度。","修厥典常，神其来顾。"],0,"x207","宋"],["绍兴祀大火十二首 其二 降神用《高安》。","郊庙朝会歌辞","四言",["有出有藏，伏见靡常。","相我国家，鉴观四方。","视罔不正，终然允臧。","神其来格，明德馨香。"],0,"x207","宋"],["绍兴祀太社太稷十七首 其五 迎神用","郊庙朝会歌辞","四言",["国主社稷，时祀有常。","肃若旧典，报本不忘。","粢盛丰洁，歌吟青黄。","尊神倏来，百物宾将。"],0,"x207","宋"],["绍兴祀太社太稷十七首 其四 迎神用","郊庙朝会歌辞","四言",["谷资土养，民赖谷生。","功利之博，莫之与京。","式严祠坛，因物荐诚。","礼具乐奏，惟神顾歆。"],0,"x207","宋"],["绍兴祀太社太稷十七首 其三 迎神用","郊庙朝会歌辞","四言",["是尊是奉，兹率旧章。","乐音纯绎，荐溢圆方。","情文备矣，神其迪尝。","永观锡羡，多穑穰穰。"],0,"x207","宋"],["绍兴祀太社太稷十七首 其二 迎神用","郊庙朝会歌辞","四言",["功烈在民，诞受露雨。","良耜既歌，乃扬帗舞。","是奉是尊，厚礼斯举。","相其丰年，多稌多黍。"],0,"x207","宋"],["绍兴祀太社太稷十七首 其一 迎神用","郊庙朝会歌辞","四言",["五祀之本，社稷有严。","芟柞伊始，夫敢不虔。","吉日惟戊，式荐豆笾。","神其来格，用介有年。"],0,"x207","宋"],["绍兴祀皇地祇十五首 其四 迎神用《宁安》。","郊庙朝会歌辞","四言",["蒇事方丘，情文孔时。","名山大泽，侑祭无遗。","牲陈黝犊，乐备咸池。","柔祇皆出，介我繁禧。"],0,"x207","宋"],["绍兴祀皇地祇十五首 其三 迎神用《宁安》。","郊庙朝会歌辞","四言",["至哉坤元，乃顺承天。","厚德载物，含洪八埏。","日北多暑，祀仪吉蠲。","式昭毋事，敢告恭虔。"],0,"x207","宋"],["绍兴祀皇地祇十五首 其二 迎神用《宁安》。","郊庙朝会歌辞","四言",["蒇事方丘，旧典时式。","至诚感神，馨非黍稷。","肸蚃来临，鉴兹明德。","永锡坤珍，时万时亿。"],0,"x207","宋"],["绍兴祀皇地祇十五首 其一 迎神用《宁安》。","郊庙朝会歌辞","四言",["至哉厚德，物生是资。","直方维则，翕辟攸宜。","于昭祀典，致享坤仪。","礼罔不答，神之格思。"],0,"x207","宋"],["绍兴祀神州地祇十六首 其四 迎神用《宁安》。","郊庙朝会歌辞","四言",["翕辟以时，协气陶蒸。","播之金石，锵厥和声。","冥冥眑眑，孔享纯诚。","是听是娭，邦基永宁。"],0,"x207","宋"],["绍兴祀神州地祇十六首 其三 迎神用《宁安》。","郊庙朝会歌辞","四言",["坱圠无垠，磅礴罔测。","山盈川冲，自生自殖。","其报惟何，率礼靡忒。","亿万斯年，功被无极。"],0,"x207","宋"],["绍兴祀神州地祇十六首 其二 迎神用《宁安》。","郊庙朝会歌辞","四言",["洪惟坤元，道著品物。","上配紫旻，厚载其德。","良月肇蒇，祭器布列。","必先皇祇，以迓景福。"],0,"x207","宋"],["绍兴祀神州地祇十六首 其一 迎神用《宁安》。","郊庙朝会歌辞","四言",["芒芒下土，恢恢方仪。","富媪统摄，潜运八维。","爰称元祀，告备吉时。","揭兹虔恭，僾其格思。"],0,"x207","宋"],["绍兴祀高禖十首 其四 降神用《高安》。","郊庙朝会歌辞","四言",["春气肇分，万类滋荣。","惟此祀事，皆象发生。","求神以类，式昭至诚。","庶几来格，子孙绳绳。"],0,"x207","宋"],["绍兴祀高禖十首 其三 降神用《高安》。","郊庙朝会歌辞","四言",["猗欤禖宫，祀典所贵。","粤自艰难，礼或弗备。","以迄于今，始建坛壝。","愿戒云车，歆此诚意。"],0,"x207","宋"],["绍兴祀高禖十首 其二 降神用《高安》。","郊庙朝会歌辞","四言",["眷此尊祀，实惟仲春。","青圭束帛，克祀克禋。","庶蒙嘉惠，嗣续诜诜。","神之降鉴，云车来臻。"],0,"x207","宋"],["绍兴祀高禖十首 其一 降神用《高安》。","郊庙朝会歌辞","四言",["聿分春气，施生在时。","禖宫肇启，精意以祠。","礼仪告备，神其格思。","厥灵有赫，锡我繁厘。"],0,"x207","宋"],["绍兴淳熙分命馆职定撰十七首 其四 姑洗为羽","郊庙朝会歌辞","四言",["霜露既降，孝思奉先。","陟降上帝，礼隆九筵。","有馨黍稷，有肥牲牷。","神来燕娭，想像肃然。"],0,"x207","宋"],["绍兴淳熙分命馆职定撰十七首 其三 太簇为征","郊庙朝会歌辞","四言",["休德孔昭，灵承上帝。","孝极尊亲，严配于位。","嘉荐芬芳，礼无不备。","神其格思，享兹诚至。"],0,"x207","宋"],["绍兴淳熙分命馆职定撰十七首 其二 黄钟为角","郊庙朝会歌辞","四言",["合宫盛礼，金商令时。","备成熙事，搜扬上仪。","骏奔在庭，精意肃祗。","来享嘉荐，神灵燕娭。"],0,"x207","宋"],["绍兴淳熙分命馆职定撰十七首 其一 圜钟为宫","郊庙朝会歌辞","四言",["上直房心，时惟明堂。","配天享亲，宗祀有常。","盛德在金，日吉辰良。","享我克诚，来格来康。"],0,"x207","宋"],["绍兴朝日十首 其四 降神用《高安》。","郊庙朝会歌辞","四言",["屹尔王宫，泛临翊翊。","惠此万方，岂惟五色。","以修阳政，以习地德。","云景杳冥，施祥无极。"],0,"x207","宋"],["高宗建炎初祀昊天上帝 其一 降神用《景安》。","郊庙朝会歌辞","四言",["搜讲上仪，式修毖祀。","日吉辰良，礼成乐备。","风驭云旗，聿来歆止。","嘉我馨德，介兹繁祉。"],0,"x207","宋"],["高宗建炎初祀昊天上帝 其四 降神用《景安》。","郊庙朝会歌辞","四言",["惟天为大，物始攸资。","恭承禋祀，以报以祈。","神不可度，日监在兹。","有馨明德，庶其格思。"],0,"x207","宋"],["高宗建炎初祀昊天上帝 其二 降神用《景安》。","郊庙朝会歌辞","四言",["我将我享，涓选休成。","执事有恪，惟寅惟清。","乐既六变，肃雍和鸣。","高高在上，庶几是听。"],0,"x207","宋"],["淳祐祭海神十六首 其四 迎神用《延安》。","郊庙朝会歌辞","四言",["猗与祀礼，四海会同。","灵之来沛，鞭霆驭风。","肸蚃彷佛，在位肃雍。","佑我烝民，式徼神功。"],0,"x207","宋"],["淳祐祭海神十六首 其三 迎神用《延安》。","郊庙朝会歌辞","四言",["若稽有唐，克致崇极。","祝号既升，爰增祭式。","从享于郊，神斯受职。","我祀肇新，式祈阴骘。"],0,"x207","宋"],["淳祐祭海神十六首 其二 迎神用《延安》。","郊庙朝会歌辞","四言",["四溟广矣，八纮是纪。","我宅东南，回复万里。","洪涛飘风，安危所倚。","祀事特隆，神其戾止。"],0,"x207","宋"],["淳祐祭海神十六首 其一 迎神用《延安》。","郊庙朝会歌辞","四言",["堪舆之间，最钜惟瀛。","包干括坤，吐日滔星。","祀典载新，礼乐孔明。","鉴吾嘉赖，来燕来宁。"],0,"x207","宋"],["宁宗郊祀二十九首 其四 降神用《景安》。","郊庙朝会歌辞","四言",["金石宣昭，羽旄纷纶。","洁火夕照，明水夜陈。","娭哉惟灵，娭哉惟神。","风马招摇，惟德之亲。"],0,"x207","宋"],["宁宗郊祀二十九首 其三 降神用《景安》。","郊庙朝会歌辞","四言",["泰尊媪厘，祖功宗德。","辰躔陪营，岳渎受职。","神哉来下，神哉来格。","飨德惟馨，留虞嘉席。"],0,"x207","宋"],["宁宗郊祀二十九首 其二 降神用《景安》。","郊庙朝会歌辞","四言",["华盖既动，紫微洞开。","星枢周旋，日车徘徊。","灵兮顾佑，灵兮沛来。","载燕载娭，式时坛垓。"],0,"x207","宋"],["宁宗郊祀二十九首 其一 降神用《景安》。","郊庙朝会歌辞","四言",["天门荡荡，云车阴阴。","百神咸秩，三灵顾歆。","神哉来娭，神哉溥临。","飨时宋德，翼翼小心。"],0,"x207","宋"],["上册宝十三首 其四 迎神用《歆安》。","郊庙朝会歌辞","四言",["牺牲既成，笾豆有楚。","𪭢金击石，式歌且舞。","追怀懿德，令闻令仪。","灵兮来格，是享是宜。"],0,"x207","宋"],["上册宝十三首 其三 迎神用《歆安》。","郊庙朝会歌辞","四言",["雍雍在宫，翼翼在庭。","显相休嘉，肃雍和鸣。","神嗜饮食，明德惟馨。","绥我思成，式燕以宁。"],0,"x207","宋"],["上册宝十三首 其二 迎神用《歆安》。","郊庙朝会歌辞","四言",["吉蠲惟时，礼仪既备。","奉璋峨峨，群公在位。","神之格思，永锡尔类。","展彼令德，于焉来暨。"],0,"x207","宋"],["上册宝十三首 其一 迎神用《歆安》。","郊庙朝会歌辞","四言",["笾豆大房，牺尊将将。","馨香既登，明灵迪尝。","其乐伊何，吹笙鼓簧。","灵来燕娭，降福无疆。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 其三 降神用《太安》。六变。","郊庙朝会歌辞","四言",["龙车既奏，凤驭载翔。","帝幄伫灵，天衢腾芳。","神来留俞，神来蹇骧。","礼鬯乐明，奏假孔将。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 其四 降神用《太安》。六变。","郊庙朝会歌辞","四言",["虹旌蜺旄，鸾旗翠盖。","星枢扶轮，月御叶卫。","灵至阴阴，灵般裔裔。","来格来飨，福流万世。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 其二 降神用《太安》。六变。","郊庙朝会歌辞","四言",["芬枝扬烈，𤈶珠叶陶。","闿珍阐符，展诗舞箾。","神哉来下，神哉来翱。","肃若有承，灵心招摇。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 其一 降神用《太安》。六变。","郊庙朝会歌辞","四言",["四灵晨耀，五纬夕明。","风云晏和，天地粹清。","灵兮来迎，灵兮来宁。","启我子孙，飨于纯精。"],0,"x207","宋"],["宁宗朝享三十五首 其四 迎神用《兴安》。九变。","郊庙朝会歌辞","四言",["文以谟显，武以烈承。","圣训之保，祖武之绳。","有肃孝假，式严衎烝。","神其来兮，以宜以宁。"],0,"x207","宋"],["宁宗朝享三十五首 其三 迎神用《兴安》。九变。","郊庙朝会歌辞","四言",["穆穆紫幄，璜璜清宫。","旱麓流咏，凫鹥叶工。","道闳诒燕，业绵垂鸿。","神其来兮，以康以崇。"],0,"x207","宋"],["宁宗朝享三十五首 其二 迎神用《兴安》。九变。","郊庙朝会歌辞","四言",["勾陈旦辟，阊阖夜分。","轸风挟月，车驷凌云。","瑞景晻霭，神光耀煴。","神其来兮，以留以忻。"],0,"x207","宋"],["宁宗朝享三十五首 其一 迎神用《兴安》。九变。","郊庙朝会歌辞","四言",["咸英备乐，簋席列斝。","诗歌安世，声叶皇雅。","翠旗羽盖，云车风马。","神其来兮，以燕以下。"],0,"x207","宋"],["绍兴以后时享二十五首 其四 迎神用《兴安》。","郊庙朝会歌辞","四言",["道信于神，神灵燕娭。","酒有嘉德，物惟其时。","缓节安歌，乐奏具宜。","欣欣乐康，福禄绥之。"],0,"x207","宋"],["绍兴以后时享二十五首 其三 迎神用《兴安》。","郊庙朝会歌辞","四言",["嘉承和平，秩祀为先。","乃练休辰，祝史告虔。","内心齐明，祀具吉蠲。","交际恍惚，如在后前。"],0,"x207","宋"],["绍兴以后时享二十五首 其一 迎神用《兴安》。","郊庙朝会歌辞","四言",["奉先严祀，率礼大经。","时思致享，肃荐芳馨。","竭诚备物，乐奏和声。","真驭来止，熙事克成。"],0,"x207","宋"],["崇恩太后升祔十四首 迎神用《兴安》。四章。","郊庙朝会歌辞","四言",["閟宫有侐，堂筵屹崇。","灵徽匪遐，精诚感通。","苾芬维时，登兹明祀。","泠然云车，有来其驭。","羽旌风翔，翠蕤飘举。","俨其音徽，登兹位处。","笙镛始奏，合止柷敔。","是享是宜，永求伊祜。","枚枚閟宫，鼎俎肆陈。","烝畀明灵，登其嘉新。","鼓钟既戒，旨酒既醇。","攸介攸止，纯禧荐臻。","旨酒嘉肴，于登于豆。","是享是宜，乐既合奏。","衎我懿德，执事温恭。","灵兮允格，有翼其从。"],0,"x207","宋"],["祫享八首 其四 迎神用《兴安》。","郊庙朝会歌辞","四言",["苾芬孝祀，荐灌肃雍。","致力于神，明信咸通。","灵之妥留，惠我庞鸿。","广被万宇，福禄攸同。"],0,"x207","宋"],["祫享八首 其三 迎神用《兴安》。","郊庙朝会歌辞","四言",["于昭孝治，通乎神明。","寒暑不忒，熙事备成。","牲牷孔硕，黍稷惟馨。","以享以祀，来燕来宁。"],0,"x207","宋"],["祫享八首 其二 迎神用《兴安》。","郊庙朝会歌辞","四言",["于穆孝思，嘉荐维时。","诚通兹格，咸来燕娭。","神之听之，申锡蕃厘。","于万斯年，永保丕基。"],0,"x207","宋"],["祫享八首 其一 迎神用《兴安》。","郊庙朝会歌辞","四言",["时维孟冬，霜露既零。","合食盛礼，以时以行。","孝心翼翼，惟神来宁。","肃倡斯举，神具是听。"],0,"x207","宋"],["高宗建炎初祀昊天上帝 其三 降神用《景安》。","郊庙朝会歌辞","四言",["礼崇禋祀，备物荐诚。","昭格穹昊，明德惟馨。","风马云车，肸蚃居歆。","申锡无疆，赉我思成。"],0,"x207","宋"],["绍兴以后祀感生帝十六首 其二 降神用《大安》。","郊庙朝会歌辞","四言",["宋德惟火，神实司之。","上仪申蒇，迎方重离。","瑶币告洁，秀华金支。","啾啾神龙，来介繁禧。"],0,"x207","宋"],["绍兴朝日十首 其一 降神用《高安》。","郊庙朝会歌辞","四言",["玄鸟既至，序属春分。","朝于太阳，厥典备存。","载严大采，示民有尊。","扬光下烛，煜爚东门。"],0,"x207","宋"],["绍兴朝日十首 其三 降神用《高安》。","郊庙朝会歌辞","四言",["周祀及暗，汉制中营。","肸蚃是届，礼神以兄。","我洁斯璧，我肥斯牲。","神兮燕享，鉴观孔明。"],0,"x207","宋"],["绍兴以后时享二十五首 其二 迎神用《兴安》。","郊庙朝会歌辞","四言",["圣灵在天，九关崇深。","风马云车，纷其顾临。","拥祥储休，昭答孝心。","孝孙受祉，万福是膺。"],0,"x207","宋"],["绍兴祀大火十二首 其一 降神用《高安》。","郊庙朝会歌辞","四言",["五纬相天，各率其职。","司礼与视，则维荧惑。","至阳之精，届我长嬴。","于以求之，祀事孔明。"],0,"x207","宋"],["出火祀大辰十二首 其四 降神用《高安》。","郊庙朝会歌辞","四言",["星入于戌，与火俱诎。","火出于辰，与星俱伸。","一伸一诎，孰操纵之。","利用出入，民咸用之。"],0,"x207","宋"],["淳化乡饮酒三十三章 其一","郊庙朝会歌辞","四言",["鹿鸣呦呦，命侣与俦。","宴乐嘉宾，既献且酬。","献酬有序，休祉无疆。","展矣君子，邦家之光。","鹿鸣呦呦，在彼中林。","宴乐嘉宾，式昭德音。","德音愔愔，既乐且湛。","允矣君子，实慰我心。","鹿鸣呦呦，在彼高冈。","宴乐嘉宾，吹笙鼓簧。","币帛戋戋，礼仪蹡蹡。","乐只君子，利用宾王。","鹿鸣相呼，聚泽之蒲。","我乐嘉宾，鼓瑟吹竽。","我命旨酒，以燕以娱。","何以赠之，玄𫄸粲如。","鹿鸣相邀，聚场之苗。","我美嘉宾，令名孔昭。","我命旨酒，以歌以谣。","何以置之，大君之朝。","鹿鸣相应，聚山之荆。","我燕嘉宾，鼓簧吹笙。","我命旨酒，以逢以迎。","何以荐之，扬于王庭。"],0,"x207","宋"],null,null,["淳化乡饮酒三十三章 其五","郊庙朝会歌辞","四言",["关雎于飞，洲渚之湄。","自家刑国，乐且有仪。","郁郁芳兰，幽人撷之。","温温恭人，哲后求之。","求之无斁，寤寐所属。","罄尔一心，受天百禄。","郁郁芳兰，雨露滋之。","温温恭人，圭组縻之。","郁郁芳兰，佩服珍之。","温温恭人，福履绥之。","关雎跄跄，集水之央。","好求贤辅，同扬德光。","苹蘩芳滋，同谁掇之。","愿言贤德，靡日不思。","偶其贤德，辅成己职。","永配玉音，服之无斁。","洁其粢盛，中心匪宁。","荐于宗庙，助君德馨。","贤淑来思，人之表仪。","风化天下，何乐如之。"],0,"x207","宋"],["淳化乡饮酒三十三章 其六","郊庙朝会歌辞","四言",["彼鹊成巢，尔类攸处。","之子有归，琼瑶是祖。","彼鹊成巢，尔类攸匹。","之子有行，锦绣是饰。","彼鹊成巢，尔类攸共。","之子有从，兰荪是奉。","伊鹊成巢，珍禽戾止。","婉彼佳人，配于君子。","伊鹊营巢，珍禽攸处。","内助贤侯，弼于明主。","伊鹊营巢，珍禽辑睦。","均养嘉雏，致于蕃育。"],0,"x207","宋"],["皇祐亲享明堂六首 其一 降神用《诚安》。","郊庙朝会歌辞","四言",["维圣享帝，维孝严亲。","肇图世室，躬展精禋。","镛鼓既设，笾豆既陈。","至诚攸感，保格上神。"],0,"x207","宋"],["章献明肃皇太后恭谢太庙","郊庙朝会歌辞","四言",["于穆宋庙，肇允基扃。","文母来献，国祚咸宁。","永言昭格，式荐惟馨。","亦既降止，聿柄神灵。","九奏允谐，皇灵来暨。","备物芬馨，昭违精意。","升降有仪，群臣序位。","享于克诚，万福攸至。","懿彼灵龟，在宫之池。","芳莲是托，千岁奇姿。","祼将清庙，播于声诗。","神降之吉，永保寿祺。","洁尔牺牲，既角且骍。","玉俎奉将，式表纯精。","祖宗斯享，毖祀以成。","福禄来降，邦祚隆平。","太宫尔肃，烈祖巍巍。","上炳淳耀，下流德晖。","诒谋燕翼，奄宅邦畿。","子孙千亿，历数同归。","乃祖齐圣，绵瓞其昌。","源流浚邈，统祚悠长。","如闻肃僾，有𫗣馨香。","监观垂祐，万叶储祥。","奕奕清庙，巍巍帝基。","诒谋积德，累洽熏熙。","粢盛丰洁，礼容肃祗。","俯歆明荐，永锡蕃禧。","赤符启祚，长发其祥。","灵源自远，帝运重光。","载洁笾豆，恭荐令芳。","致成翼翼，降福穰穰。","英英艺祖，出震承干。","握图抚运，卜祚延年。","衣冠在庙，威灵在天。","永锡无疆，子孙保焉。","赫赫皇祖，万邦之君。","功崇偃革，德盛兴文。","圣谟宏达，至教氤氲。","子孙百世，祗荐苾芬。","巍巍新庙，穆穆真皇。","德符二圣，仁洽万方。","坠典咸秩，鸿仪用彰。","威灵如在，时思不忘。","苾芬既荐，溥硕咸陈。","礼备乐举，先后有伦。","以奉七室，齐洁惟寅。","皇灵斯享，福祥荐臻。","籥翟既备，干戚是陈。","德业昭著，用和神人。","牲牷腯肥，粢盛丰洁。","三献用行，万舞复列。","礼仪克成，乐奏将阕。","神保聿归，玉豆斯彻。"],0,"x207","宋"],["真宗奉圣祖玉清昭应宫十一首 其一 降圣用《真安》。","郊庙朝会歌辞","四言",["巍巍真宇，奕奕殊庭。","规模太紫，炳焕丹青。","元命祗答，大猷是经。","多仪有践，丕应无形。","肆设金石，声闻杳冥。","伫回飙驭，永祐基扃。"],0,"x207","宋"],["先蚕六首 其一 迎神用《明安》。","郊庙朝会歌辞","四言",["生民之朔，衣皮而群。","惟圣有作，被冒以文。","礼乐以成，贵贱以分。","欲报之德，金石谐均。"],0,"x207","宋"],["建隆郊祀八首 降神用《高安》。","郊庙朝会歌辞","四言",["在国南方，时维就阳。","以祈帝祉，式致民康。","豆笾鼎俎，金石丝簧。","礼行乐奏，皇祚无疆。","步武舒迟，升坛肃祗。","其容允若，于礼攸宜。","嘉玉制币，以通神明。","神不享物，享于克诚。","笙镛备乐，茧栗陈牲。","乃迎芳俎，以荐高明。","丹云之爵，金龙之杓。","挹于尊罍，是曰清酌。","洁兹五齐，酌彼六尊。","致诚斯至，率礼弥敦。","以介景福，永隆后昆。","重熙累洽，帝道攸尊。","谓天盖高，其听孔卑。","闻乐歆德，介以福禧。","倏兮而来，忽兮而回。","云驭杳邈，天门洞开。"],0,"x207","宋"],["咸平亲郊八首 降神用《高安》。","郊庙朝会歌辞","四言",["圜丘何方，在国之阳。","礼神合祭，运启无疆。","祖考来格，笾豆成行。","其仪肃肃，降福穰穰。","礼备乐成，干健天行。","帝容有穆，佩玉锵鸣。","定位毖祀，告于神明。","嘉玉量币，享于克诚。","有牲斯纯，有俎斯陈。","进于上帝，昭报深仁。","大报于帝，盛德升闻。","醴齐良洁，粢盛苾芬。","祀帝圜丘，九州献力。","礼行于郊，百神受职。","灵祗格思，享我明德。","天鉴孔章，玄祉昭锡。","羽籥云罢，干戚载扬。","接神有恪，锡羡无疆。","神驾来思，风举云飞。","神驭归止，天空露晞。"],0,"x207","宋"],["景祐亲郊三圣并侑二首 奠币用《广安》。","郊庙朝会歌辞","四言",["千龄启运，三后在天。","嘉坛并侑，亿万斯年。","皇基缔构，帝系灵长。","躬荐郁鬯，子孙保昌。"],0,"x207","宋"],["景祐常祀二首 太祖配位奠币用《定安》。","郊庙朝会歌辞","四言",["翕受骏命，震叠群方。","侑祀上帝，德厚流光。","诞受灵符，肇基丕业。","配享洁尊，永隆万叶。"],0,"x207","宋"],["元符亲郊五首 降神用《景安》，六变辞同。","郊庙朝会歌辞","四言",["无为靡远，深厚广圻。","祭神恭在，弁冕衮衣。","粢盛丰美，明德馨辉。","以祥以佑，非眇专祈。","神灵拥卫，景从云随。","玉色温粹，天步舒迟。","周旋陟降，皇心肃祗。","千灵是保，百福攸宜。","陟彼郊丘，大祀是承。","其豆孔庶，其香始升。","上帝时歆，以我齐明。","卒事而彻，福禄来咸。","馨遗八尊，器空二簋。","至祝至虔，穹祇贶祉。"],0,"x207","宋"],null,null,null,["景祐上辛祈谷二首 太宗配位奠币用《仁安》。","郊庙朝会歌辞","四言",["天祚有开，文德来远。","祈谷日辛，侑神礼展。","于穆神宗，惟皇永命。","荐醴六尊，声歌千咏。"],0,"x207","宋"],null,["孟夏雩祀二首 太祖配坐奠币用《献安》。","郊庙朝会歌辞","四言",["昊天盖高，祀事为大。","严配皇灵，亿福来介。","龙见而雩，神之来格。","牺象精良，威灵赫奕。"],0,"x207","宋"],["景德以后祀五方帝十六首 青帝降神用《高安》。六变。","郊庙朝会歌辞","四言",["四序伊始，三阳肇新。","气迎东郊，蛰户咸春。","功宣播殖，泽被生民。","祝史正辞，昭事惟寅。","条风始至，盛德在木。","平秩东作，种献穜穋。","律应青阳，气和玉烛。","惠彼兆民，以介景福。","备物致用，荐羞神明。","礼成乐举，克享克禋。","条风斯应，候历维新。","阳和启蛰，品物皆春。","篪簧协奏，簠簋毕陈。","精羞丰荐，景福攸臻。","长嬴戒序，候正南讹。","功资蕃育，气应清和。","鼎实嘉俎，乐备登歌。","神其来享，降福孔多。","象分离位，德配炎精。","景风协律，化神含生。","百嘉茂育，乃顺高明。","神无常享，享于克诚。","笾豆有践，黍稷惟馨。","礼终三献，神归杳冥。","坤舆厚载，黄裳元吉。","宅中居正，含章抱质。","分王四季，其功靡秩。","育此群生，首兹六律。","中央定位，厚德惟新。","五行攸正，四气爰均。","笙镛以间，簠簋斯陈。","为民祈福，肃奉明禋。","土德居中，方舆配位。","乐以送神，式申昭事。","隆冬戒序，岁历顺成。","一人有庆，万物由庚。","有旨斯酒，有硕斯牲。","报功崇德，正直聪明。","大仪斡运，星纪环周。","三时不害，黍稷盈畴。","克诚致享，品物咸羞。","礼成乐变，锡祚贻休。","管磬咸和，礼献斯毕。","灵驭言旋，神降之吉。"],0,"x207","宋"],null,null,null,null,null,["景祐祀感生帝二首 宣祖配位奠币用《皇安》。","郊庙朝会歌辞","四言",["浚发长源，粤惟始祖。","五运协图，万灵来护。","龙德而隐，源流则长。","宜乎亿祀，侑享弥昌。"],0,"x207","宋"],["元符祀感生帝五首 降神用《大安》。六变。","郊庙朝会歌辞","四言",["二仪交泰，七政顺行。","四序资始，万物含生。","皇朝创业，盛德致平。","为民祈福，洁此精诚。","冕旒俨若，步武有容。","公卿济济，韶頀邕邕。","乐和凤律，酒奠牺尊。","神明斯享，礼盛难论。","大君有命，阙典咸修。","帝歆明祀，佑圣千秋。","俯临下土，回复上天。","触类而长，荷福无边。"],0,"x207","宋"],["景祐大享明堂二首 真宗配位奠币用《诚安》。","郊庙朝会歌辞","四言",["思文圣考，对越在天。","侑神作主，奉币申虔。","偃革兴文，封峦考瑞。","威烈巍巍，允膺宗祀。"],0,"x207","宋"],null,["熙宁亲享明堂二首 英宗奠币用《诚安》。","郊庙朝会歌辞","四言",["于皇圣考，克配上帝。","永言孝思，昭荐嘉币。","英声迈古，德施在民。","允秩宗祀，宾延上神。"],0,"x207","宋"],["元符亲享明堂十一首 皇帝升降用《仪安》。","郊庙朝会歌辞","四言",["严父配天，孝乎明堂。","与奠升阶，降音以将。","天步有节，帝容必庄。","辟公宪之，礼无不臧。","圣能享帝，孝克事亲。","于皇宗祀，盛节此陈。","何以荐虔，二精有炜。","何以致祥，上天鉴止。","合宫礼备，时维哲王。","堂筵四敞，明德馨香。","圣考来格，降福穰穰。","承承继继，万祀其昌。","奕奕明堂，天子即事。","奠我圣考，配于上帝。","凡百有职，畴敢不祗。","俎洁牲肥，其登有仪。","惟礼不渎，所以严亲。","惟孝不匮，所以教民。","陟配文考，享于大神。","重禧累福，祚裔无垠。","隆功骏德，两有烈光。","陟配宗祀，惠我无疆。","舞以象功，乐惟崇德。","文经万邦，武靖四国。","一张一弛，其仪不忒。","神鉴孔昭，孝思维则。","于昭盛礼，严父配天。","尽物尽诚，莫匪吉蠲。","重觞既荐，九奏相宣。","神介景福，亿万斯年。","莫尊乎天，莫亲乎父。","既享既侑，诚申礼举。","戛击堂上，八音始具。","天子亿龄，饮神之胙。","穆穆在堂，肃肃在庭。","于显辟公，来相思成。","神既歆止，有闻无声。","锡我休嘉，燕及群生。","有奕明堂，万方时会。","宗子圣考，作帝之配。","乐酌虞典，礼从周志。","厘事既成，于皇来暨。"],0,"x207","宋"],["大观宗祀明堂五首 其一 奠玉币用《镇安》。","郊庙朝会歌辞","四言",["交于神明，内心为贵。","外致其文，亦效精意。","嘉玉既陈，将以量币。","肃肃雍雍，惟帝之对。"],0,"x207","宋"],null,null,["景德祀皇地祇三首 降神用《静安》。","郊庙朝会歌辞","四言",["至哉厚德，陟配天长。","沈潜刚克，广大无疆。","资生万物，神化含章。","同和八变，神灵效祥。","于昭祀典，致享坤仪。","备物咸秩，柔祇格思。","功宣敏树，日益鸿禧。","持载品汇，率土攸宜。","妙用无方，倏来忽逝。","蠲洁寅恭，式终禋瘗。"],0,"x207","宋"],null,null,["常祀皇地祇五首 迎神用《宁安》。八变。","郊庙朝会歌辞","四言",["坤元之德，光大无疆。","一气交感，百物阜昌。","吉蠲致享，精明是将。","介兹景福，鼎祚灵长。","礼经之重，祭典为宗。","上公摄事，登降弥恭。","庶品丰洁，令仪肃雍。","百祥萃止，维吉之从。","礼崇禋祀，神鉴孔明。","牲牷博腯，以炰以烹。","馨香蠲洁，品物惟精。","锡以纯嘏，享兹至诚。","进旅退旅，载扬干扬。","不愆于仪，容服有章。","式绥式侑，神保是听。","鼓之舞之，神永安宁。","物备百嘉，乐周八变。","克诚是享，明德斯荐。","神鉴孔昭，蕃禧锡羡。","回驭飘然，邈不可见。"],0,"x207","宋"],null,["宋初祀神州地祇三首 降神用《静安》。","郊庙朝会歌辞","四言",["膴膴郊原，茫茫宇县。","画野分疆，禹功疏奠。","灵祇是臻，豆笾祗荐。","幽赞皇图，视之不见。","肸蚃储灵，肃恭用币。","锵洋导和，洪休允契。","嘉气云蒸，浃于华裔。","式荐坤珍，聿符明世。","献奠云毕，纯嘏祁祁。","威灵藏用，邈矣何之。"],0,"x207","宋"],null,null,null,["夕月三首 降神用《高安》。六变。","郊庙朝会歌辞","四言",["凝阴禀粹，照临八埏。","丽天垂象，继日代明。","一气资始，四时运行。","灵祇昭格，备物荐诚。","夕耀乘秋，功存宇县。","金奏在县，以时致荐。","祀事孔寅，明灵降眷。","洁粢丰盛，仓箱流衍。","夙陈笾豆，洁诚致祈。","垂休保佑，景祚巍巍。"],0,"x207","宋"],["大观秋分夕月四首 其一 降神用《高安》。","郊庙朝会歌辞","四言",["至阴之精，亏而复盈。","轮高仙桂，阶应祥蓂。","玉兔影孤，金茎露溢。","其驾星车，顾于兹夕。"],0,"x207","宋"],null,null,["熙宁以后祀高禖六首 降神用《高安》。六变。","郊庙朝会歌辞","四言",["容台讲礼，禖宫立祠。","司分届后，带韣陈仪。","嘉祥萃止，灵驭来思。","皇支蕃衍，永固邦基。","郊禖之应，肇自生商。","诞膺宝命，浚发其祥。","天材蕃衍，德称君王。","本支万世，与天无疆。","昔帝高辛，先禖肇祀。","爰揆仲阳，式祈嘉祉。","陈之牺牲，授以弓矢。","敷祐皇宗，施于孙子。","昭荐精衷，灵承端命。","青帝顾怀，神禖储庆。","祚以蕃昌，协于熙盛。","螽斯众多，流于雅咏。","赫赫高禖，万世所祀。","其德不回，锡兹福祉。","蕃衍椒聊，和平芣苢。","传类降康，世济其美。","礼奠蠲衷，祭仪竣事。","丕拥灵休，蕃衍皇嗣。"],0,"x207","宋"],null,["景德祀九宫贵神三首 降神用《高安》。","郊庙朝会歌辞","四言",["倬彼垂象，照临下土。","躔次运行，功德周普。","九宫既位，惟德是辅。","神之至上，皇皇斯睹。","灵禋既肃，明神既秩。","在国之东，协日之吉。","升歌有仪，六变中律。","怀和万灵，降兹阴骘。","祗荐有常，惟神无方。","回飙整驭，垂休降祥。"],0,"x207","宋"],["元祐祀九宫贵神二首 其一 降神用《景安》。六变。","郊庙朝会歌辞","四言",["上天贵神，九宫设位。","功德及物，乃秩明祀。","望拜紫坛，赫然灵气。","奠玉荐币，歆之无愧。"],0,"x207","宋"],null,["建隆以来祀享太庙十六首 迎神用《礼安》。","郊庙朝会歌辞","四言",["肃肃清庙，奉祠来诣。","格思之灵，如在之祭。","克谨威仪，载严容卫。","降福孔皆，以克永世。","工祝升阶，宾尸在位。","祗达孝思，允修毖祀。","显相有仪，克恭乃事。","俨恪其容，通此精意。","木符启瑞，著象成文。","于昭大号，协应明君。","灵命有属，鸿禧洞分。","歌以升荐，休嘉洽闻。","嘉彼驯象，来归帝乡。","南州毓质，中区效祥。","仁格巨兽，德柔遐荒。","有感斯应，神化无方。","素乌爰止，淳精允臧。","名符瑞牒，色应金方。","洁白容与，翘英奋扬。","孝思攸感，皇德逾张。","维牺维牲，以炰以烹。","植其鼗鼓，洁彼铏羹。","孔硕兹俎，于穆厥声。","肃雍显相，福禄来成。","汤汤洪河，经启长源。","郁郁嘉木，挺生本根。","大哉崇基，出乎庆门。","发祥垂裕，永世贻孙。","元钟九千，生于仲吕。","崇台九层，起于累土。","赫日之升，明夷为主。","孝孙作帝，式由祖武。","明明我祖，积德攸宜。","肇继瓜瓞，将隆本支。","爰资庆绪，式昭帝基。","于穆清庙，永洽重熙。","艰难积行，绵长钟庆。","同人之时，得主乃定。","既叙宗祧，乃修舞咏。","经武开先，永昭丕命。","猗欤太祖，受命于天。","化行区宇，功溢简编。","武威震耀，文德昭宣。","开基垂统，亿万斯年。","赫赫皇运，明明太宗。","四隩咸暨，一变时雍。","睿文炳焕，圣德温恭。","千龄万祀，永播笙镛。","已象文治，乃观武成。","进退可度，威仪克明。","常武徂征，诗人所称。","总干山立，厥象伊凝。","肥腯之牲，既析既荐。","郁鬯之酒，已酌已献。","祝辞亦陈，和奏斯遍。","享礼具举，彻其有践。"],0,"x207","宋"],["真宗御制二首 其一 奠瓒用《万国朝天》。","郊庙朝会歌辞","四言",["鸿源浚发，睿图诞彰。","高明锡羡，累洽延祥。","巍巍艺祖，溥率宾王。","煌煌文考，区宇大康。","珍符昭显，宝历绵长。","物性茂遂，民俗阜昌。","甫田多稼，禾黍穰穰。","含生嘉育，鸟兽跄跄。","八纮统域，九服要荒。","沐浴惠泽，祗畏典常。","隔谷分壤，望斗辨方。","并袭冠带，来奉圭璋。","峨峨双阙，济济明堂。","诸侯执帛，天后当阳。","何以辨等，衮衣绣裳。","何以褒德，辂车乘黄。","声明焕赫，雅颂汪洋。","启兹丕绪，祐我无疆。","大统斯集，大乐斯扬。","俯隆宗祏，仰继穹苍。"],0,"x207","宋"],["真宗告飨六首 其一 告受天书用《瑞安》。","郊庙朝会歌辞","四言",["宝命自天，鸿禧锡祚。","昭晰绿文，氤氲黄素。","玄感荐彰，灵休诞布。","寅奉珍符，聿怀永慕。"],0,"x207","宋"],["景祐亲享太庙二首 其一 迎神用《兴安》。","郊庙朝会歌辞","四言",["追养奉先，纳孝练主。","金奏凤鸣，关雎乐舞。","奠鬯恭神，肥腯展俎。","积庆聪明，降景寰宇。"],0,"x207","宋"],["至和祫享三首 其一 迎神用《兴安》。","郊庙朝会歌辞","四言",["濡露降霜，永怀孝思。","祫食谛叙，再闰之期。","歌德咏功，八音播之。","歆神惟始，灵其格兹。"],0,"x207","宋"],["嘉祐祫享二首 其一 迎神用《怀安》。","郊庙朝会歌辞","四言",["躬兹孝享，礼备乐成。","神登于俎，祝导于祊。","展牲肥腯，奏格和平。","灵其昭格，肃僾凝情。"],0,"x207","宋"],["熙宁以后享庙五首 酌献英宗室用《大英》。","郊庙朝会歌辞","四言",["在宋五世，天子嗣昌。","躬发英断，若干之刚。","声容沄沄，被于八荒。","垂千万年，永烈有光。","钟鼓惟旅，笾豆孔时。","衎我祖宗，既右享之。","神亟来止，孝孙之喜。","神保聿归，孝孙之思。","进退有容，服章有仪。","匪亟匪迟，降登孔时。","于穆仁庙，圣泽滂流。","华夷用乂，动植蒙休。","徽名冠古，奕世垂谋。","帝躬祼献，盛典昭修。","赫赫英皇，总提邦纪。","浚发神功，恢张圣理。","仙驭虽遥，鸿徽不弭。","永言孝思，竭诚躬祀。"],0,"x207","宋"],["常祀五享三首 其一 迎神用《兴安》。九变。","郊庙朝会歌辞","四言",["奕奕清庙，昭穆定位。","霜露增感，粢盛洁祭。","神灵来格，福祉攸暨。","追孝奉先，本支百世。"],0,"x207","宋"],null,null,["绍兴十四年奉上徽宗册宝三首 其一 册宝入门用《显安》。","郊庙朝会歌辞","四言",["于铄徽考，如天莫名。","迨兹丕扬，拟纯粹精。","温玉镂文，来至于祊。","有严奕奕，礼备乐成。"],0,"x207","宋"],["淳熙十五年上高宗徽号三首 其一 册宝入门用《显安》。","郊庙朝会歌辞","四言",["于穆高皇，功德兼隆。","称天以诔，初谥未崇。","载稽礼典，扬徽垂鸿。","涓日之良，登进庙宫。"],0,"x207","宋"],["庆元三年奉上孝宗徽号三首 其一 册宝入门用《显安》。","郊庙朝会歌辞","四言",["巍巍孝庙，圣德天通。","同符艺祖，克绍高宗。","有仪有册，载推载崇。","镂玉绳金，登奉祏宫。"],0,"x207","宋"],null,null,["理宗朝享三首 其一 皇帝升降用《干安》。","郊庙朝会歌辞","四言",["于皇祖宗，清庙奕奕。","威灵在天，不显惟德。","垂裕鸿延，诒谋燕翼。","孝孙格斯，受祉罔极。"],0,"x207","宋"],null,["孝宗明堂前享太庙三首 徽宗室酌献用《承元》。","郊庙朝会歌辞","四言",["明明徽祖，抚世升平。","制礼作乐，发政施仁。","圣灵在天，德泽在民。","亿万斯年，保佑后人。","于皇时宋，自天保定。","高宗受之，再仆景命。","绍开中兴，翼善传圣。","何千万年，永绥厥庆。","礼既行矣，乐既成矣。","维祖维妣，安且宁矣。","皇举玉趾，佩锵鸣矣。","拜贶总章，于厥明矣。"],0,"x207","宋"],["理宗明堂前朝享二首 其一 宁宗室奠币用《定安》。","郊庙朝会歌辞","四言",["皇矣昭考，圣灵在天。","称秩宗祀，有严恭先。","奉币以荐，见之僾然。","仁深泽厚，厥光以延。"],0,"x207","宋"],["皇后庙十五首 迎神用《肃安》。","郊庙朝会歌辞","四言",["閟宫翼翼，雅乐洋洋。","牲器肃设，几筵用张。","饰以明备，秩其令芳。","神兮来格，风动云翔。","服章观象，山龙是则。","容止跄跄，威仪翼翼。","恪恭奉祀，祗荐牺牲。","九成爰奏，有俎斯盈。","祀事孔明，庙室惟肃。","铏登笾豆，金石丝竹。","既灌既荐，允恭允穆。","奉神如在，以介景福。","初阳作配，内助惟贤。","柔顺中积，英徽外宣。","神宫有侐，明祀惟虔。","歆诚降祐，于万斯年。","猗那淑圣，象应资生。","配天作合，与日齐明。","椒宫垂范，彤史扬名。","聿修毖祀，永奉粢盛。","王门禀庆，帝族惟贤。","功存内治，德协静专。","流芳图史，垂范纮𫄧。","新庙有侐，祀礼昭然。","明明英媛，德备椒庭。","笾豆有践，黍稷匪馨。","静嘉致荐，容与昭灵。","精意以达，顾享来宁。","曾孙袭庆，柔祇育德。","正位居体，其仪不忒。","教被宫壶，化行邦国。","祝史正辞，垂裕无极。","淑德昭著，至乐和平。","登豆在列，膋香荐诚。","六变合礼，八音谐声。","穰穰景福，佑我休明。","为太宗后，为天下母。","诞圣继明，膺干作主。","玉振金相，兰芬桂芳。","于万斯年，永奉烝尝。","彝尊鬯酒，庆佑遂行。","介以纯嘏，允答明诚。","宗臣率礼，步玉锵锵。","吉蠲斯献，百禄是将。","荐献有终，礼容斯穆。","以奉嘉觞，以膺多福。","明禋告毕，灵辂难留。","升云杳邈，整驭优游。","诚深嘉栗，礼罄钦修。","丰融垂佑，以永洪休。"],0,"x207","宋"],["景祐以后乐章六首 章献明肃皇太后室奠瓒用《达安》。","郊庙朝会歌辞","四言",["肃肃閟宫，顺时荐事。","郁鬯馨香，如见于位。","祥标曾麓，德合方仪。","万邦展养，九御蒙慈。","孝恭祊祏，美播声诗。","淑灵顾享，申锡维祺。","青金玉瓒，祼将于京。","永怀罔极，夙夜齐明。","翊佐先朝，章明壶教。","淑顺谦勤，徽音在劭。","树风不止，劬劳匪报。","黍稷令芳，嘏兹乃告。","祼圭既陈，酌鬯斯醇。","音容彷佛，奠献惟寅。","内辅先猷，夙昭壶则。","保祐之劳，慈惠其德。","荣养有终，芳风无极。","享献閟宫，载怀凄恻。"],0,"x207","宋"],["真宗汾阴礼毕亲谢元德皇后室三首 迎神用《肃安》。","郊庙朝会歌辞","四言",["閟宫奕奕，韶乐洋洋。","牲币虔布，几筵肃张。","醴泉淳美，嘉肴洁香。","俟神来格，降彼帝乡。","乐铿金石，俎奉牺牲。","九成斯奏，五教爰行。","鸾骖复整，鹤驾难留。","白云缥缈，紫府深幽。","庙虽载止，神无不游。","垂佑皇宋，以永鸿休。"],0,"x207","宋"],null,["上钦成皇后册宝六首 其一 入门、升殿用《显安》。","郊庙朝会歌辞","四言",["上帝锡羡，寔生婉淑。","辅佐神皇，宠膺天禄。","诞育泰陵，劬劳顾复。","于昭徽音，久而弥郁。"],0,"x207","宋"],["上明达皇后册宝五首 其一 迎神用《歆安》。","郊庙朝会歌辞","四言",["恭俭宜家，柔顺承天。","德昭彤管，忧在进贤。","宝册袆翟，追荣寿原。","四时祼享，何千万年。"],0,"x207","宋"],["绍兴别庙乐歌五首 其一 升殿用《崇安》。","郊庙朝会歌辞","四言",["新庙肃肃，蒇事以时。","陟降阶墄，雍容有仪。","鞠躬周旋，罔敢不祗。","祝史正辞，灵其格思。"],0,"x207","宋"],["乾道别庙乐歌三首 其一 诣庙用《干安》。","郊庙朝会歌辞","四言",["涓选休辰，于秋之杪。","既齐既戒，爰假祖庙。","有侐仪坤，旧章是效。","享祀奚为，天子纯孝。"],0,"x207","宋"],["绍熙别庙二首 其一 安穆皇后室酌献用《歆安》。","郊庙朝会歌辞","四言",["祥发伣天，符彰梦日。","有怀慈容，孝享庙室。","泰尊是酌，旨酒嘉栗。","灵其格思，祚以元吉。"],0,"x207","宋"],null,["玉清昭应宫上尊号三首 其一 奉告用《隆安》。","郊庙朝会歌辞","四言",["登隆妙号，钦翼渊宗。","茂宣德礼，有恪其容。","奉璋升荐，垂佩弥恭。","扬休咏美，以间笙镛。"],0,"x207","宋"],["朝谒太清宫九首 其一 太尉奉圣号册宝用《真安》。","郊庙朝会歌辞","四言",["上旻降监，介祉实繁。","邦家修报，妙道归尊。","增名霄极，奉册灵轩。","茂宣圣典，永祐黎元。"],0,"x207","宋"],["景祐元年亲享景灵宫二首 降真用《太安》。","郊庙朝会歌辞","四言",["真馆奉币，洁齐致馨。","灵因斯格，社稷庆宁。","椒浆尊享，珍馔精祈。","睟容杳邈，瑶辂霞飞。"],0,"x207","宋"],["大观三年朝献景灵宫二首 其一 奉馔用《吉安》。","郊庙朝会歌辞","四言",["威灵洋洋，靡有常向。","于惟钦承，来假来飨。","博硕芬香，是烝是享。","奉器有虔，载德无爽。"],0,"x207","宋"],null,null,["孝宗明堂前朝献景灵宫八首 其一 盥洗用《干安》。","郊庙朝会歌辞","四言",["合宫之飨，报本奉先。","钦惟道祖，浚发璇源。","驾言谒款，其盥惟虔。","尚监精衷，锡祚绵绵。"],0,"x207","宋"],null,["理宗明堂前朝献景灵宫二首 其一 升殿登歌《干安》。","郊庙朝会歌辞","四言",["我享我将，罄兹精意。","陟降左右，维天与契。","斋明乃心，祗肃在位。","于万斯年，百福来备。"],0,"x207","宋"],["大中祥符封禅十首 其一 山上圜台降神用《高安》。","郊庙朝会歌辞","四言",["岩岩泰山，配德于天。","奉符展采，翼翼干干。","涤濯静嘉，罔有弗蠲。","上帝顾𬤊，冷风肃然。"],0,"x207","宋"],["汾阴十首 降神用《靖安》。","郊庙朝会歌辞","四言",["茫茫坤载，粤惟太宁。","资生光大，品物流形。","瞻言汾曲，允宅神灵。","圣皇躬享，明德惟馨。","至诚旁达，柔祇格思。","奉以琮币，致诚在兹。","博硕者牲，载纯其色。","体荐登俎，聿崇坤德。","秉阴成德，敏树宣功。","应变审谛，神力无穷。","沈潜刚克，流谦示中。","洁兹奠献，妙物玄通。","坤元茂育，植物成形。","于穆圣祖，功齐三灵。","严恭配侑，厚德攸宁。","永怀锡羡，歆此惟馨。","报功厚载，祀事惟明。","思文烈考，道济群生。","侑神定位，协德安平。","馨洁并荐，享于克诚。","寅威宝命，明祀惟虔。","协神备物，罔不吉蠲。","后祇格思，灵飙肃然。","诞受景福，遐哉亿年。","至哉柔祇，滋生蕃锡。","涤濯静嘉，寅恭夕惕。","金奏纯如，万舞有奕。","立我烝民，莫匪尔极。","博厚流形，秉阴成德。","柔顺利正，直方维则。","明祇格思，素汾之侧。","祗载吉蠲，宸心翼翼。","至哉物祖，设象隆脽。","动静之德，翕辟攸宜。","嘉栗以荐，精祷洪厘。","茂宣阴贶，五谷蕃滋。"],0,"x207","宋"],["祗奉天书六首 其一 奉香酌献用《瑞安》。","郊庙朝会歌辞","四言",["谓天盖高，惟皇合德。","倬彼灵章，图书是锡。","眷命谆谆，被以遐历。","膺箓告成，虔恭钦翼。"],0,"x207","宋"],["祭九鼎十二首 其一 帝鼐降神用《景安》。","郊庙朝会歌辞","四言",["日号丙丁，方号中央。","德惟其时，蠲吉是将。","夫何饮之，黄流玉瓒。","夫何食之，有陈伊馔。"],0,"x207","宋"],["大中祥符五岳加帝号祭告八首 其一 迎神用《静安》。","郊庙朝会歌辞","四言",["钟石既作，俎豆在前。","云旗飞扬，神光肃然。","当驾飙欻，来乎青圆。","言备缛礼，享兹吉蠲。"],0,"x207","宋"],["熙宁望祭岳镇海渎十七首 其一 东望迎神用《凝安》。","郊庙朝会歌辞","四言",["盛德惟木，勾芒御神。","沂岱淮海，厥功在民。","爰熙坛坎，裒对庶神。","于以歆格，灵贻具臻。"],0,"x207","宋"],null,null,null,null,["景德祭社稷三首 降神用《静安》。","郊庙朝会歌辞","四言",["百谷蕃滋，丽乎下土。","聿崇明祀，垂之千古。","育物惟茂，粒民斯普。","报本攸宜，国章咸睹。","于穆大祀，功利相宣。","灵坛美报，历代昭然。","介以蕃祉，祚以丰年。","土爰稼穑，允协民天。","制币牺齐，正辞无愧。","乐以送之，毕其精意。"],0,"x207","宋"],null,null,null,["熙宁祭风师五首 其一 迎神用《欣安》。","郊庙朝会歌辞","四言",["飘飖而来，淅沥而下。","爰张其旗，爰整其驾。","有豆有登，有兆有坛。","弭旌柅辀，降止且安。"],0,"x207","宋"],["大观祭风师六首 其一 降神用《欣安》。","郊庙朝会歌辞","四言",["羽旗云车，飘飖自天。","猗欤南箕，歆嘉升烟。","牲饩粢盛，俎簋铏笾。","维神戾止，从空泠然。"],0,"x207","宋"],["雨师雷神七首 其一 迎神用《欣安》。","郊庙朝会歌辞","四言",["众万之托，动之润之。","昭格孔时，维神之依。","泠然后先，肆我肯顾。","是耶非耶，纷其来下。"],0,"x207","宋"],["雍熙享先农六首馀同祈谷","郊庙朝会歌辞","四言",["先农播种，九谷务滋。","灵坛致享，良耜陈仪。","吉日惟亥，运属纯熙。","乐之作矣，神其格思。","亲耕展祀，明灵来格。","九有骏奔，百司庇职。","献奠肃肃，登降翼翼。","祈彼丰穰，福流万国。","肃陈韶舞，祗荐牺牲。","乃逆黄俎，以率躬耕。","祀惟古典，食乃民天。","歆兹洁祀，以应祈年。","式陈芳荐，爰致虔诚。","神其降鉴，永福黎氓。","明禋绀坛，灵风肃然。","登歌已阕，神驭将旋。","道光帝籍，礼备公田。","鉴兹躬稼，永赐丰年。"],0,"x207","宋"],["明道亲享先农十首 迎神用《静安》。","郊庙朝会歌辞","四言",["稼政之本，民食惟天。","甫田兆岁，后稷其先。","灵坛既祀，黛耜攸虔。","乃圣能享，亿万斯年。","冕服在御，坛壝有仪。","陟降左右，天惟显思。","将躬黛耜，先陟灵坛。","嘉玉量币，乐举礼殚。","神既至止，福亦和安。","千斯积咏，万国多欢。","将迎景福，乃荐嘉牲。","籍于千亩，用此精诚。","云罍已实，玉爵有舟。","荐于灵籍，伫乃神休。","神既至飨，福亦来酬。","申锡纯嘏，旨酒惟柔。","思文后稷，贻我来牟。","子孙千亿，丕荷天休。","羽葆有奕，文武交相。","周旋合度，福禄无疆。","豆笾虽荐，黍稷非馨。","惠我丰岁，歆兹至诚。","歆我嘉荐，锡我蕃禧。","多黍多稌，如京如坻。","献终豆彻，礼备乐成。","祠容肃肃，风驭冥冥。","三时务本，一垡躬耕。","人祇胥悦，祉福是膺。"],0,"x207","宋"],["景祐飨先农五首 其一 迎神用《凝安》。","郊庙朝会歌辞","四言",["在昔神农，首兹播殖。","无有污莱，尽为稼穑。","乃粒斯民，实惟帝力。","嘉荐令芳，伫瞻来格。"],0,"x207","宋"],["绍兴享先农十一首 皇帝入内壝盥洗用《隆安》。","郊庙朝会歌辞","四言",["大事在祀，齐洁为先。","既盥而升，奉以周旋。","下观而化，无敢不蠲。","惟神降格，监厥精虔。","猗欤田祖，粒食之宗。","世世仰德，青坛载崇。","时惟后稷，躬稼同功。","作配并祀，以诏无穷。","制为量币，厚意是将。","求之以类，各因其方。","于以奠之，精诚允彰。","神其享止，惠我无疆。","柔毛刚鬣，或剥或烹。","为俎孔硕，登荐厥诚。","蠲涤盏斝，巾帨而升。","挹彼注兹，酒醴维清。","洋洋在上，享于克诚。","神其孚佑，以厚民生。","羽毛干戚，张弛则殊。","进旅退旅，匪棘匪舒。","显相祀事，济济锵锵。","举斝酌醴，神其允臧。","殽核维旅，酒醴维馨。","于再于三，礼则有成。","幽明位异，施报理同。","克恭明神，降福乃丰。","我膺受之，来燕来崇。","岂伊专飨，于彼三农。","莫重于祭，非礼不成。","笾豆有践，尔殽既馨。","神具醉止，荐以齐明。","赞彻孔时，厘事斯成。","神之来止，风驶云翔。","神之旋归，有迎有将。","歌以送之，磬筦锵锵。","何以惠民，丰年穰穰。"],0,"x207","宋"],["亲耕藉田七首 其一 皇帝出大次用《干安》。","郊庙朝会歌辞","四言",["勤劳稼穑，必躬必亲。","为藉千亩，以教导民。","帝出乎震，时惟上春。","天颜咫尺，望之如云。"],0,"x207","宋"],["绍兴祀先农摄事七首 其一 迎神用《凝安》。","郊庙朝会歌辞","四言",["青阳开动，土膏脉起。","日练吉亥，为农祈祉。","典秩增峻，仪物具美。","幄光𤈶黄，庶几戾止。"],0,"x207","宋"],["祀先蚕六首 其一 迎神用《明安》。","郊庙朝会歌辞","四言",["功被寰宇，㒩虫之灵。","有神司之，以生以成。","典礼有初，祀事讲明。","孔盖翠旌，降集于庭。"],0,"x207","宋"],["景德蜡祭百神三首 降神用《高安》。","郊庙朝会歌辞","四言",["百物蕃阜，四方顺成。","通其八蜡，合乃嘉平。","旨酒斯醇，大庖孔盈。","万灵来格，威仪以成。","肃肃灵坛，昭昭上天。","洁粢丰盛，以享以虔。","百神咸萃，六乐斯县。","介兹景福，期于有年。","来顾来享，礼成乐备。","灵驭翩翩，云行雨施。"],0,"x207","宋"],["熙宁蜡祭十三首 其一 东西郊降神用《高安》。","郊庙朝会歌辞","四言",["天锡康年，四方顺成。","乃通蜡祭，索享于明。","金石四作，羽旄翠旌。","神来宴娭，泽被群生。"],0,"x207","宋"],["大观蜡祭二首 其一 东郊亚、终献用《庆安》。","郊庙朝会歌辞","四言",["震乘春阳，仁司生殖。","锡我岁丰，襄我民力。","谁其尸之，宗子先啬。","亿万斯年，怀神罔极。"],0,"x207","宋"],null,null,["大观三年释奠六首 其一 迎神用《凝安》。","郊庙朝会歌辞","四言",["仰之弥高，钻之弥坚。","于昭斯文，被于万年。","峨峨胶庠，神其来止。","思款无穷，敢忘于始。"],0,"x207","宋"],null,["景祐释奠武成王六首 其一 迎神用《凝安》。","郊庙朝会歌辞","四言",["维师尚父，四履分封。","灵神峻密，祀事寅恭。","萧芗祗荐，飙驭排空。","如几如式，福禄来崇。"],0,"x207","宋"],["绍兴释奠武成王七首 其一 迎神用《凝安》，姑洗为宫。","郊庙朝会歌辞","四言",["于赫烈武，光昭古今。","载严祀事，敕备惟钦。","既洁其牲，既谐其音。","神之格思，来顾来歆。"],0,"x207","宋"],["司中司命五首 其一 迎神用《欣安》。","郊庙朝会歌辞","四言",["冠峨峨兮，服章蕤蕤。","灵来下兮，进止委蛇。","我涓我坛，我洁我俎。","降舆却旌，于兹享御。"],0,"x207","宋"],["五龙六首 其一 迎神用《禧安》。","郊庙朝会歌辞","四言",["灵之智兮，跃汉潜幽。","欲豢扰兮，无董与刘。","陈金石兮，佐侑牢羞。","庶燕享兮，泽应民求。"],0,"x207","宋"],["建隆干德朝会乐章二十八首 其一 上寿用《禧安》。","郊庙朝会歌辞","四言",["干健为君，坤柔曰臣。","惟其臣子，克奉君亲。","永御皇极，以绥兆民。","称觞献寿，山岳嶙峋。"],0,"x207","宋"],["淳化中朝会二十三首 其一 上寿用《和安》。","郊庙朝会歌辞","四言",["四序伊始，三阳肇开。","条风入律，玉琯飞灰。","望云肃谒，鸣佩斯来。","称觞献寿，瞻拱星回。"],0,"x207","宋"],null,["熙宁中朝会三首 其一 皇帝初举酒用《庆云》。","郊庙朝会歌辞","四言",["乾坤顺夷，皇有嘉德。","爰施庆云，承日五色。","轮囷下乘，万物皆饰。","惟天祚休，长彼无极。"],0,"x207","宋"],["元符大朝会三首 其一 皇帝初举酒用《灵芝》。","郊庙朝会歌辞","四言",["嘉瑞降临，应我皇德。","烨烨神芝，不根而植。","春秋三秀，昼夜一色。","物播诗歌，声被金石。"],0,"x207","宋"],null,["绍兴朝会十三首 其一 群臣酒行用《正安》。","郊庙朝会歌辞","四言",["群公卿士，咸造在庭。","式燕以衎，思均露零。","穆穆明明，于斯为盛。","归美报上，一人有庆。"],0,"x207","宋"],null,null,["咸平藉田回仗御楼二首 其一 《采茨》。","郊庙朝会歌辞","四言",["农皇既祀，礼毕躬耕。","商辂旋轸，周颂腾声。","观魏将陟，服御爰更。","舆人瞻仰，如日之明。"],0,"x207","宋"],["干兴御楼二首 其一 升坐用《隆安》。","郊庙朝会歌辞","四言",["夹钟纪月，初吉在辰。","眚灾流庆，布德推仁。","采章震耀，典礼具陈。","茂昭丕贶，永庇斯民。"],0,"x207","宋"],["绍兴登门肆赦二首 其一 升坐用《干安》。","郊庙朝会歌辞","四言",["拜况于郊，皇哉唐哉。","熙事休成，六𬴂鼎来。","天阃以决，地垠以开。","𬯎祉发祥，如登春台。"],0,"x207","宋"],["宁宗登门肆赦二首 其一 升坐用《干安》。","郊庙朝会歌辞","四言",["帝飨于郊，荷天之休。","五福敷锡，皇明烛幽。","云行雨施，仁翔德游。","圣人多男，歌颂九州。"],0,"x207","宋"],["明道元年章献明肃皇太后朝会十五首 其一 群臣酒行用《礼安》。","郊庙朝会歌辞","四言",["肃肃临下，有威有容。","循循事上，惟信惟忠。","盛礼兴乐，示慈训恭。","君臣协吉，惟道之从。"],0,"x207","宋"],["明道元年章献明肃皇太后朝会十五首 其一 酒一行毕作《厚德无疆之舞》。","郊庙朝会歌辞","四言",["尧母之圣，放勋为子。","同心协谋，柔远能迩。","以德康俗，以文兴治。","斯焉象功，罔不昭济。"],0,"x207","宋"],["明道元年章献明肃皇太后朝会十五首 其一 酒再行作《四海会同之舞》。","郊庙朝会歌辞","四言",["七德之舞，四朝用康。","有如姬姒，助集周邦。","威克厥爱，居安不忘。","风旋山立，济济皇皇。"],0,"x207","宋"],["治平皇太后皇后册宝三首 其一 皇帝升坐用《干安》。","郊庙朝会歌辞","四言",["王化之始，治繇内孚。","时庸作命，玉简金书。","磬筦在庭，其纵绎如。","天临法扆，礼与诚俱。"],0,"x207","宋"],["熙宁皇太后册宝三首 其一 出入用《正安》。","郊庙朝会歌辞","四言",["煌煌凤字，玉气宛延。","天门崛岉，飞骖后先。","龙簨四合，奏鼓渊渊。","母仪天下，何千万年。"],0,"x207","宋"],["哲宗上太皇太后册宝五首 其一 皇帝升坐用《干安》。","郊庙朝会歌辞","四言",["大矣孝熙，帅民以躬。","奉承宝册，钦明两宫。","万乐具举，一人肃雍。","化繇上始，四海来同。"],0,"x207","宋"],null,["淳熙二年发太上皇帝太上皇后册宝十一首 其一 册宝降殿用《正安》。","郊庙朝会歌辞","四言",["高明者干，博厚者坤。","以清以宁，资始资生。","寿胡可度，德胡可评。","愿言从欲，诞受强名。"],0,"x207","宋"],null,null,null,null,["绍定三年寿明仁福慈睿皇太后册宝九首 其一","郊庙朝会歌辞","四言",["思齐圣母，媲于周任。","体干履坤，博厚洪深。","七帙既启，万寿自今。","昕庭发号，式昭德音。"],0,"x207","宋"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["御楼","郊庙朝会歌辞","四言",["五辂鸣鸾，八神警跸。","天官景从，莫不祗栗。","祲威盛容，昭哉祖述。","祚我无疆，叶气充溢。","青坛帝籍，在国之东。","荐笾执耜，率礼和容。","鸣鸾回跸，瑞气凝空。","万方瞻仰，百顺来同。","重城春满，双阙云浮。","将披雉扇，载俨珠旒。","叶风应律，文德怀柔。","溥天率土，惠泽咸周。","恩覃春煦，令布风驰。","声名昭晰，文物葳蕤。","重森宝扇，将降端闱。","永光国典，翕受天祺。"],0,"x207","宋"],null,null,["采菊","黄庭坚","四言",["南山有菊，于采其英。","谁从汝往，视我茕茕。","伊时之人，谁适有比。","不与我谋，不知其已。","薄言采之，遵彼山曲。","汝来迟迟，去我何速。","伊时之人，谁适与同。","不与我好，殆其觏凶。","江汉滔滔，有楫有杭。","谁以济此，中流且风。","嗟尔君子，时处时默。","微云反复，无伤尔足。"],0,"x66","宋"],["流水","黄庭坚","四言",["一溪之水，可涉而航。","人不我直，我犹力行。","一溪之水，不杠而涉。","濡首中流，汝嗟何及。","汤汤流水，可以休兮。","嗟行之人，则濯足兮。"],0,"x66","宋"],["种药苗二首 其一 种罂粟","苏辙","四言",["筑室城西，中有图书。","窗户之馀，松竹扶疏。","拔棘开畦，以毓嘉蔬。","畦夫告予，罂粟可储。","罂小如罂，粟细如粟。","与麦皆种，与穄皆熟。","苗堪春菜，实比秋谷。","研作牛乳，烹为佛粥。","老人气衰，饮食无几。","食肉不消，食菜寡味。","柳槌石钵，煎以蜜水。","便口利喉，调养肺胃。","三年杜门，莫适往还。","幽人衲僧，相对忘言。","饮之一杯，失笑欣然。","我来颍川，如游庐山。"],0,"x135","宋"],["种药苗二首 其二 种决明","苏辙","四言",["闲居九年，禄不代耕。","肉食不足，藜烝藿羹。","多求异蔬，以佐晨烹。","秋种罂粟，春种决明。","决明明目，功见本草。","食其花叶，亦去热恼。","有能益人，矧可以饱。","三嗅不食，笑杜陵老。","老人平生，以书为累。","夜灯照帷，未晓而起。","百骸未病，两目告瘁。","决明虽良，何补于是。","自我知非，卷去图书。","闭目内观，妙见自如。","闻阿那律，无目而视。","决明何为，适口乎尔。"],0,"x135","宋"],null,null,null,null,["题石民瞻兰石邓觉非画兰","龚璛","四言",["石子画石，积墨如山。","化为邓林，兰生竹间。","我怀古人，见此粲者。","草木臭味，日月潇洒。"],0,218,"宋"],["题李伯时三教图卷 其一","李纲","四言",["祖师西来，亿劫谁伍。","眷焉摩尼，烛此下土。","沧海津梁，脱离幽苦，至哉流宗，以振聋瞽。"],0,"x136","宋"],null,null,["盘居六章","项安世","四言",["宝峰之阴，其山深深。","有美一人，琼弁玉簪。","云居之阳，其水洋洋。","有美一人，霞衣月裳。","山之纡纡，密云所庐。","彼盘之人，亦丰厥储。","山之营营，众流所经。","彼盘之人，亦溥厥成。","渐以中上，屯以正行。","匪盘之异，惟物之情。","行止盘盘，其乐孔多。","请以是居，子如之何。"],0,"x55","宋"],null,null,["政和二年余谪海外馆琼州开元寺俨师院遇其游行市井宴坐静室作务时恐缘差失念作日用偈八首","惠洪","四言",["一切境界，病眼倒见。","但静意根，空慧自现。","一切境界，随念而至。","念未生时，髑髅是水。","道人何故，淫坊酒肆。","我自调心，非干汝事。","一日不作，一日不食。","谁其嗣之，我有遗则。","折脚铛子，随处安置。","食无精粗，但欲接气。","心欲驰散，即当摄来。","大火聚中，青莲花开。","此障道法，上品盖缠。","是何时节，乃复安眠。","沙弥嗜乳，作乳中虫。","三篾高道，一钵孤风。"],0,"x42","宋"],["永明禅师真赞二首","惠洪","四言",["三界种性，有万妍丑。","生顺死逆，梦夜想昼。","往复无间，声度垣牖。","皆依末那，戏论成就。","而末那体，无作无受。","譬如空花，实无而有。","一念了知，光明通透。","我如是见，无有错谬。","是为心宗，祖佛授手。","孰振颓纲，秀杰奇茂。","稽首永明，月临星斗。","以公风神，为我律度。","交神见之，是真保护。"],0,"x42","宋"],null,null,null,null,["赤城六章章四句","释居简","四言",["赤城峨峨，霞摽错摩。","笃生斯人，绝超凡科。","峨峨赤城，磅礴九地。","斯人笃生，水瘦石悴。","念昔三辅，湖独纷委。","逮公来斯，苕霅泾渭。","千里寿公，祷公寿康。","惠洽兆庶，日飞百觞。","伊我无酒，注彼觓兕。","愿公华衮，式昌厥嗣。","亦复愿公，啸吟紫微。","㑭我紫微，嬉其莞而。"],0,"x94","宋"],null,null,["缘识 其二十六","赵炅","四言",["具蹄凡夫，何行何著。","静锁天台，高知嵩岳。","拘束迷情，人天离乐。","圣境芝兰，名山采药。","啖柏餐松，清神去浊。","入口馨香，风和露嚼。","可以放旷，千年之鹤。","审取来由，勿自系缚。","洞有桃源，化成云阁。","上有凤皇，下水鱼跃。","本从自然，岂用图度。"],0,"x63","宋"],["缘识 其三十七","赵炅","四言",["忙即但忙，闲即便闲。","无为之见，与道相关。","言虽鄙俚，勿生谤毁。","利他何疑，嗔乃兴喜。","善恶万端，古今如此。","非善称君，非过称己。","道大幽玄，世使如然。","君临宇宙，辅弼须贤。","求之不见，形表影连。","论而非细，我惭知愧。","救世心劳，方便之智。","短又何难，长又何易。","真实语言，勿将为戏。"],0,"x63","宋"],["寿马裕斋观文 山之高，三章，章四句。","陈著","四言",["天作高山，大邦之屏。","外御其侮，王国庶定。","维石岩岩，维德之基。","天实为之，是以似之。","人亦有言，如山之寿。","万有千岁，保艾尔后。"],0,"x92","宋"],["寿马裕斋观文 东山，二章，章四句。","陈著","四言",["我徂东山，以敖以游。","彼采葛兮，谓我何求。","凤凰于飞，出自幽谷。","载好其音，集于灌木。"],0,"x92","宋"],["寿马裕斋观文 有鹤，三章，章四句。","陈著","四言",["有鹤在林，怀之好音。","载飞载止，食野之芩。","倡予和汝，爰得我所。","何斯违斯，自贻伊阻。","陟彼崔嵬，岂不怀归。","英英白云，跂予望之。"],0,"x92","宋"],["寿马裕斋观文 江之永，三章，章四句。","陈著","四言",["江之永矣，其流汤汤。","整我六师，告成于王。","春日载阳，薄言采芑。","泳之游之，民之洽矣。","清且沦漪，有美一人。","怀哉怀哉，率土之滨。"],0,"x92","宋"],null,null,null,["南有刺","曾丰","四言",["南有刺蓐，又有刺竹。","有刺竹矣，无刺蓐矣。","彼竹何族，有刺如簇。","蹴之者瘃，天委彼酷。","谁使尔蹴，尔瘃谁讟。","达者蹈足，恚者仄目。","斧斤俶俶，自贻伊蝮。","天道好复，况利于竹。","南有刺竹，又有刺木。","有刺木矣，无刺竹矣。","彼木何族，有刺如簇。","触之者衄，天委彼酷。","谁使尔触，尔衄谁讟。","达者鼓腹，歜者裂肉。","斧斤畟畟，自贻伊毒。","天道好复，况利于木。"],0,"x193","宋"],["公迈何遄","曾丰","四言",["公之西矣，蜀人是谣，都人是嚣。","诏予华衮，亟哉来朝。","彩熊既税，彩鹢既发。","月逗岁遛，竣其未达。","都人曰嘻，吾国君师。","欲猷欲为，未得良毗。","公归何迟。","公之东矣，蜀人是恋，潭人是羡。","诏予油幢，亟哉往殿。","列城既倾，列骑既迎。","日裴月徊，倘其未行。","潭人曰喔，吾家耋孺。","不襦不裤，莫能略顾。","公来何暮。","公之南矣，潭人是怀，洪人是留。","议夺朱幡，亟哉还休。","御者既靷，饯者既挽。","俄驰顷驱，僄其未返。","洪人曰嘕，吾土山川。","有真有仙，可伴长年。","公迈何遄。"],0,"x193","宋"],["彼莲之美","曾丰","四言",["彼莲之美，心乎爱矣。","所爱与直，渊乎其似。","厥根玲珑，庶乎屡空。","厥干洞然，同乎大通。","厥华尚赤，故为火德。","厥德靡常，虚室生白。","受知濂溪，爱莫助之。","邹子知之，久而敬之。"],0,"x193","宋"],["丞相二章","梅尧臣","四言",["丞相之拜，冠弁旅至。","乘马载驱，如彼钜潴。","有雁有鹜，有龟有鱼。","烝然来萃，翔泳啸呼。","丞相之去，乃还印绶。","乃饬车轮，如彼涸津。","时靡翔羽，时靡游鳞。","寂兮寂兮，岂有嘉宾。"],0,"x65","宋"],["答傅钦之","邵雍","四言",["芝兰在室，不能无臭。","金石振地，不能无声。","恶则哀之，哀而不伤。","善则乐之，乐而不淫。"],0,"x57","宋"],["王公吟","邵雍","四言",["王公大人，天下具瞻；","轻流薄习，重损威严。","此尚未了，彼安能兼。","非唯失道，又复起贪。","顶戴儒冠，心存象教。","本图心宁，复使心闹。","譬如生子，当求克肖。","不教义方，教之窃盗。"],0,"x57","宋"],["去事吟","邵雍","四言",["君子去事，民有馀祥。","小人去事，民有馀殃。"],0,"x57","宋"],["偶书 其四","邵雍","四言",["才高命寡，耻居人下。","若不固穷，非知道者。"],0,"x57","宋"],["善恶吟 其一","邵雍","四言",["瞽鲧有子，尧舜无嗣。","馀庆馀殃，何故如是。"],0,"x57","宋"],null,["善恶吟","邵雍","四言",["瞽鲧有子，尧舜无嗣。","馀庆馀殃，何故如是。","尧舜无子，瞽鲧有嗣。","福善祸淫，何故如此。"],0,"x57","宋"],["水旱吟","邵雍","四言",["尧水九年，汤旱七载。","调燮之功，此时安在。","九年洪水，七年大旱。","非尧与汤，民死过半。"],0,"x57","宋"],null,["戏作墨竹二本赠鹤林因为之赞 风筠","白玉蟾","四言",["新梢凝翠，落照馀红。","乱鸦噪罢，叶叶清风。","一枝嫩绿，数叶老苍。","夜半月明，清露瀼瀼。"],0,"x77","宋"],["和君时","彭汝砺","四言",["猗彼君子，笃志乎道。","道之云远，于焉慥慥。","猗彼君子，克诚其身。","匪禄是荣，日以养亲。","孰违孰从，曰吾从义。","孰去孰与，曰吾由礼。","温凊匪偕，云如之何。","得彼失兹，得失孰多。","吾斯未信，吾颜之厚。","重轻惟法，于尔何有。","尔旋尔车，不知其期。","我陟其冈，祇益我思。","凡人逐物，其力则倍。","苟知其养，是用无悔。","无悔无尤，是则养亲。","尔慎旃哉，以慰母心。","为山一篑，惧乎或止。","道之云远，曷云其已。","我田我田，以迟尔归。","何速于行，姑乐我私。"],0,"x143","宋"],["寄君时","彭汝砺","四言",["我思古人，克诚其心。","如陟于高，如临于深。","我处于中，而舍其偏。","我弃其零，而取其全。","勿谓道远，我至之难。","我勇以前，人孰我先。","勿谓过小，我姑为之。","千里之差，始于毫厘。","勇兮勇兮，子我所器。","子诚不已，我今所畏。","子能吾取，吾谁之匿。","子铭于盘，以视朝夕。"],0,"x143","宋"],["寄君时","彭汝砺","四言",["我灌我园，有采之心。","于以撷之，既有且多。","我游我庭，有菊之苗。","于以芼之，既旨且时。","我思昔人，亦采其薇。","我乐所安，奚愠其微。","仲兮仲兮，曷日汝偕。","以事以游，以慰予怀。"],0,"x143","宋"],["古怨诗 其一","刘敞","四言",["鸿雁飞矣，邕邕其族。","孰是人斯，茕茕其独。"],0,"x51","宋"],["古怨诗 其二","刘敞","四言",["鸿雁飞矣，或群或伍。","孰是人斯，茕茕其处。"],0,"x51","宋"],["魏京诗","刘敞","四言",["皇作大都，大都雄雄。","奄定北国，四方来同。","皇曰卿士，在昔圣考。","祗遹文武，维慈幼老。","天监在上，既有明德。","乃命于下，罔有不服。","匪允命之，亦章庆之。","匪允服之，亦保育之。","时维猃狁，侮予之疆。","靡度靡虞，跳呼以狂。","业业烝黎，载震载惊。","侵魏及澶，群心不宁。","帝奋厥武，百万其士。","匪怒以棘，于三千里。","如虎如貔，如霆如雷。","靡有远迩，天子其来。","天子来止，士增其喜。","孰偷其生，以不奋兴。","驱之浑浑，攘之贲贲。","靡有辀张，歼厥鲸鲲。","或献其宝，或请其命。","帝振于旅，惟时既定。","既閟尔弓，既櫜尔矛。","猃狁臣止，四方是休。","皇曰卿士，圣考之德。","允于孝思，孝思惟则。","尔视京魏，以作我都。","以赫厥灵，俾后勿逾。","皇曰卿士，惟帝时功。","时亦惟人，惟寇莱公。","尔慎尔止，弼予于治。","期尔前人，用迪尔事。","皇曰卿士，惟帝作武。","垂是万年，莫敢予侮。","泰山之封，后土之禅。","予监若兹，惟天是眷。","翼翼之土，天子国之。","穆穆原庙，圣人则之。","孰为强暴，敢不来觐。","俾怛于威，于忠是训。","显显天子，孝德自躬。","率是休烈，覃之北戎。","河水东注，昭哉禹绩。","时万斯年，天子之德。"],0,"x51","宋"],["古怨诗","刘敞","四言",["鸿雁飞矣，邕邕其族。","孰是人斯，茕茕其独。","鸿雁飞矣，或群或伍。","孰是人斯，茕茕其处。","天兮地兮，戴且履兮。","孰是人斯，莫我视兮。","日兮月兮，出兮没兮。","孰是人斯，远我忽兮。"],0,"x51","宋"],["四皓歌","刘敞","四言",["与汝携手，南山之阿。","富贵多忧，孰知其他。","大风横厉，江海荡波。","嗟汝鳞介，伤如之何。","高岩有薇，深谷有芝。","人生实难，委曲何为。"],0,"x51","宋"],null,null,["题猿石手卷二首","陆文圭","四言",["空山暮雨，枯木晓霜。","此处闻声，若为断肠。","楚山无人，群戏树颠。","或据大石，如君长然。"],0,"x149","宋"],null,null,null,["韩忠献北道京邑二帖赞","岳珂","四言",["扶桑擎日，厥干万尺，以为公笔。","天寿平格，元圭昭锡，以为公墨。","阴阳阖辟，鳌柱立极，见此伟特。","太山绝壁，九河碣石，莫动笔力。","有云五色，曾著瑞籍，多士辟易。","繄天实启，岂以诩饰，如彼韦陟。","公骑鹏翼，归侍帝侧，有是遗迹。","荣光交射，星月珠璧，终古不忒。","维珂之得，再拜叹息，坱圠孰测。","几几赤舄，尚想公德，永镇下国。"],0,"x202","宋"]]