[["苏小小歌","佚名","隋",["妾乘油壁车，郎骑青骢马。","何处结同心，西陵松柏下。"],{"ad":"隋"},"x239","隋"],["广平百姓为李波小妹语","佚名","隋",["李波小妹字雍容。","褰裙逐马如卷蓬。","左射右射必叠双。","妇女尚如此。","男子那可逢。"],{"ad":"隋"},"x239","隋"],["送别诗","佚名","隋",["杨柳青青著地垂，杨花漫漫搅天飞。","柳条折尽花飞尽，借问行人归不归。"],{"ad":"隋"},"x239","隋"],["炀帝幸江南时闻民歌","佚名","隋",["我儿征辽东，饿死青山下。","今我挽龙舟，又困随堤道。","方今天下饥，路粮无些小。","前去三千程，此身安可保。","寒骨枕荒沙，幽魂泣烟草。","悲损门内妻，望断吾家老。","安得义男儿，焚此无主尸。","引其孤魂回，负其白骨归。"],{"ad":"隋"},"x239","隋"],["乌夜啼 其二","佚名","隋",["长樯铁鹿子，布帆阿那起。","诧侬安在间，一去数千里。"],{"ad":"隋"},"x239","隋"],["时人为檀道济歌","佚名","隋",["可怜白浮鸠。","枉杀檀江州。"],{"ad":"隋"},"x239","隋"],["时人为檀道济歌","佚名","隋",["生人作死别，荼毒当奈何。"],{"ad":"隋"},"x239","隋"],["读曲歌","佚名","隋",["死罪刘领军，误杀刘第四。"],{"ad":"隋"},"x239","隋"],["刘敬叔引诗","佚名","隋",["鸡山别飞响，雉涧和清音。"],{"ad":"隋"},"x239","隋"],["民间为谢灵运谣","佚名","隋",["四人挈衣裙，三人捉坐席。"],{"ad":"隋"},"x239","隋"],["元嘉中魏地童谣","佚名","隋",["轺车北来如穿雉。","不意虏马饮江水。","虏主北归石济死。","虏欲渡江天不徙。"],{"ad":"隋"},"x239","隋"],["臧质引童谣","佚名","隋",["虏马渡江水，佛狸死卯年。"],{"ad":"隋"},"x239","隋"],["元嘉末童谣","佚名","隋",["钱唐出天子。"],{"ad":"隋"},"x239","隋"],["民间为奚显度谣","佚名","隋",["宁得建康压额。","不能受奚度拍。"],{"ad":"隋"},"x239","隋"],["泰始中童谣","佚名","隋",["东城出天子。"],{"ad":"隋"},"x239","隋"],["永光初谣言","佚名","隋",["湘州出天子。"],{"ad":"隋"},"x239","隋"],["元徽中童谣","佚名","隋",["襄阳白铜蹄。","郎杀荆州儿。"],{"ad":"隋"},"x239","隋"],["东阳为释慧约谣","佚名","隋",["少达妙理娄居士。"],{"ad":"隋"},"x239","隋"],["时人为刘劭刘骏语","佚名","隋",["遥望建康城，江水逆流萦。","前见子杀父，后见弟杀兄。"],{"ad":"隋"},"x239","隋"],["麦城俗谚","佚名","隋",["东驴西磨。","麦城自破。"],{"ad":"隋"},"x239","隋"],["颜延之引谚","佚名","隋",["富则盛。","贫则病。"],{"ad":"隋"},"x239","隋"],["清溪谚","佚名","隋",["扬州青。","是鬼营。"],{"ad":"隋"},"x239","隋"],["释慧通引谚","佚名","隋",["指南为北，自谓不惑。","指西为东，自谓不蒙。"],{"ad":"隋"},"x239","隋"],["时人为丁旿语","佚名","隋",["勿跋扈。","付丁旿。"],{"ad":"隋"},"x239","隋"],["南豫州军士为王玄谟宗越语","佚名","隋",["宁作五年徒，不逢王玄谟。","玄谟犹尚可，宗越更杀我。"],{"ad":"隋"},"x239","隋"],["鼓山俗语","佚名","隋",["南彭北鼓。","相去十五。"],{"ad":"隋"},"x239","隋"],["京邑为何勖孟灵休语","佚名","隋",["安成食。","临汝饰。"],{"ad":"隋"},"x239","隋"],["时人为王延之王僧虔语","佚名","隋",["二王居平。","不送不迎。"],{"ad":"隋"},"x239","隋"],["京师为东安斗场二寺僧语","佚名","隋",["斗场禅师窟，东安谈义林。"],{"ad":"隋"},"x239","隋"],["时人为胡母颢语","佚名","隋",["禾绢闭眼诺。","胡母大张橐。"],{"ad":"隋"},"x239","隋"],["百姓为袁粲褚彦回语","佚名","隋",["可怜石头城。","宁为袁粲死。","不作褚渊生。"],{"ad":"隋"},"x239","隋"],["齐宋以来民间语","佚名","隋",["扰攘建武上。"],{"ad":"隋"},"x239","隋"],["时人评八僧语","佚名","隋",["生睿发天真，严观洼流得。","慧义彭亨进，寇渊千默塞。"],{"ad":"隋"},"x239","隋"],["时人为释道经慧静语","佚名","隋",["洛下长大耳，东阿黑如墨。","有问无不酬，有酬无不塞。"],{"ad":"隋"},"x239","隋"],["碧玉歌 其一","佚名","隋",["碧玉破瓜时，郎为情颠倒。","芙蓉陵霜荣，秋容故尚好。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其二","佚名","隋",["闻欢大养蚕，定得几许丝。","所得何足言，奈何黑瘦为。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其三","佚名","隋",["夜相思。","投壶不得箭。","忆欢作娇时。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其四","佚名","隋",["开门枕水渚。","三刀治一鱼。","历乱伤杀汝。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其五","佚名","隋",["未敢便相许。","夜闻侬家论。","不持侬与汝。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其六","佚名","隋",["懊恼不堪止。","上床解要绳。","自经屏风里。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其八","佚名","隋",["将懊恼。","石阙昼夜题。","碑泪常不燥。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其九","佚名","隋",["别后常相思。","顿书千丈阙。","题碑无罢时。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十","佚名","隋",["奈何许。","所欢不在间。","娇笑向谁绪。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十一","佚名","隋",["隔津欢。","牵牛语织女。","离泪溢河汉。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十二","佚名","隋",["啼相忆。","泪如漏刻水。","昼夜流不息。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十三","佚名","隋",["著处多遇罗。","的的往年少。","艳情何能多。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十四","佚名","隋",["无故相然我。","路绝行人断。","夜夜故望汝。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十五","佚名","隋",["一坐复一起。","黄昏人定后。","许时不来已。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十六","佚名","隋",["摩可浓。","巷巷相罗截。","终当不置汝。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十七","佚名","隋",["不能久长离。","中夜忆欢时。","抱被空中啼。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十八","佚名","隋",["腹中如汤灌。","肝肠寸寸断。","教侬底聊赖。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十九","佚名","隋",["相送劳劳渚。","长江不应满。","是侬泪成许。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其二十一","佚名","隋",["郎情难可道。","欢行豆挟心。","见荻多欲绕。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其二十二","佚名","隋",["松上萝。","愿君如行云。","时时见经过。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其二十三","佚名","隋",["夜相思。","风吹窗帘动。","言是所欢来。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其二十四","佚名","隋",["长鸣鸡。","谁知侬念汝。","独向空中啼。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其二十五","佚名","隋",["腹中如乱丝。","愦愦适得去。","愁毒已复来。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其一","佚名","隋",["花钗芙蓉髻，双鬓如浮云。","春风不知著，好来动罗裙。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其二","佚名","隋",["念子情难有。","已恶动罗裙。","斩侬入怀不。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三","佚名","隋",["红蓝与芙蓉，我色与欢敌。","莫案石榴花，历乱听侬摘。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四","佚名","隋",["千叶红芙蓉，照灼绿水边。","馀花任郎摘，慎莫罢侬连。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其五","佚名","隋",["思欢久。","不爱独枝莲。","只惜同心藕。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其六","佚名","隋",["打坏木栖床，谁能坐相思。","三更书石阙，忆子夜啼碑。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其七","佚名","隋",["奈何不可言。","朝看莫牛迹。","知是宿蹄痕。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其八","佚名","隋",["娑拖何处归，道逢播掿郎。","口朱脱去尽，花钗复低昂。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其九","佚名","隋",["所欢子。","莲从胸上度。","刺忆庭欲死。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其十","佚名","隋",["揽裳踱。","跣把丝织履。","故交白足露。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其十一","佚名","隋",["上知所。","所欢不见怜。","憎状从前度。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其十二","佚名","隋",["思难忍。","络罂语犹壶。","倒写侬顿尽。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其十三","佚名","隋",["上树摘桐花，何悟枝枯燥。","迢迢空中落，遂为梧子道。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其十七","佚名","隋",["縠衫两袖裂，花钗鬓边低。","何处分别归，西上古馀啼。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其十八","佚名","隋",["所欢子。","不与他人别。","啼是忆郎耳。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其十九","佚名","隋",["披被树明灯，独思谁能忍。","欲知长寒夜，兰灯倾壶尽。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其二十","佚名","隋",["坐起叹汝好。","愿他甘丛香。","倾筐入怀抱。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其二十二","佚名","隋",["忆欢不能食。","徘徊三路间。","因风觅消息。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其二十三","佚名","隋",["朝日光景开，从君良燕游。","愿如卜者策，长与千岁龟。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其二十四","佚名","隋",["所欢子。","问春花可怜。","括插袮裆里。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其二十五","佚名","隋",["芳萱初生时，知是无忧草。","双眉画未成，那能就郎抱。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其二十六","佚名","隋",["百花鲜。","谁能怀春日。","独入罗帐眠。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其二十七","佚名","隋",["闻欢得新侬。","四支懊如垂。","鸟散放行路。","井中百翅不能飞。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其二十八","佚名","隋",["怜欢敢唤名，念欢不呼字。","连唤欢复欢，两誓不相弃。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十","佚名","隋",["白门前。","乌帽白帽来。","白帽郎是侬。","良不知乌帽郎是谁。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十一","佚名","隋",["初阳正二月，草木郁青青。","蹑履步前园，时物感人情。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十二","佚名","隋",["青幡起御路，绿柳荫驰道。","欢赠玉树筝，侬送千金宝。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十三","佚名","隋",["桃花落已尽，秋思犹未央。","春风难期信，托情明月光。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十四","佚名","隋",["计约黄昏后，人断犹未来。","闻欢开方局，已复将谁期。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十五","佚名","隋",["自从别郎后，卧宿头不举。","飞龙落药店，骨出只为汝。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十六","佚名","隋",["日光没已尽，宿鸟纵横飞。","徙倚望行云，躞蹀待郎归。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十七","佚名","隋",["百度不一回，千书信不归。","春风吹杨柳，华艳空徘徊。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十八","佚名","隋",["音信阔弦朔，方悟千里遥。","朝霜语白日，知我为欢消。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十九","佚名","隋",["合冥过藩来，向晓开门去。","欢取身上好，不为侬作虑。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四十","佚名","隋",["五鼓起开门，正见欢子度。","何处宿行还，衣被有霜露。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四十一","佚名","隋",["本自无此意，谁交郎举前。","视侬转迈迈，不复来时言。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四十二","佚名","隋",["自我别欢后，叹音不绝响。","茱萸持捻泥，龛有杀子像。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四十三","佚名","隋",["家贫近店肆，出入引长事。","郎君不浮华，谁能呈实意。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四十四","佚名","隋",["念日行不遇，道逢播掿郎。","查灭衣服坏，白肉亦黯疮。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四十五","佚名","隋",["歔欷暗中啼，斜日照帐里。","无油何所苦，但使天明尔。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四十六","佚名","隋",["黄丝咡素琴，泛弹弦不断。","百弄任郎作，唯莫广陵散。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四十八","佚名","隋",["诈我不出门，冥就他侬宿。","鹿转方相头，丁倒欺人目。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四十九","佚名","隋",["欢但且还去，遗信相参伺。","契儿向高店，须臾侬自来。"],{"ad":"隋"},"x239","隋"]]