[["淳熙二年发太上皇帝太上皇后册宝十一首 其五 册宝入德寿宫门用《正安》。","郊庙朝会歌辞","四言",["惟天为大，其德曰诚。","惟尧则之，其性曰仁。","乃文乃武，得寿得名。","于万斯年，以莫不增。"],0,"x207","宋"],["景祐飨先农五首 其五 送神用《凝安》。","郊庙朝会歌辞","四言",["务啬之本，恤祀惟馨。","神斯至止，降福攸宁。","崇兹稼政，合于礼经。","俎彻乐阕，邈仰回灵。"],0,"x207","宋"],["景祐常祀二首 其二 酌献用《英安》。","郊庙朝会歌辞","四言",["诞受灵符，肇基丕业。","配享洁尊，永隆万叶。"],0,"x207","宋"],["嘉祐祫享二首 其二 送神用《怀安》。","郊庙朝会歌辞","四言",["灵神归止，光景肃然。","福祥裕世，明威在天。","孝孙有庆，骏烈推先。","佑兹基绪，弥万斯年。"],0,"x207","宋"],["梁溪真赞","李纲","四言",["是为梁溪，了无差别。","行年之化，三十有八。","返观其前，肤腴色悦。","从是以往，苍颜华发。","本来面目，不生不灭。","游戏仕涂，天付之拙。","顺天而行，一无敢设。","独知其天，宁有他诀。","万里清风，一轮明月。","有来问者，默然无说。"],0,"x136","宋"],["景德祭社稷三首 其一 降神用《静安》。","郊庙朝会歌辞","四言",["百谷蕃滋，丽乎下土。","聿崇明祀，垂之千古。","育物惟茂，粒民斯普。","报本攸宜，国章咸睹。"],0,"x207","宋"],["乾道别庙乐歌三首 其二 升殿用《干安》。","郊庙朝会歌辞","四言",["宗祀九筵，先荐閟宫。","陟自东阶，煌煌衮龙。","于穆圣善，监兹礼容。","是享是宜，介福无穷。"],0,"x207","宋"],["绍兴祀神州地祇十六首 奉俎用《丰安》。","郊庙朝会歌辞","四言",["肃肃嘉承，唯德其物。","工祝以告，繄民之力。","神哉广生，孔蕃且硕。","奠于嘉坛，吐之则弗。"],0,"x207","宋"],null,["汾阴十首 其二 奠玉币登歌《嘉安》。","郊庙朝会歌辞","四言",["至诚旁达，柔祇格思。","奉以琮币，致诚在兹。"],0,"x207","宋"],["熊得自古英之近江舟子哗然此异征也为之留皮与胆馀均所获以侈神贶云作获熊一首时庚辰孟冬七日","敖陶孙","四言",["来黝者谁，佥曰熊与。","涉江乱流，实始逆予。","天畀敢违，俯取以荐。","维古英神，谓予汝眩。","有男不梦，有妃莫当。","居然两目，祝昼若盲。","甚者痔下，取怒河伯。","医者色难，请谋诸药。","熊兮主方，我有玄囊。","清汝决眦，捍汝浊肠。","有如不信，剖肝自明。","宁我一死，以与众生。","拜神之休，率曹披啖。","尔爱其蹯，我爱其胆。"],0,103,"宋"],["绍兴以后祀五方帝六十首 黄帝奠玉币用《嘉安》。","郊庙朝会歌辞","四言",["万椟之宝，一絇之丝。","孕之育之，谁为此施。","归之后神，神曰何为。","不宰之功，荡然四垂。"],0,"x207","宋"],["淳熙十二年加上太上皇帝太上皇后尊号十一首 其五 德寿宫册宝入殿门用《正安》。","郊庙朝会歌辞","四言",["南山之巩，皇寿无穷。","太极之尊，皇名是崇。","奉兹宝册，于皇之宫。","皇则受之，于昭盛容。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 盥洗用《干安》。","郊庙朝会歌辞","四言",["礼文有俶，祀事孔明。","将以洁告，允惟齐精。","自盥而往，聿观厥成。","灵监下临，天德其清。"],0,"x207","宋"],["咸平藉田回仗御楼二首 其二 升坐用《隆安》。","郊庙朝会歌辞","四言",["应门斯御，雉扇爰开。","人瞻日月，泽动云雷。","同风三代，均禧九垓。","欢心允洽，时咏康哉。"],0,"x207","宋"],["绍兴以后时享二十五首 哲宗室酌献用《重光》。","郊庙朝会歌辞","四言",["于皇浚哲，遹骏有声。","率时昭考，丕显仪刑。","功光大业，道协三灵。","永绥厥后，来燕来宁。"],0,"x207","宋"],["治平皇太后皇后册宝三首 其二 太尉等奉册宝入门用《正安》。","郊庙朝会歌辞","四言",["晬仪临拱，丕命明扬。","鸾回宝势，鸿贯瑶光。","礼成乐备，德裕名芳。","肇基王化，永懋天祥。"],0,"x207","宋"],["登彼公堂燕贡士 其二","陈襄","四言",["登彼公堂，有松有柏。","君子燕湑，其仪孔特。"],0,50,"宋"],["上册宝十三首 升降用《熙安》。","郊庙朝会歌辞","四言",["佩玉锵锵，其来雍雍。","陟降孔时，步武有容。","恪兹祀事，神罔时恫。","绥我邦家，福禄来崇。"],0,"x207","宋"],["雨师五首 其二 升降用《钦安》。","郊庙朝会歌辞","四言",["佩玉璆如，黼黻襜如。","承神不懈，讫获嘉虞。","圣皇命祀，臣敢弗恭。","凡尔在位，翼翼雍雍。"],0,"x207","宋"],["魏京诗 其十七","刘敞","四言",["尔慎尔止，弼予于治。","期尔前人，用迪尔事。"],0,"x51","宋"],["景德中朝会十四首 群臣举酒用《正安》。 其二","郊庙朝会歌辞","四言",["金奏在庭，有酒斯旨。","颙颙卬卬，向明负扆。","湛湛露斯，式宴以喜。","佩玉蘂兮，罔不由礼。"],0,"x207","宋"],["登彼公堂燕贡士 其一","陈襄","四言",["登彼公堂，维水汤汤。","君子燕湑，其言有章。"],0,50,"宋"],["嘉禾颂七章章四句  其二","吴泳","四言",["其秀维何，奕叶有傩。","春种秋实，备时中和。"],0,222,"宋"],["高宗郊祀前朝享太庙三十首 其六 皇帝再盥洗用《干安》。","郊庙朝会歌辞","四言",["盥至于再，洁诚愈孚。","帝用祗荐，灵咸嘉虞。","腾歌胪欢，会于轩朱。","观厥颙若，受福之符。"],0,"x207","宋"],["绍兴享先农十一首 其七 亚献用《正安》。","郊庙朝会歌辞","四言",["显相祀事，济济锵锵。","举斝酌醴，神其允臧。"],0,"x207","宋"],["常祀五享三首 其三 送神用《兴安》。","郊庙朝会歌辞","四言",["皇祖皇考，配帝配天。","骏奔显相，神保言旋。","祝以孝告，嘏以慈宣。","去来永慕，宗事惟虔。"],0,"x207","宋"],["明道亲享先农十首 其二 皇帝升降用《隆安》。","郊庙朝会歌辞","四言",["冕服在御，坛壝有仪。","陟降左右，天惟显思。"],0,"x207","宋"],["皇后庙十五首 其八 淑德皇后室用《嘉安》。","郊庙朝会歌辞","四言",["明明英媛，德备椒庭。","笾豆有践，黍稷匪馨。","静嘉致荐，容与昭灵。","精意以达，顾享来宁。"],0,"x207","宋"],["绍兴朝日十首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["礼罄沃盥，诚意肃将。","包茅是缩，冀毕重觞。","焕矣情文，既具醉止。","熙事备成，灵其有喜。"],0,"x207","宋"],["高宗祀明堂前朝享太庙二十一首 其八 宣祖室酌献用《天元》。","郊庙朝会歌辞","四言",["昭哉皇祖，骏发其祥。","雕戈圭瓒，盛烈载扬。","天锡宝符，俾炽而昌。","神圣应期，赫然垂光。"],0,"x207","宋"],["魏京诗 其十六","刘敞","四言",["皇曰卿士，惟帝时功。","时亦惟人，惟寇莱公。"],0,"x51","宋"],["丁未之冬营房告成有亭翼然名之曰劝功且为歌训迪有众","袁燮","四言",["维此江壖，控扼之所。","居安思危，可无备御。","维彼强狡，巧于乘隙。","萌檗弗除，其欲罔极。","孰堪制之，维汝弓兵。","猛虎在山，百兽震惊。","勇无坚敌，谋无遗虑。","如彼猎师，靡逸狐兔。","亦如农夫，稂莠是芟。","寇盗斯戢，善良斯安。","吾民膏血，为汝衣食。","可不念此，为民除慝。","国用方窘，于汝常给。","可不念此，竭诚报国。","无或徇私，贪求肆虐。","无或荒嬉，酣饮蒱博。","强汝志气，精汝武艺。","习汝行陈，昭汝果毅。","我闻在昔，元勋茂烈。","发迹弧矢，登坛授钺。","反观此身，均一丈夫。","彼既能然，我岂不如。","黾勉从事，不辞险阻。","风餐露宿，含辛茹苦。","汝身则劳，民获安堵。","肝胆忠义，神其福汝。","我作营房，亦既劳止。","用集尔众，缓急有备。","营房之居，义均弟兄。","务在和睦，毋或纷争。","营房之居，法如军旅。","什伍相长，其传自古。","以大总小，先正其身。","以小承大，期于率循。","我筑斯亭，名曰劝功。","尔有勤劳，是奖是崇。","尔或有罪，吾不汝贷。","鞭扑斥逐，其耻为大。","凡尔有众，各敬尔德。","习此歌诗，持循罔失。"],0,215,"宋"],["绍兴淳熙分命馆职定撰十七首 送神用《景安》。","郊庙朝会歌辞","四言",["帝在合宫，鉴观盛礼。","黍稷惟馨，神心则喜。","礼备乐成，亦既归止。","亿万斯年，以贶多祉。"],0,"x207","宋"],["崇恩太后升祔十四首 彻豆用《成安》。","郊庙朝会歌辞","四言",["锵洋纯绎，于论鼓钟。","周旋陟降，齐庄肃容。","维罍既旨，维笾伊丰。","歌彻以雍，介福来崇。"],0,"x207","宋"],["绍兴登门肆赦二首 其二 降坐用《干安》。","郊庙朝会歌辞","四言",["鸿霈普洽，言归端门。","荡荡巍巍，旋干转坤。","穆然宣室，储思垂恩。","于万斯年，敷锡群元。"],0,"x207","宋"],["干德以后祀感生帝十首 罍洗用《正安》。","郊庙朝会歌辞","四言",["昊天降康，云何以报。","斯谋斯惟，雍雍灌鬯。","身之洁兮，神斯来止。","神之享兮，民斯福矣。"],0,"x207","宋"],["景德祀皇地祇三首 其三 送神用《静安》。","郊庙朝会歌辞","四言",["妙用无方，倏来忽逝。","蠲洁寅恭，式终禋瘗。"],0,"x207","宋"],["皇后庙十五首 其三 司徒捧俎用《丰安》。彻同。","郊庙朝会歌辞","四言",["恪恭奉祀，祗荐牺牲。","九成爰奏，有俎斯盈。"],0,"x207","宋"],["宁宗朝享三十五首 彻豆用《丰安》。","郊庙朝会歌辞","四言",["升馔有章，卒食攸序。","庭锵金奏，凯收铏筥。","其献惟成，其馂维旅。","礼洽庆流，皇祖之祜。"],0,"x207","宋"],["雍熙享先农六首馀同祈谷 其五 终献用《正安》。","郊庙朝会歌辞","四言",["式陈芳荐，爰致虔诚。","神其降鉴，永福黎氓。"],0,"x207","宋"],["绍兴祀神州地祇十六首 太宗位奠币用《嘉安》。","郊庙朝会歌辞","四言",["穆穆令闻，溥博有容。","泽被万宇，靡不率从。","恭陈量币，明荐其衷。","礼亦宜之，享德攸同。"],0,"x207","宋"],["高宗皇帝御笔临吴皇象如鹰帖赞","岳珂","四言",["书法淳古，溯晋而上。","于上品中，则有皇象。","汉歌大风，思士之壮。","帝临此书，猎渭怀望。","于昭诒谋，倚重惟将。","岂象之临，亦意之尚。"],0,"x202","宋"],["祭九鼎十二首 其十一 酌献用《成安》。","郊庙朝会歌辞","四言",["罍之初登，其仪昭陈。","罍之既祼，其香升闻。","神心嘉止，于焉欣欣。","贻我有年，穰穰其仁。"],0,"x207","宋"],["绍兴享先农十一首 其二 迎神用《静安》。","郊庙朝会歌辞","四言",["猗欤田祖，粒食之宗。","世世仰德，青坛载崇。","时惟后稷，躬稼同功。","作配并祀，以诏无穷。"],0,"x207","宋"],["上册宝十三首 彻豆用《成安》。","郊庙朝会歌辞","四言",["濯濯其英，殖殖其庭。","有来群工，赉我思成。","嘉肴既将，旨酒既清。","雍彻不迟，福禄来宁。"],0,"x207","宋"],["宁宗朝享三十五首 文舞退、武舞进用《正安》。","郊庙朝会歌辞","四言",["明庭承神，鼗磬柷敔。","玉梢饰歌，佾缀维旅。","既肖厥文，复象乃武。","祖德宗功，惟帝时举。"],0,"x207","宋"],null,["朝谒太清宫九首 其六 酌献用《大安》。","郊庙朝会歌辞","四言",["钦崇至道，肃谒殊庭。","顺风而拜，明德惟馨。","飙驭来格，尊酒斯盈。","是酌是献，心通杳冥。"],0,"x207","宋"],["绍兴祀太社太稷十七首 太社位奠玉币用《嘉安》。春社太稷、土正、后稷通用。","郊庙朝会歌辞","四言",["土发而祭，农祥是祈。","笾豆加篚，典礼有彝。","惟兹圭币，用告肃祗。","神灵降鉴，锡我繁厘。"],0,"x207","宋"],["淳熙二年发太上皇帝太上皇后册宝十一首 其四 册宝出门用《正安》。","郊庙朝会歌辞","四言",["蚴蟉青龙，婉嬗象舆。","其载伊何，煌煌金书。","乃由端门，乃行康衢。","于以荣亲，振古所无。"],0,"x207","宋"],["绍兴亲享明堂二十六首 其十一 尚书捧俎用《禧安》。","郊庙朝会歌辞","四言",["展牲登俎，箫韶在庭。","羞陈五室，意彻三灵。","匪物斯享，惟诚则馨。","永作祭主，神其亿宁。"],0,"x207","宋"],["明道亲享先农十首 其九 终献用《正安》。","郊庙朝会歌辞","四言",["歆我嘉荐，锡我蕃禧。","多黍多稌，如京如坻。"],0,"x207","宋"],["绍兴祀皇地祇十五首 送神用《宁安》。","郊庙朝会歌辞","四言",["至厚至深，其动也刚。","精诚默通，或出其藏。","神之言归，化斯有光。","相我炎图，万世无疆。"],0,"x207","宋"],["元符亲郊五首 其二 升升用《干安》，罍洗、饮福并奏。","郊庙朝会歌辞","四言",["神灵拥卫，景从云随。","玉色温粹，天步舒迟。","周旋陟降，皇心肃祗。","千灵是保，百福攸宜。"],0,"x207","宋"],["熙宁以后祀高禖六首 其五 亚、终献用《文安》。","郊庙朝会歌辞","四言",["赫赫高禖，万世所祀。","其德不回，锡兹福祉。","蕃衍椒聊，和平芣苢。","传类降康，世济其美。"],0,"x207","宋"],["元符大朝会三首 其三 三举酒用《甘露》。","郊庙朝会歌辞","四言",["泫泫零露，云英醴溢。","和气凝津，流甘委白。","饴泛泮林，珠联竹柏。","天不爱道，圣功允格。"],0,"x207","宋"],["宁宗朝享三十五首 神宗室用《大明》。","郊庙朝会歌辞","四言",["厉精基治，大哉干刚。","信赏必罚，内修外攘。","礼乐法理，号令文章。","作新之功，度越百王。"],0,"x207","宋"],["宁宗朝享三十五首 升殿用《干安》。","郊庙朝会歌辞","四言",["于穆清宫，奕奕孔硕。","芝茎蔓秀，桂华冯翼。","八簋登列，六瑚贲室。","皇代拥庆，启佑千亿。"],0,"x207","宋"],["绍兴十年发皇太后册宝八首 其八 册宝升慈宁殿幄用《圣安》。","郊庙朝会歌辞","四言",["礼行东朝，乐奏大吕。","羽卫森陈，簪绅式序。","云幄邃严，宏典是举。","天子万年，母仪寰宇。"],0,"x207","宋"],["元符亲享明堂十一首 其三 神宗奠币用《信安》。","郊庙朝会歌辞","四言",["合宫礼备，时维哲王。","堂筵四敞，明德馨香。","圣考来格，降福穰穰。","承承继继，万祀其昌。"],0,"x207","宋"],["崇恩太后升祔十四首 神主升殿用《显安》。","郊庙朝会歌辞","四言",["曰嫔于京，天作之配。","进贤审官，克勤其志。","于穆清庙，本仁祖义。","亿万斯年，神灵攸暨。"],0,"x207","宋"],["魏京诗 其十三","刘敞","四言",["既閟尔弓，既櫜尔矛。","猃狁臣止，四方是休。"],0,"x51","宋"],["绍兴亲享明堂二十六首 其二十六 还大次用《憩安》。","郊庙朝会歌辞","四言",["应天以实，已事而竣。","毡案朝帝，竹宫拜神。","灵光下烛，协气斯陈。","福禄时万，基图日新。"],0,"x207","宋"],["闵雨诗 其十","刘敞","四言",["匪震匪拔，匪溢匪泄。","生我百谷，区萌毕达。","以享以食，小大胥悦。"],0,"x51","宋"],["祭九鼎十二首 其十 立冬，魁鼎迎神用《凝安》。","郊庙朝会歌辞","四言",["时运而冬，乃神玄冥。","阴阳相推，丰年以成。","越陈嘉肃，牲牢粢盛。","来享来依，监于明诚。"],0,"x207","宋"],["宁宗郊祀二十九首 亚献用《正安》。","郊庙朝会歌辞","四言",["帝临中坛，神从八陛。","华玉展瑞，明馨荐醴。","亦有嘉德，克相盛礼。","献兹重觞，降福弥弥。"],0,"x207","宋"],["淳熙十二年加上太上皇帝太上皇后尊号十一首 其四 册宝出门用《正安》。","郊庙朝会歌辞","四言",["羽卫有严，宝书有辉。","昭衍尊名，铺张上仪。","出其端闱，由于康逵。","比屋延瞻，歌之舞之。"],0,"x207","宋"],["宁宗朝享三十五首 送神用《兴安》。","郊庙朝会歌辞","四言",["珠幄𤈶黄，神既燕娭。","监观于下，福禄来宜。","云车风马，神保聿归。","启佑我后，福禄来为。"],0,"x207","宋"],["偈二十七首 其二十六","释守净","四言",["梦幻空花，六十七年。","白鸟烟没，秋水连天。"],0,166,"宋"],["熙宁蜡祭十三首 其九 升降用《穆安》。","郊庙朝会歌辞","四言",["皇皇灵德，经纬万方。","承诏摄事，陟降以庄。","高冠岌峨，长佩锵洋。","嘉承神贶，令闻不忘。"],0,"x207","宋"],["高宗郊祀前朝享太庙三十首 其九 宣祖室用《天元》。","郊庙朝会歌辞","四言",["昭哉皇祖，源深流长。","雕戈圭瓒，休有烈光。","天祐潜德，继世其昌。","永怀积累，嘉荐令芳。"],0,"x207","宋"],["进仰山瑞禾诗宋大雅十三章  其一三","张商英","四言",["彼修者禾，其实骈罗。","天子万年，本枝蕃多。"],0,116,"宋"],["纳火祀大辰十二首 商丘宣明王位奠币用《嘉安》。","郊庙朝会歌辞","四言",["恭惟火正，自陶唐氏。","邑于商丘，配食辰祀。","有功在民，有德在位。","敢替典常，惟恭奉币。"],0,"x207","宋"],["先蚕六首 其三 奠币用《娭安》。","郊庙朝会歌辞","四言",["皇天降物，屡化若神。","圣实先识，躬以教民。","功被天下，为万世文。","币以达志，庶几彻闻。"],0,"x207","宋"],["景德中朝会十四首 皇帝初举酒用《祥麟》。","郊庙朝会歌辞","四言",["帝图会昌，二兽效祥。","双角共觝，示武不伤。","四灵为畜，玄枵耀芒。","公族信厚，元元阜康。"],0,"x207","宋"],["霜降木落独松柏苍然颜色愈好因和渊明荣木篇以见意","李纲","四言",["采采荣木，春华于兹。","及尔素秋，风霜瘁之。","寒暑代谢，荣枯有时。","改柯易叶，翩其陨而。","苍苍松柏，擢干蟠根。","风霜虽厉，秀色长存。","君子进德，以道为门。","岁寒时艰，节义弥敦。","惟天于余，赋此拙陋。","材不趋新，学惟求旧。","黾勉夙夜，其何能富。","屡冒艰危，内省不疚。","先公有训，岂敢失坠。","敬慎威仪，圣言是畏。","铅刀虽钝，驽马希骥。","一割之功，十驾而至。"],0,"x136","宋"],["出火祀大辰十二首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["潜之伏矣，柞槱既休。","有俶其来，榆柳是求。","灵驾纷羽，尚其安留。","饮我三爵，言言油油。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其十三 南岳位酌献用《成安》。","郊庙朝会歌辞","四言",["神曰司天，居南之衡。","位焉则帝，于以奠方。","南讹秩事，望礼有常。","庶几嘉虞，介福无疆。"],0,"x207","宋"],["熙宁望祭岳镇海渎十七首 其二 升降用《同安》。","郊庙朝会歌辞","四言",["绅𫖒襜兮，玉佩橤兮。","于我将事，神燕喜兮。","帝命望祀，敢有不共。","往返于位，肃肃雍雍。"],0,"x207","宋"],["魏京诗 其十八","刘敞","四言",["皇曰卿士，惟帝作武。","垂是万年，莫敢予侮。"],0,"x51","宋"],["宁宗郊前朝献景灵宫二十四首 还大次用《干安》。","郊庙朝会歌辞","四言",["帝假于宫，彝承清祀。","天晖临幄，宸卫森峙。","行繇大室，旋趋紫畤。","率礼不违，式敷灵祉。"],0,"x207","宋"],["朝谒太清宫九首 其九 送神用《真安》。","郊庙朝会歌辞","四言",["醴盏在户，金奏在庭。","笾豆有践，黍稷非馨。","义尽蠲洁，诚通杳冥。","言旋风驷，祚我修龄。"],0,"x207","宋"],["绍兴祀先农摄事七首 其四 神农位酌献用《成安》。","郊庙朝会歌辞","四言",["耒耜之教，帝实开先。","致养垂利，古今民天。","嘉荐报本，于以祈年。","诚格和应，神娭福延。"],0,"x207","宋"],["绍兴以后时享二十五首 仁宗室酌献用《美成》。","郊庙朝会歌辞","四言",["至哉帝德，乃圣乃神。","恭己南面，天下归仁。","历年长久，垂裕后人。","祀修旧典，宝命维新。"],0,"x207","宋"],null,["景德祀九宫贵神三首 其三 送神用《高安》。","郊庙朝会歌辞","四言",["祗荐有常，惟神无方。","回飙整驭，垂休降祥。"],0,"x207","宋"],["至和祫享三首 其二 奠瓒用《嘉安》。","郊庙朝会歌辞","四言",["昭穆亲祖，自室徂堂。","礼备乐成，肃然祼将。","瑟瓒黄流，条鬯芬芳。","气达渊泉，神孚来享。"],0,"x207","宋"],["大观三年释奠六首 其三 奠币用《明安》。","郊庙朝会歌辞","四言",["于论鼓钟，于兹西雍。","粢盛肥硕，有显其容。","其容洋洋，咸瞻像设。","币以达诚，歆我明洁。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 再盥洗用《干安》。","郊庙朝会歌辞","四言",["觞澹初勺，礼戒重盥。","假庙以萃，取象于观。","清明外畅，精肃中贯。","我仪图之，三灵攸赞。"],0,"x207","宋"],["元符亲享明堂十一首 其八 亚献用《穆安》。","郊庙朝会歌辞","四言",["于昭盛礼，严父配天。","尽物尽诚，莫匪吉蠲。","重觞既荐，九奏相宣。","神介景福，亿万斯年。"],0,"x207","宋"],["郊祀乐章 皇帝降御座宫架奏黄钟宫干安之曲","崔敦诗","四言",["帝坐中天，流泽演迤。","厥蒙伊民，歌舞以喜。","泽流普矣，民喜偕矣。","驾言徂归，福禄同矣。"],0,93,"宋"],["程帅和陶二诗见忆次韵 其二","陈造","四言",["我瞻西郊，云停不雨。","鸡栖乱山，十舍千阻。","一书缄春，慰厉存抚。","望之或违，搔首企伫。","停云酾之，蜚雨蒙蒙。","启筒有获，如渴吸江。","孤月河汉，轻飔牖窗。","忆侍诲色，杖屦后从。","盱衡推予，褒衮俪荣。","靡怀不倾，靡言不情。","会晤良难，欻然西征。","孰谓愁斛，无自而生。","竹萌触雪，粟花缀柯。","风日山城，未春已和。","命驾取涂，计日不多。","官曹简书，公其谓何。"],0,"x178","宋"],["上册宝十三首 册宝入门用《隆安》。","郊庙朝会歌辞","四言",["威仪皇止，庶尹在庭。","爰举徽章，遹观厥成。","勒崇扬休，写之琼瑛。","迄于万祀，发闻惟馨。"],0,"x207","宋"],null,["高宗祀明堂前朝享太庙二十一首 其六 僖祖室酌献用《基命》。","郊庙朝会歌辞","四言",["何庆之长，实兆于商。","由商太戊，子孙其昌。","皇基成命，宋道用光。","诒厥孙谋，膺受四方。"],0,"x207","宋"],["孝宗明堂前朝献景灵宫八首 其三 还位用《干安》。","郊庙朝会歌辞","四言",["嘉玉既设，量币既陈。","彷佛灵游，来顾来宁。","对越伊何，厥惟一纯。","佑我熙事，以迄于成。"],0,"x207","宋"],["孝宗明堂前朝献景灵宫八首 其七 还位用《干安》。","郊庙朝会歌辞","四言",["旨酒思柔，神具醉止。","工祝既告，孝孙旋位。","何以酢之，纯嘏来备。","燕及云来，蕃衍无已。"],0,"x207","宋"],["淳祐祭海神十六首 捧俎用《丰安》。","郊庙朝会歌辞","四言",["昭格灵贶，祀典肇升。","牲牷告充，雕俎是承。","荐虔效物，省德惟馨。","灵其有喜，万宇肃澄。"],0,"x207","宋"],["五龙六首 其三 奠币用《文安》。","郊庙朝会歌辞","四言",["维灵德兮，变化不常。","沛天泽兮，周流八荒。","奠嘉币兮，肃雍不忘。","永佑民兮，锡以丰穰。"],0,"x207","宋"]]