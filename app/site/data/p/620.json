[["句","释辉","残句",["丁宁童子休教扫，留取窗前当雪看。"],0,44,"宋"],["句","华山道人","残句",["北蕃群犬窥篱落，惊起南朝老大虫。"],0,173,"宋"],["句","某道士","残句",["李郎涉世似虚舟，片帆来渡楚江秋。"],0,175,"宋"],["句 其三","欧阳景","残句",["遍向蜀都呈巧样，被人翻入锦纹头。"],0,233,"宋"],["句","江左士大夫","残句",["扁舟载双鹤，万卷贮群书。"],0,137,"宋"],["句","叶延寿","残句",["自昔吾泉出异僧，清溪今又两岩兴。"],0,213,"宋"],["句 其五","苏轼","残句",["岁寒冰冷天地闭，为我起蛰鞭鱼龙。"],0,"x67","宋"],["句 其五","李清照","残句",["露花倒影柳三变，桂子飘香张九成。"],0,119,"宋"],["句 其十三","曾几","残句",["可惜不当梅蕊破，幽香合在弟兄间。"],0,"x43","宋"],["句","杜杞","残句",["有验如有神。"],0,185,"宋"],["句","李迎","残句",["籍甚人言易已东。"],0,213,"宋"],["句","江施","残句",["深随石窦千寻去，远自云峰十里来。"],0,94,"宋"],["句 其三","赵恒","残句",["臣守但当守公法，驰骛苟进何可取。"],0,24,"宋"],["句 其三","朱熹","残句",["反躬端得味，当得有馀师。"],0,"x46","宋"],["句","贾岛","残句",["寺接江声秋月上，楼依野色夕禽还。"],0,47,"宋"],["句","黄廉","残句",["眉间见喜气，行人有归期。"],0,100,"宋"],["句","马纯","残句",["勋业簿中频点检，只添白发与苍颜。"],0,10,"宋"],["句","史定之","残句",["一堤杨柳月，十里芰荷风。"],0,30,"宋"],["句 其一","林栗","残句",["定王遗筑览长沙，城郭山川四面佳。"],0,250,"宋"],["句","张泌","残句",["槛外有天皆在照，望中无物敢潜行。"],0,92,"宋"],["句","欧阳识","残句",["资水西来兼邵水，龙山横鹜际梅山。"],0,92,"宋"],["句 其九","朱熹","残句",["君子仁慈犹克己，神仙安肯取人头。"],0,"x46","宋"],["句","潘夙","残句",["橐中奇物为棋输。"],0,189,"宋"],["句 其四","勾台符","残句",["胚浑凿开元精结，三十六峰排截嶭。"],0,7,"宋"],["句","李华","残句",["后夜郁孤台上月，更从何处照诗人。"],0,53,"宋"],null,["句 其三","曾几","残句",["斫雪流膏乃如许，也容石蟹趁时新。"],0,"x43","宋"],["句 其二","王过","残句",["危亭北据水南流，槛外频来海上舟。"],0,57,"宋"],["春日田园杂兴","云水","残句",["晴雨花时游子意，寒暄秧信老农心。"],0,88,"宋"],["句 其五","孙山","残句",["结宇孤峰上，安禅巨浪间。"],0,224,"宋"],["句","张佑","残句",["蟹黄盐满箸，熊白软加笾。"],0,219,"宋"],["句 其十三","苏轼","残句",["书窗涴壁常遭骂。"],0,"x67","宋"],["句","释道光","残句",["纵横出岫长天窄，消散归山片月孤。"],0,58,"宋"],["句","赵相","残句",["夕阳绿涧明。"],0,158,"宋"],["句 其四","强彦文","残句",["客舍三杯酒，渔舟半夜灯。"],0,185,"宋"],["句","越州幕僚","残句",["莲幕风清不受梅。"],0,211,"宋"],["句 其三","陈辅","残句",["含识应为狮子去，却来重载法王身。"],0,39,"宋"],["句","文天祥","残句",["一片黄云万顷田，江南父老庆丰年。"],0,"x53","宋"],["句","景定朝士","残句",["静夜无云惟自照，凤凰飞入合欢宫。"],0,41,"宋"],["句","陈公举","残句",["清晓蛙声引啼鴂，夕阳牛背立归鸦。"],0,140,"宋"],["句 其三十九","王随","残句",["惜花愁有雨，待日喜无云。"],0,57,"宋"],["句","时定钦","残句",["白云黄鹤自来去，绿水青山无古今。"],0,99,"宋"],["句","释法言","残句",["林下闲看水牯牛。"],0,128,"宋"],["句 其一","许庚","残句",["值雨花无怨，留春鸟自谋。"],0,