[["送蔡守","徐积","四言",["维淮之南，楚为剧州。","守土之吏，孰明以周。","蔡公既来，爰究爰乂。","明维照奸，威维沮伪。","维明维威，无敢恣睢。","侯曰可矣，其治孔易。","乃兴学校，示之本原。","儒居儒处，礼容义言。","乃修释奠，教民之恭。","有严其色，有孚其颙。","乃行乡饮，躬为主人。","拜辱拜豆，盥洗献宾。","其仪孔肃，其礼孔均。","乃召父老，父老俱来。","幅巾短褐，浩其盛哉。","父老升矣，侯则兴矣。","父老坐矣，侯则妥矣。","父老未醉，笑歌其声。","父老既醉，发白颜赪。","父老去矣，侯则举矣。","馈之物矣，告之语矣。","其语维何，维善是示。","善者使修，恶者使止。","告尔宗族，告尔邻里。","维时父老，奉之以行。","维时庶民，亦克用承。","悖傲者沮，善良者兴。","狠不敢斗，强不敢凌。","不义之讼，莫涉吾庭。","行之期年，几移其风。","吏事用简，狱牢数空。","道上之物，必归其主。","行路之人，无或敢取。","逋攘慝奸，明其购赏。","倾其巢穴，破其支党。","侯曰未也，江淮之患，不备不虞。","乃召尉逻，乃呼卒徒。","乃张尔弓，乃操尔殳。","乃坐乃作，乃驰乃驱。","勇者乃奋，怯者乃舒。","我备既强，我戎既整。","小剽之攘，破胆缩颈。","侯之方略，可以捍边。","捍边如何，威名毅然。","何兵不精，何城不坚。","虏不敢犯，敌不敢前。","侯有所祈，曾不旋日。","雪霶雨零，舆濡衣湿。","维其有德，将之以诚。","神由以格，物由以亨。","侯之为人，不患不恕。","维恕维威，维民维宜。","侯为使者，不患不威。","维威维恕，维感维豫。","侯之察狱，不患不明。","维恕维明，维平维精。","维时岭表，维时海隅。","闻侯之风，既安且需。","冤者使伸，戚者使愉。","吏长则进，物残则除。","抉其已垢，刮其已污。","维有其才，无施不可。","用之本朝，维良维佐。","用之一方，一方之纲。","嗟今之人，莫如侯者。","侯之所为，可示天下。","维其可示，是以可歌。"],0,"x123","宋"],["皇帝上太上皇帝寿乐曲 太上皇帝初举酒用蟠桃之曲","崔敦诗","四言",["结根阆苑，登实瑶池。","红云骈艳，瑞露含滋。","味参石髓，名配松脂。","王母一笑，河水涟漪。"],0,93,"宋"],["庆元二年皇后册宝十三首 其二","郊庙朝会歌辞","四言",["熛阙蟺蜎，璧门云龙。","烈文维辅，翊奉有容。","典章𪸩明，彝度肃雍。","蒇时缛仪，登于璇宫。"],0,"x207","宋"],["诚台春色","薛季宣","四言",["凤阙西冈，郎亭东乳。","惟竹猗猗，诚台有楚。","苔痕春绿，玉李晚风。","屏山坐对，青葱数峰。","颓墙色弄，文杏新红。","争鲜竞秀，芳随意远。","各称时宜，自成深浅。","妙意谁传，叵形罨画。","羲皇晚生，先天后卦。","江湖涨绿，旋拍沧洲。","晴岚翠滴，烟瘴悠悠。","篁鞭破藓，柳带萦愁。","亦有江梅，花残未落。","弄音好鸟，笙簧度曲。","堆如瓦鼓，幽独是称。","兀坐颓然，邑荒无政。","新阳多感，雷鼓轰天。","清淮咫尺，狼烽夕烟。","暮四朝三，谁为第一。","不知其它，且以永日。"],0,"x194","宋"],["宝祐二年皇子冠二十首 其十七","郊庙朝会歌辞","四言",["皇王烝哉，令闻不已。","燕翼有谋，冠醮有礼。","百僚在庭，遹相厥事。","颂声所同，嘉受帝祉。"],0,"x207","宋"],["姑苏蒋公北池诗","张方平","四言",["浙江汤汤，南国之纪。","句章之乡，居巢之里。","天子命公，二邦更治。","越人之嗟，吴人之喜。","公之为政，简而易从。","不严而威，敏以有功。","孽不及牙，奸折其绪。","孰施斧斤，不见铓露。","老稚晏起，壮服于亩。","椸有浣衣，廥有多稌。","公之退公，乐是北池。","飞阁渠渠，虚廊迟迟。","鱼跳于藻，渚有凫鹥。","钓亭桧岛，其水涟漪。","公之退公，以豫以游。","邦人喜公，尚无疾忧。","邦人祝公，百禄是遒。","匪公其私，王家之休。","我思建官，公理众政。","与民最亲，惟时守令。","其有不臧，根心之螟。","小犹虮虱，肤皮是营。","于铄有宋，一统万方。","千里所付，几人曰良。","凡领王民，守土之吏。","有理如吴，帝道则粹。","我歌北池，爰颂公德。","以告后人，勿污勿塞。"],0,2,"宋"],["太庙乐章 其二 皇帝还位干安之曲","周麟之","四言",["于穆清庙，明禋是躬。","卿士骏奔，助我肃雍。","灌鬯已事，精诚交通。","却立以思，僾然其恭。"],0,103,"宋"],["龙眠居士画十六大阿罗汉赞 其七","李纲","四言",["宝珠腾空，光焰璀璨。","谛玩无斁，有见皆幻。","堂堂风仪，龙象之姿。","灵杵宝铎，往将加持。"],0,"x136","宋"],["淳熙二年发太上皇帝太上皇后册宝十一首 其八 太傅奉太上皇后册宝升殿用《圣安》。","郊庙朝会歌辞","四言",["干健坤从，阳刚阴相。","迨兹受祉，允也并况。","虡业在下，仪物在上。","咨时三公，执事无旷。"],0,"x207","宋"],["宋颂九首 其三 皇祖","石介","四言",["皇祖曰嘻，物情难筹。","予代有周，天时人谋。","罔有不同，予德其休。"],0,105,"宋"],["颂古一百二十一首 其四十八","释宗杲","四言",["瑞岩宸风，唤主人公。","昨夜南山，虎咬大虫。"],0,"x112","宋"],["四偈 报冤行","惠洪","四言",["僧婴王难，情观可丑。","夙业纯熟，所以甘受。","受尽还无，何丑之有。","转重还轻，佛恩弥厚。"],0,"x42","宋"],["偈颂八十五首 其七十一","释妙伦","四言",["五峰影里，双涧声中。","有大宝藏，八面玲珑。"],0,10,"宋"],["题真仁夫画卷","刘克庄","四言",["草木黄落，水云莽苍。","孤舟卸帆，冻雁失行。","昔余远游，沿漓溯湘。","堠长店疏，仆痡马僵。","行李萧然，有诗满囊。","今其老矣，宁志四方。","抚卷追思，历历不忘。"],0,"x93","宋"],["上邓宪生辰  其六","杨简","四言",["迺眷西顾，金节畀之。","礼乐光华，亦王近畿。"],0,118,"宋"],["麦秀歌","薛季宣","四言",["麦秀渐渐，殷商宫兮。","肃肃清庙，俨惟墉兮。","城郭依然，浍畎通兮。","恻我心摧，悼人亡兮。","寤彼盛时，阜熙雍兮。","车盖幢幢，来朝宗兮。","自我成汤，德颙颙兮。","恍如梦惊，留眼中兮。","今我不见，内犹霿兮。"],0,"x194","宋"],["宋颂九首 其二 汤汤","石介","四言",["彼以险守，我以德怀。","王师东来，函谷自开。","蜀虏授首，呼号哀哀。","蜀人鼓舞，与我偕来。"],0,105,"宋"],["宋颂九首 其二 金陵","石介","四言",["帝赫斯怒，王师徐驱。","蕞尔蝼蚁，岂胜诛锄。","哀哀穷俘，爰叫以呼。","归于京师，𬊤哉圣谟。"],0,105,"宋"],["崧高诗为九江赵使君寿  其一","杨冠卿","四言",["崧高维岳，四方之极。","维岳降神，生此王国。"],0,61,"宋"],["宋颂九首 其三 汤汤","石介","四言",["昔时蜀道，绝人来往。","今蜀既平，王道荡荡。","尉候一置，朝贡相望。","巍巍皇祖，德声远畅。"],0,105,"宋"],["送程守","徐积","四言",["蜀之有眉，有山有江。","江大而浚，山形甚庞。","是生程公，为国重器。","可处大任，可决大事。","凡有措置，凡有施设。","坚不可摇，牢不可拔。","所以蜀人，号为铁塔。","维公有子，为山阳守。","所性所养，质直真厚。","维其质直，不浮不苟。","不生巧心，不为利口。","维其真厚，不矫不激。","体无邪气，面无邪色。","视其气貌，察其动静。","可知所养，可知所性。","可知其德，可知其政。","质直真厚，故不生事。","不为小数，不任小智。","以恕辅法，因法行恕。","不烦不苛，不暴不怒。","遂使斯民，如行大路。","无险可虞，无伤可虑。","肌肤以完，手足可措。","奸凶以衰，盗贼亦沮。","父母妻子，邑居田庐。","各安其故，各保其居。","为政如此，民是以和。","是以可慕，是以可歌。","不能歌者，太守之量。","可歌可传，可法可尚。","可以容众，可以任重。","无适不可，惟上所用。"],0,"x123","宋"],["淳祐祭海神十六首 南海位奠玉币用《瀛安》。","郊庙朝会歌辞","四言",["祝融之位，贵乎三神。","吞纳江汉，广大无垠。","长为委输，祐我黎民。","敬陈明享，允鉴恭勤。"],0,"x207","宋"],["咏茅山元符万宁宫","蔡卞","四言",["猗嗟三茅，得自初成。","气合于无，与形俱升。","孰希其风，必静必清。","寥寥久哉，乃发先生。","帝用尊之，载召来廷。","乃亲其人，燕见妙语。","乃锡命书，迨其俦侣。","因其故庐，启此新宇。","像图仙真，上肖帝所。","神笔榜之，龙凤轩翥。","天锡皇帝，聪明孝友。","抱一用中，以绥九有。","遐迩率从，尊道熙功。","有欲求之，与在斯宫。","作为好歌，以诏无穷。"],0,96,"宋"],["鶑鸣十章寄戚伯瑞  其一","彭龟年","四言",["有鸣其禽，其鸣维何。","有怀其人，我心靡他。"],0,223,"宋"],["浮山圆鉴和尚赞","释清远","四言",["并汾铁骑，老息荒丘。","云施雨罢，花落水流。"],0,116,"宋"],["南陔五章二章章八句三章章四句  其一","郑刚中","四言",["陟彼南陔，有风惟薰。","曷念劬劳，华髪盈巾。","彼发之华，尚可翦也。","嗟嗟吾亲，不可见也。"],0,"x99","宋"],["上许州吕相公嗣崧许康诗二首 许康诗 其三","宋祁","四言",["公视于庭，师兵翼翼，孔武有力。","公适于府，陪卿髦士，罔不就绪。","公宴于堂，嘉宾我从。","琴瑟鼓钟，或揳或𪭢。","静好铿锵，万舞有容。"],0,"x49","宋"],["上许州吕相公嗣崧许康诗二首 许康诗 其四","宋祁","四言",["左拂其殽，炰鼈燔羔，给鲜于庖。","右烹其蔌，笋菭蒲葅，柔嘉惟馥。","旨酒且多，其饮温克。","摄尔攸仪，侑公宴嬉。","俾胖而乐，俾艾而耆。"],0,"x49","宋"],["宋颂九首 其一 汤汤","石介","四言",["汤汤其江，区区尔孟。","一夫当关，不知天命。","蚁固于穴，蛙负于井。","咫尺之地，为可以骋。"],0,105,"宋"],["南陔五章二章章八句三章章四句  其五","郑刚中","四言",["敬尔身矣，怿其亲矣。","逮其暮矣，云何吁矣。"],0,"x99","宋"],["东坡像李伯时作曾无疑藏之命予赞之","周必大","四言",["龙章凤姿，挥斥八极。","天心月胁，照映万物。","孟子之气，庄周之文。","瞻之在前，尚有典型。"],0,"x76","宋"],["赞三十六祖颂 其二十九","释印肃","四言",["直截猛利，立雪断臂。","千古万古，丈夫意气。"],0,"x121","宋"],["寒山拾得赞","释智愚","四言",["五峰石上，双涧松边。","是者伎俩，莫骂丰干。"],0,"x153","宋"],["喜晴","赵鼎臣","四言",["我田既臧，零雨其蒙。","嗟我农夫，忧心冲冲。","谷旦于差，薄言往愬。","谓天盖高，上帝临汝。","杲杲出日，有嘒其星。","获之挃挃，我仓既盈。","薄采其芹，于彼行潦。","神之听之，无德不报。"],0,126,"宋"],["补乐府十篇 其二 帝神农氏之乐歌","曹勋","四言",["丰年告成，百谷用登。","匏笾既盈，黍稷既馨，昭假是膺。"],0,"x103","宋"],["皇帝上太上皇帝寿乐曲 酒一行罢用万寿无疆之舞","崔敦诗","四言",["三纪御图，道丰德盛。","化洽兆民，功光列圣。","畀托有归，脱屣万乘。","优游法宫，颐神养性。","岧岧具阙，丰丽靖渊。","游神象外，玩意物先。","为众父父，尊荣配天。","大福备禄，何千万年。"],0,93,"宋"],["颂古十一首 其二","释普济","四言",["肩担口叫，晓夜撑船。","道路各别，养家一般。"],0,73,"宋"],["偈颂一百六十首 其十五","释宗杲","四言",["二月仲春，久雨不晴。","云门一劄，德非有邻。"],0,"x112","宋"],["赞梅溪王先生像","陈宓","四言",["先生之道，得天之全。","气刚以和，如四时然。","功在王室，惠留于泉。","不怒而教，恶遏善迁。","为政以德，信哉格言。","先生之逝，四十三年。","有庙有祠，民奉益虔。","紫帽可砺，清名不骞。"],0,"x124","宋"],["淳熙十二年加上太上皇帝太上皇后尊号十一首 其七 太傅、中书令、侍中奉太上皇帝册宝升殿用《圣安》。","郊庙朝会歌辞","四言",["天锡伊嘏，地效其珍。","诞作宝典，奉于尊亲。","尔公尔相，尔恭尔寅。","协举令仪，遹臻厥成。"],0,"x207","宋"],["张横渠赞","陈长方","四言",["祖龙吐毒，烈火四焚。","先王载籍，毕罹其屯。","刘汉崛兴，访索丘坟。","群儒掇拾，百不一存。","绵𫈵之野，陋兮叔孙。","胸谋腹断，己学自尊。","致彼古礼，寥落无闻。","勇哉先生，绝类离伦。","追千岁上，以礼立身。","隐居关右，化行于民。","宾嘉丧祭，唯古之循。","坐令邹鲁，复见咸秦。","岩岩泰山，烈烈秋暾。","先生谨严，比德实均。","嗟世习非，诚难具论。","弃礼自快，纷其如云。","感今陈古，歌以斯文。","庶由高躅，起我后昆。"],0,142,"宋"],["郊祀乐章 皇帝入小次宫架奏黄钟宫仪安之曲","崔敦诗","四言",["匏尊既举，苏席未移。","有德斯顾，靡神不娭。","物情肃穆，天宇清夷。","宅中受命，永复邦基。"],0,93,"宋"],["偈颂六十首 其三十六","释昙华","四言",["一呼善来，须发自落。","积累既多，无处安著。","普请大众，把火烧却。"],0,47,"宋"],["崧高诗为九江赵使君寿  其五","杨冠卿","四言",["之纲之纪，允文允武。","荆舒是惩，四方无侮。"],0,61,"宋"],["有宋死孝毛子仁哀辞","杨万里","四言",["灏穹眷宋，方郅隆些。","笃生仁皇，实睿聪些。","二尧两舜，复时雍些。","杜韩富范，再夔龙些。","巍荡奋熙，起丕功些。","欧阳伯仲，轲与雄些。","云昭汉回，炳文风些。","麟在灵囿，凤在桐些。","金芝专车，朱草丛些。","悬藜结绿，牣紫宫些。","灵蛇照乘，玉府充些。","大江之西，文江东些。","毛伯苗裔，河岳钟些。","三辰五纬，韫心胸些。","如汉贾生，与终童些。","年未弱冠，收科崇些。","连收制科，天动容些。","玉映汉台，惊群公些。","弃官如泥，子职恭些。","死孝倚庐，神明通些。","文行有炜，垂无穷些。","与宋一经，相始终些。","冻黎百年，养万钟些。","草腐菌朽，花𫕥空些。","有宋孝子，蔚岱嵩些。"],0,"x54","宋"],["崧高诗为九江赵使君寿  其二","杨冠卿","四言",["绵绵瓜瓞，莫莫葛藟。","周公之孙，齐侯之子。"],0,61,"宋"],["番阳喜晴赠幕僚","袁甫","四言",["大江以东，岁屡弗康。","民病未苏，正兹忧惶。","一雨六旬，巨浸汤汤。","我告上帝，是祈是禳。","我来宿斋，室名朝阳。","顾瞻斯名，与我心当。","天告我兆，厥应果彰。","朝阳一升，阴沴伏藏。","众水归壑，殃转为祥。","民奠攸居，岁保金穰。","耄倪载咏，喜气洋洋。","匪我颛蒙，能动上苍。","赖我诸友，罔或怠荒。","斋事孔明，纯诚是将。","上帝昭格，随此瓣香。","我勉诸友，秉德日彊。","朝阳在我，自然发光。","阳复之始，养而勿伤。","常如对帝，中正斋庄。","乃保终吉，以活吾氓。","稍或安肆，罔念作狂。","政刑弗谨，号令弗臧。","天非可恃，祥覆为殃。","敬之敬之，斯须勿忘。","既以告友，抑以自防。"],0,229,"宋"],["题真净肖像","张商英","四言",["云庵纲宗，能用能照。","冷面严眸，神光独耀。","孰传其旨，觌露唯肖。","前悦后洪，如融如肇。"],0,116,"宋"],["孟知府令嗣求法名兴福","释崇岳","四言",["兴福奇儿，福无边表。","一点灵台，青天月皎。"],0,222,"宋"],["丁巳再游题蓬山堂泉石","杨栋","四言",["琼流鉴空，混沌一隙。","紫霄柱下，清泉白石。"],0,111,"宋"],["颂古十七首 其十","释师观","四言",["乾坤独立，从者里入。","风吹不著，雨打不湿。"],0,210,"宋"],["题李伯时三教图卷 其三","李纲","四言",["素王峨峨，万世所师。","太和元气，逝者如斯。","吾侪小人，有喙何施。","稽首顿首，念兹在兹。"],0,"x136","宋"],["张忠献时义诚力二帖赞","岳珂","四言",["至诚动天，中贯三极。","堂堂南阳，继以魏国。","山岳鼎震，江河釜溢。","群生失宁，乃见人杰。","大义既信，人纪复植。","于晦冥中，揭以日月。","操固汉贼，敌祸宋祏。","万段之磔，吾耻未涤。","不共戴履，矧肯屈膝。","祁山屡却，淮陇迭出。","非不拙沮，之死靡易。","我观史册，二公与匹。","功虽不同，心则如一。","隆兴至今，耳目尚及。","遗墨之宝，已若尺璧。","造次皆忠，言犹未泐。","天维可绝，地轴可折。","公心之磨，此理则熄。","两朝开济，万古阖辟。","系此诗之，以媲庙柏。"],0,"x202","宋"],["偈颂六十八首 其三十九","释法薰","四言",["欲得见前，莫存顺逆。","筑著磕著，无处寻觅。"],0,31,"宋"],["哲宗上太皇太后册宝五首 其五 太尉等奉册宝出入门用《正安》。","郊庙朝会歌辞","四言",["玉车临御，凤盖棽丽。","奉承宝册，弥文盛仪。","抗声极律，助我孝熙。","天之所佑，万寿无期。"],0,"x207","宋"],["祀先蚕六首 其五 亚、终献用《惠安》。","郊庙朝会歌辞","四言",["日吉辰良，礼备乐作。","精诚内孚，俎豆交错。","升歌清越，侑此三爵。","黎民不寒，幽显同乐。"],0,"x207","宋"],["绣释迦像并十八罗汉赞 第五诺距罗尊者","惠洪","四言",["树亦求法，身当床坐。","鹿有施心，供以山果。","雪眉许长，舒绾在我。","默而识之，未用惊破。"],0,"x42","宋"],["皇后庙十五首 其十五 送神用《归安》。","郊庙朝会歌辞","四言",["明禋告毕，灵辂难留。","升云杳邈，整驭优游。","诚深嘉栗，礼罄钦修。","丰融垂佑，以永洪休。"],0,"x207","宋"],["偈颂九十三首 其七","释梵琮","四言",["今朝结制，事事超诣。","问讯烧香，衲僧巴鼻。","人事上下，巡堂次第。","无位真人，蓦忽喷嚏。","布袋头结，吉无不利。"],0,100,"宋"],["上英宗尊号一首 入门用《正安》。","郊庙朝会歌辞","四言",["在宋五世，天子神明。","群公奉册，乃扬鸿名。","金书煌煌，遹昭厥成。","思皇多祜，与天同声。"],0,"x207","宋"],["崧高诗为九江赵使君寿  其六","杨冠卿","四言",["旱既太甚，以祈甘雨。","零雨其蒙，介我稷黍。"],0,61,"宋"],["南陔五章二章章八句三章章四句  其二","郑刚中","四言",["陟彼南陔，其薰远兮。","慨我功名，今亦晚兮。","功名之晚，尚可为也。","嗟嗟吾亲，不可追也。"],0,"x99","宋"],["闵雨诗 其八","刘敞","四言",["追悟谠直，褒进淹滞。","声色无迕，式序在位。","嬖习权近，慑威屏气。"],0,"x51","宋"],["宋颂九首 其四 莫丑","石介","四言",["皇祖有德，干覆坤容。","予在吊民，不杀以封。","皇祖慈仁，感于昆虫。"],0,105,"宋"],["绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其二","郊庙朝会歌辞","四言",["钟鼓交作，文物咸备。","彤庭玉阶，天子是莅。","咨尔辅臣，展采错事。","辅臣稽首，敢不率礼。"],0,"x207","宋"],["李伯时画马赞","李之仪","四言",["饮不以鼻，投不以趾。","虽梦亦然，理自应尔。","吾师东坡，尝有是语。","天机所同，惟伯时父。","东坡形容，伯时位置。","曹韩少陵，俱落第二。","吾私淑诸，限隔九泉。","笔头落处，几至潸然。"],0,"x203","宋"],["颂古三十八首 其一","释慧方","四言",["金槌影动，宝剑光寒。","百万之众，齐著眼看。"],0,45,"宋"],["乾道七年恭上太上皇帝太上皇后尊号十一首 其七 太傅奉太上皇帝册宝升殿用《圣安》。","郊庙朝会歌辞","四言",["大哉尧乎，南向垂裳。","君哉舜也，拜而奉觞。","缫藉光华，鼓钟铿锵。","三事稽首，宋德无疆。"],0,"x207","宋"],["枢相宣抚虞公寿雅 江舻 其四","王质","四言",["在宫雍雍，金石其音。","在庙湛湛，虎兕其扃。","暨我国人，以莫不宁。"],0,"x37","宋"],["偈颂五十一首 其十五","释道冲","四言",["须弥可裂，海水可竭。","若论此事，宁可截舌。"],0,206,"宋"],["赞护教 其一 土地","释印肃","四言",["给孤施地，慈化为尊。","护人成佛，功德奚论。"],0,"x121","宋"],["闵雨诗 其九","刘敞","四言",["己巳乃雨，若有鬼神。","凄凄其风，渰渰其云。","自东徂西，罄无不均。"],0,"x51","宋"],["王梁山画像赞","释居简","四言",["从事毛锥，壮夫不为。","置书学剑，弓号马嘶。","不斩楼兰，夫何自欺。","堂堂梁山，襟利带夔。","帝轸遐方，详延瑰琦。","良马素丝，组以五之。","维贤作牧，任以抚绥。","抚绥伊何，恩斯勤斯。","岂惟怀恩，亦复畏威。","庶靖氛埃，以偃鼓鼙。","昔人可师，感夜半鸡。","哂乃阿瞒，横槊赋诗。"],0,"x94","宋"],["崧高诗为九江赵使君寿  其三","杨冠卿","四言",["柔惠且直，小心翼翼。","王亲命之，南国是式。"],0,61,"宋"],["薛黄门春聚帖赞","岳珂","四言",["九字在纸，落落晨星。","此帖之传，犹及太平。","意象轩昂，足称其名。","作此赞焉，惟字之评。"],0,"x202","宋"],["崧高诗为九江赵使君寿  其四","杨冠卿","四言",["尽瘁以仕，不懈于位。","四方于宣，南国之纪。"],0,61,"宋"],["明堂庆成颂  其二","徐鹿卿","四言",["大祀有彝，亲享凡七。","严父配天，昉自今日。"],0,73,"宋"],["绣释迦像并十八罗汉赞 第四苏频陀尊者","惠洪","四言",["石床之外，老松挺拔。","玉瓶之中，山花自发。","手持如意，默而说似。","梵帙不看，知离文字。"],0,"x42","宋"],["偈二十七首 其二十六","释绍隆","四言",["灵机密运，日月旋流。","四象推迁，一阳来复。","化育之本，匝地普天。","草木昆虫，悉承恩力。"],0,252,"宋"],["偈颂一百五十首 其三十九","释心月","四言",["我有一要，千差齐照。","未曾拈花，不劳微笑。","拟问如何，云横海峤。"],0,188,"宋"],["明堂庆成颂  其三","徐鹿卿","四言",["远稽前载，其在成周。","皇皇宗祀，奕奕垂休。"],0,73,"宋"],["宋江三十六赞 其二十 黑旋风李逵","龚开","四言",["风有大小，不辨雌雄。","山谷之中，遇尔亦凶。"],0,103,"宋"],["宁宗郊祀二十九首 终献用《正安》。","郊庙朝会歌辞","四言",["敬事天地，升侑祖宗。","陈盥于三，介觞之重。","秉德翼翼，有来雍雍。","相予祀事，福嘏日溶。"],0,"x207","宋"],["熙宁以后祀高禖六首 其一 降神用《高安》。六变。","郊庙朝会歌辞","四言",["容台讲礼，禖宫立祠。","司分届后，带韣陈仪。","嘉祥萃止，灵驭来思。","皇支蕃衍，永固邦基。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 后稷氏位奠币。曲同大明。","郊庙朝会歌辞","四言",["播种之功，时惟后稷。","推以配天，莫匪尔极。","崇侑清祀，是为司啬。","陈币奠将，永祚王国。"],0,"x207","宋"],["赘禅宗无门关后第四十九则语","郑清之","四言",["语火是灯，掉头弗应。","惟贼识贼，一问即承。"],0,201,"宋"],["偈颂一百五十首 其三十六","释心月","四言",["我有一言，彻根彻源。","举之不全，听之不圆。","拟问如何，苍天苍天。"],0,188,"宋"],["绍定三年寿明仁福慈睿皇太后册宝九首 其二","郊庙朝会歌辞","四言",["煌煌仪物，绎绎鼓钟。","奉兹宝册，至于阶东。","上公相仪，列辟尽恭。","拜手慈宸，福如华嵩。"],0,"x207","宋"],["国清曹源为书名已复说偈云","曹勋","四言",["非湛非摇，真源常在。","直指性海，总别无碍。","星分月现，光涵法界。","寄语诸方，莫作拟解。"],0,"x103","宋"],["偈颂一一二首 其四十九","释清远","四言",["思无思思，万邪一正。","不识玄旨，徒劳念静。"],0,116,"宋"],null,["龙眠居士画十六大阿罗汉赞 其十一","李纲","四言",["宴坐便安，支颐握拳。","一念不波，灵台湛然。","婉彼胎禽，就掌取食。","了无惊猜，驯承恩力。"],0,"x136","宋"],["王洽永嘉帖赞","岳珂","四言",["瑞牛出谷，既秉金箓。","短辕逐犊，池凤是续。","栖梧食竹，葩奇韵馥。","在此宝轴，手不可触。","神观玉立，宛若在目。","恍其展读，乌衣之曲。"],0,"x202","宋"],["宁宗郊祀二十九首 尚书奉俎。","郊庙朝会歌辞","四言",["列俎孔陈，嘉笾维实。","鼎煁阳燧，玉流星液。","我牲既硕，我荐既苾。","神监下昭，安坐翔吉。"],0,"x207","宋"],["绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其五","郊庙朝会歌辞","四言",["玉玺瑶编，礼容毕具。","穆穆至尊，华殿是御。","德配有虞，绍唐授禹。","于万斯年，受天之祜。"],0,"x207","宋"],["偈颂一百六十首 其八十三","释宗杲","四言",["久雨不最，才晴又雨。","天道变化，万物得所。","云门老汉，不在里许。"],0,"x112","宋"],["甘泉吴使君使画史作简斋居士像居士见之大笑如洞山过水睹影时也戏书三十二字","陈与义","四言",["两眉轩然，意像无寄。","而服如此，又不离世。","鉴中壁上，处处皆是。","简斋虽传，文殊无二。"],0,"x72","宋"],["宗忠简公画像赞","陈炳","四言",["平生孔明，称慕莫及。","像见忠简，懦夫有立。","横流砥柱，万里长城。","欲奋空弮，以植危倾。","猛将敛手，气指目使。","谁知此公，亦裳布士。"],0,247,"宋"],["雨后月明起坐戏成","舒岳祥","四言",["雨后月明，如醉而醒。","不见其形，但见其影。","我梦初回，非曙非暝。","道人无言，起舞弄景。","水鸟无声，一鹤自警。","清风南来，露坠炯炯。","我病不饮，酌此清泠。","超然顿悟，九万俄顷。"],0,"x161","宋"],["绍兴祀岳镇海渎四十三首 其三十一 西海位。","郊庙朝会歌辞","四言",["奄浸坤轴，滋殖其濊。","而典斯稽，有陛有壝。","弗替时举，元斝斯酹。","胡先于河，实委之会。"],0,"x207","宋"]]