[["句 其三十二","释惠崇","残句",["秋近草虫乱，夜遥霜月低。"],0,69,"宋"],["句 其四十三","陶弼","残句",["转叶香随风，舒花影凌日。"],0,254,"宋"],["句 其二十六","陶弼","残句",["深入侬黄左右溪，溪边得此岁寒枝。"],0,254,"宋"],["句 其七","元绛","残句",["可惜闽州风物好，一生魂梦到三山。"],0,98,"宋"],["句 其三","翁卷","残句",["梅花处处妍。"],0,170,"宋"],["句 其五","黄景说","残句",["清杀玉川文字肠。"],0,227,"宋"],["句","吕殊","残句",["游子惊车破，农人念稼伤。"],0,251,"宋"],["句","潘阆","残句",["何须三叫绝，已恨一声多。"],0,124,"宋"],["句 其六十一","释惠崇","残句",["马渡冰河阔，雕盘喷日高。"],0,69,"宋"],["句 其八","赵师秀","残句",["石畔长来枝易老，竹间瘦得萼全清。"],0,214,"宋"],["句","牟𪩘","残句",["翻手可覆手，曲身成直身。"],0,"x188","宋"],["句 其一","陈槐卿","残句",["浩叹但伤前辈少，此怀难与俗人论。"],0,166,"宋"],["句 其十九","楼楚材","残句",["除屏簇外少青山。"],0,96,"宋"],["句 其二","李焘","残句",["瓦屋如案平，金仙閟光景。"],0,52,"宋"],["句","韩璜","残句",["愿为靖节妃。"],0,186,"宋"],["句 其一","吕午","残句",["杏城西城翁幽居。"],0,65,"宋"],["句 其十","邵伯温","残句",["秀近亭边回首处，郡城高插水云间。"],0,137,"宋"],["句 其七","吴幵","残句",["纷纶委贶知旁达，渗漉流恩亦下蟠。"],0,98,"宋"],["句  其二二","张釜","残句",["得句不妨时策勋。"],0,194,"宋"],["句 其一","王安中","残句",["凤鞋微露绣帮相。"],0,52,"宋"],["句","陈偁","残句",["壶浆压境来迎拜，犹记溪山旧主人。"],0,239,"宋"],["句 其十","吴光","残句",["檐花谢女雪，径扫沈郎钱。"],0,174,"宋"],["句 其二十五","楼楚材","残句",["窠花盆是地，巢燕屋为天。"],0,96,"宋"],["句","苏耆","残句",["上到天门最高处，不能容物只容身。"],0,87,"宋"],["句 其八","胡仔","残句",["愁随竹叶消春盏，喜入灯花缀夜缸。"],0,228,"宋"],["句 其十九","徐似道","残句",["驹入隙来元不碍，蝇钻纸出定何妨。"],0,139,"宋"],["句 其三十三","释惠崇","残句",["海鸥听舜乐，山鬼醉尧觞。"],0,69,"宋"],["句 其二","洪刍","残句",["鹿场兔径白昼静，稻垄松竹青嶂深。"],0,5,"宋"],["句 其六","王琪","残句",["结伴不禁鸳瓦冷，羞明常怯玉钩斜。"],0,242,"宋"],["句 其五","龚况","残句",["山色秋难老，池光夜不昏。"],0,13,"宋"],["句 其二","吴中复","残句",["鲸鱼有浪春涛阔，铜鼓无声夜柝闲。"],0,71,"宋"],["句 其十九","王安中","残句",["宦游梅岭外，讼诉榕庭空。"],0,52,"宋"],["句 其四","邵博","残句",["洲渚千奴熟，旌旗五马来。"],0,169,"宋"],["句","吴民载","残句",["条风著野方蚕月，高树移阴又麦秋。"],0,29,"宋"],["句 其四","俞君锡","残句",["荒店难寻酒，长途半趁船。"],0,116,"宋"],["句 其二","赵汝回","残句",["屈原一点沉湘恨，李白三生捉月身。"],0,213,"宋"],["句 其七","田亘","残句",["少时解奏三千牍，老去犹翻十二经。"],0,177,"宋"],["句 其五","田锡","残句",["诸峰居蜀右，夕翠染巴东。"],0,6,"宋"],["句 其四","陈郁","残句",["与子才分手，何人更赏心。"],0,172,"宋"],["句 其二","宋白","残句",["劳君赠我古风诗，逋翁所谓扑凸奇。"],0,187,"宋"],["句 其二十七","楼楚材","残句",["不须忧暑气，有我便无它。"],0,96,"宋"],["句 其四","章得象","残句",["青草瘴深卢橘熟，黄梅雨歇荔枝红。"],0,238,"宋"],["句 其一","李维","残句",["清朝纳禄犹强健，白首还家正太平。"],0,59,"宋"],["句 其二十四","徐俯","残句",["官事有时闲，江上每夷犹。"],0,156,"宋"],["句 其六十九","释惠崇","残句",["风暖鸟巢木，日高人灌园。"],0,69,"宋"],["句","释惟谨","残句",["满径露漙黄般若，戛檐风袅翠真如。"],0,233,"宋"],["句 其二","张瑰","残句",["人间独有当时月，山际犹无后世樵。"],0,137,"宋"],["句 其二","谢希孟","残句",["句牵主人衣，一步行不得。"],0,69,"宋"],["句","薛利和","残句",["傍人笑我无蓝袖，今日朱衣岭上归。"],0,42,"宋"],["句 其四","韦奇","残句",["窗破入云气，林疏漏月痕。"],0,174,"宋"],["句 其六十五","高似孙","残句",["晋书好传偏安石，唐世诸人且乐天。"],0,181,"宋"],["句 其三十二","王随","残句",["馀残花落席，吟次月生楼。"],0,57,"宋"],["句 其二","蒋堂","残句",["深锁烟光在楼阁，旋移春色入门墙。"],0,201,"宋"],["句 其二十八","晏殊","残句",["不闻幽艳接江蓠。"],0,186,"宋"],["句 其四","詹默","残句",["莫似公家三十五，时来不寄一行书。"],0,41,"宋"],["句 其三","俞君锡","残句",["教仆扫枯叶，留僧煎早茶。"],0,116,"宋"],["句 其八","张潞","残句",["紫垂户外瞻天近，绿堕楼前到地香。"],0,35,"宋"],["句 其七","薛绍彭","残句",["霜干叶飘零，日出水清浅。"],0,62,"宋"],["句 其九","薛绍彭","残句",["一马春风过微雨，竹间归路净无尘。"],0,62,"宋"],["句 其二","冯伉","残句",["传语东归王副使，也须别却海棠回。"],0,131,"宋"],["句 其五十五","陶弼","残句",["人心如地少平处，天气似春无冷时。"],0,254,"宋"],["句 其十三","齐唐","残句",["春波池上支琴荐，秋月桐阴把蟹螯。"],0,231,"宋"],["句","益州绿事参军","残句",["秋光都似宦情薄，山色不如归兴浓。"],0,103,"宋"],["句 其六","俞君锡","残句",["半身长在旅，何日定还家。"],0,116,"宋"],["句 其二","释守端","残句",["不似大梅老，贪随鼯鼠声。"],0,58,"宋"],["句 其二","陈俊卿","残句",["病深老迫宜归去，莫作留侯范蠡看。"],0,246,"宋"],["句  其五","唐庚","残句",["远岸明残日，孤村认小舟。"],0,88,"宋"],["句  其一二","萧德藻","残句",["直须冰雪作梯媒。"],0,239,"宋"],["句 其二十一","晏殊","残句",["争持白玉萼，共插翠云鬟。"],0,186,"宋"],["句  其四七","徐俯","残句",["绕舍绿周遭。"],0,156,"宋"],["句","杨希仲","残句",["回环万木森幢盖，缥缈三山落市廛。"],0,156,"宋"],["句 其二","释祖可","残句",["故人江北江南岸。"],0,72,"宋"],["句  其一○","陈克","残句",["渺渺大江流。"],0,118,"宋"],["句 其九","王安中","残句",["云山连楚塞，夏木暗随城。"],0,52,"宋"],["句 其五","晁迥","残句",["破暗用明明是用，非明非暗即惺惺。"],0,199,"宋"],["句 其九","张潞","残句",["江汉西来天地白。"],0,35,"宋"],["句 其六","释惠崇","残句",["春浅冰生井，宵分月上轩。"],0,69,"宋"],["句","朱惟贤","残句",["层檐月印高低影，寒壑风号远近声。"],0,128,"宋"],["句 其十","孟宾于","残句",["千家帘幕春空在，几处楼台月自明。"],0,207,"宋"],["句 其三","王溉","残句",["西边更拥上皇山，大面六顶不可攀。"],0,8,"宋"],["句","萧国梁","残句",["名传玉陛星辰晓，泽霈金枝雨露春。"],0,12,"宋"],["句 其六","唐庚","残句",["汉节从分竹，刘鞭不用蒲。"],0,88,"宋"],["句 其三十","吴沆","残句",["吹断碧云春昼永，落残红雨晓风轻。"],0,119,"宋"],["句 其八十九","释惠崇","残句",["路横岗烧断，风转浦帆斜。"],0,69,"宋"],["句 其六","夏竦","残句",["密叶凝华承玉戺，附枝交影荫银塘。"],0,12,"宋"],["句 其五十三","陶弼","残句",["渴蜂衔砚水，饥蝶嗅屏花。"],0,254,"宋"],["句 其二","张先","残句",["霓舟忽舣鲈鱼乡，槎阁却凌云汉域。"],0,198,"宋"],["句 其十五","徐似道","残句",["肩成山耸因寻句，眼作花昏为勘碑。"],0,139,"宋"],["句 其二","吴琚","残句",["春归百卉今无几，独立清微殿阁风。"],0,145,"宋"],["句  其二六","释蕴常","残句",["诗到扬州定清绝。"],0,79,"宋"],["句  其五六","释晓莹","残句",["诗书论议深。"],0,182,"宋"],["句 其五十七","释惠崇","残句",["雁行沈古戍，雕影转寒沙。"],0,69,"宋"],["句 其七十二","释惠崇","残句",["月露疏寒析，云涛闪画旗。"],0,69,"宋"],["句 其二","宗必经","残句",["不觉授书冬再易，我思暴霸欲消魂。"],0,96,"宋"],["句 其七","夏竦","残句",["似法阴爻呈六穗，或符阳数效三岐。"],0,12,"宋"],["句 其三","杨长孺","残句",["过眼一春春又夏，开残芍药更无花。"],0,170,"宋"],["句 其七","杨蟠","残句",["仲□尝三逐，将军老数奇。"],0,62,"宋"],["句 其十一","黄庭坚","残句",["浴泉秦虢流丹粉，临渚娥英冷佩衣。"],0,"x66","宋"],["句  其二","袁说友","残句",["坐来客子浑忘倦。"],0,"x192","宋"],["句  其七八","释晓莹","残句",["故人携客作幽寻。"],0,182,"宋"]]