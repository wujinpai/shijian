[["寄曹鲁川 其三","杨起元","四言",["自冬徂春，万汇聿新。","乐只君子，遐不显仁。","抽丝若茧，敷葩如神。"],0,53,"明"],["寄曹鲁川 其四","杨起元","四言",["春徂兹夏，示我藻火。","折简绝韦，大过而可。","愿言努力，旴江则那。"],0,53,"明"],["自警四首 其二","杨起元","四言",["璞则既真，攻之惟人。","其顽其块，孰圭如绅。","如彼四子，何必兼身。","文之礼乐，亦可成人。"],0,53,"明"],["自警四首 其三","杨起元","四言",["小子弗类，日中始慧。","荏苒衰颓，忧心如醉。","肇允不雕，可用为佩。","知非已晚，斯吝斯悔。"],0,53,"明"],["自警四首 其四","杨起元","四言",["矢其自兹，是攻是治。","慎尔威仪，修尔言辞。","前言往行，是效是师。","潜神涤虑，母遂尔非。"],0,53,"明"],["艾如张","温纯","四言",["郁郁灌木，众鸟嘤嘤。","临深酌酒，亦可怡情。","有鸟有鸟，鷕鷕其鸣。","厥德耿介，厥质文明。","嗟贾如皋，但慱偶声。","恐逢鸷鸟，触树致惊。","以媒下翳，以艾藏形。","庶几我获，为吾友生。"],0,67,"明"],["公无渡河","温纯","四言",["公无渡河。","陆行坦坦，尚有风波。","河水不测，盘涡实多。","深不可厉，内藏鼋鼍。","得人则食，不知其佗。","公无渡河。","虽有舟楫，吞舟奈何。","长年辟易，如见网罗。","不如安卧，饮酒高歌。","公无渡河。"],0,67,"明"],["飞鲸楼诗","释妙声","四言",["崇楼言言，上下太清。","鸣钟在悬，飞鲸是名。","在昔先民，制器尚形。","取类相感，用谹其声。","此方真教，由闻而入。","诞敷法音，昭我玄极。","假物以鸣，与世作则。","震惊大千，群响俄息。","维此积善，灵僧之宫。","爰作斯楼，警昏启蒙。","侯谁尸之，曰沙门惠。","公胡溃于，成矢誓在。","躬瞻彼飞，楼峙于东。","海华䲔在，兹蒲牢震。","骇苦轮乃，轫音场无。","碍于千万，年迷者永。"],0,198,"明"],["圭复庵贫乐斋","释妙声","四言",["贫非乐也，乐惟道义。","匪哲弗居，孰云细事。","室如悬磬，俯仰无愧。","终身欣然，何忧何惧。","矧伊吾人，宗自西方。","一饭候晷，三宿于桑。","彼上人者，如圭如璋。","肆求懿德，其居允臧。","载瞻其居，有琴有书。","亦有嘉宾，来与我娱。","草衣藜羹，屡空晏如。","从吾所好，有乐只且。","往有钟鼎，弗慎弗守。","彼有荣观，弗图弗究。","沦胥以亡，亦孔之丑。","我作是诗，以咏座右。"],0,198,"明"],["蒲庵","释妙声","四言",["循彼南涧，言采其蒲。","采之何为，滫瀡是图。","彼蒲之良，利用为屦。","载缉载䌷，如蓺稷黍。","我思古人，惟睦之陈。","克用是道，甚宜其亲。","我行四方，十年于今。","母寔有命，余何弗钦。","乃筑我居，于越之野。","悠悠我思，朝夕于楚。","乱离孔怃，山川邈悠。","岂不怀归，水无行舟。","爰有清泉，在居之侧。","既浸既灌，蒲叶嶷嶷。","蒲叶嶷嶷，蒲生日多。","母氏燕喜，我劳其何。"],0,198,"明"],["藏晖斋诗","释妙声","四言",["易贵含章，诗称养晦。","进德以愚，明道若昧。","瞻彼曜灵，运无停机。","匪息于渊，害恒其晖。","君子则之，以恬养志。","出处语嘿，弗愆于义。","继我显祖，庶免以之。","或升或潜，允也其时。","其时维何，像季师表。","骏奔东南，于今有耀。","世殊事往，手泽尚存。","天相斯文，佑我后人。","于乎小子，思绳厥武。","丕若诒谋，无念尔祖。","无念尔祖，淑慎其躬。","爰作是诗，式铭尔胸。"],0,198,"明"],["箕山操","刘炳","四言",["清流泱泱，箕山之阳。","樛木森森，箕山之阴。","嗟嗟巢父，岂洗其耳，实洁其心。"],0,39,"明"],["同云","刘炳","四言",["同云四翳，零雨其滂。","虎啸谷风，凤鸣朝阳。","吕望归周，尹挚佐汤。","仲父齐霸，诸葛汉昌。","气以类感，道由义彰。","功济九有，千载之光。"],0,39,"明"],["邕熹","刘炳","四言",["圣人务德，蠲烦去苛。","既舞干羽，载奏云和。","八表雍雍，含哺而歌。","彩霁钩陈，景融羲娥。","昆仑永峙，渤海不波。"],0,39,"明"],["引声歌","沈谦","四言",["外极莽苍，内保精粹。","至人不言，四时咸备。","理不出身，道不在智。","形体块然，神明所寄。","虚心实腹，抱道守真。","大化回薄，与仙者邻。","运斡圆象，敷匝广轮。","阴阳不害，庶得平均。"],0,64,"清"],["述怀五咏 其一","刘麟","四言",["今我乐矣，叙旧以贤。","瞻彼明德，不以厥年。","生事匪多，尺宅寸田。","暮色惟瞑，返照复鲜。","君子保终，夕厉愓然。","载我玄酒，践彼初筵。","悠悠我心，无怀葛天。"],0,186,"明"],["述怀五咏 其二","刘麟","四言",["今我乐矣，尘劳靡夕。","俯仰褒然，乾坤归宅。","冠盖各天，妻孥在侧。","知己辰星，道途扫迹。","空谷足音，使我太息。","返照入林，牛羊是则。"],0,186,"明"],["述怀五咏 其三","刘麟","四言",["今我乐矣，自春徂秋。","高人用息，志士乃愁。","终风急雨，恐撼吾楼。","楼有真人，邈不可求。","求而得之，泛我轻舟。","三山何许，垂老一游。","石川野航，曰予销忧。","龙骧虎变，挟小九州。"],0,186,"明"],["述怀五咏 其四","刘麟","四言",["今我乐矣，爰即我谋。","陂塘雨足，上下其流。","百年垂尽，寄兴孤舟。","华胄玉台，浮游石头。","群阴蔽空，百神在楼。","此夕何夕，梦游九州。","初随枕蝶，终执沙鸥。","兴倦而觉，再梦再忧。","空谷多鬼，其声啾啾。"],0,186,"明"],["述怀五咏 其五","刘麟","四言",["今我乐矣，渐解尘缘。","藏修还谧，始于今年。","八十有六，十一师签。","同生之士，艾耄涸然。","我孙森森，玉立满前。","仰忆宗祧，瓜瓞绵绵。","升高有屐，临流有船。","邀我良友，矢我新篇。","退休于室，守真尚玄。","不忮于人，不求于天。","诏尔后人，勿忘勿愆。"],0,186,"明"],["和陶停云四章怀吴中友人","陈履","四言",["行道迟迟，以风以雨。","眷言吴门，千里修阻。","摇摇扁舟，孤篷独抚。","临风怀人，终夕延伫。","沧江之上，烟树空蒙。","云闲幽谷，月湛澄江。","中有美人，寄傲南窗。","我之来兮，愿言尔从。","池草春绿，庭树秋荣。","嗟我美人，有媚余情。","爰戒方舟，速速于征。","期对尊酒，话我平生。","蝉鸣哕哕，自彼林柯。","残暑将退，凉风渐和。","思我友生，寤怀孔多。","倏尔相见，欢如之何。"],0,30,"明"],["贰吴再期忧在鳏旷今践故秩兢惕中怀和荣木四章庸自策励云尔","陈履","四言",["瞻彼日月，奄忽如兹。","皇皇四方，行将安之。","伊昔在吴，曾几何时。","于斯来复，中心恧而。","惟涧有松，不移其根。","惟谷有兰，幽芳自存。","藐予孤踪，依依吴门。","依依何为，俗美且敦。","伊昔百僚，无如余陋。","古亦有言，用人惟旧。","五斗非贫，闻善斯富。","夜寐夙兴，怯此内疚。","疾行多踬，高居或坠。","静言念之，奈何不畏。","但自策蹇，敢曰希骥。","我闻跛鳖，千里可至。"],0,30,"明"],["和劝农六章","陈履","四言",["天职生物，地职养人。","裁成辅相，职为圣真。","兹曰三才，一理所因。","地平天成，我思古人。","亩亩高原，宜尔黍稷。","眷此泽国，嘉稻斯殖。","惟水利农，亦以害穑。","水患既蠲，民乃可食。","余起海滨，跋涉川陆。","帝命来吴，令佐熙穆。","官守不恪，焉逭斥逐。","是用虚怀，询于耆宿。","众靡惮劳，劳暂逸久。","联尔比邻，结尔同耦。","固尔堤防，易尔田亩。","谋则协心，作则胼手。","农夫望岁，冀勿空匮。","无鳏厥官，时余所冀。","百川告驯，灾害不至。","庶免素餐，祛我中愧。","莫匪王事，农务奚鄙。","宗伯硕人，实迪余履。","通力合作，选农遗轨。","尔众听之，嘉言洵美。"],0,30,"明"],["何氏弟衷远宦滇南矢言送之爰念祖德和赠长沙公族祖四章","陈履","四言",["思我与子，二姓匪疏。","异流同源，曷求其初。","祖德长存，不与世徂。","眷言念之，对子踌躇。","尔祖肯构，同心有堂。","甥馆伊谁，陈琳孔璋。","叹息代迁，春雨秋霜。","觌尔好修，门阀弥光。","清时筮仕，喜与子同。","所嗟歧路，自此西东。","子趋泔海，吾往平江。","不有塞鸿，芳讯孰通。","别且万里，赠子何言。","仕比涉川，学如登山。","仕学相须，今古同然。","共期努力，毋忝厥先。"],0,30,"明"],["和酬丁柴桑二章赠临清周贰守干周名家子也以贡入仕而为卑官余欲广其志和是诗赠之","陈履","四言",["行道悠悠，曷维其止。","名家之驹，行必千里。","范尔驰驱，爱自兹始。","王道荡荡，古今所由。","上曷以喜，下曷以忧。","忧乐同民，政是用休。","惟此鲁邦，惬君壮游。"],0,30,"明"],["和答庞参军六章寄赠刘楚相子敦","陈履","四言",["忆昔海阳，我勤簿书。","君至自楚，我心则娱。","茹蘖示操，哦松名居。","矫矫玉珂，人中衡庐。","君本世胄，才为世珍。","匪矫匪傲，温其可亲。","吐英露华，裨余劣人。","赫赫贤声，明作照邻。","相助为理，夙夜孜孜。","我有阙遗，君则补之。","彼此和衷，播于声诗。","声诗云何，无邪尔思。","余遘闵凶，倏与子分。","掩涕相送，戚然不欣。","迢迢粤树，英英楚云。","贻我简书，塞鸿时闻。","君既宰邑，单父琴鸣。","膏泽斯降，甘霖载零。","今古循良，莫之与京。","倾耳弦歌，子心则宁。","长沙贾傅，我闻其风。","谁则为之，绛灌在中。","赫赫楚藩，好贤有终。","君德无瑕，宜裨王躬。"],0,30,"明"],["寂居蓟门岁聿云暮爰睹栖鸟怅然兴怀和归鸟四章","陈履","四言",["嗟嗟倦鸟，夕投风林。","岂无故栖，远隔云岑。","欲求友声，孰明其心。","聊尔戢翼，息此丛阴。","嗟嗟倦鸟，载鸣载飞。","云霄既遐，霜林焉依。","顾瞻南枝，矢言遄归。","求匹时雏，庶几靡遗。","嗟嗟倦鸟，从风徘徊。","无心高翔，愿言卑栖。","安得旧侣，同声和谐。","爰止邱隅，惬哉夙怀。","嗟嗟倦鸟，集于霜条。","伊昔春明，园列荣标。","振羽翩翩，鸣声交交。","今如之何，奋翼为劳。"],0,30,"明"],["齐地久旱途有迁民膏雨既沾草木欣畅和时运四章以谕迁者","陈履","四言",["天降时雨，亦既崇朝。","彼黍油油，秀色盈郊。","为尔百室，稽首玄霄。","愿言自今，载膏尔苗。","四野欲枯，一雨如濯。","欣欣农人，妇子相瞩。","忧怀以蠲，生计聊足。","庶几有秋，室家胥乐。","河流荡荡，沛如清沂。","雨泽沾足，田园应归。","尔舟遄返，尔锄亟挥。","毋远乡土，悔不可追。","苍苍有生，乐在园庐。","天时暂愆，尔行焉如。","一失桑梓，杳如蓬壶。","吾言匪啖，尔则听余。"],0,30,"明"],["赠魏太守考迹五章","霍韬","四言",["采菊采菊，于樵之眉。","手算金英，口衔金卮。","金英馨芬，金卮刚而。","采菊英支，蘸金刚卮。","持赠远人，薄慰远思。","采菊采菊，于樵之巅。","菊英佩韦，菊英佩弦。","菊英插髦，菊英任肩。","采采菊英，聊以永年。","持赠远人，聊慰各天。","采菊采菊，于樵之侧。","上有流云，侧有兀石。","菊根千龄，菊华千日。","插发怀哉，瞻天北极。","持赠远人，远人之德。","采菊采菊，于樵之下。","佩菊以归，薄言夙夜。","佩菊以归，薄言绘画。","我菊之英，邈不以价。","持赠远人，作远别话。","采菊采菊，于樵之岨。","樵云飞飞，樵厓楚楚。","破樵云丛，蹑樵厓砢。","采樵采樵，自我自我。","持赠远人，实获我所。"],0,201,"明"],["万竹轩五章","霍韬","四言",["增城老子，有竹万根。","根根扫云，根根成阴。","增城老子，荷锄朝行。","锄竹之墩，培竹之萌。","薪竹之枝，遥竹之琴。","七八十年，作竹主人。","增城老子，亦到西樵。","到九龙岩，蹲岩之腰。","绕岩曲腰，植竹十条。","像万竹墩，聊亦逍遥。","增城老子，亦到白沙。","白沙先生，谓多竹家。","竹以逼俗，一根则足。","况于千竹，况于万竹。","增城老子，亦到石头。","石头先生，偕之遨游。","道峰竹墩，老子则留。","谓渠家物，谓渠好逑。"],0,201,"明"],["于穆赠袁少司徒也袁公三十年显仕犹敝廛一庐","霍韬","四言",["于穆袁公，绩德耆年。","德绩之征，征德于天。","袁公征德，是身一廛。","袁公一廛，皓鬓周还。","维是一廛，袁公是便。","乃强袁公，踧踖日边，华发实研。","上林鹳鸾，瀛沿朝烟。","冲彼朝烟，舆徒是联。","舆徒是联，冲上林烟。","听上林歌，歌卷阿篇。","圣人载歌，被是五弦。"],0,201,"明"],["圜丘乐章九首 其一 迎神","霍韬","四言",["于维明命，佑我皇祖。","肇我土宇，曰予冲人，缵祖之绪。","荷天之休，锡民之祜。","式虔报祀，阳复之期。","式率髦士，骏奔祈祈。","明明帝德，佑我皇祖，昭格坛壝。"],0,201,"明"],["圜丘乐章九首 其二 奠帛","霍韬","四言",["昊天在上，我祖在侧。","我奠我币，于焉踧踖。","昊天在上，我祖在傍。","我奠我币，于焉皇皇。","天佑皇祖，锡我民祜。"],0,201,"明"],["圜丘乐章九首 其五 亚献","霍韬","四言",["酒兮靡旨，诚兮靡已。","馨德是砥，慎终如始。","酒兮靡清，诚兮靡宁。","馨德是绳，奏假明明。"],0,201,"明"],["圜丘乐章九首 其八 送神","霍韬","四言",["巍巍荡荡，帝德无象。","无曰无象，昭昭在上。","荡荡巍巍，帝德无为。","无曰无为，下式九围。","服帝之德，朝乾夕惕。","庶几无斁，帝心亦怿。"],0,201,"明"],["赠戚邑侯遐思诗四章","霍韬","四言",["天王圣神，普念我民。","惠有贤侯，借春于南。","侯燠我衣，侯饲我饥。","侯之去矣，入于王畿。","我攀侯辕，薄慰我思。","天王圣神，念我南海。","惠有贤侯，于我邑宰。","维侯则慈，维政弗私。","侯之去矣，入于天墀。","我攀侯辕，薄慰我思。","天王圣神，念我南人。","惠有贤侯，俾乂我民。","维侯则仁，维政则均。","侯之去矣，遥遥车音。","我攀侯辕，薄慰我心。","天王圣神，念我民隐。","惠有贤侯，恤我艰窘。","侯刑则轻，侯赋则省。","侯之去矣，孰嗣徽音。","我攀侯辕，薄慰我心。"],0,201,"明"],["秋江饯别诗再赠巴山","霍韬","四言",["鳌峰怅别，情未已也，溯流撑舟。","追随楼航，直指灵洲，憩舟灵洲。","陟妙高台，伫超然堂，倚松挂眸。","抱此离忧，言言离忧，情未已也。"],0,201,"明"],["征西诗","霍韬","四言",["蠢蠢氓蛮，跨谷负山。","山高谷深，大遂厥顽。","为妖为残。","残兹西土，百斯民艰。","民艰孔棘，氓毒孔威。","民之室家，不保狐绥。","民之宅里，荡覆流离。","我民流离，蛮谓得逞。","大作不靖，剽攘驰骋。","我民摇摇，不保首领。","天子曰嗟，民之病矣，蛮之竞矣。","谁其绥之，俾之定矣。","谁与元老，授之柄矣。","元老授命，拜手稽首。","赫将天威，誓歼群丑。","誓师桂林，椎牛酾酒。","虎贲洸洸，虎旗扬扬。","阖围四塞，震天四方。","跨山爬溪，以诛以攘。","以诛以攘，先其渠魁。","纵其胁从，宥之归来。","贼巢为灰，贼血贼膏，污之草莱。","民贼斯除，民生斯宁。","集有师功，奏功朝廷。","勒之鼎彝，永纪厥成。","天子有命，纪正纪勋。","维此元老，克平大憝。","胙之爵秩，匪止其身，及其子孙。"],0,201,"明"],["乐府十二首（嘉靖丙寅作） 其五 展陵","皇甫汸","四言",["帝眷园寝，谒款丘陵。","驰道旦筑，行殿宵营。","亘帷成屋，列幔为城。","般云谢巧，周日非灵。","干行玉辇，坤御金舆。","六宫婉从，万国宾趋。","銮铃响递，环佩声徐。","五臣供帐，百辟燕酺。","朱明司辰，清和肇节。","草树蒙恩，禽鱼腾悦。","周历皇畿，轸兹民业。","遐揽边关，洪思祖烈。","去遵鸾辂，归泛龙舟。","山开阳翠，川效安流。","柔情并畅，睿藻扬休。","枚朔第颂，翎赞王猷。"],0,59,"明"],["读书乐","李贽","四言",["天生龙湖，以待卓吾。","天生卓吾，乃在龙湖。","龙湖卓吾，其乐何如。","四时读书，不知其余。","读书伊何，会我者多。","一与心会，自笑自歌。","歌吟不已，继以呼呵。","恸哭呼呵，涕泗滂沱。","歌匪无因，书中有人。","我观其人，实获我心。","哭匪无因，空潭无人。","未见其人，实劳我心。","弃置莫读，束之高屋。","怡性养神，辍歌送哭。","何必读书，然后为乐。","乍闻此言，若悯不谷。","束书不观，吾何以欢。","怡性养神，正在此间。","世界何窄，方册何宽。","千圣万贤，与公何冤。","有身无家，有首无发。","死者是身，朽者是骨。","此独不朽，愿与偕殁。","倚啸丛中，声震林鹘。","歌哭相从，其乐无穷。","寸阴可惜，曷敢从容。"],0,29,"明"],["三吴山愚翁先生晚喜禅学辛酉秋繇闽入粤访金抚军携其小照坐立二图及海内诸公题赞出以相示予曰立坐者人得见而题之矣其不立不坐者将何居先生笑而不答因作四言三章而括以七绝书之卷末求质正焉","梁宪","四言",["巍巍独立，为世之则。","用舍行藏，神龙莫测。","凝然内照，静观其妙。","其妙为何，不言而笑。","立观其体，坐观其用。","坐立俱忘，天真自动。"],0,87,"明"],["题施安友于堂","龚敩","四言",["稽山苍苍，越之故疆。","惟子之居，肯构肯堂。","埙篪相须，华萼联芳。","孝友之性，发乎天常。","道与时泰，名与世昌。","金玉怡怡，德音弗忘。","凊温有宜，就养无方。","旨酒嘉肴，吹笙鼓簧。","秋月澄霁，春日载阳。","彩袖齐翻，于乡有光。","稽山峨峨，越流息波。","尔弟尔昆，如江如河。","立孝惟亲，立敬惟和。","贤哉闵生，名冠四科。"],0,75,"明"],["水居 其一","高攀龙","四言",["微雨乍过，好风徐来。","游云断续，众峰皆开。","欢然抚景，尽兹一杯。","世事如积，亦巳焉哉。"],0,35,"明"],["水居 其二","高攀龙","四言",["饭饱欣然，荡桨菰芦。","菱蔓摇漾，莲云芳敷。","今日何日，吾长五湖。","其来徐徐，其去于于。"],0,35,"明"],["水居 其三","高攀龙","四言",["举网得鱼，摘我园蔬。","享鱼煮蔬，载陈我书。","酒中有旨，书中有腴。","聊尔东窗，不乐何如。"],0,35,"明"],["水居 其四","高攀龙","四言",["薄苒登楼，四望远畴。","时雨既降，农人乍休。","乳燕来止，焂鱼出游。","万族有乐，吾亦无忧。"],0,35,"明"],["水居 其五","高攀龙","四言",["涉世愈拙，入山宜深。","踽踽空谷，悠悠长林。","支颐一卷，挂壁孤琴。","游目闲云，倾耳鸣禽。"],0,35,"明"],["水居 其六","高攀龙","四言",["清昼埽室，中宵拥衾。","无象之色，希声之音。","咎誉可远，阴阳不侵。","虽乖通理，爰得我心。"],0,35,"明"],["独漉篇四首 其一","何瑭","四言",["独漉独漉，水深没毂。","不畏没毂，但畏车覆。"],0,85,"明"],["独漉篇四首 其二","何瑭","四言",["独寝中夜，凉飙袭襟。","不能告人，祗伤我心。"],0,85,"明"],["独漉篇四首 其三","何瑭","四言",["洪水汤汤，神禹既导。","槩云自天，谁宅四隩。"],0,85,"明"],["独漉篇四首 其四","何瑭","四言",["龙恶可驯，虎猛可刺。","岂其无方，使我心瘁。"],0,85,"明"],["箜篌引","王叔承","四言",["公无渡河，河不公惜。","黄河犹可，奈此河伯。"],0,47,"明"],["瑞雪诗并序","林文俊","四言",["天生圣人，为民立极。","六合顺轨，九围承式。","惟辟奉天，惟以乂民。","民物乃康，祥祯聿臻。","于赫圣皇，允惟民主。","仁覆普天，德超邃古。","时维仲冬，雨雪愆期。","圣心恻然，轸我民饥。","曰灾所由，厥咎在朕。","我其躬祷，为民请命。","斋肃郊坛，庭燎有辉。","大君戾止，淠淠龙旗。","既类既旅，对越在上。","神监孔昭，锡之灵贶。","始自西北，有渰浮浮。","迨于既夕，望之油油。","诘旦礼成，雪霰交集。","飞若玉屑，化为琼液。","匪亟匪徐，巧当其时。","惟帝克诚，昭假不迟。","弥望皑皑，藏污掩慝。","其令所加，岁无螟蜷。","既沾既足，我亩我疆。","其兆维何，丰年穰穰。","颂声载路，既阜民生，乃永皇祚。","勿谓蚩蚩，民惟邦畿。","勿谓茫茫，天高听卑。","天难忱斯，惟德是保。","惟皇祗德，奉若天道。","厥德不回，受禄于天。","臣拜稽首，天子万年。"],0,27,"明"],["与观非和尚","黄锦","四言",["日观其非，何者为是。","是非两忘，山飞水峙。"],0,157,"明"],["殉难日作三首 其二 示汋儿","刘宗周","四言",["子职未伸，君恩未报。","当死而死，死有馀悼。"],0,22,"明"],["归樵操","张宇初","四言",["我巢于林，孰觌其忧。","伊我遐慕，曷敢不繇。","怀古之人，惟守我常。","樵斯我采，胡使我伤。","彼牛有蔚，我往曷铚。","世莫予心，奚悲我音。"],0,137,"明"],["山居五戒一戒讲学","唐伯元","四言",["我曰予贤，人曰予圣。","果圣且贤，相悦而静。","况汝之德，未满乡里。","况汝之道，未行妻子。","呶呶哓哓，盖不知耻。"],0,84,"明"],["二戒预外事","唐伯元","四言",["仁者爱己，义者正己。","枉己直人，所济有几。","匹夫之行，可化乡人。","既明且哲，以保其身。"],0,84,"明"],["三戒酬应诗文","唐伯元","四言",["赋性太轻，溢道人美。","无益于人，且先失己。","搜肠刻骨，博润笔金。","可怜多病，老去光阴。"],0,84,"明"],["四戒赴席","唐伯元","四言",["小席百钱，大席一金。","何功何能，为世所钦。","竟日嗛嗛，疏懒难支。","夜深人静，我读书时。"],0,84,"明"],["五对客戒谈时政","唐伯元","四言",["生逢唐虞，明良岳牧。","不学贾生，流涕痛哭。","物之不齐，人孰无过。","反己责躬，是我工课。"],0,84,"明"],["警志诗","施闰章","四言",["洋洋景运，六辔徂流。","尔征尔迈，不我眷留。","维帝赉予，靡德不具。","既具既完，逝不我顾。","拾穗虽利，不如躬耕。","束炬夜驰，不如早行。","鸱争腐鼠，凤餐竹食。","翔视千仞，下罕雏匹。","懿我祖考，争道策骥。","腹我目我，遑敢陨坠。","昔游东鲁，摄衣孔庭。","俯仰瞻听，实迩仪型。","匪哀匪慕，泣涕如雨。","怆如亡子，初见父母。","轨臻回赐，文企姬秦。","不惭爝火，持照千春。","陨霜警木，世难厉德。","怀璧负途，智士不惑。","猿则穴果，獭则祭鱼。","谁为令人，不勤是图。","皇皇朝夕，望晷心栗。","如岸斯崩，如虎将咥。","冉苦抱疴，颜不待耇。","敬尔良时，并宵作昼。"],0,104,"清"],["祭祖乐章三首 其一 初献","王樵","四言",["于惟王氏，代有令人。","春寿胜义，不事污君。","戊申圣作，宇宙更新。","诚斋快睹，饮水衔恩。","伯兄不吊，误挂吏文。","击鼓上书，远叩天阍。","帝曰俞哉，事竟报闻。","抚其遗孤，三世不分。","付以筦钥，让以藏金。","爰有文子，一德同心。","积善馀庆，及我后昆。"],0,37,"明"],["祭祖乐章三首 其二 亚献","王樵","四言",["兴衰之效，于古有征。","恒由浑厚，以开文明。","文明既开，浑厚渐失。","谓偶可常，至于骄佚。","溯流知源，先祖是思。","凡我后人，敬而听之。"],0,37,"明"],["祭祖乐章三首 其三 终献","王樵","四言",["宗人来止，其萃如云。","祖考视之，其初一人。","分形连气，有百其身。","孰谓同宗，可不同心。","愿言不昧，祖考如临。","岁时休享，常我顾歆。"],0,37,"明"],["劝农诗 其一","区大枢","四言",["泛彼谷风，鼓荡大和。","农辰既届，我庶如何。","无趼于陆，无滥于河。","以缘南亩，慎勿之讹。"],0,44,"明"],["劝农诗 其二","区大枢","四言",["袯斯襫斯，曷秉尔镃。","芟厥茂草，窒彼荒岐。","尔田不臧，谁则女诒。","畇畇濯濯，罔或予埤。","狎其疆畔，无昵尔茨。","率彼妇子，往馌东菑。"],0,44,"明"],["淋雨叹","区大枢","四言",["渰渰伏雨，浩浩洪泉。","溢霤决渠，沉涂塞渊。","堂阶藓积，屋瓦蜗缘。","车有停轨，突无常烟。","经旬杜户，累日如年。","嗟尔贫士，长歌自怜。"],0,44,"明"],["梁父吟","张时彻","四言",["朝上泰山，郁何盘盘。","崩崖薛嵥，石齿阑班。","虺蛇横树，虎豹当关。","憭哉栗栗，曷以盘桓。","暮上泰山，白日西匿。","前有榛莽，后有鬼蜮。","道险天寒，饥不得食。","欲见云君，何由可得。","泰山巍巍，鲁邦所宗。","智矣齐相，七国之雄。","二桃何甘，以杀三士。","惟其忍心，嗟嗟晏子。","虞罗藏机，蜂虿致螫。","口舌之微，惨惨戈戟。","长沙窜谊，汨罗沉平。","谁为始祸，嗟嗟晏婴。"],0,48,"明"],["渔樵耕读四首 其一","任环","四言",["明月扁舟，芦花浅水。","鱼无深愁，漫兴而已。"],0,210,"明"],["渔樵耕读四首 其二","任环","四言",["云山砍破，挑此一肩。","留彼新松，以待参天。"],0,210,"明"],["渔樵耕读四首 其三","任环","四言",["一犁春雨，万顷秋风。","击壤而歌，伊谁之功。"],0,210,"明"],["渔樵耕读四首 其四","任环","四言",["刺股悬梁，囊萤映雪。","达之思兼，穷亦归洁。"],0,210,"明"],["应尽须尽吟 其一","顾允成","四言",["应尽须尽，行法俟命。","剖破形骸，朗然独运。"],0,82,"明"],["应尽须尽吟 其二","顾允成","四言",["应尽须尽，没宁存顺。","朝闻夕可，三复斯训。"],0,82,"明"],["应尽须尽吟 其三","顾允成","四言",["应尽须尽，万缘息净。","啼泣满前，松风入听。"],0,82,"明"],["应尽须尽吟 其四","顾允成","四言",["应尽须尽，颜子短命。","加我数年，亦已过分。"],0,82,"明"],["应尽须尽吟 其五","顾允成","四言",["应尽须尽，天地混沌。","矧伊人兮，妄生执吝。"],0,82,"明"],["应尽须尽吟 其六","顾允成","四言",["应尽须尽，尽亦非尽。","返于太极，寓诸无竟。"],0,82,"明"],["应尽须尽吟 其七","顾允成","四言",["应尽须尽，非尽亦尽。","太极无极，何始何竟。"],0,82,"明"],["寿谈勉翁","顾允成","四言",["矍铄勉翁，八十如童。","头有异骨，足下生风。","饮食衎衎，论说融融。","图书满壁，芝兰郁蓊。","陶家之酒，饮可三泛。","邵氏之篇，吟且百筒。","我歌南山，耋寿其逢。"],0,82,"明"],["求儆里言 其一","顾允成","四言",["圣哉仲尼，五十无过。","惟圣希天，愚敢托大。"],0,82,"明"],["求儆里言 其二","顾允成","四言",["贤哉伯玉，五十知非。","惟士希贤，愚敢有违。"],0,82,"明"],["求儆里言 其三","顾允成","四言",["仲尼知命，伯玉知非。","出命入非，君子见几。"],0,82,"明"],["求儆里言 其四","顾允成","四言",["五十始衰，戒之在色。","莫庇斧斤，好是懿德。"],0,82,"明"],["求儆里言 其五","顾允成","四言",["五十无闻，斯不足畏。","回首后生，惊汗如沸。"],0,82,"明"],["求儆里言 其六","顾允成","四言",["舜其至孝，五十而慕。","予有父母，欲报无路。"],0,82,"明"],["三月三日社集东皋 其一","欧主遇","四言",["我皇九载，永和期合。","蔼蔼时彦，晋人可作。","东园之树，秾华未落。","于以晤言，曲水为乐。"],0,23,"明"],["三月三日社集东皋 其二","欧主遇","四言",["有鸟和鸣，茂林集止。","春酒既载，春服以试。","薄言采兰，于水之涘。","歌以写心，祓禊匪戏。"],0,23,"明"],["自警 其一","贺钦","四言",["婴儿之态，终身之谋。","人知是务，同俗是求。","卑污凡近，日趋下流。"],0,81,"明"],["自警 其二","贺钦","四言",["大人之度，天下之虑。","天知是祈，同理是顾。","高明光大，天衢放步。"],0,81,"明"],["翰林同年绘像图六首 其一","吴希贤","四言",["岁聿云暮，玉河之堧。","霰雪澄霁，风日清妍。","君子有酒，来我同年。"],0,18,"明"],["翰林同年绘像图六首 其二","吴希贤","四言",["惟岁甲申，圣人临御。","风虎云龙，邂逅相遇。","登我诸友，玉堂之署。"],0,18,"明"],["翰林同年绘像图六首 其三","吴希贤","四言",["玉堂巍巍，亦曰瀛洲。","十载登兹，以遨以游。","愿言相勖，无沗前修。"],0,18,"明"],["翰林同年绘像图六首 其四","吴希贤","四言",["房杜既远，孰为我师。","协力同心，惟王之毗。","云胡十载，而多仳离。"],0,18,"明"],["翰林同年绘像图六首 其五","吴希贤","四言",["如彼抟沙，易涣以散。","今者具在，式燕以衎。","获菽采萧，逢此岁晏。"],0,18,"明"],["翰林同年绘像图六首 其六","吴希贤","四言",["既搦尔管，亦抚尔琴。","嗟我诸友，东西北南。","言笑云云，实谐我心。"],0,18,"明"],["安东平 其一","景翩翩","四言",["西风吹衣，北风吹面。","郎既相迎，郎心未变。"],0,32,"明"],["安东平 其二","景翩翩","四言",["驱车终日，留侬喘息。","徐语向郎，郎意毋亟。"],0,32,"明"]]