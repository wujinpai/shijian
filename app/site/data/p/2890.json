[["送仲卿禅德","释重显","四言",["高兮竺卿，秋水虚明。","夫何之象，堪云指程。","知吾不知，笑伽耶城。"],0,"x156","宋"],["绍熙四年加上寿圣皇太后尊号八首 其八","郊庙朝会歌辞","四言",["宝册既奉，祗诵乃言。","仁深庆衍，益显益尊。","和声协气，充溢乾坤。","并受伊嘏，圣子神孙。"],0,"x207","宋"],["熙宁祀皇地祇十二首 其一 迎神用《导安》。","郊庙朝会歌辞","四言",["昭灵积厚，混混坤舆。","配天作极，阴惨阳舒。","齐明荐享，百福其储。","庶几来止，风马云车。"],0,"x207","宋"],["题郑子实秋溪钓雨图","陆文圭","四言",["水墨淡淡，烟雨蒙蒙。","溪抱前山，人倚孤篷。","我怀季鹰，感慨秋风。","身羁洛下，兴寄吴淞。"],0,"x149","宋"],["米元章临笔精日寒二帖赞","岳珂","四言",["义献之迹，临者米也。","溯观欣书，乃二体也。","随珠卞璧，萃此纸也。","以鉴得之，亦可纪也。"],0,"x202","宋"],["景祐亲郊三圣并侑二首 其二 酌献用《彰安》。","郊庙朝会歌辞","四言",["皇基缔构，帝系灵长。","躬荐郁鬯，子孙保昌。"],0,"x207","宋"],["崧高诗为九江赵使君寿  其九","杨冠卿","四言",["周邦咸喜，式歌且舞。","于时语语，厥声载路。"],0,61,"宋"],["宋江三十六赞 其二十六 青面兽杨志","龚开","四言",["圣人治世，四灵在郊。","汝兽何名，走旷劳劳。"],0,103,"宋"],["宋江三十六赞 其二十九 两头蛇解珍","龚开","四言",["左啮右噬，其毒可畏。","逢阴德人，杖之亦毙。"],0,103,"宋"],["魏京诗 其二","刘敞","四言",["皇曰卿士，在昔圣考。","祗遹文武，维慈幼老。"],0,"x51","宋"],["建隆郊祀八首 其二 皇帝升降用《隆安》。","郊庙朝会歌辞","四言",["步武舒迟，升坛肃祗。","其容允若，于礼攸宜。"],0,"x207","宋"],["偈","黄希旦","四言",["地水火风，强名四大。","迷荡真源，种种憎爱。","咄哉憨痴，会即便会。","云散月明，朗同沙界。"],0,252,"宋"],["淳化乡饮酒三十三章  其二○","郊庙朝会歌辞","四言",["郁郁芳兰，幽人撷之。","温温恭人，哲后求之。"],0,"x207","宋"],["魏京诗 其一","刘敞","四言",["皇作大都，大都雄雄。","奄定北国，四方来同。"],0,"x51","宋"],["淳熙三年发皇后册宝十三首 其八","郊庙朝会歌辞","四言",["备物典册，乐之鼓钟。","拜而受之，极其肃雍。","司言司宝，各以职从。","行地有庆，与天无穷。"],0,"x207","宋"],["嘉泰三年皇后册宝十三首 其十二","郊庙朝会歌辞","四言",["金石具举，典礼茂明。","淑慎其止，遹观厥成。","琼琚微动，凤辇翼行。","仪光媲极，德迈嫔京。"],0,"x207","宋"],["偈颂十八首 其二","释广闻","四言",["捻聚放开，放开捻聚。","黄面瞿昙，无回避处。"],0,10,"宋"],["读冯道传","郑起","四言",["西山有薇，二子采之。","二子竟死，薇不疗饥。","匪恶周粟，食不下咽。","君臣义重，彼苍者天。","尔道何人，数主一身。","有何颜面，冠冕搢绅。","乔固诸贤，宁死道边。","曹操不帝，清议凛然。"],0,205,"宋"],["大宋中兴颂","周紫芝","四言",["缅维圣宋，昔在中叶。","四方多虞，万里喋血。","大臣持谋，兴师肆伐。","将臣持兵，日献戎捷。","皇帝曰吁，黩武无烈。","糜我赤子，膏我斧钺。","孰与休师，一戟不折。","因垒而降，舞干而悦。","闭我玉关，归师解甲。","犁我春田，销兵铸铁。","使命交通，相望不绝。","爱惜两朝，前师圣说。","昭陵之仁，嘉祐之业。","念昔兴师，堂陛卼臲。","发言盈庭，更訾元蔑。","佩剑彼此，孰予孰决。","庙谋一定，群议沮折。","袖手何言，瞠目卷舌。","草木苍苍，始有芽蘖。","尽育恢胎，咸归坱圠。","灞上棘门，环卫拱列。","罔敢擅师，始制君节。","万夫属鞬，拜舞君阙。","乃命叔孙，诹日绵𫈵。","搜讲阙遗，悉究悉设。","皇帝孝思，上与天合。","冀获一真，如响必答。","翠舆南旋，红鸾秉翣。","长乐钟闻，皇情允惬。","我歌思齐，舆情激越。","皇帝之祀，咸秩罔缺。","合祭于郊，爰胾茧栗。","苍璧前陈，大裘始挈。","我歌思文，以告丰洁。","大庆御朝，王春正月。","禹会涂山，万玉交戛。","汉朝诸侯，图籍是阅。","兵戈澒洞，士气销詟。","俎豆不陈，军旅是急。","大起廱泮，儒士鼓箧。","韦带缟衣，骈冠累屧。","论秀蒸髦，尾尾岌岌。","农流于兵，病不生活。","茫茫千塍，蒿藜是没。","皇帝慨然，亲耕陇畷。","耕根之车，飞檐䡾䡾。","宣和之轨，明道之辙。","圣心恳到，三推未辍。","父老曰嘻，归告我邑。","俾尔粳稌，屯云积雪。","凡此大功，具载史牒。","用告神明，以报夔契。","帝坐法宫，礼备乐阕。","兽舞凤鸣，八音不夺。","皇威所覃，雷动风发。","南面垂衣，大壮帝室。","曰皋曰雉，鼛鼓弗及。","苍龙之阙，上摩星日。","万目顾瞻，葱葱郁郁。","澎澎海潮，吴会来集。","天子万年，风翔喜溢。","孰磨苍崖，孰秉史笔。","天子曰都，是任良弼。","圣有至言，维德之一。","是用作歌，以告万国。"],0,"x139","宋"],["临碣石 其二","曹勋","四言",["杲日既升，我徒既盈。","愿言斯适，至乐无声。","抚躬增愧，临深可惊。"],0,"x103","宋"],["偈颂五十一首 其三十","释大观","四言",["拥之不聚，拨之不散。","听之不闻，觑之不见。"],0,181,"宋"],["高宗建炎初祀昊天上帝 捧俎用《丰安》。","郊庙朝会歌辞","四言",["祀事孔明，礼文惟楙。","爰洁牺牲，载登俎豆。","或肆或将，无声无臭。","精祲潜通，永绥我后。"],0,"x207","宋"],["古怨诗 其四","刘敞","四言",["日兮月兮，出兮没兮。","孰是人斯，远我忽兮。"],0,"x51","宋"],["偈颂三十首 其三十","释慧晖","四言",["一段大事，古今难通。","三乘曲说，去来易空。","衲僧眼目，端的无工。","禅和信趣，脱然绝踪。"],0,194,"宋"],["富郑公画像赞","李纲","四言",["天下达德，惟仁智勇。","合之成体，散之致用。","岩岩富公，备此三德。","直道不回，以相王国。","其智伊何，见于使虏。","敷陈利害，以悟其主。","欢盟至今，莫敢予侮。","其仁伊何，见于救灾。","饥民如云，襁负以偕。","法简惠周，垂训将来。","何以行兹，断以勇克。","众人所惧，公独不惑。","夺虏之气，厉色折之。","赈民之饥，诚意活之。","我生后公，今觌厥象。","丹青载传，朝夕是仰。"],0,"x136","宋"],["元符亲享明堂十一首 其五 上帝位酌献用《庆安》。","郊庙朝会歌辞","四言",["惟礼不渎，所以严亲。","惟孝不匮，所以教民。","陟配文考，享于大神。","重禧累福，祚裔无垠。"],0,"x207","宋"],["政和鹿鸣宴五首 其三","郊庙朝会歌辞","四言",["鸣鹿呦呦，载弁俅俅。","烝然来思，旨酒思柔。","之子言迈，泮涣尔游。","于彼西雍，对扬王休。"],0,"x207","宋"],["与妙庵主","释慧空","四言",["至道之宗，备在尔躬。","求之则远，守之不通。","不求不守，奇哉灵叟。","极离极微，应心应手。","触目晴岚，到处成庵。","捶呵弥勒，不与同龛。","石虎抬头，泥牛入海。","蓦劄相逢，一场风采。"],0,"x118","宋"],["嘉泰三年皇后册宝十三首 其十一","郊庙朝会歌辞","四言",["妇荣于室，通籍禁中。","班列有次，车服有容。","佐我关雎，鹊巢之风。","被之僮僮，曷不肃雍。"],0,"x207","宋"],["绵  其四","王梦应","四言",["谷旦于差，惠于宗公。","工祝致告，神罔时恫。","是烝是飨，何天之宠。"],0,254,"宋"],["禅道同功修养诀","晁迥","四言",["心息相依，息调心静。","静调久久，可成胜定。","神气相合，气和神清。","清和久久，可致长生。"],0,199,"宋"],["绣释迦像并十八罗汉赞 第十半托迦尊者","惠洪","四言",["手虽有拂，境以无尘。","出三毒梦，乘五色云。","霜露果熟，慈忍现身。","以空为地，立处皆真。"],0,"x42","宋"],["宋颂九首 其二 莫丑","石介","四言",["皇祖曰嘻，天生蒸民。","立之君长，以养以仁。","乃予不恤，匪𬬮之嚚。"],0,105,"宋"],["赠杨樵隐应炎谈命","文天祥","四言",["莘郊一介，尧舜君民。","薇山二难，百世忠清。","富春耕叟，涕洟云台。","终南遁士，仕宦梯媒。","是数公者，俱以隐名。","木石一迹，霄渊异情。","九华山人，卖樵江湖。","请算世间，几种樵夫。"],0,"x53","宋"],["宁宗郊祀二十九首 再升坛。","郊庙朝会歌辞","四言",["紫坛岳立，神光夜烛。","有俨旒采，有鸾佩玉。","霄垠顾佑，祖宗熙穆。","对越不忘，俾尔戬谷。"],0,"x207","宋"],["敬思堂四言","周文璞","四言",["有亭央央，高丘之傍。","父兮母兮，坚深埋藏。","厦屋凄凉，宰木成行。","春秋蒸尝，酒浆牛羊。","身体俯伛，虽劳弗彰。","心志瞀乱，虽烦弗扬。","欲求幽阴，茫茫洋洋。","两间四方，实系我肠。","何以照之，明神后皇。","凡今之人，谁同慨伤。"],0,93,"宋"],["颂古三十三首 其十五","释师观","四言",["如何是佛，更莫别求。","相随来也，四大部洲。"],0,210,"宋"],["偈颂一一二首 其五十一","释清远","四言",["言无言言，不费唇舌。","未说之法，林中之叶。"],0,116,"宋"],["偈颂一百四十二首 其二十九","释广闻","四言",["云门行棒，不可放过。","香山礼拜，放过不可。","从来献佛，不在香多。"],0,10,"宋"],["听天吟","邵雍","四言",["上天生我，上天死我。","一听于天，有何不可。"],0,"x57","宋"],["今日何夕  其一","曾丰","四言",["今夕何夕，粲者如许。","日在于参，心在于户。","心与火俱，火为心主。","老人在南，盖得其所。"],0,"x193","宋"],["绵  其一","王梦应","四言",["绵绵瓜瓞，施于中林。","顾于烝尝，匪今斯今。"],0,254,"宋"],["绵  其二","王梦应","四言",["既庶既繁，既多受祉。","厥胤维何，宜兄宜弟。","兄弟求矣，以燕翼子。"],0,254,"宋"],["颂古四十八首 其二十九","释慧开","四言",["风幡心动，一状领过。","只知开口，不觉话堕。"],0,65,"宋"],["绍兴淳熙分命馆职定撰十七首 太宗位奠币用《宗安》。","郊庙朝会歌辞","四言",["穆穆皇祖，丕昭圣功。","声律身度，乐备礼隆。","祗荐量币，祀于合宫。","玉帛万国，驩心载同。"],0,"x207","宋"],["今日何夕  其二","曾丰","四言",["今夕何夕，粲者如许。","其月蕤宾，其日甲午。","午与火俱，火为午主。","老臣在南，盖得其侣。"],0,"x193","宋"],["宋颂九首 其三 莫丑","石介","四言",["乃谋于渭，乃将于美。","王师鹰扬，涉江万里。","辟其城门，𬬮号请死。"],0,105,"宋"],["景祐夏至祀皇地祇二首 其一 太祖奠币用《恭安》。","郊庙朝会歌辞","四言",["赫矣淳耀，俶载帝基。","一戎以定，万国来仪。","寅恭洁祀，博厚皇祇。","威灵攸在，福禄如茨。"],0,"x207","宋"],["偈颂一百零二首 其五十八","释慧远","四言",["徐六担板，我则不然。","初三十一，不用择日。","鼻孔剔穿，眼睛突出。","撞著露柱，参学事毕。"],0,154,"宋"],["偈","都贶","四言",["不可思议，是大火聚。","便恁么去，不离当处。"],0,96,"宋"],["偈颂一百二十三首 其二十八","释祖钦","四言",["皇图更统，佛运亦新。","四海八蛮，咸倾化日，穷岩绝壑，共舞阳春。"],0,64,"宋"],["和陶归鸟 其一","吴芾","四言",["翩翩归鸟，投宿深林。","岂无所择，相彼遥岑。","厥有嘉树，可以托心。","虽逢赫日，终贮清阴。"],0,"x95","宋"],["僧问四宾主因而有颂颂之 其四","释重显","四言",["宾中之主，玄沙猛虎。","半合半开，唯自相许。"],0,"x156","宋"],["偈颂一一二首 其七十四","释清远","四言",["虚名虚相，谷音鉴像。","弃而不修，岂明幻妄。","少不努力，老矣惆怅。","静以思之，随机称量。"],0,116,"宋"],["偈颂一百三十三首 其一二八","释居简","四言",["时时具足，日日团栾。","含元殿里，更问长安。"],0,"x94","宋"],["乾道七年册皇太子四首 其四","郊庙朝会歌辞","四言",["储副豫定，器之公兮。","册授孔时，礼之隆兮。","天步迟迟，旋九重兮。","寿祉万年，德无穷兮。"],0,"x207","宋"],["高宗祀明堂前朝享太庙二十一首 其十六 文舞退、武舞进用《正安》。","郊庙朝会歌辞","四言",["作乐合祖，笋簴在庭。","众奏具举，肃雍和鸣。","神灵来格，庶几是听。","皦绎以终，永观厥成。"],0,"x207","宋"],null,["方丘乐歌 其九","郊庙朝会歌辞","四言",["因地方丘，济济多仪。","乐成八变，灵祇格思。","荐馀彻豆，神贶昭垂。","亿万斯年，永祐丕基。"],0,"x207","宋"],["宋江三十六赞 其十五 铁鞭呼延绰","龚开","四言",["尉迟彦章，去来一身。","长鞭铁铸，汝岂其人。"],0,103,"宋"],["建隆郊祀八首 其一 降神用《高安》。","郊庙朝会歌辞","四言",["在国南方，时维就阳。","以祈帝祉，式致民康。","豆笾鼎俎，金石丝簧。","礼行乐奏，皇祚无疆。"],0,"x207","宋"],["偈颂二十二首 其十三","释道生","四言",["龟峰一诀，千圣罔测。","硬似泥团，烂如生铁。","是何之诀，有口无舌。"],0,138,"宋"],["十月 其五","叶巽斋","四言",["维此十月，物宝全富。","雪梅在岭，霜菊盈圃。","梧竹之高，椿松之固。","剩馥郁芬，古根盘踞。","我公之寿，此未足谕。","峻峙精神，蜀江庐阜。"],0,180,"宋"],["绍兴以后祀五方帝六十首 有熊氏酌献用《祐安》。","郊庙朝会歌辞","四言",["昔在绵邈，有人公孙。","登政抚辰，节用良勤。","所蓄既大，所行宜远。","载其华樽，从以箫管。"],0,"x207","宋"],["偈颂一百二十三首 其三十四","释祖钦","四言",["万化之源，万物之母。","德被河沙，量包海宇。","圣中之圣，主中之主。","庆会一时，寿崇千古。","以坤自贵，月朗太虚。","以干为子，红日卓午。"],0,64,"宋"],["偈六十九首 其三十七","释道宁","四言",["摩竭掩室，非是通方。","净名杜词，未为作略。","总不恁么，罕遇知音。","方便门中，随宜举唱。"],0,119,"宋"],["代冯似宗寿楼文昌  其二","杨简","四言",["补衮大手，石色五有。","砥柱中流，屹屹其守。","为人所难，一辞万口。","文昌大名，太山北斗。"],0,118,"宋"],["偈颂一百二十三首 其九十八","释崇岳","四言",["忽雨忽晴，天平地平。","释迦弥勒，打失眼睛。"],0,222,"宋"],["思惟相观音赞 其一","释心月","四言",["春禽昼啼，秋虫夜吟。","有耳皆闻，何独观音。","如是而知，如是而觉。","面目现前，超诸馀学。"],0,188,"宋"],["种药苗二首 种决明 其四","苏辙","四言",["自我知非，卷去图书。","闭目内观，妙见自如。","闻阿那律，无目而视。","决明何为，适口乎尔。"],0,"x135","宋"],["代冯似宗寿楼文昌  其一","杨简","四言",["维山四明，涵奇孕英。","或曰降神，为今甫申。","倬彼云汉，昭囘其文。","凤鸣朝阳，决河昆仑。","代天而言，粹其德音。"],0,118,"宋"],["偈颂一百三十三首 其一一九","释居简","四言",["家贼难防，家财必丧。","只可错捉，不可错放。"],0,"x94","宋"],["放拄杖睡赞","释智愚","四言",["能所顿忘，佯佯瞌睡。","一息不来，百川鼎沸。"],0,"x153","宋"],["政和鹿鸣宴五首 其五","郊庙朝会歌辞","四言",["遐不作人，天下喜乐。","何以况之，鸢飞鱼跃。","既劝之驾，献酬交错。","利用宾王，縻以好爵。"],0,"x207","宋"],["禅人求赞 其四","释宗杲","四言",["铁蛇在握，毒气烁烁。","拟议不来，劈口便著。"],0,"x112","宋"],["寒山赞","释居简","四言",["寒山指出，拾得执指。","不曾见月，矮子看戏。"],0,"x94","宋"],["纳火祀大辰十二首 大辰位奠玉币用《嘉安》。","郊庙朝会歌辞","四言",["金行序晚，玉露晨清。","齐戒丰洁，肃恭神明。","嘉币惟量，嘉玉惟精。","于以奠之，庶几来听。"],0,"x207","宋"],["内外吟","邵雍","四言",["目耳鼻口，人之户牖。","心胆脾肾，人之中霤。","内若能守，外自不受。","内若无守，外何能久。"],0,"x57","宋"],["偈颂一百二十三首 其四十三","释祖钦","四言",["只闻子声，不见子形，忒煞分明。","只得其体，不得其用，可煞现成。"],0,64,"宋"],["野饮","仇远","四言",["土冈之西，竹树之下。","板屋三间，娱此隐者。","埘有肥鸡，厩有羸马。","岂无佳菊，采不盈把。","且漉我酒，放浪林野。","莫不饮食，知味者寡。"],0,"x84","宋"],["豆卢革田园帖赞","岳珂","四言",["书名之讹，创自韦陟。","季袭其风，始见书尺。","狙冠豺绶，乃唐之贼。","相不加诛，而反畏惕。","礼度尽坏，王纲倒植。","存此谓何，览者太息。"],0,"x202","宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十","郊庙朝会歌辞","四言",["新庭靖安，祖后燕怡。","有开圣谋，累崇天基。","典章文明，声容葳蕤。","御于邦家，曰寿曰慈。"],0,"x207","宋"],["偈颂一百二十三首 其四十七","释祖钦","四言",["事有万殊，法无异说。","寒但言寒，热但言热。"],0,64,"宋"],["摄事十三首 降神用《礼安》。","郊庙朝会歌辞","四言",["肃肃清庙，昭事祖祢。","粢盛苾芬，四海来祭。","皇灵格思，令容有睟。","降福孔皆，以克永世。"],0,"x207","宋"],["绍兴圣孝感通诗","张嵲","四言",["宋有天下，逮乎八世。","猛敌横生，侵欲不忌。","尧汤水旱，文景菑异。","数则使然，岂人攸塈。","皇帝承统，甚武且仁。","内销奸孽，外备殊邻。","浸明浸昌，师武臣力。","抵掌含怒，日思奋殛。","皇帝曰咨，咨女将臣。","慎守疆埸，以保吾民。","敌来则御，折北勿追。","姑修吾德，以待所归。","人亦有言，投鼠忌器。","矧彼狡焉，吾亲是质。","彼兵攸恃，我则德攻。","靡以岁月，徼天之衷。","彼虽刚戾，不可扰驯。","我视其欲，以舒吾仁。","始我有众，公卿庶士。","谓彼悍骄，庸知德义。","苟有诚信，金石为开。","豚鱼之孚，惟道之怀。","有唐睿真，亟诏求访。","恻怛之诚，宁甘百𫍬。","皇帝曰咨，予由是心。","彼虽我诈，我惟尔忱。","孝悌之至，神明可通。","惟彼不信，天诱其衷。","行人是来，言弃旧恶。","我奉慈母，归御长乐。","八月甲子，至行在所。","天子在所，天子郊迎，其从如雨。","老稚仰观，踊跃呼舞。","卿士相趋，肃穆伛偻。","天地感通，发祥颓祉。","卿云郁兴，轮囷离诡。","屏翳不惊，川后静波。","云飞渊泳，欢声相和。","玉虬沛艾，芝盖穹崇。","千乘雷动，万骑风从。","天子是侍，如长乐宫。","渤澥为杯，华嵩为豆。","举烽行炙，撞钟命酒。","既劳王爵，下逮奔走。","万岁称觞，献太母寿。","敷天之庆，周浃寰宇。","薄海内外，无或失所。","皇帝之孝，振古曷遇。","睿算无疆，永作民主。","人无疾疠，田多稷黍。","兵革不试，四夷款附。","太母万年，康疆燕豫。","皇帝之孝，莫与比德。","锡羡无疆，子孙千亿。","莞簟发祥，开统拓迹。","嶷嶷岐岐，诜诜翼翼。","有绿其车，有赤其舄。","太母万年，含饴燕息。","始归太母，小大具疑。","谓将我廷，胡宁以归。","皇帝之孝，先定不易。","爰有廷臣，协比我德。","有赞其决，无贰其心。","指期待蔇，天实我临。","曾无愆素，归御愔愔。","凡是欢嚣，尽为歌吟。","天锡皇帝，示将保定。","太平之休，繄此其证。","际天所覆，咸为我土。","含识之伦，我籍斯附。","充入旧贯，天临万方。","子子孙孙，永世克昌。"],0,"x133","宋"],["偈颂一百零一首 其三十八","释慧性","四言",["独标万象，物外宣扬。","天长地久，地久天长。"],0,46,"宋"],["上耿泉生朝  其二","杨简","四言",["历世薮卜，有孙惟良。","恺悌君子，之纪之纲。"],0,118,"宋"],["淳化乡饮酒三十三章  其五","郊庙朝会歌辞","四言",["鹿鸣相邀，聚场之苗。","我美嘉宾，令名孔昭。","我命旨酒，以歌以谣。","何以置之，大君之朝。"],0,"x207","宋"],["送珍兄之黄檗","释慧空","四言",["老倒空生，言无旨的。","索瓶指泥，觅偈与墼。","俊流把得，劈面便掷。","如其不然，分付黄檗。"],0,"x118","宋"],["建隆以来祀享太庙十六首 其三 奠瓒用《瑞木》。","郊庙朝会歌辞","四言",["木符启瑞，著象成文。","于昭大号，协应明君。","灵命有属，鸿禧洞分。","歌以升荐，休嘉洽闻。"],0,"x207","宋"],["宋江三十六赞 其三十五 金鎗班徐宁","龚开","四言",["金不可辱，亦忌在秽。","盍铸长殳，羽林是卫。"],0,103,"宋"],["司马文正公集序帖赞","岳珂","四言",["道本于身，真积乃全。","贯以一诚，虽人实天。","元祐之初，帝赉良弼。","匪康其躬，为民而出。","龙起于洛，云兴于嵩。","有泽其膏，四海之丰。","方其未骧，一念下土。","九关虽扃，编此守虎。","及其既用，草偃维风。","群贤鳞差，滃然而从。","天以诚开，民以诚格。","混融流通，何索何获。","有崇南山，太平之基。","岩岩具瞻，维公宜之。","平生不欺，涵泳浃洽。","心画之作，为天下法。","取人以直，持己以谦。","岂徒幅笺，二德之兼。","荣光属天，公书在椟。","有德有言，温其如玉。"],0,"x202","宋"],["赠胡大夫","徐积","四言",["兵有三难，一曰难知。","二曰难处，三曰难言。","眇忽精微。","伟哉胡公，讲辨必精。","以兵为难，是为知兵。","是为力学，是为老成。","惜乎老矣，未见设施。","其谁知公，胸中之奇。","弗施于兵，施于有政。","所在所居，斯民之幸。"],0,"x123","宋"],["宝陀三句 其三","释普济","四言",["宝陀一妙，无人能到。","吃饭著衣，屙屎放尿。"],0,73,"宋"],["偈颂一百一十七首 其八","释绍昙","四言",["蛇头揩痒，虎口拔牙。","拚得性命，始是作家。"],0,"x108","宋"],["五方帝 其十二","郊庙朝会歌辞","四言",["水官修职，星昴居方。","执权含宝，万物伏藏。","大明昌祚，临下皇皇。","曰寒时若，神降之康。"],0,"x207","宋"],["应庵师祖赞 其一","释崇岳","四言",["深入虎穴，有屈难雪。","天下应庵，只得一橛。"],0,222,"宋"],["上耿泉生朝  其四","杨简","四言",["天子曰于，亟来辅予。","寘彼周行，为上大夫。","迺眷西顾，畀之节符。"],0,118,"宋"],["高宗建炎初祀昊天上帝 彻豆用《肃安》。","郊庙朝会歌辞","四言",["内心齐诚，外物蠲洁。","神来迪尝，俎豆既彻。","燕及群生，靡或夭阏。","降福穰穰，时万时亿。"],0,"x207","宋"],["理气","詹初","四言",["理本无象，气为有形。","气为理载，理以气乘。","匪理气粗，匪气理冥。","气以理神，理以气弘。","二者相须，其道分明。"],0,16,"宋"]]