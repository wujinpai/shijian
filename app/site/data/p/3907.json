[["吴鼓吹曲十二曲 其五 秋风","佚名","魏晋",["秋风扬沙尘。","寒露沾衣裳。","角弓持弦急。","鸠鸟化为鹰。","边垂飞羽檄。","寇贼侵界疆。","跨马披介胄。","慷慨怀悲伤。","辞亲向长路。","安知存与亡。","穷达固有分。","志士思立功。","思立功。","邀之战场。","身逸获高赏。","身没有遗封。"],{"ad":"魏晋"},"x238","魏晋"],["吴鼓吹曲十二曲 其六 克皖城","佚名","魏晋",["克灭皖城遏寇贼，恶此凶孽阻奸慝。","王师赫征众倾覆，除秽去暴戢兵革。","民得就农边境息，诛君吊民昭至德。"],{"ad":"魏晋"},"x238","魏晋"],["吴鼓吹曲十二曲 其七 关背德","佚名","魏晋",["关背德。","作鸱张。","割我邑城图不祥。","称兵北伐围樊阳。","嗟臂大于股。","将受其殃。","巍巍夫圣主。","睿德与玄通。","与玄通。","亲任吕蒙。","泛舟洪汜池。","溯涉长江。","神武一何桓桓。","声烈正与风翔。","历抚江安城。","大据郢邦。","虏羽授首。","百蛮咸来同。","盛哉三比隆。"],{"ad":"魏晋"},"x238","魏晋"],["吴鼓吹曲十二曲 其八 通荆门","佚名","魏晋",["荆门限巫山。","高峻与云连。","蛮夷阻其险。","历世怀不宾。","汉王据蜀郡。","崇好结和亲。","乖微中情疑。","谗夫乱其间。","大皇赫斯怒。","虎臣勇气震。","荡涤幽薮讨不恭。","观兵扬炎耀。","厉锋整封疆。","整封疆。","阐扬威武容。","功赫戏。","洪烈炳章。","邈矣帝皇世。","圣吴同厥风。","荒裔望清化。","化恢弘。","煌煌大吴。","延祚永未央。"],{"ad":"魏晋"},"x238","魏晋"],["吴鼓吹曲十二曲 其九 章洪德","佚名","魏晋",["章洪德。","迈威神。","感殊风。","怀远邻。","平南裔。","齐海滨。","越裳贡。","扶南臣。","珍货充庭。","所见日新。"],{"ad":"魏晋"},"x238","魏晋"],["吴鼓吹曲十二曲 其十 从历数","佚名","魏晋",["从历数。","于穆我皇帝。","圣哲受之天。","神明表奇异。","建号创皇基。","聪睿协神思。","德泽浸及昆虫。","浩荡越前代。","三光显精耀。","阴阳称至治。","肉角步郊畛。","凤凰栖灵囿。","神龟游沼池。","图谶摹文字。","黄龙觌鳞。","符祥日月记。","览往以察今。","我皇多哙事。","上钦昊天象。","下副万姓意。","光被弥苍生。","家户蒙惠赍。","风教肃以平。","颂声章嘉喜。","大吴兴隆。","绰有馀裕。"],{"ad":"魏晋"},"x238","魏晋"],["吴鼓吹曲十二曲 其十一 承天命","佚名","魏晋",["承天命。","于昭圣德。","三精垂象。","符灵表德。","巨石立。","九穗植。","龙金其麟。","乌赤其色。","舆人歌。","亿夫叹息。","超龙升。","袭帝服。","穷淳懿。","体玄嘿。","夙兴临朝。","劳谦日昃。","易简以崇仁。","放远谗与慝。","举贤才。","亲近有德。","均田畴。","茂稼穑。","审法令。","定品式。","考功能。","明黜陟。","人思自尽。","唯心与力。","家国治。","王道直。","思我帝皇。","寿万亿。","长保天禄。","祚无极。"],{"ad":"魏晋"},"x238","魏晋"],["吴鼓吹曲十二曲 其十二 玄化","佚名","魏晋",["玄化象以天。","陛下圣真。","张皇纲。","率道以安民。","惠泽宣流而云布。","上下睦亲。","君臣酣宴乐。","激发弦歌扬妙新。","修文筹庙胜。","须时备驾巡洛津。","康哉泰。","四海欢忻。","越与三五邻。"],{"ad":"魏晋"},"x238","魏晋"],["会稽民为徐弘歌","佚名","魏晋",["徐圣通，政无双。","平刑罚，奸宄空。"],{"ad":"魏晋"},"x238","魏晋"],["南土为杜预歌","佚名","魏晋",["后世无叛由杜翁。","孰识智名与勇功。"],{"ad":"魏晋"},"x238","魏晋"],["阳平人为束皙歌","佚名","魏晋",["束先生。","通神明。","请天三日甘雨零。","我黍以育。","我稷以生。","何以畴之。","报束长生。"],{"ad":"魏晋"},"x238","魏晋"],["三郡民为应詹歌","佚名","魏晋",["乱离既普，殆为灰朽。","侥幸之运，赖兹应后。","岁寒不凋，孤境独守。","拯我涂炭，惠隆丘阜。","润同江海，恩犹父母。"],{"ad":"魏晋"},"x238","魏晋"],["襄阳儿童为山简歌","佚名","魏晋",["山公出何许，往至高阳池。","日夕倒载归，酩酊无所知。","时时能骑马，倒着白接䍠。","举鞭向葛强，何如并州儿。"],{"ad":"魏晋"},"x238","魏晋"],["吴郡民为邓攸歌","佚名","魏晋",["𬘘如打五鼓，鸡鸣天欲曙。","邓侯挽不留，谢令推不去。"],{"ad":"魏晋"},"x238","魏晋"],["豫州耆老为祖逖歌","佚名","魏晋",["幸哉遗黎免俘虏。","三辰既朗遇慈父。","玄酒忘劳甘瓠脯。","何以咏思歌且舞。"],{"ad":"魏晋"},"x238","魏晋"],["时人为阮修歌","佚名","魏晋",["长安教书罢，洛阳卖卜来。","百钱系杖头，能使世人解。"],{"ad":"魏晋"},"x238","魏晋"],["吏为郭颐刘聪歌","佚名","魏晋",["我有贤后。","能任玄明。","政理人殷。"],{"ad":"魏晋"},"x238","魏晋"],["京师为张轨歌","佚名","魏晋",["凉州大马。","横行天下。","凉州鸱苕寇贼消。","鸱苕翩翩怖杀人。"],{"ad":"魏晋"},"x238","魏晋"],["陇上为陈安歌","佚名","魏晋",["陇上壮士有陈安，躯干虽小腹中宽。","爱养将士同心肝，䯅骢父马铁锻鞍。","七尺大刀奋如湍，丈八蛇矛左右盘。","十荡十决无当前，战如三交失蛇矛。","弃我䯅骢窜岩幽，为我外援而悬头。","西流之水东流河，一去不还奈子何。"],{"ad":"魏晋"},"x238","魏晋"],["泰始中谣","佚名","魏晋",["贾裴王，乱纪纲。","王裴贾，济天下。"],{"ad":"魏晋"},"x238","魏晋"],["泰始中童谣","佚名","魏晋",["宫中大马几作驴。","大石压之不得舒。"],{"ad":"魏晋"},"x238","魏晋"],["军中谣","佚名","魏晋",["以计代战。","一当万。"],{"ad":"魏晋"},"x238","魏晋"],["蜀民为许逊谣","佚名","魏晋",["人无盗窃，吏无奸欺。","我君活人，病无能为。"],{"ad":"魏晋"},"x238","魏晋"],["武帝太康后童谣三首 其一","佚名","魏晋",["局缩肉。","数横目。","中国当败吴当复。"],{"ad":"魏晋"},"x238","魏晋"],["武帝太康后童谣三首 其二","佚名","魏晋",["宫门柱。","且莫朽。","吴当复在三十年后。"],{"ad":"魏晋"},"x238","魏晋"],["武帝太康后童谣三首 其三","佚名","魏晋",["鸡鸣不拊翼。","吴复不用力。"],{"ad":"魏晋"},"x238","魏晋"],["蜀人谣二首 其一","佚名","魏晋",["尚之所爱，非邪则佞。","尚之所憎，非忠则正。","富拟鲁卫，家成市里。","贪如豺狼，无复极已。"],{"ad":"魏晋"},"x238","魏晋"],["蜀人谣二首 其二","佚名","魏晋",["蜀贼尚可，罗尚杀我。","平西将军，反更为祸。"],{"ad":"魏晋"},"x238","魏晋"],["惠帝即位时儿童谣","佚名","魏晋",["两火没地，哀哉秋兰。","归形街邮，终为人叹。"],{"ad":"魏晋"},"x238","魏晋"],["赵王伦为乱时谣","佚名","魏晋",["金章满箱。","尚不可长。"],{"ad":"魏晋"},"x238","魏晋"],["永熙中温县狂人书","佚名","魏晋",["光光文长。","以戟为墙。","毒药虽行。","戟还自伤。"],{"ad":"魏晋"},"x238","魏晋"],["惠帝永熙中童谣","佚名","魏晋",["二月末。","三月初。","桑生襄蕃柳叶舒。","荆笔杨版行诏书。","宫中大马几作驴。"],{"ad":"魏晋"},"x238","魏晋"],["元康三的蜀中童谣四首 其一","佚名","魏晋",["郫城坚。","盎底穿。","郫城细子李持细。"],{"ad":"魏晋"},"x238","魏晋"],["元康三的蜀中童谣四首 其二","佚名","魏晋",["江桥头。","阙下市。","城都北门十八子。"],{"ad":"魏晋"},"x238","魏晋"],["元康三的蜀中童谣四首 其三","佚名","魏晋",["巴郡葛，当下美。"],{"ad":"魏晋"},"x238","魏晋"],["元康三的蜀中童谣四首 其四","佚名","魏晋",["有客有客。","来侵门陌。","其气欲索。"],{"ad":"魏晋"},"x238","魏晋"],["元康中童谣","佚名","魏晋",["屠苏鄣日覆两耳。","当见?儿作天子。"],{"ad":"魏晋"},"x238","魏晋"],["元康中洛中童谣","佚名","魏晋",["虎从北来鼻头汗。","龙从南来登城看。","水从西来河灌灌。"],{"ad":"魏晋"},"x238","魏晋"],["惠帝元康中京洛童谣二首 其一","佚名","魏晋",["南风起兮吹白沙。","遥望鲁国何嵯峨。","千岁髑髅生齿牙。"],{"ad":"魏晋"},"x238","魏晋"],["惠帝元康中京洛童谣二首 其二","佚名","魏晋",["城东马子莫咙哅。","比至来年缠汝鬉。"],{"ad":"魏晋"},"x238","魏晋"],["惠帝大安中童谣","佚名","魏晋",["五马浮渡江，一马化为龙。"],{"ad":"魏晋"},"x238","魏晋"],["著布谣","佚名","魏晋",["著布耙腹。","为齐持服。"],{"ad":"魏晋"},"x238","魏晋"],["洛下谣","佚名","魏晋",["草木萌牙杀长沙。"],{"ad":"魏晋"},"x238","魏晋"],["惠帝时洛阳童谣","佚名","魏晋",["邺中女子莫千妖。","前至三月抱胡腰。"],{"ad":"魏晋"},"x238","魏晋"],["怀帝永嘉初童谣","佚名","魏晋",["洛中大鼠长尺二。","若不早去天狗至。"],{"ad":"魏晋"},"x238","魏晋"],["苟晞将破汲桑诗谣","佚名","魏晋",["元超兄弟大洛度。","上桑打椹为苟作。"],{"ad":"魏晋"},"x238","魏晋"],["军中为汲桑谣","佚名","魏晋",["士为将军何可羞。","六月重茵披衲裘。","不识寒暑断他头。","雄儿田兰为报仇。","中夜斩首谢并州。"],{"ad":"魏晋"},"x238","魏晋"],["王彭祖谣","佚名","魏晋",["幽州城门似藏户。","中有伏尸王彭祖。"],{"ad":"魏晋"},"x238","魏晋"],["北州为朱硕棘嵩谣","佚名","魏晋",["府中赫赫朱邱伯，十囊五囊入棘郎。"],{"ad":"魏晋"},"x238","魏晋"],["悯帝初童谣","佚名","魏晋",["天子何在。","豆田中。"],{"ad":"魏晋"},"x238","魏晋"],["悯帝初童谣","佚名","魏晋",["天子在何许，近在豆田中。"],{"ad":"魏晋"},"x238","魏晋"],["建兴中江南谣","佚名","魏晋",["訇如白坑破，合集持作甒。","扬州破换败，吴兴覆瓿甊。"],{"ad":"魏晋"},"x238","魏晋"],["王敦将灭时童谣","佚名","魏晋",["剪生剪韭。","断阳柳。","河东小子。","令我与子。"],{"ad":"魏晋"},"x238","魏晋"],["明帝太宁初童谣","佚名","魏晋",["恻力恻力。","放马山侧。","大马死。","小马饿。","高山崩。","石自破。"],{"ad":"魏晋"},"x238","魏晋"],["永嘉中长安谣","佚名","魏晋",["秦川中。","血没腕。","唯有凉州倚柱观。"],{"ad":"魏晋"},"x238","魏晋"],["凉州民谣","佚名","魏晋",["蛇利炮。","蛇利炮。","公头坠地而不觉。"],{"ad":"魏晋"},"x238","魏晋"],["西土谣","佚名","魏晋",["手莫头。","图凉州。"],{"ad":"魏晋"},"x238","魏晋"],["姑臧谣","佚名","魏晋",["鸿从南来雀不惊。","谁谓孤雏尾翅生。","高举六翮凤凰鸣。"],{"ad":"魏晋"},"x238","魏晋"],["时人为张冲谣","佚名","魏晋",["推财不疑。","张长思。"],{"ad":"魏晋"},"x238","魏晋"],["冀州童谣","佚名","魏晋",["古在左，月在右。","让去言，或入口。"],{"ad":"魏晋"},"x238","魏晋"],["临水人为张楼谣","佚名","魏晋",["阳平张楼头如箱。","见人切齿剧虎狼。"],{"ad":"魏晋"},"x238","魏晋"],["南广郡行人语","佚名","魏晋",["犹溪赤水，盘蛇七曲。","盘羊乌栊，气与天通。","看都护泚，伫柱呼伊。","庲降贾子，左檐七里。"],{"ad":"魏晋"},"x238","魏晋"],["䱥鱼谚","佚名","魏晋",["宁去累世宅。","不去䱥鱼额。"],{"ad":"魏晋"},"x238","魏晋"],["陆机引里语","佚名","魏晋",["斫檀不谛。","得系迷。","系迷尚可。","得驳马。"],{"ad":"魏晋"},"x238","魏晋"],["陆机引齐人谚","佚名","魏晋",["上山斫檀。","挈榼先殚。"],{"ad":"魏晋"},"x238","魏晋"],["陆机引里语","佚名","魏晋",["黄栗留。","看我麦。","黄葚熟。"],{"ad":"魏晋"},"x238","魏晋"],["陆机引辽东乡语","佚名","魏晋",["居就粮。","梁水鲂。"],{"ad":"魏晋"},"x238","魏晋"],["陆机引里语","佚名","魏晋",["网鱼得𫚈。","不如啖茹。"],{"ad":"魏晋"},"x238","魏晋"],["陆机引里语","佚名","魏晋",["趣织鸣。","懒妇惊。"],{"ad":"魏晋"},"x238","魏晋"],["杨济引谚","佚名","魏晋",["生子凝，了官事。"],{"ad":"魏晋"},"x238","魏晋"],["成公绥引谚","佚名","魏晋",["钱无耳。","何可訚使。"],{"ad":"魏晋"},"x238","魏晋"],["鲁褒引谚","佚名","魏晋",["钱无耳。","可使鬼。"],{"ad":"魏晋"},"x238","魏晋"],["傅玄引谚","佚名","魏晋",["己是而彼非，不当与非争。","彼是而己非，不当与非平。"],{"ad":"魏晋"},"x238","魏晋"],["驾循引谚","佚名","魏晋",["射的白。","斛米百。","射的玄斛米千。"],{"ad":"魏晋"},"x238","魏晋"],["陆士衡引俗语","佚名","魏晋",["金马门外聚群贤。","铜驼陌上集少年。"],{"ad":"魏晋"},"x238","魏晋"],["杨泉引里语","佚名","魏晋",["能理乱丝。","乃可读诗。"],{"ad":"魏晋"},"x238","魏晋"],["杨泉引语","佚名","魏晋",["黄金累千。","不如一贤。","土非玉璧。","谈者为价。","上不正。","下参差。"],{"ad":"魏晋"},"x238","魏晋"],["卫展引谚","佚名","魏晋",["廷尉狱，平如砥。","有钱生，无钱死。"],{"ad":"魏晋"},"x238","魏晋"],["袁淮引谚","佚名","魏晋",["岁在申酉，乞浆得酒。","岁在辰巳，嫁妻卖子。"],{"ad":"魏晋"},"x238","魏晋"],["时人为崔洪语","佚名","魏晋",["丛生棘刺，来自博陵。","在南为鹞，在北为鹰。"],{"ad":"魏晋"},"x238","魏晋"],["时人为石苞语","佚名","魏晋",["石仲容，姣无双。"],{"ad":"魏晋"},"x238","魏晋"],["时人为羊祜语","佚名","魏晋",["二王当国。","羊公无德。"],{"ad":"魏晋"},"x238","魏晋"],["时人为杜预号","佚名","魏晋",["杜武库言，无所不有。"],{"ad":"魏晋"},"x238","魏晋"],["京师为刘舆刘琨语","佚名","魏晋",["洛中奕奕。","庆孙越石。"],{"ad":"魏晋"},"x238","魏晋"],["时人欧阳建语","佚名","魏晋",["渤海赫赫。","欧阳坚石。"],{"ad":"魏晋"},"x238","魏晋"],["时人为卫玠王澄语","佚名","魏晋",["卫玠谈道。","平子绝倒。"],{"ad":"魏晋"},"x238","魏晋"],["时人为乐广卫玠语","佚名","魏晋",["妇翁冰清，女婿玉润。"],{"ad":"魏晋"},"x238","魏晋"],["时人为二陆三张语","佚名","魏晋",["二陆入洛，三张减价。"],{"ad":"魏晋"},"x238","魏晋"],["蜀民为何随语","佚名","魏晋",["安汉吏取粮。","令为之偿。"],{"ad":"魏晋"},"x238","魏晋"],["时人为裴秀语","佚名","魏晋",["后进领袖。","有裴秀。"],{"ad":"魏晋"},"x238","魏晋"],["时人为谢鲲语","佚名","魏晋",["任达不已。","幼舆折齿。"],{"ad":"魏晋"},"x238","魏晋"],["时人为刘颂语","佚名","魏晋",["雷蒋谷鲁。","刘为最祖。"],{"ad":"魏晋"},"x238","魏晋"],["世为卞氏语","佚名","魏晋",["卞氏六龙，玄仁无双。"],{"ad":"魏晋"},"x238","魏晋"],["襄阳里人为庞焕语","佚名","魏晋",["我家池里，龙种来归。"],{"ad":"魏晋"},"x238","魏晋"],["三魏为刘毅语","佚名","魏晋",["但闻刘轼曹，不闻杜府君。"],{"ad