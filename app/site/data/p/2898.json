[["大观闻喜宴六首 其一","郊庙朝会歌辞","四言",["多士济济，于彼西雍。","钦肃威仪，亦有斯容。","烝然来思，自西自东。","天畀尔禄，惟王其崇。"],0,"x207","宋"],["夕月十首 送神用《理安》。","郊庙朝会歌辞","四言",["歌奏云阕，式礼莫愆。","以我齐明，罄其吉蠲。","神保聿归，降康自天。","萝图永固，亿万斯年。"],0,"x207","宋"],["布袋和尚颂","岳珂","四言",["行也布袋，坐也布袋。","放下布袋，多少自在。"],0,"x202","宋"],["公迈何遄  其二","曾丰","四言",["公之东矣，蜀人是恋，潭人是羡。","诏予油幢，亟哉往殿。","列城既倾，列骑既迎。","日裴月徊，倘其未行。","潭人曰噢，吾家耋孺。","不襦不袴，莫能略顾。","公来何暮。"],0,"x193","宋"],["书寿穴中石寿星背四言","姜特立","四言",["彼石何人，云是寿者。","作镇斯宫，孰分真假。","以幻对幻，有同儿嬉。","他日启扃，问尔是谁。"],0,"x50","宋"],["宁宗郊前朝献景灵宫二十四首 饮福酒用《报安》。","郊庙朝会歌辞","四言",["旨酒惟兰，勺浆惟椒。","福流瓒斝，光烛琨瑶。","拜贶清宫，凝辉庆霄。","神其如在，徘徊招摇。"],0,"x207","宋"],["力漕篇呈发运王司封宝臣","梅尧臣","四言",["兵外肢强，兵内体壮。","敛之尽归，岁以多饷。","东南舳舻，衔尾而上。","浮江浮淮，溯汴之湍。","汴湍不常，水衡不官。","惟虞溢毁，靡虞舟槃。","舟槃粮覆，粮孰为足。","大计之数，万百惟六。","帛币错货，三倍其谷。","曰主厥漕，王之荩臣。","日忧河涸，运智烦神。","以舫实土，约流束津。","百步之间，若牙与龈。","朝涨夕降，滞舸次鳞。","亟乞于朝，朝不即报。","下上经营，风并日曝。","其躬其勤，秉心有操。","士岂无禄，视此则冒。","彼以荣佚，此以劬耗。","愿答其劬，锡命锡诰。"],0,"x65","宋"],["上邓宪生辰  其一一","杨简","四言",["洎阳为邑，罹旱则甚。","故维私邑，蒙泽亦甚。"],0,118,"宋"],["米元章临晋武帝大水帖赞","岳珂","四言",["论帖至晋，书法之祖。","溯晋而西，又举一武。","扑散质寓，意妍态鲁。","禁脔之藏，尚觌真古。"],0,"x202","宋"],["赠英公大师","李颂","四言",["篆高神品，秀爽天骨。","敏搆机先，谈深理窟。","浚极苍源，玄臻籀闼。","玉无疵瑕，车有𫐐𫐄。","达识圆明，灵襟洞豁。","粹禀飞星，胸挂流月。","大饮陶陶，闲游兀兀。","肯如常人，名利干没。"],0,225,"宋"],["乾道七年恭上太上皇帝太上皇后尊号十一首 其十一 内侍官举太上皇后册宝诣读册位用《圣安》。","郊庙朝会歌辞","四言",["敛福于郊，逢时之泰。","揭名日月，侔德覆载。","自我作古，域中有大。","永言保之，眉寿无害。"],0,"x207","宋"],["御楼 其四","郊庙朝会歌辞","四言",["恩覃春煦，令布风驰。","声名昭晰，文物葳蕤。","重森宝扇，将降端闱。","永光国典，翕受天祺。"],0,"x207","宋"],["光宗皇帝待月诗御书赞","岳珂","四言",["疏篁阴阴，长松矫矫。","苔静云闲，山清月皎。","乐以心会，兴因天随。","以诗观诗，是谓管窥。"],0,"x202","宋"],["宋江三十六赞 其三十二 拚命三郎石秀","龚开","四言",["石秀拚命，志在金宝。","大似河鲀，腹果一饱。"],0,103,"宋"],["皇祐亲享明堂六首 其五 酌献用《孝安》。","郊庙朝会歌辞","四言",["艺祖造邦，二宗绍德。","肃雍孝享，登配圜极。","先训有开，菲躬何力。","歆馨锡羡，保民丽亿。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 太昊氏位奠币用《嘉安》。","郊庙朝会歌辞","四言",["卜岁之初，我迎春祗。","孰克侑飨，曰古宓戏。","于皇宓戏，万世之德。","再拜稽首，敢爱斯璧。"],0,"x207","宋"],["寒山持经拾得手接 其二","释师范","四言",["自有一经，不肯受持。","却从他觅，可煞愚痴。"],0,"x155","宋"],["宋江三十六赞 其十六 混江龙李俊","龚开","四言",["乖龙混江，射之即济。","武皇雄争，自惜神臂。"],0,103,"宋"],["宋颂九首 其五 明道","石介","四言",["不怒而威，不疾而速。","百蛮偷息，百官重足。","土无二主，惟辟作福。"],0,105,"宋"],["宋江三十六赞 其十三 花和尚鲁智深","龚开","四言",["有飞飞儿，出家尤好。","与尔同袍，佛也被恼。"],0,103,"宋"],["示善应道人","释咸杰","四言",["善应无私，当阳有准。","直下承当，入佛祖阃。"],0,92,"宋"],["懒瓒和尚赞","释智愚","四言",["石林冰冷，粪火芋香。","深拨浅得，滋味最长。"],0,"x153","宋"],["懒瓒和尚赞","释智愚","四言",["枕石苔生，崖藤影绿。","天书促行，芋子未熟。"],0,"x153","宋"],["太常乐章又七首 其五 奉币","杨亿","四言",["醴齐良洁，有牲斯纯。","大采玄冕，乃昭其文。","王宫定位，粢盛苾芬。","民事以叙，玄德升闻。"],0,"x47","宋"],["绝命偈","张宗旦","四言",["法本心生，心因法昧。","有觉于此，是名自在。","自在真空，顿然明彻。","去住寻常，晓然春雪。"],0,87,"宋"],["上邓宪生辰  其一二","杨简","四言",["维公诞弥，端月维时。","梦维熊罴，何以寿之。","南山维基，大椿植之。","毋祝毋祈，公自有之。","某也作颂，于以敬之。"],0,118,"宋"],["汉诏郡县行乡饮酒礼颂诗 其五","洪遵","四言",["先圣严严，拜跪荐祭。","冠缨莘莘，鳞差栉比。"],0,18,"宋"],["北窗伊吾 其五","赵戣","四言",["伊吾维吾，何以为娱。","爰心其声，钟磬笙竽。"],0,237,"宋"],["熙宁以后享庙五首 其五 英宗用《大康》。","郊庙朝会歌辞","四言",["赫赫英皇，总提邦纪。","浚发神功，恢张圣理。","仙驭虽遥，鸿徽不弭。","永言孝思，竭诚躬祀。"],0,"x207","宋"],["嘉定二年册皇太子四首 其一","郊庙朝会歌辞","四言",["于皇我宋，受命于天。","升储主鬯，衍庆卜年。","典册告备，庭工载虔。","万乘莅止，端冕邃延。"],0,"x207","宋"],["宋颂九首 其六 皇祖","石介","四言",["既剪二盗，圣武烜耀。","荆潭蜀吴，如拔腐草。"],0,105,"宋"],["高宗建炎初祀昊天上帝 上帝酌献用《嘉安》。","郊庙朝会歌辞","四言",["气萌黄钟，万物资始。","钦若高穹，吉蠲时祀。","神策泰元，增授无已。","群生熙熙，函蒙繁祉。"],0,"x207","宋"],["百丈大师赞","释清远","四言",["慧灯续传，福庭宜敞。","常住世间，水月镜像。","是谓丛林，大智百丈。"],0,116,"宋"],["偈颂六十五首 其十三","释咸杰","四言",["世尊拈花，勾贼破家。","迦叶微笑，声前失照。","雪峰辊毬，双放双收。","玄沙未彻，眼中拔屑。","云门顾鉴，递相脱赚。","俱胝竖指，全无巴鼻。","遮一队汉，敌国家财。"],0,92,"宋"],["李伯阳赞 其一","白玉蟾","四言",["三花聚顶，五气朝元。","入众妙门，玄之又玄。"],0,"x77","宋"],["宝陀三句 其一","释普济","四言",["宝陀一路，来来去去。","撞著鳌头，风波无数。"],0,73,"宋"],["绍兴以后祀五方帝六十首 高阳氏位奠币用《嘉安》。","郊庙朝会歌辞","四言",["飙驭云盖，神之顾歆。","丕昭礼容，发扬乐音。","祀事既举，仰当神心。","申以嘉币，式荐诚谌。"],0,"x207","宋"],["戏作墨竹二本赠鹤林因为之赞 其二 露筱","白玉蟾","四言",["一枝嫩绿，数叶老苍。","夜半月明，清露瀼瀼。"],0,"x77","宋"],["赞法海真","释宗杲","四言",["廓圆通门，续云门派。","燕坐胡床，虎视百怪。","佩毗卢印，摧伏魔外。","一句当阳，电光非快。","不动道场，而入三昧。","赞之毁之，俱遭白癞。"],0,"x112","宋"],["宋江三十六赞 其十四 行者武松","龚开","四言",["汝优婆塞，五戒在身。","酒色财气，更要杀人。"],0,103,"宋"],["景德以后祀五方帝十六首 其一 青帝降神用《高安》。六变。","郊庙朝会歌辞","四言",["四序伊始，三阳肇新。","气迎东郊，蛰户咸春。","功宣播殖，泽被生民。","祝史正辞，昭事惟寅。"],0,"x207","宋"],["偈颂六十五首 其五十三","释普济","四言",["古佛堂前，三头六臂。","祖师门下，道绝人荒。","衲僧者里，银山铁壁。","慧日峰顶，春风和气。"],0,73,"宋"],["代诸生送蒋守 其二","徐积","四言",["长淮之南，楚为最剧。","守者为谁，以才以德。","守既视事，未逾厥月。","吏则胥畏，民则胥悦。","物来必应，事至立决。","守之动静，皆有法度。","不苟不简，不暴不怒。","处烦以敏，辅严以恕。","庭无滞讼，狱无冤囚。","民无愁叹，俗有歌讴。","古之三府，谣言奏事。","今岂不然，兼采公议。","付之使节，是以用之。","付之远俗，是以重之。","其俗既平，其刑既清。","章德表功，来朝两宫。","两宫圣明，柱上记名。"],0,"x123","宋"],["效朱公叔绝交诗","薛澄","四言",["东山有枭，不祥其名。","恶木是息，恶声是鸣。","食不弃腐，饮不择清。","宜飞求伏，以晦为明。","凶残满志，嗜欲惟撄。","伸颈招凤，使凤自惊。","岂有凤口，而和枭声。","奈何伊人，弗审物情。","请从此别，各自谋生。"],0,30,"宋"],["忠厚吟","邵雍","四言",["小人斯须，君子长久。","斯须倾邪，长久忠厚。"],0,"x57","宋"],["高宗郊前朝献景灵宫二十一首 其一 皇帝入门用《干安》。","郊庙朝会歌辞","四言",["维皇齐居，承神其初。","颙颙昂昂，龙步云趋。","景钟铿如，肃觐清都。","肸蚃之交，神人用孚。"],0,"x207","宋"],["陈绿云先生之像赞","白玉蟾","四言",["瞻师之神，寒空片月。","知师之心，红炉点雪。","闻师之德，冰清玉洁。","见师之迹，霜炎冰热。","师之一言，斩钉截铁。","师之一行，杀人见血。","风月情怀，松筠志节。","道法陆沉，玄徒瓦裂。","师领郡檄，雷轰电掣。","冠冕洞宫，兴大施设。","轮舆楩楠，陶埏坯甈。","丽以粉奂，饰以藻楶。","不逾年间，沧江贯折。","度五神足，霞裙森列。","方有伦绪，闬闾洽悦。","胡为云鹤，奄归帝阙。","溪山失翠，猿鸟凄切。","散词玉祠，柏子一𦶟。","追慕替绚，使人哽咽。"],0,"x77","宋"],["乾道七年恭上太上皇帝太上皇后尊号十一首 其四 册宝出门用《正安》。","郊庙朝会歌辞","四言",["天门九重，荡荡开彻。","金支秀华，垂绅佩玦。","或导或陪，率履不越。","注民耳目，四表胥悦。"],0,"x207","宋"],["颂古一百二十一首 其九十五","释宗杲","四言",["五逆闻雷，曾参颜回。","一粒豆子，爆出冷灰。"],0,"x112","宋"],["六世祖师画像赞 三祖","惠洪","四言",["六道暗昏，不碍明洁。","毫厘弗差，证甘露灭。","但赤头颅，特讳名氏。","离见超情，欲尽世累。","潜溪海山，麻衣风帽。","翩然往来，被褐怀宝。","精一其诚，声名俱舍。","后世丘坟，犹无知者。"],0,"x42","宋"],["宏海侍者请赞","释普宁","四言",["这川䖃苴，全不仁者。","握起老拳，佛祖也怕。"],0,119,"宋"],["偈颂六十五首 其四","释咸杰","四言",["久雨忽晴，天清地宁。","寒山抚掌，拾得忻忻。","恁么会得，旱地遭钉。"],0,92,"宋"],["绍兴祀岳镇海渎四十三首 其六 东海位。","郊庙朝会歌辞","四言",["澒洞鸿蒙，天与无极。","导纳江汉，节宣南北。","顺助其功，善下惟德。","我祀孔时，以介景福。"],0,"x207","宋"],["宋颂九首 其七 明道","石介","四言",["惟帝之道，与时语默。","静则坤阖，动则干辟。"],0,105,"宋"],["戏作墨竹二本赠鹤林因为之赞 其一 风筠","白玉蟾","四言",["新梢凝翠，落照馀红。","乱鸦噪罢，叶叶清风。"],0,"x77","宋"],["乌巨山逵长老命立首座持师顶相请赞","释昙华","四言",["烟林风姿，山岳气宇。","坐看春回，行无伴侣。","不图成佛，岂欲作祖。","一句掀翻，万机罔措。","更提柱杖，击涂毒鼓。","立禅持归，分付乌巨。"],0,47,"宋"],["宋颂九首 其二 圣文","石介","四言",["彼俶在杭，有地千里。","皮毁毛落，孤睽莫恃。","慑服声教，慕为臣使。","携彼人民，挈其土地。","于橐于囊，归于天子。"],0,105,"宋"],["宋颂九首 其一 圣文","石介","四言",["圣文安安，圣武桓桓。","朝贡万里，正朔百蛮。","无吴之险，无蜀之艰。","无潭之嚚，无荆之顽。","咸予宾顺，悦色和颜。"],0,105,"宋"],["景祐亲郊三圣并侑二首 其一 奠币用《广安》。","郊庙朝会歌辞","四言",["千龄启运，三后在天。","嘉坛并侑，亿万斯年。"],0,"x207","宋"],["净名居士赞","释智愚","四言",["一默雷轰，是非顿起。","示疾毗耶，大虫无齿。"],0,"x153","宋"],["宋颂九首 其三 圣文","石介","四言",["天子神圣，罔不怀柔。","既怀而封，恩涵泽流。","逆予有刑，视彼扬州。","顺予有封，视此钱侯。","赫赫宋德，何有穷休。"],0,105,"宋"],["绣释迦像并十八罗汉赞 第二迦诺迦伐蹉尊者","惠洪","四言",["苍髯紫鳞，上有悬锡。","玉像金瓶，层置立石。","蛮王跪看，炉烟上直。","手搯珠轮，心境俱寂。"],0,"x42","宋"],["颂古三首 其二","释宗印","四言",["一亩之地，三蛇九鼠。","物是定价，钱是足数。"],0,84,"宋"],["高宗郊祀前朝享太庙三十首 其一 皇帝入门用《干安》。后还前殿并同。","郊庙朝会歌辞","四言",["于皇我后，祗戒专精。","假于有庙，祖考是承。","趋进惟肃，僾思惟诚。","神之听之，来燕来宁。"],0,"x207","宋"],["宝祐二年皇子冠二十首 其十三","郊庙朝会歌辞","四言",["冠醮之义，匪酬匪酌。","于户之西，敬共以恪。","金石相宣，冠醮相错。","帝祉之受，施及家国。"],0,"x207","宋"],["颂古四十八首 其二","释慧开","四言",["不落不昧，两采一赛。","不昧不落，千错万错。"],0,65,"宋"],["赞灵源和尚二首 其一","释守卓","四言",["拳下翻身，竿头进步。","万派同归，灵源独露。","瓦砾光辉，风云流布。","千眼那知，群心自度。"],0,42,"宋"],["高宗建炎初祀昊天上帝 上帝位奠玉币用《嘉安》。","郊庙朝会歌辞","四言",["治极发闻，不瑕有芬。","嘉玉陈币，神届欣欣。","诚心昭著，钦恭无文。","以妥以侑，笃祜何垠。"],0,"x207","宋"],["颂古十七首 其二","释师观","四言",["青天霹雳，何处寻觅。","一人传虚，万人传实。"],0,210,"宋"],["绵  其七","王梦应","四言",["自今以始，日就月将。","遹观厥成，为龙为光，长发其祥。","兄及弟矣，乃生男子。","维其有之，是以似之。"],0,254,"宋"],["送梁必大归杭省亲 其三","黎廷瑞","四言",["瞻彼日月，有望有弦。","慨彼中年，别友实难。","有芹于池，有芝于山。","式遄其归，勿远其还。"],0,18,"宋"],["祗奉天书六首 升降用《灵文》。","郊庙朝会歌辞","四言",["旻穹无声，惟德是辅。","降监锡符，垂文篆素。","孝瑞纪封，英声载路。","既寿而昌，笃天之祜。"],0,"x207","宋"],["偈颂六十首 其三十七","释昙华","四言",["元正启祚，更无回互。","万物咸新，截铁斩钉。","应时纳祜，跳出窠臼。","孟春犹寒，言端语端。","知事头首，各各希有。","云堂大众，雍容郑重。"],0,47,"宋"],["偈颂六十五首 其六","释咸杰","四言",["即心即佛，铁牛无骨。","非心非佛，空山突兀。"],0,92,"宋"],["景德以后祀五方帝十六首 其六 奠玉币、酌献用《嘉安》。景祐用《祐安》，辞亦不同。","郊庙朝会歌辞","四言",["象分离位，德配炎精。","景风协律，化神含生。","百嘉茂育，乃顺高明。","神无常享，享于克诚。"],0,"x207","宋"],["景德以后祀五方帝十六首 其九 奠玉币、酌献用《嘉安》。景祐用《祐安》，辞亦不同。","郊庙朝会歌辞","四言",["中央定位，厚德惟新。","五行攸正，四气爰均。","笙镛以间，簠簋斯陈。","为民祈福，肃奉明禋。"],0,"x207","宋"],["景德以后祀五方帝十六首 奠玉币、酌献用《嘉安》。景祐用《祐安》，辞亦不同。","郊庙朝会歌辞","四言",["博硕肥腯，以炰以烹。","嘉栗旨酒，有弥斯盈。","肴核惟旅，肃肃烝烝。","吉蠲备物，享于克诚。"],0,"x207","宋"],["景德以后祀五方帝十六首 其十五 奠玉币、酌献用《嘉安》。景祐用《祐安》，辞亦不同。","郊庙朝会歌辞","四言",["大仪斡运，星纪环周。","三时不害，黍稷盈畴。","克诚致享，品物咸羞。","礼成乐变，锡祚贻休。"],0,"x207","宋"],["绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其十三","郊庙朝会歌辞","四言",["鞠育保护，母道备矣。","密赞亲传，德其至矣。","彩服来朝，慈容有喜。","既受鸿名，又多受祉。"],0,"x207","宋"],["梁溪四友赞序 其二 虚心赞","李纲","四言",["君子学道，其心贵虚。","此君之心，一物本无。","劲节坚竦，清影扶疏。","剑拔环侍，十万丈夫。","细细其香，猗猗其绿。","滴露和烟，锵金戛玉。","与子为友，惟日不足。","何年栖凤，慰此幽独。"],0,"x136","宋"],null,["上邓宪生辰  其五","杨简","四言",["古之遗直，亟辅予德。","疾风劲草，岁寒松柏。"],0,118,"宋"],["颂一百则 其五十九","释重显","四言",["象王嚬呻，师子哮吼。","无味之谭，塞断人口。","南北东西，乌飞兔走。"],0,"x156","宋"],["宋颂九首 其四 皇祖","石介","四言",["予亦即祚，涵濡养抚。","罔有失所，予德其裕。"],0,105,"宋"],["登彼公堂燕贡士 其四","陈襄","四言",["登彼公堂，鸿飞戾止。","君子燕湑，维其不已。"],0,50,"宋"],["偈颂二十五首 其十五","释普岩","四言",["令不虚行，箭不虚发。","傥或踌躇，二九十八。"],0,182,"宋"],["登彼公堂燕贡士 其三","陈襄","四言",["登彼公堂，维山崔嵬。","君子燕湑，其志不回。"],0,50,"宋"],["送梁必大归杭省亲 其一","黎廷瑞","四言",["悠悠楚水，霭霭吴云。","孰作之合，胡然而分。","岂无良朋，我独子忻。","于穆令德，有粲其文。"],0,18,"宋"],["送梁必大归杭省亲 其二","黎廷瑞","四言",["吴云霭霭，楚水悠悠。","眷念庭闱，道阻且修。","为贫而仕，匪食孰求。","曷不偕来，以解尔忧。"],0,18,"宋"],["宋江三十六赞 其十八 小李广花荣","龚开","四言",["中心慕汉，夺马而归。","汝能慕广，何忧数奇。"],0,103,"宋"],["嘉祐亲享明堂二首 其一 降神用《诚安》。","郊庙朝会歌辞","四言",["烨烨房心，下照重屋。","我严帝亲，匪配之渎。","西颢沆砀，夕景已肃。","灵其来娭，嘉荐芳郁。"],0,"x207","宋"],["宁宗郊祀二十九首 再诣盥洗。","郊庙朝会歌辞","四言",["帝登初觞，礼严再盥。","精明显昭，齐颙洞贯。","灵娭留俞，神光炳焕。","我宋受福，永寿于万。"],0,"x207","宋"],["三教合一面赞","释智愚","四言",["龟证无功，会三归一。","各有面子，不欲露出。"],0,"x153","宋"],["筠州圣祖殿诗 其二","苏辙","四言",["于穆圣祖，宅神皇极。","降鉴在下，子孙千亿。","羽衣玉佩，旗纛旄节。","巍巍煌煌，秩祀万国。"],0,"x135","宋"],["建隆郊祀八首 其七 亚献、终献用《正安》。","郊庙朝会歌辞","四言",["谓天盖高，其听孔卑。","闻乐歆德，介以福禧。"],0,"x207","宋"],["送鼎倅陈安仁虞部","冯山","四言",["峨峨阳山，民资以仁。","僭阳欺天，不需不神。","而乞于民，泱泱沅江。","城繄以宁，横流溃川。","不畜不灵，将坎于城。","暴政残俗，剧于怀襄。","猾胥扰民，甚于凶荒。","借公后时，吾民几亡。","舞公入城，若旱而雨。","若霖而晴，颂公之还。","孰灵沅江，孰神阳山。"],0,190,"宋"],["魏京诗 其二十一","刘敞","四言",["孰为强暴，敢不来觐。","俾怛于威，于忠是训。"],0,"x51","宋"],null,["筠州圣祖殿诗 其一","苏辙","四言",["高安在南，分自豫章。","重山复江，鱼鸟之乡。","俗野不文，吏亦怠荒。","礼失不知，习为旧常。"],0,"x135","宋"],["高宗建炎初祀昊天上帝 升坛用《正安》。","郊庙朝会歌辞","四言",["皇矣上帝，神格无方。","一阳肇复，典祀有常。","豆登丰洁，荐德清香。","棐诚居歆，降福穰穰。"],0,"x207","宋"]]