[["偈","释圆济","四言",["雨过山青，云开月白。","带雪寒松，摇风庭柏。"],0,32,"宋"],["神功盛德诗  其二四","华镇","四言",["济济朝廷，有名有实。","多士在服，百工励翼。","礼乐兴矣，刑政既达。","郁乎有文，绍周之则。"],0,"x106","宋"],["乾道七年恭上太上皇帝太上皇后尊号十一首 其八 太傅奉太上皇后册宝升殿用《圣安》。","郊庙朝会歌辞","四言",["乾元资始，坤元资生。","允也圣德，同实异名。","春王三朝，典册并行。","咨尔上公，相仪以登。"],0,"x207","宋"],["采蕺 其三","王十朋","四言",["厥草匪甘，厥蔬匪香。","维其味之，岂曰嗜之。","心焉孔焦，胆焉亟尝。","唯其苦之，是以取之。"],0,"x61","宋"],["偈颂三首 其一","释行巩","四言",["横眸碧汉，万国风清。","垂手红尘，千峰日出。"],0,241,"宋"],["放翁自赞四首 其二","陆游","四言",["名动高皇，语触秦桧。","身老空山，文传海外。","五十年间，死尽流辈。","老子无才，山僧不会。"],0,"x41","宋"],["石霜普照珂禅师赞","惠洪","四言",["漆瞳照座，骨相巉岩。","横拈麈拂，寒拥云衫。","五住名刹，道振湘南。","是谁之子，亲见云庵。"],0,"x42","宋"],["暑热","白玉蟾","四言",["玉友避嫌，竹奴专宠。","听官丐闲，诗勇不将。"],0,"x77","宋"],["和陶命子韵示津调官 其五","吴芾","四言",["勿谓吾身，有才有德。","可以安世，可以益国。","不善用之，鲜不为忒。","所以古人，戒之在得。"],0,"x95","宋"],["临终辞众偈","释元聪","四言",["来未尝来，去未尝去。","七十四年，月印寒渚。"],0,28,"宋"],["偈八首 其七","释仁勇","四言",["大方无外，大圆无内。","无内无外，圣凡普会。","瓦砾生光，须弥粉碎。","无量法门，百千三昧。"],0,187,"宋"],["永嘉真觉大师真赞","惠洪","四言",["情根无功，意识无作。","现量圆成，见闻知觉。","如镜受灯，光无坏杂。","烈火焚烧，河流湍逝。","谷风怒号，大地依止。","俱无知思，亦复如是。","此涅槃门，如鼓涂毒。","曹溪挝之，闻者僵仆。","以椎授公，万像惊缩。","光明之语，粲如日星。","精严之行，清如玉冰。","惟不传者，与空相应。","我初学道，如握与拳。","晚乃觉之，如手安然。","有时而用，搏取大千。"],0,"x42","宋"],["太常乐章三十首 其五 皇帝酌献第一室奏大善之舞曲","杨亿","四言",["肃肃艺祖，肇基洪源。","权舆光大，燕翼贻孙。","载祀惟永，庆流后昆。","威灵在天，顾我司存。"],0,"x47","宋"],["道从上人","释祖钦","四言",["惟道是从，惟心是宗。","空即是色，色即是空。","梦幻了了，来去匆匆。","水中之月，树上之风。","作如是观，无塞不通。"],0,64,"宋"],["紫岩九章章八句上寿张丞相  其一","张元干","四言",["赫赫紫岩，白虹贯渊。","玉生其中，匪雕匪镌。","登于廊庙，圭璋浑全。","温如之质，所宝象贤。"],0,"x183","宋"],["和陶时运四首，并引 其二","苏轼","四言",["下有澄潭，可饮可濯。","江山千里，供我遐瞩。","木固无胫，瓦岂有足。","陶匠自至，啸歌相乐。"],0,"x67","宋"],["汾阳昭禅师真赞","惠洪","四言",["维摩杜口，释迦饶舌。","动容顾瞻，非默非说。","虽宣一字，不露点墨。","稽首汾阳，千圣同辙。"],0,"x42","宋"],["和陶时运四首，并引 其一","苏轼","四言",["我卜我居，居非一朝。","龟不吾欺，食此江郊。","废井已塞，乔木干霄。","昔人伊何，谁其裔苗。"],0,"x67","宋"],["颂古","释昙华","四言",["居士倒地，灵照扶起。","乞儿伎俩，讨甚巴鼻。"],0,47,"宋"],["家国吟","邵雍","四言",["邪正异心，家国同体。","邪能败亡，正能兴起。"],0,"x57","宋"],["和冯济川题枯髅图","释法清","四言",["形骸在此，其人何在。","日炙风吹，掩彩掩彩。"],0,141,"宋"],["偈颂四十二首 其九","释祖先","四言",["马祖升堂，百丈卷席。","正令不行，拗曲作直。"],0,54,"宋"],["嵩禅师赞","惠洪","四言",["欧阳之学，师宗于世。","其徒喧阗，攻我以喙。","童首儒林，气索力屈。","公于是时，粹然一出。","天纵之辩，武库纵横。","璜玑捍我，如护目睛。","义如串肉，理如析薪。","一时名誉，耸动缙绅。","世尊举身，毛孔俱笑。","如公语言，笔下皆妙。","六物不坏，未易致诘。","岂其践履，明验之力。","宗教之衰，河坏山摧。","冠巾缁衲，其寒如灰。","拂拭尘翳，见冰雪容。","拜起而喟，涕落无从。"],0,"x42","宋"],["和陶命子韵示津调官 其四","吴芾","四言",["乔木千寻，竟困斧柯。","屈原特立，终陨汨罗。","水行地中，尚值坳窊。","纵如贾谊，犹滞长沙。"],0,"x95","宋"],["赞死心禅师偈 其一","释惟久","四言",["韶阳死心，灵源甚深。","耳中见色，眼里闻声。","凡明圣昧，后富前贫。","利生济物，点铁成金。","丹青徒状，非古非今。"],0,117,"宋"],["文宣王及其弟子赞 其十","赵构","四言",["谦德知二，器实瑚琏。","动必几先，孰并其辩。","一使存鲁，五国有变。","终相其主，誉处悠远。"],0,249,"宋"],["哑子观音赞","释子益","四言",["赞者舌秃，画者口哑。","篮里锦鳞，愈增高价。"],0,63,"宋"],["颂古七十六首  其七五","释士珪","四言",["口是祸门，电掣雷奔。","娑竭出海，震动乾坤。"],0,232,"宋"],["长沙岑大虫真赞","惠洪","四言",["长沙大虫，声威甚重。","独眠空林，百兽震恐。","寂子儿戏，见不知畏。","引手捋须，几缺其耳。","大空小空，是虎是你。","如备与觉，可撩其尾。","嗟今衲子，眼如裴旻。","但见其彪，安识虎真。","我拜公像，非存非没。","百尺竿头，行尘勃勃。"],0,"x42","宋"],["赞死心禅师偈 其二","释惟久","四言",["死心非真，真非死心。","虚空无状，妙有无形。","绝后再苏，亲见死心。"],0,117,"宋"],["转轮八花诗 其六","项安世","四言",["槁枯滋泽，偃屈抽芒。","稻畦远翠，蕙径幽香。","皂舆喜洽，风流激扬。"],0,"x55","宋"],["宽猛吟","邵雍","四言",["宽则民慢，猛则民残。","宽猛相济，其民自安。"],0,"x57","宋"],["观音真赞 其三","释慧空","四言",["此大开士，愿力弘深。","初无自相，随众生心。","或以土木，至于缕线。","但有少缘，悉皆出现。","终不自言，我自于谁。","惟令见者，默尔知归。"],0,"x118","宋"],["皇雅十首  其七","尹洙","四言",["蜀都既平，将臣失律。","此众悍骄，彼民危栗。","当涂叫呶，合万为一。","匪怀则威，帝心是恤。"],0,108,"宋"],["颂古五首 其三","释慧光","四言",["偷吃油糍，卖弄口觜。","年老成魔，谩神吓鬼。"],0,255,"宋"],["和陶命子韵示津调官 其九","吴芾","四言",["既有馀力，且亲灯火。","读破万卷，百倍于我。","我恨书少，意不自可。","汝能雪耻，天亦见假。"],0,"x95","宋"],["偈颂一百六十九首 其一五五","释智朋","四言",["丛林圣制，有解有结。","透脱重关，红炉点雪。"],0,18,"宋"],["荣木和陶靖节韵","程洵","四言",["我卜我居，游息在兹。","有荣者木，日封殖之。","本根既固，发生以时。","我时倾瞻，中心慨而。","维人之生，孰本孰根。","惟皇降衷，天理具存。","是曰成性，道义之门。","钦斯承斯，大化以敦。","嗟彼世人，自安浅陋。","德不图新，恶或念旧。","有干惟禄，有觊惟富。","孰能毅然，不为利疚。","我怀师训，罔敢失坠。","匪道曷从，匪义曷畏。","圣门虽远，率焉以冀。","庶几疲驽，久亦告至。"],0,115,"宋"],["颂古五首 其四","释文准","四言",["人人生缘，北律南禅。","道吾打鼓，华亭撑船。"],0,254,"宋"],["须菩提赞","释师观","四言",["老老大大，岩中宴坐。","帝释雨花，见个什么。"],0,210,"宋"],["十画四言","孔平仲","四言",["亨倅沉俗，泥虬卧虹。","星君促面，省座班封。","修治克茂，果有昌宗。","耻于便幸，宜效孤忠。"],0,"x150","宋"],["荣木","范成大","四言",["薰风南来，木荣于兹。","木荣几时，黄落从之。","逝其须臾，坐成四时。","今我不学，殆其已而。","天旋地游，日月其根。","形息气徂，不亡者存。","去乡离家，莫肯过门。","猗欤先师，不我疵陋。","褰衣示珠，俾我复旧。","自我来归，十年不富。","孰蠹孰蛊，惟汝自疚。","冉冉荣木，霜华将坠。","天黑路长，屹蹶可畏。","隶也不力，奚取六骥。","脂车著鞭，一息而至。"],0,"x52","宋"],["禅人写余真求赞 其二","释慧方","四言",["古松怪石，全体是我。","若谓一如，莫教话堕。"],0,45,"宋"],["题枯髅图","冯楫","四言",["形骸在此，其人何在。","乃知一灵，不属皮袋。"],0,78,"宋"],["天禧三年册皇太子一首","郊庙朝会歌辞","四言",["明离之象，少阳之位。","固邦为本，体天作贰。","仪范克温，礼章斯备。","丕宣令猷，恭守宗器。"],0,"x207","宋"],["为黄仲宣赋山中四章章四句  其三","方回","四言",["山中之人，耘夫耕民。","鲭厥五侯，其如子真。"],0,"x59","宋"],["颂古四十四首 其一","释法泰","四言",["生无所生，死无所死。","风动尘飞，波澄浪止。","和合离散，随处发现。","满月弯弓，双雕一箭。"],0,238,"宋"],["山行见月作 其三","赵蕃","四言",["东坡老翁，有言莫酬。","凉天佳月，即为中秋。"],0,"x36","宋"],["观世音赞六首 其六","黄庭坚","四言",["敬礼补陀，岩下水边。","十方三世，无不现前。","愿我亦证，空觉极圆。","处处悲救，火中生莲。"],0,"x66","宋"],["淳化乡饮酒三十三章  其一七","郊庙朝会歌辞","四言",["崇丘峨峨，动植斯属。","高既自遂，大亦自足。","和风斯扇，膏雨斯沐。","我仁如天，以亭以育。"],0,"x207","宋"],["新安吕公尚书夫人坟","徐积","四言",["彼美新安，有水有山。","有坟岿然，百五十年。","爰有曾孙，赤韨朱轩。","来守兹土，以慰斯坟。","扫除必躬，奉祠必亲。","水毛陆产，膋牲上尊。","百物皆具，千兵骏奔。","观者如堵，从者如云。","心追无穷，诚通无垠。","溟漠之魄，恍惚之魂。","如辟其涂，如启其门。","如兴于寝，如作于室。","如出黄泉，如见白日。"],0,"x123","宋"],["兴祖","释崇岳","四言",["有祖以来，世不可陪。","当机日用，著著全该。"],0,222,"宋"],["皇雅十首  其一四","尹洙","四言",["帝怀永图，治古是宪。","四方守臣，惟屏惟翰。","在昔艰难，弗惠训典。","跨都连城，高牙以建。","有土有民，肆乃征缮。","以息以容，终焉叛涣。","凡今帅臣，狃厥闻见。","匪革乱原，曷清多难。"],0,108,"宋"],["偈二十七首 其十一","释守净","四言",["慧不厌修，福不厌作。","福慧双收，如虎戴角。","作既无作，修亦无修。","青山绿水，短棹孤舟。","格外之谈，迥出常流。"],0,166,"宋"],["宋江三十六赞 其三 玉麒麟卢俊义","龚开","四言",["白玉麒麟，见之可爱。","风尘大行，皮毛终坏。"],0,103,"宋"],["寂音自赞四首 其四","惠洪","四言",["随缘放旷，索尔虚闲。","未埋白骨，且看青山。"],0,"x42","宋"],["偈颂一百六十九首 其一一八","释智朋","四言",["木骨金妆，似则也似。","瞬目扬眉，西天此土。"],0,18,"宋"],["龙山补亡，并引 其一","苏轼","四言",["征西天府，重九令节。","驾言龙山，宴凯群哲。","壶歌雅奏，缓带轻帢。","胡为中觞，一笑粲发。","楩楠竞秀，榆柳独脱。","骥𫘧交骛，驽蹇先蹶。","楚狂醉乱，陨帽莫觉。","戎服囚首，枯颅茁发。","惟明将军，度量豁达。","容此下士，颠倒冠袜。","宰夫杨觯，兕觥举罚。","请歌《相鼠》，以侑此爵。"],0,"x67","宋"],["龙山补亡，并引 其二","苏轼","四言",["吾闻君子，蹈常履素。","晦明风雨，不改其度。","平生丘壑，散发箕裾。","坠车天全，颠沛何惧。","腰适忘带，足适忘屦。","不知有我，帽复奚数。","流水莫系，浮云暂寓。","飘然随风，非去非取。","我冠明月，佩服宝璐。","不缨而结，不簪而附。","歌诗宁择，请饮《相鼠》。","罚此陋人，俾出童羖。"],0,"x67","宋"],["殉节诗  其四","方氏","四言",["举世须眉，何殊巾帼。","偏我妇人，尚知报国。"],0,228,"宋"],["宋江三十六赞 其一 呼保义宋江","龚开","四言",["不假称王，而呼保义。","岂若狂卓，专犯忌讳。"],0,103,"宋"],["辞众颂","释了证","四言",["来时本无，去亦非有。","珍重诸人，月明清昼。"],0,201,"宋"],["三次四言韵二首 其一","洪炎","四言",["入圣有域，存诚以闲。","德不德上，材不材间。","堂上不粪，门设常关。","鄙哉丘垤，覆篑为山。"],0,110,"宋"],["三次四言韵二首 其二","洪炎","四言",["编贝皓齿，含朱绛唇。","甄陶圆熟，琢削细匀。","不笑不言，倚席以颦。","商略有此，为若而人。"],0,110,"宋"],["汉诏郡县行乡饮酒礼颂诗 其八","洪遵","四言",["咏仁蹈德，骎骎措刑。","舄弈千载，薰为太平。"],0,18,"宋"],["公迈何遄  其一","曾丰","四言",["公之西矣，蜀人是谣，都人是嚣。","诏予华衮，亟哉来朝。","彩熊既税，彩鹢既发。","月逗岁遛，竣其未达。","都人曰嘻，吾国君师。","欲猷欲为，未得良毗。","公归何迟。"],0,"x193","宋"],["赠庞公","徐积","四言",["司马德操，来就庞公。","杖履直入，名姓不通。","坐其堂上，指挥呼索。","催令作黍，云我有客。","庞公妻子，堂下罗列。","拜且听命，奔走陈设。","此时庞公，适自外归。","忽见司马，其喜可知。","一堂之上，相从笑语。","其旁观者，莫分客主。","我读其书，爱其古风。","真厚如此，精诚交通。","量如溟海，义薄云空。","至于妻子，亦为叹者。","苟非其人，往往见骂。","盖有是夫，而有是妇。","能佐夫义，善敬夫友。","可警薄俗，可示厥后。"],0,"x123","宋"],["偈二首 其一","释继成","四言",["太阳门下，日日三秋，从东过西。","明月堂前，时时九夏，指鹿为马。"],0,16,"宋"],["辞众偈","释法祚","四言",["七十七年，幻缘忽破。","秋水无痕，霜天月堕。"],0,41,"宋"],["慈感圭老请赞无量寿像","释居简","四言",["十方取土，曰清泰城。","又曰极乐，与苦浊邻。","厌苦知乐，不毫忽间。","一念勇往，即念而瞷。","惟忆惟念，匪疾匪迟。","忆而不忘，念兹在兹。","如求亡子，如丧考妣。","如疢需石，如渴需水。","以如是故，曾何远人。","人人亡羊，入生死轮。","法法惟心，心亦非心。","郑卫嘈杂，水鸟树林。","悠悠渐修，额额阐提。","同摄罔遗，妙在不疑。","疑则疑城，日劫倍蓰。","东隅既失，桑榆可冀。","粤若二仲，达圆顿机。","路壅般舟，手自剪夷。","池栽芬陁，社结名胜。","一十有八，是修是证。","天台嗣响，的传自衡。","和者如云，调高倡宏。","六朝逮今，衣冠缁褐。","愚夫愚妇，爰同此筏。","哂乃二瓠，载沉载浮。","即窒即海，善柳柳州。","见月因摽，执指成咎。","舍有相佛，观无量寿。"],0,"x94","宋"],null,["偈颂一百六十九首 其七十九","释智朋","四言",["莺老花残，春事已过。","明眼衲僧，多是蹉过。","楝花信风，不肯放过。","万户千门，一时俱过。","筑著磕著，是谁之过。","转换不得，也要验过。"],0,18,"宋"],["五方帝 其八","郊庙朝会歌辞","四言",["帝乘中央，沉载函蒙。","经纬四方，物性滋丰。","金石之荐，象德以宫。","神锡嘉虞，介祉无穷。"],0,"x207","宋"],["偈颂四首 其三","释道济","四言",["一块两块，佛也不怪。","一醒两醒，佛也不嗔。","一碗两碗，佛也不管。"],0,220,"宋"],["郊祀庆成诗","陈襄","四言",["皇帝即位，厉精求治。","翼翼兢兢，以畏天异。","乃见宗庙，乃严郊祭。","赫赫烈祖，陟配上帝。","皇帝肇祀，心虔诚至。","斋居撤膳，夙兴弗寐。","不履黄道，不御小次。","出宿于庙，阴雨翳翳。","既其徂郊，日出晰晰。","登丘奏假，天地澄霁。","礼终乐阕，神贶来暨。","皇帝还跸，千乘万骑。","雷动天旋，臣民欣慰。","御楼肆赦，躬册丹地。","恩流泽洽，周匝无际。","惟诚感神，惟德销沴。","皇帝能飨，时赐坐致。","臣愿皇帝，事天寅畏。","左右惟贤，安民惟惠。","无咈忠谏，无轻政事。","日新一日，庶答天意。"],0,50,"宋"],["和陶命子韵示津调官 其六","吴芾","四言",["我幸此生，不忘本始。","身虽朝廷，心实田里。","所以暮年，知足知止。","以进为忧，以退为喜。"],0,"x95","宋"],["自戒","徐元杰","四言",["震畏四知，我畏我知。","心之所畏，天不可欺。"],0,242,"宋"],["黄杨","王十朋","四言",["嘉彼黄杨，郁焉其苍。","匪瓮而圆，匪盖而张。","百干同根，森如弟昆。","千枝其子，万叶其孙。","惟此黄杨，先子所植。","草木有义，先子之德。","愿言我家，兄弟子孙。","如此嘉树，永为义门。"],0,"x61","宋"],["悟首座图余幻质复求为赞","释清远","四言",["廓然无圣，俨尔有容。","明明绝眹，密密垂踪。","昔也怀宝，枯木藏龙。","今其示人，巨岳乔松。","龙吞万类，松茂三冬。","神而不改，风云必从。","吾形既得，尔道自钟。","褒斜路险，汉水朝宗。"],0,116,"宋"],["太庙","郊庙朝会歌辞","四言",["大享合宫，于礼莫盛。","入太室祼，遍于列圣。","陟降有仪，一主乎敬。","祀事孔明，邦家之庆。"],0,"x207","宋"],["畴依  其七","王柏","四言",["於穆文王，顺帝之则。","身蒙大难，小心翼翼。","三分有二，以服事殷。","可谓至德，万邦仪刑。"],0,"x137","宋"],["碧云 其三","赵蕃","四言",["寒镫既张，幽室有光。","岂无他人，惟子之良。","闭彼柴荆，今夕斯长。"],0,"x36","宋"],["偈颂七十一首 其三十八","释了惠","四言",["权实双行，主宾互立。","拿空塞空，以的破的。"],0,62,"宋"],["淳化乡饮酒三十三章  其二三","郊庙朝会歌辞","四言",["郁郁芳兰，佩服珍之。","温温恭人，福履绥之。"],0,"x207","宋"],["三月十三日夜五更闻杜鹃时成父欲入浙因赋六章章四句以送之  其二","赵蕃","四言",["归去来兮，斯言可师。","我今已归，胡能不知。"],0,"x36","宋"],["辞世颂","释普度","四言",["八十二年，驾无底船。","踏翻归去，明月一天。"],0,144,"宋"],["偈颂十二首 其一","释道璨","四言",["无个入处，奔走杀人。","有个入处，碍塞杀人。"],0,93,"宋"],["至道元年册皇太子二首 其二","郊庙朝会歌辞","四言",["皇储既建，圣祚无疆。","鸾旌列叙，鸡戟分行。","前星有烂，瑞日重光。","际天接圣，温文允臧。"],0,"x207","宋"],["至道元年册皇太子二首 其一","郊庙朝会歌辞","四言",["主鬯之重，允属贤明。","承华肇启，上嗣腾英。","礼修乐举，育德开荣。","一人元良，万邦以宁。"],0,"x207","宋"],["偈颂九首 其七","释玿","四言",["与么文彩，甚生标格。","直下承当，迥超言默。"],0,109,"宋"],["采薇吟","仇远","四言",["采薇采薇，西山之西。","薇死复生，不生夷齐。","陟彼西山，我心悲兮。"],0,"x84","宋"],["禅人画师像请赞 其四","释如珙","四言",["持刀杀人，人心不死。","赤手杀人，人心不死。","伎俩俱尽，人心自死。"],0,255,"宋"],["畴依  其五","王柏","四言",["昔在帝尧，咨舜一语。","允执厥中，舜亦命禹。","危微精一，义复兼举。","三圣授受，独盛前古。"],0,"x137","宋"],["畴依  其八","王柏","四言",["武王达孝，善继善述。","盟津既誓，干戈载戢。","访于箕子，洪范以陈。","惟皇建极，反复丁宁。"],0,"x137","宋"],["续琴操哀江南 瞻彼江汉四之二","谢翱","四言",["瞻彼江汉，截淮及楚。","起兵海隈，亡命无所。","枕戈待旦，愤不顾身。","我视王室，谁非国人。","噫嘻昊天，使汝缧绁。","奸党心寒，健儿胆裂。","黄河万里，冰雪峨峨。","尔死得死，我生谓何。"],0,222,"宋"],["偈四首 其二","释天游","四言",["三百五百，铜头铁额。","木笛横吹，谁来接拍。"],0,192,"宋"],["公迈何遄  其三","曾丰","四言",["公之南矣，潭人是怀，洪人是留。","议夺朱幡，亟哉还休。","御者既靷，饯者既挽。","俄驰顷驱，僄其未返。","洪人曰嘕，吾土山川。","有真有仙，可伴长年。","公迈何遄。"],0,"x193","宋"],["和陶命子韵示津调官 其八","吴芾","四言",["我不望汝，勋业济时。","纵得入侍，朝夕论思。","欲供子职，何如在兹。","人能尽孝，忠岂远而。"],0,"x95","宋"],["畴依  其三","王柏","四言",["虞舜侧微，重华协帝。","父顽母嚚，烝烝以乂。","天理之极，人伦之至。","恭己当天，云行雨施。"],0,"x137","宋"],["迎奉圣像四首 其一 玉皇位。","郊庙朝会歌辞","四言",["玉虚上帝，金像睟容。","宅真云构，练日龟从。","维皇对越，率礼寅恭。","灵心丕应，福禄来崇。"],0,"x207","宋"]]