[["忆江南","吴绍烈","词",["飘泊久，无处觅归船。","三月莺花春似梦，九秋风雨夜如年。","肠断奈何天。"],0,142,"近现代"],["采桑子","吴绍烈","词",["无情却是秋深雨，分外凄清。","滴碎愁心。","一夜孤眠梦不成。","闲阶早起多惆怅，落叶飘零。","霜草辞根。","圃底残花带泪痕。"],0,142,"近现代"],["菩萨蛮","吴绍烈","词",["西风不卷闲愁去。","丝丝依旧如秋雨。","雨落鸟声收。","愁来意转柔。","为怜芳草瘦。","独步黄昏后。","十里浑忘痴。","归来灯火迟。"],0,142,"近现代"],["浣溪沙","吴绍烈","词",["欲了相思倍觉难。","伤心往事怕重弹。","几回梦见影姗姗。","好把真珠传密字，暗将消息背人看。","千重愁恨万重山。"],0,142,"近现代"],["少年游","吴绍烈","词",["朱桥碧野是耶非。","往事尚依稀。","柳堤嫩绿，镜湖新月，低首共徘徊。","角声惊破春宵梦，忍泪各分飞。","留得辛酸，西窗抵足，何日再来归。"],0,142,"近现代"],["浣溪沙","吴绍烈","词",["湖海飘零似转蓬。","几回西去几回东。","徒将哀怨寄秋风。","说到归期惟有泪，算来家讯又成空。","不堪惆怅月明中。"],0,142,"近现代"],["鹧鸪天","吴绍烈","词",["噩梦何须说夙因。","柔肠断尽不成声。","拼将一世青衫泪，赢取千秋薄幸名。","新月好，晓风清。","落花流水两无情。","荒江一啸三千里，解得伤心能几人。"],0,142,"近现代"],["长相思三阕 其一","吴绍烈","词",["长相思，意迟迟。","离人心事乱如丝。","酸辛事，有谁知。","愁来拼一睡，醒罢又成痴。","念君身渐瘦，不似在家时。"],0,142,"近现代"],["长相思三阕 其二","吴绍烈","词",["长相思，望归难。","客中霜早怯衣单。","归讯杳，怕依栏。","秋声惊落叶，乡梦恨更残。","飘零何日极，终岁不成欢。"],0,142,"近现代"],["长相思三阕 其三","吴绍烈","词",["长相思，意绵绵。","五溪风雪自年年。","柔肠结，晚灯前。","欲知凶共吉，夜夜卜金钱。","枕边愁更密，羞对月娟娟。"],0,142,"近现代"],["扬州慢","吴绍烈","词",["弱柳牵丝，撩人愁绪，慵来生怕登楼。","看娇花弄影，听巧鸟歌喉。","料春到江南未久，绿杨飘絮，碧野如油。","念佳人初试新装，恁自凝眸。","容颜消瘦，苦风波何事淹留。","恨戍火连天，哀笳匝地，怎整归舟。","只有梦中飞去，乘风稳任我遨游。","奈鸡窗魂冷，依然涕泪难收。"],0,142,"近现代"],["好事近 贺同学婚礼","吴绍烈","词",["佳约订前生，争羡诗飘红叶。","今夜双星齐会，任鹊桥长设。","烛花并蒂证同心，紧挽罗衣结。","天遣百年好合，艳比团圆月。"],0,142,"近现代"],["卖花声","吴绍烈","词",["陌上草萋萋。","无限芳菲。","撩人丝柳尽依依。","绿到江南春正好，人隔天涯。","梦里总凄迷。","杜宇声催。","五更犹唤不如归。","残月枝头孤枕泪，忧恨谁知。"],0,142,"近现代"],["鹊桥仙 一九四四年初夏于秀山石耶司","吴绍烈","词",["一春消息，两重心事，都被春风吹去。","客愁乡思最浓时，正处处落红无数。","倚窗低唱，凭栏独语。","休问相思几许。","楼头待到月黄昏，怕听那杜鹃声苦。"],0,142,"近现代"],["醉花阴","吴绍烈","词",["芳草垂杨知道否。","又是春归去。","客里最惊心，燕子来时，连日风和雨。","楚天渺渺无归路。","尽多情谁诉。","小立又黄昏，且把愁怀，分付漫空絮。"],0,142,"近现代"],["换巢鸾凤 一九四五年于北碚嘉陵江畔","吴绍烈","词",["月魄惊寒，正江风吹浪，暮霭侵烟。","低徊怜倩影，软语透清欢。","叮咛记取意千般。","怎知而今魂萦梦牵。","关情处，拼几度泪痕衣满。","春晚。","芳讯断。","愁见飞花，离恨生箫管。","酒困无眠，依灯填句，苦惹柔肠千转。","曾信相思忒伤神，生来争奈情难遣。","诗中仙，也沉迷醉里香远。"],0,142,"近现代"],["玉漏迟","吴绍烈","词",["客愁深几许。","风高月冷，扁舟南浦。","慢桨轻桡，漫惹荻花芦絮。","任使波光照影，奈流水无心延伫。","凭望处。","渔村夜悄，满汀凫鹭。","只今兴味消沉，剩意倦情慵，病余羁旅。","十载飘游，都被俗尘牵误。","幸有诗篇伴我，争胜似欢歌狂舞。","谁与语。","寂寞断烟残雨。"],0,142,"近现代"],["鹊桥仙","吴绍烈","词",["嘉陵江畔，缙云山下，尽是伤心景色。","霜风才送雁南飞，又听到寒梅消息。","归舟未觅，旗亭又设。","莫惜骊歌慢拍。","人生能得几相逢，况复是天涯倦客。"],0,142,"近现代"],["点绛唇 题张啸虎《山城狂欢集》","吴绍烈","词",["寇已投降，传来消息翻疑梦。","欢声雷动。","乐极还思痛。","血战年年，多少青青冢。","和平颂。","从今高诵。","三叠阳关弄。"],0,142,"近现代"],["满庭芳","吴绍烈","词",["北雁初来，西风乍起，又是秋满人间。","客乡霜重，衾薄五更寒。","回首江南旧景，一万里险阻关山。","凭栏久，乡心逐水，飞度皖江边。","万家歌胜利，烽烟断处，人庆团𪢮。","念髫龄弱妹，白发慈颜。","纵有巴山蜀水，终不若早买归船。","离情苦，灯前梦里，别意总绵绵。"],0,142,"近现代"],["点绛唇","吴绍烈","词",["莫恋巴山，一帆归去江南好。","碧杨芳草。","绿抹春山巧。","行遍天涯，尽是崎岖道。","佳音少。","残秋霜老。","梦断鸡窗晓。"],0,142,"近现代"],["误佳期","吴绍烈","词",["连日落花风雨。","误却归期几许。","重来不见蝶翻飞，惆怅春将去。","缱绻白云闲，寂寞川江暮。","待将归去觅寒梅，路怯千山阻。"],0,142,"近现代"],["浣溪沙","吴绍烈","词",["迥野风回劲草摧。","枫林霜叶锁寒枝。","覆巢飞鸟不须归。","一点禅心空了了，百年人事总非非。","莫辞樽酒夜迟迟。"],0,142,"近现代"],["醉落魄","吴绍烈","词",["晚风清软。","桐花落尽深深院。","离怀难写箫声怨。","倚遍危栏，望断千山远。","梦里依稀怜缱绻。","尊前舞罢衣香散。","一灯愁对终宵惯。","睡也模糊，醒是凄凉伴。"],0,142,"近现代"],["水龙吟 和陈定山先生","吴绍烈","词",["几番密约沉沉，相思原系巫山外。","层峰障眼，飞鸿不度，难传密意。","别久情怀，尊前花下，也应憔悴。","便春风重到，催开桃李。","归未必，浑无计。","忍把韶光轻弃。","拼今生痴情无悔。","殊乡索寞，伤心凝立，秋江碧水。","检点音书，旧时衷曲，都成红泪。","待梦中寻觅，愁心一点，为伊人碎。"],0,142,"近现代"],["点绛唇","芍印","词",["蕉雨风窗，昨夜幽梦知多少。","流莺啼晓。","睡醒嫣然笑。","卷上湘帘，慢试晨妆好。","妆台悄。","读诗多拗。","还把回文钞。"],0,10,"近现代"],["捣练子","芍印","词",["烟柳瘦，露桃稀。","花信风深万绿肥。","雨泽朝来飘洒遍，满园春色竞芳菲。"],0,10,"近现代"],["阮郎归","芍印","词",["半窗蕉雨湿帘钩。","夜沉思转幽。","藕花风起送书楼。","更深生乱愁。","风阁静，篆烟收。","背灯人影柔。","坐残银漏露华浮，黛眉能展不。"],0,10,"近现代"],["踏莎行","芍印","词",["金鸭香销，银镫影瘦。","不堪情绪听更漏。","一帘丝雨一帘风，秋声何事侵窗牖。","寒到单衾，凉笼双袖。","瓶花憔悴灯花逗。","下帷欹枕梦难成，无聊最是黄昏后。"],0,10,"近现代"],["好事近 探梅","芍印","词",["践约探仙姿，绿萼依稀凝影。","脂点暗香飘逗，似罗浮仙境。","凌云玉骨艳还净。","晚霞正红映。","临水娉婷明靓，尽流连幽径。"],0,10,"近现代"],["浣溪沙 留别","芍印","词",["柳色长亭赋别愁。","飞花落叶替君留。","临歧判袂两悠悠。","一曲阳关流万泪，几重烟水隔双眸。","武林怕见月如钩。"],0,10,"近现代"],["鹊桥仙 七夕","芍印","词",["银河泻怨，鹊桥填恨，好驾云𫐌共处。","聘钱十万竟难偿，祗博得金风一度。","红颜不老，佳期常有，却胜广寒迟暮。","沉沉琼户听霓裳，定妒那牛郎织女。"],0,10,"近现代"],["一剪梅 寄曼姊","芍印","词",["梦断吴山隐翠螺。","豪兴消磨。","素志蹉跎。","春来心事托沧波。","闷里狂歌。","闲里低哦。","瘁雨噤寒慢踏莎。","行入烟萝。","绿染轻罗。","沉思影事似南柯。","音滞关河。","愁拥诗魔。"],0,10,"近现代"],["蝶恋花 秋日游公园","芍印","词",["秋淡红销人意恼。","裙履联吟，缓步园林好。","浅碧粼粼鱼影杳。","萧条风物寒烟绕。","僻境深藏三径草。","小作勾留，喜把风尘扫。","随意芒鞋凌缥渺。","凭他秋暮和春晓。"],0,10,"近现代"],["采桑子","芍印","词",["晶轮飞上高寒处，凉露清风。","兴逸情浓。","如此良宵眉展峰。","凭栏悄对沉沉景，影自溶溶。","梦自慵慵。","花气香烟度玉栊。"],0,10,"近现代"],["浪淘沙","芍印","词",["斜日小阑干。","柳瘁枫瘅。","断魂可奈雁声寒。","一剪西风帘半卷，翠袖愁单。","客梦几阑珊。","茗淡香残。","诗愁酒病两回环。","倦倚黄昏无意绪，思叠眉弯。"],0,10,"近现代"],["鹧鸪天","芍印","词",["画阁平桥映绿漪。","满园风物引秋思。","几番踏遍来时路，爱看娟娟翠筱姿。","疑好梦，梦成痴。","前尘回首倍凄其。","重山复水无穷恨，目断天空渺后期。"],0,10,"近现代"],["浪淘沙","芍印","词",["杨柳绿依然。","缕缕愁牵。","小楼残照夕阳天。","雾鬓风环偎倚处，几度流连。","悄立镜屏前。","羞比双肩。","瘦腰清态许人怜。","回首梦痕愁欲绝，如此缠绵。"],0,10,"近现代"],["一剪梅","芍印","词",["怕听潇潇风过桐。","佳节秋中。","望断征鸿。","一轮明月隔山重。","客邸西风。","小阁帘栊。","倚遍栏干梦亦慵。","枫叶摇红。","秋色偏浓。","桂花采得寄书筒。","代我微衷。","慰尔离悰。"],0,10,"近现代"],["水调歌头 落叶","芍印","词",["云树正依黯，客梦漫淹留。","关河到处萧瑟，风雨数声秋。","立尽黄昏庭院，祗惜纷飞片片，无力上帘钩。","飘泊异时泪，卷恨上西楼。","湿红凝，寒翠敛，几多愁。","前尘往迹，曾共烂漫恋枝头。","坠粉零脂旧恨，白露苍烟新怨，并与哭荒邱。","但愿委流水，那复羡莺俦。"],0,10,"近现代"],["水龙吟 新春夜倦酒，归后感赋","芍印","词",["暖帘香澈梅花，炉温语软春无限。","杯空柏叶，声盈爆竹，风檐月转。","烛影摇红，觥筹交错，酒阑人散。","怕归来夜悄，满庭清雾，酲未醒，心情懒。","省识华年多幻。","尽东风暗庚葭琯。","柳梢怨月，花茵嗔露，春魂易断。","怅雨愁风，感时怀旧，怎禁撩乱。","更从头细数，朝朝暮暮，倩流莺唤。"],0,10,"近现代"],["水调歌头","芍印","词",["暗雨扑帘重，残泪滴黄昏。","绿窗梦断寒月，何处寄吟魂。","消尽颠狂岁月，争奈韶华苦短，浪自逐红尘。","满袖北风冷，小阁凝寒云。","菊花寂，梅萼冱，怯霜晨。","乱愁如雨，飞入苍莽了无痕。","断岸烟平十里，极望征鸿有几，此恨更成新。","依黯寸心远，摇落锁青门。"],0,10,"近现代"],["沁园春","芍印","词",["月冷阑干，冰冱衾裯，了无梦痕。","尽愁烟恨雨，飘零金粉，落花流水，断送青春。","雨益风凄，晴添月怨，万态迷茫环此身。","伤情处，看游丝有意，罥树无因。","销魂。","绮思殷勤。","感芳草幽花心自亲。","记薰风池畔，荷香沁臆，流霞天际，桂影扶轮。","秋晚堪娱，春回有信，人意还同酒味醇。","斜阳好，奈恹恹小病，伴我黄昏。"],0,10,"近现代"],["南乡子","芍印","词",["明月又团圆。","枨触红妆对画筵。","细数欢愁经几许，萦牵。","只觉清闲不似前。","小病夏初天。","强起梳妆倦欲眠。","为问情缘何日了，缠绵。","总在穹苍播弄间。"],0,10,"近现代"],["蝶恋花","芍印","词",["别后光阴春已老。","梅子黄时，故国薰风早。","记否离筵欢未了。","醉中堕橘嗤然笑。","一样天涯怜绿草。","载酒携朋，酲味何乡好。","想像卖花声带俏。","不堪回首情怀恼。"],0,10,"近现代"],["桃源忆故人","芍印","词",["连绵风雨愁如水。","一派凄凉心事。","桃子黄梅鲜荔。","尝尽酸甜味。","好花烟景年年媚。","祗是人情多异。","穿上旧时单帔。","觅个新来醉。"],0,10,"近现代"],["苏幕遮 订婚周岁纪念日同游黄浦公园","芍印","词",["碧云悄，华月烂。","江上清风，纤縠无珠汗。","天水澄鲜光似练。","话旧论新，枨触流年换。","绿阴幽，银炬灿。","美景良宵，丝记同心绾。","似锦韶华堪眷恋。","但愿年年，永结神仙伴。"],0,10,"近现代"],["摊破浣溪沙","芍印","词",["恍似秋风起幕间。","夜灯袅袅隔轻寒。","无限思量情宛转，不成眠。","落寞青襟同一哭，骚愁幽恨倩谁怜。","吹彻潇湘怨憔悴，梦难圆。"],0,10,"近现代"],["锁窗寒","芍印","词",["积雨缄愁，飘风咽恨。","小窗人愠。","宵灯影里，苦忆旧时云鬓。","黯销凝，酣舞醉歌，斜阳芳草余春尽。","剩而今寥落，人情冷澹，软红劳困。","幽愤。","情难稳。","正满目苍凉，寸心似烬。","回风引逗，梦到天涯无分。","醉花间，桃李自春，几经回首成一哂。","赋归欤，何处清风，传得鸿边信。"],0,10,"近现代"],["洞仙歌","芍印","词",["红情绿意，最销魂何处。","小病羞笼黛眉妩。","凭床娇不起，倚枕沉吟。","罗幌外，澹月轻烟薄雾。","行云如梦远，回首前游，旧日风光总难驻。","待说与清愁，笑我娇痴，花月下，未谙情语。","恁缱绻檀郎太多情，惯问暖嘘寒，密怜深护。"],0,10,"近现代"],["菩萨蛮 其一","芍印","词",["无言悄傍阑干立。","白纱衫子轻装窄。","恁地太生分。","众宾望似云。","举杯酬月子。","言笑多清旨。","无处致殷勤。","何因重识君。"],0,10,"近现代"],["菩萨蛮 其二","芍印","词",["酒阑席冷欢声寂。","人归画阁酲怀激。","斜月漾高楼。","背灯羞展眸。","无端成稔识。","暂聚分离即。","春水不关情。","关情愁正萦。"],0,10,"近现代"],["菩萨蛮 其三","芍印","词",["秋风闲却珍珠箔。","绿窗细逗炉烟薄。","诗课正清闲。","绿衣邮使颁。","无由通款曲。","泛语还肫笃。","云影隔重天。","临风思渺绵。"],0,10,"近现代"],["菩萨蛮 其四","芍印","词",["为谁端正茶烟暖。","栏干倚处湘帘卷。","几度费低徊。","伊人来不来。","别时依约记。","乍见还疑忌。","疏影月黄昏。","清谈花下温。"],0,10,"近现代"],["菩萨蛮 其五","芍印","词",["梅香散处炉烟暖。","嬉春宴闹芳樽满。","蜡炬晕新红。","娇颜光欲融。","论杯无约法。","歌唱欢情洽。","转笑个人痴。","引吭矜隽奇。"],0,10,"近现代"],["菩萨蛮 其六","芍印","词",["小园烟景浮新绿。","回廊曲径留芳躅。","小立并香肩。","镜波双影妍。","雅谈无戏狎。","同气双情洽。","输意结同盟。","枝头鸣友声。"],0,10,"近现代"],["菩萨蛮 其七","芍印","词",["游丝不结同心扣。","相思何处抛红豆。","端是没来由。","贻书喻好逑。","答言何怫郁。","只恼人唐突。","儿本自由花。","安知宜室家。"],0,10,"近现代"],["菩萨蛮 其八","芍印","词",["昼长惯被东风困。","隔宵情绪含余愠。","玉版接琳琅。","引愆如不遑。","欲前还驻步。","香肩羞无语。","莫道喜嫌猜。","问君该不该。"],0,10,"近现代"],["菩萨蛮 其九","芍印","词",["平陵碧草匀春褶。","长堤柳色侵双靥。","飘瞥两轮驰。","乘风归去时。","与君消结愠。","野外探春讯。","运转自由车。","倩郎为掖扶。"],0,10,"近现代"],["菩萨蛮 其十","芍印","词",["月明昨夜风帘揭。","晓莺啼梦情丝绝。","寂寂艳阳天。","隔帘人半眠。","屧声归院急。","含笑拈花立。","同此惜花情。","宵来窗半明。"],0,10,"近现代"],["菩萨蛮 其十一","芍印","词",["绿窗黯黮春光瘦。","萦心有事双眉皱。","何以解春酲。","落花飞满庭。","拈毫轻渍墨。","悄倚胡床侧。","集得锦玑辞。","替侬题卷眉。"],0,10,"近现代"],["水调歌头","吴寿彭","词",["净沙点白鹭，乔木啭黄莺。","断矶遮住溪路，菰浦一川明。","南浦垂杨过雨，晴翠香粳满圃，谷口谁云耕。","荷芰美花实，水竹自华清。","野桥边，流水外，虏尘惊。","顿成平地关塞，听取炮车声。","试问残鸦飞止，谁占碧澜城里，瓯脱几道横。","系泊有游艇，弥气杂膻腥。"],0,150,"近现代"],["临江仙 千秋岭上","吴寿彭","词",["溪路马蹄周两浙，江山不负清游。","思傍岩桂寄贞幽。","千峰无语秀，万壑有清流。","挣取闲身领水石，白云漫载归休。","谁同岭上看岚浮。","磴萝题嶂壁，落叶得诗遒。"],0,150,"近现代"],["临江仙 思孝丰山居","吴寿彭","词",["稍喜清闲正入手，小窗青映丛筠。","静看萝蔓绕篱樊。","引溜添残雨，汲涧采丝莼。","心赏未须拼乐事，酒慵思怯声闻。","树梢低度一溪云。","鸣禽改节候，逸景挂疏榛。"],0,150,"近现代"],["西江月","吴寿彭","词",["寂寞芳菲几度，时光驹隙堪惊。","此楼缅想直生情。","润雨芰荷分暝。","吹落晚风宿鹭，闹池阵骤蛙鸣。","可无新恨涨澴瀯。","似旧湖烟滞碇。"],0,150,"近现代"],["红芍药 勉儿曹勤学","吴寿彭","词",["人生百岁，七十已稀少。","更除十年孩童小。","又十年昏老。","都来五十岁，一半被睡魔分了。","那二十五岁之中，宁无些个烦恼。","仔细思量，读书须赶早。","采菊滋兰堪寄傲。","学得智能好。","翅翮逞矫健，低翔高翥似林鸟。","向春来雨润阳和，乐共东风欢笑。"],0,150,"近现代"],["鹧鸪天","吴寿彭","词",["胶澳重逢涴演边。","年时未办炙肥鲜。","乍疑别久丰标似，交际爱君最静虔。","说不尽，十年前。","瓦沟骤雨泻如川。","明朝雨止舟还日，半幅相期报短篇。"],0,150,"近现代"],["青玉案","吴寿彭","词",["淮山望澈滔滔处。","长堤决，黄流注。","前路莫占晴和雨。","参旗挂树。","津鼓风传，从此故人去。","远游自是多辛苦。","过尽征鸿无寄语。","薇露夜深思旧土。","它乡久旅。","几度星霜，哀郢漫成句。"],0,150,"近现代"],["朝中措 江上","吴寿彭","词",["偏安常是误南金。","士道薄梁陈。","词旨江令浮艳，文章庾信哀深。","海门望极，滔滔逝水，波咽初心。","江上数峰笼晚，六朝恨绝遗音。"],0,150,"近现代"],["鹧鸪天 灞桥","吴寿彭","词",["杂树繁花鸟雀喧。","当年何事不窥园。","春阳媚得娇莺咤，锦雉雊留丽泽原。","霜降苑，没烧痕。","六街黄叶已飘翻。","西风渭水寻诗处，驴背如今孰与论。"],0,150,"近现代"],["念奴娇 马嵬坡上","吴寿彭","词",["春光正好，凭三郎、羯鼓杏花催拆。","列国衣冠朝衮冕，功业旷前后绝。","按舞霓裳，兴庆池北，解语真尤物。","长安盛事，丽人杜老能说。","警起渔阳角吹，胡骑南牧，尘蔽关山月。","簇仗翠华西入蜀，阁道霖铃哀彻。","自是君王，天纵圣武，此地与咽别。","莫须追问，越娃何予吴灭。"],0,150,"近现代"],["水调歌头 静夜思","吴寿彭","词",["客樯洄江海，疲马短长亭。","节候晦冥风雨，何事苦经营。","城市山林占遍，微觉人间冷暖，祇是扰均成。","老去甘岑寂，趣味足癯清。","官堤柳，断阪霜，几周星。","哀乐中年意尽，犹自惜惺惺。","杓转秋穹深处，驼坐渐工室内，噫气弥和平。","孤檠照形体，天宇净三更。"],0,150,"近现代"],["鹧鸪天 寿漆园熊老九秩","吴寿彭","词",["真坠杞天惜此身。","千秋谁守纸灰尘。","少时力士椎秦手，老去陈编见智仁。","破空疏，入密深。","烬余勘尽几芸蟫。","伏生九十传书日，莫管后贤别古今。"],0,150,"近现代"],["蝶恋花","吴寿彭","词",["纵有飞花冒堕絮。","数点危红，管教留春住。","又是一番风和雨。","燕泥香染春终去。","水馆山村无着处。","没个安排，更莫追欢绪。","祇是根株护绿浦。","浅深还放年年树。"],0,150,"近现代"],["浪淘沙二首 其一","吴寿彭","词",["高下乱云横。","一霎涛惊。","狂飙闪电海如倾。","渐渐风雷消散了，还我澄泓。","霞照远山明。","岛屿秋清。","向来埼曲碧澜泠。","沙嘴当前潮落处，楼阁蜃生。"],0,150,"近现代"],["浪淘沙二首 其二","吴寿彭","词",["夜定桅灯荧。","和梦波声。","起看河汉隔疏星。","芒角长庚晕澹月，影净西溟。","既久占阴晴。","持此伶俜。","天涯赢得是虚名。","心事平居都已了，没个牵萦。"],0,150,"近现代"],["踏莎行","吴寿彭","词",["倦酒余酲，坊鸡啼曙。","池塘夜雨涵朝雾。","曲栏斗雀噪春残，落红满地将谁护。","海瀚山暝，云遥津树。","何人会得登临句。","际天沆漭没惊鸿，孤邀明月留秋住。"],0,150,"近现代"],["菩萨蛮 其一 咏费尼克斯","吴寿彭","词",["凤凰闻说振沙碛。","朝阳千里腾云翼。","彬质茂容姿。","焚身应世期。","雏生焰尚𦶟。","韶濩又成德。","千载再来仪。","焕辉良未迟。"],0,150,"近现代"],["菩萨蛮 其二","吴寿彭","词",["几番革变斯文熄。","几番剩语开闭塞。","仁至倍栖皇。","游辞值披猖。","抱残当纪末。","不死守其阙。","旦复或光昌。","谁能补其亡。"],0,150,"近现代"],["江城子二首 其一","吴寿彭","词",["几番尘俗共栖遑。","一思量。","正难忘。","追忆承欢，更莫说凄凉。","临老牛衣恩亦怨，如运会，久心藏。","安排家事费周章。","祓灾殃。","喜余昌。","无限劬劳，儿女婚嫁忙。","待到诸孙同献寿，将若处，省慈祥。"],0,150,"近现代"],["江城子二首 其二","吴寿彭","词",["熙春年少镇相随。","奈今衰。","孰扶持。","沙上鸥闲，夕照映东池。","好是山青掩骨处，湖澜远，静相宜。","心疑我亦不多时。","苦寻思。","致安夷。","人世可哀，休结再生期。","只应泉壤来作伴，云水际，落月迟。"],0,150,"近现代"],["虞美人 忆汤","章衣萍","词",["畅观楼外初相见。","花底相偎颤。","风吹露湿各西东。","最是不堪回忆月明中。","别来六载音书杳。","病久心情悄。","人前只道不思量。","且向高楼含泪看斜阳。"],0,87,"近现代"],["蝶恋花 深秋上海迁居，有怀","章衣萍","词",["十里红尘无着处。","秋到江南，老尽江南树。","岁岁重阳苦病累。","看花总被重阳误。","孤傲心情谁共语。","独看白云，懒与俗人住。","夜夜梦魂何处去。","梵王渡畔行人路。"],0,87,"近现代"],["菩萨蛮 公园池畔信步","章衣萍","词",["风吹落叶池中去。","无聊人在无人处。","往事怕回头。","回头总是愁。","墙阴悄独立。","闷对斜阳泣。","憔悴为情多。","情多可奈何。"],0,87,"近现代"],["浪淘沙 追记夏间莫干山独步夕阳下看山","章衣萍","词",["独步白云间。","游思漫漫。","看山镇日不曾闲。","知道青山也有意，红了苍颜。","远道忆幽欢。","见也都难。","春云秋梦早消残。","还有那人忘不得，倚遍栏干。"],0,87,"近现代"],["临江仙 忆家","章衣萍","词",["蓦地西风吹树老，菊花看到梅花。","病中何事苦忆家。","故园山水好，壮志付烟霞。","十载饥寒归未得，负心深愧啼鸦。","夕阳无语冷窗纱。","病来憔悴甚，倚枕试新茶。"],0,87,"近现代"],["浪淘沙","章衣萍","词",["暮雨滴成愁。","愁上心头。","一生烦恼为风流。","总是相思添病也，病也堪羞。","人在短桥头。","私愿难酬。","夜深何事倚高楼。","雪里偕行浑似梦，梦也难留。"],0,87,"近现代"],["清平乐 赠云","章衣萍","词",["莽莽天涯。","那有知音者。","梦里人儿何处也。","满目离愁难写。","白云摇曳空中。","心随云去西风。","不会涂脂抹粉，居然巾帼英雄。"],0,87,"近现代"],["迈陂塘 雪中送鸿","章衣萍","词",["怪天公无聊无赖，风雨催人上路。","半生只为伤离别，懊恼情怀难诉。","写不尽。","是旧恨新愁，黯黯随人去。","登楼四顾。","叹匝地飞鸦，漫天风雪，行人今何处。","还惆怅，无奈云妹未来。","隔江无计飞渡。","与君同是可怜人，偏我鬓丝先误。","愁无数。","尽一片狂心，绕尽天边树。","青春易度。","只暗里思量，不苦离别，最苦相逢暮。"],0,87,"近现代"],["蝶恋花 有寄","章衣萍","词",["休怨传言鹦鹉误。","欲寄离愁，没寄离愁处。","花事阑珊春早暮。","梦魂夜夜吴淞住。","独对柔波谁共语。","私祝离鸿，休逐东风去。","绕尽海边千万树。","侬心总比君心苦。"],0,87,"近现代"],["摸鱼儿 海边有感","章衣萍","词",["又无端临风惆怅，为谁海边留住。","半年总做淞江梦，恼煞深宵风雨。","君记取。","是瞒了那人，来诉匆匆语。","无量辛苦。","看浊浪连天，痴心万缕，暗逐离鸿去。","红衫客，人儿媚妩如故。","我来休怨迟暮。","一往深情空痴绝，见也无从细诉。","人难住。","叹别离不忍，车上劳延伫。","低声细诉。","愿绝业成时，与君奔走，天涯日出处。"],0,87,"近现代"],["摊破浣溪纱","章衣萍","词",["心事淞江夕照边。","几回相见总相怜。","素手偷亲亲不得，在人前。","客岁重阳才识面，重阳已是又经年。","叶瘦花残浑不管，奈何天。"],0,87,"近现代"],["浣溪纱","章衣萍","词",["夜夜深闺伴凤城。","灯前月下总难分。","悄无人处唤亲亲。","战士高歌空忆曲，辉煌红烛看新人。","多才多艺女儿身。"],0,87,"近现代"],["蝶恋花 时事有感","章衣萍","词",["东北战云日睥睨。","大好山河，多少伤心事。","南渡诸公昏欲死。","神州处处哀鸿泪。","风冷心酸难买醉。","如此人间，那有和平地。","将士头颅枪炮里。","遥闻战鼓雄心起。"],0,87,"近现代"],["江城子","章衣萍","词",["吴淞江上小娇娘。","玉躯长。","鬓云光。","指点闲鸥，同坐话斜阳。","细剥香蕉送郎口，郎莫笑，看鸳鸯。","西风吹老美人妆。","怕倚廊。","怯空房。","盼过新年，郎不渡申江。","懒听寒潮深夜语，侬病也，自心伤。"],0,87,"近现代"],["蝶恋花","章衣萍","词",["独倚危栏看日暮。","郎似清风，侬似风中树。","三月相思无着处。","夜深踏遍吴淞路。","月下海边羞独去。","水色潮声，总是伤心处。","欲唤白云来共语。","天寒云散难留住。"],0,87,"近现代"],["虞美人","章衣萍","词",["梦中几见孤高影。","寒夜薄衾冷。","年来生怕说风流。","不是风流底事泪常流。","对灯难寐添愁绪。","有恨无人语。","好花早向战旗红。","怎奈红旗流血遍江东。"],0,87,"近现代"],["蝶恋花","章衣萍","词",["窗里愁人窗外雨。","望极天涯，寂寞情何许。","肠断海滨携手处。","炮灰马骨人难住。","尝尽中原兵革苦。","写遍云笺，总是伤心语。","底事春来君又去。","斜阳冷落通州路。"],0,87,"近现代"],["浪淘沙 春日有感","章衣萍","词",["淡日照幽窗。","倚遍回廊。","愈难相见愈思量。","弱柳好似娉婷影，柳绿人黄。","往事冷池塘。","水远山长。","孤鸿飘渺断人肠。","写尽情天怜爱字，依旧凄凉。"],0,87,"近现代"],["蝶恋花 春日有怀","章衣萍","词",["愁看和风拂柳叶。","芳草青青，好是春时节。","几处野花香不绝。","怀人总苦相思结。","懒听黄鹂闲弄舌。","有限人生，底事长离别。","无奈江流隔南北。","浮萍岁岁身为客。"],0,87,"近现代"]]