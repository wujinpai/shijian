[["淳化乡饮酒三十三章  其二一","郊庙朝会歌辞","四言",["求之无斁，寤寐所属。","罄尔一心，受天百禄。"],0,"x207","宋"],["淳化乡饮酒三十三章  其二六","郊庙朝会歌辞","四言",["偶其贤德，辅成己职。","永配玉音，服之无斁。"],0,"x207","宋"],["淳化乡饮酒三十三章  其二八","郊庙朝会歌辞","四言",["贤淑来思，人之表仪。","风化天下，何乐如之。"],0,"x207","宋"],["淳化乡饮酒三十三章  其二九","郊庙朝会歌辞","四言",["彼鹊成巢，尔类攸处。","之子有归，琼瑶是祖。"],0,"x207","宋"],["偈颂十二首 其五","释原妙","四言",["五阴山中，魔强法弱。","战之不胜，休拟议著。","宝剑全提，莫问生杀。","奋不顾身，星飞火撒。","有功者赏，无功者罚。"],0,137,"宋"],["颂一百则 其九十八","释重显","四言",["明珠在掌，有功者赏。","胡汉不来，全无伎俩。","伎俩既无，波旬失途。","瞿昙瞿昙，识我也无。"],0,"x156","宋"],["醉乡箴","郑思肖","四言",["维人之生，所主者德。","瞿瞿良士，蔼然温克。","其天其游，养和于默。","勿为气夺，迁其常则。","尔敬尔身，天命难必。","罔越乃行，终其永吉。"],0,"x98","宋"],["文宣王及其弟子赞 其十一","赵构","四言",["文学之目，名重一时。","为君子儒，作魏侯师。","不可后礼，始可言诗。","假盖小嫌，圣亦不疵。"],0,249,"宋"],["临济赞 其二","释师范","四言",["窃不见踪，败不见赃。","是真白拈，其谁与当。"],0,"x155","宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十一","郊庙朝会歌辞","四言",["三礼崇容，八銮警卫。","有来辰仪，阐徽妫汭。","璇宫肃雍，藻景澄霁。","文子文孙，本支百世。"],0,"x207","宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十六","郊庙朝会歌辞","四言",["大安耽耽，兴庆崇崇。","维皇之尊，与天比隆。","非心闲燕，文命延鸿。","欲报之恩，礼缛仪丰。"],0,"x207","宋"],["宁宗郊祀二十九首 降坛。","郊庙朝会歌辞","四言",["帝飨于郊，一精二纯。","紫觚陟降，嘉玉妥陈。","神方留娭，瑞贶纷纶。","申锡无疆，螽斯振振。"],0,"x207","宋"],["时宰生日乐章七首 其七 榆中章第七","周紫芝","四言",["榆关以北，一骑不驰。","孰窥汉月，燧息烽夷。","塞草春荣，夷氓负犁。","九州万井，风恬俗怡。","血属相保，母父子妻。","既续厥嗣，亦活黄莱，几亿万年。","维德所施，礽云来睇。","天之报之，寿之福之。","劫尘可数，此报何期。"],0,"x139","宋"],["偈颂七十六首 其四十一","释师观","四言",["蓦直蓦直，青天白日。","勘破了也，一文不直。"],0,210,"宋"],["魏京诗 其六","刘敞","四言",["业业烝黎，载震载惊。","侵魏及澶，群心不宁。"],0,"x51","宋"],["方丘乐歌 其三","郊庙朝会歌辞","四言",["无疆之德，至哉坤元。","沉潜刚克，资生实蕃。","方丘之仪，惟敬无文。","神其来思，时歆荐殷。"],0,"x207","宋"],["古怨诗  其二","刘敞","四言",["鸿鴈飞矣，或群或伍。","孰是人斯，惸惸其处。"],0,"x51","宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十三","郊庙朝会歌辞","四言",["文母曼寿，载锡之光。","总集瑞命，宜君宜王。","惠以仁显，慈以德彰。","保佑子孙，受福无疆。"],0,"x207","宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其二十二","郊庙朝会歌辞","四言",["文物流彩，銮辂靖陈。","龟瑞荐祉，坤仪效珍。","比皇之寿，翼帝以仁。","和气致祥，与物为春。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其三十二 西渎位。","郊庙朝会歌辞","四言",["自彼昆虚，于以潜流。","念兹诞润，岂侯不犹。","在昔中府，暨海聿修。","迄既望止，神保先卣。"],0,"x207","宋"],["颂古五首 其五","释妙伦","四言",["树动风摇，尘生云起。","太上老君，何曾姓李。"],0,10,"宋"],["翩翩弓之张兮诗三章寄王介甫  其三","王令","四言",["瞻彼车兮，既徴其辐。","有驹斯服，有马斯牧。","心之忧矣，聊以反复。"],0,"x68","宋"],["一经堂","郑裕","四言",["莆之甲姓，实维大方。","紫囊锦帐，阀阅膏粱。","有子盈之，乃其最良。","心志乎道，视之如忘。","博究六艺，并包五常。","东家尼父，北窗羲皇。","日相讨论，兼收并藏。","五经在笥，一经名堂。","谦以自牧，虽晦而光。","实浮于名，虽抑而扬。","伊昔孟氏，排墨与杨。","斯文羽翼，吾道栋梁。","岂特诗书，独称其长。","诸儒之说，于孟何伤。","吾子命名，既择而详。","通而贯之，辉涵汪茫。","剖破藩篱，无门无旁。","默契韶頀，能宫能商。","正蒙析滞，起废针肓。","以一知万，名实孔彰。","人知同好，𫄨句绘章。","玄酒太羹，子独先尝。","经术之门，骥骋康庄。","典谟之文，凤鸣朝阳。","学报天子，业缵星郎。","以经名家，非子谁当。"],0,32,"宋"],["偈颂一一二首 其九","释清远","四言",["总记不得，天花满裓。","纵有千言，不如一默。"],0,116,"宋"],["大观秋分夕月四首 其二 奠玉币。","郊庙朝会歌辞","四言",["玉钩初弯，冰盘乍圆。","扇掩秋后，乌飞枝边。","精凝蟾蜍，辉光婵娟。","歆于明祀，弭芳节焉。"],0,"x207","宋"],["章献明肃皇太后恭谢太庙 其十一","郊庙朝会歌辞","四言",["巍巍新庙，穆穆真皇。","德符二圣，仁洽万方。","坠典咸秩，鸿仪用彰。","威灵如在，时思不忘。"],0,"x207","宋"],["章献明肃皇太后恭谢太庙 其十二","郊庙朝会歌辞","四言",["苾芬既荐，溥硕咸陈。","礼备乐举，先后有伦。","以奉七室，齐洁惟寅。","皇灵斯享，福祥荐臻。"],0,"x207","宋"],["偈颂一百三十三首 其十四","释法薰","四言",["指天指地，小儿子戏。","无可慇勤，浇杓恶水。"],0,31,"宋"],["绍兴祀岳镇海渎四十三首 其十五 南海位。","郊庙朝会歌辞","四言",["维水善下，利物曰功。","逶迤百川，谁欤朝宗。","荡荡大受，于焉会同。","膋萧列陈，以答鸿蒙。"],0,"x207","宋"],["书乐陵王伯年太子传","徐积","四言",["酷哉武成，枉杀乐陵。","一步一杖，绕堂土赪。","投之池中，池水尽赤。","其妃哀号，至死不食。","其指其手，拳不可擘。","九院之后，小尸犹在。","骨碎肉烂，绯袍金带。","一袍有靴，一髻有解。","哀哉呜呼，此儿何罪。","贼人之孤，负人之托。","毒如豺狼，险如溪壑。","身自为孽，其子受之。","扼咽蒙头，连颈横尸。","报应如此，其来勿问。","与其自杀，不容尺寸。","我哀其愚，作为此诗。","永贻厥鉴，勿为险欺。"],0,"x123","宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十四","郊庙朝会歌辞","四言",["华鸾编玉，文螭液金。","颂德摛英，扬徽嗣音。","紫幄天开，翠华日临。","岁岁年年，如周太任。"],0,"x207","宋"],["自赞写真 其二","张纲","四言",["投闲岁久，圣恩图旧。","载锡身章，在帝左右。","骨相多屯，何以瘉人。","陈力就列，勿为具臣。"],0,53,"宋"],["偈颂一百零二首 其四十七","释绍昙","四言",["狗舐油铛，鼠咬甑箅。","用尽机思，吃没滋味。"],0,"x108","宋"],["嘉泰三年皇后册宝十三首 其八","郊庙朝会歌辞","四言",["日月临烛，乾坤覆持。","明并二曜，德合两仪。","光媲宸极，共恢化基。","膺受茂典，亿载永宜。"],0,"x207","宋"],["酬人偈","释宗振","四言",["我有一机，直下示伊。","青天霹雳，电卷星驰。","德山临济，棒喝徒施。","不传之妙，于汝何亏。"],0,240,"宋"],["景德中朝会十四首 降坐用《隆安》。","郊庙朝会歌辞","四言",["被衮当阳，穆穆皇皇。","击石拊石，颂声扬扬。","和乐优洽，终然允臧。","礼成而退，荷天百祥。"],0,"x207","宋"],["文宣王及其弟子赞 其四十九","赵构","四言",["惟彼子之，锡伯期思。","与贤并进，得圣而师。","彬彬雅道，翼翼令仪。","上目至言，庙食不隳。"],0,249,"宋"],["晦堂宝觉真赞","李之仪","四言",["不勉而中，不思而得。","从容中道，是为极则。","胡来胡现，汉来汉现。","随所运用，莫非方便。","在迩求远，知深昧浅。","头上安头，以口为眼。","以相而现，略无异同。","一有所扣，则犹撞钟。","缘不我契，漫尔形容。","稽首导师，如日方中。"],0,"x203","宋"],["和惠宰修县学韵","袁甫","四言",["人爵非贵，天爵惟尊。","贤哉惠侯，兴学祁门。","祁门之士，夙号有文。","兑习久废，索居离群。","自侯来思，锐志兴复。","士脱旧穴，迁于乔木。","人性本善，混混源泉。","四端素具，若火始然。","谁其启之，君子德风。","既修学宫，藏修其中。","内养克充，外养亦备。","尔不吾负，吾宁尔弃。","坛名舞雩，乐道无欲。","梁跨幽涧，潺潺漱玉。","面此清致，皆学之助。","本心融明，庶几寡过。","滔滔世途，人而匪天。","儿童之戏，殆类纸鸢。"],0,229,"宋"],["小师正知画师顶相请赞","释心月","四言",["高厚同源，万殊一体。","卓尔何来，湛然非止。","览蜀天云，挹龙渊水。","际会如斯，孰穷所以。","正知知之，不出乎是。"],0,188,"宋"],["方丘乐歌 其七","郊庙朝会歌辞","四言",["卓彼嘉坛，奠玉方泽。","百辟祗肃，八音纯绎。","祀事承明，柔祗感格。"],0,"x207","宋"],["五方帝 其十五","郊庙朝会歌辞","四言",["礼经之重，祀典惟明。","命官摄事，陟降以诚。","既升庶品，亦奉二精。","锡兹福祉，迄用丕平。"],0,"x207","宋"],["偈颂九十三首 其三十八","释梵琮","四言",["赵州庭柏，说向禅客。","物是实价，钱须足陌。"],0,100,"宋"],["颂古十八首 其九","释宝印","四言",["忽然不然，如铗如钳。","神仙秘诀，父子不传。"],0,106,"宋"],["偈颂五十一首 其十九","释大观","四言",["峰峦秀异，鹤不停机。","灵木迢然，凤无依倚。"],0,181,"宋"],["偈颂一百零二首 其三十八","释慧远","四言",["一心不生，万法无咎。","木匠带枷，自作自受。","有心无法，受报好丑。","有法无心，天长地久。","心生法生，乌飞兔走。","心灭法灭，倒翻筋斗。","口似鼓椎，眉如扫帚。"],0,154,"宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十九","郊庙朝会歌辞","四言",["父尊母亲，天涵地育。","燕我翼子，景命有仆。","得名得寿，如金如玉。","子孙千亿，成其厚福。"],0,"x207","宋"],["杕柏寄傅钦之 其一","司马光","四言",["彼杕者柏，生于崇峦，其叶丸丸。","君子爰处，爰处爰游。","匪忧勿忧，其乐休休。"],0,"x40","宋"],["杕柏寄傅钦之 其二","司马光","四言",["彼郁者兰，生于幽涯，其叶菲菲。","君子爰处，爰处爰嬉。","靡适弗宜，忘其渴饥。"],0,"x40","宋"],["绍熙四年加上寿圣皇太后尊号八首 其七","郊庙朝会歌辞","四言",["懿典大册，陈仪邃深。","怡怡愉愉，宝坐是临。","重彩俨侍，罙展肃心。","三宫协庆，永播徽音。"],0,"x207","宋"],["畴依  其二○","王柏","四言",["迪予朱子，理一分殊。","汛扫淫诐，煌煌四书。","有析其精，一字万钧。","有会于极，万古作程。"],0,"x137","宋"],["绍兴祀岳镇海渎四十三首 其三十 西镇位。","郊庙朝会歌辞","四言",["维吴崇崇，于汧之西。","瞻彼有陇，赫赫不迷。","克裨于岳，我酌俶齐。","于凡有旅，视公维跻。"],0,"x207","宋"],["颂古二十九首 其十五","释师体","四言",["村婆暴富，诳諕闾阎。","赵州卖俏，矢上加尖。"],0,5,"宋"],["数日前，梦人示余一卷文字，大略若谕马者，用「吃蹶」两字，梦中甚赏之，觉而忘其馀，戏作数语足之","苏轼","四言",["天骥虽老，举鞭脱逸。","交驰蚁封，步中衡石。","旁睨驽骀，丰肉灭节。","徐行方轨，动辄吃蹶。","天资相绝，未易致诘。"],0,"x67","宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其二十四","郊庙朝会歌辞","四言",["荣怀之庆，莫盛于斯。","三宫四册，五叶一时。","德阜而丰，福大而滋。","子子孙孙，于时保之。"],0,"x207","宋"],["杕柏寄傅钦之 其三","司马光","四言",["洋洋者舟，泛彼中流，于渚于洲。","思其可思，知其可知。","其逝勿追，其来勿期。"],0,"x40","宋"],["偈二十七首 其一","释绍隆","四言",["穷诸玄辩，竭世枢机。","百千法门，无量妙义。","总在个里，不隔一丝。"],0,252,"宋"],["瑞麦","陈宓","四言",["维此瑞麦，十有三茎。","伊谁所树，中夏以生。","丰年之庆，圣治之臻。","我作此赞，播之颂声。"],0,"x124","宋"],["偈颂八十七首 其十四","释慧开","四言",["平沈大地，高出虚空。","释迦弥勒，齐立下风。"],0,65,"宋"],["政和鹿鸣宴五首 其二","郊庙朝会歌辞","四言",["钟鼓皇皇，磬筦锵锵。","登降维时，利用宾王。","髦士攸宜，邦家之光。","媚于天子，事举言扬。"],0,"x207","宋"],["颂古七首 其五","释慧性","四言",["放两抛三，瞒神謼鬼。","换盆换盆，谁不识你。"],0,46,"宋"],["八月十六入南昌右狱作对治偈","惠洪","四言",["那落迦中，论劫受苦。","焚铁其地，汁铜其柱。","鱼鲙而脔，爪分而锯。","于一日夕，有万痛楚。","我避世纷，重闭其户。","而此知识，勃然而怒。","吏收付官，于此土住。","自寻其罪，焦芽石女。","然非天人，所能见与。","自业成熟，现行会遇。","受尽还无，无可措虑。","我作是观，上契佛祖。"],0,"x42","宋"],["赵州和尚赞","释宗杲","四言",["庭柏无根，虚空有骨。","十分鲁钝，似辽天鹘。","热至乘凉，寒烧榾柮。","夫是之谓，赵州古佛。"],0,"x112","宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十七","郊庙朝会歌辞","四言",["上帝有赫，百灵效祥。","储祉垂恩，锡年降康。","皇仪睟温，帝躬肃庄。","三宫齐欢，地久天长。"],0,"x207","宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十八","郊庙朝会歌辞","四言",["夏典稽瑞，禹玉含淳。","追琢有章，温润孔纯。","圣底于安，寿绵于仁。","太上立德，自天其申。"],0,"x207","宋"],["偈三十五首 其二十四","释祖珍","四言",["知幻即离，不作方便。","离幻即觉，亦无渐次。"],0,155,"宋"],["医眼","释慧开","四言",["开黑暗门，通向上窍。","内外障除，神光独耀。"],0,65,"宋"],["宁宗郊祀二十九首 还位。","郊庙朝会歌辞","四言",["肃肃礼度，𫓶𫓶宫奏。","天行徐谧，皇仪昭懋。","光连重璧，物备簋豆。","于皇以飨，无声无臭。"],0,"x207","宋"],["偈颂一百三十三首 其八","释居简","四言",["师子当门，谁敢觑著。","仁义道中，放过一著。"],0,"x94","宋"],["颜真卿朝回帖赞","岳珂","四言",["公之素守，日烈霜严。","公之大节，斗揭岩瞻。","笔势所存，心画可占。","八法具体，匪柔匪铦。","庶汇流形，如𬸣如潜。","坱圠是似，端倪孰觇。","人以艺进，公以德兼。","凛其高风，气压万签。","公神在天，公书在奁。","系赞以藏，震于壬𪫺。"],0,"x202","宋"],["绍兴亲享明堂二十六首 其一 皇帝入门用《仪安》。","郊庙朝会歌辞","四言",["惟我有宋，昊天子之。","三年卜祀，百世承基。","施及冲眇，奉牲以祠。","敢忘斋栗，偏举上仪。"],0,"x207","宋"],["文宣王及其弟子赞 其四十七","赵构","四言",["式是壤伯，昭乎圣徒。","执经请益，载道若无。","诗书规矩，学问楷模。","得时而驾，领袖诸儒。"],0,249,"宋"],["绍兴祀岳镇海渎四十三首 其五 东镇位。","郊庙朝会歌辞","四言",["惟山有镇，雄于其方。","东孰为雄，于沂之疆。","祀事有时，爰举旧章。","我望匪遥，庶几燕飨。"],0,"x207","宋"],["祭光孝南老","释善珍","四言",["我昔游浙，多贤友朋。","老归故山，耳冷如冰。","忽闻君来，语作吴馨。","白而长身，美髯垂膺。","未几月台，挝鼓腾腾。","巍然广座，摄衣而升。","我忝邻居，复为交承。","君素恢疏，不立户庭。","舌端骋辞，驱涛卷霆。","疾谁使之，一瞑不醒。","七尺桐棺，萧然行幐。","侑此瓣香，感慨曷胜。"],0,45,"宋"],["续南有嘉鱼  其一","曾丰","四言",["维离之方，维丙之穴。","谁幽尔宅，自濡自沫。","惟性是适，与汩俱入。","莫厝其罬，亦孔之黠。"],0,"x193","宋"],["宁宗郊祀二十九首","郊庙朝会歌辞","四言",["合祀丘泽，登侑祖宗。","顾𬤊惟精，灵承惟恭。","有严皇仪，有庄帝容。","监于克诚，肃肃雍雍。"],0,"x207","宋"],["嘉祐亲享明堂二首 其二 送神用《诚安》。","郊庙朝会歌辞","四言",["明明合宫，莫尊享帝。","礼乐熙成，精与神契。","桂尊初阑，羽驾倏逝。","遗我嘉祥，于显万世。"],0,"x207","宋"],["宋江三十六赞 其六 尺八腿刘唐","龚开","四言",["将军下短，贵称侯王。","汝岂非夫，腿尺八长。"],0,103,"宋"],["宋江三十六赞 其八 浪子燕青","龚开","四言",["平康巷陌，岂知汝名。","大行春色，有一丈青。"],0,103,"宋"],["汉诏郡县行乡饮酒礼颂诗 其三","洪遵","四言",["斤斤显宗，黼黻王度。","三宫孔阳，精意治具。"],0,18,"宋"],["偈颂一百三十三首 其五十九","释居简","四言",["七纵八横，千重百匝。","正令全提，是计不纳。"],0,"x94","宋"],["淳化乡饮酒三十三章  其三一","郊庙朝会歌辞","四言",["彼鹊成巢，尔类攸共。","之子有从，兰荪是奉。"],0,"x207","宋"],["淳化乡饮酒三十三章  其三三","郊庙朝会歌辞","四言",["伊鹊营巢，珍禽攸处。","内助贤侯，弼于明主。"],0,"x207","宋"],["淳化乡饮酒三十三章  其三四","郊庙朝会歌辞","四言",["伊鹊营巢，珍禽辑睦。","均养嘉雏，致于蕃育。"],0,"x207","宋"],["偈颂八十五首 其十二","释妙伦","四言",["灵山话月，曹溪指月。","检点将来，只得半橛。"],0,10,"宋"],["偈颂一百零三首 其二十五","释月涧","四言",["定乾坤句，雷厉风飞。","提佛祖令，厓崩石裂。","法主大宝，自然而至。"],0,91,"宋"],["宋江三十六赞 其七 没羽箭张清","龚开","四言",["箭以羽行，破敌无颇。","七札难穿，如游斜何。"],0,103,"宋"],["颂古二首 其二","释元妙","四言",["常侍举笔，万事皆吉。","直下承当，急急如律。","米胡参官，忘前失后。","且告贵人，为我相救。"],0,22,"宋"],["绍熙四年加上寿圣皇太后尊号八首 其六","郊庙朝会歌辞","四言",["雕舆彩仗，祗诣慈宫。","宝册前奉，龙挟云从。","言备兹礼，于宫之中。","惟天子孝，于昭祲容。"],0,"x207","宋"],["温江县二瑞颂","杨天惠","四言",["于皇御极，百志惟叙。","曰农而农，曰士而士。","尔安乃宫，尔宁乃亩。","恩诏数下，仁滂德膴。","农饱以歌，士喜式舞。","协气从之，祥嘏如雨。","乃产嘉禾，以庆农扈。","乃降甘露，以幸士子。","其庆伊何，珠穗纷举。","俾尔瓯窭，户有亿秭。","其幸维何，云液𬪩湑。","俾尔膏馥，濡及婴孺。","维明明后，博临下土。","相彼多禾，均此灵露。","道拜稽首，诞告奔走。","惠拜稽首，盱衡语语。","敢献稗官，以赞蒙瞽。"],0,228,"宋"],["偈颂一百六十九首 其九十五","释智朋","四言",["坐一走七，横三竖四。","大力量人，全身担负。","普化铃铎，杨岐驴子。"],0,18,"宋"],["偈颂九十三首 其七十六","释梵琮","四言",["千说万说，只是一说，春寒秋热。","千句万句，只是一句，小出大遇。","两段不同，收归上科。"],0,100,"宋"],["荷鹭 其一","释智愚","四言",["沙嘴坡头，枯荷影里。","清兴忽来，一息千里。"],0,"x153","宋"],["东庵泉铭","释慧空","四言",["修竹盈门，寒泉迸石。","此老何为，居之终日。","泉知说法，竹亦能禅。","洞山五位，临济三玄。"],0,"x118","宋"],["送范侍郎归许昌一首","彭汝砺","四言",["凤鸟跄跄，其羽仪仪。","其集伊何，梧桐之枝。","鸿飞冥冥，其翼差差。","其止伊何，清泠之池。","朝廷于公，夫岂不知。","国有大疑，爰度爰咨。","公虽家居，如在庙堂。","国之大经，论讨靡忘。","徐徐公车，在汴之郊。","薄言追之，以永今朝。","泛泛公舟，在河之阴。","薄言维之，以慰我心。","公赐我言，我斯藏之。","何以报之，羔羊素丝，秉德不遗。","公饮我酒，我斯酬之。","何以祝之，秀发庞眉，受福无期。"],0,"x143","宋"],["偈颂二十五首 其三","释普岩","四言",["日面月面，霹雳闪电。","直下来也，急著眼看。"],0,182,"宋"],["二苏文登趋阙二帖赞","岳珂","四言",["文字之祥，厥有原委。","父师昆弟，以及诸子。","文兮斜川，道兮颍水。","以文贯道，一家济美。","施及翰林，特游戏耳。","于风味中，亦复是似。","以坡为骨，以颍为髓。","苏门之英，来者视此。"],0,"x202","宋"],["赠韩拙堂","袁甫","四言",["世所谓巧，请为翁说。","巧于利口，佞辞河决。","何如吉人，其言呐呐。","巧于附势，炙手可热。","何如节士，刚肠若铁。","巧于营生，百计渔夺。","何如儒家，冷淡生活。","拙反为巧，巧乃大拙。","蓦然猛省，比论未彻。","本无巧拙，奚较优劣。","大道融融，旷兮太空。","恶不待攻，善与人同。","客访拙翁，携酒相从。","客去西东，翁数飞鸿。","春日烘烘，适兴携筇。","兴尽呼童，燕坐堂中。","一门雍雍，兰玉玲珑。","客贺拙翁，笑倚长松。"],0,229,"宋"],["绍兴十三年发皇后册宝十三首 其十一","郊庙朝会歌辞","四言",["窈窕其容，淑嫕其姿。","烂其如云，瞻我母仪。","曰天之妹，作合惟宜。","粲然舞抃，畴不肃祗。"],0,"x207","宋"],["绍兴淳熙分命馆职定撰十七首 彻豆用《肃安》。","郊庙朝会歌辞","四言",["于皇上帝，肃然来临。","恭荐芳俎，以达高明。","烹饪既事，享于克诚。","以介景福，惟德之馨。"],0,"x207","宋"]]