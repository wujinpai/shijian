[["苏文忠萧丞相楼二诗帖赞","岳珂","四言",["登高而赋，维以思古。","二难之风，意健句妩。","黯然尘楮，笔势轩翥。","真兮不谖，我怀陟岵。"],0,"x202","宋"],null,["鶑鸣十章寄戚伯瑞  其二","彭龟年","四言",["禽其鸣矣，惟其丑矣。","我之怀矣，惟其友矣。"],0,223,"宋"],["景灵宫乐章 其三 皇帝降殿干安之曲","周麟之","四言",["我秩元祀，上推鸿源。","展事有侐，祲威肃然。","升墄既降，秉心益虔。","荷天之休，于千万年。"],0,103,"宋"],["太常乐章三十首 其一 皇帝南郊前一日朝飨太庙奏理安曲迎神","杨亿","四言",["肃肃清庙，昭事祖祢。","粢盛苾芬，四海来祭。","皇灵格思，令容有睟。","降福孔偕，以克永世。"],0,"x47","宋"],["畴依  其一七","王柏","四言",["历纪明道，祥应两程。","吟风弄月，有的其承。","体用一原，显微无间。","惠我光明，如夜复旦。"],0,"x137","宋"],["送方丰之秀才归福唐","吕本中","四言",["我居江东，惟信之州。","子来自南，而与我游。","问其所友，一时之秀。","其兄韫德，亦既有就。","子学既立，子志甚远。","何以终之，止在不倦。","贫贱勿厌，自然无闷。","富贵勿羡，害德之本。","彼古之人，能圣与仁。","我胡不能，叹其绝尘。","今子归矣，岁亦有秋。","何以告子，惟圣之求。","水流有源，木生有根。","惟源与根，入德之门。","求圣根源，惟正之守。","正之不守，弃师背友。","丝毫之伪，勿萌于心。","无有内外，亦无浅深。","由此则圣，舍此则病。","是以君子，所守先正。","于以赠别，亦以自警。","为别后思，且以三省。"],0,"x83","宋"],["明堂庆成颂  其七","徐鹿卿","四言",["皇入太室，祼献必躬。","列圣在天，时降于宗。"],0,73,"宋"],["金牛长老德铠写平园真求赞","周必大","四言",["经传白马，寺假金牛。","祖意西来，江水东流。","于我何有，色见音求。","千帆任过，长对沙洲。"],0,"x76","宋"],["龙城智公真赞","惠洪","四言",["奉持毗尼，圭璧无玷。","研味般若，金刚有焰。","有万其众，感以无心。","如象牙雷，如磁石针。","住持此山，垂三十白。","殿阁化成，儿孙戢戢。","高明广大，不可形容。","稽首寄老，后身宝公。"],0,"x42","宋"],["赠成师掾公策","赵汝腾","四言",["易中之策，阴阳错综。","是兴神物，以前民用。","受命如响，吉凶生动。","子取策名，仆沿理控。","先觉仲尼，方人子贡。","惟诚前知，不亿而中。","中庸即易，是道公共。","非策之策，斯语请诵。"],0,47,"宋"],["偈颂一百五十首 其三十七","释心月","四言",["我有一语，通今贯古。","全主全宾，全规全矩。","直下承当，未敢相许。"],0,188,"宋"],["喜无忧求偈","白玉蟾","四言",["禅不用参，道不用学。","行住坐卧，是大圆觉。"],0,"x77","宋"],["寿马裕斋观文 有鹤，三章，章四句。 其三","陈著","四言",["陟彼崔嵬，岂不怀归。","英英白云，跂予望之。"],0,"x92","宋"],["寿马裕斋观文 有鹤，三章，章四句。 其一","陈著","四言",["有鹤在林，怀之好音。","载飞载止，食野之芩。"],0,"x92","宋"],["寿马裕斋观文 有鹤，三章，章四句。 其二","陈著","四言",["倡予和汝，爰得我所。","何斯违斯，自贻伊阻。"],0,"x92","宋"],["正冬御殿上寿乐章八首 其七 赐群臣第三盏酒宫悬作正安之曲","杨亿","四言",["酒以成礼，乐以侑食。","露湛朝阳，星环紫极。","淑慎尔容，既饱以德。","进退周旋，威仪抑抑。"],{"yz":[]},"x47","宋"],["广州州学记系诗","蒋之奇","四言",["诸侯之学，是谓泮水。","诗人所颂，鲁侯戾止。","献馘于是，献囚于是。","采芹则美，饮酒维旨。","淮夷来服，觓弓搜矢。","其挚维何，元龟象齿。","区区鲁邦，陋无足纪。","维泮之兴，功烈如彼。","下逮郑国，学校不修。","青青子衿，莫肯来游。","谁欲毁之，侨吉厥犹。","视其所召，药之则瘳。","我得吾师，实获所求。","首善于京，其速置邮。","矧在守长，宣化承流。","德音不昭，维职之忧。","番禺之学，莫原所作。","岁月其绵，栋楹腐恶。","藩级板夷，屋垣圮剥。","图像之威，弗丹弗雘。","圣经不谈，束置高阁。","讲席其虚，维尘漠漠。","譬彼弗殖，萎其将落。","于嗟斯民，谁启谁觉。","释老二氏，尚能尊师。","岂伊吾儒，曾是弗为。","道废若此，莫或耻之。","振而起诸，岂不在兹。","爰命鸠材，僝工以时。","肇新两序，翼如翚飞。","载辟祠庭，奂其轮而。","颐指而化，鬼设神施。","乃延师生，来燕来处。","匪怒伊教，载笑载语。","笾豆有践，殽核维旅。","以妥以侑，礼仪具举。","济间多士，进退规矩。","夏弦春诵，各得其所。","相彼错薪，有擢维楚。","遐不作人，成是才谞。","在汉循吏，时则文翁。","修起学宫，成都市中。","常衮在闽，讲导从容。","士比内州，岁贡以充。","贤不天成，有养自蒙。","谁谓越远，齐鲁同风。","憬彼夷蛮，来顺来从。","南交厎宁，猗学之功。"],0,62,"宋"],["偈颂六十八首 其五十四","释法薰","四言",["西来无意，直指无旨。","引得痴儿，尽卧冷地。"],0,31,"宋"],["赠刘矮跛相士 其一","文天祥","四言",["炼石为形，铿金为音。","世方好圆，痴守方心。","阴阳𬘡缊，人一气质。","善恶之微，证于声色。","意所欲发，虽吾不知。","彼美子刘，洞其先几。","肮脏难合，今世道病。","如子所言，生禀已定。","戆夫勇士，往往一偏。","以视妾妇，岂不犹贤。","洪范得三，二曰刚克。","会其归其，好是正直。","学问工夫，气质用微。","汝能观形，安知其馀。","子术已定，吾情已成。","子执子术，吾安吾情。"],0,"x53","宋"],["鶑鸣十章寄戚伯瑞  其八","彭龟年","四言",["春花粲兮，两山之间。","谁与我适，觞咏以还。"],0,223,"宋"],["颂古三十八首 其二","释慧方","四言",["文殊弹指，罔明出定。","今日重新，打翻旧令。","女子瞿昙，在我心镜。"],0,45,"宋"],["孝宗皇帝御制春词御书赞","岳珂","四言",["春赋之作，八荒是同。","掞词寄情，则其馀功。","德异玩人，理存观妙。","臣藏其真，以见电笑。"],0,"x202","宋"],["廖知县请赞","释宗杲","四言",["我赞我真，孰能委悉。","火风暖动，地水坚湿。","俱属现量，拟心则失。","就而明之，是妄非实。","背而捐之，土木瓦石。","吾说是言，如箭射的。","离此别求，幻惑无识。"],0,"x112","宋"],["孝宗明堂前朝献景灵宫八首 其八 文舞退、武舞进用《正安》。","郊庙朝会歌辞","四言",["象德之成，有奕其舞。","一弛一张，进旅退旅。","嘒以管箫，和以镛鼓。","神其乐康，永锡多祜。"],0,"x207","宋"],["闵雨诗 其六","刘敞","四言",["退而斋心，渊默以居。","钟鼓不设，宴游不娱。","左右肃然，壹怀瞿瞿。"],0,"x51","宋"],["林文节赠贾收诗稿二诗帖赞","岳珂","四言",["欧称醉翁，公称醒老。","尚论平生，岂以诗考。","庆历之滁，元祐之湖。","醒欤醉欤，醉欤醒欤。"],0,"x202","宋"],["偈二十首 其十九","释鼎需","四言",["横按吹毛，虚张意气。","冲开铁壁，枉费精神。"],0,10,"宋"],["光宗皇帝夏竦双头牡丹赋御书赞","岳珂","四言",["圣孝动天，瑞则应之。","帝开绍熙，天实命之。","三宫燕娱，爱且敬之。","禁籞翠华，时联幸之。","万葩其春，彩服映之。","玉色怡愉，霞卮蒏之。","岂乐行都，民物盛之。","乾坤同欢，康衢咏之。","于牣灵沼，鱼鸟泳之。","天光下临，邦家庆之。","煌煌牡丹，奇产并之。","帝王称觞，亲捧迎之。","巍巍太皇，万寿称之。","一德隆兴，圣益圣之。","维太平臣，尝比兴之。","国英竦名，夏则姓之。","秾纤艳殊，美则评之。","仁皇之祥，今亦订之。","尧父舜子，本天性之。","龙楼鸡鸣，久温凊之。","晦明节宣，臣或诤之。","瑜瑕未昭，事则镜之。","宸毫所传，神具听之。","后三十年，臣则胜之。","金匮名山，尚克证之。"],0,"x202","宋"],["上耿泉生朝  其七","杨简","四言",["迺抚徽人，惠绥千里。","匪亟匪除，匪作匪异，而郡亦治。"],0,118,"宋"],["正冬御殿上寿乐章八首 其五 赐群臣第二盏酒宫悬作正安之曲","杨亿","四言",["金奏在悬，有酒斯旨。","颙颙卬卬，向明负扆。","湛湛露斯，式宴以喜。","佩玉蕊兮，罔不由礼。"],0,"x47","宋"],["龙眠居士画十六大阿罗汉赞 其十四","李纲","四言",["麌麌群鹿，出于岩端。","植杖倚松，寓目纵观。","风度凝然，万法皆了。","去发留髭，岂无所表。"],0,"x136","宋"],["赞护教 其二 二王","释印肃","四言",["仰山显迹，契会宗师。","一法性身，利物宏慈。"],0,"x121","宋"],["许彦周所作墨戏为之赞","惠洪","四言",["异哉土蛇，登树而怒。","怒见脊尾，口眼可惧。","王孙地坐，气詟毛竖。","欲去不敢，攀枝而顾。","丰狐行藏，心常愧负。","见之而走，敏若脱兔。","孰能傲然，如此老树。","与之相亲，不惊不怖。","问何能尔，以无我故。","酒色海中，有万奇趣。","不出二种，猜疑掉举。","盖无常蛇，终不赦汝。","居士图之，以警未悟。","觉范一见，笑手为拊。"],0,"x42","宋"],["绍定三年寿明仁福慈睿皇太后册宝九首 其七","郊庙朝会歌辞","四言",["迩臣跪奏，严办必恭。","乃御袆褕，升于殿中。","慈颜雍穆，和气冲融。","芳流清史，传之无穷。"],0,"x207","宋"],["和讷斋题晓山亭","杜范","四言",["理粲万象，孰妙孰徼。","卓彼南山，目游心讨。","露气澄澈，净不容扫。","瑟瑟风松，剪剪烟筱。","甘梦未觉，一声晨鸟。","恐随宾送，岁月空老。","整冠危坐，抱膝自笑。","天际飞鸿，健翮矫矫。","一念既彻，何远不到。","我卷我书，岂其弗考。","万动纷起，万虑冥澡。","斯物之格，斯理之奥。","随寓随得，靡间昏晓。","云麓固夷，石壁非峭。","目在而察，炯炯独燎。","有临泰华，或视以渺。","山岂不崇，乃见之小。","扁亭者谁，有揭斯表。"],0,115,"宋"],["文王操","薛季宣","四言",["凤兮凤兮，鸟之王兮。","览德辉兮，为嘉祥兮。","匪下昌兮，我王明兮。"],0,"x194","宋"],["宋颂九首 其四 圣神","石介","四言",["具篙与舟，同朝天子。","一发五豝，二君皆至。","皇祖圣神，鸿光丕懿。"],0,105,"宋"],["薰莸吟","邵雍","四言",["善恶之间，薰莸可究。","近薰必香，近莸必臭。"],0,"x57","宋"],["题林和靖像","袁韶","四言",["避影林壑，清畏人知。","尔梅多事，漏吾天机。","长风孤骞，秋鹤与飞。","山高水深，无成无亏。"],0,230,"宋"],["淳熙二年发太上皇帝太上皇后册宝十一首 其七 太傅奉太上皇帝册升殿用《圣安》。奉宝同。","郊庙朝会歌辞","四言",["天畀遐福，允彰父慈。","维昔旷典，我能举之。","徐尔陟降，敬尔威仪。","申锡无疆，永言保之。"],0,"x207","宋"],["皇帝上太上皇帝寿乐曲 酒再行罢用圣德重光之舞","崔敦诗","四言",["于穆圣子，仁天智神。","体刚立极，宝俭化民。","美政毕举，旧章聿遵。","舞以象德，拟韶实伦。","龙楼问寝，前殿奉卮。","密承慈训，不怠其祗。","海宇丰阜，边陲晏夷。","于以养志，福禄来宜。"],0,93,"宋"],["折渭州画像赞","李之仪","四言",["龙章凤姿，燕颔虎颈。","巍巍堂堂，弗严而整。","山纳海容，霜根雪节。","可畏而亲，力莫之斡。","吾私淑诸，一代之英。","多取益给，欲掩滋明。","长庚未艾，白气何来。","精爽如在，佳城不开。","出卯则角，堕地而班。","岂无所遗，𫘧骥方闲。","高牙赤舄，惟叔惟虎。","有之似之，千载一武。","赳赳桓桓，彼徒见诮。","他日凌烟，实先前诏。"],0,"x203","宋"],["嘲茶山","葛胜仲","四言",["吴兴紫笋，实产顾渚。","唐昔底贡，阚山芽吐。","隼旟出临，虎岩亲驻。","邻邦刺史，金匏相遇。","木瓜堂前，穿云浥露。","烹蒸包发，及春未暮。","天子称珍，分甘当路。","今则不然，名毁势去。","金沙弗湘，玉食弗御。","敷荣穷山，牢落谁顾。","如女失宠，空闺自嫭。","请以千金，买长门赋。"],0,"x195","宋"],["绍兴以后蜡祭四十二首 帝神农位奠币。曲同大明。","郊庙朝会歌辞","四言",["农为政本，食乃民天。","神农氏作，民始力田。","先啬之配，礼报则然。","有币将之，维以告虔。"],0,"x207","宋"],["绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首  其一四","郊庙朝会歌辞","四言",["仰瞻慈闱，登进宝册。","惟时𣊓御，祗率厥职。","曰寿曰名，母兮兼得。","俪我尊父，亿载无极。"],0,"x207","宋"],["偈颂八十五首 其七十八","释妙伦","四言",["正朝握拂，埽荡窠窟。","左拣牛溲，右选马勃。","竖作一团，是甚臭鹘。","分付诸人，洗肠换骨。"],0,10,"宋"],["胡广文以直养名堂余举伊川之说问之往反数十言终未判也再以是讯焉","彭龟年","四言",["以物养物，如水沃木。","推彼有馀，益此不足。","惟直与气，如木有根。","本既充盛，枝叶自繁。","气言其形，直言其理。","与生俱生，无彼无此。","云何谓直，养此气耶。","直果外来，气内出耶。","孟氏此言，我知其自。","则以告子，以义外计。","谓直养气，其差则同。","疑其不然，愿启我蒙。"],0,223,"宋"],["赠陈如晦","赵汝腾","四言",["堂堂六湖，清秋玉壶。","我则尚友，岂敢为徒。","仁义弘毅，不可夺志。","岂私我朋，义之与比。","德必有邻，二彭其人。","与语终日，澹无一尘。","以罪来归，得此四宾。","甘心涧谷，以老我身。"],0,47,"宋"],["颂古三十八首 其二十六","释慧方","四言",["坏与不坏，言端语端。","舌头咬破，自觉心酸。","大随投子，终无两般。","万里区区，独自往还。"],0,45,"宋"],["明堂庆成颂  其一二","徐鹿卿","四言",["秋空无滓，万里一碧。","璧月珠星，瑞光浮溢。"],0,73,"宋"],["庆梅州刘侯修葺程乡学宫落成  其三","林陶","四言",["暗訚诸生，振鹭来翔。","诗书礼乐，游息修藏。","勉尔行业，为时俊良。","毋毁于随，毋嬉于荒。","三岁大比，用宾于王。"],0,67,"宋"],["鲁二儒","舒岳祥","四言",["叔孙事秦，以谀蔽愚。","至于归汉，荐进狡夫。","灭我王道，甚于焚书。","是以二儒，确乎其居。"],0,"x161","宋"],["上耿泉生朝  其九","杨简","四言",["洎阳为邑，实惟所临。","宽简虽至，威信亦深。","敢不兢兢，治所赋金。","以谨以程，以恪以忱。"],0,118,"宋"],["宁宗朝享三十五首 还位用《干安》。","郊庙朝会歌辞","四言",["旅楹有闲，人神允叶。","福以德昭，飨以诚接。","六乐宣扬，百礼炜烨。","对越在天，流祚万叶。"],0,"x207","宋"],["宁宗朝享三十五首 还位用《干安》。","郊庙朝会歌辞","四言",["在周之庭，设业设簴。","酒醴惟醹，尔殽伊脯。","帝觞毕勺，天步旋举。","丕显丕承，念兹皇祖。"],0,"x207","宋"],["宁宗朝享三十五首 还位用《干安》。","郊庙朝会歌辞","四言",["圣图广大，宗祊光辉。","假于有庙，帝命不违。","僾若有慕，夙夜畏威。","嘉乐君子，福禄祁祁。"],0,"x207","宋"],["画髑髅颂","释宗杲","四言",["即此形骸，便是其人。","一灵皮袋，皮袋一灵。"],0,"x112","宋"],["送梁子熙联句","苏舜钦","四言",["大荣大辱，能生死人。","二物不并，以挠厥真。","之子病闷，肠如车轮。","劳忧到母，饿寒著身。","世俗卤莽，辄置莫亲。","文彩光艳，伏不得伸。","凄吟哀号，酸入四邻。","夜计破午，若燕若秦。","腹愤轧轧，胸奇陈陈。","淮国晚岭，吴渠春津。","去谢夙蕴，归逢故辛。","雌火在丑，刮凿遁屯。","驾风鞭霆，以脱凡鳞。"],0,196,"宋"],["故江阳杨君画像赞","黄庭坚","四言",["显允临邛，吏师文宗。","能者述之，德宇恢恢。","疏而不失，有物实之。","于义当然，确乎不夺。","强者屈之，爱民如子。","曰予用威，谁其恤之。","图像如生，虽不能言，谁敢忽之。","其事在人，岁月其逝，勿坠失之。","后有南董，询事考言，尚其笔之。"],0,"x66","宋"],["颂十六首 其十","释慧晖","四言",["参得五语，功勋始成。","有时不说，恣口说行。","有时不玄，空失妙正。","有时不显，才一气生。","有时不出，独来水清。","有时不生，未开眼睛。","毕竟见得，连天晓星。"],0,194,"宋"],["宋颂九首 其二 圣神","石介","四言",["二国之君，各保尔土。","虎凭于山，莫予敢取。","蛟凭于渊，莫予敢侮。","万其年兮，关𫔎以固。"],0,105,"宋"],["颂古一百二十一首 其九十六","释宗杲","四言",["口是祸门，电激雷奔。","娑竭出海，震动乾坤。"],0,"x112","宋"],["偈颂三十首 其二十九","释慧晖","四言",["朝说暮说，出广长舌。","坐卧经行，万里镔铁。"],0,194,"宋"],["徐泾教授求六一先生赞","周必大","四言",["我不识公，而哀斯文。","稷言皋谟，宋艳班香。","四海所宗，一乡何有。","瞻之在前，瞠乎若后。"],0,"x76","宋"],["宏智禅师赞","释智愚","四言",["金凤初鸣，玉人启户。","露冷风高，子归就父。"],0,"x153","宋"],["偈颂五十一首 其二十","释大观","四言",["孤危不立，坐断千差。","有笑陪宾，无赃验贼。"],0,181,"宋"],["南陔五章二章章八句三章章四句  其三","郑刚中","四言",["彼居之子，庭闱休休。","爱日之念，胡弗省修。"],0,"x99","宋"],["偈颂六十五首 其三十七","释普济","四言",["崇山峻岭，茂林修竹。","终日提纲，神号鬼哭。"],0,73,"宋"],["雨师五首 其三 奠币用《容安》。","郊庙朝会歌辞","四言",["崇崇坛阶，灵既降止。","有严执奠，承祀兹始。","明灵在天，式顾庶察。","泽润以时，永拂荒札。"],0,"x207","宋"],["淳熙十六年皇后册宝十三首 其十三","郊庙朝会歌辞","四言",["维天佑宋，盛事相仍。","崇号三宫，甫兹浃辰。","肇正中闱，缛礼载陈。","邦家之庆，旷古无伦。"],0,"x207","宋"],["太庙乐章 皇帝盥洗干安之曲","周麟之","四言",["维皇斋精，鬷假于庙。","观盥之初，惟以洁告。","衎承祖宗，恤祀昭孝。","诚心有孚，介福斯报。"],0,103,"宋"],["绍兴十年发皇太后册宝八首 其三 侍中奉宝诣皇帝褥位用《礼安》。","郊庙朝会歌辞","四言",["祖启瑶光，诞生明圣。","尊极母仪，帝庸作命。","宝章煌煌，导以笙磬。","还燕慈宁，邦家徯庆。"],0,"x207","宋"],["偈二十七首 其二","释守净","四言",["谈玄说妙，撒屎撒尿。","行棒行喝，将盐止渴。","立主立宾，花擘宗乘。"],0,166,"宋"],["宋颂九首 其一 圣神","石介","四言",["不疾而速，不怒而威。","惟圣惟神，其几其微。"],0,105,"宋"],["明堂庆成颂  其二一","徐鹿卿","四言",["前星必耀，年谷必丰。","人所同欲，天宁弗从。"],0,73,"宋"],null,["吏部侍郎李公","《靖康小雅》作者","四言",["烈烈李公，实备全德。","义动幽明，气贯金石。","扈跸敌营，爰究忠烈。","杞人之忧，废立大厄。","公挺不顾，二将面叱。","勇甚雷霆，天地动色。","命轻鸿毛，名高斗极。","燎火之焚，不变蓝璧。","滔天之溺，砥柱独立。","死得其所，震耀方册。"],0,91,"宋"],null,["宋颂九首 其十 明道","石介","四言",["唐三百年，时惟开元。","猗欤明道，开元同言。"],0,105,"宋"],["乙卯仲春丁奠毕作素王颂一首呈承祭之士颂曰","赵汝腾","四言",["于穆素王，天纵将圣。","小用于鲁，振挈纲领。","莱兵面却，齐人退听。","三都隳奸，两观锄佞。","市无饰贾，朝无乱政。","少壮悉逊，道涂不竞。","曲阜大治，诸侯交儆。","女乐间之，可以出迸。","俟膰不至，于卫之境。","留不暖席，去复俄顷。","几围于匡，幸释以宁。","归主蘧瑗，耻居次乘。","彷徨过宋，流离在郑。","魋恶习礼，木不留影。","立郭东门，累然谁省。","在陈徘徊，弗授寸柄。","河水洋洋，不渡者命。","蒲盟止兵，蔡惧设阱。","楚尼书社，彼哉谗胜。","辙环靡归，不容何病。","十有四年，鲁复来聘。","亦莫果用，六经是订。","易系礼编，诗删书定。","私淑三千，弦歌雩咏。","维持太极，与天地并。","贤于尧舜，功用之盛。","专飨南面，此感彼应。","笾豆牲牢，庭燎辉映。","万有千载，垂于祀令。","承祭儒绅，孰敢不敬。","何以事之，存心养性。"],0,47,"宋"],["余来湖外家问不通者累月因和渊明停云篇以遣怀","李纲","四言",["上天停云，以阴以雨。","我之怀矣，川路修阻。","田园将芜，幼稚谁抚。","雁信来迟，鹤立以伫。","凄其以风，零雨其蒙。","自去梁溪，爰止西江。","一室萧然，卧于北窗。","块独处此，人谁我从。","岂无轩裳，谁适为荣。","人之为人，亦以有情。","乱离瘼矣，弃家遐征。","知我如此，不如无生。","今夕何夕，鹊袅庭柯。","载植其尾，迭相鸣和。","发书占之，远问为多。","兆而未至，怀哉若何。"],0,"x136","宋"],["尧任舜禹行","释文珦","四言",["尧任舜禹，圣化日熙。","二臣至德，惟尧克知。","明良胥会，征庸弗疑。","佐命垂统，股肱纲维。","行尧之道，蚤夜孳孳。","上齐七政，大录万几。","与人为善，念兹在兹。","举相去凶，咨牧授时。","执德于心，其化若驰。","洪水滔天，浩浩无涯。","下民昏垫，荒度为宜。","乃乘四载，奠决刊随。","栉风沐雨，手胼足胝。","四海会同，九泽具陂。","诞敷文德，帝命是祗。","翔泳咸若，凤皇来仪。","尧嘉厥功，翕受敷施。","同声相应，百僚师师。","是知官人，安危之基。","用贤则安，用佞则危。","惟彼陶唐，百工允厘。","后世有述，先天弗违。","能赏能禅，缵承伏牺。","为民之极，黄收纯衣。","明并日月，照临无私。","不言而治，端拱无为。","民无能名，荡荡巍巍。","惟天为大，惟尧则之。","先圣斯言，当深致思。","或未之思，室是远而。"],0,"x80","宋"],["颂古四十五首 其四","释如珙","四言",["我瞿昙佛，具正遍知。","子母分解，只在当时。"],0,255,"宋"],["题李伯时三教图卷 其二","李纲","四言",["丈人之德，藐焉犹龙。","吐纳新故，婴儿在中。","鼎水静绿，飞丹夜红。","大德不德，河上遗踪。"],0,"x136","宋"],["临江合皂李仲章以省轩求诗","包恢","四言",["心之精明，不远伊迩。","胸中若正，瞭焉眸子。","举目有证，莫切于视。","孰名曰省，少目取义。","目当少时，湛湛精睟。","其光神全，其见专致。","老目为耆，则与少异。","非徒以目，而分老稚。","惟目如少，有可取譬。","实省在心，省当如是。","如开双明，洞见万类。","心难常存，省不可替。","心难常觉，省不可离。","心本善者，孰非纯懿。","心不善者，孰非私利。","省与不省，善恶关系。","省者如醒，不省如醉。","省者如寝，不省如寐。","省者如活，不省如毙。","果能自省，卓然奋励。","暗室不欺，屋漏不愧。","如目万象，无有掩蔽。","一不自省，冥然罔记。","外物交引，内无纷炽。","如目老昏，无非障翳。","二者相远，宜知敬忌。","聂君少年，有目可贵。","以省名轩，轩豁无滞。","惟道无穷，要在远诣。","惟言多穷，要履实地。","惟难有常，勉无失坠。"],0,127,"宋"],["上耿泉生朝  其六","杨简","四言",["江左矜刑，狱平讼清。","惟清惟明，民用以宁，奸宄亦惩。"],0,118,"宋"],["明堂庆成颂  其二四","徐鹿卿","四言",["我将不作，臣窃其义。","请诵末章，夙夜祇畏。"],0,73,"宋"],["偈颂八十五首 其六十三","释妙伦","四言",["我此一关，无背无向。","拟欲进前，网在头上。"],0,10,"宋"],["绍兴以后蜡祭四十二首 后稷位奠币。曲同夜明。","郊庙朝会歌辞","四言",["明明周祖，惟民之恤。","播种为教，下民乃粒。","曾是索飨，而匪先公。","万物难报，阡陌之功。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 神农位奠币。曲同夜明。","郊庙朝会歌辞","四言",["耒耜肇兴，自神农氏。","稼穑滋殖，为农者始。","作配明祀，奠以告虔。","万世佃渔，帝功卓然。"],0,"x207","宋"],["偈颂一百五十首 其五十八","释心月","四言",["龙蟠虎踞，今古嶷然。","楚水秦淮，滔滔无间。"],0,188,"宋"],["和韩履善韵","袁甫","四言",["雨雪霏霏，青山华巅。","能令山老，曷不老泉。","雪高高山，雪深深渊。","山自寂寂，泉自涓涓。","我爱嶙峋，亦爱漪涟。","雪兮入水，我观其澜。","雪也在山，我取而餐。","入水不见，依旧灵源。","在山见雪，不见苍然。","苍然虽改，岿然则存。","见与不见，神光浑全。","悟此雪词，龟龙参前。","一止一流，谁合谁分。","忘言为赘，言本无言。"],0,229,"宋"],["绍兴以后蜡祭四十二首 后稷位酌献。曲同夜明。","郊庙朝会歌辞","四言",["岁十二月，祀有常典。","祭列司啬，言反其本。","酌彼泰尊，百末兰生。","承神嘉虞，繄此德馨。"],0,"x207","宋"],["偈颂一百五十首 其三十八","释心月","四言",["我有一机，对面提持。","石火莫及，电光罔追。"],0,188,"宋"],["绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其三","郊庙朝会歌辞","四言",["巍巍天宫，洞开阊阖。","旗常葳蕤，剑佩杂沓。","宝册启行，法驾继发。","铄哉盛典，快睹胥悦。"],0,"x207","宋"],["绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其四","郊庙朝会歌辞","四言",["仰止皇居，九门载辟。","丽日重光，非烟五色。","雷动万乘，云从百辟。","咫尺重霄，鞠躬屏息。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 后稷位酌献。曲同大明。","郊庙朝会歌辞","四言",["释之蒸之，为酒为醴。","推本所由，于焉洽礼。","周邦开基，邰家是启。","献兹嘉觞，拜下首稽。"],0,"x207","宋"],["徐明叔竞向热传达二帖赞","岳珂","四言",["书名之行，始于东夷。","归而范模，则有馀师。","中兴几人，存此绝技。","太平之风，尚想渐被。"],0,"x202","宋"],["刘禹端公问云居雨从何来东平问官人风作何色 其一","释重显","四言",["雨从何来，风作何色。","龙门万仞，曾留宿客。","进退相将，谁遭点额。"],0,"x156","宋"]]