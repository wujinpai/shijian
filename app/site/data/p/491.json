[["郊庙歌辞 蜡百神乐章 肃和","佚名","四言",["序迫岁阴，日躔星纪。","爰稽茂典，聿崇清祀。","绮币霞舒，瑞珪虹起。","百禩垂裕，万灵荐祉。"],0,"x14","唐"],["郊庙歌辞 享孔子庙乐章 迎神","佚名","四言",["通吴表圣，问老探真。","三千弟子，五百贤人。","亿龄规法，万载嗣禋。","洁诚以祭，奏乐迎神。"],0,"x14","唐"],["郊庙歌辞 祀九宫贵神乐章 豫和 四","佚名","四言",["夜如何其，明星煌煌。","天清容卫，露结坛场。","树羽幢幢，佩玉锵锵。","凝精驻目，瞻望神光。"],0,"x14","唐"],["郊庙歌辞 梁太庙乐舞辞 送神","佚名","四言",["其降无从，其往无踪。","黍稷非馨，有感必通。","赫奕令德，髣髴睟容。","再拜慌忽，遐想昊穹。"],0,"x14","唐"],["郊庙歌辞 梁太庙乐舞辞 象功舞","佚名","四言",["天地合德，睿圣昭彰。","累赠太傅，俄登魏王。","雄名不朽，奕叶而光。","建国之兆，君临万方。"],0,"x14","唐"],["郊庙歌辞 祀九宫贵神乐章 豫和 三","佚名","四言",["帝临中坛，受厘元神。","皇灵萃止，羽旄肃陈。","摄提运衡，招摇移轮。","光光宇宙，电耀雷震。"],0,"x14","唐"],["郊庙歌辞 祀九宫贵神乐章 豫和 六","佚名","四言",["崇崇泰坛，灵具临兮。","铿锽大乐，振动心兮。","神之降矣，卿云郁兮。","神之至止，清风肃兮。"],0,"x14","唐"],["郊庙歌辞 祀九宫贵神乐章 豫和 五","佚名","四言",["九位既肃，万灵毕会。","天门启扄，日驭飞盖。","焕兮棽离，傧兮暗霭。","如山之福，惟圣时对。"],0,"x14","唐"],["郊庙歌辞 仪坤庙乐章 太和","丘说","四言",["孝哉我后，冲乎迺圣。","道映重华，德辉文命。","慕深视箧，情殷抚镜。","万国移风，兆人承庆。"],0,26,"唐"],["劝世","吕岩","四言",["一毫之善，与人方便。","一毫之恶，劝君莫作。","衣食随缘，自然快乐。","算是甚命，问什么卜。","欺人是祸，饶人是福。","天眼昭昭，报应甚速。","谛听吾言，神钦鬼伏。"],0,176,"唐"],["郊庙歌辞 享太庙乐章 雍和二首 其二","张说","四言",["俎豆有馥，粢盛絜丰。","亦有和羹，既戒既平。","鼓钟管磬，肃唱和鸣。","皇皇后祖，来我思成。"],0,133,"唐"],["诗品二十四则 超诣","司空图","四言",["匪神之灵，匪机之微。","如将白云，清风与归。","远引若至，临之已非。","少有道契，终与俗违。","乱山高木，碧苔芳晖。","诵之思之，其声愈稀。"],0,"x26","唐"],["郊庙歌辞 武后享清庙乐章十首 第三登歌","佚名","四言",["肃敷大礼，上谒尊灵。","敬[陈]筐币，载表丹诚。"],0,"x14","唐"],["郊庙歌辞 武后享清庙乐章十首 第四迎神","佚名","四言",["敬奠苹藻，式罄虔襟。","洁诚斯展，伫降灵歆。"],0,"x14","唐"],["郊庙歌辞 梁太庙乐舞辞 来仪舞","佚名","四言",["于赫帝命，应天顺人。","亭育品汇，宾礼百神。","洪基永固，景命惟新。","肃恭孝享，祚我生民。"],0,"x14","唐"],null,["郊庙歌辞 襃德庙乐章 彰德","佚名","四言",["名隆五岳，秩映三台。","严祠已备，[睟]影方回。"],0,"x14","唐"],["道藏歌诗 十四","佚名","四言",["推校千精，热馘雷震。","五帝秉钺，神公吐烟。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 升和","佚名","四言",["顾惟菲薄，纂历应期。","中外同轨，夷狄来思。","乐用崇德，礼以陈词。","夕惕若厉，钦奉弘基。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 崇德舞","张说","四言",["皇合一德，朝宗百神。","削平天地，大拯生人。","上帝配食，单于入臣。","戎歌陈舞，晔晔震震。"],0,133,"唐"],["郊庙歌辞 太清宫乐章 煌煌","佚名","四言",["煌煌道宫，肃肃太清。","礼光尊祖，乐备充庭。","罄竭诚至，希夷降灵。","云凝翠盖，风燄红旌。","众真以从，九奏初迎。","永惟休祐，是锡和平。"],0,"x14","唐"],["郊庙歌辞 蜡百神乐章 送神","佚名","四言",["十旬欢洽，一日祠终。","澄彝拂俎，报德酬功。","虑虔容肃，礼缛仪丰。","神其降祉，整驭随风。"],0,"x14","唐"],["二风诗   二","元结","四言",["至哉俭德，不丰不敷。","谁能颂之，我请颂夫。","於戏劳王，俭亦何深。","戒尔万代，奢侈荒淫。"],0,63,"唐"],["二风诗   二","元结","四言",["嘻乎乱王，王心何思。","暴淫虐惑，无思不为。","生人冤怨，言何极之。"],0,63,"唐"],["郊庙歌辞 武后享清庙乐章十首 第六送文舞","佚名","四言",["帝图草创，皇业初开。","功高佐命，业赞云雷。"],0,"x14","唐"],["郊庙歌辞 武后享清庙乐章十首 第十送神","佚名","四言",["大礼言毕，仙卫将归。","莫申丹恳，空瞻紫微。"],0,"x14","唐"],["南郊文武出入舒和之乐","张九龄","四言",["祝史辞正，人神庆叶。","福以德昭，享以诚接。","六变云备，百礼斯浃。","祀事孔明，祚流万叶。"],0,188,"唐"],["郊庙歌辞 五郊乐章 黄帝宫音 肃和","魏征","四言",["眇眇方舆，苍苍圜盖。","至哉枢纽，宅中图大。","气调四序，风和万籁。","祚我明德，时雍道泰。"],0,152,"唐"],["上崔相百忧章","李白","四言",["共公赫怒，天维中摧。","鲲鲸喷荡，扬涛起雷。","鱼龙陷人，成此祸胎。","火焚昆山，玉石相磓。","仰希霖雨，洒宝炎煨。","箭发石开，戈挥日回。","邹衍恸哭，燕霜飒来。","微诚不感，犹絷夏台。","苍鹰搏攫，丹棘崔嵬。","豪圣凋枯，王风伤哀。","斯文未丧，东岳岂颓。","穆逃楚难，邹脱吴灾。","见机苦迟，二公所咍。","骥不骤进，麟何来哉。","星离一门，草掷二孩。","万愤结习，忧从中催。","金瑟玉壶，尽为愁媒。","举酒太息，泣血盈桮。","台星再朗，天纲重恢。","屈法申恩，弃瑕取材。","冶长非罪，尼父无猜。","覆盆傥举，应照寒灰。"],0,"x3","唐"],null,["郊庙歌辞 祭方丘乐章 肃和","褚亮","四言",["至矣坤德，皇哉地祇。","开元统纽，合大承规。","九宫肃列，六典相仪。","永言配命，长保无亏。"],0,150,"唐"],["郊庙歌辞 享太庙乐章 崇德舞","佚名","四言",["五运改卜，千龄启圣。","彤云晓聚，黄星夜映。","叶阐珠囊，基开玉镜。","下临万宇，上齐七政。","雾开三象，尘清九服。","海溓星晖，远安迩肃。","天地交泰，华夷辑睦。","翔泳归仁，中外禔福。","绩逾黜夏，勋高翦商。","武陈七德，刑设三章。","祥禽巢阁，仁兽游梁。","卜年惟永，景福无疆。"],0,"x14","唐"],["郊庙歌辞 享懿德太子庙乐章 登歌酌鬯","佚名","四言",["誉阐元储，寄崇明两。","玉裕虽晦，铜楼可想。","弦诵辍音，笙歌罢响。","币帛言设，礼容无爽。"],0,"x14","唐"],["郊庙歌辞 襃德庙乐章 进德","佚名","四言",["涂山懿戚，妫汭崇姻。","祠筵肇启，祭典方申。","礼以备物，乐以感神。","用隆敦敍，载穆彝伦。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 大成舞","张说","四言",["帝舞季历，龙圣生昌。","后歌有𫊸，胎炎孕黄。","天地合德，日月齐光。","肃雍孝享，祚我万方。"],0,133,"唐"],["郊庙歌辞 祭大社乐章 迎神","佚名","四言",["烈山有子，后土有臣。","播种百谷，济育兆人。","春官缉礼，宗伯司禋。","戊为吉日，迎享兹辰。"],0,"x14","唐"],["郊庙歌辞 五郊乐章 赤帝徵音 肃和","魏征","四言",["离位克明，火中宵见。","峰云暮起，景风晨扇。","木槿初荣，含桃可荐。","芬馥百品，铿锵三变。"],0,152,"唐"],["郊庙歌辞 享章怀太子庙乐章 登歌酌鬯","佚名","四言",["忠孝本著，羽翼先成。","寝门昭德，驰道为程。","币帛有典，容卫无声。","司存既肃，庙享惟清。"],0,"x14","唐"],["太和 寿和","贺知章","四言",["惟以明发，有怀载殷。","乐盈而反，礼顺其禋。","立清以献，荐欲是亲。","於穆不已，裒对斯臻。"],0,210,"唐"],["郊庙歌辞 祭神州乐章 送神","佚名","四言",["神州阴祀，洪恩广济。","草树沾和，飞沈沐惠。","礼修鼎俎，奠歆瑶币。","送乐有章，灵轩其逝。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 景云舞","张说","四言",["景云霏烂，告我帝符。","噫帝冲德，与天为徒。","笙镛遥远，俎豆虚无。","春秋孝献，回复此都。"],0,133,"唐"],["郊庙歌辞 武后明堂乐章 皇嗣出入升降","武则天","四言",["至人光俗，大孝通神。","谦以表性，恭惟立身。","洪规载启，茂典方陈。","誉隆三善，祥开万春。"],0,96,"唐"],["郊庙歌辞 享太庙乐章 送神","佚名","四言",["五声备奏，三献终祠。","车移凤辇，斾转虹旗。","礼周笾豆，诚效虔祗。","皇灵徙跸，簪绅拜辞。"],0,"x14","唐"],["郓州谿堂诗","韩愈","四言",["帝奠九廛，有叶有年。","有荒不条，河岱之间。","及我宪考，一收正之。","视邦选侯，以公来尸。","公来尸之，人始未信。","公不饮食，以训以徇。","孰饥无食，孰呻孰叹。","孰冤不问，不得分愿。","孰为邦蟊，节根之螟。","羊很狼贪，以口覆城。","吹之喣之，摩手拊之。","箴之石之，膊而磔之。","凡公四封，既富以彊。","谓公吾父，孰违公令。","可以师征，不宁守邦。","公作谿堂，播播流水。","浅有蒲莲，深有葭苇。","公以宾燕，其鼓骇骇。","公燕谿堂，宾校醉饱。","流有跳鱼，岸有集鸟。","既歌以舞，其鼓考考。","公在谿堂，公御琴瑟。","公暨宾赞，稽经诹律。","施用不差，人用不屈。","谿有薲苽，有龟有鱼。","公在中流，右诗左书。","无我斁遗，此邦是庥。"],0,"x19","唐"],["郊庙歌辞 武后大享昊天乐章 十","佚名","四言",["肃肃祀典，邕邕礼秩。","三献已周，九成斯毕。","爰撤其俎，载迁其实。","或升或降，唯诚唯质。"],0,"x14","唐"],["郊庙歌辞 封泰山乐章 寿和","张说","四言",["烝烝我后，享献惟寅。","躬酌郁鬯，跪奠明神。","孝莫孝乎，配上帝亲。","敬莫敬乎，教天下臣。"],0,133,"唐"],["郊庙歌辞 封泰山乐章 寿和","张说","四言",["皇祖严配，配享皇天。","皇皇降嘏，天子万年。"],0,133,"唐"],["郊庙歌辞 武后大享昊天乐章 十一","佚名","四言",["礼终肆类，乐阕九成。","仰惟明德，敢荐非馨。","顾慙菲奠，久驻云𫐌。","瞻荷灵泽，悚恋兼盈。"],0,"x14","唐"],["唐封泰山乐章 豫和六首 其五","张说","四言",["天道无亲，至诚与邻。","山川遍礼，宫征维新。","玉帛非盛，聪明会真。","正斯一德，通乎百神。"],0,133,"唐"],["唐封泰山乐章 豫和六首 其六","张说","四言",["享帝享亲，维孝维圣。","缉熙懿德，敷扬成命。","华夷志同，笙镛礼盛。","明灵降止，感此诚敬。"],0,133,"唐"],["郊庙歌辞 五郊乐章 白帝商音 肃和","魏征","四言",["金行在节，素灵居正。","气肃霜严，林雕草劲。","豺祭隼击，潦收川镜。","九谷已登，万箱流咏。"],0,152,"唐"],["郊庙歌辞 享太庙乐章 惟新舞","刘晏","四言",["汉祚惟永，神功中兴。","夙驱氛祲，天覆黎蒸。","三光再朗，庶绩其凝。","重熙累叶，景命是膺。"],0,94,"唐"],["郊庙歌辞 昭德皇后庙乐章 坤元","佚名","四言",["於穆先后，丽圣称崇。","母临万宇，道[被]六宫。","昌时协庆，理内成功。","殷荐明德，传芳国风。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 迎神","佚名","四言",["七庙观德，百灵攸仰。","俗荷财成，物资含养。","道光执契，化笼提象。","肃肃雍雍，神其来飨。"],0,"x14","唐"],["郊庙歌辞 善胜舞 禋顺","佚名","四言",["礼毕祀先，香散几筵。","罢舞干戚，收撤豆笾。"],0,"x14","唐"],null,null,["郊庙歌辞 太清宫乐章 终上","佚名","四言",["不宰元功，无为上圣。","洪源长发，诞受天命。","金奏迎真，璇宫展盛。","备礼周乐，垂光储庆。"],0,"x14","唐"],["郊庙歌辞 周郊祀乐章 禋顺乐","佚名","四言",["黄彝将献，特牲预迎。","既修昭事，潜达明诚。"],0,"x14","唐"],null,["郊庙歌辞 享太庙乐章 肃和","佚名","四言",["月礼已周，云和将变。","爰献其醑，载迁其奠。","明德逾隆，非馨是荐。","泽沾动植，仁覃宇县。"],0,"x14","唐"],["郊庙歌辞 明皇祀圜丘乐章 太和","佚名","四言",["郊坛斋帝，礼乐祀天。","丹青寰宇，宫征山川。","神祇毕降，行止重旋。","融融穆穆，纳祉洪延。"],0,"x14","唐"],["郊庙歌辞 明皇祀圜丘乐章 太和","佚名","四言",["六成既阕，三荐云终。","神心具醉，圣敬愈崇。","受厘皇邸，回跸帷宫。","穰穰之福，永永无穷。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 光大舞","张说","四言",["肃肃艺祖，滔滔浚源。","有雄玉剑，作镇金门。","玄王贻绪，后稷谋孙。","肇禋九庙，四海来尊。"],0,133,"唐"],["郊庙歌辞 享太庙乐章 钧天舞","张说","四言",["高皇迈道，端拱无为。","化怀獯鬻，兵赋句骊。","礼尊封禅，乐盛来仪。","合位娲后，同称伏羲。"],0,133,"唐"],["庆云章","陈子昂","四言",["昆仑元气，实生庆云。","大人作矣，五色氤氲。","昔在帝妫，南风既薰。","丛芳烂熳，郁郁纷纷。","旷矣千祀，庆云来止。","玉叶金柯，祚我天子。","非我天子，庆云谁昌。","非我圣母，庆云谁光。","庆云光矣，周道昌矣。","九万八千，天授皇年。"],0,80,"唐"],["郊庙歌辞 享太庙乐章 大明舞","张说","四言",["赤精乱德，四海困穷。","黄旗举义，三灵会同。","旱望春雨，云披大风。","溥天来祭，高祖之功。"],0,133,"唐"],["郊庙歌辞 享太庙乐章 凯安三首 其一","张说","四言",["瑟彼瑶爵，亚维上公。","室如屏气，门不容躬。","礼殷其本，乐执其中。","圣皇永慕，天地幽通。"],0,133,"唐"],["郊庙歌辞 仪坤庙乐章 其二 送神","佚名","四言",["玉帛仪大，金丝奏广。","灵应有孚，冥征不爽。","降彼休福，歆兹禋享。","送乐有章，神麾其上。"],0,"x14","唐"],["郊庙歌辞 梁郊祀乐章 庆平","赵光逢、张衮","四言",["天命降鉴，帝德惟馨。","享祀不忒，礼容孔明。","奠璧布币，荐神献精。","神佑以答，敷锡永宁。"],0,0,"唐"],["郊庙歌辞 祭汾阴乐章 南吕羽","韩休","四言",["於穆濬哲，维清缉熙。","肃事昭配，永言孝思。","涤濯静嘉，馨香在兹。","神之听之，用受福厘。"],0,62,"唐"],["郊庙歌辞 享太庙乐章 景云舞","佚名","四言",["惟睿作圣，惟圣登皇。","精感耀魄，时膺会昌。","舜慙大孝，尧推让王。","能事斯极，振古谁方。","文明履运，车书同轨。","巍巍赫赫，尽善尽美。","衢室凝旒，大庭端扆。","释负之寄，事光复子。","脱屣高天，登遐上玄。","龙湖超忽，象野芊绵。","游衣复道，荐果初年。","新庙奕奕，明德配天。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 和宁舞","牛僧孺","四言",["湜湜颀颀，融昭德辉。","不纽不舒，贯成九围。","武烈文经，敷施当宜。","纂尧付启，亿万熙熙。"],0,164,"唐"],["郊庙歌辞 仪坤庙乐章 其一 迎神","佚名","四言",["月灵降德，坤元授光。","娥英比秀，任姒均芳。","瑶台荐祉，金屋延祥。","迎神有乐，歆此嘉芗。"],0,"x14","唐"],null,["郊庙歌辞 享太庙乐章 延和","佚名","四言",["巍巍累圣，穆穆重光。","奄有区夏，祚启隆唐。","百蛮饮泽，万国来王。","本枝亿载，鼎祚逾长。"],0,"x14","唐"],["郊庙歌辞 梁太庙乐舞辞 昭德舞","佚名","四言",["肃肃文考，源濬派长。","汉称诞季，周实生昌。","奄有四海，超彼百王。","笙镛迭奏，礼物荧煌。"],0,"x14","唐"],["诗品二十四则 纤秾","司空图","四言",["采采流水，蓬蓬远春。","窈窕深谷，时见美人。","碧桃满树，风日水滨。","柳阴路曲，流莺比邻。","乘之愈往，识之愈真。","如将不尽，与古为新。"],0,"x26","唐"],["郊庙歌辞 享太庙乐章 太和","张说","四言",["时文圣后，清庙肃邕。","致诚勤荐，在貌思恭。","玉节肆夏，金锵五钟。","绳绳云步，穆穆天容。"],0,133,"唐"],["郊庙歌辞 梁太庙乐舞辞 大合舞","佚名","四言",["於穆皇祖，濬哲雍熙。","美溢中夏，化被南陲。","后稷累德，公刘创基。","肇兴九庙，乐合来仪。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 恭和","佚名","四言",["礼周三献，乐阕九成。","肃承灵福，悚惕兼盈。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 肃和","张说","四言",["天子享孝，工歌溥将。","躬祼郁鬯，乃焚膋芗。","臭以达阴，声以求阳。","奉时烝尝，永代不忘。"],0,133,"唐"],["郊庙歌辞 享太庙乐章 诚敬","佚名","四言",["顾惟菲质，忝位椒宫。","虔奉苹藻，肃事神宗。","敢申诚絜，庶罄深衷。","睟容有裕，灵享无穷。"],0,"x14","唐"],["郊庙歌辞 明皇祀圜丘乐章 舒和","佚名","四言",["祝史正辞，人神叶庆。","福以德招，享以诚应。","六变云备，百礼斯浃。","祀事孔明，祚流万叶。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 严和","佚名","四言",["肃肃清庙，赫赫玄猷。","功高万古，化奄十洲。","中兴丕业，上荷天休。","祗奉先构，礼备怀柔。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 广运舞","郭子仪","四言",["于赫皇祖，昭明有融。","惟文之德，惟武之功。","河海静谧，车书混同。","虔恭孝飨，穆穆玄风。"],0,201,"唐"],["郊庙歌辞 享惠昭太子庙乐章 请神","归登","四言",["嘉荐既陈，祀事孔明。","闲歌在堂，万舞在庭。","外则尽物，内则尽诚。","凤笙如闻，歌其洁精。"],0,40,"唐"],["郊庙歌辞 让皇帝庙乐章 酌献","李纾","四言",["八音具举，三寿既盥。","洁兹宗彝，瑟彼圭瓒。","兰肴重错，椒醑飘散。","降祚维城，永为藩翰。"],0,255,"唐"],["还丹歌 十二","杨行真人","四言",["世上求道，酒肉愚痴。","百年欲过，颙颙不知。","金公制伏，还丹一支。","朱砂伏火，治病无疑。","长生有望，坚固无疑。","不衰不老，彭祖同时。"],0,50,"唐"],["补周礼九夏系文   一","皮日休","四言",["爣爣皎日，歘丽于天。","厥明御舒，如王出焉。"],0,"x15","唐"],["补周礼九夏系文   一","皮日休","四言",["愔愔清庙，仪仪象服。","我尸出矣，迎神之谷。"],0,"x15","唐"],["补周礼九夏系文   一","皮日休","四言",["有郁其鬯，有俨其彝。","九变未作，全乘来之。"],0,"x15","唐"],["补周礼九夏系文   一","皮日休","四言",["麟之仪仪，不絷不维。","乐德而至，如宾之嬉。"],0,"x15","唐"],["补周礼九夏系文   一","皮日休","四言",["王有虎臣，锡之𫓧钺。","征彼不憓，一扑而灭。"],0,"x15","唐"],["补周礼九夏系文   一","皮日休","四言",["洪源谁孕，疏为江河。","大块孰埏，播为山阿。"],0,"x15","唐"],["补周礼九夏系文   一","皮日休","四言",["礼酒既酌，嘉宾既厚，牍为之奏。"],0,"x15","唐"],["补周礼九夏系文   一","皮日休","四言",["桓桓其珪，衮衮其衣。","出作二伯，天子是毗。"],0,"x15","唐"],["郊庙歌辞 享太庙乐章 虔和","佚名","四言",["礼标荐鬯，肃事祠庭。","敬申如在，敢托非馨。"],0,"x14","唐"]]