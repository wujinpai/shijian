[["诗品二十四则 疏野","司空图","四言",["惟性所宅，真取弗羁。","拾物自富，与率为期。","筑屋松下，脱帽看诗。","但知旦暮，不辨何时。","倘然适意，岂必有为。","若其天放，如是得之。"],0,"x26","唐"],["诗品二十四则 典雅","司空图","四言",["玉壶买春，赏雨茆屋。","坐中佳士，左右修竹。","白云初晴，幽鸟相逐。","眠琴绿阴，上有飞瀑。","落花无言，人淡如菊。","书之岁华，其曰可读。"],0,"x26","唐"],["游长宁公主流杯池二十五首 其二十一","上官婉儿","四言",["檀栾竹影，飙𫗇松声。","不烦歌吹，自足娱情。"],0,80,"唐"],["游长宁公主流杯池二十五首 其二十四","上官婉儿","四言",["清波汹涌，碧树冥蒙。","莫怪留步，因攀桂丛。"],0,80,"唐"],["游长宁公主流杯池二十五首 其二十五","上官婉儿","四言",["莫论圆峤，休说方壶。","何如鲁馆，即是仙都。"],0,80,"唐"],["诗品二十四则 雄浑","司空图","四言",["大用外腓，真体内充。","返虚入浑，积健为雄。","具备万物，横绝太空。","荒荒油云，寥寥长风。","超以象外，得其环中。","持之匪强，来之无穷。"],0,"x26","唐"],["峡中旧语（题拟）","佚名","四言",["五月下峡，死而不吊。","（同前卷下）。"],0,"x14","唐"],["诗品二十四则 含蓄","司空图","四言",["不著一字，尽得风流。","语不涉难，已不堪忧。","是有真宰，与之沈浮。","如渌满酒，花时返秋。","悠悠空尘，忽忽海沤。","浅深聚散，万取一收。"],0,"x26","唐"],["郊庙歌辞 享太庙乐章 凯安三首 其二","张说","四言",["礼匝三献，乐遍九成。","降循轩陛，仰欷皇情。","福与仁合，德因孝明。","百年神畏，四海风行。"],0,133,"唐"],["诗品二十四则 流动","司空图","四言",["若纳水𫐑，如转丸珠。","夫岂可道，假体遗愚。","荒荒坤轴，悠悠天枢。","载要其端，载同其符。","超超神明，返返冥无。","来往千载，是之谓乎。"],0,"x26","唐"],["琴曲歌辞 琴歌","顾况","四言",["琴调秋些，胡风遶雪。","峡泉生咽，佳人愁些。"],0,191,"唐"],["诗品二十四则 高古","司空图","四言",["畸人乘真，手把芙蓉。","泛彼浩劫，窅然空纵。","月出东斗，好风相从。","太华夜碧，人闻清钟。","虚伫神素，脱然畦封。","黄唐在独，落落玄宗。"],0,"x26","唐"],["郊庙歌辞 享太庙乐章 凯安三首 其三","张说","四言",["总总干戚，填填鼓钟。","奋扬增气，坐作为容。","离若鸷鸟，合如战龙。","万方观德，肃肃邕邕。"],0,133,"唐"],["诗品二十四则 冲淡","司空图","四言",["素处以默，妙机其微。","饮之太和，独鹤与飞。","犹之惠风，苒苒在衣。","阅音修篁，美曰载归。","遇之匪深，即之愈稀。","脱有形似，握手已违。"],0,"x26","唐"],["诗品二十四则 实境","司空图","四言",["取语甚直，计思匪深。","忽逢幽人，如见道心。","晴涧之曲，碧松之阴。","一客荷樵，一客听琴。","情性所至，妙不自寻。","遇之自天，冷然希音。"],0,"x26","唐"],["琴操十首 其二 猗兰操","韩愈","四言",["兰之猗猗，扬扬其香。","不采而佩，于兰何伤。","今天之旋，其曷为然。","我行四方，以日以年。","雪霜贸贸，荠麦之茂。","子如不伤，我不尔觏。","荠麦之茂，荠麦之有。","君子之伤，君子之守。"],0,"x19","唐"],["诗品二十四则 飘逸","司空图","四言",["落落欲往，矫矫不群。","缑山之鹤，华顶之云。","高人画中，令色𬘡缊。","御风蓬叶，泛彼无垠。","如不可执，如将有闻。","识者已领，期之愈分。"],0,"x26","唐"],["与昂上人两字继合四句初字日","皎然","四言",["有一鸟雏，凌寒独宿。","若逢云雨，两两相逐。"],0,"x22","唐"],["剥啄行","韩愈","四言",["剥剥啄啄，有客至门。","我不出应，客去而嗔。","从者语我，子胡为然。","我不厌客，困于语言。","欲不出纳，以堙其源。","空堂幽幽，有秸有莞。","门以两板，丛书于间。","窅窅深堑，其墉甚完。","彼宁可隳，此不可干。","从者语我，嗟子诚难。","子虽云尔，其口益蕃。","我为子谋，有万其全。","凡今之人，急名与官。","子不引去，与为波澜。","虽不开口，虽不开关。","变化咀嚼，有鬼有神。","今去不勇，其如后艰。","我谢再拜，汝无复云。","往追不及，来不有年。"],0,"x19","唐"],["诗品二十四则 绮丽","司空图","四言",["神存富贵，始轻黄金。","浓尽必枯，浅者屡深。","露馀山青，红杏在林。","月明华屋，画桥碧阴。","金尊酒满，共客弹琴。","取之自足，良殚美襟。"],0,"x26","唐"],["郊庙歌辞 让皇帝庙乐章 送神","李纾","四言",["奠献已事，昏昕载分。","风摇雨散，灵卫𬘡缊。","龙驾帝服，已腾五云。","泮宫复閟，寂寞无闻。"],0,255,"唐"],["郊庙歌辞 五郊乐章 白郊迎神","佚名","四言",["序移玉律，节应金商。","天严杀气，吹警秋方。","槱燎既积，稷奠并芳。","乐以迎奏，庶降神光。"],0,"x14","唐"],["诗品二十四则 劲健","司空图","四言",["行神如空，行气如虹。","巫峡千寻，走云连风。","饮真茹强，蓄素守中。","喻彼行健，是谓存雄。","天地与立，神化攸同。","期之以实，御之以终。"],0,"x26","唐"],["诗品二十四则 缜密","司空图","四言",["是有真迹，如不可知。","意象欲生，造化已奇。","水流花开，清露未晞。","要路愈远，幽行为迟。","语不欲犯，思不欲痴。","犹春于绿，明月雪时。"],0,"x26","唐"],["郊庙歌辞 让皇帝庙乐章 迎神","李纾","四言",["皇矣天宗，德先王季。","因心则友，克让以位。","爰命有司，式尊前志。","神其降灵，昭飨祀事。"],0,255,"唐"],["郊庙歌辞 祭汾阴乐章 舒和","何鸾","四言",["乐奏云阕，礼章载虔。","禋宗于地，昭假于天。","惟馨荐矣，既醉歆焉。","神之降福，永永万年。"],0,65,"唐"],["郊庙歌辞 禅社首乐章 其二 太和","贺知章","四言",["肃我成命，于昭黄衹。","裘冕而祀，陟降在斯。","五音克备，八变聿施。","缉熙肆靖，厥心匪离。"],0,210,"唐"],["郊庙歌辞 五郊乐章 青郊迎神","佚名","四言",["缇幕移候，青郊启蛰。","淑景迟迟，和风习习。","璧玉宵备，旌旄曙立。","张乐以迎，帝神其入。"],0,"x14","唐"],["诗品二十四则 洗炼","司空图","四言",["犹矿出金，如铅出银。","超心炼冶，绝爱缁磷。","空潭泻春，古镜照神。","体素储洁，乘月返真。","载瞻星辰，载歌幽人。","流水今日，明月前身。"],0,"x26","唐"],["郊庙歌辞 五郊乐章 白帝商音","魏征","四言",["白藏应节，天高气清。","岁功既阜，庶类收成。","万方静谧，九土和平。","馨香是荐，受祚聪明。"],0,152,"唐"],["郊庙歌辞 五郊乐章 赤郊迎神","佚名","四言",["青阳节谢，朱明候改。","靡草雕华，含桃流彩。","虡列钟磬，筵陈脯醢。","乐以迎神，神其如在。"],0,"x14","唐"],["奉和圣制烛龙斋祭","张九龄","四言",["上帝临下，鉴亦有光。","孰云阴骘，惟圣克彰。","六月徂暑，四郊愆阳。","我后其勤，告于坛场。","精意允溢，群灵鼓舞。","蔚兮朝云，沛然时雨。","雨我原田，亦既有年。","烛龙煌煌，明宗报祀。","于以助之，天人帝子。","闻诗有训，国风兹始。"],0,188,"唐"],["郊庙歌辞 五郊乐章 黄郊迎神","佚名","四言",["朱明季序，黄郊王辰。","厚以载物，甘以养人。","毓金为体，禀火成身。","宫音式奏，奏以迎神。"],0,"x14","唐"],["诗品二十四则 旷达","司空图","四言",["生者百岁，相去几何。","欢乐苦短，忧愁实多。","何如尊酒，日往烟萝。","花覆茆檐，疏雨相过。","倒酒既尽，杖藜行过。","孰不有古，南山峨峨。"],0,"x26","唐"],["郊庙歌辞 五郊乐章 赤帝徵音","魏征","四言",["青阳告谢，朱明戒序。","延长是祈，敬陈椒醑。","博硕斯荐，笙镛备举。","庶尽肃恭，非馨稷黍。"],0,152,"唐"],["郊庙歌辞 五郊乐章 黑郊迎神","佚名","四言",["玄英戒序，黑郊临候。","掌礼陈彝，司筵执豆。","寒氛敛色，沍泉凝漏。","乐以迎神，八音斯奏。"],0,"x14","唐"],["诗品二十四则 清奇","司空图","四言",["娟娟群松，下有漪流。","晴雪满汀，隔溪渔舟。","可人如玉，步屧寻幽。","载行载止，空碧悠悠。","神出古异，淡不可收。","如月之曙，如气之秋。"],0,"x26","唐"],["郊庙歌辞 让皇帝庙乐章 迎俎","李纾","四言",["祀盛体荐，礼协粢盛。","方周假庙，用鲁纯牲。","捧撤祗敬，击拊和鸣。","受厘归胙，既戒而平。"],0,255,"唐"],["郊庙歌辞 禅社首乐章 其七 太和","贺知章","四言",["昭昭有唐，天俾万国。","列祖应命，四宗顺则。","申锡无疆，宗我同德。","曾孙继绪，享神配极。"],0,210,"唐"],["郊庙歌辞 让皇帝庙乐章 奠币","李纾","四言",["惟帝时若，去而上仙。","祀用商武，乐备宫悬。","白壁加荐，玄𫄸告虔。","子孙拜后，承兹吉蠲。"],0,255,"唐"],["郊庙歌辞 五郊乐章 送神","佚名","四言",["春末冬暮，徂夏杪秋。","土王四月，时季一周。","黍稷已享，笾豆宜收。","送神有乐，神其赐休。"],0,"x14","唐"],["郊庙歌辞 五郊乐章 送神","佚名","四言",["文物流彩，声明动色。","人竭其恭，灵昭其饬。","歆荐不已，垂祯无极。","送礼有章，惟神还轼。"],0,"x14","唐"],["郊庙歌辞 五郊乐章 送神","佚名","四言",["炎精式降，苍生攸仰。","羞列豆笾，酒陈牺象。","昭祀有应，冥期不爽。","送乐张音，惟灵之往。"],0,"x14","唐"],["郊庙歌辞 五郊乐章 送神","佚名","四言",["祀遵五礼，时属三秋。","人怀肃敬，灵降祯休。","奠歆旨酒，荐享珍羞。","载张送乐，神其上游。"],0,"x14","唐"],["郊庙歌辞 五郊乐章 送神","佚名","四言",["北郊时冽，南陆辉处。","奠本虔诚，献弥恭虑。","上延祉福，下承欢豫。","广乐送神，神其整驭。"],0,"x14","唐"],["郊庙歌辞 五郊乐章 青帝角音","魏征","四言",["鹤云旦起，鸟星昏集。","律候新风，阳开初蛰。","至德可飨，行潦斯挹。","锡以无疆，蒸人乃粒。"],0,152,"唐"],null,["郊庙歌辞 德明兴圣庙乐章 登歌奠币","李纾","四言",["四时有典，百事来祭。","尊祖奉宗，严禋大帝。","礼先苍璧，奠备黝制。","于万斯年，熙成帝系。"],0,255,"唐"],null,null,["琴操十首 其七 履霜操","韩愈","四言",["父兮儿寒，母兮儿饥。","儿罪当笞，逐儿何为？","儿在中野，以宿以处。","四无人声，谁与儿语。","儿寒何衣，儿饥何食。","儿行于野，履霜以足。","母生众儿，有母怜之。","独无母怜，儿宁不悲。"],0,"x19","唐"],["唐大飨拜洛乐章 昭和","武则天","四言",["九玄眷命，三圣基隆。","奉成先旨，明台毕功。","宗祀展敬，冀表深衷。","永昌帝业，式播淳风。"],0,96,"唐"],["唐大飨拜洛乐章 昭和","武则天","四言",["舒云致养，合大资生。","德以恒固，功由永贞。","升歌荐序，垂币翘诚。","虹开玉照，凤引金声。"],0,96,"唐"],["郊庙歌辞 汉宗庙乐舞辞 武德舞","张昭","四言",["明明我祖，天集休明。","神母夜哭，彤云昼兴。","笾豆有践，管籥斯登。","孝孙致告，神其降灵。"],0,230,"唐"],null,["还丹歌","岑真人","四言",["东方青龙，丙丁甲乙。","西方白虎，壬癸凝液。","二气舍真，世人难觅。","机持此宝，一水一石。","灰池焰烁，名除死籍。"],0,22,"唐"],["酬诸公见过","王维","四言",["嗟予未丧，哀此孤生。","屏居蓝田，薄地躬耕。","岁[晏]输税，以奉粢盛。","晨往东臯，草露未晞。","暮看烟火，负担来归。","我闻有客，足埽荆扉。","箪食伊何，疈瓜抓枣。","仰厕群贤，皤然一老。","媿无莞簟，班荆席藁。","泛泛登陂，折彼荷花。","静观素鲔，俯映白沙。","山鸟群飞，日隐轻霞。","登车上马，倏忽云散。","雀噪荒村，鸡鸣空馆。","还复幽独，重欷累叹。"],0,"x1","唐"],["有竹一篇七章 其六","萧颖士","四言",["彼纷者务，体其豫矣。","有旨者酒，欢其且矣。","友僚萃止，跗蕚载韡。"],0,199,"唐"],null,["有竹一篇七章 其三","萧颖士","四言",["彼蔚者竹，萧其森矣。","有开者合，宛其深矣。","回簷幽砌，如翼如齿。"],0,199,"唐"],["郊庙歌辞 蜡百神乐章 迎神","佚名","四言",["八蜡开祭，万物合祀。","上极天维，下穷坤纪。","鼎俎流芬，罇彝荐美。","有灵有祇，咸希来止。"],0,"x14","唐"],["郊庙歌辞 武后享清庙乐章十首 第二","佚名","四言",["隆周创业，宝命惟新。","敬宗茂典，爰表虔禋。","声明已备，文物斯陈。","肃容如在，恳志方申。"],0,"x14","唐"],["郊庙歌辞 朝日乐章 肃和","佚名","四言",["惟圣格天，惟明飨日。","帝郊肆类，王宫戒吉。","珪奠春舒，钟歌晓溢。","礼云克备，斯文有秩。"],0,"x14","唐"],["猛虎行","李贺","四言",["长戈莫舂，长弩莫抨。","乳孙哺子，教得生狞。","举头为城，掉尾为旌。","东海黄公，愁见夜行。","道逢驺虞，牛哀不平。","何用尺刀，壁上雷鸣。","泰山之下，妇人哭声。","官家有程，吏不敢听。"],0,118,"唐"],["诗品二十四则 悲慨","司空图","四言",["大风卷水，林木为摧。","意苦若死，招憩不来。","百岁如流，富贵冷灰。","大道日往，若为雄才。","壮士拂剑，浩然弥哀。","萧萧落叶，漏雨苍苔。"],0,"x26","唐"],["郊庙歌辞 周宗庙乐舞辞 肃顺","佚名","四言",["我后至孝，祗谒祖先。","仰瞻庙貌，夙设宫悬。","朱弦疏越，羽舞回旋。","神其来格，明祀惟虔。"],0,"x14","唐"],["郊庙歌辞 禅社首乐章 其四 雍和","贺知章","四言",["夙夜宥密，不敢宁宴。","五齐既陈，八音在县。","粢盛以絜，房俎斯荐。","惟德惟馨，尚兹克徧。"],0,210,"唐"],["郊庙歌辞 享章怀太子庙乐章 迎神","佚名","四言",["副君昭象，道应黄离。","铜楼备德，玉裕成规。","仙气霭霭，灵从师师。","前驱戾止，控鹤来仪。"],0,"x14","唐"],["郊庙歌辞 太清宫乐章 香初上","佚名","四言",["肃肃我祖，緜緜道宗。","至感潜达，灵心暗通。","云𫐌御气，芝盖随风。","四时禋祀，万国来同。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 钧天[舞]","佚名","四言",["承天抚箓，纂圣登皇。","遐清万宇，仰协三光。","功成日用，道济时康。","璇图载永，宝历斯昌。","日月扬晖，烟云烂色。","河岳修贡，神祇効职。","舜风攸偃，尧曦先就。","睿感通寰，孝思浃宙。","奉扬先德，虔遵曩狩。","展义天扄，飞英云岫。","化逸王表，神凝帝先。","乘云厌俗，驭日登玄。"],0,"x14","唐"],null,["奉和圣制喜雨","张九龄","四言",["艰我稼穑，载育载亭。","随物应之，曷圣与灵。","谓我何凭，惟德之馨。","谁云天远，以诚必至。","太清无云，羲和顿辔。","于斯烝人，瞻彼非觊。","阴冥倏忽，沛泽咸洎。","何以致之，我后之感。","无皋无隰，黍稷黯黯。","无卉无木，敷芬黮黤。","黄龙勿来，鸣鸟不思。","人和年丰，皇心则怡。","岂与周宣，云汉徒诗。"],0,188,"唐"],["郊庙歌辞 周郊祀乐章 昭顺乐","佚名","四言",["五兵勿用，万国咸安。","告功圆盖，受命云坛。","乐鸣凤律，礼备鸡竿。","神光欲降，众目遐观。"],0,"x14","唐"],["郊庙歌辞 周郊祀乐章 昭顺乐","佚名","四言",["云门孤竹，苍璧黄琮。","既祀天地，克配祖宗。","虔修盛礼，仰荅玄功。","神归碧落，福降无穷。"],0,"x14","唐"],["郊庙歌辞 隐太子庙乐章 迎神","佚名","四言",["苍震有位，黄离蔽明。","江充祸结，戾据灾成。","衔冤昔痛，赠典今荣。","享灵有秩，奉乐以迎。"],0,"x14","唐"],["郊庙歌辞 享懿德太子庙乐章 迎神","佚名","四言",["甲观昭祥，画堂升位。","礼绝群后，望尊储贰。","启诵慙德，庄丕掩粹。","伊浦凤翔，缑峰鹤至。"],0,"x14","唐"],["郊庙歌辞 武后明堂乐章 迎送王公","武则天","四言",["千官肃事，万国朝宗。","载延百辟，爰集三宫。","君臣德合，鱼水斯同。","睿图方永，周历长隆。"],0,96,"唐"],["郊庙歌辞 太清宫乐章 登歌","佚名","四言",["严禋展事，理洁烝尝。","皇矣圣祖，德惟馨香。","盛荐既撤，工歌载扬。","大来之庆，降福穰穰。"],0,"x14","唐"],["郊庙歌辞 太清宫乐章 再上","佚名","四言",["仙宗绩道，我李承天。","庆深虚极，符光象先。","俗登仁寿，化阐蟺涓。","五千贻范，亿万斯年。"],0,"x14","唐"],["蠹","齐己","四言",["蠹不自蠹，而蠹于木。","蠹极木心，以丰尔腹。","偶或成之，胡为勗人。","人而不真，繇尔乱神。","蠹兮蠹兮，何全其生。","无托尔形，霜松雪柽。"],0,"x29","唐"],["郊庙歌辞 享隐太子庙乐章 肃和","佚名","四言",["岁肇春宗，干开震长。","瑶山既寂，戾园斯享。","玉肃其事，物昭其象。","弦诵成风，笙歌合响。"],0,"x14","唐"],["二风诗   一","元结","四言",["至哉勤绩，不盈不延。","谁能颂之，我请颂焉。","於戏劳王，勤亦何极。","济尔九土，山川沟洫。"],0,63,"唐"],["二风诗   一","元结","四言",["嘻乎王家，曾有凶王。","中世失国，岂非骄荒。","复复之难，令则可忘。"],0,63,"唐"],["郊庙歌辞 享惠昭太子庙乐章 送神","王涯","四言",["威仪毕陈，备乐将阕。","苞茅酒缩，膋萧香彻。","宫臣展事，肃雍在列。","迎精送往，厥鉴昭晰。"],0,240,"唐"],["郊庙歌辞 享章怀太子庙乐章 迎俎酌献","佚名","四言",["通三锡胤，明两承英。","太山比赫，伊水闻笙。","宗祧是寄，礼乐其亨。","嘉辰荐俎，以发声明。"],0,"x14","唐"],["郊庙歌辞 祭神州乐章 迎神","佚名","四言",["黄舆厚载，赤寰归德。","含育九区，保安万国。","诚敬无怠，禋祀有则。","乐以迎神，其仪不忒。"],0,"x14","唐"],["郊庙歌辞 周郊祀乐章 福顺乐","佚名","四言",["相承五运，取法三才。","大礼爰展，率土咸来。","卿云秘室，甘泉宝台。","象樽初酌，受福不回。"],0,"x14","唐"],["郊庙歌辞 周郊祀乐章 福顺乐","佚名","四言",["昊天成命，邦国盛仪。","多士齐列，六龙载驰。","坛升泰一，乐奏咸池。","高明祚德，永致昌期。"],0,"x14","唐"],["二风诗   三","元结","四言",["至哉茂功，不升不圯。","谁能颂之，我请颂矣。","於戏劳王，功亦何大。","去尔兆庶，洪湮灾害。"],0,63,"唐"],["郊庙歌辞 梁太庙乐舞辞 登歌","佚名","四言",["于赫我皇，建中立极。","动以武功，静以文德。","昭事上帝，欢心万国。","大报严禋，四海述职。"],0,"x14","唐"],["诗品二十四则 沈著","司空图","四言",["绿杉野屋，落日气清。","脱巾独步，时闻鸟声。","鸿雁不来，之子远行。","所思不远，若为平生。","海风碧云，夜渚月明。","如有佳语，大河前横。"],0,"x26","唐"],["蟋蟀诗","罗隐","四言",["顽飔毙芳，吹愁夕长。","屑戍有动，歌离吊梦。","如诉如言，绪引虚宽。","周隙伺榻，繁咽夤缘。","范睡蝉老，冠峨緌好。","不冠不緌，尔奚以悲。","蚊蚋有毒，食人肌肉。","苍蝇多端，黑白偷安。","尔也出处，物兮莫累。","坏舍啼衰，虚堂泣曙。","勿徇諠哗，鼠岂无牙。","勿学萋菲，垣亦有耳。","危条槁飞，抽恨咿咿。","别帐缸冷，柔魂不定。","美人在何，夜影流波。","与子伫立，裴回思多。"],0,"x17","唐"],["郊庙歌辞 梁太庙乐舞辞 皇帝行","佚名","四言",["莫高者天，攀跻弗克。","𬯀天有方，累仁积德。","祖宗隆之，子孙履之。","配天明祀，永永孝思。"],0,"x14","唐"],["郊庙歌辞 五郊乐章 黑帝羽音","魏征","四言",["严冬季月，星回风厉。","享祀报功，方祚来岁。"],0,152,"唐"],["郊庙歌辞 享太庙乐章 福和","张说","四言",["备礼用乐，崇亲致尊。","诚通慈降，敬彻爱存。","献怀称寿，啐感承恩。","皇帝孝德，子孙千亿。","大包天域，长亘不极。"],0,133,"唐"],["郊庙歌辞 隐太子庙乐章 送神","佚名","四言",["皇情悼往，祀议增设。","钟鼓铿锵，羽旄昭晰。","掌礼云备，司筵告彻。","乐以送神，灵其鉴阕。"],0,"x14","唐"],["郊庙歌辞 武后享清庙乐章十首 第九彻俎","佚名","四言",["登歌已阕，献礼方周。","钦承景福，肃奉鸿休。"],0,"x14","唐"],["郊庙歌辞 武后明堂乐章 登歌","武则天","四言",["礼崇宗祀，志表严禋。","笙镛合奏，文物维新。","敬遵茂典，敢择良辰。","絜诚斯著，奠谒方申。"],0,96,"唐"],null,["郊庙歌辞 祀九宫贵神乐章 豫和 二","佚名","四言",["黑帝旋驭，青躔导日。","金箓上玄，玉堂初吉。","钩陈夕次，銮和先跸。","蔼蔼群灵，昭昭咸秩。"],0,"x14","唐"],["郊庙歌辞 蜡百神乐章 肃和","佚名","四言",["序迫岁阴，日躔星纪。","爰稽茂典，聿崇清祀。","绮币霞舒，瑞珪虹起。","百禩垂裕，万灵荐祉。"],0,"x14","唐"],["郊庙歌辞 享孔子庙乐章 迎神","佚名","四言",["通吴表圣，问老探真。","三千弟子，五百贤人。","亿龄规法，万载嗣禋。","洁诚以祭，奏乐迎神。"],0,"x14","唐"],["郊庙歌辞 祀九宫贵神乐章 豫和 四","佚名","四言",["夜如何其，明星煌煌。","天清容卫，露结坛场。","树羽幢幢，佩玉锵锵。","凝精驻目，瞻望神光。"],0,"x14","唐"],["郊庙歌辞 梁太庙乐舞辞 送神","佚名","四言",["其降无从，其往无踪。","黍稷非馨，有感必通。","赫奕令德，髣髴睟容。","再拜慌忽，遐想昊穹。"],0,"x14","唐"],["郊庙歌辞 梁太庙乐舞辞 象功舞","佚名","四言",["天地合德，睿圣昭彰。","累赠太傅，俄登魏王。","雄名不朽，奕叶而光。","建国之兆，君临万方。"],0,"x14","唐"],["郊庙歌辞 祀九宫贵神乐章 豫和 三","佚名","四言",["帝临中坛，受厘元神。","皇灵萃止，羽旄肃陈。","摄提运衡，招摇移轮。","光光宇宙，电耀雷震。"],0,"x14","唐"],["郊庙歌辞 祀九宫贵神乐章 豫和 六","佚名","四言",["崇崇泰坛，灵具临兮。","铿锽大乐，振动心兮。","神之降矣，卿云郁兮。","神之至止，清风肃兮。"],0,"x14","唐"],["郊庙歌辞 祀九宫贵神乐章 豫和 五","佚名","四言",["九位既肃，万灵毕会。","天门启扄，日驭飞盖。","焕兮棽离，傧兮暗霭。","如山之福，惟圣时对。"],0,"x14","唐"],["郊庙歌辞 仪坤庙乐章 太和","丘说","四言",["孝哉我后，冲乎迺圣。","道映重华，德辉文命。","慕深视箧，情殷抚镜。","万国移风，兆人承庆。"],0,26,"唐"],["劝世","吕岩","四言",["一毫之善，与人方便。","一毫之恶，劝君莫作。","衣食随缘，自然快乐。","算是甚命，问什么卜。","欺人是祸，饶人是福。","天眼昭昭，报应甚速。","谛听吾言，神钦鬼伏。"],0,176,"唐"],["郊庙歌辞 享太庙乐章 雍和二首 其二","张说","四言",["俎豆有馥，粢盛絜丰。","亦有和羹，既戒既平。","鼓钟管磬，肃唱和鸣。","皇皇后祖，来我思成。"],0,133,"唐"],["诗品二十四则 超诣","司空图","四言",["匪神之灵，匪机之微。","如将白云，清风与归。","远引若至，临之已非。","少有道契，终与俗违。","乱山高木，碧苔芳晖。","诵之思之，其声愈稀。"],0,"x26","唐"],["郊庙歌辞 武后享清庙乐章十首 第三登歌","佚名","四言",["肃敷大礼，上谒尊灵。","敬[陈]筐币，载表丹诚。"],0,"x14","唐"],["郊庙歌辞 武后享清庙乐章十首 第四迎神","佚名","四言",["敬奠苹藻，式罄虔襟。","洁诚斯展，伫降灵歆。"],0,"x14","唐"],["郊庙歌辞 梁太庙乐舞辞 来仪舞","佚名","四言",["于赫帝命，应天顺人。","亭育品汇，宾礼百神。","洪基永固，景命惟新。","肃恭孝享，祚我生民。"],0,"x14","唐"],null,["郊庙歌辞 襃德庙乐章 彰德","佚名","四言",["名隆五岳，秩映三台。","严祠已备，[睟]影方回。"],0,"x14","唐"],["道藏歌诗 十四","佚名","四言",["推校千精，热馘雷震。","五帝秉钺，神公吐烟。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 升和","佚名","四言",["顾惟菲薄，纂历应期。","中外同轨，夷狄来思。","乐用崇德，礼以陈词。","夕惕若厉，钦奉弘基。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 崇德舞","张说","四言",["皇合一德，朝宗百神。","削平天地，大拯生人。","上帝配食，单于入臣。","戎歌陈舞，晔晔震震。"],0,133,"唐"],["郊庙歌辞 太清宫乐章 煌煌","佚名","四言",["煌煌道宫，肃肃太清。","礼光尊祖，乐备充庭。","罄竭诚至，希夷降灵。","云凝翠盖，风燄红旌。","众真以从，九奏初迎。","永惟休祐，是锡和平。"],0,"x14","唐"],["郊庙歌辞 蜡百神乐章 送神","佚名","四言",["十旬欢洽，一日祠终。","澄彝拂俎，报德酬功。","虑虔容肃，礼缛仪丰。","神其降祉，整驭随风。"],0,"x14","唐"],["二风诗   二","元结","四言",["至哉俭德，不丰不敷。","谁能颂之，我请颂夫。","於戏劳王，俭亦何深。","戒尔万代，奢侈荒淫。"],0,63,"唐"],["二风诗   二","元结","四言",["嘻乎乱王，王心何思。","暴淫虐惑，无思不为。","生人冤怨，言何极之。"],0,63,"唐"],["郊庙歌辞 武后享清庙乐章十首 第六送文舞","佚名","四言",["帝图草创，皇业初开。","功高佐命，业赞云雷。"],0,"x14","唐"],["郊庙歌辞 武后享清庙乐章十首 第十送神","佚名","四言",["大礼言毕，仙卫将归。","莫申丹恳，空瞻紫微。"],0,"x14","唐"],["南郊文武出入舒和之乐","张九龄","四言",["祝史辞正，人神庆叶。","福以德昭，享以诚接。","六变云备，百礼斯浃。","祀事孔明，祚流万叶。"],0,188,"唐"],["郊庙歌辞 五郊乐章 黄帝宫音 肃和","魏征","四言",["眇眇方舆，苍苍圜盖。","至哉枢纽，宅中图大。","气调四序，风和万籁。","祚我明德，时雍道泰。"],0,152,"唐"],["上崔相百忧章","李白","四言",["共公赫怒，天维中摧。","鲲鲸喷荡，扬涛起雷。","鱼龙陷人，成此祸胎。","火焚昆山，玉石相磓。","仰希霖雨，洒宝炎煨。","箭发石开，戈挥日回。","邹衍恸哭，燕霜飒来。","微诚不感，犹絷夏台。","苍鹰搏攫，丹棘崔嵬。","豪圣凋枯，王风伤哀。","斯文未丧，东岳岂颓。","穆逃楚难，邹脱吴灾。","见机苦迟，二公所咍。","骥不骤进，麟何来哉。","星离一门，草掷二孩。","万愤结习，忧从中催。","金瑟玉壶，尽为愁媒。","举酒太息，泣血盈桮。","台星再朗，天纲重恢。","屈法申恩，弃瑕取材。","冶长非罪，尼父无猜。","覆盆傥举，应照寒灰。"],0,"x3","唐"],null,["郊庙歌辞 祭方丘乐章 肃和","褚亮","四言",["至矣坤德，皇哉地祇。","开元统纽，合大承规。","九宫肃列，六典相仪。","永言配命，长保无亏。"],0,150,"唐"],["郊庙歌辞 享太庙乐章 崇德舞","佚名","四言",["五运改卜，千龄启圣。","彤云晓聚，黄星夜映。","叶阐珠囊，基开玉镜。","下临万宇，上齐七政。","雾开三象，尘清九服。","海溓星晖，远安迩肃。","天地交泰，华夷辑睦。","翔泳归仁，中外禔福。","绩逾黜夏，勋高翦商。","武陈七德，刑设三章。","祥禽巢阁，仁兽游梁。","卜年惟永，景福无疆。"],0,"x14","唐"],["郊庙歌辞 享懿德太子庙乐章 登歌酌鬯","佚名","四言",["誉阐元储，寄崇明两。","玉裕虽晦，铜楼可想。","弦诵辍音，笙歌罢响。","币帛言设，礼容无爽。"],0,"x14","唐"],["郊庙歌辞 襃德庙乐章 进德","佚名","四言",["涂山懿戚，妫汭崇姻。","祠筵肇启，祭典方申。","礼以备物，乐以感神。","用隆敦敍，载穆彝伦。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 大成舞","张说","四言",["帝舞季历，龙圣生昌。","后歌有𫊸，胎炎孕黄。","天地合德，日月齐光。","肃雍孝享，祚我万方。"],0,133,"唐"],["郊庙歌辞 祭大社乐章 迎神","佚名","四言",["烈山有子，后土有臣。","播种百谷，济育兆人。","春官缉礼，宗伯司禋。","戊为吉日，迎享兹辰。"],0,"x14","唐"],["郊庙歌辞 五郊乐章 赤帝徵音 肃和","魏征","四言",["离位克明，火中宵见。","峰云暮起，景风晨扇。","木槿初荣，含桃可荐。","芬馥百品，铿锵三变。"],0,152,"唐"],["郊庙歌辞 享章怀太子庙乐章 登歌酌鬯","佚名","四言",["忠孝本著，羽翼先成。","寝门昭德，驰道为程。","币帛有典，容卫无声。","司存既肃，庙享惟清。"],0,"x14","唐"],["太和 寿和","贺知章","四言",["惟以明发，有怀载殷。","乐盈而反，礼顺其禋。","立清以献，荐欲是亲。","於穆不已，裒对斯臻。"],0,210,"唐"],["郊庙歌辞 祭神州乐章 送神","佚名","四言",["神州阴祀，洪恩广济。","草树沾和，飞沈沐惠。","礼修鼎俎，奠歆瑶币。","送乐有章，灵轩其逝。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 景云舞","张说","四言",["景云霏烂，告我帝符。","噫帝冲德，与天为徒。","笙镛遥远，俎豆虚无。","春秋孝献，回复此都。"],0,133,"唐"],["郊庙歌辞 武后明堂乐章 皇嗣出入升降","武则天","四言",["至人光俗，大孝通神。","谦以表性，恭惟立身。","洪规载启，茂典方陈。","誉隆三善，祥开万春。"],0,96,"唐"],["郊庙歌辞 享太庙乐章 送神","佚名","四言",["五声备奏，三献终祠。","车移凤辇，斾转虹旗。","礼周笾豆，诚效虔祗。","皇灵徙跸，簪绅拜辞。"],0,"x14","唐"],["郓州谿堂诗","韩愈","四言",["帝奠九廛，有叶有年。","有荒不条，河岱之间。","及我宪考，一收正之。","视邦选侯，以公来尸。","公来尸之，人始未信。","公不饮食，以训以徇。","孰饥无食，孰呻孰叹。","孰冤不问，不得分愿。","孰为邦蟊，节根之螟。","羊很狼贪，以口覆城。","吹之喣之，摩手拊之。","箴之石之，膊而磔之。","凡公四封，既富以彊。","谓公吾父，孰违公令。","可以师征，不宁守邦。","公作谿堂，播播流水。","浅有蒲莲，深有葭苇。","公以宾燕，其鼓骇骇。","公燕谿堂，宾校醉饱。","流有跳鱼，岸有集鸟。","既歌以舞，其鼓考考。","公在谿堂，公御琴瑟。","公暨宾赞，稽经诹律。","施用不差，人用不屈。","谿有薲苽，有龟有鱼。","公在中流，右诗左书。","无我斁遗，此邦是庥。"],0,"x19","唐"],["郊庙歌辞 武后大享昊天乐章 十","佚名","四言",["肃肃祀典，邕邕礼秩。","三献已周，九成斯毕。","爰撤其俎，载迁其实。","或升或降，唯诚唯质。"],0,"x14","唐"],["郊庙歌辞 封泰山乐章 寿和","张说","四言",["烝烝我后，享献惟寅。","躬酌郁鬯，跪奠明神。","孝莫孝乎，配上帝亲。","敬莫敬乎，教天下臣。"],0,133,"唐"],["郊庙歌辞 封泰山乐章 寿和","张说","四言",["皇祖严配，配享皇天。","皇皇降嘏，天子万年。"],0,133,"唐"],["郊庙歌辞 武后大享昊天乐章 十一","佚名","四言",["礼终肆类，乐阕九成。","仰惟明德，敢荐非馨。","顾慙菲奠，久驻云𫐌。","瞻荷灵泽，悚恋兼盈。"],0,"x14","唐"],["唐封泰山乐章 豫和六首 其五","张说","四言",["天道无亲，至诚与邻。","山川遍礼，宫征维新。","玉帛非盛，聪明会真。","正斯一德，通乎百神。"],0,133,"唐"],["唐封泰山乐章 豫和六首 其六","张说","四言",["享帝享亲，维孝维圣。","缉熙懿德，敷扬成命。","华夷志同，笙镛礼盛。","明灵降止，感此诚敬。"],0,133,"唐"],["郊庙歌辞 五郊乐章 白帝商音 肃和","魏征","四言",["金行在节，素灵居正。","气肃霜严，林雕草劲。","豺祭隼击，潦收川镜。","九谷已登，万箱流咏。"],0,152,"唐"],["郊庙歌辞 享太庙乐章 惟新舞","刘晏","四言",["汉祚惟永，神功中兴。","夙驱氛祲，天覆黎蒸。","三光再朗，庶绩其凝。","重熙累叶，景命是膺。"],0,94,"唐"],["郊庙歌辞 昭德皇后庙乐章 坤元","佚名","四言",["於穆先后，丽圣称崇。","母临万宇，道[被]六宫。","昌时协庆，理内成功。","殷荐明德，传芳国风。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 迎神","佚名","四言",["七庙观德，百灵攸仰。","俗荷财成，物资含养。","道光执契，化笼提象。","肃肃雍雍，神其来飨。"],0,"x14","唐"],["郊庙歌辞 善胜舞 禋顺","佚名","四言",["礼毕祀先，香散几筵。","罢舞干戚，收撤豆笾。"],0,"x14","唐"],null,null,["郊庙歌辞 太清宫乐章 终上","佚名","四言",["不宰元功，无为上圣。","洪源长发，诞受天命。","金奏迎真，璇宫展盛。","备礼周乐，垂光储庆。"],0,"x14","唐"],["郊庙歌辞 周郊祀乐章 禋顺乐","佚名","四言",["黄彝将献，特牲预迎。","既修昭事，潜达明诚。"],0,"x14","唐"],null,["郊庙歌辞 享太庙乐章 肃和","佚名","四言",["月礼已周，云和将变。","爰献其醑，载迁其奠。","明德逾隆，非馨是荐。","泽沾动植，仁覃宇县。"],0,"x14","唐"],["郊庙歌辞 明皇祀圜丘乐章 太和","佚名","四言",["郊坛斋帝，礼乐祀天。","丹青寰宇，宫征山川。","神祇毕降，行止重旋。","融融穆穆，纳祉洪延。"],0,"x14","唐"],["郊庙歌辞 明皇祀圜丘乐章 太和","佚名","四言",["六成既阕，三荐云终。","神心具醉，圣敬愈崇。","受厘皇邸，回跸帷宫。","穰穰之福，永永无穷。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 光大舞","张说","四言",["肃肃艺祖，滔滔浚源。","有雄玉剑，作镇金门。","玄王贻绪，后稷谋孙。","肇禋九庙，四海来尊。"],0,133,"唐"],["郊庙歌辞 享太庙乐章 钧天舞","张说","四言",["高皇迈道，端拱无为。","化怀獯鬻，兵赋句骊。","礼尊封禅，乐盛来仪。","合位娲后，同称伏羲。"],0,133,"唐"],["庆云章","陈子昂","四言",["昆仑元气，实生庆云。","大人作矣，五色氤氲。","昔在帝妫，南风既薰。","丛芳烂熳，郁郁纷纷。","旷矣千祀，庆云来止。","玉叶金柯，祚我天子。","非我天子，庆云谁昌。","非我圣母，庆云谁光。","庆云光矣，周道昌矣。","九万八千，天授皇年。"],0,80,"唐"],["郊庙歌辞 享太庙乐章 大明舞","张说","四言",["赤精乱德，四海困穷。","黄旗举义，三灵会同。","旱望春雨，云披大风。","溥天来祭，高祖之功。"],0,133,"唐"],["郊庙歌辞 享太庙乐章 凯安三首 其一","张说","四言",["瑟彼瑶爵，亚维上公。","室如屏气，门不容躬。","礼殷其本，乐执其中。","圣皇永慕，天地幽通。"],0,133,"唐"],["郊庙歌辞 仪坤庙乐章 其二 送神","佚名","四言",["玉帛仪大，金丝奏广。","灵应有孚，冥征不爽。","降彼休福，歆兹禋享。","送乐有章，神麾其上。"],0,"x14","唐"],["郊庙歌辞 梁郊祀乐章 庆平","赵光逢、张衮","四言",["天命降鉴，帝德惟馨。","享祀不忒，礼容孔明。","奠璧布币，荐神献精。","神佑以答，敷锡永宁。"],0,0,"唐"],["郊庙歌辞 祭汾阴乐章 南吕羽","韩休","四言",["於穆濬哲，维清缉熙。","肃事昭配，永言孝思。","涤濯静嘉，馨香在兹。","神之听之，用受福厘。"],0,62,"唐"],["郊庙歌辞 享太庙乐章 景云舞","佚名","四言",["惟睿作圣，惟圣登皇。","精感耀魄，时膺会昌。","舜慙大孝，尧推让王。","能事斯极，振古谁方。","文明履运，车书同轨。","巍巍赫赫，尽善尽美。","衢室凝旒，大庭端扆。","释负之寄，事光复子。","脱屣高天，登遐上玄。","龙湖超忽，象野芊绵。","游衣复道，荐果初年。","新庙奕奕，明德配天。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 和宁舞","牛僧孺","四言",["湜湜颀颀，融昭德辉。","不纽不舒，贯成九围。","武烈文经，敷施当宜。","纂尧付启，亿万熙熙。"],0,164,"唐"],["郊庙歌辞 仪坤庙乐章 其一 迎神","佚名","四言",["月灵降德，坤元授光。","娥英比秀，任姒均芳。","瑶台荐祉，金屋延祥。","迎神有乐，歆此嘉芗。"],0,"x14","唐"],null,["郊庙歌辞 享太庙乐章 延和","佚名","四言",["巍巍累圣，穆穆重光。","奄有区夏，祚启隆唐。","百蛮饮泽，万国来王。","本枝亿载，鼎祚逾长。"],0,"x14","唐"],["郊庙歌辞 梁太庙乐舞辞 昭德舞","佚名","四言",["肃肃文考，源濬派长。","汉称诞季，周实生昌。","奄有四海，超彼百王。","笙镛迭奏，礼物荧煌。"],0,"x14","唐"],["诗品二十四则 纤秾","司空图","四言",["采采流水，蓬蓬远春。","窈窕深谷，时见美人。","碧桃满树，风日水滨。","柳阴路曲，流莺比邻。","乘之愈往，识之愈真。","如将不尽，与古为新。"],0,"x26","唐"],["郊庙歌辞 享太庙乐章 太和","张说","四言",["时文圣后，清庙肃邕。","致诚勤荐，在貌思恭。","玉节肆夏，金锵五钟。","绳绳云步，穆穆天容。"],0,133,"唐"],["郊庙歌辞 梁太庙乐舞辞 大合舞","佚名","四言",["於穆皇祖，濬哲雍熙。","美溢中夏，化被南陲。","后稷累德，公刘创基。","肇兴九庙，乐合来仪。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 恭和","佚名","四言",["礼周三献，乐阕九成。","肃承灵福，悚惕兼盈。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 肃和","张说","四言",["天子享孝，工歌溥将。","躬祼郁鬯，乃焚膋芗。","臭以达阴，声以求阳。","奉时烝尝，永代不忘。"],0,133,"唐"],["郊庙歌辞 享太庙乐章 诚敬","佚名","四言",["顾惟菲质，忝位椒宫。","虔奉苹藻，肃事神宗。","敢申诚絜，庶罄深衷。","睟容有裕，灵享无穷。"],0,"x14","唐"],["郊庙歌辞 明皇祀圜丘乐章 舒和","佚名","四言",["祝史正辞，人神叶庆。","福以德招，享以诚应。","六变云备，百礼斯浃。","祀事孔明，祚流万叶。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 严和","佚名","四言",["肃肃清庙，赫赫玄猷。","功高万古，化奄十洲。","中兴丕业，上荷天休。","祗奉先构，礼备怀柔。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 广运舞","郭子仪","四言",["于赫皇祖，昭明有融。","惟文之德，惟武之功。","河海静谧，车书混同。","虔恭孝飨，穆穆玄风。"],0,201,"唐"],["郊庙歌辞 享惠昭太子庙乐章 请神","归登","四言",["嘉荐既陈，祀事孔明。","闲歌在堂，万舞在庭。","外则尽物，内则尽诚。","凤笙如闻，歌其洁精。"],0,40,"唐"],["郊庙歌辞 让皇帝庙乐章 酌献","李纾","四言",["八音具举，三寿既盥。","洁兹宗彝，瑟彼圭瓒。","兰肴重错，椒醑飘散。","降祚维城，永为藩翰。"],0,255,"唐"],["还丹歌 十二","杨行真人","四言",["世上求道，酒肉愚痴。","百年欲过，颙颙不知。","金公制伏，还丹一支。","朱砂伏火，治病无疑。","长生有望，坚固无疑。","不衰不老，彭祖同时。"],0,50,"唐"],["补周礼九夏系文   一","皮日休","四言",["爣爣皎日，歘丽于天。","厥明御舒，如王出焉。"],0,"x15","唐"],["补周礼九夏系文   一","皮日休","四言",["愔愔清庙，仪仪象服。","我尸出矣，迎神之谷。"],0,"x15","唐"],["补周礼九夏系文   一","皮日休","四言",["有郁其鬯，有俨其彝。","九变未作，全乘来之。"],0,"x15","唐"],["补周礼九夏系文   一","皮日休","四言",["麟之仪仪，不絷不维。","乐德而至，如宾之嬉。"],0,"x15","唐"],["补周礼九夏系文   一","皮日休","四言",["王有虎臣，锡之𫓧钺。","征彼不憓，一扑而灭。"],0,"x15","唐"],["补周礼九夏系文   一","皮日休","四言",["洪源谁孕，疏为江河。","大块孰埏，播为山阿。"],0,"x15","唐"],["补周礼九夏系文   一","皮日休","四言",["礼酒既酌，嘉宾既厚，牍为之奏。"],0,"x15","唐"],["补周礼九夏系文   一","皮日休","四言",["桓桓其珪，衮衮其衣。","出作二伯，天子是毗。"],0,"x15","唐"],["郊庙歌辞 享太庙乐章 虔和","佚名","四言",["礼标荐鬯，肃事祠庭。","敬申如在，敢托非馨。"],0,"x14","唐"],null,null,["郊庙歌辞 朝日乐章 迎神","佚名","四言",["太阳朝序，王宫有仪。","蟠桃彩驾，细柳光驰。","轩祥表合，汉历彰奇。","礼和乐备，神其降斯。"],0,"x14","唐"],["补周礼九夏系文   四","皮日休","四言",["出有嘉谋，入有内则。","繄彼臣庶，钦王之式。"],0,"x15","唐"],["补周礼九夏系文   四","皮日休","四言",["我牢不愆，我货不匮。","硕硕其才，有乐而止。"],0,"x15","唐"],["补周礼九夏系文   四","皮日休","四言",["何以乐之，金石九奏。","何以锡之，龙旗九旒。"],0,"x15","唐"],["郊庙歌辞 祭大社乐章 送神","佚名","四言",["吉祥式就，酬功载毕。","亲地尊天，礼文经术。","贶征令序，福流初日。","神驭爰归，祠官其出。"],0,"x14","唐"],["郊庙歌辞 祀圜丘乐章 太和","褚亮","四言",["穆穆我后，道应千龄。","登三处大，得一居贞。","礼惟崇德，乐以和声。","百神仰止，天下文明。"],0,150,"唐"],["郊庙歌辞 享太庙乐章 长发舞","张说","四言",["具礼崇德，备乐承风。","魏推幢主，周赠司空。","不行而至，无成有终。","神兴王业，天归帝功。"],0,133,"唐"],["汉堤诗","卢肇","四言",["阴沴奸阳，来暴于襄。","洎入大郛，波端若铓。","触厚摧高，不知其防。","骇溃颠委，万室皆毁。","灶登蛟鼍，堂集鳣鲔。","惟恩若雠，母不能子。","洪溃既涸，闬闳其虚。","以隳我堵，以剥我庐。","酸伤顾望，若践丘墟。","帝曰念嗟，朕日南顾。","流灾降慝，天曷台怒。","滔滔襄郊，捽我婴孺。","于惟馀氓，饥伤喘呼。","斯为淫痍，孰往膏傅。","惟汝元寮，佥举明哲。","我公用谐，苴茅杖节。","来视襄人，喔咻提挈。","不日不月，咍乎抃悦。","乃泳故堤，陷于沙泥。","缺落坳圯，由东讫西。","公曰呜呼，汉之有堤。","实命襄人，不力乃力，则及乃身。","具锸与畚，汉堤其新。","帝廪有粟，帝府有缗。","尔成尔堤，必锡尔勤。","襄人怡怡，听命襄浒。","背襄肩杵，奔走蹈舞。","分之卒伍，令以麾鼓。","寻尺既度，日月可数。","登登嶪嶪，周旋上下。","披岘斲楚，飞石挽土。","举筑殷雷，骇汗霏雨。","疲癃鳏独，奋有筋膂。","呀吁来助，提筐负筥。","不劳其劳，杂沓笑语。","咸曰卢公，来赐我生。","斯堤既成，蜿蜿而平。","确尔山固，屹如云横。","汉流虽狂，坚不可蚀。","代千年亿，与天无极。","惟公之堤，昔在人心。","既筑既城，横之于南。","萌渚不峻，此门不深。","今复在兹，于汉之阴。","斯堤已崇，兹民获祐。","𫠜童相庆，室以完富。","贻于襄人，愿保厥寿。","繄公之功，赫焉如昼。","捍此巨灾，崒若京阜。","天子赐之，百姓载之。","族孙作诗，昭示厥后。"],0,177,"唐"],null,["郊庙歌辞 祭方丘乐章 雍和","褚亮","四言",["柔而能方，直而能敬。","载厚以德，大亨以正。","有涤斯牷，有馨斯盛。","介兹景福，祚我休庆。"],0,150,"唐"],["郊庙歌辞 享太庙乐章 大政舞","张说","四言",["于赫元命，权舆帝文。","天齐八柱，地半三分。","宗庙观德，笙镛乐勋。","封唐之兆，成天下君。"],0,133,"唐"],["郊庙歌辞 享太庙乐章 承光舞","佚名","四言",["金相载穆，玉裕重辉。","养德清禁，承光紫微。","干宫候色，震象增威。","监国方永，宾天不归。","孝友自衷，温文性与。","龙楼正启，鹤驾斯举。","丹扆流念，鸿名式序。","中兴考室，永陈彝俎。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 歆和","佚名","四言",["崇禋已备，粢盛聿修。","洁诚斯展，钟石方遒。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 雍和二章 其一","张说","四言",["在涤嘉豢，丽碑敬牲。","角握之牡，色纯之骍。","火传阳燧，水溉阴精。","太公胖俎，傅说和羹。"],0,133,"唐"],["补周礼九夏系文   三","皮日休","四言",["出有龙旗，入有珩佩。","勿驱勿驰，惟慎惟戒。"],0,"x15","唐"],["补周礼九夏系文   三","皮日休","四言",["自筐及筥，我有牢醑。","自筐及篚，我有货币。"],0,"x15","唐"],["补周礼九夏系文   三","皮日休","四言",["王有掌讶，遉尔疆理。","王有掌客，馈尔饔饩。"],0,"x15","唐"],["补周礼九夏系文   三","皮日休","四言",["礼酒既罄，嘉宾既醒，雅为之行。"],0,"x15","唐"],["补周礼九夏系文","皮日休","四言",["㻏㻏衡笄，翚衣褕翟。","自内而祭，为君之则。"],0,"x15","唐"],null,["郊庙歌辞 封泰山乐章 肃和","张说","四言",["奠祖配天，承天享帝。","百灵咸秩，四海来祭。","植我苍璧，布我玄制。","华日裴回，神烟容裔。"],0,133,"唐"],["郊庙歌辞 五郊乐章 黄帝宫音","魏征","四言",["黄中正位，含章居贞。","既长六律，兼和五声。","毕陈万舞，乃荐斯牲。","神其下降，永祚休平。"],0,152,"唐"],["郊庙歌辞 享隐太子庙乐章 雍和","佚名","四言",["明典肃陈，神居邃启。","春伯联事，秋官相礼。","有来雍雍，登歌济济。","缅维主鬯，庶歆芳醴。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 昭感","佚名","四言",["铿锵韶濩，肃穆神容。","洪规赫赫，祠典雍雍。","已周三献，将乘六龙。","虔诚有托，恳志无从。"],0,"x14","唐"],["倬彼我系 其一","王勃","四言",["倬彼我系，出自有周。","分疆锡社，派别支流。","居衞仕宋，臣嬴相刘。","廼武廼文，或公或侯。"],0,239,"唐"],["倬彼我系 其二","王勃","四言",["晋历崩坼，衣冠扰弊。","粤自太原，播徂江澨。","礼丧贤隐，时屯道闭。","王室如毁，生人多殪。"],0,239,"唐"],["倬彼我系 其四","王勃","四言",["伊我祖德，思济九埏。","不常厥所，于兹五迁。","欲及时也，夫岂愿焉。","其位虽屈，其言则传。"],0,239,"唐"],["倬彼我系 其六","王勃","四言",["伊余小子，信慙明哲。","彼网有条，彼车有辙。","思屏人事，克终前烈。","于嗟代网，卒余来絏。"],0,239,"唐"],["倬彼我系 其七","王勃","四言",["来絏伊何，谓余曰仕。","我瞻先达，三十方起。","夫岂不怀，高山仰止。","愿言毓德，啜菽饮水。"],0,239,"唐"],null,["还丹歌 七","杨行真人","四言",["铅汞二阴，还丹之心。","相制不难，人迷不寻。","学者不见，徒费千金。","堪得指教，作福拯贫。","如斯之用，天人不嗔。","非道破除，天之大怒。","恶病加之，遭官刑狱。"],0,50,"唐"],["郊庙歌辞 祭汾阴乐章 雍和","贾曾","四言",["蠲我饎餴，絜我膋芗。","有豆孔硕，为羞既臧。","至诚无昧，精意惟芳。","神其醉止，欣欣乐康。"],0,159,"唐"],["还丹歌 九","杨行真人","四言",["丹砂丹砂，济命济家。","能济我命，能济我家。","能生姹女，嫁与黄芽。","事夫洁素，无喜无怒。","礼乐周旋，晨昏节度。","金亦可作，世亦可度。","作今不成，徒然自悮。"],0,50,"唐"],["郊庙歌辞 享太庙乐章 肃和","魏征","四言",["大哉至德，允兹明圣。","格于上下，聿遵诚敬。","嘉乐斯登，鸣球以咏。","神其降止，式隆景命。"],0,152,"唐"],["上古之什补亡训传十三章 左车二章之一 其二","顾况","四言",["左车有庆，万人犹病。","曷可去之，于党孔盛。","敏尔之生，胡为波迸。"],0,191,"唐"],["郊庙歌辞 祭[太]社乐章 肃和","褚亮","四言",["后土凝德，神功协契。","九域底平，两仪交际。","戊期应序，阴墉展币。","灵车少留，俯歆樽桂。"],0,150,"唐"],["上古之什补亡训传十三章 左车二章之二 其三","顾况","四言",["左车有赫，万人毒螫。","曷可去之，于党孔硕。","敏尔之生，胡为草戚。"],0,191,"唐"],["郊庙歌辞 享太庙乐章 保大舞","郭子仪","四言",["于穆文考，圣神昭章。","肃勺群慝，含光远方。","万物茂遂，九夷宾王。","愔愔云韶，德音不忘。"],0,201,"唐"],["还丹歌 十五","杨行真人","四言",["能知少女，必定还精。","能伏朱儿，必定坚贞。","金精石髓，是魂之灵。","能修者圣，能伏者灵。","鬼官不追，仙籍有名。","。"],0,50,"唐"],["郊庙歌辞 禅社首乐章 肃和","贺知章、源乾曜","四言",["黄祇是[祗]，我其夙夜。","寅畏诚絜，匪遑宁舍。","礼以琮玉，荐厥茅藉。","念兹降康，胡宁克暇。"],0,126,"唐"],["郊庙歌辞 五郊乐章 黑帝羽音 肃和","魏征","四言",["律回玉琯，星周金度。","次极阳乌，纪穷阴兔。","火林霰雪，阳泉凝冱。","八蜡已登，三农息务。"],0,152,"唐"],null,["郊庙歌辞 五郊乐章 黑帝羽音 雍和","魏征","四言",["阳月斯纪，应钟在候。","载洁牲牷，爰登俎豆。","既高既远，无声无臭。","静言格思，惟神保祐。"],0,152,"唐"],["郊庙歌辞 周朝飨乐章 治顺","佚名","四言",["庭陈大乐，作当太微。","凝旒负扆，端拱垂衣。","鸳鸾成列，簪组相辉。","御炉香散，郁郁霏霏。"],0,"x14","唐"],["上古之什补亡训传十三章","顾况","四言",["我行自东，山海其空。","旅棘有丛，我行自西。","垒与云齐，雨雪凄凄。","我行自南，烈火满林。","日中无禽，雾雨淫淫。","我行自北，烛龙寡色。"],0,191,"唐"],["郊庙歌辞 朝日乐章 送神","佚名","四言",["五齐兼酌，百羞具陈。","乐终广奏，礼毕崇禋。","明鉴万宇，照临兆人。","永流洪庆，式动曦轮。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 通和","佚名","四言",["祠容既毕，仙座爰兴。","停停凤举，霭霭云升。","长隆宝运，永锡休征。","福覃贻厥，恩被黎蒸。"],0,"x14","唐"],["郊庙歌辞  懿宗室舞","萧倣","四言",["圣祚无疆，庆传乐章。","金枝繁茂，玉叶延长。","海渎常[晏]，波涛不扬。","汪汪美化，垂范今王。"],0,180,"唐"],null,["郊庙歌辞 享文敬太子庙乐章 请神","许孟容","四言",["觞牢具品，管磬有节。","祝道夤恭，神仪昭晰。","桐圭早贵，象辂追设。","声达乐成，降歆丰洁。"],0,203,"唐"],["郊庙歌辞 昭德皇后庙乐章 雍和","佚名","四言",["我将我享，尽明而诚。","载芬黍稷，载涤牺牲。","懿矣元良，万邦以贞。","心乎爱敬，若覩容声。"],0,"x14","唐"],["郊庙歌辞 昭德皇后庙乐章 雍和","佚名","四言",["公尸既起，享礼载终。","称歌进彻，尽敬繇衷。","泽流惠下，大小咸同。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 文舞","张说","四言",["圣谟九德，真言五千。","庆集昌胄，符开帝先。","高文杖钺，克配彼天。","三宗握镜，六合涣然。","帝其承祀，率礼罔愆。","图书雾出，日月清悬。","舞形德类，咏谂功传。","黄龙蜿蟺，彩云蹁跹。","五行气顺，八佾风宣。","介此百禄，于皇万年。"],0,133,"唐"],["郊庙歌辞 五郊乐章 青帝角音 肃和","魏征","四言",["玄鸟司春，苍龙登岁。","节物变柳，光风转蕙。","瑶席降神，朱弦飨帝。","诚备祝嘏，礼殚珪币。"],0,152,"唐"],["郊庙歌辞 蜡百神乐章 雍和","佚名","四言",["缇籥劲序，玄英晚候。","姬蜡开仪，豳歌入奏。","蕙馥雕俎，兰芬玉酎。","大享明祇，永绥多祐。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 大和舞","张说","四言",["退居江水，郁起丹陵。","礼物还旧，朝章中兴。","龙图友及，骏命恭膺。","鸣球香瓒，大糦是承。"],0,133,"唐"],["郊庙歌辞 禅社首乐章 其三 肃和","贺知章","四言",["黄祇是祗，我其夙夜。","夤畏诚絜，匪遑宁舍。","礼以琮玉，荐厥茅藉。","念兹降康，胡宁克暇。"],0,210,"唐"],null,["补周礼九夏系文   二","皮日休","四言",["爣爣皎日，歘入于地。","厥晦厥贞，如王入焉。"],0,"x15","唐"],["补周礼九夏系文   二","皮日休","四言",["杳杳阴竹，坎坎路鼓。","我尸入矣，得神之祜。"],0,"x15","唐"],["补周礼九夏系文   二","皮日休","四言",["既醑既酢，爰朄爰舞。","象物既降，全乘之去。"],0,"x15","唐"],["补周礼九夏系文   二","皮日休","四言",["凤之愉愉，不篝不笯。","乐德而至，如宾之娱。"],0,"x15","唐"],["补周礼九夏系文   二","皮日休","四言",["王有虎臣，锡之圭瓒。","征彼不享，一烘而泮。"],0,"x15","唐"],["补周礼九夏系文   二","皮日休","四言",["厥流浩漾，厥势嵯峨。","今君之酌，慰我实多。"],0,"x15","唐"],["补周礼九夏系文   二","皮日休","四言",["礼酒既竭，嘉宾既悦，应为之节。"],0,"x15","唐"],["补周礼九夏系文   二","皮日休","四言",["桓桓其珪，衮衮其服。","入作三孤，国人是福。"],0,"x15","唐"],null,["郊庙歌辞 五郊乐章 赤帝徵音 雍和","魏征","四言",["昭昭丹陆，奕奕炎方。","礼陈牲币，乐备篪簧。","琼羞溢俎，玉醑浮觞。","恭惟正直，歆此馨香。"],0,152,"唐"],["郊庙歌辞 祀雨师乐章 迎俎酌献","包佶","四言",["阳开幽蛰，躬奉郁鬯。","礼备节应，震来灵降。","动植求声，飞沈允望。","时康气茂，惟神之贶。"],0,30,"唐"],["郊庙歌辞 享太庙乐章 光大舞","佚名","四言",["大业龙祉，徽音骏尊。","潜居皇德，赫嗣天昆。","展仪宗祖，重诚孝孙。","春秋无极，享奏存存。"],0,"x14","唐"],null,null,["郊庙歌辞 五郊乐章 白帝商音 雍和","魏征","四言",["律应西成，气躔南吕。","珪币咸列，笙竽备举。","苾苾兰羞，芬芬桂醑。","式资宴贶，用调霜序。"],0,152,"唐"],null,["郊庙歌辞 祀风师乐章 迎神","包佶","四言",["太皞御气，句芒肇功。","苍龙青旗，爰候祥风。","律以和应，神以感通。","鼎俎修蚃，时惟礼崇。"],0,30,"唐"],["乐府杂曲 鼓吹铙歌曲十二篇 其九 靖本邦","柳宗元","四言",["本邦伊晋，惟时不靖。","根柢之摇，枝叶攸病。","守臣不任，勚于神圣。","惟钺之兴，翦焉则定。","洪惟我理，式和以敬。","群顽既夷，庶绩咸正。","皇谟载大，惟人之庆。"],0,143,"唐"],["五郊乐章 赤帝徵音 雍和","魏征","四言",["昭昭丹陆，帟帟炎方。","礼陈牲币，乐备箎簧。","琼羞溢俎，玉𨠨浮觞。","恭惟正直，歆此馨香。"],0,152,"唐"],["咏方圆动静","李泌","四言",["方如行义，圆如用智。","动如逞才，静如遂意。"],0,172,"唐"],["郊庙歌辞 祀雨师乐章 迎神","包佶","四言",["陟降左右，诚达幽圜。","作解之功，乐惟有年。","云𫐌戾止，洒雾飘烟。","惟馨展礼，爰列豆笾。"],0,30,"唐"],null,null,null,["倬彼我系 其八","王勃","四言",["有鸟反哺，其声嗷嗷。","言念旧德，忧心忉忉。","今我不养，岁月其滔。","僶俛从役，岂敢告劳。"],0,239,"唐"],null,["倬彼我系 其三","王勃","四言",["伊我有器，思逢其主。","自东施西，择木开宇。","田彼河曲，家乎汾浦。","天未厌乱，吾将谁辅。"],0,239,"唐"],["郊庙歌辞 明皇祀圜丘乐章 雍和","佚名","四言",["烂云普洽，律风无外。","千品其凝，九宾斯会。","禋尊晋烛，纯牺涤汰。","玄覆攸广，鸿休汪濊。"],0,"x14","唐"],["江有枫一篇十章 三","萧颖士","四言",["想彼槭矣，亦类其枫。","矧伊怀人，而忘其东。"],0,199,"唐"],["郊庙歌辞 享先农乐章 雍和","褚亮","四言",["前夕视牲，质明奉俎。","沐芳整弁，其仪式序。","盛礼毕陈，嘉乐备举。","歆我懿德，非馨稷黍。"],0,150,"唐"],["江有枫一篇十章 九","萧颖士","四言",["有鸟有鸟，粤鸥与鹭。","浮湍戏渚，皓然洁素。","忘其猜妒，彼何人斯，曾足伤惧。"],0,199,"唐"],["江有枫一篇十章 六","萧颖士","四言",["我朋在矣，彼陆之子。","如松如杞，淑问不已。"],0,199,"唐"],["郊庙歌辞 仪坤庙乐章 寿和","徐坚","四言",["于穆清庙，肃雍严祀。","合福受厘，介以繁祉。"],0,247,"唐"],["倬彼我系 其九","王勃","四言",["从役伊何，薄求卑位。","告劳伊何，来参卿事。","名存实爽，负信愆义。","静言遐思，中心是愧。"],0,239,"唐"],null,["祭汾阴乐章","贾曾","四言",["蠲我渐饎，洁我膋芗。","有豆孔硕，为羞既臧。","至城无昧，精意惟芳。","神其醉止，欣欣乐康。"],0,159,"唐"],["补乐歌十首  一","元结","四言",["猗太帝兮，其智如神。","分草实兮，济我生人。"],0,63,"唐"],["郊庙歌辞 仪坤庙乐章 金奏","佚名","四言",["阴灵曜祉，轩曜降精。","祥符淑气，庆集柔明。","瑶俎既列，雕桐发声。","徽猷永远，比德皇英。"],0,"x14","唐"],["判行营将士申请裹粮","宋光嗣","四言",["才请冬赐，又给行装。","汉州咫尺，要甚裹粮？","绵州物贱，直到益昌。"],0,187,"唐"],["郊庙歌辞 祭汾阴乐章 寿和","苏颋","四言",["礼物斯具，乐章乃陈。","谁其作主，皇考圣真。","对越在天，圣明佐神。","窅然汾上，厚泽如春。"],0,238,"唐"],["江有枫一篇十章 十","萧颖士","四言",["此惧惟何，惧寘于罗。","彼骄者子，谗言孔多。","我闻先师，体命委和。","公伯之愬，则如予何。","怅然山河，惟以啸歌，其忧也哉。"],0,199,"唐"],["郊庙歌辞 祭神州乐章 雍和","褚亮","四言",["泰折严享，阴郊展敬。","礼以导神，乐以和性。","黝牲在列，黄琮俯暎。","九土既平，万邦贻庆。"],0,150,"唐"],["郊庙歌辞 享文敬太子庙乐章 送神","张荐","四言",["三献具举，九旗将旋。","追劳表德，罢享宾天。","风引仙管，堂虚画筵。","芳馨常在，瞻望悠然。"],0,5,"唐"],["补乐歌十首  二","元结","四言",["猗太帝兮，其功如天。","均四时兮，成我丰年。"],0,63,"唐"],["郊庙歌辞 五郊乐章 青帝角音 雍和","魏征","四言",["大乐稀音，至诚简礼。","文物棣棣，声明济济。","六变有成，三登无体。","乃眷丰洁，恩覃恺悌。"],0,152,"唐"],["郊庙歌辞 祭汾阴乐章 顺和","源光裕","四言",["方丘既膳，嘉飨载谧。","齐敬毕诚，陶匏贵质。","秀毕丰荐，芳俎盈实。","永永福流，其升如日。"],0,173,"唐"],["郊庙歌辞 禅社首乐章 雍和","贺知章、源乾曜","四言",["夙夜宥密，不敢宁宴。","五齐既陈，八音在县。","粢盛以洁，房俎斯荐。","惟德惟馨，尚兹克徧。"],0,126,"唐"],["倬彼我系 其五","王勃","四言",["爰述帝制，大搜王道。","曰天曰人，是祖是考。","礼乐咸若，诗书具草。","贻厥孙谋，永为家宝。"],0,239,"唐"],null,["郊庙歌辞 禅社首乐章 太和","贺知章、源乾曜","四言",["肃我成命，于昭黄祇。","裘冕而祀，陟降在斯。","五音克备，八音聿施。","缉熙肆靖，厥心匪离。"],0,126,"唐"],["郊庙歌辞 禅社首乐章 太和","贺知章、源乾曜","四言",["昭昭有唐，天俾万国。","列祖应命，四宗顺则。","申锡无疆，宗我同德。","曾孙继序，享神配极。"],0,126,"唐"],null,["享太庙乐章","萧倣","四言",["于铄丕嗣，惟帝之光。","羽籥象德，金石荐祥。","圣系无极，景命永昌。","神降上哲，维天配长。"],0,180,"唐"],["中和乐九章 歌东军第三","卢照邻","四言",["遐哉庙略，赫矣台臣。","横戈碣石，倚剑浮津。","风丘拂箨，日域清尘。","岛夷复祀，龙伯来宾。","休兵宇县，献馘天𬮱。","旆海凯入，耀辉震震。"],0,250,"唐"],["郊庙歌辞 仪坤庙乐章 雍和","员半千","四言",["孝享云毕，维彻有章。","云感玄羽，风凄素商。","瞻望神座，祗恋匪遑。","礼终乐阕，肃雍锵锵。"],0,219,"唐"],["鹡鸰颂","李隆基","四言",["伊我轩宫，奇树青葱，蔼周庐兮。","冒霜停雪，以茂以悦，恣卷舒兮。","连枝同荣，吐绿含英，曜春初兮。","蓐收御节，寒露微结，气清虚兮。","桂宫兰殿，唯所息宴，栖雍渠兮。","行摇飞鸣，急难有情，情有馀兮。","顾惟德凉，夙夜兢惶，惭化疏兮。","上之所教，下之所效，实在予兮。","天伦之性，鲁卫分政，亲贤居兮。","爰游爰处，爰笑爰语，巡庭除兮。","观此翔禽，以悦我心，良史书兮。"],0,63,"唐"],["郊庙歌辞 祭[太]社乐章 雍和","褚亮","四言",["美报崇本，严恭展事。","受露疎坛，承风启地。","絜粢登俎，醇牺入馈。","介福远流，群生毕遂。"],0,150,"唐"],["江有归舟三章 一","萧颖士","四言",["江有归舟，亦乱其流。","之子言旋，嘉名孔修。","扬于王庭，允焯其休。"],0,199,"唐"],["讲古文联句","皎然","四言",["帝出于震，文明始敷。","山岳降气，龟龙负图。","爰有书契，乃立典谟。","先知孔圣，飞步天衢。","汉承秦弊，尊儒尚学。","百氏六经，九流七略。","屈宋接武，班马继作。","或颂燕然，或赞麟阁。","降及三祖，始变二雅。","仲宣闲和，公干萧洒。","士衡安仁，不史不野。","左张精奥，嵇阮高寡。","暨于江表，其文郁兴。","绮丽争发，繁芜则惩。","词晔春华，思清冬冰。","景纯跌宕，游仙独步。","青云其情，白璧其句。","灵运山水，实多奇趣。","远派孤峰，龙腾凤翥。","陶令田园，匠意真直。","春柳寒松，不凋不饰。","江淹杂体，方见才力。","拟之信工，似而不逼。","鲍昭从军，主意危苦。","气胜其词，雅愧于古。","隐侯似病，创制规矩。","时见琳琅，惜哉榛楛。","谢朓秀发，词理翩翩。","孤标爽迈，深造精研。","惠休翰林，别白离坚。","有会必惬，无惭曩贤。","吴均颇劲，失于典裁。","竟乏波澜，徒工边塞。","彼柳吴兴，高视时辈。","汀洲一篇，风流寡对。","何逊清切，所得必新。","缘情既密，象物又真。","江总征正，未越常伦。","时合风兴，或无淄磷。","二杜繁俗，三刘琐碎。","陈徐之流，阴张之辈。","伊数公者，阃域之外。","吁此以还，有固斯郐。"],0,"x22","唐"],null,["江有归舟三章 三","萧颖士","四言",["彼游惟帆，匪风不扬。","有彬伊父，匪学不彰。","予其怀而，勉尔无忘。"],0,199,"唐"],null,["郊庙歌辞 祀圜丘乐章 寿和","褚亮","四言",["八音斯奏，三献毕陈。","宝祚惟永，晖光日新。"],{"yz":["魏徵"]},150,"唐"],["郊庙歌辞 享太庙乐章 大顺舞","郑𬘡","四言",["于穆时文，受天明命。","允恭玄默，化成理定。","出震嗣德，应干传圣。","猗欤缉熙，千亿流庆。"],0,18,"唐"],["郊庙歌辞 祀圜丘乐章 雍和","褚亮","四言",["钦惟大帝，[载]仰皇穹。","始命田烛，爰启郊宫。","云门骇听，雷鼓鸣空。","神其介祀，景祚斯融。"],0,150,"唐"],["江有归舟三章 二","萧颖士","四言",["舟既归止，人亦荣止。","兄矣弟矣，孝斯践矣。","称觞燕喜，于岵于屺。"],0,199,"唐"],["重联句一首","皎然","四言",["肃肃清院，翛翛碧鲜。","已见心远，何关地偏。","自公退食，升堂草玄。","纷纷已隔，云心澹然。"],0,"x22","唐"],null,null,["中和乐九章 歌明堂第二","卢照邻","四言",["穆穆圣皇，雍雍明堂。","左平右墄，上圆下方。","调均风雨，制度阴阳。","四窗八达，五室九房。","南通夏火，西瞰秋霜。","天子临御，万玉锵锵。"],0,250,"唐"],["郊庙歌辞 中宗祀昊天乐章 太和","佚名","四言",["恭临宝位，肃奉瑶图。","恒思解网，每轸泣辜。","德慙巢燧，化劣唐虞。","期我良弼，式赞嘉谟。"],0,"x14","唐"],["郊庙歌辞 仪坤庙乐章 永和","祝钦明","四言",["閟宫实实，清庙微微。","降格无象，馨香有依。","式昭纂庆，方融嗣徽。","明禋是享，神保聿归。"],0,175,"唐"],["祝牛宫辞","陆龟蒙","四言",["四牸三牯，中一去乳。","天霜降寒，纳此室处。","老农拘拘，度地不亩。","东西几何，七举其武。","南北几何，丈二加五。","偶楹当闲，载尺入土。","太岁在亥，馀不足数。","上缔蓬茅，下远官府。","耕耨以时，饮食得所。","或寝或卧，免风免雨。","宜尔子孙，实我仓庾。"],0,"x24","唐"],["春昼","韩偓","四言",["春融艳艳，大醉陶陶。","漏添迟日，箭减良宵。","藤垂戟户，柳拂河桥。","帘幕燕子，池塘[伯]劳。","肤清臂瘦，衫薄香销。","楚殿衣窄，南朝髻高。","河阳县远，清波地遥。","丝缠露泣，各自无憀。"],0,34,"唐"],["中和乐九章 歌公卿第八","卢照邻","四言",["蹇蹇三事，师师百僚。","群龙在职，振鹭盈朝。","丰金辉首，佩玉鸣腰。","青蒲翼翼，丹地翘翘。","歌云佐汉，捧日匡尧。","天工人代，邈邈昭昭。"],0,250,"唐"],["郊庙歌辞 武后明堂乐章 皇帝行","武则天","四言",["仰膺历数，俯顺讴歌。","远安迩肃，俗阜时和。","化光玉镜，讼息金科。","方兴典礼，永戢干戈。"],0,96,"唐"],["郊庙歌辞 周宗庙乐舞辞 咸顺","佚名","四言",["万舞咸列，三阶克清。","贯珠一倡，击石九成。","盈觞虽酌，灵坐无形。","永怀我祖，达其孝诚。"],0,"x14","唐"],["郊庙歌辞 雩祀乐章 雍和","褚亮","四言",["绀筵分彩，珤图吐绚。","风管晨凝，云歌晓啭。","肃事兰羞，虔申桂奠。","百谷斯登，万箱攸荐。"],0,150,"唐"],["咏方圆动静示李泌","张说","四言",["方如棋局，圆如棋子。","动如棋生，静如棋死。"],0,133,"唐"],["菊荣一篇五章 四","萧颖士","四言",["采采者菊，于宾之馆。","既低其枝，又弱其干。","有斐君子，是焉披玩。","良辰旨酒，宴饮无算。","怆其仳别，终然永叹。"],0,199,"唐"],["郊庙歌辞 仪坤庙乐章 坤贞","薛稷","四言",["乾道既亨，坤元以贞。","肃雍攸在，辅佐斯成。","外睦九族，内光一庭。","克生睿哲，祚我休明。","钦若徽范，悠哉淑灵。","建兹清宫，于彼上京。","缩茅以献，絜秬惟馨。","实受其福，斯乎亿龄。"],0,67,"唐"],null,["菊荣一篇五章 二","萧颖士","四言",["采采者菊，于邑之城。","旧根新茎，布叶垂英。","彼美淑人，应家之祯。","有弦既鸣，我政则平。","宜尔栋崇，必复其庆。"],0,199,"唐"],["江有枫一篇十章 五","萧颖士","四言",["粤东可居，彼吴之墟。","有田有庭，有朋有书。","有莼有鱼，君子居焉。","惟以宴醑，其乐徐徐。"],0,199,"唐"],["菊荣一篇五章 三","萧颖士","四言",["采采者菊，于邦之府。","阴槐翳柳，迩楹近宇。","彼劳者子，喧卑是处。","慨其莫知，蕴结谁语。","企彼高人，色斯遐举。"],0,199,"唐"],["江有枫一篇十章 八","萧颖士","四言",["我思震泽，菱芡幕幕。","寤寐如觌，我思剡谿。","杉筿萋萋，寤寐无迷。"],0,199,"唐"],["江有枫一篇十章 四","萧颖士","四言",["东可游矣，会之丘矣。","于山于水，于庙于寺。","于亭于里，君子游焉。","于以宴喜，其乐亹亹。"],0,199,"唐"],["嫁女诗 其九","嵩岳诸仙","四言",["上清神女，玉京仙郎。","乐此今夕，和鸣凤凰。","凤凰和鸣，将翱将翔。","与天齐休，庆流无央。"],0,109,"唐"],["郊庙歌辞·后唐宗庙乐舞辞·永平舞","崔居俭、卢文纪","四言",["庆传瓒祚，位正瑶图。","功宣四海，化被八区。","静彰帝道，动合干符。","千秋万祀，永荷昭苏。"],0,101,"唐"],["江有枫一篇十章 七","萧颖士","四言",["我友于征，彼郑之子。","如琇如英，德音孔明。"],0,199,"唐"],["赠皇甫侍御赴都八首 二","元希声","四言",["猗嗟众珍，以况君子。","公侯之胄，必复其始。","利器长材，温仪峻峙。"],0,87,"唐"],["菊荣一篇五章 五","萧颖士","四言",["岁方晏矣，霜露残促。","谁其荣斯，有英者菊。","岂微春华，懿此贞色。","人之侮我，混于薪棘。","诗人有言，好是正直。"],0,199,"唐"],["空馆夜歌 一","夷陵女郎","四言",["明月清风，良宵会同。","星河易翻，欢娱不终。","绿樽翠杓，为君斟酌。"],0,6,"唐"],["赠皇甫侍御赴都八首 其一","元希声","四言",["东南之美，生于会稽。","牛斗之气，蓄于昆溪。","有瑶者玉，连城是齐。","有威者凤，非梧不栖。"],0,87,"唐"],["郊庙歌辞 祭汾阴乐章 凯安","蒋挺","四言",["维岁之吉，维辰之良。","圣君绂冕，肃事坛场。","大礼已备，大乐斯张。","神其醉止，降福无疆。"],0,65,"唐"],["郊庙歌辞 武后享清庙乐章十首 第五饮福","佚名","四言",["爰陈玉醴，式奠琼浆。","灵心有穆，介福无疆。"],0,"x14","唐"],["赠皇甫侍御赴都八首 其六","元希声","四言",["载怀朋情，尝接闲宴。","好洽昆弟，官联州县。","如彼松竹，春荣冬蒨。","柯叶蔼然，不渝霜霰。"],0,87,"唐"],["赠皇甫侍御赴都八首 其八","元希声","四言",["金石其心，芝兰其室。","言语方间，音徽自溢。","肃子风威，严子霜质。","赠言岁暮，以保贞吉。"],0,87,"唐"],null,["池州夫子庙麟台","韦表微","四言",["二仪既闭，三象乃乖。","圣道埋郁，人心不开。","上无文武，下有定哀。","吁嗟麟兮，孰为来哉。","周虽不纲，孔实嗣圣。","诗书既删，礼乐大定。","劝善惩恶，奸邪乃正。","吁嗟麟兮，克昭符命。","圣与时合，化行位尊。","苟或乖戾，身穷道存。","于昭鲁邑，栖迟孔门。","吁嗟麟兮，孰知其仁。","运极数残，德至时否。","楚国寖广，秦封益侈。","墙仞迫阨，崎岖阙里。","吁嗟麟兮，靡有攸止。","世治则麟，世乱则麕。","出非其时，麋鹿同群。","孔不自圣，麟不自祥。","吁嗟麟兮，天何所亡。"],0,117,"唐"],["菊荣一篇五章 一","萧颖士","四言",["采采者菊，芬其荣斯。","紫英黄萼，照灼丹墀。","恺悌君子，佩服攸宜。","王国是维，大君是毗。","贻尔子孙，百禄萃之。"],0,199,"唐"],["赠皇甫侍御赴都八首 其五","元希声","四言",["绰绰夫君，是膺柱下。","准绳有望，名器无假。","宠盖伯山，气雄公雅。","立朝正色，俟我能者。"],0,87,"唐"],["郊庙歌辞 享太庙乐章 象德舞","段文昌","四言",["肃肃清庙，登显至德。","泽周八荒，兵定四极。","生物咸遂，群盗灭息。","明圣钦承，子孙千亿。"],0,235,"唐"],["赠皇甫侍御赴都八首 其四","元希声","四言",["粤在古昔，分官厥初。","刺邪矫枉，非贤勿居。","棱棱直指，烈烈方书。","苍玉鸣珮，绣衣登车。"],0,87,"唐"],null,["郊庙歌辞 祭汾阴乐章 太簇角","卢从愿","四言",["坤元载物，阳乐发生。","播植资始，品汇咸亨。","列俎棋布，方坛砥平。","神歆禋祀，后德惟明。"],0,90,"唐"],["郊庙歌辞 周朝飨乐章 康顺","佚名","四言",["鸿钧广运，嘉节良辰。","列辟在位，万国来宾。","干旌屡舞，金石咸陈。","礼容既备，帝履长春。"],0,"x14","唐"],["空馆夜歌 其三","夷陵女郎","四言",["[玉]户金缸，愿陪君王。","邯郸宫中，金石丝簧。","卫女秦娥，左右成行。","纨缟缤纷，翠眉红妆。","王欢顾盼，为王歌舞。","愿得君欢，常无灾苦。"],0,6,"唐"],["和马郎中画鹤赞","卢纶","四言",["高高华亭，有鹤在屏。","削玉点漆，乘轩姓丁。","暮云冥冥，双垂雪翎。","晨光炯炯，一直朱顶。","含音俨容，绝粒遗影。","君以为真，相期缑岭。"],0,106,"唐"],["郊庙歌辞 祭汾阴乐章 太和","王晙","四言",["於穆圣皇，六叶重光。","太原刻颂，后土疎场。","宝鼎呈符，歊云孕祥。","礼乐备矣，降福穰穰。"],0,158,"唐"],["与独孤穆冥会诗 其六 县主请迁葬诗","临淄县主","四言",["露草芊芊，颓茔未迁。","自我居此，于今几年。","与君先祖，畴昔恩波。","死生契阔，忽此相过。","谁谓佳期，寻当别离。","俟君之北，携手同归。"],0,166,"唐"],["与独孤穆冥会诗 其七 穆荅县主","临淄县主","四言",["伊彼维扬，在天一方。","驱马悠悠，忽来异乡。","情通幽显，获此相见。","义感畴昔，言存缱绻。","清江桂洲，可以遨游。","惟子之故，不遑淹留。"],0,166,"唐"],null,["郊庙歌辞 享太庙乐章 长发舞","魏征","四言",["濬哲惟唐，长发其祥。","帝命斯祐，王业克昌。","配天载德，就日重光。","本枝百代，申锡无疆。"],0,152,"唐"],null,["郊庙歌辞 封泰山乐章 太和","张说","四言",["孝敬中发，和容外彰。","腾华照宇，如升太阳。","贞璧就奠，玄灵垂光。","礼乐具举，济济洋洋。"],0,133,"唐"],["赠皇甫侍御赴都八首 其七","元希声","四言",["会合非我，关山坐违。","离鸿晓引，别叶秋飞。","𬴂骖徐动，尊饯相依。","远情超忽，岐路光辉。"],0,87,"唐"],null,["郊庙歌辞 享太庙乐章 大明舞","魏征","四言",["五纪更运，三正逓升。","勋华既没，禹汤勃兴。","神武命代，灵睠是膺。","望云彰德，察纬告征。","上纽天维，下安地轴。","征师涿野，万国咸服。","偃伯灵台，九官允穆。","殊域委赆，怀生介福。","大礼既饰，大乐已和。","黑章扰囿，赤字浮河。","功宣载籍，德被咏歌。","克昌厥后，百禄是荷。"],0,152,"唐"],["郊庙歌辞 享太庙乐章 金奏","佚名","四言",["肃肃清庙，巍巍盛唐。","配天立极，累圣重光。","乐和管磬，礼备烝尝。","永惟来格，降福无疆。"],0,"x14","唐"],null,["郊庙歌辞 享太庙乐章 永和","魏征","四言",["於穆烈祖，弘此丕基。","永言配命，子孙保之。","百神既洽，万国在兹。","是用孝享，神其格思。"],0,152,"唐"],["郊庙歌辞 享太庙乐章 永和","魏征","四言",["肃肃清祀，烝烝孝思。","荐享昭备，虔恭在兹。","雍歌撤俎，祝嘏陈辞。","用光武志，永固鸿基。"],0,152,"唐"],["郊庙歌辞 梁郊祀乐章 庆肃","张衮","四言",["笾豆簠簋，黍稷非馨。","懿兹彝器，厥德惟明。","金石匏革，以和以平。","由此无疆，期乎永宁。"],0,68,"唐"],["大蜀皇帝寿春节进尧铭舜颂二首 舜颂","贯休","四言",["高高历山，有黍有粟。","皇皇大舜，合尧玄德。","五典克从，四门伊穆。","大道将行，天下为公。","临下有赫，选贤用能。","吾皇则之，无斁无逸。","绥厥品汇，光光得一。","千辐临顶，十在随跸。","大哉大同，为光为龙。","吾皇则之，圣谋隆隆。","纳隍孜孜，攷攷切切。","六宗是禋，五瑞斯列。","排麟环凤，披香立雪。","四夷纳賮，九围有截。","昔救世师，降生竺乾。","寿春亦然，万年万年。"],0,"x30","唐"],["郊庙歌辞 祭方丘乐章 顺和","褚亮","四言",["阴祇协赞，厚载方贞。","牲币具举，箫管备成。","其礼惟肃，其德惟明。","神之听矣，式鉴虔诚。"],0,150,"唐"],["郊庙歌辞 享惠昭太子庙乐章 迎俎酌献","李逢吉","四言",["既洁酒醴，聿陈熟腥。","肃将震念，昭格储灵。","展矣礼典，薰然德馨。","愔愔管磬，亦具是听。"],0,62,"唐"],["大蜀皇帝寿春节进尧铭舜颂二首 尧铭","贯休","四言",["金册昭昭，列圣孤标。","仲尼有言，巍巍帝尧。","承天眷命，罔厥矜骄。","四德炎炎，堦蓂不凋。","永孚于休，垂衣飘飖。","吾皇则之，小心翼翼。","秉阳亭毒，不遑暇食。","土堦苔绿，茅茨雪滴。","君既天赋，相亦天锡。","德辀金镜，以圣继圣。","汉高将将，太宗兵柄。","吾皇则之，日新德盛。","朽索六马，罔坠厥命。","熙熙蓼萧，块润风调。","舞擎干羽，囿入𫇴荛。","既玉其叶，亦金其枝。","叶叶枝枝，百工允厘。","享国如尧，不疑不疑。"],0,"x30","唐"],null,["郊庙歌辞 武后大享拜洛乐章 禋和","佚名","四言",["百礼崇容，千官肃事。","灵降无兆，神凝有粹。","奠享咸周，威仪毕备。","奏夏登列，歌雍彻肆。"],0,"x14","唐"],["郊庙歌辞 善胜舞","佚名","四言",["圣祖累功，福钟来裔。","持羽执干，舞文不废。"],0,"x14","唐"],["赠皇甫侍御赴都八首 其三","元希声","四言",["道心惟微，厥用允塞。","德辉不泯，而映邦国。","静以有神，动而作则。","九臯千里，其声不忒。"],0,87,"唐"],["郊庙歌辞 后唐宗庙乐舞辞 武成舞","崔居俭","四言",["艰难王业，返正皇唐。","先天在造，却日重光。","汉绍世祖，夏资少康。","功成德茂，率祀无疆。"],0,87,"唐"],null,["郊庙歌辞 朝日乐章 雍和","佚名","四言",["晨仪式荐，明祀惟光。","神物爰止，灵晖载扬。","玄端肃事，紫幄兴祥。","福履攸假，于昭允王。"],0,"x14","唐"],["郊庙歌辞 后唐宗庙乐舞辞 文明舞","崔居俭、卢文纪","四言",["帝业光扬，皇图翕赫。","圣德孔彰，神功不测。","信及豚鱼，恩沾动植。","懿范鸿名，传之万亿。"],0,101,"唐"],["郊庙歌辞 明堂乐章 雍和","褚亮","四言",["八牖晨披，五精朝奠。","雾凝璇篚，风清金县。","神涤备全，明粢丰衍。","载絜彝俎，陈诚以荐。"],0,150,"唐"],["铸镜歌","龙护老人","四言",["盘龙盘龙，隐于镜中。","分野有象，变化无穷。","兴云吐雾，行雨生风。","上清仙子，来献圣聪。"],0,42,"唐"],null,null,["郊庙歌辞 太清宫乐章 冲和","佚名","四言",["虚无结思，钟磬和音。","歌以颂德，香以达心。","礼殊祼鬯，义感昭临。","云车至止，庆垂愔愔。"],0,"x14","唐"],["中和乐九章 歌诸王第七","卢照邻","四言",["星陈帝子，岳列天孙。","义光带砺，象著乾坤。","我有明德，利建攸存。","苴以茅社，锡以牺尊。","藩屏王室，翼亮尧门。","八才两献，夫何足论。"],0,250,"唐"],null,["啄木","齐己","四言",["啄木啄啄，鸣林响壑。","贪心既缘，利嘴斯凿。","有朽百尺，微虫斯宅。","以啄去害，啄更弥剧。","层崖豫章，耸干苍苍。","无纵尔啄，摧我栋梁。"],0,"x29","唐"],null,["唐大飨拜洛乐章 敬和","武则天","四言",["兰俎既升，苹羞可荐。","金石载设，咸英已变。","林泽斯总，山川是遍。","敢用敷诚，实惟忘倦。"],0,96,"唐"],["中和乐九章 歌登封第一","卢照邻","四言",["炎图丧宝，黄历开璇。","祖武类帝，宗文配天。","玉銮垂日，翠华陵烟。","东云干吕，南风入弦。","山称万岁，河庆千年。","金绳永结，璧丽长悬。"],0,250,"唐"],["郊庙歌辞 仪坤庙乐章 金奏","徐彦伯","四言",["阴灵效祉，轩曜降精。","祥符淑气，庆集柔明。","瑶俎既列，雕桐发声。","徽猷永远，比德皇英。"],0,147,"唐"],["郊庙歌辞 享先农乐章 肃和","褚亮","四言",["樽彝既列，瑚簋方荐。","歌工载登，币礼斯奠。","肃肃享祀，颙颙缨弁。","神之听之，福流寰县。"],0,150,"唐"],null,["郊庙歌辞 后唐宗庙乐舞辞 武成舞","崔居俭、卢文纪","四言",["艰难王业，返正皇唐。","先天再造，却日重光。","汉绍世祖，夏资少康。","功成德茂，率祀无疆。"],0,101,"唐"],null,["郊庙歌辞 享太庙乐章 雍和","魏征","四言",["崇兹享祀，诚敬兼至。","乐以感灵，礼以昭事。","粢盛咸絜，牲牷孔备。","永言孝思，庶几不匮。"],0,152,"唐"],["郊庙歌辞 享太庙乐章 雍和","魏征","四言",["於穆清庙，聿修严祀。","四县载陈，三献斯止。","笾豆撤荐，人祗介祉。","神惟格思，锡祚不已。"],0,152,"唐"],null,["郊庙歌辞 梁郊祀乐章 其五 庆和","赵光逢","四言",["惟德动天，有感必通。","秉兹一德，禋于六宗。","钦夤宝命，恭肃礼容。","来顾来享，永穆皇风。"],0,56,"唐"],["郊庙歌辞 梁郊祀乐章 庆肃","赵光逢、张衮","四言",["笾豆簠簋，黍稷非馨。","懿兹彝器，厥德惟明。","金石匏革，以和以平。","繇此无体，期乎永宁。"],0,0,"唐"],["郊庙歌辞 梁郊祀乐章 其六 庆和","赵光逢","四言",["天惟佑德，辟乃奉天。","交感斯在，昭事罔愆。","岁功已就，王道无偏。","于焉报本，是用告虔。"],0,56,"唐"],["郊庙歌辞 夕月乐章 肃和","佚名","四言",["测妙为神，通微曰圣。","坎祀贻则，郊禋展敬。","璧荐登光，金歌动映。","以载嘉德，以流曾庆。"],0,"x14","唐"],null,["郊庙歌辞 享节愍太子庙乐章 登歌酌鬯","佚名","四言",["灼灼重明，仰承元首。","既贤且哲，惟孝与友。","惟孝虽遥，灵规不朽。","礼因诚致，备絜玄酒。"],0,"x14","唐"],["郊庙歌辞 祭汾阴乐章 姑洗征","刘晃","四言",["大君出震，有事郊禋。","斋戒既肃，馨香毕陈。","乐和礼备，候暖风春。","恭惟降福，实赖明神。"],0,202,"唐"],["郊庙歌辞 仪坤庙乐章 永和","徐彦伯","四言",["猗若清庙，肃肃荧荧。","国荐严祀，坤兴淑灵。","有几在室，有乐在庭。","临兹孝享，百禄惟宁。"],0,147,"唐"],["中和乐九章 歌储宫第六","卢照邻","四言",["波澄少海，景丽前星。","高禖诞圣，甲观升灵。","承规翠所，问寝瑶庭。","宗儒侧席，问道横经。","山宾皎皎，国胄青青。","黄裳元吉，邦家以宁。"],0,250,"唐"],null,["郊庙歌辞 明堂乐章 肃和","褚亮","四言",["象天御宇，乘时布政。","严配申虔，宗禋展敬。","罇罍盈列，树羽交映。","玉币通诚，祚隆皇圣。"],0,150,"唐"],["郊庙歌辞 享惠昭太子庙乐章 登歌","杜羔","四言",["因心克孝，位震遗芬。","宾天道茂，轸怀气分。","发祗乃祀，咳叹如闻。","二歌斯升，以咏德薰。"],0,198,"唐"],null,["郊庙歌辞 仪坤庙乐章 昭升","薛稷","四言",["阳灵配德，阴魄昭升。","尧坛凤下，汉室龙兴。","伣天作对，前旒是凝。","化行南国，道盛西陵。","造舟集灌，无德而称。","我粢既絜，我醴既澄。","阴阴灵庙，光灵若凭。","德馨惟享，孝思烝烝。"],0,67,"唐"],null,["中和乐九章 歌南郊第四","卢照邻","四言",["虔郊上帝，肃事圆丘。","龙驾四牡，鸾旗九斿。","钟歌晚引，紫炀高浮。","日丽苍璧，云飞鸣球。","皇之庆矣，万寿千秋。"],0,250,"唐"],null,["郊庙歌辞 梁郊祀乐章 庆顺","赵光逢","四言",["圣皇戾止，天步舒迟。","干干睿相，穆穆皇仪。","进退必肃，陟降是祗。","六变克协，万灵协随。"],0,56,"唐"],["祈谷乐章 肃和","褚亮","四言",["履艮斯绳，居中体正。","龙运垂祉，昭符启圣。","式事严禋，聿怀嘉庆。","惟帝永锡，时皇休命。"],0,150,"唐"],null,["郊庙歌辞 梁郊祀乐章 庆熙","赵光逢、张衮","四言",["哲后躬享，旨酒斯陈。","王恭无斁，严祀维夤。","皇祖以配，大孝以振。","宜锡景福，永休下民。"],0,0,"唐"],null,["郊庙歌辞 雩祀乐章 豫和","佚名","四言",["鸟纬迁序，龙星见辰。","纯阳在律，明德崇禋。","五方降帝，万宇安人。","恭以致享，肃以迎神。"],0,"x14","唐"],["郊庙歌辞 雩祀乐章 豫和","佚名","四言",["祀遵经设，享缘诚举。","献毕于樽，彻临于俎。","舞止干戚，乐停柷敔。","歌以送神，神还其所。"],0,"x14","唐"],null,["郊庙歌辞 后唐宗庙乐舞辞 应天舞","崔居俭、卢文纪","四言",["晋国肇兴，雄图再固。","黼黻帝道，金玉王度。","皇天无亲，惟德是辅。","载诞英明，永光圣祚。"],0,101,"唐"],["郊庙歌辞 后唐宗庙乐舞辞 雍煕舞","崔居俭、卢文纪","四言",["仁君御宇，寰海谧清。","运符武德，道协文明。","九成式敍，百度惟贞。","金门积庆，玉叶传荣。"],0,101,"唐"],null,null,null,["刘方平壁画山","皇甫冉","四言",["墨妙无前，性生笔先。","回溪已失，远嶂犹连。","侧径樵客，长林野烟。","青峰之外，何处云天。"],0,93,"唐"],null,["郊庙歌辞 梁郊祀乐章 庆熙","张衮","四言",["哲后躬享，旨酒斯陈。","王恭无斁，严祀惟寅。","皇祖以配，大孝以振。","宜锡景福，永休下民。"],0,68,"唐"],["唐大飨拜洛乐章 九和","武则天","四言",["祗荷坤德，钦若干灵。","惭惕罔置，兴居匪宁。","恭崇礼则，肃奉仪形。","惟凭展敬，敢荐非馨。"],0,96,"唐"],["郊庙歌辞 梁郊祀乐章 庆平","赵光逢","四言",["天命降鉴，帝德惟馨。","享祀不忒，礼容孔明。","奠璧布币，荐纯献精。","神祐以荅，敷锡永宁。"],0,56,"唐"],["凉雨一章","萧颖士","四言",["习习凉风，泠泠浮飙。","君子乐胥，于其宾僚。","有女斯夭，式歌且谣。","欲言终宥，惟以招邀，于胥乐兮。"],0,199,"唐"],null,null,null,["唐大飨拜洛乐章 禋和","武则天","四言",["百礼崇容，千官肃事。","灵降舞兆，神凝有粹。","奠享咸周，威仪毕备。","奏夏登列，歌雍撤肆。"],0,96,"唐"],null,["郊庙歌辞 享隐太子庙乐章 诚和","佚名","四言",["道閟鹤关，运缠鸠里。","门集大命，俾歆嘉祀。","礼亚六瑚，诚殚二簋。","有诚颙若，神斯戾止。"],0,"x14","唐"],["郊庙歌辞 享先农乐章 咸和","褚亮","四言",["粒食伊始，农之所先。","古今攸赖，是曰人天。","耕斯帝籍，播厥公田。","式崇明祀，神其福焉。"],0,150,"唐"],["虞获子鹿","韦应物","四言",["虞获子鹿，畜之城陬。","园有美草，池有清流。","但见蹶蹶，亦闻呦呦。","谁知其思，岩谷云游。"],0,"x10","唐"],null,null,["郊庙歌辞 仪坤庙乐章 肃和","张齐贤","四言",["祼圭既濯，郁鬯既陈。","画幕云举，黄流玉醇。","仪充献酌，礼盛众禋。","地察惟孝，愉焉飨亲。"],0,243,"唐"],["郊庙歌辞 襃德庙乐章 昭德","佚名","四言",["道赫梧宫，悲盈蒿里。","爰赐徽烈，载敷嘉祀。","享洽四时，规陈二簋。","灵应昭格，神其戾止。"],0,"x14","唐"],["唐德明兴圣庙乐章 送神","李纾","四言",["元精回复，灵贶繁滋。","风洒兰路，云摇桂旗。","高丘缅邈，凉部逶迟。","瞻望靡及，缠绵永思。"],0,255,"唐"],null,["郊庙歌辞 中宗祀昊天乐章 福和","佚名","四言",["九成爰奏，三献式陈。","钦承景福，恭托明禋。"],0,"x14","唐"],["郊庙歌辞 晋朝飨乐章 初举酒文同乐","佚名","四言",["赫矣昌运，明哉圣王。","文兴坠典，礼复旧章。","鸳鸾济济，鸟兽跄跄。","一人有庆，万福无疆。"],0,"x14","唐"],null,["郊庙歌辞 享太庙乐章 永和","魏征、褚亮","四言",["肃肃清祀，烝烝孝思。","荐享昭备，虔恭在兹。","雍歌彻俎，祝嘏陈辞。","用光武志，永固鸿基。"],0,223,"唐"],["郊庙歌辞 享太庙乐章 大定舞","李回","四言",["受天明命，敷佑下土。","化时以俭，卫文以武。","氛消夷夏，俗臻往古。","亿万斯年，形于律吕。"],0,127,"唐"],["郊庙歌辞 德明兴圣庙乐章 迎神","李纾","四言",["元尊九德，佐尧光宅。","烈祖太宗，方周作伯。","响怀霜露，乐变金石。","白云青风，髣髴来格。"],0,255,"唐"],["郊庙歌辞 中宗祀昊天乐章 肃和","佚名","四言",["悠哉广覆，大矣曲成。","九玄著象，七曜贞明。","珪璧是奠，酝酎斯盈。","作乐崇德，爰畅咸英。"],0,"x14","唐"],["郊庙歌辞 中宗祀昊天乐章 亚献","佚名","四言",["三灵降飨，三后配神。","虔敷藻奠，敬展郊禋。"],0,"x14","唐"],null,null,["泽宫诗 其一","刘禹锡","四言",["秩秩泽宫，有的维鹄。","祁祁庶士，于以干禄。"],0,"x21","唐"],["泽宫诗 其二","刘禹锡","四言",["彼鹄斯微，若止若翔。","千里之差，起于毫芒。"],0,"x21","唐"],["泽宫诗 其三","刘禹锡","四言",["我矢既直，我弓既良。","依于高墉，因我不臧。"],0,"x21","唐"],null,null,["唐享昊天乐 第十一","武则天","四言",["礼终肆类，乐阕九成。","仰惟明德，敢荐非馨。","顾惭菲奠，久驰云𫐌。","瞻荷灵泽，悚恋兼盈。"],0,96,"唐"],null,["泽宫诗 其四","刘禹锡","四言",["高墉伊何，维器与时。","视之以心，谁谓鹄微。"],0,"x21","唐"],["郊庙歌辞 祀风师乐章 迎俎酌献","包佶","四言",["德盛昭临，迎拜巽方。","爰候发生，式荐馨香。","酌醴具举，工歌载扬。","神歆六律，恩降百祥。"],0,30,"唐"],["曳鼎歌","武则天","四言",["羲农首出，轩昊膺期。","唐虞继踵，汤禹乘时。","天下光宅，海内雍熙。","上玄降鉴，方建隆基。"],0,96,"唐"],["郊庙歌辞 享孔子庙乐章 送神","佚名","四言",["醴溢牺象，羞陈俎豆。","鲁壁类闻，泗川入觏。","里校覃福，胄筵承祐。","雅乐清音，送神具奏。"],0,"x14","唐"],["彼农二章 一","陆龟蒙","四言",["世路浇险，淳风荡除。","彼农家流，犹存厥初。","藁焉而席，茨焉而居。","首乱如葆，形枯若腒。","大耋既鲐，童子未𪚐。","以负以载，悉薅悉鉏。","我慕圣道，我躭古书。","小倦于学，时游汝庐。","有饭一盛，莫盐莫蔬。","有𦈡一缇，不襟不袪。","所谓饥寒，汝何逭欤。"],0,"x24","唐"],null,["郊庙歌辞 享太庙乐章 雍和","魏征、褚亮","四言",["於穆清庙，聿修严祀。","四县载陈，三献斯止。","笾豆彻荐，人祇介祉。","神维格思，锡祚不已。"],0,223,"唐"],null,["彼农二章 二","陆龟蒙","四言",["禹贡厥田，上下各异。","善人为邦，民受其赐。","去年西成，野有遗穗。","今夏南亩，旱气赤地。","遭其丰凶，概歛无二。","退输弗供，进诉弗视。","号于旻天，以血为泪。","孟子有言，王无罪岁。","诗以穷辞，以嫉悍吏。"],0,"x24","唐"],null,["题僧房绝句","吕岩","四言",["唐朝进士，今日神仙。","足蹑紫雾，却返洞天。"],0,176,"唐"],["郊庙歌辞 雩祀乐章 肃和","褚亮","四言",["朱鸟开辰，苍龙启映。","大帝昭飨，群生展敬。","礼备怀柔，功宣舞咏。","旬液应序，年祥协庆。"],0,150,"唐"],["绣袈裟衣缘","长屋","四言",["山川异域，风月同天。","寄诸佛子，共结来缘。"],0,92,"唐"],null,["郊庙歌辞 祭方丘乐章 金奏","佚名","四言",["坤元至德，品物资生。","神凝博厚，道协高明。","列镇五岳，环流四瀛。","于何不载，万宝斯成。"],0,"x14","唐"],["郊庙歌辞 德明兴圣庙乐章 德明酌献","李纾","四言",["清庙弈弈，和乐雍雍。","器尊牺象，礼属宗公。","白水方[祼]，黄流在中。","谟明之德，万古清风。"],0,255,"唐"],["祭汾阴乐章","韩思复","四言",["大乐和畅，殷荐明神。","一降通感，八变必臻。","有求斯应，无德不亲。","降灵醉止，休征万人。"],0,81,"唐"],["郊庙歌辞 享太庙乐章 大基舞","魏征","四言",["猗与祖业，皇矣帝先。","剪商德厚，封唐庆延。","在姬犹稷，方晋逾宣。","基我鼎运，于斯万年。"],0,152,"唐"],["郊庙歌辞 享文敬太子庙乐章 登歌","陈京","四言",["歌以德发，声以乐贵。","乐善名存，追仙礼异。","鸾旌拱修，凤鸣合次。","神听皇慈，仲月皆至。"],0,8,"唐"],["郊庙歌辞 祭方丘乐章 顺和","佚名","四言",["坤厚载物，德柔垂祉。","九域咸雍，四溟为纪。","敬因良节，虔修阴祀。","广乐式张，灵其降止。"],0,"x14","唐"]]