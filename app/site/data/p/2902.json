[["和忠道者牧牛颂","释天游","四言",["两角指天，四足踏地。","拽断鼻绳，牧甚屎屁。"],0,192,"宋"],["寿马裕斋观文 山之高，三章，章四句。 其一","陈著","四言",["天作高山，大邦之屏。","外御其侮，王国庶定。"],0,"x92","宋"],["绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其八","郊庙朝会歌辞","四言",["天祐皇家，庆集重闱。","宝兮扬名，册兮流徽。","金支秀华，盛容祲威。","诏我近弼，相礼不违。"],0,"x207","宋"],["绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其六","郊庙朝会歌辞","四言",["慈皇天临，睟表怡怡。","钦哉圣子，亲奉玉卮。","鳌抃嵩呼，欢浃华夷。","迩臣捧册，是恪是祗。"],0,"x207","宋"],["宋颂九首 其二 六合雷声","石介","四言",["匪民之嚚，为贼俘虏。","往吊其民，王泽时雨。","往伐其罪，王师虎旅。"],0,105,"宋"],["宋颂九首 其三 圣神","石介","四言",["圣机神谋，天秘地藏，风行雷动。","旦秣我马，夕取其疆。","二君不知，晏眠于床。"],0,105,"宋"],["偈颂十八首 其十三","释道璨","四言",["至日书云，云作何色。","眼里无筋，青黄赤白。"],0,93,"宋"],["绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其七","郊庙朝会歌辞","四言",["瑟彼华玉，篆鱼钮龙。","与册并登，咨尔上公。","咏以歌诗，协之鼓钟。","是陟是降，靡有弗恭。"],0,"x207","宋"],["宋颂九首 其三 六合雷声","石介","四言",["昔时钱俶，有国于吴。","今俶归我，为吾前驱。","并人望风，请为臣奴。"],0,105,"宋"],["以玉刚卯为向伯共生朝","陈与义","四言",["仲冬吉日，风穆气休。","我出刚卯，以寿元侯。","祝融之玉，莫此离方。","元侯佩之，如玉之刚。","攘除厉凶，以迪明王。","南门不键，有室则强。","三肃元侯，既赠既祷。","曷以报我，当以刚卯。"],0,"x72","宋"],["偈颂七十六首 其三十七","释师观","四言",["暑退凉生，风高露冷。","叶落归根，藏头露影。","赵州吃茶，云门胡饼。","如何是道，明眼落井。"],0,210,"宋"],["绍兴以后时享二十五首 文舞退、武舞进用《正安》。","郊庙朝会歌辞","四言",["肃肃清庙，于显维德。","我祀孔时，我奏有翼。","秉翟载骏，有来干戚。","神之燕娭，休祥允格。"],0,"x207","宋"],["绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其九","郊庙朝会歌辞","四言",["大哉乾元，既极形容。","坤元德至，实与比隆。","宝册并登，勒崇垂鸿。","相我缛仪，肃肃雍雍。"],0,"x207","宋"],null,["太庙乐章 皇帝再盥洗干安之曲","周麟之","四言",["盥至于再，洁诚俞孚。","帝用祗荐，灵咸嘉虞。","腾歌胪驩，会于轩朱。","观厥颙若，受福之符。"],0,103,"宋"],["李邺侯赞","陈长方","四言",["四海九州，如一戏具。","运之失机，人与俱仆。","嗟世小儿，坐旁窥观。","拟指其手，目动心寒。","伟兹邺侯，把握是器。","南西北东，唯所欲置。","先捣范阳，困贼两河。","远猷不施，遗孽遂多。","藉其馀智，指令李郭。","尚洗甲兵，二都清廓。","再造有唐，如汉子房。","留封亦谢，高卧嵩阳。","老居上宰，前星嵲屼。","诚动昏庸，阴销篡夺。","寒暑迭运，今三百年。","岩岩英风，俨若在前。","我思古人，心焉密勿。","伟兹邺侯，才不世出。"],0,142,"宋"],["刘禹端公问云居雨从何来东平问官人风作何色 其二","释重显","四言",["风作何色，雨从何来。","不用弹指，楼阁门开。","波波棱棱，南方未回。"],0,"x156","宋"],["上邓宪生辰  其七","杨简","四言",["钦哉祥刑，克宽克明。","民罹旱虐，焦劳发情。"],0,118,"宋"],["元符亲享明堂十一首 其四 奉俎用《禧安》。","郊庙朝会歌辞","四言",["奕奕明堂，天子即事。","奠我圣考，配于上帝。","凡百有职，畴敢不祗。","俎洁牲肥，其登有仪。"],0,"x207","宋"],["李参政转物庵","释宗杲","四言",["若能转物，即同如来。","咄哉瞿昙，诳諕痴呆。","物无自性，我亦非有。","转者为谁，徒劳心手。","知无自性，复是何物。","瞥起情尘，扪空揣骨。","此庵无作，住者何人。","具顶门眼，试辨疏亲。"],0,"x112","宋"],["渡芦达磨赞二首 其二","释智朋","四言",["破六宗邪，开五叶花。","西天此土，地无朱砂。"],0,18,"宋"],["绍兴祀皇地祇十五首 文舞退、武舞进用《正安》。","郊庙朝会歌辞","四言",["于穆媪神，媲德彼天。","我修毖祀，以莫不虔。","肆陈时夏，干羽相宣。","灵其来游，降福绵绵。"],0,"x207","宋"],["颂四宾主 其十七","释印肃","四言",["宾主互用，动亦非动。","佛祖机关，不妨重弄。","法共不共，十八何用。","一相无相，自知轻重。","信手拈来，得时不会。","龟毛作过，兔角受罪。","山河俱动，此义失宗。","宗非山河，俱动是梦。","动亦不动，收来无用。","这回捉败，永不费功。","宾亦无宾，道孰可名。","今父逃逝，契悟方亲。","主得真主，佛祖共举。","认贼为子，不敢相许。","万国来亲，唯一佛身。","血脉不断，得者忻忻。","更下注脚，盲人摸索。","见中求见，病消求药。","和光同尘，没量智人。","有谁相识，资深资深。"],0,"x121","宋"],["高宗郊前朝献景灵宫二十一首 其十四 亚、终献用《冲安》。","郊庙朝会歌辞","四言",["五音饬奏，神既亿康。","澹其容与，荐此嘉觞。","有来显相，𫓶玉锵锵。","奉承若宥，罔不斋庄。"],0,"x207","宋"],["宋颂九首 其十一 明道","石介","四言",["明道之政，可以歌舞。","小臣作颂，实惭吉甫。"],0,105,"宋"],["弥陀古像赞","释智愚","四言",["有愿度生，垂手接引。","含生不来，物无可悯。"],0,"x153","宋"],["高宗建炎初祀昊天上帝 太祖位奠币用《定安》。","郊庙朝会歌辞","四言",["茫茫苍穹，孰知其纪。","精意潜通，虽远而迩。","量币荐诚，有实斯篚。","眷然顾之，永锡繁祉。"],0,"x207","宋"],["祀先蚕六首 其三 奠币用《娱安》。","郊庙朝会歌辞","四言",["化日初长，时当暮春。","蚕事方兴，惟后惟嫔。","丝纩御冬，残生济人。","敢忘报本，篚币是陈。"],0,"x207","宋"],["黄州江下","汪元量","四言",["黄州渡口，赤壁矶头。","冷风凄雨，一叶扁舟。"],0,"x189","宋"],["题陈和仲观聚堂","袁甫","四言",["习庵筑室，扁曰观聚。","堂前何有，万象可睹。","山如郛郭，烟云吞吐。","草木沃若，春光媚妩。","修篁漫山，不知隆暑。","何况秋空，呼日入户。","朔风吹雪，松声如怒。","上天下地，四方曰宇。","物生其间，何可胜数。","我于是观，乐哉斯土。","随意作室，不华不窳。","买山旋添，稍葺园圃。","得趣幽闲，不入城府。","良朋偶来，倾倒肺腑。","不及时事，惟谈邹鲁。","朋去何为，周易一部。","消息盈虚，穷今亘古。","观乃自观，寂无一语。"],0,229,"宋"],["绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其十二","郊庙朝会歌辞","四言",["坤德益崇，天寿平格。","庆流万世，子孙千亿。","刻玉范金，铺张赫奕。","惟昔姜任，则莫我匹。"],0,"x207","宋"],["摄事十三首 奠瓒用《瑞安》。","郊庙朝会歌辞","四言",["淳清育物，瑞木成文。","元气陶冶，非烟鬰氛。","玄贶昭格，至和所熏。","登歌祼献，肸蚃如闻。"],0,"x207","宋"],["净慈释刺血写经赞","李昴英","四言",["此经如筏，写之著相。","而刺血写，妄中之妄。","经诸佛说，血父母生。","何净何垢，等为前尘。","末法阇梨，沉酣入骨。","一毫且靳，而况于血。","血犹可舍，是知身幻。","大痛一回，直须臂断。"],0,124,"宋"],["云门匡真禅师画像赞二首","惠洪","四言",["见流滔天，公峙如山。","壁立万仞，捍其狂澜。","可望而却，不可览攀。","犀颅虎眸，美髯绕颊。","云辞电机，霹雳为舌。","邪宗堕倾，魔胆破裂。","须臾清明，光风霁月。","丛林驴骡，蹴踏龙象。","不可系羁，逸气迈往。","我不得济，大地是浪。","忽然现前，清机历掌。","阿罗汉有，三毒捺落。","迦没把柄，咄哉黄面。","浙子一生，吃著不尽。"],0,"x42","宋"],["龙眠居士画十六大阿罗汉赞 其十五","李纲","四言",["适从何来，游历于此。","大空斓斑，负经以侍。","有伟衣冠，山川之神。","旌麾戈甲，其从如云。"],0,"x136","宋"],["偈颂八十五首 其七十五","释妙伦","四言",["淘沙得金，凿石得玉。","张弓得鸟，掷钓得鱼。"],0,10,"宋"],null,["寿马裕斋观文 东山，二章，章四句。 其一","陈著","四言",["我徂东山，以敖以游。","彼采葛兮，谓我何求。"],0,"x92","宋"],["刘忠武书简帖赞","岳珂","四言",["以劲笔力，作往来帖。","婉有馀妍，庄不可狎。","古者文武，初非二流。","系于卿士，予其从周。"],0,"x202","宋"],["寿马裕斋观文 东山，二章，章四句。 其二","陈著","四言",["凤凰于飞，出自幽谷。","载好其音，集于灌木。"],0,"x92","宋"],["内使黄公","《靖康小雅》作者","四言",["在昔汉唐，亡由阉宦。","出或用之，鲜不贻患。","岂期黄公，独禀高见。","白发虔心，有闻必谏。","竭力东城，以身死难。","揭名不磨，万世炳焕。"],0,91,"宋"],["崧高诗为九江赵使君寿  其一二","杨冠卿","四言",["我来自东，小大稽首。","是用作歌，以介眉寿。"],0,61,"宋"],["宁宗朝享三十五首 还大次用《干安》。","郊庙朝会歌辞","四言",["王假有庙，对越在天。","帷宫旋御，率礼不愆。","泰畤展祠，云阳奉瑄。","齐居精明，益用告虔。"],0,"x207","宋"],["闵雨诗 其三","刘敞","四言",["天命降监，在我元圣。","兼覆广裕，四方既定。","惟民之恤，无所疵病。"],0,"x51","宋"],["景德祀皇地祇三首 其二 奠玉币、酌献用《嘉安》。","郊庙朝会歌辞","四言",["于昭祀典，致享坤仪。","备物咸秩，柔祇格思。","功宣敏树，日益鸿禧。","持载品汇，率土攸宜。"],0,"x207","宋"],["明堂庆成颂  其一一","徐鹿卿","四言",["乐既具奏，佾舞工歌。","八音克谐，两间浃和。"],0,73,"宋"],["赠詹生谒徐径坂","赵汝腾","四言",["贤哉二生，不远千里。","瞻彼径坂，今之泗水。","予诗为容，有进无止。","非殷洪乔，乃互乡子。"],0,47,"宋"],["绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其十一","郊庙朝会歌辞","四言",["丕赫有宋，三圣授受。","谁其助之，繄我太母。","东朝受册，饮此春酒。","圣子神孙，密侍左右。"],0,"x207","宋"],["高宗祀明堂前朝享太庙二十一首 其十八 终献用《正安》。","郊庙朝会歌辞","四言",["疏幂三举，诚意一纯。","孰陪予祀，公族振振。","明灵来娭，乐舞具陈。","奉神所佑，昭孝息民。"],0,"x207","宋"],["闵雨诗 其十一","刘敞","四言",["天子之德，视雨之施。","肇自京师，达于四裔。","无有蛮貊，孚我君惠。"],0,"x51","宋"],null,null,["哀吟赠蔡子骧女","徐积","四言",["蔡氏之子，彼仲女者。","考之古今，如仲者寡。","有德之容，有德之性。","所好所习，一出于正。","貌庄而丽，气温而醇。","女子之中，而有斯人。","慈良端厚，内敏而重。","终日寡言，亦不戏弄。","字无难易，所见辄识。","不知此女，从何而得。","读释氏书，欣然有适。","身之所有，皆出自然。","如何不幸，不假之年。","扬州道中，死于六月。","二十七日，暑气酷烈。","二十九日，三更大殓。","形神如生，体亦不变。","其气甚洁，其香甚郁。","附于身者，何用珠玉。","不知此女，而往何处。","杳杳冥冥，云霞烟雾。","世之所有，则维其常。","若斯人者，独秀孤芳。","吾于其母，是为内兄。","哀吟恻恻，慰其死生。"],0,"x123","宋"],["天目和尚赞松源和尚像永长老请赞","释如珙","四言",["我祖之真，是真非真。","我父之赞，是赞非赞。","非真是真，非赞是赞。","塞破虚空，断杨岐旨，灭临济宗。","分付定水，打凤罗龙。"],0,255,"宋"],["宁宗郊祀二十九首 文舞退、武舞进用《正安》。","郊庙朝会歌辞","四言",["羽籥陈容，干戚按节。","德闲而泰，功劳而决。","虞我神祇，扬我谟烈。","尽美尽善，福流有截。"],0,"x207","宋"],null,["颂古一百二十一首 其四十九","释宗杲","四言",["镆铘在握，天魔胆落。","明眼衲僧，休便卜度。"],0,"x112","宋"],["绣释迦像并十八罗汉赞 第十七难提蜜多罗庆友尊者","惠洪","四言",["风度凝远，支颐而倦。","看此宝塔，至身出现。","戏蛮弄毬，引此稚兽。","万用不藏，如日之昼。"],0,"x42","宋"],["熙宁蜡祭十三首 其四 奉俎用《承安》。","郊庙朝会歌辞","四言",["礼崇明祀，必先成民。","奉牲以告，备腯其均。","炮炙芬芬，俎豆莘莘。","锡之纯嘏，以佑斯人。"],0,"x207","宋"],["闵雨诗 其十二","刘敞","四言",["天子之政，视雨之时。","养老长幼，速哉熙熙。","更化易俗，而民不知。"],0,"x51","宋"],["明堂庆成颂  其一","徐鹿卿","四言",["穆穆圣皇，出震乘干。","二十二载，如日中天。"],0,73,"宋"],["吴思道朝服画像赞","李之仪","四言",["可畏而亲，不扶而直。","艺表士林，望高王国。","如在广庭，鹄立柱石。","翼翼眉间，尝满黄色。"],0,"x203","宋"],["景灵宫乐章 皇帝还大次干安之曲","周麟之","四言",["帝将于郊，昭事上祀。","爰兹毕觞，复即于次。","飚斿载旋，容旌沓骑。","维皇嘉承，锡祚昌炽。"],0,103,"宋"],["次韵李允道四言","方回","四言",["之子酒所，龙蛇挥扫。","清风拂砚，明月视稿。","佳思涌出，傍观惊倒。","岂不有学，升之曰造。"],0,"x59","宋"],["虎丘隆和尚赞","释如珙","四言",["睡虎一啸，虚空掇转。","南辰居北，北辰居南。","驴作驴鸣，犬作犬吠。","外道消灭，正宗亦无。"],0,255,"宋"],["元符亲享明堂十一首 其六 配位酌献用《德安》。","郊庙朝会歌辞","四言",["隆功骏德，两有烈光。","陟配宗祀，惠我无疆。"],0,"x207","宋"],["宁宗朝享三十五首 出小次用《干安》。","郊庙朝会歌辞","四言",["庙楹邃严，夜景藻清。","文物炳彪，礼仪熙成。","帷宫载敞，佩珩有声。","帝复对越，将受厥明。"],0,"x207","宋"],["汾阴十首 其五 太祖配坐酌献用《博安》。","郊庙朝会歌辞","四言",["坤元茂育，植物成形。","于穆圣祖，功齐三灵。","严恭配侑，厚德攸宁。","永怀锡羡，歆此惟馨。"],0,"x207","宋"],["太庙乐章 奉俎丰安之曲","周麟之","四言",["有硕其牲，登于大房。","肃展以飨，庶几迪尝。","匪腯是告，我民其康。","保艾尔后，垂休无疆。"],0,103,"宋"],["青山辞","陈天麟","四言",["青山崔崔，白云溶溶。","我疑其中，仙人所宫。","风马云舆，霓旌羽幢。","游行太空，翩然相从。","望而不见，使我心忡。","我本金华，牧羊之童。","口诵蕊笈，有声如钟。","震撼岩壑，无碍不通。","谪居下土，黄尘蒙蒙。","五色之气，布满西东。","秋高露清，陟彼危峰。","呼吸元气，精神内融。","啸傲万物，后天而终。"],0,13,"宋"],["北堂 其三","黄公槐","四言",["北堂有子，其实三兮。","仲焉此去，其心惨兮。"],0,55,"宋"],["寿马裕斋观文 山之高，三章，章四句。 其三","陈著","四言",["人亦有言，如山之寿。","万有千岁，保艾尔后。"],0,"x92","宋"],["寿马裕斋观文 江之永，三章，章四句。 其二","陈著","四言",["春日载阳，薄言采芑。","泳之游之，民之洽矣。"],0,"x92","宋"],["茶山解嘲","葛胜仲","四言",["众万之生，于世暂寓。","一偾一兴，孰知其故。","退黜奚戚，进升奚慕。","岂以通塞，顾改常度。","有如我翁，昔尝掀翥。","戴𫄥垂缨，去天尺五。","今屏山城，亦皆时数。","左右佩剑，畴可笑侮。","翁具退省，前言大误。","用与不用，智力何预。","幸同此邦，邂逅承晤。","结为金兰，安此贫素。"],0,"x195","宋"],["寿马裕斋观文 江之永，三章，章四句。 其一","陈著","四言",["江之永矣，其流汤汤。","整我六师，告成于王。"],0,"x92","宋"],["雨师五首 其五 送神用《欣安》。","郊庙朝会歌辞","四言",["牲俎告彻，嘉乐休成。","卒事有严，燕虞高灵。","蕃我民人，育我稷黍。","万有千祀，承神之祜。"],0,"x207","宋"],["东京留守宗公","《靖康小雅》作者","四言",["洪河滔滔，撼野摧山。","砥柱中立，独当狂澜。","敌势焰焰，动植俱残。","公俯视之，若萤燐然。","知无不为，独殿中原。","方事北讨，将以身先。","赤羽若日，朱旗绛天。","二贼巧沮，行或止还。","虽醢二贼，奚足偿焉。","夺之遽矣，中外悲叹。"],0,91,"宋"],["宁宗朝享三十五首 终献用《正安》。","郊庙朝会歌辞","四言",["秉德翼翼，显相肃雍。","疏幂三举，诚意益恭。","光烛黼绣，和流笙镛。","子孙众多，福禄来从。"],0,"x207","宋"],["龙眠居士画十六大阿罗汉赞 其十","李纲","四言",["长松森然，虬枝拂天。","支颐据木，仰睇玄猿。","竹树之间，方虚禅座。","我欲摄衣，往补其处。"],0,"x136","宋"],["偈颂三十首 其十五","释慧晖","四言",["佛日高悬，祖月弥朗。","僧云漫漫，法雨浩浩。","禅林花发，教风春迎。"],0,194,"宋"],["闵雨诗 其七","刘敞","四言",["疏狱省刑，与物更始。","内恕孔悲，引咎在己。","爰及四海，愚智咸喜。"],0,"x51","宋"],["老母德安县君生辰颂时湖南奉使途中作","彭汝砺","四言",["有节维冬，有载维春。","维时斯成，惟诞斯辰。","妇妾祇祇，儿女诜诜。","是笑是言，是祝是虔。","其德维何，维厚之坤。","其福维何，维北之山。","嗟尔小子，不克骏奔。","靡不肃雍，维我母贤。","无有申之，有永其年。"],0,"x143","宋"],["绍兴以后祀五方帝六十首 白帝奠玉币用《嘉安》。","郊庙朝会歌辞","四言",["惟时素秋，肇举元祀。","礼备乐作，降登有数。","洋洋在上，神既来止。","神之格思，锡我繁祉。"],0,"x207","宋"],["魏京诗 其五","刘敞","四言",["时维猃狁，侮予之疆。","靡度靡虞，跳呼以狂。"],0,"x51","宋"],["偈颂八十五首 其七十三","释妙伦","四言",["足不履地，头不顶天。","才识双涧，便见双泉。","问有今古，答无正偏。","若也未晓，细嚼黄连。"],0,10,"宋"],["四先生像赞 东莱吕成公","刘黻","四言",["探微极深，经纬万象。","不显其杰，沈潜直养。","体立同著，惟和且平。","甘雨润泽，古井渊渟。"],0,247,"宋"],["龙眠居士画十六大阿罗汉赞 其十二","李纲","四言",["敷座亲密，便于笑语。","怀抱之适，怡然相顾。","沥彼瓶液，注于掌中。","普润四大，一滴之功。"],0,"x136","宋"],["咸平亲郊八首 其八 送神用《高安》。","郊庙朝会歌辞","四言",["神驾来思，风举云飞。","神驭归止，天空露晞。"],0,"x207","宋"],["偈颂六十五首 其四十三","释普济","四言",["悉达脚下，七花八裂。","韶阳棒头，有礼有乐。"],0,73,"宋"],["偈颂三十六首 其二十八","释如珙","四言",["粪堆头上，无人觑著。","万法纷纭，自起自灭。"],0,255,"宋"],["高宗郊前朝献景灵宫二十一首 其二十一 还大次用《干安》。","郊庙朝会歌辞","四言",["帝将于郊，昭事上祀。","爰兹毕觞，复即于此。","飙游载旋，容旌沓骑。","维皇嘉承，锡祚昌炽。"],0,"x207","宋"],["景祐释奠武成王六首 其三 奠币用《明安》。","郊庙朝会歌辞","四言",["四岳之裔，凉彼武王。","发扬蹈厉，周室用昌。","追封庙食，简册增芳。","升币以奠，磬筦锵锵。"],0,"x207","宋"],["乾道七年恭上太上皇帝太上皇后尊号十一首 其五 册宝入德寿门用《正安》。","郊庙朝会歌辞","四言",["礼神颂祇，福禄来下。","不有荣名，孰缉伊嘏。","千乘万骑，鱼鱼雅雅。","皇扉洞开，鞠躬如也。"],0,"x207","宋"],["绍兴二十八年祀圜丘 升坛用《干安》。","郊庙朝会歌辞","四言",["帝临崇坛，媪神其从。","稽古合祛，并侑神宗。","升阶奠玉，诚意感通。","贶施鼎来，受福无穷。"],0,"x207","宋"],["李次仲诞辰颂","曹勋","四言",["柱史列裔，清映霞举。","环堵所礼，土木所与。","起死济民，浑迹尘土。","好生广德，密佑人主。","三千功就，易迁行著。","东恩及孙，西色仍叙。","仙不言寿，道不言古。","愿祝罗浮，五云同侣。"],0,"x103","宋"],["民情吟","邵雍","四言",["民情既乐，和气为祥。","民情既忧，戾气为殃。","祥为雨露，天下丰穰。","殃为水旱，天下凶荒。"],0,"x57","宋"],["崧高诗为九江赵使君寿  其一一","杨冠卿","四言",["永锡难老，眉寿保鲁。","以佐天子，为周室辅。"],0,61,"宋"],["崇恩太后升祔十四首 终献用《仪安》。","郊庙朝会歌辞","四言",["珩璜之贵，袆褕之尊。","天作之合，内治慈温。","元良钟庆，祉福乾坤。","以享以祀，事亡如存。"],0,"x207","宋"],["皇后庙十五首 其十二 饮福用《禧安》。","郊庙朝会歌辞","四言",["彝尊鬯酒，庆佑遂行。","介以纯嘏，允答明诚。"],0,"x207","宋"],["明堂庆成颂  其二三","徐鹿卿","四言",["若古有训，明命难谌。","虽休勿休，惟单厥心。"],0,73,"宋"]]