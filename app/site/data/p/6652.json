[["古像赞二百零五首 其一三二 柳河东","孙承恩","四言",["经术名世，翰墨绝人。","笔谏之言，有至理存。","服涴弗贺，纳嬖谏止。","诤臣之风，王魏其侣。"],0,"x290","明"],["古像赞二百零五首 其一三三 李卫公","孙承恩","四言",["风采峻凝，经济自任。","威慑强藩，王灵再振。","议论侃侃，忠勤孜孜。","克伐必行，贤者之疵。"],0,"x290","明"],["古像赞二百零五首 其一三四 周世宗","孙承恩","四言",["世宗英明，志存混一。","服强以力，怀弱以德。","武功既振，文治亦修。","宏规大度，邈焉寡俦。"],0,"x290","明"],["古像赞二百零五首 其一三五 宋太祖","孙承恩","四言",["宋祖龙兴，仁厚建国。","笃尊圣道，式著君德。","慎狱恤民，惩奢塞源。","身端化本，大哉王言。"],0,"x290","明"],["古像赞二百零五首 其一三六 宋太宗","孙承恩","四言",["显允太宗，重光御世。","修德弭灾，仁民图治。","节重山林，功略宦寺。","太平之政，蔚然可纪。"],0,"x290","明"],["古像赞二百零五首 其一三七 宋仁宗","孙承恩","四言",["穆穆仁宗，实惟盛德。","奉身清约，议论恳恻。","学勤讲筵，治法无逸。","昭陵之思，百世一日。"],0,"x290","明"],["古像赞二百零五首 其一三八 宋高宗","孙承恩","四言",["宋祚中否，高宗再兴。","五马兆祥，七庙委灵。","志亏勾践，才谢光武。","恢复成虚，遗恨千古。"],0,"x290","明"],["古像赞二百零五首 其一三九 宋孝宗","孙承恩","四言",["性资英明，治行勤励。","恢复拳拳，可质天地。","治民振武，敬天仁民。","事机屡乖，志卒弗伸。"],0,"x290","明"],["古像赞二百零五首 其一四○ 宋宁宗","孙承恩","四言",["始政清明，登用儒硕。","继体守文，兢业靡失。","内斥正学，外挑强邻。","权奸何诛，彼哉曷君。"],0,"x290","明"],["古像赞二百零五首 其一四一 宋理宗","孙承恩","四言",["允矣贤德，俨然儒绅。","表章正学，崇重关闽。","虚名独存，实践未有。","儒效不白，匪道之咎。"],0,"x290","明"],["古像赞二百零五首 其一四二 宋度宗","孙承恩","四言",["度宗绍图，国事日去。","奸邪肆行，忠义屏气。","忘情军国，恣乐宫闱。","天亡由人，巳矣曷悲。"],0,"x290","明"],["古像赞二百零五首 其一四三 赵韩王","孙承恩","四言",["天眷有宋，公实佐命。","辅相两朝，四海底定。","强敏以断，沉毅以刚。","显允有闻，式重庙堂。"],0,"x290","明"],["古像赞二百零五首 其一四四 曹武惠王","孙承恩","四言",["懿美济阳，仁厚慎敬。","总师专征，武略亦竞。","义杀不妄，秋毫不私。","一代元戎，忠贞无疵。"],0,"x290","明"],["古像赞二百零五首 其一四五 吕文穆公","孙承恩","四言",["太宗重光，文穆柄政。","悃悃其厚，侃侃其正。","孰侮孰诬，我嘿我容。","休休其中，大臣之风。"],0,"x290","明"],["古像赞二百零五首 其一四六 寇忠悯公","孙承恩","四言",["立朝侃侃，直道靡顾。","致身鼎铉，秉节清素。","手扶日毂，不震不凌。","社稷之功，莫能与京。"],0,"x290","明"],["古像赞二百零五首 其一四七 李文靖公","孙承恩","四言",["和靖镇俗，忧勤励君。","体国寥寥，孰知公心。","天书矫诬，新法乱政。","异言纷纷，始颂公圣。"],0,"x290","明"],["古像赞二百零五首 其一四八 王文正公","孙承恩","四言",["王公盛德，休休其容。","人讦我誉，荐贤为公。","智名勇能，公无可述。","致时太平，乃见公绩。"],0,"x290","明"],["古像赞二百零五首 其一四九 晏元献公","孙承恩","四言",["以臣事君，大臣之义。","公在相位，实克有是。","嫉恶匪隘，检身益严。","弗丏恩泽，世称尔贤。"],0,"x290","明"],["古像赞二百零五首 其一五○ 韩魏公","孙承恩","四言",["魏公间气，崇志雅量。","乘时奋庸，出将入相。","表仪朝著，正笏垂绅。","光辅三帝，社稷之臣。"],0,"x290","明"],["古像赞二百零五首 其一五一 范文正公","孙承恩","四言",["德行纯备，贞金粹玉。","风节峻厉，霜松雪竹。","先忧后乐，思济斯民。","一代贤相，前后绝伦。"],0,"x290","明"],["古像赞二百零五首 其一五二 富郑公","孙承恩","四言",["志节皎皎，忠勤劬劬。","国有宪章，恪遵弗渝。","奖善若培，去恶如莠。","大臣之事，君子之守。"],0,"x290","明"],["古像赞二百零五首 其一五三 文潞公","孙承恩","四言",["休休元臣，堂堂大耄。","端雅静重，镇压浮躁。","危疑定策，社稷之功。","天下异人，夷使改容。"],0,"x290","明"],["古像赞二百零五首 其一五四 欧阳文忠公","孙承恩","四言",["勋业闻望，韩范并驰。","古文奥学，匹休昌黎。","复三代醇，黜五季陋。","一代宗工，孰居其右。"],0,"x290","明"],["古像赞二百零五首 其一五五 胡直讲","孙承恩","四言",["经术名家，旁通乐律。","苏湖之教，造士有术。","束以条格，率以躬行。","百世一时，尚怀典刑。"],0,"x290","明"],["古像赞二百零五首 其一五六 包孝肃公","孙承恩","四言",["面目棱棱，刚气烈烈。","势力苞苴，莫我敢敚。","严肃者政，苛刻匪心。","非汉法吏，乃古直臣。"],0,"x290","明"],["古像赞二百零五首 其一五七 蔡端明","孙承恩","四言",["吏事严明，绰有异政。","辞翰精美，传播夷境。","矫命非抗，风节在兹。","进茶效忠，贤者之疵。"],0,"x290","明"],["古像赞二百零五首 其一五八 刘集贤","孙承恩","四言",["天禄石渠，野史稗官。","博学洽闻，莫与子班。","忠信而恭，方大以直。","庶几其全，后学之式。"],0,"x290","明"],["古像赞二百零五首 其一五九 徐节孝","孙承恩","四言",["孝不为名，廉不矫世。","吾尽吾心，吾安吾义。","晚膺荐书，乐育多士。","训告数辞，听者兴起。"],0,"x290","明"],["古像赞二百零五首 其一六○ 张忠定公","孙承恩","四言",["刚气自负，奇节自喜。","中庸或乖，顽懦愧死。","正论难合，直道不容。","一代名臣，孰能置公。"],0,"x290","明"],["古像赞二百零五首 其一六一 李旴江","孙承恩","四言",["才质俊辨，制作明洁。","考定明堂，博采众说。","周礼有论，平土有书。","疑孟何为，见斥后儒。"],0,"x290","明"],["古像赞二百零五首 其一六二 程大中","孙承恩","四言",["其心悃悃，其行慥慥。","老成典刑，克慎家教。","钟和毓粹，笃生二贤。","寻源究本，后世式瞻。"],0,"x290","明"],["古像赞二百零五首 其一六三 周元公","孙承恩","四言",["天不丧道，乃生哲人。","建图著书，发挥道真。","德容清和，襟度朗彻。","俨如见之，光风霁月。"],0,"x290","明"],["古像赞二百零五首 其一六五 程正公","孙承恩","四言",["气质刚方，文理密察。","造诣精深，体用毕达。","任道之重，卫道之严。","孟氏似之，泰山岩岩。"],0,"x290","明"],["古像赞二百零五首 其一六六 邵康节","孙承恩","四言",["学探造化，穷高极微。","德安以成，清和坦夷。","安乐窝中，包宙括宇。","击壤千篇，诗家异趣。"],0,"x290","明"],["古像赞二百零五首 其一六七 张明公","孙承恩","四言",["张子严毅，德成以礼。","实践躬行，精思妙契。","东西二铭，醇乎其醇。","井田为治，惜志不伸。"],0,"x290","明"],["古像赞二百零五首 其一六八 司马文正公","孙承恩","四言",["熙宁谏诤，忠谠切深。","元祐相业，旋干转坤。","行成无伪，学几不杂。","一德醇儒，百年清节。"],0,"x290","明"],["古像赞二百零五首 其一六九 吕正献公","孙承恩","四言",["政尚宽厚，性秉纯实。","时维司马，同心一德。","元祐并相，力挽化机。","赵祀三百，培植在兹。"],0,"x290","明"],["古像赞二百零五首 其一七○ 曾文定公","孙承恩","四言",["文宗汉秦，学探理致。","开源濂洛，祖述洙泗。","经术为治，可据而施。","汉有刘向，子其庶几。"],0,"x290","明"],["古像赞二百零五首 其一七一 苏文忠公","孙承恩","四言",["伟气雄才，大节孤忠。","立朝非达，居夷匪穷。","傲睨千古，挥斥八极。","𪫺人鄙夫，仰公褫魄。"],0,"x290","明"],["古像赞二百零五首 其一七二 黄文节公","孙承恩","四言",["孝友天性，文学夙成。","诗擅名家，匹休少陵。","砺节困穷，忘情富贵。","党锢诸贤，公实无愧。"],0,"x290","明"],["古像赞二百零五首 其一七三 吕荥阳公","孙承恩","四言",["博师群儒，刻意践履。","恬素自安，志薄进取。","习静虽学，死心病仁。","一蹴造圣，或误后人。"],0,"x290","明"],["古像赞二百零五首 其一七五 杨文靖公","孙承恩","四言",["晚年立雪，早坐春风。","天理人欲，蝉蜕冰融。","纯粹和平，朴实简易。","出处之迹，下惠或似。"],0,"x290","明"],["古像赞二百零五首 其一七六 李忠定公","孙承恩","四言",["一用靖康，镇遏披猖。","再用绍兴，方成朝廷。","筹策未终，斥逐随继。","疏草具在，读之出涕。"],0,"x290","明"],["古像赞二百零五首 其一七七 岳武穆王","孙承恩","四言",["性本忠义，神授勇力。","正气弗阿，克胜无敌。","赤手障澜，挥戈回日。","计成偃月，此恨何极。"],0,"x290","明"],["古像赞二百零五首 其一七八 朱韦斋","孙承恩","四言",["早力文词，方驾韩欧。","晚窥圣学，宗师程周。","知言之微，知德之奥。","成子大儒，克任斯道。"],0,"x290","明"],["古像赞二百零五首 其一七九 李延平","孙承恩","四言",["早岁豪迈，中更纯粹。","造诣既深，涵养亦至。","冰壶秋月，表里莹然。","考亭雅范，濂洛正传。"],0,"x290","明"],["古像赞二百零五首 其一八○ 朱文公","孙承恩","四言",["道纯德备，理明义精。","具圣人体，集诸儒成。","秋肃春温，海涵岳峙。","斯文桢干，后学仪矩。"],0,"x290","明"],["古像赞二百零五首 其一八一 张宣公","孙承恩","四言",["颖悟夙成，大本先立。","识见粹纯，践履笃实。","明体适用，志意伟然。","义利之辨，式示大闲。"],0,"x290","明"],["古像赞二百零五首 其一八二 吕成公","孙承恩","四言",["气备中和，心涵古今。","克治之勇，涵养之深。","宗程翼朱，共相斯道。","中原文献，惟子是绍。"],0,"x290","明"],["古像赞二百零五首 其一八三 陆文安公","孙承恩","四言",["学探本原，先立大体。","作圣功夫，直捷简易。","高明自得，灭裂则诬。","圣道大中，岂容殊途。"],0,"x290","明"],["古像赞二百零五首 其一八四 陈文毅公","孙承恩","四言",["经济大志，恢复雄图。","慷慨谈兵，气激懦夫。","道兼王霸，论杂义利。","要之圣门，异乎不异。"],0,"x290","明"],["古像赞二百零五首 其一八五 黄文肃公","孙承恩","四言",["早承师训，体认佩服。","明睿端庄，造诣纯笃。","昌明光大，不迷真传。","订正三礼，后学赖焉。"],0,"x290","明"],["古像赞二百零五首 其一八六 蔡文节公","孙承恩","四言",["精识博闻，英气伟才。","一时师门，邈焉寡侪。","礼乐象数，性命道德。","考订发挥，俟圣不惑。"],0,"x290","明"],["古像赞二百零五首 其一八七 蔡九峰","孙承恩","四言",["帝王治道，典册具布。","秦人毁裂，汉儒训诂。","微辞奥义，湮塞晦蒙。","子能发挥，百代尔宗。"],0,"x290","明"],["古像赞二百零五首 其一八八 刘文简公","孙承恩","四言",["学本考亭，邹鲁的传。","旁参东莱，亦会其源。","表章四书，经筵启沃。","体国忠诚，备见三略。"],0,"x290","明"],["古像赞二百零五首 其一八九 真文忠公","孙承恩","四言",["求道孜孜，正学是继。","立朝侃侃，力扶大义。","衍义一书，发挥详明。","执此以治，王道以成。"],0,"x290","明"],["古像赞二百零五首 其一九○ 文丞相","孙承恩","四言",["烈烈文山，忠节孤劲。","身荷纲常，还报列圣。","正气不亡，百世犹昨。","山川峙流，风霆磅礴。"],0,"x290","明"],["古像赞二百零五首 其一九一 谢叠山","孙承恩","四言",["蚤岁英迈，议论激发。","晚遭崎岖，不失臣节。","饱忠饫义，我腹匪枵。","充然而归，文山并高。"],0,"x290","明"],["古像赞二百零五首 其一九二 饶双峰","孙承恩","四言",["道发紫阳，莹彻具足。","子也成学，笃志佩服。","尊德道问，益精以详。","离同合异，将无赘厖。"],0,"x290","明"],["古像赞二百零五首 其一九三 元世祖","孙承恩","四言",["雄武以断，聪明而仁。","扶舆间气，笃生此人。","驱策贤豪，振扬武烈。","继统中华，式钦大业。"],0,"x290","明"],["古像赞二百零五首 其一九四 耶律文正王","孙承恩","四言",["用夏变夷，辅仁胜杀。","弥缝化工，洗濯日月。","创立帝制，底绥民生。","仁者之功，孰能与京。"],0,"x290","明"],["古像赞二百零五首 其一九五 临淮王","孙承恩","四言",["临淮桓桓，严凝若神。","百万貔貅，御如一人。","讨定江南，混一九土。","武功洸洸，永载盟府。"],0,"x290","明"],["古像赞二百零五首 其一九六 刘文正公","孙承恩","四言",["脱迹空门，致身台铉。","大计密谋，忠勤不倦。","滦京崇崇，王气所钟。","定鼎宅中，召公之功。"],0,"x290","明"],["古像赞二百零五首 其一九七 许文正公","孙承恩","四言",["尊闻行知，潜心圣道。","岂惟堂基，巳及阃奥。","司马笃实，伯子粹纯。","考亭之后，见子一人。"],0,"x290","明"],["古像赞二百零五首 其一九八 程文宪公","孙承恩","四言",["贞柔不失，大雅有容。","昭回制作，文饰帝躬。","敦凝厚庞，像或其侣。","望之俨然，可愧薄鄙。"],0,"x290","明"],["古像赞二百零五首 其一九九 姚文献公","孙承恩","四言",["立志卓越，倡道苏门。","上溯邹鲁，下探关闽。","謇谔在朝，立纲陈纪。","身尊道行，莫窥其际。"],0,"x290","明"],["古像赞二百零五首 其二○○ 廉文正公","孙承恩","四言",["庙堂陈谟，方面专制。","渊渊嘉猷，烈烈正气。","轲训义利，孔戒孝忠。","一世人豪，呜呼廉公。"],0,"x290","明"],["古像赞二百零五首 其二○一 刘文靖公","孙承恩","四言",["宅心高明，立志坚勇。","择义既精，任道亦重。","泥涂轩冕，寤寐圣贤。","威凤九霄，其飞翩翩。"],0,"x290","明"],["古像赞二百零五首 其二○二 吴文正公","孙承恩","四言",["少而英迈，晚就平实。","潜心六经，殚力著述。","道明业广，德盛礼恭。","北许南吴，并称儒宗。"],0,"x290","明"],["古像赞二百零五首 其二○三 赵文敏公","孙承恩","四言",["前代王孙，异时翰学。","粹质令仪，高吟大作。","绘事拟圣，墨妙入神。","文采风流，照映后人。"],0,"x290","明"],["古像赞二百零五首 其二○四 许文懿公","孙承恩","四言",["山川蕴灵，哲人继出。","子承三贤，亦克绍述。","沿流溯源，直穷昆仑。","紫阳之道，得子益尊。"],0,"x290","明"],["古像赞二百零五首 其二○五 虞文靖公","孙承恩","四言",["魁凝巨人，淹贯博学。","探求本原，驰骋制作。","经纶之妙，寓于文辞。","弗尽厥用，后世惜之。"],0,"x290","明"],["桑溪禊饮诗二首 其一","徐熥","四言",["春风载柔，遵彼长林。","我有旨酒，与子同斟。","幽怀既惬，玄想弥深。","悠悠逝波，实怆我心。"],0,"x291","明"],["绣岭寿藏四景 其三 前泉","邵宝","四言",["我泉我池，源源其来。","我池我泉，不绝涓涓。","既清且涟，汇于我前，何千百年。"],0,"x292","明"],["绣岭寿藏四景 其四 后岭","邵宝","四言",["岭兮如屏，孰为之绣。","彼桃万株，厥亦惟旧。","山之苍苍，朝烟夕霞。","千载武陵，非仙家邪。"],0,"x292","明"],["升彼高堂为毛太安人寿","顾清","四言",["升彼高堂，酌其兕觥。","兕觥欣欣，春酒载盈。","维彼硕人，是介是承。","硕人雍雍，厥德洵美。","载其有家，维惠恭止。","维惠恭止，休其承祉。","其祉伊何，兰茁其芽。","处也家宝，出维国华。","国华有辉，维帝宠嘉。","锡之鸾书，曰汝之报。","汝考汝母，汝迪汝教。","维往莫追，生也永耀。","硕人拜命，弗掖弗持。","珠翟霞裳，象服孔宜。","邦人来观，秩秩其仪。","其仪秩秩，其容有怿。","乃筵斯堂，乃几斯席。","硕人燕胥，笾豆有绎。","维南有山，维东有海。","硕人寿考，终燕乐岂。","山石弗砺，海波弗尘。","维彼硕人，于千百春。"],0,"x293","明"],["为定默然题吴僧画兰二首 其一","顾清","四言",["猗猗芳兰，在彼幽谷。","孰为我徒，清泉修竹。","清泉涓涓，修竹苍苍。","荪也可人，蔚乎相望。","明窗若空，左右图史。","永言诸君，乐自今始。"],0,"x293","明"],["为定默然题吴僧画兰二首 其二","顾清","四言",["吴有高人，得笔三昧。","洒墨飞空，坠不沾地。","化为幽兰，殊妙特妍。","相所于归，繄定默然。","煜煜者兰，岩岩者石。","咨尔丛林，兹焉作式。"],0,"x293","明"],["初夏","区大相","四言",["滔滔孟夏，品物洁齐。","日月于迈，我心孔凄。","中园有槿，其叶萋萋。","芰荷出水，桃李成蹊。","春花昨荣，落而为泥。","今者谈宴，诘旦乖暌。","大块劳生，形役志迷。","良会几何，用兹惋懠。","灼灼丹葩，煌煌赤圭。","君子服之，以和天倪。","山则多云，水则盈溪。","挐舟溯梁，渚钓林栖。","瞻彼白驹，驾我青鹥。","与二三子，于攀于跻。"],0,"x294","明"],["励志诗 其一","区大相","四言",["有大人者，德业日新。","彼虽圣哲，聿用忧勤。","嗟余小子，舜我何人。","少也失学，壮而无闻。"],0,"x294","明"],["励志诗 其二","区大相","四言",["在昔弱龄，粗事诗书。","鬒发其蓬，税驾焉如。","朝华夕殒，奄忽居诸。","我匪乔松，其能久欤。"],0,"x294","明"],["励志诗 其三","区大相","四言",["不树不艺，曷望秋获。","不斲不削，曷施丹雘。","我疆我室，是咨是度。","勿为胡成，不殖将落。"],0,"x294","明"],["励志诗 其四","区大相","四言",["上善若水，是以有德。","下士闻道，笑而不识。","鹪鹩巢林，卑栖自溺。","大鹏扶摇，汝将安适。"],0,"x294","明"],["励志诗 其五","区大相","四言",["嗟我不淑，实昧前算。","刚而不克，柔而靡断。","方覆一篑，废涂于半。","泛泛中流，茫茫道岸。"],0,"x294","明"],["励志诗 其六","区大相","四言",["鸿鹄高飞，必用羽仪。","如何中路，弃我如遗。","非彼弃我，我实荒斯。","迁善改过，来犹可追。"],0,"x294","明"],["励志诗 其七","区大相","四言",["人亦有言，下流莫处。","高岸为谷，百恶是注。","祸福之门，贤者所杜。","慎尔发机，荣辱之主。"],0,"x294","明"],["励志诗 其八","区大相","四言",["人亦有言，功崇惟志。","云胡弗竞，希骥则骥。","大人所履，小子所视。","矧兹秽陋，能不思企。"],0,"x294","明"],["励志诗 其九","区大相","四言",["畴能不细，而丰于大。","畴能不迩，而远是迈。","积水成渊，累土成岱。","不积不累，厥功攸替。"],0,"x294","明"],["励志诗 其十","区大相","四言",["滔滔逝者，日月其遒。","烈士壮心，奚必凛秋。","嗟我怀思，在彼中洲。","望而不见，我心伤忧。"],0,"x294","明"],["三月三日拟兰亭体","区大相","四言",["四时之乐，惟此暮春。","偕我良俦，祓彼涧滨。","兴言觞咏，陶写天真。","仰睇飞羽，俯察游鳞。"],0,"x294","明"],["朔风吹缨五章送焦弱侯修撰","区大相","四言",["朔风吹缨，代马悲鸣。","往送我友，言返旧京。","我无羽翼，与子偕行。","匪耽爰处，永弃休明。","离觞未御，夙驾徂征。","瞻望靡及，言以宣情。","鸳鸯在梁，载戢其羽。","昕嬉玉水，夕宿兰渚。","虞者张罗，巧中其侣。","载飞载鸣，东西失所。","永乖形影，隔绝笑语。","岂不尔思，怅望伊阻。","翩翩玄隼，集于高隅。","矜彼腐鼠，逐我鹓雏。","我欲弯弓，畏彼狂且。","玄阴漠漠，雨雪载途。","子之去矣，敬慎尔躯。","清静恬淡，为道之腴。","我友自南，罹谗而逝。","悠悠彼天，而奸是惠。","蒙蒙棘榛，植于阶陛。","如何周道，容此芜秽。","有客有客，先子云迈。","心之烦矣，涕集于袂。","我谓我友，省已靡愆。","彼骄者子，狂言便便。","扃钥不慎，盗将入门。","利口覆邦，彼妇逐贤。","青蝇青蝇，白壁何冤。","是非之原，众所共惛。","如何君子，遽惑谗言。"],0,"x294","明"],["梦竹篇三章赠吴孝父","区大相","四言",["丛丛绿竹，傍渭临淇。","中通外直，露箨风枝。","其人虽往，其竹不移。","瞻望考兮，悠悠梦思。","丛丛绿竹，植于中林。","中林何有，有书有琴。","硕人所处，十亩其阴。","思而不见，梦也是寻。","我思绿竹，于焉游傲。","清风未泯，明月来照。","厥林维贤，厥笋维孝。","匪竹则梦，中心是悼。"],0,"x294","明"],["庚子三月三日再效兰亭体","区大相","四言",["春芳时暮，景和气融。","轻飙散霭，薄霞被峰。","临川叹逝，出谷吟风。","高揖巢许，远慕乔松。"],0,"x294","明"],["淇上三章","区大相","四言",["淇水悠悠，竹竿翛翛。","静言思子，惜无轻舟。","淇水弥弥，竹竿离离。","愿言见子，惜无榜师。","既具我舟，亦伐我榜。","方之泳之，将子是访。","滔滔临淇，实劳我思。"],0,"x294","明"],["寿颂三章","区大相","四言",["碧草既菲，朱华载扬。","薰风扇箔，溽露沾裳。","郁郁灵萱，植于北堂。","茂兹永日，式举瑶觞。","瑶觞式举，琴瑟在御。","间以笙簧，杂以宝璐。","彩服有烂，和乐且孺。","锡厥孙子，亦洽宾序。","何以献之，九霞之醴。","曷其侈矣，冰桃玉李。","何以申之，婺星之纪。","曷其侈矣，于西王母。"],0,"x294","明"],["三礼诗三首 其一 皇太子册立诗","区大相","四言",["于昭皇明，十叶惟圣。","引祚自天，敷祐厥命。","百辟是钦，四方是正。","咸建国本，以绥家庆。","帝衍其昌，缵服其光。","载辑人纲，载锡天常。","孝慈用章，福履无疆。","奠丕丕基，以定厥祥。","厥有圣嗣，惟皇元子。","睿聪夙成，令闻蔚起。","天之所置，孰俪懿美。","式灵震器，以享以祀。","如彼玉润，蕴德不瑕。","如彼朝阳，协于重华。","山川鬼神，罔不宠嘉。","凡厥内外，系心靡他。","维昔廷言，冀光大典。","帝命曰吁，天序丕显。","尚其弱龄，学于黾勉。","无庸骤尊，而骄不腆。","乃列坟史，乃翼师儒。","时敏厥修，日新与俱。","群公矢谟，元良在图。","帝命曰俞，万邦作孚。","乃诹礼司，庀是仪服。","乃虔时日，以先太卜。","象辂鸾旌，有贲执玉。","左右视听，百尔祇肃。","厘兹册宝，有穆其容。","践位储贰，俾朝于东。","并建诸王，蕃屏维宗。","覃惠自公，殊方攸同。","济济宫寮，保傅是弼。","既曜春华，亦乘秋实。","诏美导和，庶士维吉。","启以三善，崇以四术。","思皇帝胄，遹骏贻谋。","眷命悠悠，底于千秋。","敬承维夏，继述有周。","矢诗宣猷，以扬鸿休。"],0,"x294","明"],["三礼诗三首 其二 皇太子冠礼诗","区大相","四言",["吉日惟良，命服惟元。","集礼铜龙，烂其盈门。","宫僚肃将，以承前轩。","衮冕有加，其道弥尊。","衮冕峨峨，既曼且硕。","采璂朱绂，瑶契金册。","宠兹成德，圣祖列辟。","式光宗祏，皇心孔怿。","皇醴东朝，训命告厘。","念厥毗倚，淑是令仪。","裕民惟志，寿国惟祺。","睿敏圣嗣，敬德不违。","圣嗣敬德，诞受多福。","霭其如春，式其如玉。","象贤攸属，令终有勖。","作颂孔穆，风言维祝。","厥颂伊何，于际于蟠。","厥讽伊何，慎防其端。","方圆以翊，中正以观。","保兹燕誉，奕世不刊。"],0,"x294","明"],["三礼诗三首 其三 皇太子婚礼诗","区大相","四言",["两仪既定，阴阳斯位。","于皇储圣，惟德是媲。","自天之祐，罔不淳备。","乃启甲观，而登淑懿。","苑桃之华，有烨其光。","馥彼兰宫，达于椒房。","乃登文币，以定厥祥。","元祚其昌，嘉命之将。","德音孔惠，人神作缔。","在妫之汭，在姬之渭。","女史有纪，彤管有炜。","以其良娣，威仪棣棣。","威仪静幽，君子好逑。","佩瑜鸣球，羽葆文辀。","八鸾啾啾，曰闲以柔。","从车如流，归于龙楼。","帝道蕃茂，垂裕厥后。","庆成入奏，左右忭舞。","酌彼醇酬，以其玉斗。","群公稽首，天子万寿。"],0,"x294","明"],["寿域诗四章为庄得全编修尊人作","区大相","四言",["煌煌寿域，光于南斗。","包孕群生，诞锡惟厚。","鸾凰是藩，麟鹿是囿。","碧草朱华，以繁以茂。","南斗之下，是为星沙。","环以绿水，夹以丹霞。","于焉逍遥，其乐孔嘉。","俾尔寿谷，德音不瑕。","南斗之傍，爰开玉堂。","皇降嘉赉，有烂其光。","玉树琼柯，有芬其芳。","俾尔昌炽，德音孔扬。","绵绵星沙，寿域所届。","济济玉堂，寿域所会。","及尔子孙，亦昌以大。","介兹景福，永寿无害。"],0,"x294","明"],["太和山铭","区大相","四言",["穹窿太和，上参冥莫。","近接嵩华，远拔衡霍。","明后有作，是称灵岳。","上帝攸居，天柱是度。","赫赫成后，玄戈再援。","神之相之，用武以断。","穆穆肃皇，中兴江汉。","神之启之，守文以缵。","巍巍天柱，前俯璚台。","层城万仞，上应中台。","地轴盘结，云汉昭回。","灵踪久閟，真路乍开。","爰饰云构，造于中天。","冠峰被麓，舄奕墟躔。","丹碧霞焕，栋宇星悬。","势侔太一，巧极望仙。","神之所妥，钩陈营卫。","鞭风驾霆，出入云际。","神之所临，征灵表异。","康国阜民，克显于世。","玄圃之峦，仁后所履。","丹丘之屺，仙灵所倚。","咸障大荒，曷窥元始。","追茂至道，孰逾斯美。","惟兹崇报，前掩禅封。","在帝左右，罔或不共。","四气顺序，万方景从。","昭佑我明，受福无穷。"],0,"x294","明"]]