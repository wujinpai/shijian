[["绍兴朝会十三首 其一 群臣酒行用《正安》。","郊庙朝会歌辞","四言",["群公卿士，咸造在庭。","式燕以衎，思均露零。","穆穆明明，于斯为盛。","归美报上，一人有庆。"],0,"x207","宋"],null,null,["咸平藉田回仗御楼二首 其一 《采茨》。","郊庙朝会歌辞","四言",["农皇既祀，礼毕躬耕。","商辂旋轸，周颂腾声。","观魏将陟，服御爰更。","舆人瞻仰，如日之明。"],0,"x207","宋"],["干兴御楼二首 其一 升坐用《隆安》。","郊庙朝会歌辞","四言",["夹钟纪月，初吉在辰。","眚灾流庆，布德推仁。","采章震耀，典礼具陈。","茂昭丕贶，永庇斯民。"],0,"x207","宋"],["绍兴登门肆赦二首 其一 升坐用《干安》。","郊庙朝会歌辞","四言",["拜况于郊，皇哉唐哉。","熙事休成，六𬴂鼎来。","天阃以决，地垠以开。","𬯎祉发祥，如登春台。"],0,"x207","宋"],["宁宗登门肆赦二首 其一 升坐用《干安》。","郊庙朝会歌辞","四言",["帝飨于郊，荷天之休。","五福敷锡，皇明烛幽。","云行雨施，仁翔德游。","圣人多男，歌颂九州。"],0,"x207","宋"],["明道元年章献明肃皇太后朝会十五首 其一 群臣酒行用《礼安》。","郊庙朝会歌辞","四言",["肃肃临下，有威有容。","循循事上，惟信惟忠。","盛礼兴乐，示慈训恭。","君臣协吉，惟道之从。"],0,"x207","宋"],["明道元年章献明肃皇太后朝会十五首 其一 酒一行毕作《厚德无疆之舞》。","郊庙朝会歌辞","四言",["尧母之圣，放勋为子。","同心协谋，柔远能迩。","以德康俗，以文兴治。","斯焉象功，罔不昭济。"],0,"x207","宋"],["明道元年章献明肃皇太后朝会十五首 其一 酒再行作《四海会同之舞》。","郊庙朝会歌辞","四言",["七德之舞，四朝用康。","有如姬姒，助集周邦。","威克厥爱，居安不忘。","风旋山立，济济皇皇。"],0,"x207","宋"],["治平皇太后皇后册宝三首 其一 皇帝升坐用《干安》。","郊庙朝会歌辞","四言",["王化之始，治繇内孚。","时庸作命，玉简金书。","磬筦在庭，其纵绎如。","天临法扆，礼与诚俱。"],0,"x207","宋"],["熙宁皇太后册宝三首 其一 出入用《正安》。","郊庙朝会歌辞","四言",["煌煌凤字，玉气宛延。","天门崛岉，飞骖后先。","龙簨四合，奏鼓渊渊。","母仪天下，何千万年。"],0,"x207","宋"],["哲宗上太皇太后册宝五首 其一 皇帝升坐用《干安》。","郊庙朝会歌辞","四言",["大矣孝熙，帅民以躬。","奉承宝册，钦明两宫。","万乐具举，一人肃雍。","化繇上始，四海来同。"],0,"x207","宋"],null,["淳熙二年发太上皇帝太上皇后册宝十一首 其一 册宝降殿用《正安》。","郊庙朝会歌辞","四言",["高明者干，博厚者坤。","以清以宁，资始资生。","寿胡可度，德胡可评。","愿言从欲，诞受强名。"],0,"x207","宋"],null,null,null,null,["绍定三年寿明仁福慈睿皇太后册宝九首 其一","郊庙朝会歌辞","四言",["思齐圣母，媲于周任。","体干履坤，博厚洪深。","七帙既启，万寿自今。","昕庭发号，式昭德音。"],0,"x207","宋"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["御楼","郊庙朝会歌辞","四言",["五辂鸣鸾，八神警跸。","天官景从，莫不祗栗。","祲威盛容，昭哉祖述。","祚我无疆，叶气充溢。","青坛帝籍，在国之东。","荐笾执耜，率礼和容。","鸣鸾回跸，瑞气凝空。","万方瞻仰，百顺来同。","重城春满，双阙云浮。","将披雉扇，载俨珠旒。","叶风应律，文德怀柔。","溥天率土，惠泽咸周。","恩覃春煦，令布风驰。","声名昭晰，文物葳蕤。","重森宝扇，将降端闱。","永光国典，翕受天祺。"],0,"x207","宋"],null,null,["采菊","黄庭坚","四言",["南山有菊，于采其英。","谁从汝往，视我茕茕。","伊时之人，谁适有比。","不与我谋，不知其已。","薄言采之，遵彼山曲。","汝来迟迟，去我何速。","伊时之人，谁适与同。","不与我好，殆其觏凶。","江汉滔滔，有楫有杭。","谁以济此，中流且风。","嗟尔君子，时处时默。","微云反复，无伤尔足。"],0,"x66","宋"],["流水","黄庭坚","四言",["一溪之水，可涉而航。","人不我直，我犹力行。","一溪之水，不杠而涉。","濡首中流，汝嗟何及。","汤汤流水，可以休兮。","嗟行之人，则濯足兮。"],0,"x66","宋"],["种药苗二首 其一 种罂粟","苏辙","四言",["筑室城西，中有图书。","窗户之馀，松竹扶疏。","拔棘开畦，以毓嘉蔬。","畦夫告予，罂粟可储。","罂小如罂，粟细如粟。","与麦皆种，与穄皆熟。","苗堪春菜，实比秋谷。","研作牛乳，烹为佛粥。","老人气衰，饮食无几。","食肉不消，食菜寡味。","柳槌石钵，煎以蜜水。","便口利喉，调养肺胃。","三年杜门，莫适往还。","幽人衲僧，相对忘言。","饮之一杯，失笑欣然。","我来颍川，如游庐山。"],0,"x135","宋"],["种药苗二首 其二 种决明","苏辙","四言",["闲居九年，禄不代耕。","肉食不足，藜烝藿羹。","多求异蔬，以佐晨烹。","秋种罂粟，春种决明。","决明明目，功见本草。","食其花叶，亦去热恼。","有能益人，矧可以饱。","三嗅不食，笑杜陵老。","老人平生，以书为累。","夜灯照帷，未晓而起。","百骸未病，两目告瘁。","决明虽良，何补于是。","自我知非，卷去图书。","闭目内观，妙见自如。","闻阿那律，无目而视。","决明何为，适口乎尔。"],0,"x135","宋"],null,null,null,null,["题石民瞻兰石邓觉非画兰","龚璛","四言",["石子画石，积墨如山。","化为邓林，兰生竹间。","我怀古人，见此粲者。","草木臭味，日月潇洒。"],0,218,"宋"],["题李伯时三教图卷 其一","李纲","四言",["祖师西来，亿劫谁伍。","眷焉摩尼，烛此下土。","沧海津梁，脱离幽苦，至哉流宗，以振聋瞽。"],0,"x136","宋"],null,null,["盘居六章","项安世","四言",["宝峰之阴，其山深深。","有美一人，琼弁玉簪。","云居之阳，其水洋洋。","有美一人，霞衣月裳。","山之纡纡，密云所庐。","彼盘之人，亦丰厥储。","山之营营，众流所经。","彼盘之人，亦溥厥成。","渐以中上，屯以正行。","匪盘之异，惟物之情。","行止盘盘，其乐孔多。","请以是居，子如之何。"],0,"x55","宋"],null,null,["政和二年余谪海外馆琼州开元寺俨师院遇其游行市井宴坐静室作务时恐缘差失念作日用偈八首","惠洪","四言",["一切境界，病眼倒见。","但静意根，空慧自现。","一切境界，随念而至。","念未生时，髑髅是水。","道人何故，淫坊酒肆。","我自调心，非干汝事。","一日不作，一日不食。","谁其嗣之，我有遗则。","折脚铛子，随处安置。","食无精粗，但欲接气。","心欲驰散，即当摄来。","大火聚中，青莲花开。","此障道法，上品盖缠。","是何时节，乃复安眠。","沙弥嗜乳，作乳中虫。","三篾高道，一钵孤风。"],0,"x42","宋"],["永明禅师真赞二首","惠洪","四言",["三界种性，有万妍丑。","生顺死逆，梦夜想昼。","往复无间，声度垣牖。","皆依末那，戏论成就。","而末那体，无作无受。","譬如空花，实无而有。","一念了知，光明通透。","我如是见，无有错谬。","是为心宗，祖佛授手。","孰振颓纲，秀杰奇茂。","稽首永明，月临星斗。","以公风神，为我律度。","交神见之，是真保护。"],0,"x42","宋"],null,null,null,null,["赤城六章章四句","释居简","四言",["赤城峨峨，霞摽错摩。","笃生斯人，绝超凡科。","峨峨赤城，磅礴九地。","斯人笃生，水瘦石悴。","念昔三辅，湖独纷委。","逮公来斯，苕霅泾渭。","千里寿公，祷公寿康。","惠洽兆庶，日飞百觞。","伊我无酒，注彼觓兕。","愿公华衮，式昌厥嗣。","亦复愿公，啸吟紫微。","㑭我紫微，嬉其莞而。"],0,"x94","宋"],null,null,["缘识 其二十六","赵炅","四言",["具蹄凡夫，何行何著。","静锁天台，高知嵩岳。","拘束迷情，人天离乐。","圣境芝兰，名山采药。","啖柏餐松，清神去浊。","入口馨香，风和露嚼。","可以放旷，千年之鹤。","审取来由，勿自系缚。","洞有桃源，化成云阁。","上有凤皇，下水鱼跃。","本从自然，岂用图度。"],0,"x63","宋"],["缘识 其三十七","赵炅","四言",["忙即但忙，闲即便闲。","无为之见，与道相关。","言虽鄙俚，勿生谤毁。","利他何疑，嗔乃兴喜。","善恶万端，古今如此。","非善称君，非过称己。","道大幽玄，世使如然。","君临宇宙，辅弼须贤。","求之不见，形表影连。","论而非细，我惭知愧。","救世心劳，方便之智。","短又何难，长又何易。","真实语言，勿将为戏。"],0,"x63","宋"],["寿马裕斋观文 山之高，三章，章四句。","陈著","四言",["天作高山，大邦之屏。","外御其侮，王国庶定。","维石岩岩，维德之基。","天实为之，是以似之。","人亦有言，如山之寿。","万有千岁，保艾尔后。"],0,"x92","宋"],["寿马裕斋观文 东山，二章，章四句。","陈著","四言",["我徂东山，以敖以游。","彼采葛兮，谓我何求。","凤凰于飞，出自幽谷。","载好其音，集于灌木。"],0,"x92","宋"],["寿马裕斋观文 有鹤，三章，章四句。","陈著","四言",["有鹤在林，怀之好音。","载飞载止，食野之芩。","倡予和汝，爰得我所。","何斯违斯，自贻伊阻。","陟彼崔嵬，岂不怀归。","英英白云，跂予望之。"],0,"x92","宋"],["寿马裕斋观文 江之永，三章，章四句。","陈著","四言",["江之永矣，其流汤汤。","整我六师，告成于王。","春日载阳，薄言采芑。","泳之游之，民之洽矣。","清且沦漪，有美一人。","怀哉怀哉，率土之滨。"],0,"x92","宋"],null,null,null,["南有刺","曾丰","四言",["南有刺蓐，又有刺竹。","有刺竹矣，无刺蓐矣。","彼竹何族，有刺如簇。","蹴之者瘃，天委彼酷。","谁使尔蹴，尔瘃谁讟。","达者蹈足，恚者仄目。","斧斤俶俶，自贻伊蝮。","天道好复，况利于竹。","南有刺竹，又有刺木。","有刺木矣，无刺竹矣。","彼木何族，有刺如簇。","触之者衄，天委彼酷。","谁使尔触，尔衄谁讟。","达者鼓腹，歜者裂肉。","斧斤畟畟，自贻伊毒。","天道好复，况利于木。"],0,"x193","宋"],["公迈何遄","曾丰","四言",["公之西矣，蜀人是谣，都人是嚣。","诏予华衮，亟哉来朝。","彩熊既税，彩鹢既发。","月逗岁遛，竣其未达。","都人曰嘻，吾国君师。","欲猷欲为，未得良毗。","公归何迟。","公之东矣，蜀人是恋，潭人是羡。","诏予油幢，亟哉往殿。","列城既倾，列骑既迎。","日裴月徊，倘其未行。","潭人曰喔，吾家耋孺。","不襦不裤，莫能略顾。","公来何暮。","公之南矣，潭人是怀，洪人是留。","议夺朱幡，亟哉还休。","御者既靷，饯者既挽。","俄驰顷驱，僄其未返。","洪人曰嘕，吾土山川。","有真有仙，可伴长年。","公迈何遄。"],0,"x193","宋"],["彼莲之美","曾丰","四言",["彼莲之美，心乎爱矣。","所爱与直，渊乎其似。","厥根玲珑，庶乎屡空。","厥干洞然，同乎大通。","厥华尚赤，故为火德。","厥德靡常，虚室生白。","受知濂溪，爱莫助之。","邹子知之，久而敬之。"],0,"x193","宋"],["丞相二章","梅尧臣","四言",["丞相之拜，冠弁旅至。","乘马载驱，如彼钜潴。","有雁有鹜，有龟有鱼。","烝然来萃，翔泳啸呼。","丞相之去，乃还印绶。","乃饬车轮，如彼涸津。","时靡翔羽，时靡游鳞。","寂兮寂兮，岂有嘉宾。"],0,"x65","宋"],["答傅钦之","邵雍","四言",["芝兰在室，不能无臭。","金石振地，不能无声。","恶则哀之，哀而不伤。","善则乐之，乐而不淫。"],0,"x57","宋"],["王公吟","邵雍","四言",["王公大人，天下具瞻；","轻流薄习，重损威严。","此尚未了，彼安能兼。","非唯失道，又复起贪。","顶戴儒冠，心存象教。","本图心宁，复使心闹。","譬如生子，当求克肖。","不教义方，教之窃盗。"],0,"x57","宋"],["去事吟","邵雍","四言",["君子去事，民有馀祥。","小人去事，民有馀殃。"],0,"x57","宋"],["偶书 其四","邵雍","四言",["才高命寡，耻居人下。","若不固穷，非知道者。"],0,"x57","宋"],["善恶吟 其一","邵雍","四言",["瞽鲧有子，尧舜无嗣。","馀庆馀殃，何故如是。"],0,"x57","宋"],null,["善恶吟","邵雍","四言",["瞽鲧有子，尧舜无嗣。","馀庆馀殃，何故如是。","尧舜无子，瞽鲧有嗣。","福善祸淫，何故如此。"],0,"x57","宋"],["水旱吟","邵雍","四言",["尧水九年，汤旱七载。","调燮之功，此时安在。","九年洪水，七年大旱。","非尧与汤，民死过半。"],0,"x57","宋"],null,["戏作墨竹二本赠鹤林因为之赞 风筠","白玉蟾","四言",["新梢凝翠，落照馀红。","乱鸦噪罢，叶叶清风。","一枝嫩绿，数叶老苍。","夜半月明，清露瀼瀼。"],0,"x77","宋"],["和君时","彭汝砺","四言",["猗彼君子，笃志乎道。","道之云远，于焉慥慥。","猗彼君子，克诚其身。","匪禄是荣，日以养亲。","孰违孰从，曰吾从义。","孰去孰与，曰吾由礼。","温凊匪偕，云如之何。","得彼失兹，得失孰多。","吾斯未信，吾颜之厚。","重轻惟法，于尔何有。","尔旋尔车，不知其期。","我陟其冈，祇益我思。","凡人逐物，其力则倍。","苟知其养，是用无悔。","无悔无尤，是则养亲。","尔慎旃哉，以慰母心。","为山一篑，惧乎或止。","道之云远，曷云其已。","我田我田，以迟尔归。","何速于行，姑乐我私。"],0,"x143","宋"],["寄君时","彭汝砺","四言",["我思古人，克诚其心。","如陟于高，如临于深。","我处于中，而舍其偏。","我弃其零，而取其全。","勿谓道远，我至之难。","我勇以前，人孰我先。","勿谓过小，我姑为之。","千里之差，始于毫厘。","勇兮勇兮，子我所器。","子诚不已，我今所畏。","子能吾取，吾谁之匿。","子铭于盘，以视朝夕。"],0,"x143","宋"],["寄君时","彭汝砺","四言",["我灌我园，有采之心。","于以撷之，既有且多。","我游我庭，有菊之苗。","于以芼之，既旨且时。","我思昔人，亦采其薇。","我乐所安，奚愠其微。","仲兮仲兮，曷日汝偕。","以事以游，以慰予怀。"],0,"x143","宋"],["古怨诗 其一","刘敞","四言",["鸿雁飞矣，邕邕其族。","孰是人斯，茕茕其独。"],0,"x51","宋"],["古怨诗 其二","刘敞","四言",["鸿雁飞矣，或群或伍。","孰是人斯，茕茕其处。"],0,"x51","宋"],["魏京诗","刘敞","四言",["皇作大都，大都雄雄。","奄定北国，四方来同。","皇曰卿士，在昔圣考。","祗遹文武，维慈幼老。","天监在上，既有明德。","乃命于下，罔有不服。","匪允命之，亦章庆之。","匪允服之，亦保育之。","时维猃狁，侮予之疆。","靡度靡虞，跳呼以狂。","业业烝黎，载震载惊。","侵魏及澶，群心不宁。","帝奋厥武，百万其士。","匪怒以棘，于三千里。","如虎如貔，如霆如雷。","靡有远迩，天子其来。","天子来止，士增其喜。","孰偷其生，以不奋兴。","驱之浑浑，攘之贲贲。","靡有辀张，歼厥鲸鲲。","或献其宝，或请其命。","帝振于旅，惟时既定。","既閟尔弓，既櫜尔矛。","猃狁臣止，四方是休。","皇曰卿士，圣考之德。","允于孝思，孝思惟则。","尔视京魏，以作我都。","以赫厥灵，俾后勿逾。","皇曰卿士，惟帝时功。","时亦惟人，惟寇莱公。","尔慎尔止，弼予于治。","期尔前人，用迪尔事。","皇曰卿士，惟帝作武。","垂是万年，莫敢予侮。","泰山之封，后土之禅。","予监若兹，惟天是眷。","翼翼之土，天子国之。","穆穆原庙，圣人则之。","孰为强暴，敢不来觐。","俾怛于威，于忠是训。","显显天子，孝德自躬。","率是休烈，覃之北戎。","河水东注，昭哉禹绩。","时万斯年，天子之德。"],0,"x51","宋"],["古怨诗","刘敞","四言",["鸿雁飞矣，邕邕其族。","孰是人斯，茕茕其独。","鸿雁飞矣，或群或伍。","孰是人斯，茕茕其处。","天兮地兮，戴且履兮。","孰是人斯，莫我视兮。","日兮月兮，出兮没兮。","孰是人斯，远我忽兮。"],0,"x51","宋"],["四皓歌","刘敞","四言",["与汝携手，南山之阿。","富贵多忧，孰知其他。","大风横厉，江海荡波。","嗟汝鳞介，伤如之何。","高岩有薇，深谷有芝。","人生实难，委曲何为。"],0,"x51","宋"],null,null,["题猿石手卷二首","陆文圭","四言",["空山暮雨，枯木晓霜。","此处闻声，若为断肠。","楚山无人，群戏树颠。","或据大石，如君长然。"],0,"x149","宋"],null,null,null,["韩忠献北道京邑二帖赞","岳珂","四言",["扶桑擎日，厥干万尺，以为公笔。","天寿平格，元圭昭锡，以为公墨。","阴阳阖辟，鳌柱立极，见此伟特。","太山绝壁，九河碣石，莫动笔力。","有云五色，曾著瑞籍，多士辟易。","繄天实启，岂以诩饰，如彼韦陟。","公骑鹏翼，归侍帝侧，有是遗迹。","荣光交射，星月珠璧，终古不忒。","维珂之得，再拜叹息，坱圠孰测。","几几赤舄，尚想公德，永镇下国。"],0,"x202","宋"]]