[["绍兴以后蜡祭四十二首 其一 东方百神降神用《熙安》。","郊庙朝会歌辞","四言",["玄冥凌厉，岁聿其周。","天地闭藏，农且息休。","古大蜡礼，伊耆肇修。","爰荐𫗣馨，以迓飙游。"],0,"x207","宋"],["绍兴祀九宫贵神十首 其四 降神用《景安》。","郊庙朝会歌辞","四言",["练时吉良，聿崇明祀。","粢盛洁丰，牲硕酒旨。","肃唱和声，来燕来止。","嘉承天休，赉及含齿。"],0,"x207","宋"],["绍兴祀九宫贵神十首 其三 降神用《景安》。","郊庙朝会歌辞","四言",["于赫九宫，天神之贵。","煌煌彪列，下土是莅。","幽赞高穹，阴骘万类。","肃若旧典，有严祗事。"],0,"x207","宋"],["绍兴祀九宫贵神十首 其二 降神用《景安》。","郊庙朝会歌辞","四言",["载阳衍德，农祥孔昭。","赉兹元嘏，穰穰黍苗。","象舆眇冥，金奏远姚。","无阏厥灵，丹衷匪恌。"],0,"x207","宋"],["绍兴祀九宫贵神十首 其一 降神用《景安》。","郊庙朝会歌辞","四言",["紫阙幽宏，惟神灵尊。","辅成泰元，赞役乃坤。","曰雨曰旸，缊豫调纷。","享荐陨光，蒙祉如屯。"],0,"x207","宋"],["绍兴祀大火十二首 其四 降神用《高安》。","郊庙朝会歌辞","四言",["于赫我宋，以火德王。","永永丕图，繄神之相。","神之来矣，维其时矣。","礼备乐奏，神其知矣。"],0,"x207","宋"],["绍兴祀大火十二首 其三 降神用《高安》。","郊庙朝会歌辞","四言",["小大率礼，不愆于仪。","展采错事，秩祀孔时。","维今之故，阅我数度。","修厥典常，神其来顾。"],0,"x207","宋"],["绍兴祀大火十二首 其二 降神用《高安》。","郊庙朝会歌辞","四言",["有出有藏，伏见靡常。","相我国家，鉴观四方。","视罔不正，终然允臧。","神其来格，明德馨香。"],0,"x207","宋"],["绍兴祀太社太稷十七首 其五 迎神用","郊庙朝会歌辞","四言",["国主社稷，时祀有常。","肃若旧典，报本不忘。","粢盛丰洁，歌吟青黄。","尊神倏来，百物宾将。"],0,"x207","宋"],["绍兴祀太社太稷十七首 其四 迎神用","郊庙朝会歌辞","四言",["谷资土养，民赖谷生。","功利之博，莫之与京。","式严祠坛，因物荐诚。","礼具乐奏，惟神顾歆。"],0,"x207","宋"],["绍兴祀太社太稷十七首 其三 迎神用","郊庙朝会歌辞","四言",["是尊是奉，兹率旧章。","乐音纯绎，荐溢圆方。","情文备矣，神其迪尝。","永观锡羡，多穑穰穰。"],0,"x207","宋"],["绍兴祀太社太稷十七首 其二 迎神用","郊庙朝会歌辞","四言",["功烈在民，诞受露雨。","良耜既歌，乃扬帗舞。","是奉是尊，厚礼斯举。","相其丰年，多稌多黍。"],0,"x207","宋"],["绍兴祀太社太稷十七首 其一 迎神用","郊庙朝会歌辞","四言",["五祀之本，社稷有严。","芟柞伊始，夫敢不虔。","吉日惟戊，式荐豆笾。","神其来格，用介有年。"],0,"x207","宋"],["绍兴祀皇地祇十五首 其四 迎神用《宁安》。","郊庙朝会歌辞","四言",["蒇事方丘，情文孔时。","名山大泽，侑祭无遗。","牲陈黝犊，乐备咸池。","柔祇皆出，介我繁禧。"],0,"x207","宋"],["绍兴祀皇地祇十五首 其三 迎神用《宁安》。","郊庙朝会歌辞","四言",["至哉坤元，乃顺承天。","厚德载物，含洪八埏。","日北多暑，祀仪吉蠲。","式昭毋事，敢告恭虔。"],0,"x207","宋"],["绍兴祀皇地祇十五首 其二 迎神用《宁安》。","郊庙朝会歌辞","四言",["蒇事方丘，旧典时式。","至诚感神，馨非黍稷。","肸蚃来临，鉴兹明德。","永锡坤珍，时万时亿。"],0,"x207","宋"],["绍兴祀皇地祇十五首 其一 迎神用《宁安》。","郊庙朝会歌辞","四言",["至哉厚德，物生是资。","直方维则，翕辟攸宜。","于昭祀典，致享坤仪。","礼罔不答，神之格思。"],0,"x207","宋"],["绍兴祀神州地祇十六首 其四 迎神用《宁安》。","郊庙朝会歌辞","四言",["翕辟以时，协气陶蒸。","播之金石，锵厥和声。","冥冥眑眑，孔享纯诚。","是听是娭，邦基永宁。"],0,"x207","宋"],["绍兴祀神州地祇十六首 其三 迎神用《宁安》。","郊庙朝会歌辞","四言",["坱圠无垠，磅礴罔测。","山盈川冲，自生自殖。","其报惟何，率礼靡忒。","亿万斯年，功被无极。"],0,"x207","宋"],["绍兴祀神州地祇十六首 其二 迎神用《宁安》。","郊庙朝会歌辞","四言",["洪惟坤元，道著品物。","上配紫旻，厚载其德。","良月肇蒇，祭器布列。","必先皇祇，以迓景福。"],0,"x207","宋"],["绍兴祀神州地祇十六首 其一 迎神用《宁安》。","郊庙朝会歌辞","四言",["芒芒下土，恢恢方仪。","富媪统摄，潜运八维。","爰称元祀，告备吉时。","揭兹虔恭，僾其格思。"],0,"x207","宋"],["绍兴祀高禖十首 其四 降神用《高安》。","郊庙朝会歌辞","四言",["春气肇分，万类滋荣。","惟此祀事，皆象发生。","求神以类，式昭至诚。","庶几来格，子孙绳绳。"],0,"x207","宋"],["绍兴祀高禖十首 其三 降神用《高安》。","郊庙朝会歌辞","四言",["猗欤禖宫，祀典所贵。","粤自艰难，礼或弗备。","以迄于今，始建坛壝。","愿戒云车，歆此诚意。"],0,"x207","宋"],["绍兴祀高禖十首 其二 降神用《高安》。","郊庙朝会歌辞","四言",["眷此尊祀，实惟仲春。","青圭束帛，克祀克禋。","庶蒙嘉惠，嗣续诜诜。","神之降鉴，云车来臻。"],0,"x207","宋"],["绍兴祀高禖十首 其一 降神用《高安》。","郊庙朝会歌辞","四言",["聿分春气，施生在时。","禖宫肇启，精意以祠。","礼仪告备，神其格思。","厥灵有赫，锡我繁厘。"],0,"x207","宋"],["绍兴淳熙分命馆职定撰十七首 其四 姑洗为羽","郊庙朝会歌辞","四言",["霜露既降，孝思奉先。","陟降上帝，礼隆九筵。","有馨黍稷，有肥牲牷。","神来燕娭，想像肃然。"],0,"x207","宋"],["绍兴淳熙分命馆职定撰十七首 其三 太簇为征","郊庙朝会歌辞","四言",["休德孔昭，灵承上帝。","孝极尊亲，严配于位。","嘉荐芬芳，礼无不备。","神其格思，享兹诚至。"],0,"x207","宋"],["绍兴淳熙分命馆职定撰十七首 其二 黄钟为角","郊庙朝会歌辞","四言",["合宫盛礼，金商令时。","备成熙事，搜扬上仪。","骏奔在庭，精意肃祗。","来享嘉荐，神灵燕娭。"],0,"x207","宋"],["绍兴淳熙分命馆职定撰十七首 其一 圜钟为宫","郊庙朝会歌辞","四言",["上直房心，时惟明堂。","配天享亲，宗祀有常。","盛德在金，日吉辰良。","享我克诚，来格来康。"],0,"x207","宋"],["绍兴朝日十首 其四 降神用《高安》。","郊庙朝会歌辞","四言",["屹尔王宫，泛临翊翊。","惠此万方，岂惟五色。","以修阳政，以习地德。","云景杳冥，施祥无极。"],0,"x207","宋"],["高宗建炎初祀昊天上帝 其一 降神用《景安》。","郊庙朝会歌辞","四言",["搜讲上仪，式修毖祀。","日吉辰良，礼成乐备。","风驭云旗，聿来歆止。","嘉我馨德，介兹繁祉。"],0,"x207","宋"],["高宗建炎初祀昊天上帝 其四 降神用《景安》。","郊庙朝会歌辞","四言",["惟天为大，物始攸资。","恭承禋祀，以报以祈。","神不可度，日监在兹。","有馨明德，庶其格思。"],0,"x207","宋"],["高宗建炎初祀昊天上帝 其二 降神用《景安》。","郊庙朝会歌辞","四言",["我将我享，涓选休成。","执事有恪，惟寅惟清。","乐既六变，肃雍和鸣。","高高在上，庶几是听。"],0,"x207","宋"],["淳祐祭海神十六首 其四 迎神用《延安》。","郊庙朝会歌辞","四言",["猗与祀礼，四海会同。","灵之来沛，鞭霆驭风。","肸蚃彷佛，在位肃雍。","佑我烝民，式徼神功。"],0,"x207","宋"],["淳祐祭海神十六首 其三 迎神用《延安》。","郊庙朝会歌辞","四言",["若稽有唐，克致崇极。","祝号既升，爰增祭式。","从享于郊，神斯受职。","我祀肇新，式祈阴骘。"],0,"x207","宋"],["淳祐祭海神十六首 其二 迎神用《延安》。","郊庙朝会歌辞","四言",["四溟广矣，八纮是纪。","我宅东南，回复万里。","洪涛飘风，安危所倚。","祀事特隆，神其戾止。"],0,"x207","宋"],["淳祐祭海神十六首 其一 迎神用《延安》。","郊庙朝会歌辞","四言",["堪舆之间，最钜惟瀛。","包干括坤，吐日滔星。","祀典载新，礼乐孔明。","鉴吾嘉赖，来燕来宁。"],0,"x207","宋"],["宁宗郊祀二十九首 其四 降神用《景安》。","郊庙朝会歌辞","四言",["金石宣昭，羽旄纷纶。","洁火夕照，明水夜陈。","娭哉惟灵，娭哉惟神。","风马招摇，惟德之亲。"],0,"x207","宋"],["宁宗郊祀二十九首 其三 降神用《景安》。","郊庙朝会歌辞","四言",["泰尊媪厘，祖功宗德。","辰躔陪营，岳渎受职。","神哉来下，神哉来格。","飨德惟馨，留虞嘉席。"],0,"x207","宋"],["宁宗郊祀二十九首 其二 降神用《景安》。","郊庙朝会歌辞","四言",["华盖既动，紫微洞开。","星枢周旋，日车徘徊。","灵兮顾佑，灵兮沛来。","载燕载娭，式时坛垓。"],0,"x207","宋"],["宁宗郊祀二十九首 其一 降神用《景安》。","郊庙朝会歌辞","四言",["天门荡荡，云车阴阴。","百神咸秩，三灵顾歆。","神哉来娭，神哉溥临。","飨时宋德，翼翼小心。"],0,"x207","宋"],["上册宝十三首 其四 迎神用《歆安》。","郊庙朝会歌辞","四言",["牺牲既成，笾豆有楚。","𪭢金击石，式歌且舞。","追怀懿德，令闻令仪。","灵兮来格，是享是宜。"],0,"x207","宋"],["上册宝十三首 其三 迎神用《歆安》。","郊庙朝会歌辞","四言",["雍雍在宫，翼翼在庭。","显相休嘉，肃雍和鸣。","神嗜饮食，明德惟馨。","绥我思成，式燕以宁。"],0,"x207","宋"],["上册宝十三首 其二 迎神用《歆安》。","郊庙朝会歌辞","四言",["吉蠲惟时，礼仪既备。","奉璋峨峨，群公在位。","神之格思，永锡尔类。","展彼令德，于焉来暨。"],0,"x207","宋"],["上册宝十三首 其一 迎神用《歆安》。","郊庙朝会歌辞","四言",["笾豆大房，牺尊将将。","馨香既登，明灵迪尝。","其乐伊何，吹笙鼓簧。","灵来燕娭，降福无疆。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 其三 降神用《太安》。六变。","郊庙朝会歌辞","四言",["龙车既奏，凤驭载翔。","帝幄伫灵，天衢腾芳。","神来留俞，神来蹇骧。","礼鬯乐明，奏假孔将。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 其四 降神用《太安》。六变。","郊庙朝会歌辞","四言",["虹旌蜺旄，鸾旗翠盖。","星枢扶轮，月御叶卫。","灵至阴阴，灵般裔裔。","来格来飨，福流万世。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 其二 降神用《太安》。六变。","郊庙朝会歌辞","四言",["芬枝扬烈，𤈶珠叶陶。","闿珍阐符，展诗舞箾。","神哉来下，神哉来翱。","肃若有承，灵心招摇。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 其一 降神用《太安》。六变。","郊庙朝会歌辞","四言",["四灵晨耀，五纬夕明。","风云晏和，天地粹清。","灵兮来迎，灵兮来宁。","启我子孙，飨于纯精。"],0,"x207","宋"],["宁宗朝享三十五首 其四 迎神用《兴安》。九变。","郊庙朝会歌辞","四言",["文以谟显，武以烈承。","圣训之保，祖武之绳。","有肃孝假，式严衎烝。","神其来兮，以宜以宁。"],0,"x207","宋"],["宁宗朝享三十五首 其三 迎神用《兴安》。九变。","郊庙朝会歌辞","四言",["穆穆紫幄，璜璜清宫。","旱麓流咏，凫鹥叶工。","道闳诒燕，业绵垂鸿。","神其来兮，以康以崇。"],0,"x207","宋"],["宁宗朝享三十五首 其二 迎神用《兴安》。九变。","郊庙朝会歌辞","四言",["勾陈旦辟，阊阖夜分。","轸风挟月，车驷凌云。","瑞景晻霭，神光耀煴。","神其来兮，以留以忻。"],0,"x207","宋"],["宁宗朝享三十五首 其一 迎神用《兴安》。九变。","郊庙朝会歌辞","四言",["咸英备乐，簋席列斝。","诗歌安世，声叶皇雅。","翠旗羽盖，云车风马。","神其来兮，以燕以下。"],0,"x207","宋"],["绍兴以后时享二十五首 其四 迎神用《兴安》。","郊庙朝会歌辞","四言",["道信于神，神灵燕娭。","酒有嘉德，物惟其时。","缓节安歌，乐奏具宜。","欣欣乐康，福禄绥之。"],0,"x207","宋"],["绍兴以后时享二十五首 其三 迎神用《兴安》。","郊庙朝会歌辞","四言",["嘉承和平，秩祀为先。","乃练休辰，祝史告虔。","内心齐明，祀具吉蠲。","交际恍惚，如在后前。"],0,"x207","宋"],["绍兴以后时享二十五首 其一 迎神用《兴安》。","郊庙朝会歌辞","四言",["奉先严祀，率礼大经。","时思致享，肃荐芳馨。","竭诚备物，乐奏和声。","真驭来止，熙事克成。"],0,"x207","宋"],["崇恩太后升祔十四首 迎神用《兴安》。四章。","郊庙朝会歌辞","四言",["閟宫有侐，堂筵屹崇。","灵徽匪遐，精诚感通。","苾芬维时，登兹明祀。","泠然云车，有来其驭。","羽旌风翔，翠蕤飘举。","俨其音徽，登兹位处。","笙镛始奏，合止柷敔。","是享是宜，永求伊祜。","枚枚閟宫，鼎俎肆陈。","烝畀明灵，登其嘉新。","鼓钟既戒，旨酒既醇。","攸介攸止，纯禧荐臻。","旨酒嘉肴，于登于豆。","是享是宜，乐既合奏。","衎我懿德，执事温恭。","灵兮允格，有翼其从。"],0,"x207","宋"],["祫享八首 其四 迎神用《兴安》。","郊庙朝会歌辞","四言",["苾芬孝祀，荐灌肃雍。","致力于神，明信咸通。","灵之妥留，惠我庞鸿。","广被万宇，福禄攸同。"],0,"x207","宋"],["祫享八首 其三 迎神用《兴安》。","郊庙朝会歌辞","四言",["于昭孝治，通乎神明。","寒暑不忒，熙事备成。","牲牷孔硕，黍稷惟馨。","以享以祀，来燕来宁。"],0,"x207","宋"],["祫享八首 其二 迎神用《兴安》。","郊庙朝会歌辞","四言",["于穆孝思，嘉荐维时。","诚通兹格，咸来燕娭。","神之听之，申锡蕃厘。","于万斯年，永保丕基。"],0,"x207","宋"],["祫享八首 其一 迎神用《兴安》。","郊庙朝会歌辞","四言",["时维孟冬，霜露既零。","合食盛礼，以时以行。","孝心翼翼，惟神来宁。","肃倡斯举，神具是听。"],0,"x207","宋"],["高宗建炎初祀昊天上帝 其三 降神用《景安》。","郊庙朝会歌辞","四言",["礼崇禋祀，备物荐诚。","昭格穹昊，明德惟馨。","风马云车，肸蚃居歆。","申锡无疆，赉我思成。"],0,"x207","宋"],["绍兴以后祀感生帝十六首 其二 降神用《大安》。","郊庙朝会歌辞","四言",["宋德惟火，神实司之。","上仪申蒇，迎方重离。","瑶币告洁，秀华金支。","啾啾神龙，来介繁禧。"],0,"x207","宋"],["绍兴朝日十首 其一 降神用《高安》。","郊庙朝会歌辞","四言",["玄鸟既至，序属春分。","朝于太阳，厥典备存。","载严大采，示民有尊。","扬光下烛，煜爚东门。"],0,"x207","宋"],["绍兴朝日十首 其三 降神用《高安》。","郊庙朝会歌辞","四言",["周祀及暗，汉制中营。","肸蚃是届，礼神以兄。","我洁斯璧，我肥斯牲。","神兮燕享，鉴观孔明。"],0,"x207","宋"],["绍兴以后时享二十五首 其二 迎神用《兴安》。","郊庙朝会歌辞","四言",["圣灵在天，九关崇深。","风马云车，纷其顾临。","拥祥储休，昭答孝心。","孝孙受祉，万福是膺。"],0,"x207","宋"],["绍兴祀大火十二首 其一 降神用《高安》。","郊庙朝会歌辞","四言",["五纬相天，各率其职。","司礼与视，则维荧惑。","至阳之精，届我长嬴。","于以求之，祀事孔明。"],0,"x207","宋"],["出火祀大辰十二首 其四 降神用《高安》。","郊庙朝会歌辞","四言",["星入于戌，与火俱诎。","火出于辰，与星俱伸。","一伸一诎，孰操纵之。","利用出入，民咸用之。"],0,"x207","宋"],["淳化乡饮酒三十三章 其一","郊庙朝会歌辞","四言",["鹿鸣呦呦，命侣与俦。","宴乐嘉宾，既献且酬。","献酬有序，休祉无疆。","展矣君子，邦家之光。","鹿鸣呦呦，在彼中林。","宴乐嘉宾，式昭德音。","德音愔愔，既乐且湛。","允矣君子，实慰我心。","鹿鸣呦呦，在彼高冈。","宴乐嘉宾，吹笙鼓簧。","币帛戋戋，礼仪蹡蹡。","乐只君子，利用宾王。","鹿鸣相呼，聚泽之蒲。","我乐嘉宾，鼓瑟吹竽。","我命旨酒，以燕以娱。","何以赠之，玄𫄸粲如。","鹿鸣相邀，聚场之苗。","我美嘉宾，令名孔昭。","我命旨酒，以歌以谣。","何以置之，大君之朝。","鹿鸣相应，聚山之荆。","我燕嘉宾，鼓簧吹笙。","我命旨酒，以逢以迎。","何以荐之，扬于王庭。"],0,"x207","宋"],null,null,["淳化乡饮酒三十三章 其五","郊庙朝会歌辞","四言",["关雎于飞，洲渚之湄。","自家刑国，乐且有仪。","郁郁芳兰，幽人撷之。","温温恭人，哲后求之。","求之无斁，寤寐所属。","罄尔一心，受天百禄。","郁郁芳兰，雨露滋之。","温温恭人，圭组縻之。","郁郁芳兰，佩服珍之。","温温恭人，福履绥之。","关雎跄跄，集水之央。","好求贤辅，同扬德光。","苹蘩芳滋，同谁掇之。","愿言贤德，靡日不思。","偶其贤德，辅成己职。","永配玉音，服之无斁。","洁其粢盛，中心匪宁。","荐于宗庙，助君德馨。","贤淑来思，人之表仪。","风化天下，何乐如之。"],0,"x207","宋"],["淳化乡饮酒三十三章 其六","郊庙朝会歌辞","四言",["彼鹊成巢，尔类攸处。","之子有归，琼瑶是祖。","彼鹊成巢，尔类攸匹。","之子有行，锦绣是饰。","彼鹊成巢，尔类攸共。","之子有从，兰荪是奉。","伊鹊成巢，珍禽戾止。","婉彼佳人，配于君子。","伊鹊营巢，珍禽攸处。","内助贤侯，弼于明主。","伊鹊营巢，珍禽辑睦。","均养嘉雏，致于蕃育。"],0,"x207","宋"],["皇祐亲享明堂六首 其一 降神用《诚安》。","郊庙朝会歌辞","四言",["维圣享帝，维孝严亲。","肇图世室，躬展精禋。","镛鼓既设，笾豆既陈。","至诚攸感，保格上神。"],0,"x207","宋"],["章献明肃皇太后恭谢太庙","郊庙朝会歌辞","四言",["于穆宋庙，肇允基扃。","文母来献，国祚咸宁。","永言昭格，式荐惟馨。","亦既降止，聿柄神灵。","九奏允谐，皇灵来暨。","备物芬馨，昭违精意。","升降有仪，群臣序位。","享于克诚，万福攸至。","懿彼灵龟，在宫之池。","芳莲是托，千岁奇姿。","祼将清庙，播于声诗。","神降之吉，永保寿祺。","洁尔牺牲，既角且骍。","玉俎奉将，式表纯精。","祖宗斯享，毖祀以成。","福禄来降，邦祚隆平。","太宫尔肃，烈祖巍巍。","上炳淳耀，下流德晖。","诒谋燕翼，奄宅邦畿。","子孙千亿，历数同归。","乃祖齐圣，绵瓞其昌。","源流浚邈，统祚悠长。","如闻肃僾，有𫗣馨香。","监观垂祐，万叶储祥。","奕奕清庙，巍巍帝基。","诒谋积德，累洽熏熙。","粢盛丰洁，礼容肃祗。","俯歆明荐，永锡蕃禧。","赤符启祚，长发其祥。","灵源自远，帝运重光。","载洁笾豆，恭荐令芳。","致成翼翼，降福穰穰。","英英艺祖，出震承干。","握图抚运，卜祚延年。","衣冠在庙，威灵在天。","永锡无疆，子孙保焉。","赫赫皇祖，万邦之君。","功崇偃革，德盛兴文。","圣谟宏达，至教氤氲。","子孙百世，祗荐苾芬。","巍巍新庙，穆穆真皇。","德符二圣，仁洽万方。","坠典咸秩，鸿仪用彰。","威灵如在，时思不忘。","苾芬既荐，溥硕咸陈。","礼备乐举，先后有伦。","以奉七室，齐洁惟寅。","皇灵斯享，福祥荐臻。","籥翟既备，干戚是陈。","德业昭著，用和神人。","牲牷腯肥，粢盛丰洁。","三献用行，万舞复列。","礼仪克成，乐奏将阕。","神保聿归，玉豆斯彻。"],0,"x207","宋"],["真宗奉圣祖玉清昭应宫十一首 其一 降圣用《真安》。","郊庙朝会歌辞","四言",["巍巍真宇，奕奕殊庭。","规模太紫，炳焕丹青。","元命祗答，大猷是经。","多仪有践，丕应无形。","肆设金石，声闻杳冥。","伫回飙驭，永祐基扃。"],0,"x207","宋"],["先蚕六首 其一 迎神用《明安》。","郊庙朝会歌辞","四言",["生民之朔，衣皮而群。","惟圣有作，被冒以文。","礼乐以成，贵贱以分。","欲报之德，金石谐均。"],0,"x207","宋"],["建隆郊祀八首 降神用《高安》。","郊庙朝会歌辞","四言",["在国南方，时维就阳。","以祈帝祉，式致民康。","豆笾鼎俎，金石丝簧。","礼行乐奏，皇祚无疆。","步武舒迟，升坛肃祗。","其容允若，于礼攸宜。","嘉玉制币，以通神明。","神不享物，享于克诚。","笙镛备乐，茧栗陈牲。","乃迎芳俎，以荐高明。","丹云之爵，金龙之杓。","挹于尊罍，是曰清酌。","洁兹五齐，酌彼六尊。","致诚斯至，率礼弥敦。","以介景福，永隆后昆。","重熙累洽，帝道攸尊。","谓天盖高，其听孔卑。","闻乐歆德，介以福禧。","倏兮而来，忽兮而回。","云驭杳邈，天门洞开。"],0,"x207","宋"],["咸平亲郊八首 降神用《高安》。","郊庙朝会歌辞","四言",["圜丘何方，在国之阳。","礼神合祭，运启无疆。","祖考来格，笾豆成行。","其仪肃肃，降福穰穰。","礼备乐成，干健天行。","帝容有穆，佩玉锵鸣。","定位毖祀，告于神明。","嘉玉量币，享于克诚。","有牲斯纯，有俎斯陈。","进于上帝，昭报深仁。","大报于帝，盛德升闻。","醴齐良洁，粢盛苾芬。","祀帝圜丘，九州献力。","礼行于郊，百神受职。","灵祗格思，享我明德。","天鉴孔章，玄祉昭锡。","羽籥云罢，干戚载扬。","接神有恪，锡羡无疆。","神驾来思，风举云飞。","神驭归止，天空露晞。"],0,"x207","宋"],["景祐亲郊三圣并侑二首 奠币用《广安》。","郊庙朝会歌辞","四言",["千龄启运，三后在天。","嘉坛并侑，亿万斯年。","皇基缔构，帝系灵长。","躬荐郁鬯，子孙保昌。"],0,"x207","宋"],["景祐常祀二首 太祖配位奠币用《定安》。","郊庙朝会歌辞","四言",["翕受骏命，震叠群方。","侑祀上帝，德厚流光。","诞受灵符，肇基丕业。","配享洁尊，永隆万叶。"],0,"x207","宋"],["元符亲郊五首 降神用《景安》，六变辞同。","郊庙朝会歌辞","四言",["无为靡远，深厚广圻。","祭神恭在，弁冕衮衣。","粢盛丰美，明德馨辉。","以祥以佑，非眇专祈。","神灵拥卫，景从云随。","玉色温粹，天步舒迟。","周旋陟降，皇心肃祗。","千灵是保，百福攸宜。","陟彼郊丘，大祀是承。","其豆孔庶，其香始升。","上帝时歆，以我齐明。","卒事而彻，福禄来咸。","馨遗八尊，器空二簋。","至祝至虔，穹祇贶祉。"],0,"x207","宋"],null,null,null,["景祐上辛祈谷二首 太宗配位奠币用《仁安》。","郊庙朝会歌辞","四言",["天祚有开，文德来远。","祈谷日辛，侑神礼展。","于穆神宗，惟皇永命。","荐醴六尊，声歌千咏。"],0,"x207","宋"],null,["孟夏雩祀二首 太祖配坐奠币用《献安》。","郊庙朝会歌辞","四言",["昊天盖高，祀事为大。","严配皇灵，亿福来介。","龙见而雩，神之来格。","牺象精良，威灵赫奕。"],0,"x207","宋"],["景德以后祀五方帝十六首 青帝降神用《高安》。六变。","郊庙朝会歌辞","四言",["四序伊始，三阳肇新。","气迎东郊，蛰户咸春。","功宣播殖，泽被生民。","祝史正辞，昭事惟寅。","条风始至，盛德在木。","平秩东作，种献穜穋。","律应青阳，气和玉烛。","惠彼兆民，以介景福。","备物致用，荐羞神明。","礼成乐举，克享克禋。","条风斯应，候历维新。","阳和启蛰，品物皆春。","篪簧协奏，簠簋毕陈。","精羞丰荐，景福攸臻。","长嬴戒序，候正南讹。","功资蕃育，气应清和。","鼎实嘉俎，乐备登歌。","神其来享，降福孔多。","象分离位，德配炎精。","景风协律，化神含生。","百嘉茂育，乃顺高明。","神无常享，享于克诚。","笾豆有践，黍稷惟馨。","礼终三献，神归杳冥。","坤舆厚载，黄裳元吉。","宅中居正，含章抱质。","分王四季，其功靡秩。","育此群生，首兹六律。","中央定位，厚德惟新。","五行攸正，四气爰均。","笙镛以间，簠簋斯陈。","为民祈福，肃奉明禋。","土德居中，方舆配位。","乐以送神，式申昭事。","隆冬戒序，岁历顺成。","一人有庆，万物由庚。","有旨斯酒，有硕斯牲。","报功崇德，正直聪明。","大仪斡运，星纪环周。","三时不害，黍稷盈畴。","克诚致享，品物咸羞。","礼成乐变，锡祚贻休。","管磬咸和，礼献斯毕。","灵驭言旋，神降之吉。"],0,"x207","宋"],null,null,null,null,null,["景祐祀感生帝二首 宣祖配位奠币用《皇安》。","郊庙朝会歌辞","四言",["浚发长源，粤惟始祖。","五运协图，万灵来护。","龙德而隐，源流则长。","宜乎亿祀，侑享弥昌。"],0,"x207","宋"],["元符祀感生帝五首 降神用《大安》。六变。","郊庙朝会歌辞","四言",["二仪交泰，七政顺行。","四序资始，万物含生。","皇朝创业，盛德致平。","为民祈福，洁此精诚。","冕旒俨若，步武有容。","公卿济济，韶頀邕邕。","乐和凤律，酒奠牺尊。","神明斯享，礼盛难论。","大君有命，阙典咸修。","帝歆明祀，佑圣千秋。","俯临下土，回复上天。","触类而长，荷福无边。"],0,"x207","宋"],["景祐大享明堂二首 真宗配位奠币用《诚安》。","郊庙朝会歌辞","四言",["思文圣考，对越在天。","侑神作主，奉币申虔。","偃革兴文，封峦考瑞。","威烈巍巍，允膺宗祀。"],0,"x207","宋"],null,["熙宁亲享明堂二首 英宗奠币用《诚安》。","郊庙朝会歌辞","四言",["于皇圣考，克配上帝。","永言孝思，昭荐嘉币。","英声迈古，德施在民。","允秩宗祀，宾延上神。"],0,"x207","宋"],["元符亲享明堂十一首 皇帝升降用《仪安》。","郊庙朝会歌辞","四言",["严父配天，孝乎明堂。","与奠升阶，降音以将。","天步有节，帝容必庄。","辟公宪之，礼无不臧。","圣能享帝，孝克事亲。","于皇宗祀，盛节此陈。","何以荐虔，二精有炜。","何以致祥，上天鉴止。","合宫礼备，时维哲王。","堂筵四敞，明德馨香。","圣考来格，降福穰穰。","承承继继，万祀其昌。","奕奕明堂，天子即事。","奠我圣考，配于上帝。","凡百有职，畴敢不祗。","俎洁牲肥，其登有仪。","惟礼不渎，所以严亲。","惟孝不匮，所以教民。","陟配文考，享于大神。","重禧累福，祚裔无垠。","隆功骏德，两有烈光。","陟配宗祀，惠我无疆。","舞以象功，乐惟崇德。","文经万邦，武靖四国。","一张一弛，其仪不忒。","神鉴孔昭，孝思维则。","于昭盛礼，严父配天。","尽物尽诚，莫匪吉蠲。","重觞既荐，九奏相宣。","神介景福，亿万斯年。","莫尊乎天，莫亲乎父。","既享既侑，诚申礼举。","戛击堂上，八音始具。","天子亿龄，饮神之胙。","穆穆在堂，肃肃在庭。","于显辟公，来相思成。","神既歆止，有闻无声。","锡我休嘉，燕及群生。","有奕明堂，万方时会。","宗子圣考，作帝之配。","乐酌虞典，礼从周志。","厘事既成，于皇来暨。"],0,"x207","宋"]]