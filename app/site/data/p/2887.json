[["偈颂十首 其十一","释德光","四言",["一法不明，翳汝眼睛。","眼睛不明，世界峥嵘。"],0,208,"宋"],["文宣王及其弟子赞 其三十六","赵构","四言",["琅邪之伯，其惟子骄。","微言既彰，德音孔昭。","已观雩舞，同听齐韶。","历千百祀，跂想高标。"],0,249,"宋"],["章献明肃皇太后恭谢太庙 其三","郊庙朝会歌辞","四言",["懿彼灵龟，在宫之池。","芳莲是托，千岁奇姿。","祼将清庙，播于声诗。","神降之吉，永保寿祺。"],0,"x207","宋"],["章献明肃皇太后恭谢太庙 其六","郊庙朝会歌辞","四言",["乃祖齐圣，绵瓞其昌。","源流浚邈，统祚悠长。","如闻肃僾，有𫗣馨香。","监观垂祐，万叶储祥。"],0,"x207","宋"],["章献明肃皇太后恭谢太庙 其九","郊庙朝会歌辞","四言",["英英艺祖，出震承干。","握图抚运，卜祚延年。","衣冠在庙，威灵在天。","永锡无疆，子孙保焉。"],0,"x207","宋"],["章献明肃皇太后恭谢太庙 其十四","郊庙朝会歌辞","四言",["牲牷腯肥，粢盛丰洁。","三献用行，万舞复列。","礼仪克成，乐奏将阕。","神保聿归，玉豆斯彻。"],0,"x207","宋"],["颂古三十三首 其二十四","释师观","四言",["香严上树，住住住住。","拟问如何，葛藤露布。"],0,210,"宋"],["我策我马寄王介甫 其三","王令","四言",["井则有泉，渴者俯之。","燎之阳阳，寒者附之。","君子则高，吾则仰之。"],0,"x68","宋"],["宗门一句","释守卓","四言",["宗门一句，明明独露。","孰辨端倪，胡为指注。","指注不真，镜像空尘。","空尘何立，镜像谁入。","当机则应，头头非剩。","触处俱宣，句句通玄。","门门宾主，互正互偏。","含容透脱，千江一月。","无在不在，谁憎谁爱。","焕尔既明，森然不碍。","不碍既明，金刚眼睛。","穷幽测显，神妙体灵。","妙灵不住，无生不生。","是宜超越，所以纵横。"],0,42,"宋"],["文殊大士为龙女说法赞","释师范","四言",["文殊说法，所说何法。","女子成佛，所成何佛。","无法可说，无佛可成。","卧龙奋迅，狮子嚬呻。"],0,"x155","宋"],["皇雅十首  其一","尹洙","四言",["天监下民，乱靡有定。","甚武且仁，祚厥真圣。","仁实怀徕，武以执竞。","匪虔匪刘，拯我大命。"],0,108,"宋"],["章献明肃皇太后恭谢太庙 其四","郊庙朝会歌辞","四言",["洁尔牺牲，既角且骍。","玉俎奉将，式表纯精。","祖宗斯享，毖祀以成。","福禄来降，邦祚隆平。"],0,"x207","宋"],["绍兴以后祀感生帝十六首 僖祖位酌献用《肃安》。","郊庙朝会歌辞","四言",["皇矣文献，开国有先。","德配感生，对越在天。","练日得辛，来止灵坛。","神其锡羡，瑞应猗兰。"],0,"x207","宋"],["宗室公衡真赞","周必大","四言",["信厚为质，温恭其仪。","视此标的，盛哉本支。"],0,"x76","宋"],["绍兴以后祀感生帝十六首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["伟炎厥初，缘感而系。","庆衍式崇，昭融有契。","乐功既谐，觞献斯继。","歆类不违，克昌百世。"],0,"x207","宋"],["绍兴十三年发皇后册宝十三首 其一","郊庙朝会歌辞","四言",["天地奠位，乾坤以分。","夫妇有别，父子相亲。","圣王之治，礼重婚姻。","端冕从事，是正大伦。"],0,"x207","宋"],["章献明肃皇太后恭谢太庙 其八","郊庙朝会歌辞","四言",["赤符启祚，长发其祥。","灵源自远，帝运重光。","载洁笾豆，恭荐令芳。","致成翼翼，降福穰穰。"],0,"x207","宋"],["殉节诗  其二","方氏","四言",["我生不辰，咨嗟风雨。","一木难支，劝君解组。"],0,228,"宋"],["偈颂一百二十三首 其一一八","释崇岳","四言",["开炉开炉，柴炭全无。","星儿火种，照彻十虚。"],0,222,"宋"],["颂古三十三首 其三十二","释师观","四言",["驴放三千，马放八百。","透过重关，未为英杰。"],0,210,"宋"],["鄂州劝农","罗愿","四言",["国有四民，各分一职。","农次于士，盖尊稼穑。","日出当作，日入乃息。","用天分地，以足衣食。","菖叶初生，于是始耕。","务限既入，农事转急。","禾当播种，乘雨接湿。","高田大豆，榆荚为候。","三月区处，油麻穄黍。","时当警窃，图葺墙宇。","蚕沙麦种，四月收贮。","开渠决窦，以待暴雨。","月建在午，秧苗入土。","女工织作，三伏炎暑。","七月芟草，烧治荒田。","大麦小麦，上戊社前。","禾欲上场，九月涂仓。","缉绩布缕，十月多霜。","冬至埋谷，预试五种。","不宜者轻，宜者则重。","腊月粪地，治碓雕桑。","修治农器，向春则忙。","四时之务，展转相寻。","既有常产，当有常心。","鸡豚兼蓄，枣栗成林。","我念此州，土多冒占。","纷纷刬请，扰扰定验。","雨泽空过，失天之时。","生意不发，失地之脂。","身力不出，枉堕四肢。","于私无益，于官亦亏。","耕既不深，难行根脉。","耘既不勤，众草之宅。","粪若不施，谷不精泽。","收若不速，风雨狼藉。","若能开垦，处处良田。","若能灌溉，岁岁丰年。","古来开亩，广尺深尺。","长亩三条，于中种植。","渐锄陇草，爬土亩中。","苗根日深，耐旱与风。","又有区种，与亩不同。","方深六寸，种禾一丛。","七寸一区，匀如棋局。","区收三升，亩号百斛。","用力既到，所收亦多。","比之漫撒，效验如何。","凡苗之长，全在粪壤。","器欲巧便，牛须肥健。","其或无牛，以人牵犁。","彼此换工，惟在心齐。","游手浮堕，讥笑父祖。","一时之逸，终身之苦。","稍识文字，莫弄官方。","暂然得理，不可为常。","劝尔保身，孝谨无辱。","劝尔居家，省俭常足。","兄弟同心，勿营私曲。","年丰感谢，休厌米谷。","官租未送，莫尝酒肉。","不寻闲事，门户清肃。","粗然不阙，教子习读。","渐入士类，光庇宗族。","岁时礼节，亲邻往复。","孙曾济济，所谓受福。","古有茅容，鸡供母馔。","自将野菜，与客同饭。","张氏九世，同居相爱。","官家亲问，写忍以对。","郤公贫馁，甥侄孤遗。","饭藏两颊，以活两儿。","王丹在乡，亲行农野。","多载酒肴，劝赏勤者。","前贤所为，可以为师。","美哉农者，国之良民。","直道本业，必养其亲。","奸未必富，拙未必贫。","地道无穷，天有冬春。","筋力在己，日用日新。","俯仰求人，莫如求身。"],0,84,"宋"],["文宣王及其弟子赞 其二十七","赵构","四言",["念昔颛孙，商德与邻。","学以干禄，问以书绅。","参前倚衡，忠信是遵。","色取行违，作戒后人。"],0,249,"宋"],["自述真赞","释通慧","四言",["真兮寥廓，郢人图雘。","岳耸云空，澄潭月跃。"],0,123,"宋"],["畴依  其一一","王柏","四言",["贤哉颜子，好学独称。","既竭吾才，欲罢不能。","不贰不迁，庶乎亚圣。","一箪一瓢，不幸短命。"],0,"x137","宋"],["圣号雅二篇 其四","赵湘","四言",["赫赫君道，皇其崇之。","遹彼丕教，皇实基之。","维基伊何，实以无为。","海隅苍生，被服熙熙。"],0,126,"宋"],["景德以后祀五方帝十六首 其八 黄帝降神用《高安》。","郊庙朝会歌辞","四言",["坤舆厚载，黄裳元吉。","宅中居正，含章抱质。","分王四季，其功靡秩。","育此群生，首兹六律。"],0,"x207","宋"],["偈二十七首 其十一","释绍隆","四言",["目前无法，万象森然。","意在目前，突出难辨。"],0,252,"宋"],["颂古一百二十一首 其二十八","释宗杲","四言",["𫗋𫗋风松，萧萧雨桧。","师子咬人，韩獹逐瑰。"],0,"x112","宋"],["潘子贱改月帖赞","岳珂","四言",["公立柱下，直声凛如。","气则不馁，而况于书。","待人以情，真意浃洽。","于嗟前修，动则可法。"],0,"x202","宋"],["示徒三戒 其二","释原妙","四言",["举心动念，无益于人，戒之莫起。"],0,137,"宋"],["政和亲郊三首 其一 配位酌献用《大宁》。","郊庙朝会歌辞","四言",["于穆文祖，妙道九德。","默契灵心，肇基王迹。","启佑后人，垂裕罔极。","合食昭荐，孝思维则。"],0,"x207","宋"],["皇后庙十五首 其十三 亚献用《恭安》。","郊庙朝会歌辞","四言",["宗臣率礼，步玉锵锵。","吉蠲斯献，百禄是将。"],0,"x207","宋"],["须菩提赞","李之仪","四言",["敷座而坐，如日初晓。","护念付属，一时俱了。","非此老人，其谁能表。","漫自形容，本无欠少。"],0,"x203","宋"],["送关都官致仕 其三","陈襄","四言",["有坚松柏，君子斧之。","有实秠稷，农夫有之。","天子有老，曷其与归。"],0,50,"宋"],["绍兴亲享明堂二十六首 其十七 皇帝还小次用《仪安》。","郊庙朝会歌辞","四言",["匏尊既举，秸席未移。","有德斯顾，靡神不娭。","物情肃穆，天宇清夷。","宅中受命，永复邦基。"],0,"x207","宋"],["偈二十首 其十二","释鼎需","四言",["世尊拈花，迦叶微笑。","师铁得金，一场富贵。","马祖升堂，百丈卷席。","为众竭力，祸出私门。"],0,10,"宋"],["文宣王及其弟子赞 其六十七","赵构","四言",["孰封于萧，实惟子柳。","夙饫格言，克遵善诱。","明德斯馨，贤业所就。","以侑于儒，传芳逾茂。"],0,249,"宋"],["苏文忠公书简帖赞","岳珂","四言",["云涛稽天，睨而陆之。","神龙在渊，颔而触之。","一世谝谝，稚而畜之。","节坚气全，墨卿卜之。","淳古简严，芝繇仆之。","劲直不然，䖃鲊目之。"],0,"x202","宋"],["种药苗二首 种决明 其二","苏辙","四言",["决明明目，功见本草。","食其花叶，亦去热恼。","有能益人，矧可以饱。","三嗅不食，笑杜陵老。"],0,"x135","宋"],["高宗皇帝韦杜三诗御书赞","岳珂","四言",["古者赋诗，惟以言志。","或陈卒章，或摭首意。","惟圣秉箓，启于多艰。","北乡之悲，銮舆未还。","岁时顾瞻，雪涕凝伫。","宸毫寄心，亦或有取。","惟唐二臣，一唱一酬。","节物感怀，下笔不休。","西清燕闲，念此夐隔。","郁乎居南，凄其望北。","璧跗琅钮，舒卷龙笺。","白云其翔，契阔十年。","臣之管窥，尝读国史。","曹勋衣襟，洪皓幅纸。","或恸或泣，或命以官。","或间持书，或使问安。","玉音琅琅，具记青汗。","宜其注思，感此归雁。","三诗之作，迭写杜韦。","社日二篇，独书前诗。","昭哉圣情，如古之赋。","迄其弗偿，徒切舜慕。","霜露之履，谁无此哀。","止或尼之，谓之何哉。","是帖之传，式媲遗训。","敌忾于王，见者必奋。"],0,"x202","宋"],["咄庵","释居简","四言",["咄地一下，好肉剜疮。","更安名字，雪上加霜。"],0,"x94","宋"],["宋江三十六赞 其三十三 双尾蝎解宝","龚开","四言",["医师用蝎，其体贵全。","反其常性，雷公汝嫌。"],0,103,"宋"],["大观秋分夕月四首 其四 送神。","郊庙朝会歌辞","四言",["四扉大开，五云车立。","霓裾娣从，风翿童执。","摇曳胥来，锵洋爰集。","歆我严禋，西面以揖。"],0,"x207","宋"],["景祐祭文宣王庙六首 迎神用《凝安》。","郊庙朝会歌辞","四言",["大哉至圣，文教之宗。","纪纲王化，丕变民风。","常祀有秩，备物有容。","神其格思，是仰是崇。"],0,"x207","宋"],["送关都官致仕 其四","陈襄","四言",["野有白驹，来食我麰。","君子之往，胡为不留。","我心悠悠，为天子忧。"],0,50,"宋"],["和子瞻次韵陶渊明劝农诗 其三","苏辙","四言",["掇拾于川，搜捕于陆。","俯鞠妇子，仰荐昭穆。","闽乘其偷，载耒逐逐。","计无百年，谋止信宿。"],0,"x135","宋"],["乾道元年册皇太子四首 其三","郊庙朝会歌辞","四言",["乐备既奏，和声冲融。","玉简金书，翔鸾戏鸿。","下拜登受，旋于青宫。","仪辰作贰，垂休无穷。"],0,"x207","宋"],["路人有弃其子者因作是诗予时奉使湖外","彭汝砺","四言",["彼呱呱者，其孰弃之。","彼嬛嬛者，其孰收之。","彼禽何知，能字其雏。","飞前则顾，饥啄则呼。","孰谓斯人，禽之不如。","彼雏之微，皆得所依。","婉娩其音，婆娑其衣。","孰谓斯人，乃独无归。","我号斯言，以告采诗。"],0,"x143","宋"],["和陶命子韵示津调官 其十","吴芾","四言",["我本白丁，恩及童孩。","虽由先德，亦自书来。","汝诚博古，为世实才。","时或未遇，又何慊哉。"],0,"x95","宋"],["示徒三戒 其一","释原妙","四言",["开口动舌，无益于人，戒之莫言。"],0,137,"宋"],["偈颂一百三十六首 其六十八","释惟一","四言",["宗通说通，抹过西东。","无两舌头，有双箭锋。","因甚如此，闽蜀同风。"],0,143,"宋"],["简求心要书绅辞","晁迥","四言",["以静制动，静为躁君。","以虚受有，虚缘葆真。","详而后习，可书诸绅。"],0,199,"宋"],["偈颂八十七首 其三十八","释慧开","四言",["循规守短，无绳自缚。","纵横无碍，外道魔军。","存心澄寂，默照邪禅。","恣意忘缘，解脱深坑。","惺惺不昧，带锁担枷。","思善思恶，地狱天堂。","佛见法见，二铁围山。","念起即觉，弄精魂汉。","兀然习定，鬼家活计。","进则迷理，退则乖宗。","不进不退，有气死人。"],0,65,"宋"],["嘉定二年册皇太子四首 其三","郊庙朝会歌辞","四言",["明两承曜，作贰宣猷。","茂德金昭，令誉川流。","豫定厥本，永贻乃谋。","三朝致养，问寝龙楼。"],0,"x207","宋"],["春日  其二","陈杰","四言",["春日迟迟，春风载时，春服有晖。","念我蚕女，勚于桑畴。"],0,174,"宋"],["文宣王及其弟子赞 其五十七","赵构","四言",["有卫伯玉，夫子与居。","寡过未能，荐赞使乎。","以尸谏君，友则史鱼。","果得进贤，烂然简书。"],0,249,"宋"],["明道亲享先农十首 其五 皇帝初献用《禧安》。","郊庙朝会歌辞","四言",["云罍已实，玉爵有舟。","荐于灵籍，伫乃神休。"],0,"x207","宋"],["谢颜庵主拄杖","释慧空","四言",["拄杖一枝，苍龙出水。","大流激湍，众峰齐峙。"],0,"x118","宋"],["颂古一百首 其十九","释智愚","四言",["白石凿凿，韫尔美璞。","君子道晦，君子斯乐。"],0,"x153","宋"],["绍兴朝会十三首 其二 酒一行用文舞。","郊庙朝会歌辞","四言",["文物以纪，藻色以明。","礼备乐举，遹观厥成。","睿知有临，诞敷文德。","教雨化风，洽此四国。"],0,"x207","宋"],["偈三十五首 其二十九","释祖珍","四言",["向上一路，千圣不传。","学者劳形，如猿捉影。"],0,155,"宋"],["大中祥符五岳加帝号祭告八首 其六 北岳。","郊庙朝会歌辞","四言",["仰止灵岳，镇于朔方。","增崇懿号，度越彝章。","祗荐嘉乐，式陈令芳。","永资纯佑，国祚蕃昌。"],0,"x207","宋"],["绍兴以后时享二十五首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["观德宗祏，奕世烈光。","有严祀典，粤循旧章。","乐谐九变，献举重觞。","燕娭如在，戬谷穰穰。"],0,"x207","宋"],["文宣王及其弟子赞 其三十九","赵构","四言",["人谁无子，尔嗣标奇。","行为世范，学为人师。","请车诚非，顾匪其私。","千载之下，足以示慈。"],0,249,"宋"],["南郊大礼庆成诗五首 其三 有事于南郊","苏颂","四言",["惟皇继天，宅位三祀。","灵德及远，嘉生茂遂。","仲冬月良，一阳气至。","上将告成，礼严肆类。","自庙徂郊，万灵拱卫。","天收宿雰，日丽佳气。","月逾既望，再登午陛。","对越苍祗，配以太帝。","奠玉酌匏，升烟燎币。","志尽虔恭，备成熙事。","玉舆旋衡，欢声沸渭。","皇专乃诚，下蒙厥惠。"],0,"x85","宋"],["祫飨太庙 其七","郊庙朝会歌辞","四言",["皇皇在宥，品物由庚。","文教纯被，武功告成。","流颂乐府，拥休宗祊。","帝奉祼瓒，钦哉孝诚。"],0,"x207","宋"],["临终颂","冯楫","四言",["初三十一，中九下七。","老人言尽，龟哥眼赤。"],0,78,"宋"],["绍兴以后祀感生帝十六首 彻豆用《肃安》。","郊庙朝会歌辞","四言",["洁陈斯备，昭格惟禋。","神歆以饫，宰彻其馂。","清歌振晓，叶气流春。","永锡祚嗣，以渥烝民。"],0,"x207","宋"],["寿皇子 其一","程珌","四言",["磊魁晶荧，岁有常期，见于秋分。","秋分维何，天高气清。","玉蟾吐𪸩，银汉无声。","澄霄一色，万里云平。","此时候之，出丙入丁。","所出之国，政化和平。","人生其时，既寿且宁。","矧复前星，以及子星，与之并明。","天启休期，应期挺生。"],0,255,"宋"],["画木石赞","黄庭坚","四言",["小山丛竹，到天古木。","石下有人，定是山谷。"],0,"x66","宋"],["文宣王及其弟子赞 其四十五","赵构","四言",["子敛受封，爰居武城。","亹亹其闻，翩翩其英。","抠衣时习，愿学日明。","诞敷孔教，爵里疏荣。"],0,249,"宋"],["绍兴以后祀感生帝十六首 盥洗用《保安》。","郊庙朝会歌辞","四言",["冲牙锵鸣，肃容专精。","交神之义，罔敢弗诚。","设洗于阼，罍水惟清。","盥以致洁，感通神明。"],0,"x207","宋"],["绍兴二十八年祀圜丘 还内用《采茨》。","郊庙朝会歌辞","四言",["五辂鸣銮，八神警跸。","天官景从，莫不祗栗。","祲威盛容，昭哉祖述。","祚我无疆，叶气充溢。"],0,"x207","宋"],["御楼 其二","郊庙朝会歌辞","四言",["青坛帝籍，在国之东。","荐笾执耜，率礼和容。","鸣鸾回跸，瑞气凝空。","万方瞻仰，百顺来同。"],0,"x207","宋"],["乾道元年册皇太子四首 其二","郊庙朝会歌辞","四言",["于维皇储，玉润金声。","体震之荐，重离之明。","册宝具举，环佩锵鸣。","守器承祧，惟邦之荣。"],0,"x207","宋"],["熙宁祀皇地祇十二首 其十一 彻豆用《丰安》。","郊庙朝会歌辞","四言",["曳我黼黻，履舄接武。","锵我珩璜，降升圉圉。","其将肆兮，既曰不侮。","其终彻兮，恭钦惟主。"],0,"x207","宋"],["畴依  其四","王柏","四言",["禹乃嗣兴，载平水土。","天锡九畴，彝伦攸叙。","克俭克勤，不伐不矜。","有典有则，贻厥子孙。"],0,"x137","宋"],["明堂庆成颂  其五","徐鹿卿","四言",["时维秋季，涓吉中辛。","本以忱敬，秩以仪文。"],0,73,"宋"],["熙宁祀皇地祇十二首 其十 亚、终献用《仪安》。","郊庙朝会歌辞","四言",["折俎在笾，胾羹在豆。","何以酌之，酒醴是侑。","何以锡之，贻尔眉寿。","何以格之，永尔康阜。"],0,"x207","宋"],["上耿泉生朝  其五","杨简","四言",["是司九府，爰总数路。","爰究爰度，阜丰化布，国用是裕。"],0,118,"宋"],["和子瞻次韵陶渊明劝农诗 其六","苏辙","四言",["莫为之先，冥不谓鄙。","一夫前行，百夫具履。","以为不信，出视同轨。","期尔十年，风变而美。"],0,"x135","宋"],["采薇图","蔡必荐","四言",["西山有薇，美人不移。","西山无薇，美人不归。","采薇采薇，山是人非。","薇满西山，不生夷齐。"],0,244,"宋"],["偈颂一百三十三首 其一二九","释法薰","四言",["妙旨迅速，言说来迟。","龙门上客，未举先知。"],0,31,"宋"],["文宣王及其弟子赞 其四十二","赵构","四言",["褒锡朱虚，在器轮舆。","儒室振领，圣门曳裾。","贤业得蕴，美材以摅。","百世不刊，载观成书。"],0,249,"宋"],["大中祥符五岳加帝号祭告八首 其七 中岳。","郊庙朝会歌辞","四言",["岩岩神岳，作镇中央。","肃奉徽册，尊名孔章。","聿降飙驾，载献兰觞。","熙事允洽，宝祚弥昌。"],0,"x207","宋"],["种药苗二首 种甖粟 其三","苏辙","四言",["老人气衰，饮食无几。","食肉不消，食菜寡味。","柳槌石钵，煎以蜜水。","便口利喉，调养肺胃。"],0,"x135","宋"],["文宣王及其弟子赞 其六十六","赵构","四言",["勉勉子车，封邑淳于。","亲炙避席，唯诺趋隅。","发微既博，雅道是扶。","抑可尚也，不亦美乎。"],0,249,"宋"],["僧问四宾主因而有颂颂之 其六","释重显","四言",["主中之宾，温故知新。","互换相照，师子嚬呻。"],0,"x156","宋"],["孟夏雩祀二首 其二 酌献用《感安》。","郊庙朝会歌辞","四言",["龙见而雩，神之来格。","牺象精良，威灵赫奕。"],0,"x207","宋"],["畴依  其一二","王柏","四言",["曾子虽鲁，纤悉不遗。","吾道一贯，以鲁得之。","易箦得正，手足斯启。","仁为己任，死而后已。"],0,"x137","宋"],["褒山定明禅师赞","释清远","四言",["四海称唐，师出华阳。","不起燕坐，翱翔帝乡。","名与山俱，道逐时芳。","济民助国，能雨能旸。","贫者获富，热者得凉。","群蒙所归，实在不亡。"],0,116,"宋"],["嘉定二年册皇太子四首 其二","郊庙朝会歌辞","四言",["太极端御，少阳肃祗。","珉简斯镂，衮服孔宜。","式奏备乐，乃陈盛仪。","下拜登受，永言保之。"],0,"x207","宋"],["淳熙十二年加上太上皇帝太上皇后尊号十一首 其十 太上皇后出合升御坐用《坤安》。降坐同。","郊庙朝会歌辞","四言",["天相慈皇，庆臻壶闱。","徽柔内修，寿与天齐。","既承皇欢，载觌母仪。","懿典鸿名，永绥多祺。"],0,"x207","宋"],["力外吟","邵雍","四言",["以少为多，以无为有。","力外周旋，不能长久。"],0,"x57","宋"],["偈颂一百零二首 其二十二","释绍昙","四言",["有亦不管，无亦不管。","饭来开口，睡来合眼。"],0,"x108","宋"],["南丰军山庙碑","曾肇","四言",["土膏起兮，泉流驶兮。","牧徂于田，偕妇子兮。","既耕且艺，耘且耔兮。","一岁之功，在勤始兮。","野无蟊螟，塘有水兮。","非神之力，其谁使兮。","我苞盈兮，我实成兮。","挥镰铚铚，风雨声兮。","囷仓露积，如坻京兮。","遗𥟱滞穗，富鳏茕兮。","饮食劝酬，销忿争兮。","傥非神助，岁莫登兮。","我有室家，神所祐兮。","我有旌倪，神所寿兮。","神之惠我，维其旧兮。","上之报神，亦云厚兮。","酾酒刑牲，殽杯丰兮。","吹箫考鼓，声逢逢兮。","我民荐献，无终穷兮。","千秋万岁，保斯宫兮。"],0,26,"宋"],["王元之真赞","黄庭坚","四言",["天赐王公，佐我太宗。","学问文章，致于匪躬。","四方来庭，上稍宴衎。","公舍瓦石，责君尧舜。","采芝商山，以切直去。","惟是文章，许以独步。","白发还朝，泣思轩辕。","鸡犬舔鼎，群飞上天。","真宗好文，且大用公。","太阿出柙，公挺其锋。","龙怒鳞逆，在廷岌岌。","万物并流，砥柱中立。","古之遗直，叔向以之。","呜呼王公，其尚似之。"],0,"x66","宋"],["偈颂一百零二首 其四十五","释慧远","四言",["初二十六，齑羹豆粥。","日午夜行，投明暗宿。"],0,154,"宋"],["绍定三年寿明仁福慈睿皇太后册宝九首 其九","郊庙朝会歌辞","四言",["皇文既举，庆礼告虔。","肇自宫闱，格于幅员。","子称母寿，母谓子贤。","陟降在兹，隆名际天。"],0,"x207","宋"],["标指六偈 语默","释清远","四言",["至道非言，言亦可传。","可传何也，应物而宣。","言虽应物，物自无物。","无物之言，言音自没。","绝言之语，妙应还普。","道非晦明，语默同取。","举复谁唱，物物虚旷。","咸通大千，遍乎尘想。","品类非一，同言异出。","圆音落落，凡圣俱适。","千品万类，薰含种智。","故此一门，称无量义。","山河宣演，草木扬音。","长说无间，所谓甚深。","深兮甚浅，不动情见。","最省工夫，凡夫不荐。","不荐最亲，妙义敷陈。","欢言即笑，恚怒即嗔。","嗔为金刚，喜为迦叶。","华藏毗卢，心心相接。","接兮可见，莫看背面。","无字密言，从兹出现。","现复谁论，非用耳闻。","六根共户，妙偈星分。","森罗经文，不出一尘。","非舌非辩，雷转电奔。","展之在手，何法不有。","纵横三界，无一渗漏。","时人不信，执言说病。","依倚前尘，以为决定。","决定是心，决定是尘。","心尘所使，非自由人。","诸圣苦口，随愚过咎。","巧说多词，强为分剖。","法无言说，汝须善别。","舍离语言，生死自绝。","凡夫闻此，无说过咎。","取彼无言，冥然长久。","端坐暗狱，以心相续。","背却语言，犹如土木。","舍有之无，落在邪途。","有无俱病，二病俱祛。","祛复何去，不离当处。","当处不生，语默相取。","取兮不知，是东是西。","说即不说，不疑即疑。","故称佛子，了事凡夫。","是何凡夫，问取李胡。"],0,116,"宋"]]