[null,["啄木","齐己","四言",["啄木啄啄，鸣林响壑。","贪心既缘，利嘴斯凿。","有朽百尺，微虫斯宅。","以啄去害，啄更弥剧。","层崖豫章，耸干苍苍。","无纵尔啄，摧我栋梁。"],0,"x29","唐"],null,["唐大飨拜洛乐章 敬和","武则天","四言",["兰俎既升，苹羞可荐。","金石载设，咸英已变。","林泽斯总，山川是遍。","敢用敷诚，实惟忘倦。"],0,96,"唐"],["中和乐九章 歌登封第一","卢照邻","四言",["炎图丧宝，黄历开璇。","祖武类帝，宗文配天。","玉銮垂日，翠华陵烟。","东云干吕，南风入弦。","山称万岁，河庆千年。","金绳永结，璧丽长悬。"],0,250,"唐"],["郊庙歌辞 仪坤庙乐章 金奏","徐彦伯","四言",["阴灵效祉，轩曜降精。","祥符淑气，庆集柔明。","瑶俎既列，雕桐发声。","徽猷永远，比德皇英。"],0,147,"唐"],["郊庙歌辞 享先农乐章 肃和","褚亮","四言",["樽彝既列，瑚簋方荐。","歌工载登，币礼斯奠。","肃肃享祀，颙颙缨弁。","神之听之，福流寰县。"],0,150,"唐"],null,["郊庙歌辞 后唐宗庙乐舞辞 武成舞","崔居俭、卢文纪","四言",["艰难王业，返正皇唐。","先天再造，却日重光。","汉绍世祖，夏资少康。","功成德茂，率祀无疆。"],0,101,"唐"],null,["郊庙歌辞 享太庙乐章 雍和","魏征","四言",["崇兹享祀，诚敬兼至。","乐以感灵，礼以昭事。","粢盛咸絜，牲牷孔备。","永言孝思，庶几不匮。"],0,152,"唐"],["郊庙歌辞 享太庙乐章 雍和","魏征","四言",["於穆清庙，聿修严祀。","四县载陈，三献斯止。","笾豆撤荐，人祗介祉。","神惟格思，锡祚不已。"],0,152,"唐"],null,["郊庙歌辞 梁郊祀乐章 其五 庆和","赵光逢","四言",["惟德动天，有感必通。","秉兹一德，禋于六宗。","钦夤宝命，恭肃礼容。","来顾来享，永穆皇风。"],0,56,"唐"],["郊庙歌辞 梁郊祀乐章 庆肃","赵光逢、张衮","四言",["笾豆簠簋，黍稷非馨。","懿兹彝器，厥德惟明。","金石匏革，以和以平。","繇此无体，期乎永宁。"],0,0,"唐"],["郊庙歌辞 梁郊祀乐章 其六 庆和","赵光逢","四言",["天惟佑德，辟乃奉天。","交感斯在，昭事罔愆。","岁功已就，王道无偏。","于焉报本，是用告虔。"],0,56,"唐"],["郊庙歌辞 夕月乐章 肃和","佚名","四言",["测妙为神，通微曰圣。","坎祀贻则，郊禋展敬。","璧荐登光，金歌动映。","以载嘉德，以流曾庆。"],0,"x14","唐"],null,["郊庙歌辞 享节愍太子庙乐章 登歌酌鬯","佚名","四言",["灼灼重明，仰承元首。","既贤且哲，惟孝与友。","惟孝虽遥，灵规不朽。","礼因诚致，备絜玄酒。"],0,"x14","唐"],["郊庙歌辞 祭汾阴乐章 姑洗征","刘晃","四言",["大君出震，有事郊禋。","斋戒既肃，馨香毕陈。","乐和礼备，候暖风春。","恭惟降福，实赖明神。"],0,202,"唐"],["郊庙歌辞 仪坤庙乐章 永和","徐彦伯","四言",["猗若清庙，肃肃荧荧。","国荐严祀，坤兴淑灵。","有几在室，有乐在庭。","临兹孝享，百禄惟宁。"],0,147,"唐"],["中和乐九章 歌储宫第六","卢照邻","四言",["波澄少海，景丽前星。","高禖诞圣，甲观升灵。","承规翠所，问寝瑶庭。","宗儒侧席，问道横经。","山宾皎皎，国胄青青。","黄裳元吉，邦家以宁。"],0,250,"唐"],null,["郊庙歌辞 明堂乐章 肃和","褚亮","四言",["象天御宇，乘时布政。","严配申虔，宗禋展敬。","罇罍盈列，树羽交映。","玉币通诚，祚隆皇圣。"],0,150,"唐"],["郊庙歌辞 享惠昭太子庙乐章 登歌","杜羔","四言",["因心克孝，位震遗芬。","宾天道茂，轸怀气分。","发祗乃祀，咳叹如闻。","二歌斯升，以咏德薰。"],0,198,"唐"],null,["郊庙歌辞 仪坤庙乐章 昭升","薛稷","四言",["阳灵配德，阴魄昭升。","尧坛凤下，汉室龙兴。","伣天作对，前旒是凝。","化行南国，道盛西陵。","造舟集灌，无德而称。","我粢既絜，我醴既澄。","阴阴灵庙，光灵若凭。","德馨惟享，孝思烝烝。"],0,67,"唐"],null,["中和乐九章 歌南郊第四","卢照邻","四言",["虔郊上帝，肃事圆丘。","龙驾四牡，鸾旗九斿。","钟歌晚引，紫炀高浮。","日丽苍璧，云飞鸣球。","皇之庆矣，万寿千秋。"],0,250,"唐"],null,["郊庙歌辞 梁郊祀乐章 庆顺","赵光逢","四言",["圣皇戾止，天步舒迟。","干干睿相，穆穆皇仪。","进退必肃，陟降是祗。","六变克协，万灵协随。"],0,56,"唐"],["祈谷乐章 肃和","褚亮","四言",["履艮斯绳，居中体正。","龙运垂祉，昭符启圣。","式事严禋，聿怀嘉庆。","惟帝永锡，时皇休命。"],0,150,"唐"],null,["郊庙歌辞 梁郊祀乐章 庆熙","赵光逢、张衮","四言",["哲后躬享，旨酒斯陈。","王恭无斁，严祀维夤。","皇祖以配，大孝以振。","宜锡景福，永休下民。"],0,0,"唐"],null,["郊庙歌辞 雩祀乐章 豫和","佚名","四言",["鸟纬迁序，龙星见辰。","纯阳在律，明德崇禋。","五方降帝，万宇安人。","恭以致享，肃以迎神。"],0,"x14","唐"],["郊庙歌辞 雩祀乐章 豫和","佚名","四言",["祀遵经设，享缘诚举。","献毕于樽，彻临于俎。","舞止干戚，乐停柷敔。","歌以送神，神还其所。"],0,"x14","唐"],null,["郊庙歌辞 后唐宗庙乐舞辞 应天舞","崔居俭、卢文纪","四言",["晋国肇兴，雄图再固。","黼黻帝道，金玉王度。","皇天无亲，惟德是辅。","载诞英明，永光圣祚。"],0,101,"唐"],["郊庙歌辞 后唐宗庙乐舞辞 雍煕舞","崔居俭、卢文纪","四言",["仁君御宇，寰海谧清。","运符武德，道协文明。","九成式敍，百度惟贞。","金门积庆，玉叶传荣。"],0,101,"唐"],null,null,null,["刘方平壁画山","皇甫冉","四言",["墨妙无前，性生笔先。","回溪已失，远嶂犹连。","侧径樵客，长林野烟。","青峰之外，何处云天。"],0,93,"唐"],null,["郊庙歌辞 梁郊祀乐章 庆熙","张衮","四言",["哲后躬享，旨酒斯陈。","王恭无斁，严祀惟寅。","皇祖以配，大孝以振。","宜锡景福，永休下民。"],0,68,"唐"],["唐大飨拜洛乐章 九和","武则天","四言",["祗荷坤德，钦若干灵。","惭惕罔置，兴居匪宁。","恭崇礼则，肃奉仪形。","惟凭展敬，敢荐非馨。"],0,96,"唐"],["郊庙歌辞 梁郊祀乐章 庆平","赵光逢","四言",["天命降鉴，帝德惟馨。","享祀不忒，礼容孔明。","奠璧布币，荐纯献精。","神祐以荅，敷锡永宁。"],0,56,"唐"],["凉雨一章","萧颖士","四言",["习习凉风，泠泠浮飙。","君子乐胥，于其宾僚。","有女斯夭，式歌且谣。","欲言终宥，惟以招邀，于胥乐兮。"],0,199,"唐"],null,null,null,["唐大飨拜洛乐章 禋和","武则天","四言",["百礼崇容，千官肃事。","灵降舞兆，神凝有粹。","奠享咸周，威仪毕备。","奏夏登列，歌雍撤肆。"],0,96,"唐"],null,["郊庙歌辞 享隐太子庙乐章 诚和","佚名","四言",["道閟鹤关，运缠鸠里。","门集大命，俾歆嘉祀。","礼亚六瑚，诚殚二簋。","有诚颙若，神斯戾止。"],0,"x14","唐"],["郊庙歌辞 享先农乐章 咸和","褚亮","四言",["粒食伊始，农之所先。","古今攸赖，是曰人天。","耕斯帝籍，播厥公田。","式崇明祀，神其福焉。"],0,150,"唐"],["虞获子鹿","韦应物","四言",["虞获子鹿，畜之城陬。","园有美草，池有清流。","但见蹶蹶，亦闻呦呦。","谁知其思，岩谷云游。"],0,"x10","唐"],null,null,["郊庙歌辞 仪坤庙乐章 肃和","张齐贤","四言",["祼圭既濯，郁鬯既陈。","画幕云举，黄流玉醇。","仪充献酌，礼盛众禋。","地察惟孝，愉焉飨亲。"],0,243,"唐"],["郊庙歌辞 襃德庙乐章 昭德","佚名","四言",["道赫梧宫，悲盈蒿里。","爰赐徽烈，载敷嘉祀。","享洽四时，规陈二簋。","灵应昭格，神其戾止。"],0,"x14","唐"],["唐德明兴圣庙乐章 送神","李纾","四言",["元精回复，灵贶繁滋。","风洒兰路，云摇桂旗。","高丘缅邈，凉部逶迟。","瞻望靡及，缠绵永思。"],0,255,"唐"],null,["郊庙歌辞 中宗祀昊天乐章 福和","佚名","四言",["九成爰奏，三献式陈。","钦承景福，恭托明禋。"],0,"x14","唐"],["郊庙歌辞 晋朝飨乐章 初举酒文同乐","佚名","四言",["赫矣昌运，明哉圣王。","文兴坠典，礼复旧章。","鸳鸾济济，鸟兽跄跄。","一人有庆，万福无疆。"],0,"x14","唐"],null,["郊庙歌辞 享太庙乐章 永和","魏征、褚亮","四言",["肃肃清祀，烝烝孝思。","荐享昭备，虔恭在兹。","雍歌彻俎，祝嘏陈辞。","用光武志，永固鸿基。"],0,223,"唐"],["郊庙歌辞 享太庙乐章 大定舞","李回","四言",["受天明命，敷佑下土。","化时以俭，卫文以武。","氛消夷夏，俗臻往古。","亿万斯年，形于律吕。"],0,127,"唐"],["郊庙歌辞 德明兴圣庙乐章 迎神","李纾","四言",["元尊九德，佐尧光宅。","烈祖太宗，方周作伯。","响怀霜露，乐变金石。","白云青风，髣髴来格。"],0,255,"唐"],["郊庙歌辞 中宗祀昊天乐章 肃和","佚名","四言",["悠哉广覆，大矣曲成。","九玄著象，七曜贞明。","珪璧是奠，酝酎斯盈。","作乐崇德，爰畅咸英。"],0,"x14","唐"],["郊庙歌辞 中宗祀昊天乐章 亚献","佚名","四言",["三灵降飨，三后配神。","虔敷藻奠，敬展郊禋。"],0,"x14","唐"],null,null,["泽宫诗 其一","刘禹锡","四言",["秩秩泽宫，有的维鹄。","祁祁庶士，于以干禄。"],0,"x21","唐"],["泽宫诗 其二","刘禹锡","四言",["彼鹄斯微，若止若翔。","千里之差，起于毫芒。"],0,"x21","唐"],["泽宫诗 其三","刘禹锡","四言",["我矢既直，我弓既良。","依于高墉，因我不臧。"],0,"x21","唐"],null,null,["唐享昊天乐 第十一","武则天","四言",["礼终肆类，乐阕九成。","仰惟明德，敢荐非馨。","顾惭菲奠，久驰云𫐌。","瞻荷灵泽，悚恋兼盈。"],0,96,"唐"],null,["泽宫诗 其四","刘禹锡","四言",["高墉伊何，维器与时。","视之以心，谁谓鹄微。"],0,"x21","唐"],["郊庙歌辞 祀风师乐章 迎俎酌献","包佶","四言",["德盛昭临，迎拜巽方。","爰候发生，式荐馨香。","酌醴具举，工歌载扬。","神歆六律，恩降百祥。"],0,30,"唐"],["曳鼎歌","武则天","四言",["羲农首出，轩昊膺期。","唐虞继踵，汤禹乘时。","天下光宅，海内雍熙。","上玄降鉴，方建隆基。"],0,96,"唐"],["郊庙歌辞 享孔子庙乐章 送神","佚名","四言",["醴溢牺象，羞陈俎豆。","鲁壁类闻，泗川入觏。","里校覃福，胄筵承祐。","雅乐清音，送神具奏。"],0,"x14","唐"],["彼农二章 一","陆龟蒙","四言",["世路浇险，淳风荡除。","彼农家流，犹存厥初。","藁焉而席，茨焉而居。","首乱如葆，形枯若腒。","大耋既鲐，童子未𪚐。","以负以载，悉薅悉鉏。","我慕圣道，我躭古书。","小倦于学，时游汝庐。","有饭一盛，莫盐莫蔬。","有𦈡一缇，不襟不袪。","所谓饥寒，汝何逭欤。"],0,"x24","唐"],null,["郊庙歌辞 享太庙乐章 雍和","魏征、褚亮","四言",["於穆清庙，聿修严祀。","四县载陈，三献斯止。","笾豆彻荐，人祇介祉。","神维格思，锡祚不已。"],0,223,"唐"],null,["彼农二章 二","陆龟蒙","四言",["禹贡厥田，上下各异。","善人为邦，民受其赐。","去年西成，野有遗穗。","今夏南亩，旱气赤地。","遭其丰凶，概歛无二。","退输弗供，进诉弗视。","号于旻天，以血为泪。","孟子有言，王无罪岁。","诗以穷辞，以嫉悍吏。"],0,"x24","唐"],null,["题僧房绝句","吕岩","四言",["唐朝进士，今日神仙。","足蹑紫雾，却返洞天。"],0,176,"唐"],["郊庙歌辞 雩祀乐章 肃和","褚亮","四言",["朱鸟开辰，苍龙启映。","大帝昭飨，群生展敬。","礼备怀柔，功宣舞咏。","旬液应序，年祥协庆。"],0,150,"唐"],["绣袈裟衣缘","长屋","四言",["山川异域，风月同天。","寄诸佛子，共结来缘。"],0,92,"唐"],null,["郊庙歌辞 祭方丘乐章 金奏","佚名","四言",["坤元至德，品物资生。","神凝博厚，道协高明。","列镇五岳，环流四瀛。","于何不载，万宝斯成。"],0,"x14","唐"],["郊庙歌辞 德明兴圣庙乐章 德明酌献","李纾","四言",["清庙弈弈，和乐雍雍。","器尊牺象，礼属宗公。","白水方[祼]，黄流在中。","谟明之德，万古清风。"],0,255,"唐"],["祭汾阴乐章","韩思复","四言",["大乐和畅，殷荐明神。","一降通感，八变必臻。","有求斯应，无德不亲。","降灵醉止，休征万人。"],0,81,"唐"],["郊庙歌辞 享太庙乐章 大基舞","魏征","四言",["猗与祖业，皇矣帝先。","剪商德厚，封唐庆延。","在姬犹稷，方晋逾宣。","基我鼎运，于斯万年。"],0,152,"唐"],["郊庙歌辞 享文敬太子庙乐章 登歌","陈京","四言",["歌以德发，声以乐贵。","乐善名存，追仙礼异。","鸾旌拱修，凤鸣合次。","神听皇慈，仲月皆至。"],0,8,"唐"],["郊庙歌辞 祭方丘乐章 顺和","佚名","四言",["坤厚载物，德柔垂祉。","九域咸雍，四溟为纪。","敬因良节，虔修阴祀。","广乐式张，灵其降止。"],0,"x14","唐"]]