[["浪淘沙 寄眉令妹","钟青","词",["寂寞久临风。","敛步从容。","春来懒玩小墙东。","怕他撩乱花飞处，芳草茸茸。","忆别恨匆匆。","失语无穷。","何如那日莫相逢。","可惜一番光景好，心与谁同。"],0,253,"清"],["太常引 七夕早起，偶与女媛围棋","徐淑","词",["朝来倦绣且围棋。","姑妇固相宜，母女亦何奇。","但瓜葛、休生诳欺。","卢胡一笑，楸枰白黑，转眼总忘机。","空自论高低，还与汝、商量晒衣。"],0,38,"清"],["绮罗香 早春寄怀静和、瑞芳两张夫人、静来浦夫人","徐淑","词",["巾帼娴诗，裙钗解赋，屈指而今能几。","幸合朋簪，可惜判襟容易。","柳腰懒、人定都同，蕉心卷、我宁偏异。","倚东风、针线慵拈。","摊书还觉甚无味。","男儿如忆旧雨，一任挥鞭鼓棹，飘然行矣。","各锁深闺，只有梦牵魂系。","愿帘前，燕语休听，惟灯下、鱼书频寄。","待春深、游约西湖，翠眉相对喜。"],0,38,"清"],["虞美人 春感   见《词综》、《词雅》","袁寒篁","词",["轻寒渐退东风暖。","漫把湘帘卷。","眼前萱草不忘忧。","偏是一丝杨柳、一丝愁。","年年对景增凄切。","恨共丁香结。","不如掩了碧窗纱。","一任淡烟微雨、送韶华。"],0,137,"清"],["踏莎行 题唐赤子太史邓尉观梅诗后","袁寒篁","词",["十里寒香，千秋艳玉。","鱼鳞蝶翅重重簇。","五湖人去馆娃荒，问谁消得看花福。","佳客金华，仙才玉局。","风流不数林君复。","彩毫一夜遍春山，吴侬唱作江南曲。"],0,137,"清"],["木兰花慢","袁寒篁","词",["怅人生如寄，禁几度，暮秋天。","看黄菊丹枫，白苹红蓼，斗媚争妍。","江郎祗馀恨赋，对荒原拱木惨无言。","判取愁埋死后，那堪恨积生前。","冰轮常缺亦常圆。","千古总依然。","叹古往今来，勋名竹帛，断梦飞烟。","临风那堪惋吊，只湖山面目似当年。","空外宾鸿作字，分明写出愁篇。"],0,137,"清"],["画堂春 落花","钱宛鸾","词",["今宵微雨昨朝风。","落尽残红。","黄莺啼老绿阴中。","摇漾帘栊。","拾翠人遥，洛浦为云，梦散巫峰。","将开将谢怨春工。","未解芳容。"],0,32,"清"],["浪淘沙","钱宛鸾","词",["好梦几番惊。","花又凋零。","东风难记许多情。","病雨伤春忙过了，一事无成。","空对晚山青。","眉影分明。","却教私语向银屏，燕子飞来人不见，徙倚空亭。"],0,32,"清"],["少年游 题画蜀葵","钱宛鸾","词",["织云制粉，裁霞剪彩，倚醉嫁熏风。","池馆胭脂，芳堤景色，半入画图中。","丹青何处非烟雨，点缀忒精工。","傲杀杜鹃，不输芍药，蜀地笑芙蓉。"],0,32,"清"],["满庭芳","钱宛鸾","词",["宝镜凝霜，玉蓖斗月，见时曾未梳头。","画帘垂地，风自荡银钩。","壁影暗描妩媚，开心处，不肯回眸。","真无奈，生疏特甚，偏为落花愁。","红楼。","终日倚，嗔他燕子，细语绸缪。","想情如中酒，那付东流。","看把绣床整顿，才一会、又拨箜篌。","谁知道，等闲春老，误了少年游。"],0,32,"清"],["点绛唇 对月怀表妹","万淑修","词",["月落乌啼，今宵提起心先碎。","无凭鳞羽。","逾觉人憔悴。","目极烟迷，望断家门路。","携琴处。","海棠花底，共赋伤春句。"],0,194,"清"],["南柯子 病中怀亲","万淑修","词",["不必愁生死，关山隔故乡。","楼头吴橘又初黄。","正是暮秋时候、过重阳。","日落迷芳草，庭深怯晓霜。","病怀无计苦参商。","又见一行征雁、断人肠。"],0,194,"清"],["鹧鸪天 同表妹游董夫人西园","万淑修","词",["花径斜开浅水滨。","疏篁深处绝纤尘。","漫从洛浦邀神女，试到天台访玉真。","携绿绮，伴佳宾。","绕篱小草好相亲。","却忧赋就胶东去，日暮还听鸟弄春。"],0,194,"清"],["玉楼春 元宵后一日忆母","万淑修","词",["东风依旧来庭院。","极目家山云隔断。","辛盘空对九枝花，千里月明人更远。","黄河涛转亲无患。","窗外梅花开已半。","未逢驿使托青鸾，寄去高堂如觐面。"],0,194,"清"],["捣练子 新燕","束蘅","词",["掀帘看，乱红飘。","新燕衔泥补旧巢。","私语侍儿还记得，去年曾否立花梢。"],0,3,"清"],["苏幕遮 秋闺","束蘅","词",["绿窗闲，人已静。","玉兔初升，银烛光摇冷。","倦倚画楼栏自凭。","庭院深深，墙角花枝映。","小池新水明如镜，霜打残荷，几点无多剩。","瘦减腰肢力不胜。","无奈伤秋，愁绝鸳鸯病。"],0,3,"清"],["踏莎行 寄洛珍","束蘅","词",["暖透窗纱，云迷院树。","停针时有熏风度。","闲看稚子捉杨花，小鸟无心来又去。","翡翠生色，芭蕉垂露。","落红返照家门路。","不知何事苦萦怀，怕听杜鹃啼不住。"],0,3,"清"],["长相思 题月下抱琴美人图","陆敏","词",["风正凉。","桂正香。","月照当头树影墙。","良宵暗断肠。","灯闪墙。","月移廊。","欲抚丝桐情自伤。","声中求凤凰。"],0,66,"清"],["蝶恋花 春尽","陆敏","词",["莺唤纱窗惊晓梦。","日上三竿，乱把花枝弄。","杨柳池塘烟水重。","荼蘼香暖时相送。","懊恼游蜂闲打閧。","自卷湘帘，玉笛轻声弄。","暗卜金钱何处用。","六幺倒挂窗前凤。"],0,66,"清"],["青玉案 题赵夫人文淑画","陆敏","词",["寒山闺秀神清彻。","映千尺，流泉雪。","忽见花开来舞蝶。","缣缃乍展，丹铅漫染，点缀香痕湿。","玉人天授生花笔。","非雾非烟空翠滴。","好鸟和鸣呼欲出。","红蕉白萼，柔枝嫩叶，生意毫端集。"],0,66,"清"],["忆秦娥 杜鹃","陆凤池","词",["东风咽。","杜鹃帘外啼红血。","啼红血，一枝竹影，半庭残月。","当年幽恨凭谁说。","乡关望断真凄绝。","真凄绝。","不如归去，旧时宫阙。"],0,102,"清"],["雨中花 秋思","陆凤池","词",["满径芙蓉红如晕。","更交映、桂芳菊润。","听幽砌蛩吟，疏林蝉噪，惹起清秋恨。","每叹流光容易尽。","记七夕、鹊桥渡稳。","早过了中秋，疏风斜雨，又是重阳近。"],0,102,"清"],["渔歌子 秋夜","徐淑秀","词",["露滴花寒入夜深。","多情明月向愁人。","灯隐隐，漏沉沉。","断续钟声断续砧。"],0,255,"清"],["忆王孙","徐淑秀","词",["重重幽恨锁眉峰。","斜倚阑干思未穷。","徒使心牵问不通。","忆相逢。","在梦中。"],0,255,"清"],["鹧鸪天 夜坐","徐淑秀","词",["宝篆香消觉夜深。","挑灯无语倍伤情。","瑶琴欲抚闲消闷，拨尽朱弦总断魂。","风索莫，月凄清。","无端愁思苦萦心。","徘徊不尽梧桐月，守着窗儿坐到明。"],0,255,"清"],["真珠帘 孤雁","叶慧光","词",["冥冥万里呼群急。","叹浮生、也复漂流南北。","一点落平沙，认往时踪迹。","辗转惊魂犹未定，正雪满、寒滩芦荻。","恻恻。","待写怨留情，不成行墨。","清影独占天涯，傍潇湘苦竹，泪痕凝碧。","天半动哀声，似断弦瑶瑟。","十二楼中明月夜，怅旧侣、那堪思忆。","凄绝。","只孤鹤横江，似曾相识。"],0,31,"清"],["眼儿媚 上冢","叶慧光","词",["半篙春水碧罗纹。","流出杏花村。","行人陌上，纸钱飞蝶，细雨如尘。","归来似醉浑无力，界面尚啼痕。","金炉香冷，纱窗月上，灯火黄昏。"],0,31,"清"],["凄凉犯 木芙蓉","叶慧光","词",["秋江水浅红蕖落，寒英又遍江岸。","画船歌歇，西风渐紧，绮罗重换。","鸳鸯拆散。","但留得、寥天一雁。","带衰杨、萧疏几线，杳杳斜阳晚。","那更新霜溅，渡萧辰、恁般清怨。","溪花落尽，剩娉婷、尚疑人面。","待插银瓶，怕憔悴、愁颜莫展。","更伊谁、无情酒盏向汝劝。"],0,31,"清"],["宣清 秋怀","叶慧光","词",["雨霁新凉，小院垂帘，秋风萧萧恁早。","听哀蝉、尚恋碧阴，又寒蛩、暗泣荒草。","病发凋零，愁容损减，伤人易老。","叹于今、了无多，吟风嘲月怀抱。","便再谱花牒，别翻水调，知音人去杳。","且学坐蒲团，破除烦恼。","洞天白云最好。","一片冰心对莲花，去栽瑶岛。"],0,31,"清"],["长相思 秋夜","张道介","词",["灯影残。","月影残。","烟树微茫夜已阑。","个人犹未闲。","思恹恹。","病恹恹。","一段心情何处牵。","长天秋水边。"],0,247,"清"],["武陵春 春暮","张道介","词",["杨白花飞飞几许，点点落帘钩。","萍踪切莫逐波流。","端为那人愁。","鸠妇呼晴还唤雨，晴雨总无由。","好携樱笋上兰舟。","绿阴天际游。"],0,247,"清"],["浣溪沙 夏闰","张道介","词",["开遍荼縻一院香。","困人天气日初长。","池塘深浅浴鸳鸯。","禊帖午临欹枕倦，玉琴晚奏短襟凉。","登楼惆怅又斜阳。"],0,247,"清"],["满庭芳 题画拳石","张道介","词",["泼墨濡毫，缀成小石，宛然霞浸云烘。","幽窗舒卷，几席列奇峰。","点点莓苔如滴，清闲供、可入诗筒。","消昼永、评花品茗，日日坐春风。","何殊游胜地，连山拱壁，软土推红。","见岚光岫色，倒映帘栊。","休羡南宫怀袖，玲珑样、晴雨空蒙。","珍藏好，莫教轻掷，文锦细加封。"],0,247,"清"],["点绛唇","陈契","词",["春色撩人，闷来闲步苍苔径。","花阴踏尽。","倦向阑干凭。","试看雕梁，紫燕时相并。","教人恨。","飞花成阵。","又惹芳心困。"],0,158,"清"],["菩萨蛮","陈契","词",["兰膏收拾芙蓉匣。","杏腮红雨春纤雪。","羞绾合欢裳。","偎郎抱玉匡。","香微烟穗灭。","漏促琼签彻。","残梦正迷离。","寒鸡背月啼。"],0,158,"清"],["菩萨蛮","陈契","词",["今生浪拟来生约。","从今悔却从前错。","腰带细如丝。","思君知不知。","五更风又雨。","两地侬和汝。","着意待新欢。","莫如侬一般。"],0,158,"清"],["菩萨蛮 山居。回文","陈契","词",["乱流溪树烟横岸。","岸横烟树溪流乱。","桥断接遥峰。","峰遥接断桥。","焙茶山雨细。","细雨山茶焙。","秋到等闲鸥。","鸥闲等到秋。"],0,158,"清"],["浣溪沙","王璐卿","词",["风落残红兰槛多。","墙阴袅娜紫遛过。","牡丹和露湿轻罗。","闲把鸳针穿蝶翅，戏抛绳拂引狸奴。","昼长挨得绣功夫。"],0,229,"清"],["玉蝴蝶 咏梦","王璐卿","词",["怪尔庄生何事，勾人别思，惹我离魂。","十二画栏深处，依旧黄昏。","月溶溶、桃花满地，烟淡淡、柳絮盈身。","正氤氲。","香浮翠幕，雾锁重门。","殷勤。","忽听天际，数声横笛，一曲阳春。","凝望琼楼素娥，如雪乱红云。","似依稀、莺牵绣带，还缥缈、蝶绕罗裙。","羡巫神。","凌波来去，不动芳尘。"],0,229,"清"],["渔歌子","沈士芳","词",["凉气萧萧坐久生。","风吹败叶落闲庭。","窗纸响，砌蛩吟。","残月依依影半明。"],0,133,"清"],["清平乐","沈士芳","词",["柳风梅雪。","绣幕云驱月。","花气扑帘香影折。","睡暖一双蝴蝶。","敛眉独倚金扉。","轻寒吹上铢衣。","满地星红小绿，凤尖怕蹴香泥。"],0,133,"清"],["相思引","沈士芳","词",["绣阁无心理翠𫔇。","臂环轻卸耳珰欹。","鹧鸪香冷，频揭玉狻猊。","雁婿衔霜传锦字，猧儿带月护铜扉。","无多春色，又逐杏花飞。"],0,133,"清"],["相思引","沈士芳","词",["蟾影筛花印翠蚨。","为寻粉蝶上兰陂。","板桥怯渡，笑带柳枝扶。","归路卸头灯背立，回波旖旎态摩挲。","春图半幅，香阁背人摹。"],0,133,"清"],["浣溪沙","许玉晨","词",["翠竹阴深暑未消。","玉荷池畔暗香飘。","半规月影上梧梢。","团扇倩人涂蛱蝶，画叉唤婢卷蟏蛸。","小屏风底换轻绡。"],0,243,"清"],["菩萨蛮","许玉晨","词",["枣花帘外西风紧。","玉凫沉麝馀香烬。","灯影暗银缸。","梧桐叶打窗。","此情谁共省。","泪湿红巾冷。","寒雨又凄凄。","秋虫作伴啼。"],0,243,"清"],["好事近","许玉晨","词",["春水碧漪漪，㶉𫛶下来双浴。","恰被落红惊去。","剩浮萍新绿。","小栏花韵倍嫣然，香睡午晴足。","困倚画屏深处。","又风敲修竹。"],0,243,"清"],["金缕曲","许玉晨","词",["昼永何当遣。","向晴窗、开炉试茗，提壶洗砚。","偏是珍禽檐间语，又唤绣床针线。","谁省识、相思人倦。","幸有墙东樱桃树，破东风、已觉红深浅。","对妆阁，作清伴。","凤城多少香轮碾。","只闲门、一番新雨，绣苔凝遍。","欲倩生花传幽绪，奈被江郎占断，但梦忆、故山清远。","遥盼吴淞春波阔，恨锦鳞、不寄回纹转。","馀芳泪，枕函泫。"],0,243,"清"],["风入松 秋夜","范姝","词",["金风析析绕窗前。","梧叶舞翩跹。","空阶蛩语无休歇，不由人、无限凄然。","天上月明如洗，桂枝影堕疏檐。","砧残漏永如年，宝鼎喷馀烟。","琵琶冷落无心拨，为闲愁、常锁眉尖。","这苦向人难诉，还来题上花笺。"],0,122,"清"],["夏初临 药名闺怨，和周羽步","范姝","词",["竹叶低斟，相思无限，车前细问归期。","织女牵牛，天河水界东西。","比似寄生天上，胜孤身、独活空闺。","人言郎去，合欢不远，半夏当归。","徘徊郁金堂北，玳瑁床西。","香烧龙麝，窗饰文犀。","稿本拈来，缃囊故纸留题。","五味慵调，恹恹病、没药能医。","从容待，乌头变白，枯柳生稊。"],0,122,"清"],["浣溪沙 西施梦武塘梅花和尚墓下有此种","沈栗","词",["一别苏台不计春。","浣沙石上草如茵。","幻生花种也怜人。","梦绕吴宫心独捧，香消南国态谁颦。","小名低唤莫生嗔。"],0,168,"清"],["巫山一段云 梨花","沈栗","词",["腻粉匀梅白，凝脂分杏红。","盈盈神女下巫峰。","院落自溶溶。","淡淡黄昏月，轻轻杨柳风。","一枝带雨逗娇容。","多被晓烟笼。"],0,168,"清"],["踏莎行 玫瑰","沈栗","词",["日暖蜂喧，群芳开足。","药栏烂漫非金谷。","柔条弱刺惹罗衣，摘来蛱蝶犹相逐。","蕊绽骊珠，花凝紫玉。","秦楼初度霓裳曲。","香分太乙殿中烟，相公服色新妆束。"],0,168,"清"],["忆王孙 春花月夜","唐元观","词",["月上妆楼花影偏。","花浓月淡映湘帘。","爱月怜花人未眠。","整花钿。","学拜深深花月前。"],0,175,"清"],["醉公子 题轩外竹","唐元观","词",["庭栽千个绿，好把南华读。","我爱此君幽。","琅玕戛玉钩。","寄情时觅句，枕瑟常眠里。","破壁长孙枝，思君十二时。"],0,175,"清"],["鹧鸪天 和外，咏柳","唐元观","词",["叶叶撩人太瘦生。","枝枝荡漾最轻盈。","长堤驿路随云断，小阁疏帘伴月明。","邀舞燕，住啼莺。","风流张绪是多情。","几回欲寄回文字，万缕千丝织未成。"],0,175,"清"],["临江仙 题山园遥青阁","唐元观","词",["野径苔荒客少到，双扉春昼常关。","朱栏曲曲水流湾。","莺啼修竹里，犬吠白云间。","远翠飞来白似练，望中碧浪青山。","桃花烂漫竹成斑，杖藜沽酒出，麋鹿采芝还。"],0,175,"清"],["生查子 垂柳，呈外","王琛（洛珍","词",["春丝难自持，殷勤动檐马。","檐马未停声，郎马嘶花下。","归鞭笑语迎，共入荼蘼架。","嗔柳太无情，薄幸教伊打。"],0,69,"清"],["卜算子 西园同唐静因夫人咏紫薇","王琛（洛珍","词",["可怜百日花，清露垂垂湿。","络索鲛绡霞帔重，临风人独立。","小榭月朦胧，曲沼波光织。","院落沉沉灯火深，弦繁催管急。"],0,69,"清"],["谒金门 遥青阁春晚","王琛（洛珍","词",["春正好。","桃李满院开了。","草色青青帘逼绕。","落红童未扫。","一望云迷山杳。","嗔杀卷中人老。","燕子双双归恁早。","卷帘月挂小。"],0,69,"清"],["鹧鸪天 题山园，和束佩君","王琛（洛珍","词",["地僻林深人迹稀。","重阴寂寂掩双扉。","竹窗半启炉烟细，残梦初醒酒力微。","云作盖，芰为衣。","山容黯淡水光低。","鸟啼花落消长昼，小立空阶月到西。"],0,69,"清"],["菩萨蛮 杨花","杜漪兰","词",["飞绵糁径无消息。","因风管领东南陌。","小谢正无聊。","漫天作雪飘。","疏帘愁未卷。","浪迹萍踪远。","舞怯舞池塘。","萍浮总渺茫。"],0,83,"清"],["减字木兰花 咏茉莉","杜漪兰","词",["花开长夏。","点点珠凝清泪夜。","玉凤团成。","好待黄昏伴美人。","丰姿素质。","无限芳心堪爱惜。","半吐幽香。","笑插云鬟助晚妆。"],0,83,"清"],["阮郎归 新柳","杜漪兰","词",["条风处处放新枝。","行行春日迟。","闲看芳草影参差。","莺花争艳时。","杨柳岸，画船齐。","相思忆画眉。","那禁对对鸟飞归。","风光只自知。"],0,83,"清"],["南乡子 和陈相国夫人徐湘苹送别","杜漪兰","词",["数载炙清光。","万里家山别路长。","尺素裁书云锦样，流觞。","半是兰亭笔墨香。","彩鹢竖牙樯。","力敌秋风薜荔裳。","寄语瑶池今阿母，情伤。","把酒叮咛看雁行。"],0,83,"清"],["醉太平 偶成","秦昙","词",["寒梅暗香。","良宵漏长。","何妨痛饮千觞，写黄庭数行。","亭前晓霜。","床前月凉。","风敲铁马丁当，最撩人断肠。"],0,120,"清"],["蝶恋花","秦昙","词",["寒食才过春又半。","燕子衔泥，画栋营巢满。","细雨蒙蒙扃小院。","胭脂落尽桃花片。","罗袜倦移情绪懒。","触目凄凉，不觉双蛾敛。","风景依然人事换。","旧游追省空肠断。"],0,120,"清"],["望湘人 健娘","秦昙","词",["爱一星俏眼，半寸纤葱，仙容偏不憔悴。","黏瓣衣香，兜簪肌颤，生日榴红喷砌。","细罥虫丝，怯撩虎口，稳骑鹤背。","似翾风老欠风情，滑簟不容同睡。","照影水心镜底。","露一般颜色，难分姊妹。","向百药炉边，偏上病人云髻。","鸳鸯颈，听嘐嘐语细。","恨不成双，却怪他、健影临风，止度月馀年纪。"],0,120,"清"],["如梦令 鹦鹉","吴瑗（文青","词",["本是乌衣伴侣。","不学文鹥沙渚。","偶尔寄寒庑，消受酸风苦雨。","无语。","无语。","犹自解怜毛羽。"],0,186,"清"],["如梦令","吴瑗（文青","词",["何处仙车缥缈。","枝上莺传花老。","会晤有今朝，莫道相逢迟早。","留笑。","留笑。","误认天台休恼。"],0,186,"清"],["如梦令","吴瑗（文青","词",["不是胭脂窈窕。","莫认花容月貌。","静冷月明中，断绝红尘音耗。","懊恼。","懊恼。","何似鹦哥睡早。"],0,186,"清"],["谢秋娘 秋蛩","蔡翥","词",["秋声惨，最惨络丝娘。","夜夜吟寒头欲白，声声咽月叶初黄。","宁不断人肠。"],0,33,"清"],["如梦令 秋露","蔡翥","词",["晓起画栏濡透。","叶叶枝枝如豆。","风过碧梧摇，滴滴绿珠齐溜。","重九。","重九。","酿与江枫为酒。"],0,33,"清"],["雨中花 出盆兰就雨","蔡翥","词",["曾记去年冬日。","怕煞朔风剪急。","袅袅芳踪，退藏幽密，待取春消息。","愁里光阴容易失。","转眼又过惊蛰。","正微雨蒙蒙，倩人扶出，就沐犹无力。"],0,33,"清"],["行香子 题画美人","蔡翥","词",["谁向冰绡。","淡写轻描。","新妆巧、杨柳纤腰。","云鬟叠叠，绣带飘飘。","又眼儿媚，眉儿秀，脸儿娇。","有个妖娆。","曾得相遭。","细思量、何处逍遥。","料应今夜，月下吹箫。","在梅花溪，桃花岸，杏花桥。"],0,33,"清"],["西地锦","葛嫩","词",["人在重帘深处，日移危坐席间。","一双海燕栖华栋，呢喃春堕花筵。"],0,231,"清"],["西地锦","葛嫩","词",["轻透描鸾绣裤，微挑刺凤金莲。","罗衣试减寒犹在，临轩翠袖低偏。"],0,231,"清"],["清平乐","葛嫩","词",["东风无力。","吹梦无踪迹。","昨日似今今似昔。","不与些儿将息。","断肠人在天涯。","春光不恋儿家。","到底吹完柳絮，偏生留着梨花。"],0,231,"清"],["师师令","葛嫩","词",["懵腾乍起。","正云鬟未理。","手挼裙带倚床阑，但说道、困人天气。","娇眼半开犹似睡。","怕镜奁如水。","玉容懒把桃花𫖃，却自然妖丽。","彩毫约略扫眉峰，春已透、粉香堆里。","一见教郎终日喜。","拚小楼同醉。"],0,231,"清"],["南乡子 秋思","屠茝佩","词",["独上楼西。","绿鬟鸾镜晓妆低。","半暖乍寒花影静，重思省。","听得砧声着意整。"],0,1,"清"],["七娘子 喜晴","屠茝佩","词",["湿云销尽朝阳皎。","庭前绿遍忘忧草。","玫瑰香浓，紫霞凌晓。","重帘不锁炉烟袅。","树头梅子青多少。","熏风吹透荷钱小。","愁在眉山，欣看林表。","芳菲又恐莺啼早。"],0,1,"清"],["小秦王 柳浪闻莺","吴湘（婉罗","词",["香雾蒙蒙不肯收。","丝丝垂柳绾春愁。","玉骢也解游人意，却听莺声便欲留。"],0,203,"清"],["菩萨蛮 回文","吴湘（婉罗","词",["好花闻遍啼莺老。","老莺啼遍闻花好。","香暖透轻■，■轻透暖香。","燕来春■■。","■■春来燕。","流■■■■，■■■■流。"],0,203,"清"],["菩萨蛮 咏菊","吴湘（婉罗","词",["寂寂空庭寒料峭。","黄花开遍秋光老。","朔雁正南飞。","东篱剩数枝。","玉人妆未竟。","漫摘簪云鬓。","菊已瘦霜痕。","人还瘦几分。"],0,203,"清"],["菩萨蛮","吴湘（婉罗","词",["谁家玉笛声呜咽。","小亭夜月增凄切。","月又不分明。","教人怎么听。","更深人已尽。","悄有灯和影。","灯尽欲抛奴。","谁怜影也无。"],0,203,"清"],["阮郎归 湖上送春","孙瑶英","词",["西陵歌舞送春愁。","杨花飞满楼。","杜鹃啼血恨无休。","闺人欲白头。","桥六转，荡轻舟。","湖山非旧游。","乱红摇落淡烟稠，好句锦囊收。"],0,70,"清"],["小重山 秋夜","孙瑶英","词",["独坐闲窗午漏敲。","落花间覆地，语莺娇。","屏山图画自轻描。","风阵阵，蟋蟀响庭寥。","月影上芭蕉。","离怀无可遣，费推敲。","囊琴长挂为谁调。","人瘦也，寂寞是凉宵。"],0,70,"清"],["玉楼春 闺情","孙瑶英","词",["氤氲绿篆浮香鸭。","睡起午窗开镜匣。","纤纤素手整云鬟，银粉淡消红映颊。","双峰锁翠眉愁压。","拈得金针还倒捻。","东风肠断少人知，慵看花间飞蛱蝶。"],0,70,"清"],["满江红 咏雪","孙瑶英","词",["仙女天花，忽散遍、满城春色。","极目处、峰峦银砌，楼台粉饰。","皓鹤乍离珠阙舞，琼枝忽向瑶阶植。","看纷纷，应斗早梅芳，成林白。","沾绣幄，明书室。","严风紧，迟还急。","似澄江铺练，蓝田生璧。","片片飞来疑柳絮，轻轻舞去穿窗隙。","望川原，万顷月华寒，无尘迹。"],0,70,"清"],["望江南 四时词","吴娟","词",["江南好，柳色绿如烟。","处处芳菲都是锦，村村红紫漫争妍。","春暖艳阳天。"],0,247,"清"],["望江南","吴娟","词",["江南好，十里芰荷风。","雪藕冰桃凉彻骨，珠兰茉莉沁酥胸。","竹簟睡朦胧。"],0,247,"清"],["望江南","吴娟","词",["江南好，丛桂小山多。","香气袭人题锦字，清光良夜照银河。","乞巧待如何。"],0,247,"清"],["望江南","吴娟","词",["江南好，酿雪映梳妆。","小阁衣寒煨野栗，重帏被冷𦶟沉香。","兽炭暖牙床。"],0,247,"清"],["画堂春","蓉湖女子","词",["冷莎铺月树穿星。","秋棠褪尽红英。","鹭鸶两两浴兰汀。","湿浪吹萍。","雾气卷开山色，云光流出溪声。","湘帘斜卷绿烟凝，人倚银屏。"],0,140,"清"],["菩萨蛮 仿王修微回文","蓉湖女子","词",["镜开羞学新妆靓。","靓妆新学羞开镜。","离别怕迟归。","归迟怕别离。","绿痕螺黛促。","促黛螺痕绿。","千万约来年。","年来约万千。"],0,140,"清"],["卜算子","蓉湖女子","词",["刬袜坠金菱，髻溜琼妆亸。","为爱鹦哥红豆抛，莫认车边果。","曲槛小屏山，月淡花如雾。","倦倚檀肩数乱星，数到牵牛住。"],0,140,"清"],["少年游","蓉湖女子","词",["斜风卷水，平芜吹侧，波面细于丝。","杨柳烟中，蓼花影里，密树度云迟。","藤床八尺龙须席，卧听晚蟾嘶。","携却楸枰，沉吟应劫，抛局数残棋。"],0,140,"清"],["南歌子 夜坐","尹琼华","词",["清漏莲花静，寒灯荷叶明。","小楼罢绣坐含情。","可笑小鬟偷睡、倚银屏。"],0,217,"清"],["卖花声 送春","庄焘","词",["新绿满汀洲。","月在西楼。","池塘脉脉水东流。","两岸蛙声鸣夕照，春去悠悠。","往事怕回头。","惹起闲愁。","物华如梦杳难留。","雨后飞花风里絮，身世浮沤。"],0,198,"清"],["卜算子","庄焘","词",["积雨喜新晴，小院风初定。","月满芳阶露气浮，花动雕栏影。","宝鼎篆烟微，幽梦残灯省。","忽逐钟声度小桥，不管春衣冷。"],0,198,"清"],["减字木兰花","庄焘","词",["薄寒透帐。","晓雨声声来枕上。","纤草含春。","荒甃颓垣到处生。","落花无语。","飞入池塘和泪去。","杨柳丝柔。","懒尽东风不送愁。"],0,198,"清"]]