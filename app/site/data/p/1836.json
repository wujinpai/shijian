[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["竹枝词 袁宏道评曰：刘荪州无此奥","徐渭","七言律诗",["风前烛焰片时红。","马首西时马尾东。","两只鸳鸯睡不醒，一只相思愁杀侬。","笼中鹞子不得出。","笼外要入将奈何。","一边虫粘蜘蛛网，一边窗打扑灯蛾。"],0,"x269","明"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["题画二首","张宁","七言律诗",["雨晴芳渚野凫飞，杨柳条长荇叶肥。","闲展蓬窗看溪水，春痕渐上钓鱼矶。","雪满孤山雨满楼，青春花鸟淡相留。","年芳似旧故人少，默倚阑干悔昔游。"],0,"x315","明"],null,null,null,null,null,null,null,null,null,null,null,null,["戴文进小景二绝","张宁","七言律诗",["萧萧葭菼著霜稀，秋水连天有雁飞。","怅望溪山旧人去，一船斜日映愁归。","忙处人多静处稀，芦花风急梦将飞。","莫教一枕黄昏雨，直待邯郸觉后归。"],0,"x315","明"]]