[["诗品二十四则 疏野","司空图","四言",["惟性所宅，真取弗羁。","拾物自富，与率为期。","筑屋松下，脱帽看诗。","但知旦暮，不辨何时。","倘然适意，岂必有为。","若其天放，如是得之。"],0,"x26","唐"],["诗品二十四则 典雅","司空图","四言",["玉壶买春，赏雨茆屋。","坐中佳士，左右修竹。","白云初晴，幽鸟相逐。","眠琴绿阴，上有飞瀑。","落花无言，人淡如菊。","书之岁华，其曰可读。"],0,"x26","唐"],["游长宁公主流杯池二十五首 其二十一","上官婉儿","四言",["檀栾竹影，飙𫗇松声。","不烦歌吹，自足娱情。"],0,80,"唐"],["游长宁公主流杯池二十五首 其二十四","上官婉儿","四言",["清波汹涌，碧树冥蒙。","莫怪留步，因攀桂丛。"],0,80,"唐"],["游长宁公主流杯池二十五首 其二十五","上官婉儿","四言",["莫论圆峤，休说方壶。","何如鲁馆，即是仙都。"],0,80,"唐"],["诗品二十四则 雄浑","司空图","四言",["大用外腓，真体内充。","返虚入浑，积健为雄。","具备万物，横绝太空。","荒荒油云，寥寥长风。","超以象外，得其环中。","持之匪强，来之无穷。"],0,"x26","唐"],["峡中旧语（题拟）","佚名","四言",["五月下峡，死而不吊。","（同前卷下）。"],0,"x14","唐"],["诗品二十四则 含蓄","司空图","四言",["不著一字，尽得风流。","语不涉难，已不堪忧。","是有真宰，与之沈浮。","如渌满酒，花时返秋。","悠悠空尘，忽忽海沤。","浅深聚散，万取一收。"],0,"x26","唐"],["郊庙歌辞 享太庙乐章 凯安三首 其二","张说","四言",["礼匝三献，乐遍九成。","降循轩陛，仰欷皇情。","福与仁合，德因孝明。","百年神畏，四海风行。"],0,133,"唐"],["诗品二十四则 流动","司空图","四言",["若纳水𫐑，如转丸珠。","夫岂可道，假体遗愚。","荒荒坤轴，悠悠天枢。","载要其端，载同其符。","超超神明，返返冥无。","来往千载，是之谓乎。"],0,"x26","唐"],["琴曲歌辞 琴歌","顾况","四言",["琴调秋些，胡风遶雪。","峡泉生咽，佳人愁些。"],0,191,"唐"],["诗品二十四则 高古","司空图","四言",["畸人乘真，手把芙蓉。","泛彼浩劫，窅然空纵。","月出东斗，好风相从。","太华夜碧，人闻清钟。","虚伫神素，脱然畦封。","黄唐在独，落落玄宗。"],0,"x26","唐"],["郊庙歌辞 享太庙乐章 凯安三首 其三","张说","四言",["总总干戚，填填鼓钟。","奋扬增气，坐作为容。","离若鸷鸟，合如战龙。","万方观德，肃肃邕邕。"],0,133,"唐"],["诗品二十四则 冲淡","司空图","四言",["素处以默，妙机其微。","饮之太和，独鹤与飞。","犹之惠风，苒苒在衣。","阅音修篁，美曰载归。","遇之匪深，即之愈稀。","脱有形似，握手已违。"],0,"x26","唐"],["诗品二十四则 实境","司空图","四言",["取语甚直，计思匪深。","忽逢幽人，如见道心。","晴涧之曲，碧松之阴。","一客荷樵，一客听琴。","情性所至，妙不自寻。","遇之自天，冷然希音。"],0,"x26","唐"],["琴操十首 其二 猗兰操","韩愈","四言",["兰之猗猗，扬扬其香。","不采而佩，于兰何伤。","今天之旋，其曷为然。","我行四方，以日以年。","雪霜贸贸，荠麦之茂。","子如不伤，我不尔觏。","荠麦之茂，荠麦之有。","君子之伤，君子之守。"],0,"x19","唐"],["诗品二十四则 飘逸","司空图","四言",["落落欲往，矫矫不群。","缑山之鹤，华顶之云。","高人画中，令色𬘡缊。","御风蓬叶，泛彼无垠。","如不可执，如将有闻。","识者已领，期之愈分。"],0,"x26","唐"],["与昂上人两字继合四句初字日","皎然","四言",["有一鸟雏，凌寒独宿。","若逢云雨，两两相逐。"],0,"x22","唐"],["剥啄行","韩愈","四言",["剥剥啄啄，有客至门。","我不出应，客去而嗔。","从者语我，子胡为然。","我不厌客，困于语言。","欲不出纳，以堙其源。","空堂幽幽，有秸有莞。","门以两板，丛书于间。","窅窅深堑，其墉甚完。","彼宁可隳，此不可干。","从者语我，嗟子诚难。","子虽云尔，其口益蕃。","我为子谋，有万其全。","凡今之人，急名与官。","子不引去，与为波澜。","虽不开口，虽不开关。","变化咀嚼，有鬼有神。","今去不勇，其如后艰。","我谢再拜，汝无复云。","往追不及，来不有年。"],0,"x19","唐"],["诗品二十四则 绮丽","司空图","四言",["神存富贵，始轻黄金。","浓尽必枯，浅者屡深。","露馀山青，红杏在林。","月明华屋，画桥碧阴。","金尊酒满，共客弹琴。","取之自足，良殚美襟。"],0,"x26","唐"],["郊庙歌辞 让皇帝庙乐章 送神","李纾","四言",["奠献已事，昏昕载分。","风摇雨散，灵卫𬘡缊。","龙驾帝服，已腾五云。","泮宫复閟，寂寞无闻。"],0,255,"唐"],["郊庙歌辞 五郊乐章 白郊迎神","佚名","四言",["序移玉律，节应金商。","天严杀气，吹警秋方。","槱燎既积，稷奠并芳。","乐以迎奏，庶降神光。"],0,"x14","唐"],["诗品二十四则 劲健","司空图","四言",["行神如空，行气如虹。","巫峡千寻，走云连风。","饮真茹强，蓄素守中。","喻彼行健，是谓存雄。","天地与立，神化攸同。","期之以实，御之以终。"],0,"x26","唐"],["诗品二十四则 缜密","司空图","四言",["是有真迹，如不可知。","意象欲生，造化已奇。","水流花开，清露未晞。","要路愈远，幽行为迟。","语不欲犯，思不欲痴。","犹春于绿，明月雪时。"],0,"x26","唐"],["郊庙歌辞 让皇帝庙乐章 迎神","李纾","四言",["皇矣天宗，德先王季。","因心则友，克让以位。","爰命有司，式尊前志。","神其降灵，昭飨祀事。"],0,255,"唐"],["郊庙歌辞 祭汾阴乐章 舒和","何鸾","四言",["乐奏云阕，礼章载虔。","禋宗于地，昭假于天。","惟馨荐矣，既醉歆焉。","神之降福，永永万年。"],0,65,"唐"],["郊庙歌辞 禅社首乐章 其二 太和","贺知章","四言",["肃我成命，于昭黄衹。","裘冕而祀，陟降在斯。","五音克备，八变聿施。","缉熙肆靖，厥心匪离。"],0,210,"唐"],["郊庙歌辞 五郊乐章 青郊迎神","佚名","四言",["缇幕移候，青郊启蛰。","淑景迟迟，和风习习。","璧玉宵备，旌旄曙立。","张乐以迎，帝神其入。"],0,"x14","唐"],["诗品二十四则 洗炼","司空图","四言",["犹矿出金，如铅出银。","超心炼冶，绝爱缁磷。","空潭泻春，古镜照神。","体素储洁，乘月返真。","载瞻星辰，载歌幽人。","流水今日，明月前身。"],0,"x26","唐"],["郊庙歌辞 五郊乐章 白帝商音","魏征","四言",["白藏应节，天高气清。","岁功既阜，庶类收成。","万方静谧，九土和平。","馨香是荐，受祚聪明。"],0,152,"唐"],["郊庙歌辞 五郊乐章 赤郊迎神","佚名","四言",["青阳节谢，朱明候改。","靡草雕华，含桃流彩。","虡列钟磬，筵陈脯醢。","乐以迎神，神其如在。"],0,"x14","唐"],["奉和圣制烛龙斋祭","张九龄","四言",["上帝临下，鉴亦有光。","孰云阴骘，惟圣克彰。","六月徂暑，四郊愆阳。","我后其勤，告于坛场。","精意允溢，群灵鼓舞。","蔚兮朝云，沛然时雨。","雨我原田，亦既有年。","烛龙煌煌，明宗报祀。","于以助之，天人帝子。","闻诗有训，国风兹始。"],0,188,"唐"],["郊庙歌辞 五郊乐章 黄郊迎神","佚名","四言",["朱明季序，黄郊王辰。","厚以载物，甘以养人。","毓金为体，禀火成身。","宫音式奏，奏以迎神。"],0,"x14","唐"],["诗品二十四则 旷达","司空图","四言",["生者百岁，相去几何。","欢乐苦短，忧愁实多。","何如尊酒，日往烟萝。","花覆茆檐，疏雨相过。","倒酒既尽，杖藜行过。","孰不有古，南山峨峨。"],0,"x26","唐"],["郊庙歌辞 五郊乐章 赤帝徵音","魏征","四言",["青阳告谢，朱明戒序。","延长是祈，敬陈椒醑。","博硕斯荐，笙镛备举。","庶尽肃恭，非馨稷黍。"],0,152,"唐"],["郊庙歌辞 五郊乐章 黑郊迎神","佚名","四言",["玄英戒序，黑郊临候。","掌礼陈彝，司筵执豆。","寒氛敛色，沍泉凝漏。","乐以迎神，八音斯奏。"],0,"x14","唐"],["诗品二十四则 清奇","司空图","四言",["娟娟群松，下有漪流。","晴雪满汀，隔溪渔舟。","可人如玉，步屧寻幽。","载行载止，空碧悠悠。","神出古异，淡不可收。","如月之曙，如气之秋。"],0,"x26","唐"],["郊庙歌辞 让皇帝庙乐章 迎俎","李纾","四言",["祀盛体荐，礼协粢盛。","方周假庙，用鲁纯牲。","捧撤祗敬，击拊和鸣。","受厘归胙，既戒而平。"],0,255,"唐"],["郊庙歌辞 禅社首乐章 其七 太和","贺知章","四言",["昭昭有唐，天俾万国。","列祖应命，四宗顺则。","申锡无疆，宗我同德。","曾孙继绪，享神配极。"],0,210,"唐"],["郊庙歌辞 让皇帝庙乐章 奠币","李纾","四言",["惟帝时若，去而上仙。","祀用商武，乐备宫悬。","白壁加荐，玄𫄸告虔。","子孙拜后，承兹吉蠲。"],0,255,"唐"],["郊庙歌辞 五郊乐章 送神","佚名","四言",["春末冬暮，徂夏杪秋。","土王四月，时季一周。","黍稷已享，笾豆宜收。","送神有乐，神其赐休。"],0,"x14","唐"],["郊庙歌辞 五郊乐章 送神","佚名","四言",["文物流彩，声明动色。","人竭其恭，灵昭其饬。","歆荐不已，垂祯无极。","送礼有章，惟神还轼。"],0,"x14","唐"],["郊庙歌辞 五郊乐章 送神","佚名","四言",["炎精式降，苍生攸仰。","羞列豆笾，酒陈牺象。","昭祀有应，冥期不爽。","送乐张音，惟灵之往。"],0,"x14","唐"],["郊庙歌辞 五郊乐章 送神","佚名","四言",["祀遵五礼，时属三秋。","人怀肃敬，灵降祯休。","奠歆旨酒，荐享珍羞。","载张送乐，神其上游。"],0,"x14","唐"],["郊庙歌辞 五郊乐章 送神","佚名","四言",["北郊时冽，南陆辉处。","奠本虔诚，献弥恭虑。","上延祉福，下承欢豫。","广乐送神，神其整驭。"],0,"x14","唐"],["郊庙歌辞 五郊乐章 青帝角音","魏征","四言",["鹤云旦起，鸟星昏集。","律候新风，阳开初蛰。","至德可飨，行潦斯挹。","锡以无疆，蒸人乃粒。"],0,152,"唐"],null,["郊庙歌辞 德明兴圣庙乐章 登歌奠币","李纾","四言",["四时有典，百事来祭。","尊祖奉宗，严禋大帝。","礼先苍璧，奠备黝制。","于万斯年，熙成帝系。"],0,255,"唐"],null,null,["琴操十首 其七 履霜操","韩愈","四言",["父兮儿寒，母兮儿饥。","儿罪当笞，逐儿何为？","儿在中野，以宿以处。","四无人声，谁与儿语。","儿寒何衣，儿饥何食。","儿行于野，履霜以足。","母生众儿，有母怜之。","独无母怜，儿宁不悲。"],0,"x19","唐"],["唐大飨拜洛乐章 昭和","武则天","四言",["九玄眷命，三圣基隆。","奉成先旨，明台毕功。","宗祀展敬，冀表深衷。","永昌帝业，式播淳风。"],0,96,"唐"],["唐大飨拜洛乐章 昭和","武则天","四言",["舒云致养，合大资生。","德以恒固，功由永贞。","升歌荐序，垂币翘诚。","虹开玉照，凤引金声。"],0,96,"唐"],["郊庙歌辞 汉宗庙乐舞辞 武德舞","张昭","四言",["明明我祖，天集休明。","神母夜哭，彤云昼兴。","笾豆有践，管籥斯登。","孝孙致告，神其降灵。"],0,230,"唐"],null,["还丹歌","岑真人","四言",["东方青龙，丙丁甲乙。","西方白虎，壬癸凝液。","二气舍真，世人难觅。","机持此宝，一水一石。","灰池焰烁，名除死籍。"],0,22,"唐"],["酬诸公见过","王维","四言",["嗟予未丧，哀此孤生。","屏居蓝田，薄地躬耕。","岁[晏]输税，以奉粢盛。","晨往东臯，草露未晞。","暮看烟火，负担来归。","我闻有客，足埽荆扉。","箪食伊何，疈瓜抓枣。","仰厕群贤，皤然一老。","媿无莞簟，班荆席藁。","泛泛登陂，折彼荷花。","静观素鲔，俯映白沙。","山鸟群飞，日隐轻霞。","登车上马，倏忽云散。","雀噪荒村，鸡鸣空馆。","还复幽独，重欷累叹。"],0,"x1","唐"],["有竹一篇七章 其六","萧颖士","四言",["彼纷者务，体其豫矣。","有旨者酒，欢其且矣。","友僚萃止，跗蕚载韡。"],0,199,"唐"],null,["有竹一篇七章 其三","萧颖士","四言",["彼蔚者竹，萧其森矣。","有开者合，宛其深矣。","回簷幽砌，如翼如齿。"],0,199,"唐"],["郊庙歌辞 蜡百神乐章 迎神","佚名","四言",["八蜡开祭，万物合祀。","上极天维，下穷坤纪。","鼎俎流芬，罇彝荐美。","有灵有祇，咸希来止。"],0,"x14","唐"],["郊庙歌辞 武后享清庙乐章十首 第二","佚名","四言",["隆周创业，宝命惟新。","敬宗茂典，爰表虔禋。","声明已备，文物斯陈。","肃容如在，恳志方申。"],0,"x14","唐"],["郊庙歌辞 朝日乐章 肃和","佚名","四言",["惟圣格天，惟明飨日。","帝郊肆类，王宫戒吉。","珪奠春舒，钟歌晓溢。","礼云克备，斯文有秩。"],0,"x14","唐"],["猛虎行","李贺","四言",["长戈莫舂，长弩莫抨。","乳孙哺子，教得生狞。","举头为城，掉尾为旌。","东海黄公，愁见夜行。","道逢驺虞，牛哀不平。","何用尺刀，壁上雷鸣。","泰山之下，妇人哭声。","官家有程，吏不敢听。"],0,118,"唐"],["诗品二十四则 悲慨","司空图","四言",["大风卷水，林木为摧。","意苦若死，招憩不来。","百岁如流，富贵冷灰。","大道日往，若为雄才。","壮士拂剑，浩然弥哀。","萧萧落叶，漏雨苍苔。"],0,"x26","唐"],["郊庙歌辞 周宗庙乐舞辞 肃顺","佚名","四言",["我后至孝，祗谒祖先。","仰瞻庙貌，夙设宫悬。","朱弦疏越，羽舞回旋。","神其来格，明祀惟虔。"],0,"x14","唐"],["郊庙歌辞 禅社首乐章 其四 雍和","贺知章","四言",["夙夜宥密，不敢宁宴。","五齐既陈，八音在县。","粢盛以絜，房俎斯荐。","惟德惟馨，尚兹克徧。"],0,210,"唐"],["郊庙歌辞 享章怀太子庙乐章 迎神","佚名","四言",["副君昭象，道应黄离。","铜楼备德，玉裕成规。","仙气霭霭，灵从师师。","前驱戾止，控鹤来仪。"],0,"x14","唐"],["郊庙歌辞 太清宫乐章 香初上","佚名","四言",["肃肃我祖，緜緜道宗。","至感潜达，灵心暗通。","云𫐌御气，芝盖随风。","四时禋祀，万国来同。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 钧天[舞]","佚名","四言",["承天抚箓，纂圣登皇。","遐清万宇，仰协三光。","功成日用，道济时康。","璇图载永，宝历斯昌。","日月扬晖，烟云烂色。","河岳修贡，神祇効职。","舜风攸偃，尧曦先就。","睿感通寰，孝思浃宙。","奉扬先德，虔遵曩狩。","展义天扄，飞英云岫。","化逸王表，神凝帝先。","乘云厌俗，驭日登玄。"],0,"x14","唐"],null,["奉和圣制喜雨","张九龄","四言",["艰我稼穑，载育载亭。","随物应之，曷圣与灵。","谓我何凭，惟德之馨。","谁云天远，以诚必至。","太清无云，羲和顿辔。","于斯烝人，瞻彼非觊。","阴冥倏忽，沛泽咸洎。","何以致之，我后之感。","无皋无隰，黍稷黯黯。","无卉无木，敷芬黮黤。","黄龙勿来，鸣鸟不思。","人和年丰，皇心则怡。","岂与周宣，云汉徒诗。"],0,188,"唐"],["郊庙歌辞 周郊祀乐章 昭顺乐","佚名","四言",["五兵勿用，万国咸安。","告功圆盖，受命云坛。","乐鸣凤律，礼备鸡竿。","神光欲降，众目遐观。"],0,"x14","唐"],["郊庙歌辞 周郊祀乐章 昭顺乐","佚名","四言",["云门孤竹，苍璧黄琮。","既祀天地，克配祖宗。","虔修盛礼，仰荅玄功。","神归碧落，福降无穷。"],0,"x14","唐"],["郊庙歌辞 隐太子庙乐章 迎神","佚名","四言",["苍震有位，黄离蔽明。","江充祸结，戾据灾成。","衔冤昔痛，赠典今荣。","享灵有秩，奉乐以迎。"],0,"x14","唐"],["郊庙歌辞 享懿德太子庙乐章 迎神","佚名","四言",["甲观昭祥，画堂升位。","礼绝群后，望尊储贰。","启诵慙德，庄丕掩粹。","伊浦凤翔，缑峰鹤至。"],0,"x14","唐"],["郊庙歌辞 武后明堂乐章 迎送王公","武则天","四言",["千官肃事，万国朝宗。","载延百辟，爰集三宫。","君臣德合，鱼水斯同。","睿图方永，周历长隆。"],0,96,"唐"],["郊庙歌辞 太清宫乐章 登歌","佚名","四言",["严禋展事，理洁烝尝。","皇矣圣祖，德惟馨香。","盛荐既撤，工歌载扬。","大来之庆，降福穰穰。"],0,"x14","唐"],["郊庙歌辞 太清宫乐章 再上","佚名","四言",["仙宗绩道，我李承天。","庆深虚极，符光象先。","俗登仁寿，化阐蟺涓。","五千贻范，亿万斯年。"],0,"x14","唐"],["蠹","齐己","四言",["蠹不自蠹，而蠹于木。","蠹极木心，以丰尔腹。","偶或成之，胡为勗人。","人而不真，繇尔乱神。","蠹兮蠹兮，何全其生。","无托尔形，霜松雪柽。"],0,"x29","唐"],["郊庙歌辞 享隐太子庙乐章 肃和","佚名","四言",["岁肇春宗，干开震长。","瑶山既寂，戾园斯享。","玉肃其事，物昭其象。","弦诵成风，笙歌合响。"],0,"x14","唐"],["二风诗   一","元结","四言",["至哉勤绩，不盈不延。","谁能颂之，我请颂焉。","於戏劳王，勤亦何极。","济尔九土，山川沟洫。"],0,63,"唐"],["二风诗   一","元结","四言",["嘻乎王家，曾有凶王。","中世失国，岂非骄荒。","复复之难，令则可忘。"],0,63,"唐"],["郊庙歌辞 享惠昭太子庙乐章 送神","王涯","四言",["威仪毕陈，备乐将阕。","苞茅酒缩，膋萧香彻。","宫臣展事，肃雍在列。","迎精送往，厥鉴昭晰。"],0,240,"唐"],["郊庙歌辞 享章怀太子庙乐章 迎俎酌献","佚名","四言",["通三锡胤，明两承英。","太山比赫，伊水闻笙。","宗祧是寄，礼乐其亨。","嘉辰荐俎，以发声明。"],0,"x14","唐"],["郊庙歌辞 祭神州乐章 迎神","佚名","四言",["黄舆厚载，赤寰归德。","含育九区，保安万国。","诚敬无怠，禋祀有则。","乐以迎神，其仪不忒。"],0,"x14","唐"],["郊庙歌辞 周郊祀乐章 福顺乐","佚名","四言",["相承五运，取法三才。","大礼爰展，率土咸来。","卿云秘室，甘泉宝台。","象樽初酌，受福不回。"],0,"x14","唐"],["郊庙歌辞 周郊祀乐章 福顺乐","佚名","四言",["昊天成命，邦国盛仪。","多士齐列，六龙载驰。","坛升泰一，乐奏咸池。","高明祚德，永致昌期。"],0,"x14","唐"],["二风诗   三","元结","四言",["至哉茂功，不升不圯。","谁能颂之，我请颂矣。","於戏劳王，功亦何大。","去尔兆庶，洪湮灾害。"],0,63,"唐"],["郊庙歌辞 梁太庙乐舞辞 登歌","佚名","四言",["于赫我皇，建中立极。","动以武功，静以文德。","昭事上帝，欢心万国。","大报严禋，四海述职。"],0,"x14","唐"],["诗品二十四则 沈著","司空图","四言",["绿杉野屋，落日气清。","脱巾独步，时闻鸟声。","鸿雁不来，之子远行。","所思不远，若为平生。","海风碧云，夜渚月明。","如有佳语，大河前横。"],0,"x26","唐"],["蟋蟀诗","罗隐","四言",["顽飔毙芳，吹愁夕长。","屑戍有动，歌离吊梦。","如诉如言，绪引虚宽。","周隙伺榻，繁咽夤缘。","范睡蝉老，冠峨緌好。","不冠不緌，尔奚以悲。","蚊蚋有毒，食人肌肉。","苍蝇多端，黑白偷安。","尔也出处，物兮莫累。","坏舍啼衰，虚堂泣曙。","勿徇諠哗，鼠岂无牙。","勿学萋菲，垣亦有耳。","危条槁飞，抽恨咿咿。","别帐缸冷，柔魂不定。","美人在何，夜影流波。","与子伫立，裴回思多。"],0,"x17","唐"],["郊庙歌辞 梁太庙乐舞辞 皇帝行","佚名","四言",["莫高者天，攀跻弗克。","𬯀天有方，累仁积德。","祖宗隆之，子孙履之。","配天明祀，永永孝思。"],0,"x14","唐"],["郊庙歌辞 五郊乐章 黑帝羽音","魏征","四言",["严冬季月，星回风厉。","享祀报功，方祚来岁。"],0,152,"唐"],["郊庙歌辞 享太庙乐章 福和","张说","四言",["备礼用乐，崇亲致尊。","诚通慈降，敬彻爱存。","献怀称寿，啐感承恩。","皇帝孝德，子孙千亿。","大包天域，长亘不极。"],0,133,"唐"],["郊庙歌辞 隐太子庙乐章 送神","佚名","四言",["皇情悼往，祀议增设。","钟鼓铿锵，羽旄昭晰。","掌礼云备，司筵告彻。","乐以送神，灵其鉴阕。"],0,"x14","唐"],["郊庙歌辞 武后享清庙乐章十首 第九彻俎","佚名","四言",["登歌已阕，献礼方周。","钦承景福，肃奉鸿休。"],0,"x14","唐"],["郊庙歌辞 武后明堂乐章 登歌","武则天","四言",["礼崇宗祀，志表严禋。","笙镛合奏，文物维新。","敬遵茂典，敢择良辰。","絜诚斯著，奠谒方申。"],0,96,"唐"],null,["郊庙歌辞 祀九宫贵神乐章 豫和 二","佚名","四言",["黑帝旋驭，青躔导日。","金箓上玄，玉堂初吉。","钩陈夕次，銮和先跸。","蔼蔼群灵，昭昭咸秩。"],0,"x14","唐"]]