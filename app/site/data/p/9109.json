[null,null,["题西庵所藏佛牙","耶律铸","七言律诗",["旃檀奁里贮灵牙，来自中天尊者家。","莹色冷侵秋夜月，真光明射晚晴霞。","本同舍利原无别，疑是金刚事有差。","犹忆广长舌左右，嚼咀风雨震雷车。"],0,"x245","元"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["画  太白诗意","凌云翰","七言律诗",["君去还当我醉时，东坡解道谪仙诗。","百年粉素消磨尽，犹有山花一两枝。","谁写江村枫树林，草堂如有客相寻。","野船怪得轻如叶，秋水今朝五尺深。"],0,"x246","元"],null,null,null,["二仙像 铁拐","凌云翰","七言律诗",["一拐随身四海闻，剑锋久暗七星文。","等闲磨砺光芒出，划断青天万里云。","似醉如痴不顾身，谁知一一露天真。","露台便是中秋月，养就蟾蜍白胜银。"],0,"x246","元"]]