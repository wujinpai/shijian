[["偈颂九十三首 其五十二","释梵琮","四言",["方丈门中，了无罅缝。","维摩文殊，相逢鼓笼。","昨夜三更，打失鼻孔。","普请诸人，各摸索著。"],0,100,"宋"],["四偈 无求行","惠洪","四言",["形恃美好，今已毁坏。","置之世路，自觉塞碍。","始缘饥寒，致万憎爱。","欲坏身衰，入此三昧。"],0,"x42","宋"],["偈颂十七首 其八","释师范","四言",["面门一思，长时无间。","见成句子，百味完全。"],0,"x155","宋"],["偈颂一百三十三首 其三十一","释居简","四言",["才生便刬，不得一半。","失之东隅，桑榆已晚。"],0,"x94","宋"],["祫礼颂圣德诗","梅尧臣","四言",["溥哉孝享，将事于宁。","文武卿士，冠剑在庭。","爰俟帝斋，风霰其零。","风霰不已，钩陈豹尾。","龙旗太常，立列比比。","帝居路寝，百辟就次。","至于谷旦，漫漫翳翳。","帝入灵宫，左撞黄钟。","升阶置玉，日气曈鸿。","鸿鸿杲杲，氛驳阴扫。","宿于太宫，月星皓皓。","侍祠之臣，鹄举鹭振。","或捧其匜，或进其巾。","辅相夹导，俯偻鳞鳞。","圭瓒以陈，登歌以均。","东向虚位，发爵亲亲。","平明帝还，紫宸序班。","望帝之颜，穆穆闲闲。","檐步廊廊，雪浮阳光。","大楹烂烂，朱陛煌煌。","称祝万寿，万寿无疆。","却登宝舆，以御端门。","揭鸡肆赦，雷动乾坤。","于时都人，于时妇女。","于时蛮夷，异口同语。","天子万年，仁圣之主。","臣时执册，与物咸睹。","敢播于诗，庶闻九土。"],0,"x65","宋"],["送赵漕称","徐积","四言",["人之古貌，心未必醇。","心醇貌古，或非通人。","我视赵公，其貌甚古。","心德俱醇，通达明悟。","我曹山野，岂足尽知。","但据所见，以类可推。","大河之说，何其通达。","精简平允，明辨昭皙。","盖其心得，身至自阅。","坐而可言，起而可设。","又云九河，勿守故迹。","但求禹意，然后为得。","此说尤奇，汉儒不及。","我自黑头，尽心河渠。","逢人辄问，三十年馀。","得公此说，庶几成书。","既讲大河，遂及赈饥。","如此方略，所系甚大。","乡官胥徒，实为巨害。","使领虽贤，吏不可乏。","必得官吏，斯为善法。","可为利泽，可制奸猾。","如其备预，莫若义仓。","勿取军民，勿法隋唐。","裒多益寡，斯谋乃臧。","损上益下，民悦无疆。","可自王公，下至选人。","每月之俸，百取一分。","凡千钱者，其出钱十。","斛取一升，缣取一疋。","各从本所，贮其本色。","主者不劳，但视其籍。","不移一符，不烦一力。","月知所增，岁知所积。","出者不劳，如无所出。","其所损者，毫毛涓滴。","一仓之内，诸所畜聚，尽是官俸。","凡皆为民，不得移用。","即移用者，法不可纵。","不以去官，不以赦原。","设法如此，其谁敢干。","古人所贵，讲辨之学。","应而弗精，询谋诹度。","惟是陋生，不足待问。","问而不应，应而不精。","君子不为，非人之情。","惟是弗精，面目腼然。","在乎复教，庶无后愆。"],0,"x123","宋"],["五祖演和尚赞","释清远","四言",["遇冤则亲，传虚果当。","刚硬齿牙，生铁肠脏。","风清淮楚，道实宗匠。","不有智悲，子孙安向。"],0,116,"宋"],["大达国师无业公画像赞","惠洪","四言",["以如是观，觉知见闻。","性等太虚，卓然而存。","示其身世，如空忽云。","应缘上洛，寄名李氏。","在龆龀中，俨大乘器。","坐必跏趺，行必直视。","十二落发，二十受具。","能于诸佛，放身命处。","解衣盘礴，从容笑语。","江西指佛，即心最的。","初亦不然，回首乃识。","如眼照物，了证无惑。","燕坐并汾，声动天壤。","有所问诘，戒莫妄想。","两朝致敬，累召不往。","终不得已，别道以行。","盖视死生，洞若户庭。","出入去来，物莫能撄。","众生拘囚，如蝇唾污。","公如香象，卓立回顾。","摆坏缰锁，自在而去。","公之所养，一至于兹。","人英僧杰，龙章凤姿。","谥曰大达，宪穆之师。"],0,"x42","宋"],["偈颂八十七首 其三十九","释慧开","四言",["烈焰亘天，洪涛辊底。","眨上眉毛，剑去久矣。"],0,65,"宋"],["怀古愚兄 其三","丘葵","四言",["有荷荐香，有竹荐凉。","归哉归哉，一觥对床。"],0,190,"宋"],["善恶吟 其二","邵雍","四言",["尧舜无子，瞽鲧有嗣。","福善祸淫，何故如此。"],0,"x57","宋"],["和仲长统诗二首 其二","郭印","四言",["致虚守静，其术至寡。","有相皆虚，无物不可。","包藏寥廓，该摄细琐。","出入隐显，妙用由我。","九天匪高，九地匪下。","驾鹤周游，鱼鱼雅雅。","焚荡三彭，性空真火。","大道甚夷，学孝僻左。","发车推辕，舍舟摇柂。","五金八石，残生炉冶。"],0,"x79","宋"],["和仲长统诗二首 其一","郭印","四言",["造化一机，乾坤一壳。","死生虫臂，胜负蜗角。","达人于道，混混殊俗。","瞽非丧明，刖非卞足。","贼生户牖，祸征帷幄。","聚蚁贪膻，飞蛾赴烛。","弹雀以珠，抵鹊以玉。","丧精失灵，皆由多欲。","命也天齐，愚夫自促。"],0,"x79","宋"],["偈颂五首 其四","释文礼","四言",["七尺单前，一蒲团地。","横亘十方，竖穷三际。"],0,108,"宋"],["噫田操四章章六句寄呈王介甫 其四","王令","四言",["谁能采芹，不适有获。","果蓏树之，则食其实。","岂弟君子，孔敬且力。"],0,"x68","宋"],["偈二十七首 其十三","释绍隆","四言",["光非照境，境亦非存。","光境俱忘，复是何物。","百草头上，罢却干戈。"],0,252,"宋"],["高宗郊祀前朝享太庙三十首 其二十八 送神用《兴安》。","郊庙朝会歌辞","四言",["神之来游，风马云车。","淹留彷佛，顾瞻欷歔。","神之还归，钧天帝居。","监观于下，何福不除。"],0,"x207","宋"],["景祐祀感生帝二首 其一 宣祖配位奠币用《皇安》。","郊庙朝会歌辞","四言",["浚发长源，粤惟始祖。","五运协图，万灵来护。"],0,"x207","宋"],["吕居仁瞻仰收召二帖赞","岳珂","四言",["吕氏一门，我朝韦平。","衣冠既南，孰为典型。","猗欤北扉，翰墨腾英。","难进之风，蔼于心声。","其进维何，风雷隐砰。","贱霸尊王，万古作程。","天将开之，以豁聩盲。","孰遏其萌，维盗实憎。","观公初心，何止惩羹。","亲朋斯升，方喜汇征。","私书之诒，犹欲却行。","岂愿空言，与乳臭争。","道之将宏，非人所能。","俯首事雠，众方若酲。","讵知祸胎，自汉公卿。","沦胥一谈，大吕为轻。","纶音一颁，四海竦聆。","臧宫鸣剑，贾谊请缨。","书下奉天，已识中兴。","曲笔谁欤，反肆讥评。","阴险何知，云收雾明。","公帖初获，我心未宁。","谓彼噂沓，臆度以情。","是或鼠腐，犹疑鸿冥。","既见公书，恳恳至诚。","视彼傥来，虽宠若惊。","肯以王言，屈于奸朋。","公义既昭，公论既明。","迨今百年，犹歉混并。","时欤数欤，迄莫我听。","公帖云烟，公心日星。","彼犬之狺，何吠非形。","天澄气清，修竹兰亭。","阅此帖焉，对于汗青。"],0,"x202","宋"],["常祀皇地祇五首 其一 迎神用《宁安》。八变。","郊庙朝会歌辞","四言",["坤元之德，光大无疆。","一气交感，百物阜昌。","吉蠲致享，精明是将。","介兹景福，鼎祚灵长。"],0,"x207","宋"],["庆元二年皇后册宝十三首 其三","郊庙朝会歌辞","四言",["金晶丽辉，璧叶含春。","赞夏之翼，绎虞之嫔。","乐序韶亮，礼文藻新。","辟公相成，物采彬彬。"],0,"x207","宋"],["偈颂一百二十三首 其三十六","释崇岳","四言",["衲僧一拶，钵盂口阔。","天下杨岐，望林止渴。"],0,222,"宋"],["颂古四十八首 其三十五","释慧开","四言",["云月是同，溪山各异。","万福万福，是一是二。"],0,65,"宋"],["朱文公储议帖赞","岳珂","四言",["道统之传，洙泗濂伊。","公于淳熙，万古一时。","言名之舆，世泯其辙。","皎皎纲常，首载先烈。","粤古大臣，以国为身。","浚源培根，兹为爱君。","总干徂征，拜疏辄发。","外宁内忧，间不容发。","复雠大义，不振不随。","易安于危，本则先之。","先王之忠，与莱公对。","谗夫孔多，百钦若辈。","彼姑息者，大义一毛。","谓我徒劳，群吠以嘈。","事是迹讹。"],0,"x202","宋"],["畴依  其一","王柏","四言",["元会开物，风气浑庞。","聿生神圣，惟包羲皇。","始画八卦，人文炳煌。","大道之书，谁云已亡。"],0,"x137","宋"],["建隆干德朝会乐章二十八首 皇帝升座用《隆安》。","郊庙朝会歌辞","四言",["天临有赫，上法乾元。","铿锵六乐，俨恪千官。","皇仪允肃，玉坐居尊。","文明在御，礼备诚存。"],0,"x207","宋"],["观音真赞 其二","释慧空","四言",["静处藏身，动中跳出。","全起灭心，为自在力。","耳闻不知，眼见不识。","天下人称，圆通第一。"],0,"x118","宋"],["明教禅师五种不坏赞 其五","释居简","四言",["的的紫槵，茸茸素丝。","自幼至老，念兹在兹。","譬夫一龛，绕以十镜。","此灯长明，一印印定。","定则离念，反而自求。","于无求中，以敏厥修。","物初有终，法无有尽。","是故此珠，横绝煨烬。"],0,"x94","宋"],["渊禅人求赞","释清远","四言",["似余似余，类我类我。","我复谓谁，如火与火。","描邈不就，迎随不果。","写出龙门，衲僧灾祸。"],0,116,"宋"],["见义吟","邵雍","四言",["见善必为，不见则已。","量力而动，力尽而止。"],0,"x57","宋"],["景祐飨先农五首 其三 奠币用《明安》。","郊庙朝会歌辞","四言",["农为政本，食乃民天。","苾芬明祀，蔗蓘良田。","陈兹量币，望彼丰年。","茂介福祉，来钦吉蠲。"],0,"x207","宋"],["绍兴祀祚德庙八首 亚、终献用《正安》。","郊庙朝会歌辞","四言",["𣅺𣅺灵宇，神安且翔。","三哲鼎峙，中荐嘉觞。","凛若义气，千载弥光。","猗其祐之，锡羡无疆。"],0,"x207","宋"],["标指六偈 水月","释清远","四言",["水月指陈，最疏最亲。","若谓可见，还带重轮。","月皎于上，水流于下。","彼此非干，应缘何假。","声回响转，垛成招箭。","指喻孰明，标门谁辨。","凡夫见闻，月皎水浑。","心波业识，奔流苦门。","二乘闻见，如镜中面。","对像迷真，渠还未荐。","水澄月映，孤光迥迥。","灭此化城，更须前进。","一月耀天，光吞大千。","森罗顿现，亘尔无边。","齐含宝月，交光廓彻。","非中非外，一多融摄。","毗卢性海，自他无碍。","迷悟悟迷，相亡相在。","一尘百亿，百亿一尘。","奔走尘刹，不动本身。","光亡月落，几人摸索。","四十九年，浑用不著。","丈夫壮志，自有行市。","十字路头，看人失利。","不忻诸圣，不厌凡夫。","拈箕奉帚，跨马骑驴。","若人笑我，我亦笑渠。","更问如何，我不识书。"],0,116,"宋"],["种药苗二首 种甖粟 其二","苏辙","四言",["甖小如甖，粟细如粟。","与麦皆种，与穄皆熟。","苗堪春菜，实比秋谷。","研作牛乳，烹为佛粥。"],0,"x135","宋"],["十月 其三","叶巽斋","四言",["维此十月，可爱其日。","光华朝升，融温晏布。","熙熙小春，物态和豫。","清明在中，靡翳靡雾。","我公之政，莫不休燠。","衣服其和，悦我黎庶。"],0,180,"宋"],["文宣王及其弟子赞 其四十八","赵构","四言",["开国乘氏，有德斯彰。","参稽百行，赞理三纲。","自拔行闲，荣名甚光。","在史蔼蔼，历久弥芳。"],0,249,"宋"],["干兴御楼二首 其二 降坐用《隆安》。","郊庙朝会歌辞","四言",["皇衢赫敞，黼坐穹崇。","华缨在列，严令发中。","王制钜丽，宝瑞丰融。","均禧绵宇，万寿无穷。"],0,"x207","宋"],["绍兴亲享明堂二十六首 其二 升堂用《仪安》。","郊庙朝会歌辞","四言",["于赫明堂，肇称禋祀。","祖宗来游，亦侑于帝。","九州骏奔，百辟咸事。","敛时纯休，锡我万世。"],0,"x207","宋"],["十月 其四","叶巽斋","四言",["维此十月，新霜始降。","寒不折胶，冻不凝冱。","凛然严师，少而慈父。","戒示坚冰，衣裘蚤具。","我公之威，伊教匪怒。","不竞不絿，无怨无恶。"],0,180,"宋"],["建隆以来祀享太庙十六首 其十六 彻豆用《丰安》。","郊庙朝会歌辞","四言",["肥腯之牲，既析既荐。","郁鬯之酒，已酌已献。","祝辞亦陈，和奏斯遍。","享礼具举，彻其有践。"],0,"x207","宋"],["嘉禾颂七章章四句  其一","吴泳","四言",["翼翼嘉禾，在梁之亩。","九穗离离，实栗实秀。"],0,222,"宋"],["高宗郊祀前朝享太庙三十首 其四 迎神用《兴安》。","郊庙朝会歌辞","四言",["秬鬯既将，黄钟具奏。","肃我祖考，祗栗以俟。","于皇列圣，在帝左右。","监观于兹，云车来下。"],0,"x207","宋"],["辞世偈","清溪沅禅师","四言",["六十七年，无法可说。","一片云收，澄潭皎月。"],0,153,"宋"],["文宣王及其弟子赞 其六十三","赵构","四言",["侁侁申周，四科与俦。","逸驾文圃，鼓枻儒流。","冠佩既燕，言动允休。","邵陵得封，可想清修。"],0,249,"宋"],["题宝塔","释印肃","四言",["塔本无缝，真如不动。","说此经处，涌出虚空。","释迦多宝，听说如梦。","东西无二，见见不同。","无刹不收，无色不融。","层层落落，光影重重。","恒河沙劫，尽入其中。","三世诸佛，一法身通。","针劄不入，寿量无穷。","目连舍利，常隐于中。","阿育王像，妙色金容。","天龙八部，万亿灵通。","擎山持杵，遍满虚空。","护持礼塔，摧灭魔踪。","显正宝塔，八面玲珑。","水火不坏，障毗岚风。","众生见者，永脱樊笼。","信者施者，功德不空。","无住布施，福德无穷。","住相布施，犹滞途中。","诸佛子等，无功之功。","成如是塔，标指宗风。","空劫坏时，此塔不镕。","劫火洞然，体若虚空。","究竟涅槃，应时体用。","逗机应化，无法不同。","皇图永固，舜雨尧风。","郡邑宰僚，禄位高崇。","万民快乐，五谷盈丰。","狼烟自息，瑞气和浓。","性相平等，含灵体同。","世出世间，色不异空。","稽首和南，礼塔事终。","乾道四年，戊子季冬。","南泉慈化，肃老遗风。","法界有情，一切珍重。"],0,"x121","宋"],["文宣王及其弟子赞 其二十四","赵构","四言",["天清日明，密雨曷有。","师命持盖，子亦善扣。","惟夫子博，三才允究。","学者之乐，所得遂茂。"],0,249,"宋"],["文宣王及其弟子赞 其七十三","赵构","四言",["乐氏子声，锡爵昌平。","信道之万，见善乃明。","引领高节，载惟思诚。","先贤聿集，出为时英。"],0,249,"宋"],["殉节诗  其一","方氏","四言",["昊天懵懵，四海汹汹。","赵氏终衰，妖孽景从。"],0,228,"宋"],["噫田操四章章六句寄呈王介甫 其一","王令","四言",["田彼黍矣，则食于秋。","我人之耕，载芟载薅。","岂不惮劳，将食无攸。"],0,"x68","宋"],["元符亲享明堂十一首 其十一 归大次用《憩安》。","郊庙朝会歌辞","四言",["有奕明堂，万方时会。","宗子圣考，作帝之配。","乐酌虞典，礼从周志。","厘事既成，于皇来暨。"],0,"x207","宋"],["绍兴亲享明堂二十六首 其十 皇帝还位用《仪安》。","郊庙朝会歌辞","四言",["耳听𫓶玉，目瞻𤈶珠。","乐备周奏，仪参汉图。","神人并况，天地同符。","亦既见帝，王心则愉。"],0,"x207","宋"],["颂古十七首 其十一","释师观","四言",["报慈一隔，描邈不得。","大用现前，不存轨则。"],0,210,"宋"],["孝宗明堂前享太庙三首 其三 还大次用《干安》。","郊庙朝会歌辞","四言",["礼既行矣，乐既成矣。","维祖维妣，安且宁矣。","皇举玉趾，佩锵鸣矣。","拜贶总章，于厥明矣。"],0,"x207","宋"],["古怨诗 其三","刘敞","四言",["天兮地兮，戴且履兮。","孰是人斯，莫我视兮。"],0,"x51","宋"],["偈颂六十首 其十二","释昙华","四言",["虚空为鼓，须弥为槌。","要打便打，莫问是谁。"],0,47,"宋"],["江豚诗","孔武仲","四言",["黑者江豚，白者白塈。","状异名殊，同宅大水。","渊有群鱼，掠以肥已。","是谓小害，顾有可喜。","大川夷平，缟素不起。","两两出没，矜其颊嘴。","若俛若仰，若跃若跪。","舟人相语，惊澜将作。","亟入湾浦，踣樯布笮。","俄顷风至，簸山摇岳。","浪如车轮，氛雾相薄。","舟人燕安，如在城郭。","先事而告，昭哉尔功。","鳄啖牛马，头象鼍龙。","暴殄天物，安得尔同。","于人无害，所欲易充。","暴露形体，告人以忠。","又多膏油，以助汝工。","江湖下贫，机杼以农。","乌鹊知风，商羊识雨。","大厦之下，风雨何苦。","岂知舟航，方在积险。","以尔占天，蓍蔡之验。","古之报祭，不遗微虫。","孰扬尔烈，登荐蜡宫。","世不尔好，复惟尔恶。","我作此歌，为昭其故。"],0,"x117","宋"],["噫田操四章章六句寄呈王介甫 其三","王令","四言",["伐木伐木，无废于勤。","不足柱榱，犹用以薪。","岂弟君子，无易于人。"],0,"x68","宋"],["欢喜吟","邵雍","四言",["日往月来，终则有始。","半行天上，半下地底。","照临之间，不忧则喜。","予何人哉，欢喜不已。"],0,"x57","宋"],["绍兴亲享明堂二十六首 其三 降神用《诚安》。","郊庙朝会歌辞","四言",["噫神何亲，惟德是辅。","玉牲具陈，诚则来顾。","我开明堂，遵国之故。","尚蒙居歆，以笃宗祜。"],0,"x207","宋"],["题秋堂四兰 其三 雨","释绍昙","四言",["纷披佩玉，仆委苔痕。","檐花写恨，难拈楚魂。"],0,"x108","宋"],["偈颂三十首 其十二","释慧晖","四言",["路遮户外，家包云中。","客游三月，主居月宫。"],0,194,"宋"],["偈颂一百四十一首 其二十九","释师范","四言",["安居结制，现前三昧。","普化摇铃，老卢踏碓。"],0,"x155","宋"],["颂古四十八首 其三十一","释慧开","四言",["问既一般，答亦相似。","饭里有砂，泥中有刺。"],0,65,"宋"],["绣释迦像并十八罗汉赞 第八阇罗弗多罗尊者","惠洪","四言",["坐依胡床，手把筇竹。","偏袒右肩，而收一足。","小僧涤器，师视而笑。","主伴则殊，日用同妙。"],0,"x42","宋"],["四圣赞 其二","释师体","四言",["稽首观音，全彰妙有。","鹤唳青霄，莺啼绿柳。","鼓响钟鸣，椎鸡打狗。","不落诸缘，通身眼手。"],0,5,"宋"],["颂古十五首 其五","释慧远","四言",["电卷星飞，珠回玉转。","打破面皮，赤心片片。"],0,154,"宋"],["偈颂十五首 其十二","释宝印","四言",["初三十一，中九下七。","众眼难瞒，当机莫惜。"],0,106,"宋"],["绣释迦像并十八罗汉赞 第十八宾头卢尊者","惠洪","四言",["夷奴碾茶，愚中有慧。","走鹿卧地，动中有止。","而师持麈，闲坐俯视。","曾见佛来，法法如是。"],0,"x42","宋"],["师资吟","邵雍","四言",["未知道义，寻人为师。","既知道义，人来为资。","寻师未易，为资实难。","指南向道，非去非还。","师人则耻，人师则喜。","喜耻皆非，我独无是。","好为人师，与耻何异。"],0,"x57","宋"],["送张漕正","徐积","四言",["以正名官，居官以正。","岂惟朝廷，生民之幸。","名官以正，居官以直。","岂惟生民，宗庙社稷。","积者为庆，流者为泽。","远者无疆，久者无极。","此奚有他，一言之力。","维时我后，智勇兼有。","揭日当天，操杓运斗。","随手如意，不劳而治。","明明赫赫，有因有革。","所因者宜，所革者当。","维当维宜，生民之望。","维正维言，民之望之。","维言维正，何以尚之。","越有诤臣，义不顾身。","白刃可蹈，赤心可倾。","既曰真矣，弗变弗移。","既曰直矣，弗阿弗随。","何事可沮，何利可回。","不可则止，其可则为。","往司厥官，往成厥功。","回天论事，有祖之风。"],0,"x123","宋"],["咸平亲郊八首 其一 降神用《高安》。","郊庙朝会歌辞","四言",["圜丘何方，在国之阳。","礼神合祭，运启无疆。","祖考来格，笾豆成行。","其仪肃肃，降福穰穰。"],0,"x207","宋"],["和子瞻次韵陶渊明劝农诗 其五","苏辙","四言",["斫木陶土，器则不匮。","绩麻缫茧，衣则可冀。","药饵具前，病安得至。","坐而告穷，相视徒愧。"],0,"x135","宋"],["畴依  其一四","王柏","四言",["惟孟轲氏，雄士绝识。","伯仲禹功，力距扬墨。","性善养气，前所未闻。","历选诸子，实醇乎醇。"],0,"x137","宋"],["偈颂十七首 其三","释师范","四言",["滴水滴冻，浑无罅缝。","明眼衲僧，失却鼻孔。"],0,"x155","宋"],["颂古三十首 其十九","释怀深","四言",["檐头雨滴，阶前地湿。","法法现成，人信不刃。","更问如何，长江水急。"],0,"x134","宋"],["偈颂十八首 其十三","释广闻","四言",["落赖家风，今日重举。","草本多同，西天此土。"],0,10,"宋"],["偈颂六十七首 其二十三","释原妙","四言",["大海无鱼，大地无草。","大富无粮，大悟无道。"],0,137,"宋"],["畴依  其一五","王柏","四言",["圣道不行，自周公殁。","圣学不传，由孟子卒。","上无善治，下无真儒。","章句训诂，煨烬之余。"],0,"x137","宋"],["端午寒溪早出","薛季宣","四言",["云天鸿蒙，烟萝冥密。","寒溪线绕，荆江壁出。","竹径晨游，露风飘𫗇。","有怀硕人，远在清汨。","不竞流芳，眷此诚壹。","道存语外，泓潭纳日。","形模比栉，滉如日室。","万派瓜分，无往弗彻。","吾心愦焉，莫可致诘。"],0,"x194","宋"],["今日何夕  其五","曾丰","四言",["今夕何夕，袢暑其蒸。","于后之旦，维槿始荣。","有绰其声，我后中兴。","我公协成，有功有能。","我后显旌，不伐不矜。","我氓盛称，我氓盛称，我公长生。"],0,"x193","宋"],["春日  其一","陈杰","四言",["春日悠悠，春风载条，春酒思柔。","念我农人，种秫在畴。"],0,174,"宋"],["皇雅十首  其二○","尹洙","四言",["帝咨庶工，畴其辅予。","俊乂以登，厥劳乃图。","匪忘旧勋，非贤勿俞。","巍巍衮台，盛德以居。"],0,108,"宋"],["大笔吟","邵雍","四言",["有客无知，为性太质。","不忮不求，无固无必。","足蹑天根，手探月窟。","所得之怀，尽赋于笔。","意远情融，气和神逸。","酒放微醺，绡铺半匹。","如风之卒，如云之勃。","如电之欻，如雨之密。","或往或还，或没或出。","涤荡氛埃，廓开天日。","鸾凤翱翔，龙蛇盘屈。","春葩暄妍，秋山崒屼。","三千簪裾，俯循儒术。","百万貔貅，仰听军律。","松桂成林，芝兰满室。","蜀锦初番，朝霞乍拂。","白璧一双，黄金百镒。","羲之来求，牧之来乞。","物外神交，人间事毕。","观者析醒，收之愈疾。"],0,"x57","宋"],["广寿","彭龟年","四言",["人孰为寿，寿莫如德。","日新又新，终古不息。","学以明之，先正我心。","所欲既寡，山崇海深。"],0,223,"宋"],["绍兴以后祀感生帝十六首 送神用《大安》。","郊庙朝会歌辞","四言",["丰祀孔饰，肃来自天。","兰尊既彻，飙驭载遄。","骑云缥缈，聆乐流连。","惟迈惟顾，降福绵绵。"],0,"x207","宋"],["高宗祀明堂前朝享太庙二十一首 其十 太宗室用《大定》。","郊庙朝会歌辞","四言",["煌煌神武，再御戎轩。","时惠南土，旋定太原。","车书混同，声教布宣。","维天佑之，亿万斯年。"],0,"x207","宋"],["定州阅古堂","富弼","四言",["朔方之兵，劲于九土。","尤劲而要，粤惟定武。","兵劲在驭，用则罴虎。","失驭而劲，骄不可举。","曰保曰贝，闭壁连阻。","武爵新守，束手就虏。","皇帝曰噫，汝武曷取。","有敝必革，以儒于抚。","公来帅定，始以威怒。","有兵悍横，一用于斧。","连营怛之，胆栗腰伛。","既惧而教，如𫗦如乳。","以刺以射，以钲以鼓。","无一不若，师师旅旅。","列城自刺，靡不和附。","阴沴为梗，降此大雨。","大河破泄，在河之浒。","民被黜垫，田入莽污。","流离荡析，不得其所。","公戚曰吁，予敢宁处。","乃大招来，乃大保聚。","乃营帛粟，寒衣饥茹。","民归而安，水下孰御。","强弱死生，由公复虑。","曰义曰仁，震肃春煦。","合和蒸天，天顺以序。","公境独稔，爰麦爰黍。","公俗独乐，夫耕妇杼。","人虽曰康，公亦奚豫。","谓此一方，民与兵具。","务剧任重，稽古其裕。","人皆谓公，与古为伍。","公文化民，公武御侮。","何思古人，公不自许。","遂择奇匠，绘于堂宇。","列其行事，指掌可数。","前有古人，在我门户。","后有来者，依我墙堵。","斯堂勿坏，有堂有故。","堂之不存，来者曷睹。","宏乎焕乎，千载是矩。"],0,44,"宋"],["临济赞","释祖先","四言",["揎拳捋肘，只有一个。","电卷星飞，抬头蹉过。"],0,54,"宋"],["圣号雅二篇 其二","赵湘","四言",["皇振厥猷，法天以宁。","我法我度，我经我营。","或风或雨，或雷或霆。","日月昭然，奋皇之明。","霜肃以平，露泽以清。","左右百辟，烂兮敷星。"],0,126,"宋"],["上钦成皇后册宝六首 其六 亚、终献用《和安》。","郊庙朝会歌辞","四言",["酌彼玉瓒，有椒其馨。","鬷假无言，雍容在庭。","生莫与崇，于赫厥声。","祀事孔明，神格是听。"],0,"x207","宋"],["高宗郊祀前朝享太庙三十首 其十九 入小次用《干安》。","郊庙朝会歌辞","四言",["于皇我后，祗戒专精。","躬制声诗，文思聪明。","雍容戾止，玉立端诚。","神听如在，福禄来宁。"],0,"x207","宋"],["褒忠庙歌","叶梦得","四言",["天生裔夷，以限四极。","有不能然，乃啸上国。","既殄我民，尔则逆天。","恶稔而诛，天胡舍㫋。","在昔肃氏，厥贡砮矢。","不我来庭，敢干我纪。","揭揭杨侯，梗其喉牙。","万夫一躯，莫我敢加。","谁谓尔狂，我冯我抑。","谁谓备残，我唑我斥。","天子曰嘻，惟我有臣。","曷不赎之，人百其身。","屹屹崇冈，侯安于域。","桷梴旅楹，侯有庙食。","惟皇上帝，命侯来归。","顾瞻山川，申我王威。","侯食百世，旗纛旖旖。","百灵齐趋，从侯北指。","侯车轰轰，于彼故疆。","覆其穴巢，何有虎狼。","告功帝阍，帝笑为喜。","四方既平，侯祀百世。","曷慕匪忠，歇畏匪死。","简于帝衷，惟忠弗畏。","明明天子，与帝一心。","是播是崇，是显自今。","有流滔滔，贯于南邦。","我诗孔昭，配此大江。"],0,4,"宋"],["四圣赞 其四","释师体","四言",["稽首普贤，不可思议。","出头露面，开言吐气。","拍盲担板，忘恩断义。","事无寸长，熏天炙地。"],0,5,"宋"],["宋江三十六赞 其三十一 没遮拦穆横","龚开","四言",["出没太行，茫无畔岸。","虽没遮拦，难离火伴。"],0,103,"宋"],["干德以后祀感生帝十首 降神用《大安》。","郊庙朝会歌辞","四言",["和均玉管，政协璇衡。","四序资始，万物含生。","皇猷允洽，至德惟明。","为民祈福，克致精诚。"],0,"x207","宋"],["偈颂一百四十二首 其一","释广闻","四言",["不落化门，扫除露布。","拟觅行踪，铁蛇横卧。"],0,10,"宋"],["绍兴朝会十三首 上公上寿用《和安》。","郊庙朝会歌辞","四言",["八音克谐，万舞有奕。","上公奉觞，率兹百辟。","声效呼嵩，祝圣人寿。","亿载万年，天长地久。"],0,"x207","宋"],["墨梅 其二","家铉翁","四言",["冰崖孤芳，雪林早春。","伴我读易，见天地心。"],0,96,"宋"],["绍兴亲享明堂二十六首 其十四 太祖位酌献用《孝安》。","郊庙朝会歌辞","四言",["一德开基，百年垂统。","中天禘郊，薄海朝贡。","宝龟相承，器鼎加重。","泽深庆绵，帝复命宋。"],{"yz":["崔敦诗"]},"x207","宋"],["意尽吟","邵雍","四言",["意尽于物，言尽于诚。","矫情镇物，非我所能。"],0,"x57","宋"]]