[["宁宗郊祀二十九首 诣望瘗位用《干安》。","郊庙朝会歌辞","四言",["地载万物，阴翕而成。","山岳河渎，皆坤之灵。","克肖其象，与阴俱凝。","视瘗于坎，思求厥成。"],0,"x207","宋"],["绍兴亲享明堂二十六首 其十五 太宗位酌献用《韶安》。","郊庙朝会歌辞","四言",["绍天承业，继世立功。","帷幄屡胜，车书始同。","武扫氛雾，文垂日虹。","遗泽所及，孰知其终。"],0,"x207","宋"],["熙宁望祭岳镇海渎十七首 其三 奠玉币用《明安》。","郊庙朝会歌辞","四言",["祀以崇德，币则有仪。","肃我将事，登降孔时。","精明纯洁，罔有弗祗。","史辞无愧，神用来娭。"],0,"x207","宋"],["绍兴祀九宫贵神十首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["均调大化，阴骘下民。","骏功有赫，诞举明禋。","嘉觞中贰，执事惟寅。","清明鬯矣，福禄攸臻。"],0,"x207","宋"],["枢相宣抚虞公寿雅 汉清 其七","王质","四言",["我耄皤皤，公昔年之，而曷捐之。"],0,"x37","宋"],null,["真宗告飨六首 其二 太祖、太宗加上尊谥用《显安》。","郊庙朝会歌辞","四言",["报贶陟封，聿昭典礼。","让德穹厚，归功祖祢。","丕显尊称，尽善尽美。","寅威孝思，以介蕃祉。"],0,"x207","宋"],["宁宗郊祀二十九首 饮福用《禧安》。","郊庙朝会歌辞","四言",["瓒斝觓䚧，觥罍氤氲。","有醴惟香，有酒惟欣。","肸蚃丰融，懿懿芬芬。","我龙受之，如川如云。"],0,"x207","宋"],["高宗郊前朝献景灵宫二十一首 其二 升殿用《干安》。","郊庙朝会歌辞","四言",["帝既临飨，罄兹精意。","对越在天，爰升紫陛。","孔容翼翼，保承丕绪。","孝奉天仪，永锡尔类。"],0,"x207","宋"],["绍兴十四年奉上徽宗册宝三首 其二 册宝升殿用《显安》。","郊庙朝会歌辞","四言",["金字煌煌，瑶光灿灿。","群工奉之，登此宝殿。","对越祖宗，式遵成宪。","威灵在天，来止来燕。"],0,"x207","宋"],["大中祥符封禅十首 其五 亚献用《恭安》。","郊庙朝会歌辞","四言",["因高定位，礼修物备。","荐鬯卜牲，虔恭寅畏。","八音克谐，天神咸暨。","降福穰穰，永锡尔类。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 诣圣祖位用《干安》。","郊庙朝会歌辞","四言",["维宋肖德，钦天顾右。","于皇道祖，丕厘灵祐。","葛藟殖繁，瓜瓞孕茂。","克昌厥后，世世孝奏。"],0,"x207","宋"],["纳火祀大辰十二首 捧俎用《丰安》。","郊庙朝会歌辞","四言",["万汇攸成，四方宁谧。","工祝致告，普存民力。","乃荐斯牲，为俎孔硕。","介以繁祉，式和民则。"],0,"x207","宋"],["出火祀大辰十二首 捧俎用《丰安》。","郊庙朝会歌辞","四言",["有严在涤，陈彼牲牢。","孔硕其俎，荐此血毛。","厥初生民，饮茹则然。","以燔以炙，伊谁云先。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 文舞退、武舞进用《正安》。","郊庙朝会歌辞","四言",["持翟成象，秉朱就列。","旄乘整溢，凤仪谐节。","挥舒皇文，歌蹈先烈。","合好效欢，福流有截。"],0,"x207","宋"],["李养源自号蒙泉求诗于东平包某作此以赠之","包恢","四言",["水象童蒙，以出伊始。","泉乃白水，出自艮止。","天一初生，纯一清明。","厥初始达，犹元而亨。","当其蒙稚，涓涓犹细。","及其渐进，混混未止。","如玉与珠，不曰白乎。","如冰与雪，湛不可污。","反求诸己，心正如是。","有生之初，纯白纯懿。","养之于蒙，作圣之功。","大人不失，与赤子同。","圣如夫子，皓莫尚已。","涅而不缁，洞彻表里。","溥博渊泉，浩浩渊渊。","皓如银河，月流星连。","仰观先圣，本同一性。","自始失养，遂终失正。","气或杂之，内欲蔽伊。","官或不思，外引远而。","蒙反成失，白反变黑。","黑水西流，清渭南隔。","君在家庭，习若少成。","异彼污世，同流浊泾。","外引内欲，永绝勿赎。","蒙养宜深，荐习宜熟。","浚发尔源，如发蒙然。","放乎四海，波涛际天。","学有源委，海可至矣。","所不然者，有如白水。"],0,127,"宋"],["上明达皇后册宝五首 其三 退文舞、进武舞用《昭安》。","郊庙朝会歌辞","四言",["秉翟竣事，万舞𪭢金。","总干挥戚，节以鼓音。","礼容有炜，肸蚃来歆。","淑灵是听，雅奏愔愔。"],0,"x207","宋"],["上钦成皇后册宝六首 其二 迎神用《歆安》。","郊庙朝会歌辞","四言",["于显惟德，徽柔懿明。","嫔于初载，有闻惟馨。","肆我鼓钟，万舞在庭。","神保是格，来止来宁。"],0,"x207","宋"],["绍兴亲享明堂二十六首 其二十五 望瘗用《仪安》。","郊庙朝会歌辞","四言",["礼协丰融，诚交彷佛。","辟公受膰，宗祀临瘗。","贻我来牟，以兴嗣岁。","山川出云，天地同气。"],0,"x207","宋"],["绍兴祀高禖十首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["中春涓吉，蒇事禖祠。","礼备乐作，笾豆孔时。","贰觞毕举，荐献无违。","庶几神惠，祥启熊罴。"],0,"x207","宋"],["出火祀大辰十二首 商丘宣明王位奠币用《嘉安》。","郊庙朝会歌辞","四言",["二七储神，与天地并。","孰俪厥德，聿惟南正。","功楙陶唐，泽流亿姓。","作配严禋，贽列惟称。"],0,"x207","宋"],["宁宗郊祀二十九首 还位用《干安》。","郊庙朝会歌辞","四言",["甘露流英，卿云舒采。","灵俞有喜，神光晻暧。","穆穆来莅，洋洋如在。","帝用居歆，泽及四海。"],0,"x207","宋"],["宁宗郊祀二十九首 还位用《干安》。","郊庙朝会歌辞","四言",["璇图天深，鼎文日辉。","庆流皇家，象炳紫微。","干回冕旒，云焕衮衣。","何千万年，式于九围。"],0,"x207","宋"],["增上神宗徽号一首 升殿用《显安》。","郊庙朝会歌辞","四言",["于惟祢庙，乃圣乃神。","秉文之士，作起惟新。","建宫稽古，一视同仁。","庶几备号，以享天人。"],0,"x207","宋"],["颂古二首 僧问雪窦明觉如何是佛，曰四山围绕。","释知昺","四言",["狂狗逐块，瞎馿趁队。","只许我知，不许你会。"],0,59,"宋"],["高宗建炎初祀昊天上帝 太祖位酌献用《英安》。","郊庙朝会歌辞","四言",["赫赫翼祖，受命于天。","德迈三代，威加八埏。","陟配上帝，明禋告虔。","流光垂裕，于万斯年。"],0,"x207","宋"],["熙宁蜡祭十三首 其七 送神用《宣安》。","郊庙朝会歌辞","四言",["灵之来下，扩景乘光。","灵之回御，景龙以骧。","鉴我休德，降嘏产祥。","大田多稼，以惠无疆。"],0,"x207","宋"],["佥书枢密院事张公","《靖康小雅》作者","四言",["金人强悍，一岁再至。","公提郡兵，疾驱入卫。","敌将易姓，公秉大义。","独敢抗言，必复赵氏。","欲扶日驭，力扫氛翳。","身拘名张，忠烈振世。"],0,91,"宋"],["绍兴以后祀五方帝六十首 神农氏酌献用《祐安》。","郊庙朝会歌辞","四言",["猗欤先农，肇兹黍稷。","既殖既播，有此粒食。","秬鬯洁清，彝樽疏幂。","竭我瑶斝，莫报嘉绩。"],0,"x207","宋"],null,["宁宗朝享三十五首 饮福用《干安》。","郊庙朝会歌辞","四言",["玉瓒黄流，有𫗣其香。","来假来享，降福穰穰。","我应受之，汤孙之将。","有百斯男，福禄无疆。"],0,"x207","宋"],["行者了宽等题钱买度牒疏四章 其四","李昴英","四言",["即心是佛，见性成僧。","无奈世缘，要二尺绫。"],0,124,"宋"],["孝宗明堂前朝献景灵宫八首 其六 再诣圣祖位用《干安》。","郊庙朝会歌辞","四言",["岁逢有年，月旅无射。","我将我飨，如几如式。","肃尔臣工，谐尔金石。","本原休功，垂裕罔极。"],0,"x207","宋"],["绍兴祀祚德庙八首 其五 英略公位酌献用《成安》。","郊庙朝会歌辞","四言",["立孤固难，死亦匪易。","义轻一身，开先赵嗣。","肃穆庙貌，烈有馀气。","式旋嘉荐，昭哉祀事。"],0,"x207","宋"],["五龙六首 其五 亚、终献用《嘉安》。","郊庙朝会歌辞","四言",["明明天子，礼文咸秩。","矧神之功，横被九域。","云施称民，物产滋殖。","嘉承惠和，罔有终极。"],0,"x207","宋"],["皇后庙十五首 其九 庄穆皇后室用《理安》。","郊庙朝会歌辞","四言",["曾孙袭庆，柔祇育德。","正位居体，其仪不忒。","教被宫壶，化行邦国。","祝史正辞，垂裕无极。"],0,"x207","宋"],["熙宁以后享庙五首 其四 祫享仁宗用《大和》。","郊庙朝会歌辞","四言",["于穆仁庙，圣泽滂流。","华夷用乂，动植蒙休。","徽名冠古，奕世垂谋。","帝躬祼献，盛典昭修。"],0,"x207","宋"],null,["朝谒太清宫九首 其七 饮福用《大安》。","郊庙朝会歌辞","四言",["彼涡之壤，指李之区。","千乘万骑，来朝密都。","躬陈芳荐，款接仙舆。","饮酒受福，永耀鸿图。"],0,"x207","宋"],["大中祥符封禅十首 其九 太祖配坐酌献用《禅安》。","郊庙朝会歌辞","四言",["皇矣圣祖，丕赫神武。","秉运宅中，威加九土。","德厚功崇，颂声载路。","陟配方祗，对天之祜。"],0,"x207","宋"],["大晟府拟撰释奠十四首 奉俎用《丰安》。","郊庙朝会歌辞","四言",["道同乎天，人伦之至。","有飨无穷，其兴万世。","既洁斯牲，粢明醑旨。","不懈以忱，神之来暨。"],0,"x207","宋"],["绍熙别庙二首 其二 安恭皇后室酌献用《歆安》。","郊庙朝会歌辞","四言",["美咏河洲，德嫔妫汭。","徽音如存，肇修祀事。","缩以包茅，酌以醴齐。","灵来顾歆，降福攸备。"],0,"x207","宋"],["高宗郊前朝献景灵宫二十一首 其三 降圣用《太安》。","郊庙朝会歌辞","四言",["惟德馨香，升闻八方。","粤神临之，来从帝乡。","万灵景卫，有烨其光。","监我精纯，降福穰穰。"],0,"x207","宋"],["四贤堂","汤起岩","四言",["猗与四公，棠棣之华。","秀韡一时，茂兴两家。","宋公联翩，鄂不相鲜。","万里风云，上负青天。","连公戾契，渊冰澄结。","进而蹩躄，砥砺其节。","其光晔晔。","追惟平生，法兴是仪。","邑人之思，右史之词。","雨箔风楹，岁环几经，筑此特堂。","吾今令君，令君勤民。","民燕其德，振滞补弊，此焉居一。","于时四公，序集其觞。","生气津津，冠佩有光。","古之为政，崇德尚贤。","居今笃古，令君有焉。","君系陇西，绍祖维名。","起岩作诗，辑和厥声。","敢告典者，毋替其承。"],0,53,"宋"],["上册宝十三首 送神用《歆安》。","郊庙朝会歌辞","四言",["礼仪既备，神保聿归。","洋洋在上，不可度思。","神之来兮，肸蚃之随。","神之去兮，休嘉是贻。"],0,"x207","宋"],["出火祀大辰十二首 送神用《理安》。","郊庙朝会歌辞","四言",["五运惟火，寔宗众阳。","宿壮用明，千载愈光。","神保聿归，安处火房。","郁攸不作，炎图永昌。"],0,"x207","宋"],["皇后庙十五首 其七 懿德皇后室用《顺安》。","郊庙朝会歌辞","四言",["王门禀庆，帝族惟贤。","功存内治，德协静专。","流芳图史，垂范纮𫄧。","新庙有侐，祀礼昭然。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其三十五 北方迎神用《凝安》。","郊庙朝会歌辞","四言",["我土绵绵，孰匪疆理。","惟时幽都，匪曰隃只。","涤哉艮月，朔风其同。","曷阻曷深，其亦来降。"],0,"x207","宋"],["高宗郊前朝献景灵宫二十一首 其八 奉馔用《吉安》。","郊庙朝会歌辞","四言",["百职骏奔，来相于庭。","奉盛以告，登兹芳馨。","际天蟠地，默运三灵。","神兮来歆，祚我休平。"],0,"x207","宋"],["真宗奉圣祖玉清昭应宫十一首 其三 奉馔用《吉安》。","郊庙朝会歌辞","四言",["发祥有自，介福无疆。","纷纶丕应，保佑下方。","嘉荐斯备，雅奏具扬。","寅威洞达，监眄昭章。"],0,"x207","宋"],["崇恩太后升祔十四首 升降殿用《熙安》。","郊庙朝会歌辞","四言",["笙箫纷如，陟彼庙庭。","锵锵佩玉，怀兹先灵。","神保聿止，音容杳冥。","繁禧是介，万年惟宁。"],0,"x207","宋"],["上明达皇后册宝五首 其四 彻豆用《成安》。","郊庙朝会歌辞","四言",["登献罔愆，俎豆斯彻。","神具醉止，礼终乐阕。","御事既退，珊珊佩玦。","介我繁祉，歆此蠲洁。"],0,"x207","宋"],["枢相宣抚虞公寿雅 江舻 其三","王质","四言",["天子在宫，有恫悒悒。","神主在庙，有震岌岌。","暨我国人，以莫不惕。"],0,"x37","宋"],["熙宁望祭岳镇海渎十七首 其五 送神用《凝安》。","郊庙朝会歌辞","四言",["神之至止，熙坛为春。","神之将归，旗服振振。","欻兮回飙，窅兮旋云。","祐于东方，永施厥仁。"],0,"x207","宋"],["熙宁望祭岳镇海渎十七首 其八 送神用《凝安》。","郊庙朝会歌辞","四言",["鼓钟云云，吹管伊伊。","神既醉饱，曰送言归。","山有厚藏，水有灵德。","物其永依，往奠炎宅。"],0,"x207","宋"],["熙宁望祭岳镇海渎十七首 其十一 送神用《凝安》。","郊庙朝会歌辞","四言",["言旋其处，以奠中域。","无替厥灵，四方是则。","神永不息，祀永不愆。","以享以报，于万斯年。"],0,"x207","宋"],["熙宁望祭岳镇海渎十七首 其十四 送神用《凝安》。","郊庙朝会歌辞","四言",["我乐我神，簋俎腥饔。","曰神之还，西土是宫。","于蕃禽鱼，于衍草木。","富我薮隰，滋我高陆。"],0,"x207","宋"],["熙宁望祭岳镇海渎十七首 其十七 送神用《凝安》。","郊庙朝会歌辞","四言",["维山及川，奠宅幽方。","我度其灵，降止靡常。","肃肃坎坛，既迎既将。","促乐彻俎，是送是望。"],0,"x207","宋"],null,null,["理宗朝享三首 其三 宁宗室用《大安》。","郊庙朝会歌辞","四言",["帝德之休，恭俭渊懿。","三十一年，谨终如始。","升祔在宫，祖功并美。","民怀有仁，何千万世。"],0,"x207","宋"],["崇恩太后升祔十四首 退文舞、进武舞用《昭安》。","郊庙朝会歌辞","四言",["翩然干戚，扬庭陈阶。","文以经纬，武以威怀。","其张其弛，节与音谐。","迄兹献享，妥灵绥来。"],0,"x207","宋"],null,["绍兴祀神州地祇十六首 升殿用《正安》。","郊庙朝会歌辞","四言",["崇崇其坛，屹矣层级。","佩约步趋，降登中节。","左瞻右睨，祥风蔼集。","斿旆羽纷，昭鉴翊翊。"],0,"x207","宋"],["枢相宣抚虞公寿雅 江舻 其五","王质","四言",["有庚之寅，维公其生。","在巳之辛，维公其成。","而有斯厄，而有斯人。","匪天之私，伊宋之仁。"],0,"x37","宋"],["绍兴享先农十一首 其六 文舞退、武舞进用《正安》。","郊庙朝会歌辞","四言",["羽毛干戚，张弛则殊。","进旅退旅，匪棘匪舒。"],0,"x207","宋"],["祭九鼎十二首 其二 奉馔用《丰安》。","郊庙朝会歌辞","四言",["粢盛既丰，牲牢既充。","展兹熙事，温温其恭。","惟明欣欣，燔炙芬芬。","保乎天子，繁祉荐臻。"],0,"x207","宋"],["宁宗朝享三十五首 再诣盥洗用《干安》。","郊庙朝会歌辞","四言",["精粹象天，明清鉴月。","再御兹盥，益致其洁。","齐容颙若，诚意洞彻。","百礼允洽，率礼不越。"],0,"x207","宋"],["绍兴祀皇地祇十五首 升殿用《正安》。","郊庙朝会歌辞","四言",["景风应时，聿严毖祀。","用事方丘，锵锵济济。","登降有节，三献成礼。","神其格思，锡我繁祉。"],0,"x207","宋"],["大中祥符朝会五首 其二 再举酒用《神芝》。","郊庙朝会歌辞","四言",["彼茁者芝，茂英煌煌。","敷秀乔岳，寔繁其房。","适符修贡，封峦允臧。","永言登荐，抑惟旧章。"],0,"x207","宋"],null,["枢相宣抚虞公寿雅 江舻 其六","王质","四言",["大江之滨，采石之津。","波之沦沦，石之粼粼。","谓公可堙，江则可尘。","山之嵚嵚，隰之畇畇。","谓公可磨，山则可簪。"],0,"x37","宋"],["干德以后祀感生帝十首 奠玉币用《庆安》。","郊庙朝会歌辞","四言",["笾豆有践，玉帛斯陈。","神无常享，享于精纯。"],0,"x207","宋"],["绍兴释奠武成王七首 其三 奠币用《明安》。","郊庙朝会歌辞","四言",["祀率旧典，礼崇骏功。","齐明衷正，肸蚃丰融。","量币肃备，周旋鞠躬。","神其昭受，幽赞无穷。"],0,"x207","宋"],["宁宗朝享三十五首 再升殿用《干安》。","郊庙朝会歌辞","四言",["明明维后，诒厥孙谋。","系隆我汉，陈锡哉周。","以孝以飨，世德作求。","介以繁祉，万邦咸休。"],0,"x207","宋"],["高宗郊前朝献景灵宫二十一首 其十九 降殿用《干安》。","郊庙朝会歌辞","四言",["我秩元祀，上推灵源。","展事有侐，祲威肃然。","丹墄既降，秉心益虔。","荷天之休，于千万年。"],0,"x207","宋"],["宁宗郊祀二十九首 送神用《景安》。","郊庙朝会歌辞","四言",["神辅有德，来燕来娭。","礼荐熙成，三灵逆厘。","神飨有道，言旋言归。","福祉咸蒙，百世本支。"],0,"x207","宋"],["祭九鼎十二首 其五 立夏，冈鼎迎神用《凝安》。","郊庙朝会歌辞","四言",["我方东南，我日朱明。","爰因其时，鼎以冈名。","粢盛既馨，牲牷既盈。","佑我皇家，巽令风行。"],0,"x207","宋"],["颂古四十五首 其一","释如珙","四言",["世尊拈花，迦叶微笑。","正法眼藏，涅槃妙心。"],0,255,"宋"],["枢相宣抚虞公寿雅 汉清 其三","王质","四言",["农耰于野，不蹂一苗。","贾驰于郊，不惊一毛。","公在襄阳，民生逍遥。"],0,"x37","宋"],["宁宗郊前朝献景灵宫二十四首 诣饮福位用《干安》。","郊庙朝会歌辞","四言",["若木露英，清云流霞。","蔓蔓芝秀，冯冯桂华。","绵瑞无疆，产嘏孔奢。","皇则受之，巩我帝家。"],0,"x207","宋"],["淳祐祭海神十六首 东海位奠玉币用《德安》。","郊庙朝会歌辞","四言",["百川所归，天地之左。","澒洞鸿蒙，功高善下。","行都攸依，百禄是荷。","制币嘉玉，以侑以妥。"],0,"x207","宋"],["华之高寿鲁斋先生七十  其七","金履祥","四言",["自古在昔，圣贤有作。","七十之龄，德烈方恪。"],0,83,"宋"],["上钦成皇后册宝六首 其五 酌献用《明安》。","郊庙朝会歌辞","四言",["天维显思，有相于内。","右贤去邪，夙夜儆戒。","猗欤追册，重翟袆衣。","既右享之，百世是仪。"],0,"x207","宋"],["绍兴二十八年祀圜丘 太宗皇帝位奠玉币用《化安》。御制。","郊庙朝会歌辞","四言",["赫赫巍巍，及时纯熙。","昊天成命，后则受之。","登迈邃古，光被声诗。","有币陟配，孙谋所贻。"],0,"x207","宋"],["熙宁蜡祭十三首 其十一 酌献用《禔安》。","郊庙朝会歌辞","四言",["英英礼文，既备而全。","严严四郊，屹屹紫坛。","百末旨酒，其敷若兰。","何以畀民，既寿而安。"],0,"x207","宋"],["政和亲郊三首 其二 配位酌献用《大宁》。","郊庙朝会歌辞","四言",["于皇顺祖，积德累祥。","发源深厚，不耀其光。","基天明命，厥后克昌。","是孝是享，申锡无疆。"],0,"x207","宋"],["高宗郊前朝献景灵宫二十一首 其七 还位用《干安》。","郊庙朝会歌辞","四言",["我后临飨，奠币攸毕。","式旋其趋，矩度有式。","礼容斋庄，孝思纯实。","天休滋至，时万时亿。"],0,"x207","宋"],["高宗郊前朝献景灵宫二十一首 其十二 还位用《干安》。","郊庙朝会歌辞","四言",["奠鬯告成，式旋厥位。","天步雍容，神人燕喜。","九庙观德，百灵荐祉。","子孙其昌，垂千万祀。"],0,"x207","宋"],["高宗郊前朝献景灵宫二十一首 其十六 还位用《干安》。","郊庙朝会歌辞","四言",["帝临閟庭，逆厘上灵。","神羯安坐，肃若有承。","嘉觞既申，德闻惟馨。","灵光留俞，祚我亿龄。"],0,"x207","宋"],["宁宗朝享三十五首 入小次用《干安》。","郊庙朝会歌辞","四言",["皇容肃祗，天步舒迟。","对越惟恭，敬事不遗。","陟降莅止，永言孝思。","上帝临女，日监于兹。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其十九 中央迎神用《凝安》。","郊庙朝会歌辞","四言",["天作高山，屹然中峙。","经营厥宇，万亿咸遂。","火熙土王，爰举时祀。","绳绳宣延，彷佛来止。"],0,"x207","宋"],["熙宁祭风师五首 其四 亚、终献，酌献用《雍安》。","郊庙朝会歌辞","四言",["栗栗坛坫，载是豆觞。","醇烈氤氲，普荐芬芳。","酌之维宜，献之维时。","民有报侑，灵用安之。"],0,"x207","宋"],null,["景德中朝会十四首 初举酒毕用《盛德升闻》。 其一","郊庙朝会歌辞","四言",["八佾具呈，万舞有奕。","既以象功，又以观德。","进旅退旅，执籥秉翟。","至化怀柔，远人来格。"],0,"x207","宋"],["绍兴别庙乐歌五首 其五 彻豆用《宁安》。","郊庙朝会歌辞","四言",["仙驭弗返，眇邈清都。","荐此嘉殽，既丰既腴。","奠享有成，鼓乐愉愉。","彻我豆笾，率礼无逾。"],0,"x207","宋"],["华之高寿鲁斋先生七十  其一","金履祥","四言",["金华之高，其色苍苍。","维华降神，生何及王。"],0,83,"宋"],["大晟府拟撰释奠十四首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["百王宗师，生民物轨。","瞻之洋洋，神其宁止。","酌彼金罍，惟清且旨。","登献惟三，于嘻成礼。"],0,"x207","宋"],["绍兴祭风师六首 其四 酌献用《雍安》。","郊庙朝会歌辞","四言",["我求于神，无臭无声。","神之燕飨，惟时专精。","大磬在列，槱燎在庭。","侑我桂酒，娭其以听。"],0,"x207","宋"],["祀先蚕六首 其二 初献盥洗、升殿用《翊安》。降同。","郊庙朝会歌辞","四言",["灵修戾止，诏以毛血。","既盥而帨，尊爵蠲洁。","金石谐宛，登降有节。","宜顾宜飨，情文不越。"],0,"x207","宋"]]