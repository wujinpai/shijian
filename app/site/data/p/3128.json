[["句 其一","毛滂","残句",["苕水相逢眼便青。"],0,"x110","宋"],["句 其二","王禹偁","残句",["床头只有黄州印，鉴里看成白发翁。"],0,"x91","宋"],["句 其五","吴幵","残句",["星斗垂光烛紫坛。"],0,98,"宋"],["句","廖挺","残句",["馀波下作双溪水，只欠休文八咏楼。"],0,102,"宋"],["句","郑戬","残句",["春到不择地，石傍花自开。"],0,105,"宋"],["句 其六十九","高似孙","残句",["花开才一信，人日故多阴。"],0,181,"宋"],["句","刘昌言","残句",["惟有夜来蝴蝶梦，翩翩飞入刺桐花。"],0,173,"宋"],["句 其二","石懋","残句",["满身美荫抱高柳，问汝适从何处来。"],0,196,"宋"],null,["句 其三","周邠","残句",["候得南枝腊后芳。"],0,251,"宋"],["句 其三","范雍","残句",["山奇号九嵏，名与雍州同。"],0,218,"宋"],["句 其三","杨天惠","残句",["北郭云山接巴阆，东城雪水泻文龙。"],0,228,"宋"],["句 其三","陈郁","残句",["地旷日难晚，海宽天欲浮。"],0,172,"宋"],["句 其十八","王随","残句",["当户晓山青倚汉，傍檐风竹冷敲秋。"],0,57,"宋"],["句 其十四","晏殊","残句",["震邸陪经席，辰阶总化钧。"],0,186,"宋"],["句 其六","邵伯温","残句",["自昔充城号奥区，蜀人唤作小成都。"],0,137,"宋"],["句 其五","卢襄","残句",["红芭蕉映黑牵牛。"],0,217,"宋"],["句 其七","邵伯温","残句",["今日行人去果州，倾城出送旧遨头。"],0,137,"宋"],["句 其八十八","释惠崇","残句",["来时云拥衲，别夜月随筇。"],0,69,"宋"],["句 其十一","陈尧佐","残句",["争似碧澜堂上望，疏疏烟树漠汀洲。"],0,103,"宋"],["句  其五","杨炎正","残句",["渔人四五家。"],0,12,"宋"],["句  其三","刘昌诗","残句",["野径萦回路百盘。"],0,38,"宋"],["句","刘公弼","残句",["滩声来席上，亭影落溪中。"],{"yz":["刘公弼"]},110,"宋"],["句 其四","武允蹈","残句",["午簟展风供睡课，夜窗扃雨办诗逋。"],0,148,"宋"],["句  其九","黄庭坚","残句",["语妙何妨石作肠。"],0,"x66","宋"],["句 其二","缪鉴","残句",["门当车马道，帘隔利名尘。"],0,134,"宋"],["句 其一","姚辟","残句",["京洛黄尘久倦游，一官来寄海边州。"],0,235,"宋"],["句 其二十","高似孙","残句",["相次西风吹蟹老，眼前且作鲙残图。"],0,181,"宋"],["句 其一","陈恬","残句",["嵩阳读水经。"],0,18,"宋"],["句 其三","梁周翰","残句",["宿雨一番蔬甲拆，春山几处茗旗香。"],0,7,"宋"],["句 其三十一","刘筠","残句",["惠和官尚小，师达禄须干。"],0,152,"宋"],["句 其四","葛天民","残句",["冰霜过了翩然去。"],0,31,"宋"],["句 其五","宋庠","残句",["花寒阴鹤警，霜草腐萤疏。"],0,"x167","宋"],["句 其四","释惟凤","残句",["众星随手举，万物应心平。"],0,39,"宋"],["句 其三","吕本中","残句",["山中露冷草木瘦，江上月寒蒲柳秋。"],0,"x83","宋"],["句 其四","龚况","残句",["得句怕难续，避人长转多。"],0,13,"宋"],["句 其一","夏倪","残句",["蚁浮金椀浊，妓压画船低。"],0,232,"宋"],["句 其二","夏倪","残句",["犹喜平生蟹螯手，尚能半幅写行书。"],0,232,"宋"],["句 其十四","王琪","残句",["山花冷隔何堪折，一曲红梅字字香。"],0,242,"宋"],["句 其四十二","高似孙","残句",["未教剪初韭，全如持左螯。"],0,181,"宋"],["句 其二","陈恬","残句",["雪里消磨一半春。"],0,18,"宋"],["句 其一","吴充","残句",["南郭迎天使，东郊诏隐人。"],0,5,"宋"],["句  其一○七","释晓莹","残句",["随宜领览到斜晖。"],0,182,"宋"],["句  其五九","徐俯","残句",["露重冰清风日暖。"],0,156,"宋"],["句  其三","吴幵","残句",["鸟声催暮急，山气欲晴寒。"],0,98,"宋"],["句","王璜","残句",["村近莫愁连竹坞，人歌楚些下苹洲。"],0,218,"宋"],["句 其一","米芾","残句",["清明去郡则得郡，安用作业解洗业。"],0,245,"宋"],["句 其四","汪藻","残句",["路行归雁不到处，家在长江欲尽头。"],0,198,"宋"],["句 其三十五","张舜民","残句",["午食易愁藜藿粥，夜堂无睡数灯花。"],0,209,"宋"],["句 其六","杜耒","残句",["酿雪不成微有雨，被风吹散却为晴。"],0,55,"宋"],["句","释圆悟","残句",["独怜万木凋零后，屹立风霜惨澹中。"],0,142,"宋"],["句","潘阆","残句",["土床安睡稳，纸被转身鸣。"],0,124,"宋"],["句 其五","武允蹈","残句",["眼昏书字不著纸，耳重听言常问人。"],0,148,"宋"],["句 其八","宋白","残句",["最念春风尝酒处，梅酸笋翠后溪头。"],0,187,"宋"],["句","林宋伟","残句",["韩非老子俱同传，乞与时人子细看。"],0,232,"宋"],["句","李咨","残句",["空令抱恨归黄壤，不见崇山谪去时。"],0,198,"宋"],["句 其六十五","释惠崇","残句",["坐石云生袖，添泉月入瓶。"],0,69,"宋"],["句 其三","曾致尧","残句",["更无尘土当轩起，只有松萝绕槛生。"],0,53,"宋"],["句 其二十","冯坦","残句",["问天底是资身策，度日应收卖卜钱。"],0,149,"宋"],["句  其七","杜耒","残句",["行穷十里岭。"],0,55,"宋"],null,["句 其十五","王随","残句",["满窗寒影云生岳，一枕秋声雨滴阶。"],0,57,"宋"],["句  其三","叶适","残句",["初分大道非常道，才有先天未后天。"],0,"x197","宋"],["句 其四十七","张舜民","残句",["晚风亦自知人意，时去时来管送香。"],0,209,"宋"],["句 其二","孟大武","残句",["扫地石盆冷，闭门春昼长。"],0,74,"宋"],["句 其五","胡铨","残句",["两山排闼来，周遭似环翠。"],0,241,"宋"],["句 其六","卢襄","残句",["茧足相从南极边，真机不落野狐涎。"],0,217,"宋"],["句","赵不息","残句",["鲁国笔端昭日月，次山书法得春秋。"],0,200,"宋"],["句 其二","郑域","残句",["槟榔共聘币。"],0,89,"宋"],["句 其四十九","高似孙","残句",["斫雪蝤蛑鲙，生香茉莉杯。"],0,181,"宋"],["句  其一○","杨蟠","残句",["花湿转分明。"],0,62,"宋"],["句","林灵素","残句",["政和丁酉西风秋，天子赐以骑青牛。"],0,59,"宋"],["句 其二","孙觉","残句",["儿童窃食不知禁，格磔山禽满院飞。"],0,41,"宋"],["句 其一","张瑰","残句",["洲围淮口江形狭，亭上石头月色多。"],0,137,"宋"],["句 其二","赵汝愚","残句",["寒雪冥蒙外，山云显晦中。"],0,13,"宋"],["句","范纯粹","残句",["惯处贱贫知世态，饱谙迁谪见家风。"],0,41,"宋"],["句","张公裕","残句",["马谙旧路行来滑，琴遇知音尚不弹。"],0,65,"宋"],["句","魏兼","残句",["茗泛绿云收北苑，稻炊红玉取西山。"],0,183,"宋"],["句  其五","王子俊","残句",["病客欲眠浑不寐。"],0,228,"宋"],["句 其五","李壁","残句",["平生阅世朦胧眼，偏向白鸥飞处明。"],0,80,"宋"],["句 其十六","释惠崇","残句",["露下牛羊静，河明桑柘空。"],0,69,"宋"],["句  其二○","王安中","残句",["玉颜知复为谁容。"],0,52,"宋"],null,["句 其五","张仲节","残句",["不知去年征战时，妾家良人在还没。"],0,210,"宋"],["句","释惠觉","残句",["澜深鱼自跃，风暖客还来。"],0,162,"宋"],["句 其五","杨长孺","残句",["灵均九畹应无此，福地三茅浪自夸。"],0,170,"宋"],["句 其二","刘洞","残句",["翻忆潘郎章奏内，阴阴日暮好沾巾。"],0,235