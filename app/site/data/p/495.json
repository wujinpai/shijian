[["郊庙歌辞 祭方丘乐章 顺和","佚名","四言",["乐备金石，礼光尊俎。","大享爰终，洪休是举。","雨零感节，云飞应序。","缨绂载辞，皇灵具举。"],0,"x14","唐"],null,null,["杂言和常州李员外副使春日戏题十首 其九","权德舆","四言",["闲庭无事，独步春辉。","韶光满目，落蘂盈衣。","芳树交柯，文禽并飞。","婉彼君子，怅然有违。","对酒不饮，横琴不挥。","不挥者何，知音诚稀。"],0,"x11","唐"],["唐享昊天乐 第六","武则天","四言",["昭昭上帝，穆穆下临。","礼崇备物，乐奏锵金。","兰羞委荐，桂醑盈斟。","敢希明德，幸罄庄心。"],0,96,"唐"],["郊庙歌辞 享太庙乐章 文明舞","郑余庆","四言",["开邸除暴，时迈勋尊。","三元告命，四极骏奔。","金枝翠叶，辉烛瑶琨。","象德亿载，贻庆汤孙。"],0,184,"唐"],["题县令范传真化洽亭","沈颜","四言",["前有浅山，屹然如屏。","后有卑岭，缭然如城。","跨池左右，足以建亭。","斯亭何名，化洽而成。"],0,11,"唐"],["唐享昊天乐 第七","武则天","四言",["尊浮九酝，礼备三周。","陈诚菲奠，契福神猷。"],0,96,"唐"],null,["郊庙歌辞 祀九宫贵神乐章 肃和","佚名","四言",["歌工既奏，神位既秩。","天符众星，运行太一。","声和十管，气应中律。","肃肃明廷，介兹元吉。"],0,"x14","唐"],["郊庙歌辞 祀九宫贵神乐章 肃和","佚名","四言",["精意严恭，明祠丰洁。","献酬既备，俎豆斯撤。","日丽天仪，风和乐节。","事光祀典，福覃有截。"],0,"x14","唐"],["郊庙歌辞 德明兴圣庙乐章 亚献终献","李纾","四言",["惟清惟肃，靡闻靡见。","举备九成，俛终三献。","庆彰曼寿，胙撤嘉荐。","瘗玉埋牲，礼神斯徧。"],0,255,"唐"],null,null,["郊庙歌辞 仪坤庙乐章 雍和","郑善玉","四言",["酌郁既灌，芗萧方𦶟。","笾豆静器，簠簋芬𫗣。","鱼腊荐美，牲牷表洁。","是戢是将，载迎载列。"],0,1,"唐"],["仪坤庙乐章","丘悦","四言",["孝哉我后，冲乎廻圣。","道映重华，德辉文命。","慕深视箧，情殷抚镜。","万国移命，兆人承庆。"],0,217,"唐"],["郊庙歌辞 祀圜丘乐章 肃和","褚亮","四言",["闿阳播气，甄曜垂明。","有赫圜宰，深仁曲成。","日丽苍璧，烟开紫营。","聿遵干享，式降鸿祯。"],0,150,"唐"],null,null,["郊庙歌辞 享太庙乐章 宣宗室舞","夏侯孜","四言",["于铄令主，圣祚重昌。","兴起教义，申明典章。","俗尚素朴，人皆乐康。","积德可报，流庆无疆。"],0,23,"唐"],null,["郊庙歌辞 祭神州乐章 肃和","褚亮","四言",["大矣坤仪，至哉神县。","包含日域，牢笼月竁。","露絜三清，风调六变。","皇祇介祉，式歆恭荐。"],0,150,"唐"],null,["郊庙歌辞 祭汾阴乐章 肃和","崔玄童","四言",["聿修严配，展事禋宗。","祥符宝鼎，礼备黄琮。","[祝]词以信，明德惟聪。","介兹景福，永永无穷。"],0,222,"唐"],null,null,["郊庙歌辞 夕月乐章 雍和","佚名","四言",["朏晨争举，天宗礼辟。","夜典凉秋，阴明湛夕。","有𨠨斯旨，有牲斯硕。","穆穆其晖，穰穰是积。"],0,"x14","唐"],null,["郊庙歌辞 释奠武成王乐章 亚献终献","于邵","四言",["贰觞以献，三变其终。","顾此非馨，尚达斯衷。","茅缩可致，神歆载融。","始神翊周，拯溺除凶。","时维降祐，永绝兴戎。"],0,121,"唐"],null,["郊庙歌辞 五郊乐章 黄帝宫音 雍和","魏征","四言",["金县夕肆，玉俎朝陈。","飨荐黄道，芬流紫宸。","迺诚迺敬，载享载禋。","崇荐斯在，惟皇是宾。"],0,152,"唐"],["郊庙歌辞 梁太庙乐舞辞 撤豆","佚名","四言",["笙镛洋洋，庭燎煌煌。","明星有烂，祝史下堂。","[笾]豆斯撤，礼容有章。","克勤克俭，无怠无荒。"],0,"x14","唐"],null,null,["郊庙歌辞 释奠武成王乐章 迎神","于邵","四言",["卜畋不从，兆发非熊。","乃倾荒政，爰佐一戎。","盛烈载垂，命祀惟崇。","日练上戊，宿严閟宫。","迎奏嘉至，感而遂通。"],0,121,"唐"],["三月三日宴王明府山亭","高瑾","四言",["暮春元巳，春服初裁。","童冠八九，于洛之隈。","河堤草变，巩树花开。","逸人谈发，仙御舟来。","间关黄鸟，瀺灂丹腮。","乐饮命席，优哉悠哉。"],0,72,"唐"],null,null,["郊庙歌辞 祀九宫贵神乐章 豫和 一","佚名","四言",["于昭上穹，临下有光。","羽翼五佐，周流八荒。","谁其飨之，时文对敭。","虞经夏典，兹礼未遑。"],0,"x14","唐"],["郊庙歌辞 后唐宗庙乐舞辞 雍熙舞","卢文纪","四言",["仁君御宇，环海谧清。","运符武德，道协文明。","九成式敍，百度惟成。","金门积庆，玉叶传荣。"],0,219,"唐"],["恺悌诗（幷序） 慎独二章（一章十句，一章八句）（慎独，闭邪存其诚也。） 二","孙宗闵","四言",["仲舒格言，许绪深旨。","灵怀发中，神资素履。","吻契洵猷，践扬前轨。","蔼蔼令名，烂光青史。"],0,137,"唐"],["郊庙歌辞 享太庙乐章 太和舞","佚名","四言",["广乐既备，嘉荐既新。","述先惟德，孝飨惟亲。","七献具举，五齐毕陈。","锡兹祚福，于万斯春。"],0,"x14","唐"],["恺悌诗（幷序） 慎独二章（一章十句，一章八句）（慎独，闭邪存其诚也。） 一","孙宗闵","四言",["恐惧不覩，诫慎不闻。","我公慎独，于斯洞分。","微既莫显，隐何可云？","温树奚问，谏草自焚。","克谨天戒，允符帝文。"],0,137,"唐"],["郊庙歌辞 善胜舞 肃顺","佚名","四言",["乐奏四顺，福受万年。","神归碧天，庭余瑞烟。"],0,"x14","唐"],["郊庙歌辞 周朝飨乐章 福顺","佚名","四言",["圣皇端拱，多士输忠。","蛮觞共献，臣心毕同。","声齐嵩岳，祝比华封。","千龄万祀，常保时雍。"],0,"x14","唐"],["郊庙歌辞 祀九宫贵神乐章 太和","佚名","四言",["帝在灵坛，大明登光。","天回云粹，穆穆皇皇。","金奏九夏，圭陈八芗。","旷哉动植，如熙春阳。"],0,"x14","唐"],["郊庙歌辞 太清宫乐章 真和","佚名","四言",["玉磬含香，金炉既馥。","风驭泠泠，云坛肃肃。","杳归大象，霈流嘉福。","俾宁万邦，无思不服。"],0,"x14","唐"],null,["郊庙歌辞 晋朝飨乐章 举酒","佚名","四言",["大明御宇，至德动天。","君臣庆会，礼乐昭宣。","劒佩成列，金石在县。","椒觞再献，宝历万年。"],0,"x14","唐"],["郊庙歌辞 郊天旧乐章 豫和","佚名","四言",["苹蘩礼著，黍稷诚微。","音盈凤管，彩驻龙旗。","洪歆式就，介福攸归。","送乐有阕，灵驭遄飞。"],0,"x14","唐"],null,["游长安诸寺联句 常乐坊赵景公寺 题约公院","段成式","四言",["印火荧荧，灯续燄青。","七俱胝咒，四阿含经。","各录佳语，聊事素屏。","丈室安居，延宾不扃。"],0,113,"唐"],["郊庙歌辞 享文敬太子庙乐章 其一 迎俎酌献","冯伉","四言",["撰日瞻景，诚陈乐张。","礼容秩秩，羽舞煌煌。","肃将涤濯，祗荐芬芳。","永锡繁祉，思深飨尝。"],0,149,"唐"],null,["郊庙歌辞 昭德皇后庙乐章 寿和","佚名","四言",["工祝致告，徽音不遐。","酒醴咸旨，馨香具嘉。","受厘献祉，永庆邦家。"],0,"x14","唐"],null,null,["郊庙歌辞 周宗庙乐舞辞 肃雍舞","佚名","四言",["周道载兴，象日之明。","万邦咸庆，百谷用成。","於穆圣祖，祗荐鸿名。","祀于庙社，陈其牺牲。","进旅退旅，皇武之形。","一倡三叹，朱弦之声。","以妥以侑，既和且平。","至诚潜达，介福攸宁。"],0,"x14","唐"],null,null,["让皇帝庙乐章 亚献终献","李纾","四言",["秩礼有序，和音既同。","九仪不忒，三揖将终。","孝感藩后，相维辟公。","四时之典，永永无穷。"],0,255,"唐"],["郊庙歌辞 祀雨师乐章 奠币登歌","包佶","四言",["岁正朱明，礼布元制。","惟乐能感，与神合契。","阴雾离翍，灵驭摇裔。","膏泽之庆，期于稔岁。"],0,30,"唐"],null,["郊庙歌辞 享太庙乐章 大成舞","魏征","四言",["周穆王季，晋美帝文。","明明盛德，穆穆齐芬。","藏用四履，屈道参分。","铿锵钟石，载纪鸿勋。"],0,152,"唐"],["浮云三章 一","皎然","四言",["浮云浮云，集于扶桑。","扶桑茫茫，日暮之光。","匪日之暮，浮云之污。","嗟我怀人，忧心如蠹。"],0,"x22","唐"],["浮云三章 二","皎然","四言",["浮云浮云，集于咸池。","咸池微微，日昃之时。","匪日之昃，浮云之惑。","嗟我怀人，忧心如织。"],0,"x22","唐"],["浮云三章 三","皎然","四言",["浮云浮云，集于高舂。","高舂蒙蒙，日夕之容。","匪日之夕，浮云之积。","嗟我怀人，忧心如[惄]。"],0,"x22","唐"],null,null,["延英殿玉灵芝诗三章章八句 三","肃宗皇帝","四言",["幸生芳本，当我扆旒。","效此灵质，贲其王猷。","神惟不爱，道亦无求。","端拱思惟，永荷天休。"],0,92,"唐"],["郊庙歌辞 梁太庙乐舞辞 帝盥","佚名","四言",["庄肃莅事，周旋礼容。","裸鬯严洁，穆穆雍雍。"],0,"x14","唐"],["郊庙歌辞 汉宗庙乐舞辞 积善舞","张昭","四言",["黍稷斯馨，祖德惟明。","蛇告赤帝，龟谋大横。","云行雨施，天成地平。","造我家邦，斡我璇衡。","陶匏在御，醍盎惟精。","或戛或击，载炮载烹。","饮福受胙，舞降歌迎。","滔滔不竭，洪惟水行。"],0,230,"唐"],["郊庙歌辞 释奠武成王乐章 送神","于邵","四言",["明祀方终，备乐斯阕。","黝𫄸就瘗，豆笾告撤。","肸蚃尚余，光景云灭。","返归虚极，神心则悦。"],0,121,"唐"],["郊庙歌辞 晋朝飨乐章 再举酒","佚名","四言",["朝野无事，寰瀛大康。","圣人有作，盛礼重光。","万国执玉，千官奉觞。","南山永固，地久天长。"],0,"x14","唐"],["郊庙歌辞 周宗庙乐舞辞 明德舞","佚名","四言",["惟彼岐阳，德大流光。","载造周室，泽及遐荒。","于铄圣祖，上帝是皇。","迺圣迺神，知微知彰。","新庙奕奕，丰年穰穰。","取彼血膋，以往蒸尝。","黍稷惟馨，笾豆大房。","工祝致告，受福无疆。"],0,"x14","唐"],["延英殿玉灵芝诗三章章八句 二","肃宗皇帝","四言",["元气产芝，明神合德。","紫微间采，白蕣呈色。","载启瑞图，庶符皇极。","天心有眷，王道惟直。"],0,92,"唐"],["郊庙歌辞 享节愍太子庙乐章 迎神","佚名","四言",["储后望崇，元良寄切。","寝门是仰，驰道不绝。","仙袂云会，灵旗电晰。","煌煌而来，礼物攸设。"],0,"x14","唐"],["郊庙歌辞 享太庙乐章 大基舞","魏征、褚亮","四言",["猗与祖业，皇矣帝先。","翦商德厚，封唐庆延。","在姬犹稷，方晋喻宣。","基我鼎运，于万斯年。"],0,223,"唐"],null,["郊庙歌辞 武后明堂乐章 商音","武则天","四言",["律中夷则，序应收成。","功宣建武，义表惟明。","爰申礼奠，庶展翘诚。","九秋是式，百谷斯盈。"],0,96,"唐"],["郊庙歌辞 享太庙乐章 大明舞","魏征、褚亮","四言",["五纪更运，三正递升。","勋华既没，禹汤勃兴。","神武命代，灵睠是膺。","望云彰德，察纬告征。","上纽天维，下安地轴。","征师涿野，万国咸服。","偃伯灵台，九官允穆。","殊域委賮，怀生介福。","大礼既饰，大乐已和。","黑章扰囿，赤字浮河。","功宣载籍，德被咏歌。","克昌厥后，百禄是荷。"],0,223,"唐"],["郊庙歌辞 祀九宫贵神乐章 福和","佚名","四言",["祀既云毕，明灵告旋。","礼洽和应，神歆福延。","动植咸若，阴阳不愆。","锡兹纯嘏，天子万年。"],0,"x14","唐"],["唐享昊天乐 第五","武则天","四言",["朝坛雾卷，曙岭烟沈。","爰设筐币，式表诚心。","筵辉丽璧，乐畅和音。","仰惟灵鉴，俯察翘襟。"],0,96,"唐"],["三月三日宴王明府山亭","韩仲宣","四言",["河滨上巳，洛汭春华。","碧池涵日，翠斝澄霞。","沟垂细柳，岸拥平沙。","歌莺响树，舞蝶惊花。","云浮宝马，水韵香车。","熟记行乐，淹留景斜。"],0,141,"唐"],null,["郊庙歌辞 享太庙乐章 长发舞","魏征、褚亮","四言",["睿哲维唐，长发其祥。","帝命斯祐，王业克昌。","配天载德，就日重光。","本支百代，申锡无疆。"],0,223,"唐"],["郊庙歌辞·后唐宗庙乐舞辞·昭德舞","崔居俭、卢文纪","四言",["懿彼明德，赫赫煌煌。","名高阃域，功著旗常。","道符休泰，运叶祺祥。","庆传万祀，以播耿光。"],0,101,"唐"],null,["延英殿玉灵芝诗三章章八句 一","肃宗皇帝","四言",["玉殿肃肃，灵芝煌煌。","重英发秀，连叶分房。","宗庙之福，垂其耿光。"],0,92,"唐"],["郊庙歌辞 祀九宫贵神乐章 豫和","佚名","四言",["享申百礼，庆洽百灵。","上排阊阖，洞入杳冥。","奠玉高坛，燔柴广庭。","神之降福，万国咸宁。"],0,"x14","唐"],["补茅鸱 一","丘光庭","四言",["茅鸱茅鸱，无集我冈。","汝食汝饱，莫我为祥。","愿弹去汝，来彼凤凰。","来彼凤凰，其仪有章。"],0,28,"唐"],["唐德明兴圣庙乐章 兴圣酌献","李纾","四言",["閟宫静谧，合乐周张。","泰尊始献，百末重觞。","震澹存诚，庶几迪尝。","遥源之祚，天汉灵长。"],0,255,"唐"],["郊庙歌辞 襃德庙乐章 襃德","佚名","四言",["家著累仁，门昭积善。","瑶篚既列，金县式展。"],0,"x14","唐"],["郊庙歌辞 祀风师乐章 奠币登歌","包佶","四言",["旨酒告絜，青苹应候。","礼陈瑶币，乐献金奏。","弹弦自昔，解冻惟旧。","仰瞻肸蚃，群祥来凑。"],0,30,"唐"],["郊庙歌辞 祀九宫贵神乐章 寿和","佚名","四言",["时文哲后，肃事严禋。","馨我明德，享于贵神。","大庖载盈，旨酒斯醇。","精意所属，期于利人。"],0,"x14","唐"],["郊庙歌辞 周宗庙乐舞辞 治顺","佚名","四言",["清庙将入，衮服是依。","载行载止，令行令仪。","永终就养，空极孝思。","瞻望如在，顾复长违。"],0,"x14","唐"],["题雷琴（二首） 一","宋之问","四言",["山虚水深，万籁萧萧。","古无人踪，惟石嶕峣。"],0,158,"唐"],["三月三日宴王明府山亭","席元明","四言",["日惟上巳，时亨有巢。","中尊引桂，芳筵籍茅。","书僮橐笔，膳夫行炰。","烟霏万雉，花明四郊。","沼苹白带，山花紫苞。","同人聚饮，千载神交。"],0,141,"唐"],["郊庙歌辞 享太庙乐章 大成舞","魏征、褚亮","四言",["周称王季，晋美帝文。","明明盛德，穆穆齐芬。","藏用四履，屈道三分。","铿锵钟石，载纪鸿勋。"],0,223,"唐"],["赠毛仙翁","郑澣","四言",["至道无名，至人长生。","爰观绘事，以挹真形。","方口渥丹，浓眉刷青。","松姿本秀，鹤质自轻。","道德神仙，内蕴心灵。","红肌丝发，外彰华精。","色如含芳，貌若和光。","胚浑造化，含吐阴阳。","吾闻安期，隐见不常。","或在世间，或游上苍。","猗欤真人，得非后身。","写此仙骨，久而不磷。","皎皎明眸，了然如新。","蔼蔼童颜，的然如春。","金石可并，丹青不冺。","通天台上，有见常人。","俗士观瞻，方悟幽尘。","君子图之，敬兮如神。"],0,90,"唐"]]