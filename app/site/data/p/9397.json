[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["箫谱　拟霓裳羽衣曲","伍瑞隆","杂言",["玉城峨峨，白云匝银河。","将子浩歌桂之殿，秋风夜多。","我乘皓鸾，逍遥万里。","下视九州，清虚无际。","露泠泠，仙桂。","长桥玉偃桂之殿，清飘飘秋云夜卷。","如此粲者何，其室则迩，其人甚远。","桂枝长，飘飖夜有光、袅袅花前双凤皇，色如冰雪声如簧。","赠子芳华，揽子衣裳。","飞飞双鬟，于桂之间，银光清泠飘玉山。","桂之殿，其声珊珊。","欲来不来，双鸾笑复回。","东望玉楼，西望瑶台。","桂之殿，灵花夜开。","玉殿无纤尘，洵清且芬。","谁是飞琼，谁是云林，笑语迢迢人不闻。","翠光莹莹射金阙，珠幕银帘冻欲裂，欲往从之历霜雪。","桂之殿，洵清且漠。","玉蟾蜍何在，清泠泠飘飖天际。","将子袪兮云之隈，千秋万岁兮吾复来。"],0,"x376","明"],null,null,null,["明月斜 闺情","梁清标","杂言",["漏三更，香一缕。","妾梦长随岭上云，郎停锦缆何州雨。","灯半昏，寒犹峭。","绣被浓薰百和匀，春纤冷拨幺弦小。"],0,"x400","清"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["画扇二首","董纪","杂言",["世态有古今，江山本无异。","相逢俱隐沦，所问知何事。","轧鸦渡江船，㾕?临关马。","萧寺罢晨钟，残雪尚飘洒。"],0,"x377","明"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["转应曲 春雨","尤侗","杂言",["春雨，春雨。","花上泪痕几许。","东风吹到纱窗。","日日愁来断肠。","肠断，肠断。","又续新愁一半。","秋雨，秋雨。","滴碎琼宫霓羽。","清歌妙舞阑珊。","阵阵霜风夜寒。","寒夜，寒夜。","寄语嫦娥睡罢。"],0,"x402","清"],null,["怨东风 客思","尤侗","杂言",["蒲叶端阳寓。","又看银河渡。","江山何事苦留人，住。","住。","住。","破屋颓垣，古槐荒草，满庭秋雨。","泥滑长安路。","马首无停处。","一鞭落日又西风，去。","去。","去。","茅店孤灯，故乡回首，梦中云树。","秋暑蝇成阵。","西日长如闰。","无聊所事不宜人，闷。","闷。","闷。","薄酒初醒，孤灯半灭，残书独枕。","愁缕萦方寸。","华发添双鬓。","无端读史更悲歌，恨。","恨。","恨。","剑废荆轲，骓忘项羽，弓藏韩信。"],0,"x402","清"]]