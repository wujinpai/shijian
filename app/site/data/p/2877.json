[["皇雅十首  其一六","尹洙","四言",["冀州之疆，粤惟大卤。","俗忮而专，地扼而固。","协比幽都，荡摇边圉。","三垂既夷，凶威弗沮。","帝御六师，百万貔虎。","剪其附庸，至于城下。","锋镝始交，梯冲如舞。","蠢尔孱王，请附降虏。","我士奋扬，愿究吾武。","皇帝曰吁，念彼黎庶。","匪鲸匪鲵，复为王土。"],0,108,"宋"],["名实吟","邵雍","四言",["内无是实，外有是名，小人故矜。","外无是名，内有是实，君子何失。"],0,"x57","宋"],["颂古一百二十一首 其一○○","释宗杲","四言",["十字街头，现成行货。","拟欲商量，漆桶蹉过。"],0,"x112","宋"],["颜乐亭诗，并叙","苏轼","四言",["天生蒸民，为之鼻口。","美者可嚼，芬者可嗅。","美必有恶，芬必有臭。","我无天游，六凿交斗。","骛而不返，跬步商受。","伟哉先师，安此微陋。","孟贲股栗，虎豹却走。","眇然其身，中亦何有。","我求至乐，千载无偶。","执瓢从之，忽焉在后。"],0,"x67","宋"],["大易吟","邵雍","四言",["天地定位，否泰反类。","山泽通气，损咸见义。","雷风相薄，恒益起意。","水火相射，既济未济。","四象相交，成十六事。","八卦相荡，为六十四。"],0,"x57","宋"],["文宣王及其弟子赞 其四","赵构","四言",["懿德贤行，有一则尊。","子也履之，成性存存。","骍角有用，犁牛莫论。","刑政之言，惠施元元。"],0,249,"宋"],["文宣王及其弟子赞 其七","赵构","四言",["道义正己，文学擅科。","为宰武城，联以弦歌。","割鸡之试，牛刀谓何。","前言戏尔，博约则多。"],0,249,"宋"],["皇雅十首  其二五","尹洙","四言",["皇曰有众，予实念兹。","战无必胜，矧其归师。","借曰大获，畴能尽之。","益俾余丑，毒吾朔陲。","乃愈其盟，北州以绥。"],0,108,"宋"],["皇雅十首  其一八","尹洙","四言",["帝籍于郊，典仪具陈。","务农以训，供祀以勤。","祀在于诚，匪勤于人。","训农以实，匪训以文。","帝谨二物，乃躬乃亲。","公侯卿士，暨厥庶民。","千甸有制，饬哉惟寅。"],0,108,"宋"],["偈颂一百六十首 其八","释宗杲","四言",["文彩未彰，消息已露。","文彩既彰，难为盖覆。"],0,"x112","宋"],["观音真赞 其四","释慧空","四言",["一香一华，惟称惟赞。","潮落海门，风生彼岸。"],0,"x118","宋"],["文宣王及其弟子赞 其五","赵构","四言",["德以充性，行以澡身。","二事在躬，日跻而新。","并驱贤科，得颜与邻。","不幸斯疾，命也莫伸。"],0,249,"宋"],["种药苗二首 种甖粟 其一","苏辙","四言",["筑室城西，中有图书。","窗户之余，松竹扶疏。","拔棘开畦，以毓嘉蔬。","畦夫告予，甖粟可储。"],0,"x135","宋"],["文宣王及其弟子赞 其一","赵构","四言",["大哉圣宣，斯文在兹。","帝王之式，古今之师。","志则春秋，道由忠恕。","贤于尧舜，日月其誉。","维时载雍，戢此武功。","肃昭盛仪，海㝢聿崇。"],0,249,"宋"],["人情吟","邵雍","四言",["人达人情，无寡无广。","天下之事，如指诸掌。"],0,"x57","宋"],["四偈 其二","惠洪","四言",["见胜进者，心生嫉妒。","以苾刍相，包蛇虺怒。","不敢以身，而先天下。","三人同行，必有师者。","孔老之圣，行已如此。","奈何怀瞋，而称释子。","子以缘差，我故痛告。","尽世间心，乃可学道。"],0,"x42","宋"],["安乐泉颂","黄庭坚","四言",["姚子雪曲，杯色争玉。","得汤郁郁，白云生谷。","清而不薄，厚而不浊。","甘而不哕，辛而不螫。","老夫手风，须此晨药。","眼花作颂，颠倒淡墨。"],0,"x66","宋"],["冽井  其一","王柏","四言",["冽彼井泉，莲华斯名。","有美一人，于焉载沈。","夫也不二，昊天曰明。","父之我爱，曷慰我心。"],0,"x137","宋"],["颂古一百二十一首 其三十","释宗杲","四言",["一正一邪，一倒一起。","文选赵州，靴里动指。"],0,"x112","宋"],["庶几吟","邵雍","四言",["以圣责人，固未完备。","以人望人，自有馀地。","责人无难，受责非易。","其殆庶几，犹望颜子。"],0,"x57","宋"],["偈颂一百四十二首 其一○一","释广闻","四言",["六年冷坐，九年面壁。","碓捣东南，磨推西北。"],0,10,"宋"],["空生真赞","惠洪","四言",["以空寂身，无所倚依。","而捉杖藜，以灵知心。","不在散摄，而玩贝叶。","不舍声色，而证真空。","与我日用，能所心同。","于一切处，寂入法海。","如风行空，无所妨碍。","但离二执，圆成普会。","当慎以修，入此三昧。"],0,"x42","宋"],["性情吟","邵雍","四言",["践形治性，践迹治情。","贤人践迹，圣人践形。"],0,"x57","宋"],["冽井  其四","王柏","四言",["有冽彼泉，在弦歌内。","所谓伊人，之死靡悔。","人孰不死，我无昧昧。","是心之存，炯千万载。"],0,"x137","宋"],["自作真赞","刘一止","四言",["枯木寒岩，形影相依。","禄食而臞，孰与遁肥。","四十九年，我知其非。","已往不谏，来者庶几。"],0,239,"宋"],["偈颂五十一首 其十","释道冲","四言",["摩竭提国，亲行此令。","尽大地人，丧身失命。"],0,206,"宋"],["挽何无适","王柏","四言",["二五之英，清通莹彻。","有钟于躬，非贤则哲。","乌乎无适，自幼卓绝。","奴仆选骚，铨衡庄列。","鞭霆走电，不可追𥬞。","一操而存，肃整辔辙。","著书未就，不幸短折。","既赋以奇，未易泯灭。","世外精神，笔头风月。","有阅斯立，有妥斯魄。","既妥尔魄，既筑尔阡。","是曰反终，是曰归全。","人生斯世，岂必百年。","欲动情胜，万事出焉。","孰好孰恶，孰媸孰妍。","孰过而改，孰善而迁。","一征物表，浩浩其天。","风定水止，月印万川。","阴阳不独，动静不偏。","既静复动，太极烱然。"],0,"x137","宋"],["和陶劝农六首，并引 其五","苏轼","四言",["天下假易，亦不汝匮。","春无遗勤，秋有厚冀。","云举雨决，妇姑毕至。","我良孝爱，袒跣何愧。"],0,"x67","宋"],["送傅倅","傅察","四言",["洺之水兮，其流舒舒。","公之来兮，朱服熊车。","士元展骥，仲举题舆。","公之来兮，民斯乐胥。","洺之水兮，其流洋洋。","公之化兮，春雨秋阳。","裤襦颂洽，禾黍岁穰。","公之化兮，民斯悦康。","洺之水兮，其流弥弥。","公之去兮，旌旗旖旎。","父老攀辕，缙绅方轨。","公之去兮，瞻望徙倚。","洺之水兮，其流泄泄。","公之德兮，此邦所愒。","吏遵其画，人怀其惠。","公之德兮，久而勿替。","洺之水兮，其流活活。","公之名兮，兹其弥达。","翔于朝宁，骞于省闼。","公之名兮，莫我敢遏。"],0,35,"宋"],["治乱吟五首 其四","邵雍","四言",["火能胜水，火不胜水，其火遂灭。","水能从火，水不从火，其水不热。","夫能制妻，夫不制妻，其妻遂绝。","妻能从夫，妻不从夫，其妻必孽。"],0,"x57","宋"],["性情吟","邵雍","四言",["君子任性，小人任情。","任性则近，任情则远。"],0,"x57","宋"],["日新","赵禥","四言",["大哉盘铭，日新其德。","一盟一思，惟汤是则。"],0,42,"宋"],["送裴守","徐积","四言",["维时西南，巴蜀一道。","强楚侵疆，故蜀东徼。","水激以猛，山迫而峭。","人性坚悍，地形险要。","孰往而使，孰抚而教。","惟帝难之，乃眷东顾。","曰山阳守，智足知务。","能正而和，能察而恕。","严所以立，宽所以辅。","性不狎侮，躬有法度。","是表是仪，可俾可付。","其往钦哉，所居必裕。","公拜稽首，驰传以起。","入境褰帷，登山叱驭。","设施有本，先后有序。","可者立行，不可立去。","公曰来汝，吏受约束。","天子圣人，汝勿苛酷。","民心无他，罪生不足。","穷阎荒村，颓垣破屋。","岂可罗网，更入牢狱。","公曰兵官，当去其懦。","贼侮则犯，贼畏则挫。","勉之在勤，戒之在惰。","兵要素练，慎勿安坐。","公曰县尉，县无城郭。","奸者鼠伺，狂者兽攫。","一邑性命，弓手是持。","选择补之，训练使之。","即有能者，有以劳之。","即不能者，戒之告之。","在昔汉氏，蛮多变者。","失信失恩，扰之故也。","今则不然，有以处汝。","德以服汝，威以御汝。","恩以结汝，信以固汝。","汝无自恃，皇帝神武。","凡公敕戒，吏皆奉行。","何法不恕，何刑不平。","何兵不练，何技不精。","一纲尽举，百为大成。","盗贼衰息，蛮夷信服。","四封之内，截然整肃。","小人有依，良民受福。","天子嘉之，驰传以召。","慈母喜之，载色载笑。","神亦祚之，永锡难老。"],0,"x123","宋"],["偈","富弼","四言",["执相诚非，破相亦妄。","不执不破，是名实相。"],0,44,"宋"],["文宣王及其弟子赞 其八","赵构","四言",["辩以饰诈，言以致文。","苟弗执礼，宜奠释纷。","朽木粪墙，置不足言。","言语之科，粗然有闻。"],0,249,"宋"],["五方帝 其二","郊庙朝会歌辞","四言",["太微灵德，若首五精。","本仁与益，降气施生。","纯牲有硕，旨酒斯清。","锡兹寿嘏，既寿洽平。"],0,"x207","宋"],["偈颂八十七首 其十一","释慧开","四言",["灵从何来，圣从何起。","五通六通，不是不是。","今日天宁，如何指示，齐之以礼。"],0,65,"宋"],["文宣王及其弟子赞 其三","赵构","四言",["天经地义，孝哉闵骞。","父母昆弟，莫间其言。","污君不仕，志气轩轩。","复我汶上，出处休焉。"],0,249,"宋"],["冽井  其二","王柏","四言",["冽彼井泉，莲华其号。","有美一人，于焉是蹈。","琴瑟既合，载言载笑。","父母不允，中心悼悼。"],0,"x137","宋"],["云门糊饼","释守卓","四言",["左眼半斤，右眼八两。","不问亲疏，有功者赏。"],0,42,"宋"],["文宣王及其弟子赞 其二","赵构","四言",["德行首科，显冠学徒。","不迁不贰，乐道以居。","食埃甚忠，在陋自如。","宜称贤哉，岂止不愚。"],0,249,"宋"],["五方帝 其十四","郊庙朝会歌辞","四言",["太宇清明，宣以方色。","沛哉灵游，昭示幽则。","崇配尊亲，惟兹孝德。","神熙蕃丕，涵育四极。"],0,"x207","宋"],["和劝农篇","李纲","四言",["天临下土，是生烝民。","耕食凿饮，乃含其真。","淳浇朴散，巧伪相因。","谁其还之，时惟圣人。","圣人立政，爰重黍稷。","设命官司，职是播植。","春勤于耕，秋乃有穑。","储其嬴馀，荒岁足食。","瞻彼中原，祁邳平陆。","春日载阳，和风肃穆。","夫耕妇馌，俦类相逐。","少壮竭力，逸此耆宿。","岂无他图，惟兹永久。","利其耒耜，十千维耦。","带月荷锄，侵星耘亩。","崇本抑末，孰敢游手。","终年厌飧，报则不贵。","千箱万仓，以副汝冀。","为酒为醴，乐此分至。","仰奉俯畜，夫复何愧。","四体不勤，丈人所鄙。","带经而耕，岂废冠履。","我思古人，希风往轨。","躬耕南阳，无使专美。"],0,"x136","宋"],["五方帝 其七","郊庙朝会歌辞","四言",["盛德居厚，含章有融。","惟思惟信，曰黄曰中。","礼诚荐达，福祐嘉通。","永延永阜，九谷咸丰。"],0,"x207","宋"],["吏部二词帖赞","岳珂","四言",["薛在近世，意庄体葩。","仿而肖耶，偶其好耶。","笔动圣鉴，艺兼词华。","系诗而藏，维以传家。"],0,"x202","宋"],["偈十首 其六","释慧晖","四言",["一回得妙，二度忘妙。","急急归云，堆堆白云。","别增真照，殊出月照。","芬芸百花，馥郁红花。","春窗暖笑，破家好笑。"],0,194,"宋"],["影论吟","邵雍","四言",["性在体内，影在形外。","性往体随，形行影会。","体性不存，形影安在。","影外之言，曾何足怪。"],0,"x57","宋"],["赤眼禅师画像赞","惠洪","四言",["森森禅林，公特秀出。","轻世急道，不可跂及。","遗风至今，秋霜烈日。","我初瞻像，再拜稽首。","一室严冷，如虎方吼。","嗟余寡助，乃生公后。","忍视大法，陵夷末运。","奴婢小人，利欲迫窘。","冀公一咤，脑破胆陨。","呜呼公乎，再见无由。","冗攘方炽，何时云休。","愿起公死，从之以游。"],0,"x42","宋"],["园樱伤老也 其三","司马光","四言",["悠悠泛舟，载纵载横。","白日将倾，飘风载惊。","嗟我老矣，发脱齿零。","胡为百忧，劳此馀生。"],0,"x40","宋"],["钟离真人赞","陆游","四言",["五季之乱，方酣于兵。","叱嗟风云，卓乎人英。","功虽不成，气则莫夺。","煌煌金丹，秕糠陶葛。"],0,"x41","宋"],["太常乐章三十首 其六 酌献第二室奏大宁之舞曲","杨亿","四言",["文思圣祖，长发其祥。","锡羡蕃衍，德厚流光。","眷命自天，卜世聿昌。","肃祗孝享，降福无疆。"],0,"x47","宋"],["徽宗皇帝诗联扇面御书赞","岳珂","四言",["四海如春，时维帝心。","遇物而感，其传至今。","宫扇之存，有此神翰。","愿扬仁风，慰彼涂炭。"],0,"x202","宋"],["淳熙十六年皇后册宝十三首 其一","郊庙朝会歌辞","四言",["干位既正，坤斯顺承。","日丽于天，月斯溯明。","惟帝受命，惟帝并登。","黼扆尊临，典册是行。"],0,"x207","宋"],["恩怨吟","邵雍","四言",["人之常情，无重于死。","恩感人心，死犹有喜。","怨结人心，死犹未已。","恩怨之深，使人如此。"],0,"x57","宋"],["偈","释道初","四言",["鸡见便鬭，犬见便𫜪。","殿上鸱吻，终日相对。"],0,191,"宋"],["北窗伊吾 其一","赵戣","四言",["伊吾维吾，椎鲁株愚。","友资其深，片雪洪垆。"],0,237,"宋"],["神功盛德诗  其三","华镇","四言",["其畀惟何，笃生真人。","作之孔武，敏则有神。","乃圣嗣德，益之以文。","庆既令矣，克成厥勋。"],0,"x106","宋"],["由听吟","邵雍","四言",["由听而失，以听为宾。","而今而后，何复信人。"],0,"x57","宋"],["祭介石","释善珍","四言",["末俗住山，尤贵黄纸。","造物畀公，共衰病至。","既病之矣，复遇岁艰。","当八面风，撑百漏船。","漫刺衔袖，临斋乞米。","骄儿索饭，饥嗔饱喜。","我行四方，阅士如墙。","小智虚夸，妄夫荒唐。","宣绍命脉，干淳气魄。","天悭地閟，神盍宝惜。","冷灰粟焰，将晓景星。","泯灭甚易，佛法替陵。","同时爱憎，异世悲慨。","诸君不信，有遗录在。","我作苦语，模写虚空。","泪尽血续，夫岂为公。"],0,45,"宋"],["文宣王及其弟子赞 其六","赵构","四言",["循良之要，在于有政。","可使为宰，千室百乘。","师门育材，治心扶性。","退则进之，琢磨之柄。"],0,249,"宋"],["和陶答庞参军六首 其一","苏轼","四言",["我见异人，且得异书。","挟书从人，何适不娱。","罗浮之趾，卜我新居。","子非玄德，三顾我庐。"],0,"x67","宋"],["和陶答庞参军六首 其二","苏轼","四言",["旨酒荔蕉，绝甘分珍。","虽云晚接，数面自亲。","海隅一笑，岂云无人。","无酒酤我，或乞其邻。"],0,"x67","宋"],["偈颂十七首 其十一","释师范","四言",["机不离位，沉乎醉乡。","语不离窠，滞在金网。"],0,"x155","宋"],["赵氏鄮山书院诗并序","方回","四言",["国学在国，乡校在乡。","在遂曰序，在党曰庠。","虞夏殷周，厥制弥详。","家亦有塾，以修以藏。","蒙而已养，长罔不臧。","下而为士，上而侯王。","莫不有师，扶纲植常。","生人之类，赖此以生。","四海九州，以治以平。","家德户行，靡刑靡兵。","岂若后世，丧实存名。","业岂无斋，论亦有堂。","所习伊何，止于词章。","剽窃掇拾，青紫为荣。","高虚卑浅，烛理弗明。","亦儒其冠，亦公亦卿。","鄮山之塾，谁实成之。","匪有所觊，而斯营之。","一圣百贤，厥庑煌煌。","睎之则是，景行是行。"],0,"x59","宋"],["淳熙二年发太上皇帝太上皇后册宝十一首 其三 皇帝奉太上皇帝册宝授太傅用《礼安》。奉太上皇后同。","郊庙朝会歌辞","四言",["翠华之旗，灵鼍之鼓。","陈于广宇，相我盛举。","来汝公傅，肃乃仪矩。","毋愆于素，以笃多祜。"],0,"x207","宋"],["复故庐一首","周紫芝","四言",["我卜我居，于城之隅。","缭以群山，带以清渠。","日出扶桑，月翳金枢。","朝云夕烟，变灭卷舒。","乔木丰草，蔚其周庐。","群书在床，浊酒在壶。","蹒跚簪裾，亦复晏如。","淮水之游，谁脂我车。","逮其归而，四壁其徒。","柔柯既剪，稚竹日疏。","山为改容，木为槁枯。","吾亦浩然，言念归与。","今我来思，为之踌躇。","扊扅在门，鞿靮在涂。","驾言曷归，杜门寔娱。","寒止皲瘃，饥止瘠臞。","人谁不死，焉识其馀。"],0,"x139","宋"],["马别主","陈古遇","四言",["马别主兮，涕泗沾臆。","士别主兮，喜见颜色。","于嗟马兮，胡恋而驻。","于嗟士兮，胡弃而背。"],0,83,"宋"],["龙虎颂","周无所住","四言",["龙虎猖狂，心念炎烈。","慧剑才挥，二兽俱灭。"],0,69,"宋"],["偈颂一百六十首 其四十","释宗杲","四言",["法是常法，道是常道。","拶破面门，点即不到。"],0,"x112","宋"],["劝徒铭","释惟照","四言",["身心无拘，动寂无知。","如大死人，无倚无依。","无拘者宽，无知者安。","无内无外，无定无观。","无适无莫，无造无作。","无去无来，无好无恶。","一道清虚，万法如如。","愚极成智，智极成愚。","超诸数量，孰云比况。","净尽不留，无法可尚。","识不可识，智不可知。","谁家之子，兀然巍巍。","巍巍不存，根尘颖脱。","如憨如痴，落落魄魄。","不惜口业，为了说破。","笑杀阇梨，山僧罪过。"],0,48,"宋"],["五方帝 其四","郊庙朝会歌辞","四言",["惟帝乘离，司厥生殖。","感所自兴，据我炎德。","既度斯筵，乃馨斯稷。","对越居歆，介祉无极。"],0,"x207","宋"],["颂古三首 其三","释祖先","四言",["岩头一拶，虚空迸裂。","父子不传，神仙妙诀。"],0,54,"宋"],["偈十二首 其八","释文准","四言",["大道纵横，触事现成。","云开日发，水绿山青。"],0,254,"宋"],["皇雅十首  其二一","尹洙","四言",["任贤伊何，昌言是庸。","勉告尔猷，罔恤迺躬。","岂无狷辞，怫于予衷。","予不尔疵，尔无面从。"],0,108,"宋"],["五方帝 其九","郊庙朝会歌辞","四言",["玉琯均和，金风候气。","神其格思，丰粢洁币。","九谷顺成，群物茂遂。","降福无疆，德泽光被。"],0,"x207","宋"],["五方帝 其六","郊庙朝会歌辞","四言",["四序均气，五色奠方。","元标枢纽，位正中央。","至诚馨洁，率土年康。","神兮降止，鼎祚绵长。"],0,"x207","宋"],["三月十三日夜五更闻杜鹃时成父欲入浙因赋六章章四句以送之  其三","赵蕃","四言",["不如归去，春且云莫。","山中之乐，岂同岐路。"],0,"x36","宋"],["不善吟","邵雍","四言",["不良之人，禀气非正。","蛇蝎其情，豺狼其性。","至良之人，禀气清明。","金玉其性，芝兰其情。"],0,"x57","宋"],["神功盛德诗  其四","华镇","四言",["于皇武王，帝锡其猷。","克奋神武，应天之求。","维睠乃顾，申命用休。","狱讼讴歌，旁来不谋。","高视虞夏，嗣于有周。"],0,"x106","宋"],["送乔司法","徐积","四言",["乔掾循循，有如寒士。","面无浮气，能训诸理。","可养可充，曰正曰直。","其维思诚，其在不息。"],0,"x123","宋"],["引谚","苏玄朗","四言",["天地之先，无根灵草。","一意制度，产成至宝。"],{"yz":["苏玄朗"]},65,"宋"],["内外吟 其二","邵雍","四言",["衣冠不整，谓之外惰。","外义不修，谓之内惰。","内外俱惰，何人不唾。"],0,"x57","宋"],["皇雅十首  其二二","尹洙","四言",["始时从官，戎容扬扬。","今帝左右，儒冠煌煌。","朝廷以尊，文物典章。","得人之盛，奕世重光。"],0,108,"宋"],["神功盛德诗  其五","华镇","四言",["蠢尔小腆，昧天之灵。","弗念厥显，首干我经。","龙旗东指，淮海惟清。","西狩三城，泽潞以平。","皇皇天声，如雷如霆，罔不震惊。"],0,"x106","宋"],["山中放歌","释文珦","四言",["春草离离，秋兰猗猗，足纫吾衣。","南山有芝，西山有薇，足乐吾饥。","谁信谁疑，谁是谁非，足亡吾机。","或瘗或焚，或暴或沉，足为吾归。","生浮死休，已而已而，出山何为。","歌阕声消，隐几而息，梦为飞云。","遨游八极，我为云邪，云为我邪。","无待无得，窅然皆丧，自适夫道。","吾心之适，富兮贵兮，吾不与易。"],0,"x80","宋"],["云门大师","释云","四言",["中毒睦州，伸冤雪峤。","拔本无门，剜空作窍。","有折脚殃，乃破家兆。","万福曾郎，容此不肖。"],0,181,"宋"],["梦蝶居士赞二首 其一","惠洪","四言",["俯看人世，一沤起灭。","失脚来游，梦入蚁穴。","前身后身，独临两境。","左右见之，不杂其影。","眉目秀发，嫩木含春。","风度凝远，霁月洗云。","叶屋花房，玉堂金宇。","我视睨睨，渠方栩栩。"],0,"x42","宋"],["绍兴祭风师六首 其五 亚、终献。","郊庙朝会歌辞","四言",["礼有三祀，仪物视帝。","神临消摇，畴敢跛倚。","重觞载申，百味孔旨。","神兮乐康，答我以祉。"],0,"x207","宋"],["回泽老","释慧空","四言",["昔人住庵，水流菜叶。","识者非之，况纸上墨。"],0,"x118","宋"],["瓦瓢赞","惠洪","四言",["异哉此瓢，修吭矬身。","弗生爪蔓，生陶家轮。","我疑其中，藏十洲春。","昔有列仙，杂于市人。","屋檐悬之，自旦及申。","辄入其中，偃仰而卧。","而楼居者，见之胆破。","遂从之游，推挤莫可。","挽而同登，相向而坐。","如四老人，会商山果。","唯简素公，道貌天容。","岂其人欤，出处略同。","道山岿然，弱水之东。","何时来归，泠然御风。","而以此瓢，挂之瘦筇。","我作妙语，天葩粲红。"],0,"x42","宋"],["禅人写真求赞 其三十九","释正觉","四言",["渊默之得，不可文墨。","流应之功，不可形容。","秋入野水，月行霁空。","影像名字，且唤天童。"],0,"x88","宋"],["酬海宗二侍者 其一","释重显","四言",["荪之得兰，其道匪难。","扶吾病起，如珠在盘。","一兮二兮，自看谁看。"],0,"x156","宋"],["灵源清禅师赞五首 其四","惠洪","四言",["风度凝远，杳然靖深。","如春在花，如意在琴。","虽甚昭著，莫可追寻。","蹶起临济，如磁石针。"],0,"x42","宋"],["颂古十首 其八","释慧空","四言",["丈二钢钉，八尺铁橛。","插在眼中，犹自不瞥。"],0,"x118","宋"],["好胜吟","邵雍","四言",["人无好胜，事无过求。","好胜多辱，过求多忧。","忧辱并至，道德弗游。","不止人患，身亦是仇。"],0,"x57","宋"],["淳熙十六年皇后册宝十三首 其二","郊庙朝会歌辞","四言",["乃协良辰，维春之宜。","乃诏近弼，来汝相仪。","九门洞开，文物华辉。","声诗载歌，于以侑之。"],0,"x207","宋"],["颂古五首 其三","释文准","四言",["我脚驴脚，放过一著。","庞公笊篱，清平木杓。"],0,254,"宋"],["善恶吟","邵雍","四言",["人善不趋，己恶不除。","谓之知道，不亦难乎。"],0,"x57","宋"],["君子饮酒吟","邵雍","四言",["父慈子孝，兄友弟恭。","家给人足，时和岁丰。","筋骸康健，里闬乐从。","君子饮酒，其乐无穷。"],0,"x57","宋"],["偈颂一百六十首 其一五三","释宗杲","四言",["念七念七，全无消息。","背看分明，正观难识。"],0,"x112","宋"]]