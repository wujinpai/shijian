[["句","刘翼","残句",["富贵功名堪擘画，最难擘画子孙贤。"],0,77,"宋"],["句 其二","陆经","残句",["薄有田园归去好，苦无官况莫来休。"],0,209,"宋"],["句","任尽言","残句",["切勿填河汉，须留洗甲兵。"],0,189,"宋"],["句 其六","寇准","残句",["水底日为天上日。"],0,12,"宋"],["句 其八","杨亿","残句",["世人何人最得闲，司谏拂衣归华山。"],0,"x47","宋"],["句","晏几道","残句",["玉笙声里鸾空怨。"],0,110,"宋"],["句 其一","张氏","残句",["莫讶泪频滴，都缘心未灰。"],0,174,"元"],["句 其七","张耒","残句",["逢君金华宴，正味百花先。"],0,"x71","宋"],["句 其三","曾布","残句",["天际林峦压寿邱，夹江旁瞰两三州。"],0,67,"宋"],["句 其三","赵昚","残句",["富贵必从勤苦得，男儿须读五车书。"],0,40,"宋"],["句 其一","翁卷","残句",["留客看花赋诗坐。"],0,170,"宋"],["句 其十","胡仔","残句",["白发惟公道，春风不世情。"],0,228,"宋"],["句 其七","米芾","残句",["甘泉如惠泉。"],0,245,"宋"],["句 其十","林逋","残句",["印文生绿经旬合，砚匣留尘尽日封。"],0,210,"宋"],["句","蒋雍","残句",["入寺门围玉带水。"],0,204,"宋"],["句","吴臧","残句",["葛巾竹杖闲来此，可是心清迹亦清。"],0,85,"宋"],["句 其五","杨杰","残句",["山横大秀一峰高，水入平湖千里远。"],0,102,"宋"],["句 其三","丁谓","残句",["珊瑚新笔架，云母旧屏风。"],0,131,"宋"],["句  其四","吕本中","残句",["十二峰前且系船。"],0,"x83","宋"],["句 其一","魏泰","残句",["麻源山压盱江水，高楼迥对江山起。"],0,197,"宋"],["句","李鼎","残句",["南流底处所，绛帐居尊严。"],{"yz":["李鼐"]},90,"元"],["句 其六","王予可","残句",["唾尖绒舌淡红甜。"],0,182,"宋"],["句 其九","寇准","残句",["杜鹃啼处血成花，梅子黄时雨如雾。"],0,12,"宋"],["句  其二四","张釜","残句",["其如衰病只伤神。"],0,194,"宋"],["句","吴羽","残句",["滁阳自昔称名垒，旧有东园枕滁水。"],0,168,"宋"],["句","郭忠恕","残句",["为逢末劫归依佛，不就新恩叙理官。"],0,82,"宋"],["句 其十四","李清照","残句",["罗衣消尽恁时香。"],0,119,"宋"],["句 其一","马子严","残句",["章村蓬荜两三家，篱落纵横被野花。"],0,241,"宋"],["句 其八","司马光","残句",["薄梗任飘流。"],0,"x40","宋"],["句","苏迨","残句",["吾侪归卧髀骨裂，会友携壶劳行役。"],0,115,"宋"],["句 其一","周邠","残句",["小杜池边暂舣舟，老齐山下共寻幽。"],0,251,"宋"],["句","李简","残句",["山绕一城藏古寺，江连二水送孤舟。"],0,196,"宋"],["句","许翁","残句",["亭名燕喜经品题，至今增重湟川地。"],0,35,"宋"],["句 其三","程敦厚","残句",["墙头荔子已斓斑。"],0,126,"宋"],["句 其六","陈师道","残句",["日来霜露后，更觉天宇净。"],0,"x60","宋"],["句 其三","章甫","残句",["藉糟行万里，醉死甘为戮。"],0,218,"宋"],["句","曾绎","残句",["已无丑扇几边乱，空见春锄天际飞。"],0,34,"宋"],["句 其五","赵构","残句",["气回俎豆群工泰，喜入貔貅万马秋。"],0,249,"宋"],["句 其八","王予可","残句",["凤蹴瑶华散，龙衔桂子香。"],0,182,"宋"],["句","张缜","残句",["两岸更无通步路，四时常有避风船。"],0,108,"宋"],["句","汪伯彦","残句",["两两泰阶星一色，亭亭华表鹤双归。"],0,135,"宋"],["句 其五","晁说之","残句",["抚掌笑木奴，尔岂当封侯。"],0,"x64","宋"],["句  其二六","陈克","残句",["老去光阴非我春。"],0,118,"宋"