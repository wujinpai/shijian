[["万年春 赠兴国寺修塔僧","马钰","杂言",["物外高僧，澄澄湛湛真禅刹。","真禅刹。","心无察察。","理趣常搜刷。","玉性玲珑，处处皆通达。","皆通达。","无拘无辖。","垒起黄金塔。"],0,"x262","元"],["万年春 赠陈知命","马钰","杂言",["地肺陈公，白毫显出非常异。","人难比。","希夷苗裔。","肯著尘凡累。","猛舍家缘，物外搜玄理。","清心意。","自然浇溉。","太一冲和气。"],0,"x262","元"],["三光会合 继重阳韵","马钰","杂言",["乡关不住。","谨依教语。","脱身要归去。","何思何虑。","略而分诉。","任他魔阻。","丹诚显露。","真心定处。","云朋霞友聚。","修行美事，在乎勤做。","九转大功数。","无中要取。","个中敷布。","得瞻眉宇。","可登云路。","性灵昭著。","神仙自是度。"],0,"x262","元"],["上丹霄 次重阳韵","马钰","杂言",["遇风仙，心开悟，骋颠狂。","黜妻屏子便迎祥。","逍遥坦荡，恣情吟咏谩成章。","就中行化觅知友，同共闻香。","烹丹鼎，下丹结，中丹热，大丹凉。","不须炼白更烧黄。","自然玉性，万般霞彩射人光。","上丹霄，去住蓬岛，永永圆方。"],0,"x262","元"],["五灵妙仙 借柳词韵","马钰","杂言",["马风宁海，遇重阳十八。","憨憨地、就中奸黠。","六尘绝。","纵逍遥自在，开怀豁畅，云游水历，琼瑶路如冰滑。","□□补天缺。","下功收五彩，经营活雪。","调龙虎、撞关冲节。","得真悦。","见晴空莹净，圆圆正正，光辉晃朗，元来自家心月。"],0,"x262","元"],["五灵妙仙 赠众道友","马钰","杂言",["马风重，恳告诸公道友。","休迷假、内容堪守。","要长久。","用真功全在，清心净意，擒猿捉马，休令暂时游走。","□□得无漏。","气精神会合，丹砂结就。","无中相、自然开口。","论无有。","这玄玄妙纱，怡然悟解，元来却是，真师暗中传授。"],0,"x262","元"],["五灵妙仙 赠扶风县淡公","马钰","杂言",["悟来降，我相街前乞八。","飍飍地、似痴如黠。","万缘绝。","净清中恣饮，刀圭烂醉，灵台皎洁，惺洒自然光滑。","□□本无缺。","玉炉金鼎内，黄芽白雪。","真龙虎，绕幡关节。","姹婴悦。","把昆仑顶戴，冲开云雾，天无昼夜，长显一轮明月。"],0,"x262","元"],["五灵妙仙 赠赵八先生","马钰","杂言",["马风词，拜上真宁赵八。","常清净、内容娇黠。","马猿绝。","处无为无作，通玄达妙，琼浆得饮，馨香味兼甘滑。","□□无盈缺。","自然神气壮，眠卧冰雪。","欺寒暑、不拘时节。","这般悦。","自心知意解，难言难说，逍遥坦荡，清了洞天真月。"],0,"x262","元"],["五灵妙仙 赠蓬瀛散人","马钰","杂言",["愿贤增寿，算家豪散八。","儿孙孝、尽皆奸黠。","总超绝。","效庞公许氏，全家顿悟，同登彼岸，长生路途清滑。","□□兔角缺。","往来游戏，看天花瑞雪。","金茎秀、迥无枝节。","个中悦。","是灵童应净，真乐真乐，无愁可解，唯吟绛霄风月。"],0,"x262","元"],["化生儿 和重阳真人","马钰","杂言",["得遇忻然别东州。","访地肺，恣遨游。","水云自在没忧愁。","这攀援，爱念休。","保护根元二尾牛。","运玉汞，倒颠流。","金丹结正不持修。","阐玄谈，般若舟。"],0,"x262","元"],["天道无亲 劝公道友","马钰","杂言",["奉劝离俗修持，自有清清雨。","雨变雪花飞，得见青莲浦。","陪伴脱尘云霞侣。","不要起、攀缘心绪。","莫恋金笼共鹦鹉。","听马风真语。"],0,"x262","元"],["天道无亲 本名甘草子劝众道友","马钰","杂言",["唯愿。","想像庄周，梦蝶飞轻粉。","悟彻本无亲，天道堪凭信。","一志寂寥修行紧。","便莫惜、假躯娇嫩。","捐弃家缘须陡顿。","任女男妻恨。"],0,"x262","元"],["心月照云溪 继重阳韵","马钰","杂言",["死生生死，镇日常惊怕。","忽尔遇风仙，便说开、些儿妙话。","忻然顿觉，猛烈弃家缘，向无中，铸经营，烹炼丹无价。","投真得趣，自是增惺洒。","方寸要清凉，把尘缘、般般放下。","颐神养气，心月照云溪，处无私，凭真实，无谄亦无诈。"],0,"x262","元"],["心月照云溪 继重阳韵","马钰","杂言",["一心离俗，二气调和宝。","清净聚三光，四时花、五方运造。","断除六欲，不使七情牵，持八戒，九关通，十载功须到。","十年锻炼，九变金光草。","八脉总和匀，有七圣、六丁助道。","五行咄出，四假不中留，礼三清，成不二，一性投仙岛。"],0,"x262","元"],["心月照云溪 继重阳韵","马钰","杂言",["我今得遇，便向难中做。","决要脱家缘，细寻思、不堪回顾。","黜妻屏子，绝利更忘名，离乡关，归物外，称个超然悟。","马猿捉住。","修葺真园所。","岂敢恋冤亲，要龟蛇、时时厮觑。","援其性命，出自太原公，掌元初，成圆相，踏碎根源路。"],0,"x262","元"],["斗修行 本名斗百花犯正宫","马钰","杂言",["同流宜斗修行，斗把刚强摧挫。","斗降心忘，酒色财气人我。","斗不还乡，时时斗悟清贫，逍遥。","放慵闲过。","斗要成功果。","斗没纤尘，斗进长生真火。","斗炼七返九还，灿烂丹颗。","斗起慈悲、常常似斗无争，斗早得携云朵。"],0,"x262","元"],["无调名 次重阳韵","马钰","杂言",["醉中醒。","睡中惊。","暗中明。","个中平。","心开悟，得前程。"],0,"x262","元"],["无调名 继重阳韵","马钰","杂言",["重阳仙，设芋栗。","赠我夫妻莫前失。","要知命。","要知性。","从此超凡要入圣。","妙玄知。","妙玄知。","身中子午倒颠时。","水乡无漏金丹结，自然云步赴瑶池。"],0,"x262","元"],["无调名 赠王公叠字调","马钰","杂言",["运三车，入宝瓶。","花灿烂，玉堂明。","光照耀，鬼神惊。","散阴魔，精自秘。","藏丹颗，性灵灵。","明出现，绝多能。"],0,"x262","元"],["无调名 赠风翔酒郎中","马钰","杂言",["杜康造底。","昔日文君，当垆沽底。","蓦想古业毕卓，亲曾偷底。","是刘伶，十分偏爱底。","帝前李白曾吐底。","栾巴起慈，救火遥噀底。","司马相公，常常专专诫底。","又争知，是郎中贵姓底。"],0,"x262","元"],["水云游 继重阳韵","马钰","杂言",["玉性玉性。","玉户牢封，金门紧钉。","玉房中、见个骊龙，玉虎来吞并。","玉关能启通捷径。","玉童传宣令。","玉皇天、至矣无私，玉诏今番定。"],0,"x262","元"],["水云游 继重阳韵","马钰","杂言",["思算思算。","妻妾儿孙，休来戏玩。","这冤亲、系脚绳儿，宜一刀两段。","灵源悟彻元灿烂。","这一番更换。","马风子、辞别家乡，与风仙作伴。"],0,"x262","元"],["水云游（北曲） 继重阳韵","马钰","杂言",["不住不住。","火院当离，深宜别户。","害风仙、化我扃门，这修行须做。","腥膻戒尽常餐素。","挂体唯麻布。","待百朝、锁钥开时，效吾师内顾。"],0,"x262","元"],["风马儿 继重阳韵","马钰","杂言",["意马颠狂自由纵。","来往走、珰滴琉玎。","更加之、心猿厮调弄。","歌迷酒惑财色引，珰滴琉玎。","幸遇风仙把持鞚。","便不敢、珰滴琉玎。","待清清、堪归云霞洞。","浑身白彻再不肯，珰滴琉玎。"],0,"x262","元"],["平等会 本名相思会继古韵","马钰","杂言",["信口便胡轰，不管无腔调。","畅我情怀歌舞，一任人笑。","还童返老。","志在无忧恼。","向妙处，下功搜，细勘校。","琼浆恣饮，元气充来饱。","锻炼神丹，无大无小。","胎仙养就，捧出灵芝草。","便自炫，这番儿，道决了。"],0,"x262","元"],["玉花洞 继重阳韵","马钰","杂言",["得其真遇，怎敢怠慢，勤修功果。","紧擒意马，无令颠劣，便把心猿锁。","逢魔逢难全然可。","盖谓无烟火。","本师说破。","元初这个。","争甚闲人我。"],0,"x262","元"],["玉京山 继重阳韵","马钰","杂言",["慷慨男儿跳出来。","名缰并利锁，豁然开。","宜乎了干死生灾。","超彼岸，休望再头回。","师父教方催。","道装当结裹，没心推。","任教妻子哭哀哀。","关西去，做个驾云材。"],0,"x262","元"],["玉炉三涧雪 继重阳韵","马钰","杂言",["火院出离勇猛，发心急救残生。","丹田难仗本师耕。","岂敢常怀徼幸。","得遇明明有幸，通玄暗暗勤行。","便教日午打三更。","玉里掏开金矿。"],0,"x262","元"],["玉炉三涧雪 继重阳韵藏头","马钰","杂言",["别乡关宁海，持真实为凭。","怀三教作良朋。","内日光为证。","悟清清净净，知湛湛澄澄。","中养火虎龙吞。","诀传来游泳。"],0,"x262","元"],["传妙道 本名传花枝借柳词韵","马钰","杂言",["山侗正抚，心琴仙调。","蓦然想、道契仇香姓赵。","愿吾官，早开悟，事皆颠倒。","匿智慧，装懵懂，咄去奸俏。","便仿效、许氏庞公，全家物外，个个总了了。","清心净意，通禅明道。","逍遥乐、永无忧恼。","纵狂歌，任下士，闻之大笑。","笑则笑，怎知得，内貌忒好。","待异日、行满功成，管决有、紫书来到。"],0,"x262","元"],["两只雁儿","马钰","杂言",["四更里，彻玲珑，玲珑彻碧天。","登彼岸，跨凤鸾。","辛苦三二年。","言非大，莫虚传。","传了无一言。","猿是马，马是猿。","休教付两边。"],0,"x262","元"],["两只雁儿","马钰","杂言",["一更里，要精专。","安闲静坐眼看。","猿猴耍，莫放颠。","先须减睡眠。","眠心散，露青天。","恒沙功满大千。","工夫要，行功圆。","非干是自然。"],0,"x262","元"],["两只雁儿","马钰","杂言",["二更里，二气运，铅消汞焰煎。","铅是汞，汞成铅。","冲和满洞天。","冲和气，任虚源。","九曲明珠串。","双阙透，射碧天。","元来是自然。"],0,"x262","元"],["两只雁儿","马钰","杂言",["五更里，画角喧。","惊回清梦游仙。","眠是梦，梦是眠。","方知心是天。","天生地，地生天。","一气合混元。","添一岁，减一年。","真空不动然。"],0,"x262","元"],["两只雁儿","马钰","杂言",["三更里，月正圆。","笙歌消夜天。","金童喜，玉女欢。","凡间不一般。","长生酒，醉不颠。","饮了还少年。","曲江上，望悬悬。","酣买不用钱。"],0,"x262","元"],["添声杨柳枝","马钰","杂言",["杨柳枝词扫一篇。","寄谁边。","一于一郝二刘仙。","诉些言。","好与丘刘谭马子，共搜玄。","九还七返行功全。","去朝元。"],0,"x262","元"],["添声杨柳枝","马钰","杂言",["猛弃荣华儿女妻。","悟玄机。","腾腾兀兀任无为。","做憨痴。","云水不游芳草径，内行持。","功成行满独何之。","赴瑶池。"],0,"x262","元"],["添声杨柳枝","马钰","杂言",["日里金鸡叫一声。","梦初惊。","清风枕上有馀清。","酒初醒。","雾卷云收天似水，月初明。","虚堂寂寂绝尘情。","性初平。"],0,"x262","元"],["孤鹰","马钰","杂言",["苦海为人，随波逐浪，茫茫甚日休期。","为酒色财气。","一向粘惹，瞒心昧己。","不算前程，幼躯有限，待作千年之计。","忽一朝阴公来请，看你教谁替。","千间峻宇，金玉满堂，毕竟成何济。","劝诸公省，早把凡笼猛跳出，向物外飘蓬，放落魄婪耽，鹑居鷇食，昏昏炼已。","默默地、怡神养气。","丹成既济。","乘彩云，跨凤归。"],0,"x262","元"],["金花叶 赠徐安神","马钰","杂言",["欲要灵明莹彻。","向心上、速宜解结。","便莫受、家缘火熁。","弃妻男产业。","逞俊宁如养拙。","引龙虎、休教急切。","自然悟、神仙妙诀。","本来真难灭。"],0,"x262","元"],["金鸡叫","马钰","杂言",["火院中间常火燎。","忧儿女、形容衰了。","傍人替你生烦恼。","投献诗词，万望心明晓。","不测无常非事小。","悟来后、便搜玄妙。","蓬莱云路通关要。","炼就金丹，出自我金鸡叫。"],0,"x262","元"],["金鸡叫","马钰","杂言",["三髻山侗闲失笑。","离乡井、无愁买恼。","忧他性命无心了。","终日哀人，忘了自家道。","堪可垂钩须索钓。","且不免、厮煎打炒。","耐羞耐耻频频告。","谨劝贤家，早悟我金鸡叫。"],0,"x262","元"],["金鸡叫","马钰","杂言",["元是神仙何不晓。","听予劝、家缘事小。","迷津苦海须当跳。","一个灵明，免使尘笼罩。","物外澄心通密妙。","常清净、龙蟠虎绕。","神丹结正腾辉耀。","返老还童，出自我金鸡叫。"],0,"x262","元"],["金鸡叫","马钰","杂言",["入道已蒙相许了。","火坑深、宜乎猛跳。","男儿出语无虚矫。","慎勿迟疑，休使傍人笑。","断制家缘回日早。","休似鹤、留言华表。","从斯马钰登高眺。","奉劝吾兄，莫忘我金鸡叫。"],0,"x262","元"],["金鸡叫","马钰","杂言",["外骋惺惺非是俏。","内修持、些儿最妙。","真如一点三光照。","𦶟起心香。","自有祥烟罩。","李四高人如悟晓。","无中有、非常冥杳。","胎仙舞袖麾灵耀。","跨鹤腾空，出自我金鸡叫。"],0,"x262","元"],["金鸡叫","马钰","杂言",["日日朝朝常报晓。","徒人省、搜玄搜妙。","孳孳为善回光照。","勘破浮生，便把家缘掉。","九曲明珠安九窍。","丝连蚁、火光频燎。","往来穿透功夫了。","得赴蓬瀛，出自我金鸡叫。"],0,"x262","元"],["金鸡叫","马钰","杂言",["许我年时来入道。","想贤家、心无虚矫。","劝公早早家缘掉。","稍稍迟迟、做出诸宫调。","若肯回头何事好。","乐清闲、持杯欢笑。","抚琴月下沈香袅。","搜获玄机，别有个金鸡叫。"],0,"x262","元"],["金鸡叫","马钰","杂言",["日暮残辉何不晓。","好收心、回光返照。","宜乎急急搜玄妙。","疾速修持，莫待西沉了。","物外修仙非是矫。","早认取、言钩语钓。","诗词香饵吞些小。","跃出迷津，悟得我金鸡叫。"],0,"x262","元"],["金鸡叫 化李仲达","马钰","杂言",["撞着鲸鲵须索钓。","抛香饵、时时引调。","洋洋不顾迷波淼。","休要相趖，与你如胶鳔。","掷下金钩常搅扰。","如回首、牵归玄妙。","将来决定成仙了。","朝拜三清，出自我金鸡叫。"],0,"x262","元"],["金莲出玉花","马钰","杂言",["赠予鞋履。","我赐贤家玄妙理。","休别猜疑。","早离尘缘得所宜。","论其元首。","清净精光牢固守。","性不沉流。","决继海蟾的祖刘。"],0,"x262","元"],["金莲出玉花","马钰","杂言",["金汞定。","富人荣非我景。","子何忧。","叹浮生鬓染秋。","生慧草。","早修心端的好。","道胜侯。","袖携云访玉楼。"],0,"x262","元"],["金莲出玉花","马钰","杂言",["刘公听劝。","学佛修仙凭识见。","割弃心尘。","不在焚烧舍拚身。","些儿修炼。","锻炼神丹须九转。","功行圆周。","相继海蟾的祖刘。"],0,"x262","元"],["金莲出玉花","马钰","杂言",["直饶呼使。","怎比清清修不二。","会炼三丹。","远胜为人得好官。","牢擒意马。","紧锁心猿宁著假。","灵物圆周。","得看壶中万万洲。"],0,"x262","元"],["金莲出玉花 于疃于吉先索","马钰","杂言",["于公听劝。","世事无涯难历偏。","好认玄微。","稍稍知空达妙机。","家缘撇掉。","云水遨游修大道。","异日功成。","跨鹤携云赴玉京。"],0,"x262","元"],["金莲出玉花 劝刘法司放鹦鹉","马钰","杂言",["绿毛红嘴。","因为能言还自累。","奉劝修何。","语得分明愈著魔。","不如省觉。","缄口藏机怀卓荦。","人总嫌伊。","得出凡笼自在飞。"],0,"x262","元"],["金莲出玉花 本名减字木兰花赠大毕先生","马钰","杂言",["毕公好志。","官障私魔心不二。","决烈修持。","能可移山志不移。","尘缘一削。","世上荣华无染著。","可称仙徒。","堪许完全大药炉。"],0,"x262","元"],["金莲出玉花 姜公惠故纸","马钰","杂言",["然传旨。","下清吟专谢纸。","帛迁延。","笔书笺鑺见前。","开微寡。","擘悭心当舍下。","惠群仙。","却酬君诗百篇。"],0,"x262","元"],["金莲出玉花 姜公惠蒲扇","马钰","杂言",["蒲编线定。","救苦成功生异景。","热恼无忧。","招引风来夏变秋。","休言是草。","虽则物轻人意好。","感谢姜侯。","惠我清凉免上楼。"],0,"x262","元"],["金莲出玉花 继张修祖殿试韵","马钰","杂言",["传天际。","小金婴能补缀。","白绒清。","物随针绣我心。","灵无影。","八刀圭谁可饮。","友张翁。","客邀观七宝宫。"],0,"x262","元"],["金莲出玉花 继酒同监韵联珠","马钰","杂言",["心数岁。","久休心成妙最。","好心磨。","琢心开疾似梭。","飞玉性。","上无瑕真自净。","有何愁。","恼吾官心不休。"],0,"x262","元"],["金莲出玉花 莱州仓使庐武义","马钰","杂言",["庐公仓使。","意在留心风马二。","未解修丹。","送我劳劳到武官。","速回车马。","欲要全真先弃假。","功行须周。","定是将来看十洲。"],0,"x262","元"],["金莲出玉花 寄任节级","马钰","杂言",["任公节级。","肯救危难常济急。","此去淳于。","报得专专献钵盂。","山东马钰。","词寄贤家收养玉。","玉里生金。","无口能言话古今。"],0,"x262","元"],["金莲出玉花 寄张知观","马钰","杂言",["张公知观。","性命堪搜常作观。","勘破嚣尘。","灰了凡心出世尘。","内修内炼。","真汞真铅常锻炼。","要见金莲。","须是深深种玉莲。"],0,"x262","元"],["金莲出玉花 清真子姚公索","马钰","杂言",["命中养性。","水里生金真本柄。","虎绕龙蟠。","走玉飞金结作团。","刀圭恣饮。","产个胎仙端更正。","别是生涯。","出入腾空步翠霞。"],0,"x262","元"],["金莲出玉花 赠刘同监","马钰","杂言",["圭烂饮。","后玄机宜再审。","上田田。","了真功得自然。","中莲绽。","是为仙无失陷。","了心休。","继海蟾的祖刘。"],0,"x262","元"],["金莲出玉花 赠范明叔棕扇","马钰","杂言",["棕丝为扇。","堪与闲人常作善。","惊諕蚊蝇。","款款轻摇免杀生。","添成幽雅。","相助逍遥尘不惹。","拂尽攀缘。","意净心清性月圆。"],0,"x262","元"],["金莲出玉花 赠清净庵主刘公","马钰","杂言",["彭城庵主。","喜舍花园庵舍做。","设此良缘。","种下将来福禄田。","全家修善。","正是修行真地面。","更好清心。","神气冲和上宝岑。"],0,"x262","元"],["金莲堂 俗惜黄花藏头","马钰","杂言",["传心悟。","中堪睹。","婴娇并女姹。","会封门户。","灭更虫销，木相交做。","事绝，财不觑。","内个中主。","从识汝。","升火降自是，丹阳坚固。","往与今来人，谁肯慕。","子明通玄路。"],0,"x262","元"],["金鼎一溪云 次重阳韵","马钰","杂言",["净里传章句，清中悟句章。","通玄达妙得嘉祥。","自是绝炎凉。","玉户三封清浅。","金鼎一溪云篆。","蓬瀛方丈是家乡。","卧月醉云堂。"],0,"x262","元"],["青莲池上客 俗青玉案攒三拆字继重阳韵","马钰","杂言",["财宝俱捐也。","忆些潇洒。","真修无苟且。","调畅，自然舒□。","马回公惹。","炉炼丹难舍。","功如冶。","山侗成清雅。","神彩，莫能摹写。","马天高下。"],0,"x262","元"],["青莲池上客 继重阳韵","马钰","杂言",["元宵内景闲闲看。","见云雾、风吹散。","洞里天晴如碧案。","一轮心月，十分明更，性烛非常灿。","灵台结个灯球焕。","慧照中间按。","不使三尸分片段。","青莲池上，客来推要，混入长生观。"],0,"x262","元"],["青莲池上客 继重阳韵","马钰","杂言",["马风忽尔风风遇。","自然得、昭然著。","协气横横和气煦。","汞铅交结，虎龙蟠住。","玉马驸。","相曳云霞步。","根源寂寂灵源聚。","元神显，天神护。","道可成兮丹可顾。","青莲池上客，来同赴。","金马驻。","直入蓬莱路。"],0,"x262","元"],["青莲池上客 继重阳韵","马钰","杂言",["将来一志环墙坐。","没水漉，并泥拖。","旦望何须人拜贺。","有心做小，无心做大。","马自佐。","锁灭从前过。","净清力壮无灾祸。","见祥云，朵头亸。","玉户金门封爝火。","青莲池上客，来开锁。","马感荷。","得得真功果。"],0,"x262","元"],["养家苦","马钰","杂言",["养家苦，赡他人。","衣丰食足尚嫌贫。","运机心，丧了真。","修行好，作闲人。","自然忧道不忧贫。","炼顽心，养至真。"],0,"x262","元"],["养家苦","马钰","杂言",["养家苦，没程头。","一朝身死作阴囚。","见阎王，不自由。","修行好，有程头。","三千功满不为囚。","做神仙，得自由。"],0,"x262","元"],["养家苦","马钰","杂言",["修行易，断情难。","始初分解最艰难。","譬无常，破尽难。","心开悟，没疑难。","觉从前事养家难。","学神仙，有甚难。"],0,"x262","元"],["养家苦","马钰","杂言",["思微妙，想尘缘。","两般搜索要精研。","但知空，向道坚。","心清净，意通玄。","自然知道没言传。","达无为，作大仙。"],0,"x262","元"],["养家苦","马钰","杂言",["养家苦，为妻男。","是非荣辱饱经谙。","限临头，事怎甘。","修行好，子端南。","神丹灿烂弃行庵。","宴瑶池，德饱酣。"],0,"x262","元"],["养家苦","马钰","杂言",["养家苦，似蜂虔。","采花成蜜为谁甜。","肯堤防，蛛网粘。","修行好，做风虔。","舌生津液玉浆甜。","溉黄芽，无惹粘。"],0,"x262","元"],["养家苦","马钰","杂言",["养家苦，没休期。","危危险险似围棋。","被人祈，无祷祈。","修行好，最稀奇。","姹婴争把虎龙骑。","献胎仙，凤与麒。"],0,"x262","元"],["养家苦","马钰","杂言",["养家苦，特贪饕。","家丰又待望官高。","遇危难，无计逃。","修行好，不贪饕。","埋光隐迹恐名高。","处无为，生死逃。"],0,"x262","元"],["养家苦","马钰","杂言",["养家苦，恋尘缘。","铺谋活计望千年。","奈凡躯，不久坚。","修行好，结良缘。","功成行满不排年。","做神仙，因志坚。"],0,"x262","元"],["养家苦","马钰","杂言",["养家苦，喜相违。","常常思想死生危。","怕从前，火院围。","修行好，处无为。","神珠光彩透帘帏。","现灵童，相貌威。"],0,"x262","元"],["养家苦","马钰","杂言",["养家苦，镇常忙。","忙来忙去到无常。","作阴囚，住鬼房。","修行好，不曾忙。","闲闲闲里守真常。","得修完，玉洞房。"],0,"x262","元"],["养家苦 赠宁伯功","马钰","杂言",["养家苦，火坑深。","万尘埋没不能禁。","遇风仙，物外寻。","修行好，炼阳阴。","净清能见水中金。","现光辉，罩宝岑。"],0,"x262","元"],["挂金灯 赠重阳师父侄王周臣","马钰","杂言",["绝攀缘，心上生光莹。","朗然变化。","无穷异景。","这密妙、教贤省。","内貌宜，手速整。","悟后分凡圣。","亘初灵明，火内正劲。","锻炼出、清中静。"],0,"x262","元"],["挂金索（北曲）","马钰","杂言",["三更里，明月正把乾坤照。","吓得邪魔，千里不见了。","退尽阴兵，不用刀圭妙。","海底龟蛇，自然相盘绕。"],0,"x262","元"],["挂金索（北曲）","马钰","杂言",["四更里，无事好把真经看。","句句幽玄，说道教修炼。","不用水火，不用柴和炭。","炼就灵丹，万两金不换。"],0,"x262","元"],["挂金索（北曲）","马钰","杂言",["五更里，天晓架上金鸡叫。","有个忙儿，拍手呵呵笑。","放饱牛儿，快活睡一觉。","行满功成，自有丹书诏。"],0,"x262","元"],["挂金索（北曲）","马钰","杂言",["一更里，端坐慢慢调龙虎。","运转三关，透入泥丸去。","龙蟠金鼎，虎绕黄庭户。","这些儿工夫，等闲休分付。"],0,"x262","元"],["挂金索（北曲）","马钰","杂言",["二更里，二点阴阳真气妙。","上下三关，休教差错了。","姹女婴儿，两个都放娇。","金公黄婆，自然匹配了。"],0,"x262","元"],["洞中天 本名鹧鸪天寄呈马运甫","马钰","杂言",["休赌休饮休保人。","减些烟焰少婪尘。","能搜己过为长便，不见他非获好因。","惊宠辱，乐清贫。","修心养性惜精神。","常凭如此成功行，明月清风作友真。"],0,"x262","元"],["洞中天 全真庵丹井","马钰","杂言",["穿凿须当二九深。","甘泉自有应清吟。","更祈治病名丹井，相称山侗普济心。","人听劝，作知音。","重阳妙趣好追寻。","紫芝气焰生形象，碧眼真如上宝岑。"],0,"x262","元"],["洞中天 赠员先生","马钰","杂言",["蓦想浮华痛我心。","暂时荣显落沉沦。","争如物外逍遥客，岂似寰中自在人。","忘俗虑，乐清贫。","住行坐卧啰哩凌。","炼烹玉鼎长生药，保养金炉不死真。"],0,"x262","元"],["洞中天 赠昭然子","马钰","杂言",["劝公休要恋迷津。","华阳巾换皂罗巾。","不为汨没尘中客，得做逍遥物外人。","修道德，固精神。","虎龙蟠绕啸吟频。","汞铅自是成丹药，跨鹤腾云礼至真。"],0,"x262","元"],["炼丹砂","马钰","杂言",["行道要心坚。","密护丹田。","调和真息永绵绵。","十二时中常若见。","休要尘牵。","诀要避喧哗，静处安然。","须通语、默默言传。","神秀丹成行满。","得去朝元。"],0,"x262","元"],["炼丹砂","马钰","杂言",["天水劫云庵。","远胜精蓝。","云朋霞友日常参。","恰似栽松招引鹤，岂是贪婪。","若肯悟清谈。","管有香甘。","田园分付与儿男。","欲住蓬瀛先改作，落魄婪耽。"],0,"x262","元"],["炼丹砂 赠清静散人孙不二","马钰","杂言",["奉报富春姑。","休要随余。","而今非妇亦非夫。","各自修完真面目，脱免三涂。","炼气莫教粗。","上下宽舒。","绵绵似有却如无。","个里灵童调引动，得赴仙都。"],0,"x262","元"],["神光灿 继重阳韵","马钰","杂言",["风仙锁户，马钰辞巢，寂然澹乎自持。","了干根源，岂肯攀恋妻儿。","识破气财酒色，凭清净、固养灵芝。","当下手，暗修完功行，不许人知。","隐密藏机蓄响，便须常做个玉褐怀披。","泼杀无明火烛，自是心慈。","忍辱得何味况，善芽生、仙佛常随。","通玄妙，这真功，却是无为。"],0,"x262","元"],["神清秀 寄看庞总管园赵公","马钰","杂言",["些儿微妙非常好。","猛焰里、自然芝草。","玉虎与金龙，密护三田宝。","丹成九转青童报。","便授取、紫微宣诰。","体挂六铢衣，跨鹤归蓬岛。"],0,"x262","元"]]