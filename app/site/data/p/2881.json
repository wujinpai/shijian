[["所居三章二章章八句一章章十句  其一","洪皓","四言",["昔我所居，巨室髙门。","或出或处，笑傲乾坤。","终日熙熙，省定晨昏。","致君泽民，兹志常存。"],0,68,"宋"],["玄牝颂","周无所住","四言",["万物芸芸，各归其根。","识得根源，玄牝虚传。"],0,69,"宋"],["赤城六章章四句  其五","释居简","四言",["伊我无酒，注彼觩兕。","愿公华衮，式昌厥嗣。"],0,"x94","宋"],["宋江三十六赞 其二 智多星吴学究","龚开","四言",["古人用智，义国安民。","惜哉所予，酒色粗人。"],0,103,"宋"],["舜泉诗","苏辙","四言",["历山岩岩，虞舜宅焉。","虞舜徂矣，其神在天。","其德在人，其物在泉。","神不可亲，德用不知。","有冽斯泉，下民是祗。","泉流无疆，有永我思。","源发于山，施于北河。","播于中逵，汇为澄波。","有鳖与鱼，有菱与荷。","蕴毒是泄，污浊以流。","埃𡏖消亡，风火灭收。","丛木敷荣，劳者所休。","谁为旱灾，靡物不伤。","天地耗竭，泉亦沦亡。","民咸不宁，曰不享耶。","时雨既澍，百谷既登。","有流泫然，弥坎而升。","沟洫满盈，𫚥黾沸腾。","匪泉实来，帝实顾余。","执其羔豚，苹藻是菹。","帝今在堂，泉复如初。"],0,"x135","宋"],["偈","释智孜","四言",["五十春秋，如电如露。","月映寒江，分明归去。"],0,220,"宋"],["颂古十七首 其七","释师观","四言",["傀儡棚头，全火祗候。","明眼人前，一场漏逗。"],0,210,"宋"],["上广东漕使黄郎中  其六","曾丰","四言",["天相公生，成春收集。","挺所钟兮，醇乎成质。"],0,"x193","宋"],["偈二十七首 其二十一","释绍隆","四言",["放一线道，曲为今时。","性地未明，须凭指注。"],0,252,"宋"],["颂古五十七首 其二","释道昌","四言",["二俱不了，随合多少。","纵使夜行，投明未到。"],0,23,"宋"],["颂古七十六首  其一五","释士珪","四言",["百丈野狐，塞鴈衔芦。","李广神箭，张颠草书。"],0,232,"宋"],["义利吟","邵雍","四言",["君子尚义，小人尚利。","尚利则乱，尚义则治。"],0,"x57","宋"],["真炉鼎颂","周无所住","四言",["头上顶天，脚下踏地。","中有一物，煅成宝器。"],0,69,"宋"],["赤城六章章四句  其六","释居简","四言",["亦复愿公，啸吟紫微。","㑭我紫微，嬉其莞而。"],0,"x94","宋"],["颂古五十七首 其四十四","释道昌","四言",["前面有虎，元来是汝。","更问如何，冤苦冤苦。"],0,23,"宋"],["颂古五十七首 其五十五","释道昌","四言",["针头削铁，佛面刮金。","无处若有，出手便惊。"],0,23,"宋"],["颂古三十六首 其十一","释惟一","四言",["即心是佛，砒霜狼毒。","起死回生，不消一服。"],0,143,"宋"],["偈四首 其四","释思慧","四言",["南询诸友，踏破草鞋。","绝学无为，坐消日月。","凡前易脱，圣解难忘。","但有纤毫，皆成渗漏。","可中为道，似地击山。","应物显形，如驴觑井。","纵无计较，途辙已成。","若论相应，转没交涉。","勉诸仁者，莫错用心。","各自归堂，更求何事。"],0,103,"宋"],["苏李松石图赞","张侃","四言",["东坡先生，锦绣心胸。","戏作怪石，一时告功。","当其落笔，雨霈风从。","齐安赤壁，惠州鹤峰。","十年饱览，孰可撄锋。","温润枯淡，变态不同。","一卷之石，作倚盘松。","龙眠居士，孰羁其踪。","一瞬八表，如鹤在空。","东坡颂美，佳名日穹。","明窗展观，松古石窿。","天下之宝，岂间穷通。","东坡之节，龙眠之隐。","一异出处，如琴加轸。","吁嗟二公，人中之龙。","百馀岁后，仰止英风。","我生后时，何以形容。","纪述惟赞，愧非扬雄。"],0,"x146","宋"],["偈颂十八首 其五","释如净","四言",["净慈法座，木头一棚。","横撑竖撑，黑漆光生。"],0,105,"宋"],["摄事十三首 其十一 真宗室用《大明》。","郊庙朝会歌辞","四言",["煌煌真宗，善继善承。","经武耀德，臻于治平。","对祀礼乐，丕昭鸿名。","陟配文庙，皇图永宁。"],0,"x207","宋"],["和陶命子韵示津调官 其三","吴芾","四言",["曰岂不欲，效彼群龙。","润泽万物，助成岁功。","潜而不用，夫岂自封。","惧将有悔，不显其踪。"],0,"x95","宋"],["升堂颂古五十二首 其四十","释怀深","四言",["道源不远，性海非遥。","但向己求，莫从他觅。","觅亦不得，得亦不真。","修是他心，不如自性。","自性清净，即是法身。"],0,"x134","宋"],["偈六十三首 其十三","释道宁","四言",["兵随印转，将逐符行。","把断要关，不通音信。"],0,119,"宋"],["死心禅师舍利赞","惠洪","四言",["地水火风，动暖坚湿。","是中何从，出此坚实。","盖众生心，引大法力。","化为光明，圆粹五色。","稽首死心，骂人老贼。"],0,"x42","宋"],["乾道七年恭上太上皇帝太上皇后尊号十一首 其六 太上皇帝升御坐。降同。","郊庙朝会歌辞","四言",["穆穆圣颜，安安天步。","有缛者仪，以莫不举。","天人和同，恩泽洋普。","亿载万年，为众父父。"],0,"x207","宋"],["颂古六首 其五","释崇岳","四言",["大机圆应，大用直截。","雪峰云门，只得一橛。","毕竟如何，不说不说。"],0,222,"宋"],["宋江三十六赞 其九 病尉迟孙立","龚开","四言",["尉迟壮士，以病自名。","端能去病，国功可成。"],0,103,"宋"],["太常乐章三十首 其二十八 皇帝南郊回御楼将索扇奏隆安之曲","杨亿","四言",["应门有翼，羽卫斯陈。","山龙衮冕，律度声身。","峨峨奉璋，肃肃九宾。","清明在躬，志气如神。"],0,"x47","宋"],["有美人兮四章  其一","赵友直","四言",["有美人兮，在天之东。","瞻之勿及，我心憧憧。"],0,49,"宋"],["偈颂二十一首 其十一","释普宁","四言",["向上一路，千圣不传。","等闲踏著，不直半钱。"],0,119,"宋"],["偈颂四十一首 其一","释慧晖","四言",["山上栏外，水下槛前。","夜兔光雪，昼乌辉火。","黄头出妙，净名入玄。","胡僧印心，卢公传衣。","张三野曲，李四樵歌。","船动碧波，海浸孤天。"],0,194,"宋"],["终风操","王令","四言",["云之扬扬，油油其蒙。","望我以雨，卒从以风。","云之油油，扬扬其去。","我挽不可，泣立以伫。","终风不休，终云不留。","不雨我田，不谷我收。","岩岩南山，有川其下。","徒能必云，不能必雨。","蓁蓁者林，有越而樛。","人伐以归，我徂安休。","嗟今之人，顾己是求。","有颀者木，曷为而材。","大折以薪，小生何哉。","嗟今之人，谁同我哀。"],0,"x68","宋"],["淳化乡饮酒三十三章  其二四","郊庙朝会歌辞","四言",["关雎跄跄，集水之央。","好求贤辅，同扬德光。"],0,"x207","宋"],["疑信吟","邵雍","四言",["人无轻信，事无多疑。","轻信招衅，多疑招离。"],0,"x57","宋"],["紫岩九章章八句上寿张丞相  其二","张元干","四言",["紫岩赫赫，众山维则。","秉国之钧，百僚是式。","志殄仇方，力复明辟。","时方中兴，勋冠今昔。"],0,"x183","宋"],["偈颂六十五首 其二十八","释咸杰","四言",["月圆月缺，循途守辙。","打破牢关，天宽地宽。"],0,92,"宋"],["次程帅劝农和陶诗韵","陈造","四言",["我官于房，庸谂房民。","是腹枵然，惟贮一真。","服事告工，以成以因。","雄也言之，参天以人。","燥之润之，是有黍稷。","天不竟刈，物岂自植。","系人之力，温饱稼穑。","惟蚕而衣，如稼而食。","盍槌于家，盍桑于陆。","饲眠后先，如族昭穆。","爰缲爰织，如寇之逐。","悠悠玩日，迄莫归宿。","孰溉不车，曾不计久。","孰视槁干，徒用播耦。","吴丰楚约，谁非朕亩。","穗斯茧斯，均措厥手。","彼多其储，汝则易匮。","效劳计工，宁终不冀。","蹀躞十驾，与骥一至。","枵中赤立，吾代尔愧。","吏职民忧，无庸汝鄙。","农以济学，繄吾素履。","岂曰多言，率遵前轨。","教诏顺从，庶或兼美。"],0,"x178","宋"],["偈颂八十七首 其十二","释慧开","四言",["闹市红尘，入廛垂手。","才涉思惟，劈脊便搂。"],0,65,"宋"],["无心颂","张伯端","四言",["堪笑我心，如顽如鄙。","兀兀腾腾，任物安委。","不解修行，亦不造罪。","不曾利人，亦不私己。","不持戒律，不徇忌讳。","不知礼乐，不行仁义。","人间所能，百无一会。","饥来吃饭，渴来饮水。","困则打睡，觉则行履。","热则单衣，寒则盖被。","无思无量，何忧何喜。","不悔不谋，无念无意。","凡生荣辱，逆旅而已。","林木栖鸟，亦可为比。","来且不禁，去亦不止。","不避不来，无赞无毁。","不厌丑恶，不羡善美。","不趣静室，不远闹市。","不说人非，不夸己是。","不厚尊崇，不薄贱稚。","亲爱冤仇，大小内外。","哀乐得丧，钦侮险易。","心无两睹，坦然一揆。","不为福先，不为祸始。","感而后应，迫而后起。","不畏锋刀，焉怕虎兕。","随物称呼，岂拘名字。","眼不就色，声不来耳。","凡所有相，皆属妄伪。","男女形声，悉非定体。","体相无心，不染不碍。","自在逍遥，物莫能累。","妙觉光圆，映彻表里。","包裹六极，无有遐迩。","光兮非光，如月在水。","取舍既难，复何比拟。","了兹妙用，迥然超彼。","或问所宗，此而已矣。"],0,152,"宋"],["偈颂一百六十九首 其十一","释智朋","四言",["伶利衲僧，动无思算。","合水和泥，田头地畔。","搆得完全，只得一半，穷坑难满。"],0,18,"宋"],["紫岩九章章八句上寿张丞相  其四","张元干","四言",["紫岩广兮，作镇坤位。","尽臣之道，厚德以载。","开国南阳，厥绪光大。","是似是续，福禄未艾。"],0,"x183","宋"],["偈颂八十七首 其二","释慧开","四言",["礼拜即是，不礼即是。","黄面瞿昙，在我脚底。"],0,65,"宋"],["臭庵","释师范","四言",["全无气息，直是薰人。","无鼻孔者，方堪与邻。"],0,"x155","宋"],["颂古六十二首 其三十六","释清远","四言",["春寒料峭，冻杀年少。","切忌参商，别无奇妙。","低头侍奉，欢喜问讯。","佛法商量，伤子性命。"],0,116,"宋"],["郴州干明进和尚舍利赞","惠洪","四言",["李广射虎，石为之穿。","耿恭祝井，涸为之泉。","忠孝所致，如响答焉。","公亦何为，饥餐困眠。","人初莫测，公岂自言。","戏为火浴，朽者明鲜。","舍利粲粲，玉碎珠圆。","乃至所养，盖其云全。","天全之妙，非粗不传。","如春在花，如意在弦。","嗤嗤横目，气凌云天。","死未及寒，化为腥膻。","矧投于火，不作腥烟。","安有万手，收此精坚。","维德之一，堙所拳拳。","死生之大，卒莫能迁。","公初设心，唯此是专。","不祈人知，人趋如川。","终必有验，理之固然。","我作赞词，丰碑以镌。"],0,"x42","宋"],["偈颂八十七首 其一","释慧开","四言",["父子不传，百无一有。","狭路相逢，推门落臼。"],0,65,"宋"],["正因法孙命工绘吾幻质炷礼请赞","释普宁","四言",["个样面嘴，阿谁敢拟。","威凛凛生，气愤愤地。","临济德山，望风敬畏。","和苏噜之。"],0,119,"宋"],["上广东漕使黄郎中  其五","曾丰","四言",["三春彭兮，和气弸兮。","季于孟仲，和之英兮。","至英收凝，天相丕乎。","公生裕裕，集春之成。"],0,"x193","宋"],["偈颂三十首 其二十","释印肃","四言",["化藏经语，结般若因，度有缘众。","一卷一千，共亦不共。","才出头来，便得受用。","此经无价，拟议不中。","除非自肯，破尘了梦。","见佛不空，塔成无缝。","半偈舍身，古今尊重。","劫火不烧，魔不能动。","佛祖皆宗，天龙普供。","万莫放过，千亿珍重。"],0,"x121","宋"],["明月  其三","陈杰","四言",["白日苦短，而夜苦长。","迟尔不来，明月靡常。"],0,174,"宋"],["山行见月作 其一","赵蕃","四言",["有风肃然，落于树巅。","使我沈疴，不药而痊。"],0,"x36","宋"],["晁无咎金山诗帖赞","岳珂","四言",["我登吞海，而帖适至。","事虽偶然，不啻有意。","彼江山者，秀无古今。","丘壑市朝，则二其必。","阿大中郎，煌煌虎节。","金闺卷怀，亦既殊辙。","同此登览，而趣不同。","云霄并翔，翚翟冥鸿。","矢词胸襟，浩荡万里。","比兴所存，二疏是企。","清诗胜景，何地无之。","不絷不维，景则我随。","征尘障天，我亦倦翼，遗墨未渝，微躬奚息。","南零之波，上派于湓。","诗其警予，以谂侯门。"],0,"x202","宋"],["淳熙十二年加上太上皇帝太上皇后尊号十一首 其三 皇帝奉太上皇帝册宝授太傅。太上皇后册宝同。","郊庙朝会歌辞","四言",["我尊我亲，承天之祉。","寿名兼美，家国咸喜。","公傅秉礼，宝册有炜。","惟千万祀，令闻不已。"],0,"x207","宋"],["文宣王及其弟子赞 其二十八","赵构","四言",["婉彼子羔，受业先圣。","宗庙之问，一出乎正。","克笃于孝，非愚乃令。","师知其生，有辉贤行。"],0,249,"宋"],["偈三首 其一","释克文","四言",["云门抽顾，自有来由。","一点不到，休休休休。"],0,13,"宋"],["偈颂一百四十二首 其九十二","释广闻","四言",["达磨面壁，云门念七。","玉本无瑕，雕文丧德。"],0,10,"宋"],["文宣王及其弟子赞 其二十一","赵构","四言",["邈矣子季，睢阳是伯。","屏息受业，延教登席。","未践四科，困涉六籍。","祀典载之，好是正直。"],0,249,"宋"],["南风歌","薛季宣","四言",["忾彼夏日，熇熇其暑。","毒我下民，辟焉无所。","忾彼夏夜，郁蒸其雨。","民之愠结，莫安其处。","凯风自南，发于茂林。","实彼百谷，纾我愠心。"],0,"x194","宋"],["文宣王及其弟子赞 其三十二","赵构","四言",["室家壮年，无子则逐。","见于信史，全齐之俗。","原本厥初，师言可复。","以学则知，揆之宜笃。"],0,249,"宋"],["迎奉圣像四首 其三 太祖位。","郊庙朝会歌辞","四言",["烝哉大君，聿怀帝祖。","镕范真仪，奉尊灵宇。","至感祥开，洪辉物睹。","瞻谒尽恭，飞英率土。"],0,"x207","宋"],["绝命诗","邓得遇","四言",["宋室忠臣，邓氏孝子。","不忍偷生，宁甘溺死。","彭咸故居，乃吾潭府。","屈公子平，乃吾伴侣。","优哉悠哉，吾得其所。"],0,148,"宋"],["正冬御殿上寿乐章八首 其二 皇帝举第二爵酒登歌奏祥麟之曲","杨亿","四言",["帝图会昌，仁兽效祥。","双觡共抵，示武不伤。","四灵为畜，玄枵耀芒。","公族信厚，元元阜康。"],0,"x47","宋"],["偈颂七十六首 其二十一","释师范","四言",["倾盖相逢，已成多事。","侧鞭回首，早涉繁词。"],0,"x155","宋"],["偈颂七十六首 其七十六","释师观","四言",["来时无踪，去时无迹。","七十五年，青天霹雳。"],0,210,"宋"],["题崇德君所画雀竹蜩螗图赞","黄庭坚","四言",["蒿下蹄间，斥𫛩饮啄。","争雄穹枝，竿网将作。","蝉嘒竹间，自谓得己。","螗螂从之，鸡鸣不已。"],0,"x66","宋"],["偈颂一百三十三首 其四十三","释居简","四言",["跛跛挈挈，百丑千拙。","斗诸方胜，胜诸方劣。"],0,"x94","宋"],["衡山南台寺飞来罗汉赞","惠洪","四言",["惟毗尼藏，称性之印。","印一切法，无有少剩。","而此尊者，跏趺不瞬。","外寂中空，幻灭都尽。","诸佛子等，勿故起妄。","于是像中，作去来想。","昔本不来，今亦焉往。","即一切法，离一切相。","如一月真，无二无别。","于众水中，同时见月。","像非异同，月岂生灭。","以应缘故，光影清绝。","钟山众泉，石井异味。","灵隐众山，小岭异翠。","此岭此泉，皆飞而至。","示根境法，其实同体。","如此大士，诸法成就。","南岳庐山，宴坐驰走。","而事藏界，随处而有。","虽证无生，亦不灭受。"],0,"x42","宋"],["葛文康书简帖赞","岳珂","四言",["辞以情达，义以气激。","以素心期，托名手笔。","都曹之获，中寓其一。","尚想风流，太平人物。"],0,"x202","宋"],["偈颂一百三十三首 其九十一","释法薰","四言",["雪峰辊毬，禾山打鼓。","要觅旨归，月不破五。"],0,31,"宋"],["紫岩九章章八句上寿张丞相  其七","张元干","四言",["土宇未复，繄公辟之。","士风未变，繄公革之。","军律未振，繄公鼓之。","国论未定，繄公断之。"],0,"x183","宋"],["紫岩九章章八句上寿张丞相  其三","张元干","四言",["紫岩高兮，上摩穹窿。","雨露润泽，风云会同。","表宋宗臣，礼泰智崇。","皇以昭之，简在帝衷。"],0,"x183","宋"],["乾道七年恭上太上皇帝太上皇后尊号十一首 其三 皇帝奉太上皇帝册宝授太傅用《礼安》。奉太上皇后同。","郊庙朝会歌辞","四言",["仪物陈矣，礼乐明矣。","天子戾止，诒尔臣矣。","陟降维则，恭且勤矣。","茫茫四海，德教形矣。"],0,"x207","宋"],["陶隐居画像赞","苏庠","四言",["蕊珠妙言，字照编简。","云霾三馆，其人则远。","世衰道丧，完节者鲜。","临终之叹，作世和篇。"],0,60,"宋"],["紫岩九章章八句上寿张丞相  其八","张元干","四言",["来朝伊何，筑隄于沙。","对扬伊何，言宣其麻。","明明天子，坐于正衙。","徯公来归，相我邦家。"],0,"x183","宋"],["三昧诸颂 其五","释印肃","四言",["神光遍界，体若金刚。","威神力固，邪宗销亡。"],0,"x121","宋"],["赵平甫幽居八操 其一 筠居操","杨万里","四言",["公子诛茅，不木不土。","此君惠然，聿来胥宇。"],0,"x54","宋"],["正冬御殿上寿乐章八首 其六 皇帝举第四爵酒登歌奏河清之曲","杨亿","四言",["德水汤汤，发源灵长。","皎鉴澄澈，千年效祥。","积厚流湿，资生阜昌。","朝宗润下，善利无疆。"],0,"x47","宋"],["偈颂一百三十三首 其一○九","释法薰","四言",["当头一句，无过直与。","南山有口，不敢错举，笑破露柱。"],0,31,"宋"],["龙门常住图师真知事求赞","释清远","四言",["寥廓无状，孰为龙门。","有指南路，绝刀斧痕。","因缘去住，任物所论。","黄竹寒湫，晓而复昏。"],0,116,"宋"],["颂古四十八首 其一","释慧开","四言",["狗子佛性，全提正令。","才涉有无，丧身失命。"],0,65,"宋"],["广慧法师赞","陆游","四言",["东土震旦，西方极乐。","一緉草鞋，到处行脚。"],0,"x41","宋"],["颂古三十一首 其三","释安永","四言",["鱼行水浊，鸟飞毛落。","大士横身，不受斧凿。"],0,145,"宋"],["颂古三十一首 其六","释安永","四言",["丧尽家财，无本可据。","赤手杀人，弥天罪过。"],0,145,"宋"],["偈颂一百六十九首 其五十一","释智朋","四言",["此大楼阁，无住无去。","此楼阁门，无开无闭。","作者同归，不劳弹指。"],0,18,"宋"],["文宣王及其弟子赞 其十二","赵构","四言",["礼之有本，子能启问。","大哉斯言，光昭明训。","德辉泰山，诬祭莫奋。","崇兹祀典，盍永令闻。"],0,249,"宋"],["文宣王及其弟子赞 其五十八","赵构","四言",["学者行道，敝缊亦称。","使齐光华，偶为肥轻。","周急之言，君子所令。","答问允严，理皆先经。"],0,249,"宋"],["命子篇","赵友直","四言",["悠悠我祖，肇自轩辕。","迄于赵城，因而氏焉。","汉家涿郡，继族于燕。","卜迁大梁，世系绵绵。","宋自中叶，徙都南塘。","武显扈跸，聿居虞乡。","于赫文杏，奕世其芳。","符德象贤，谱牒有光。","顾及于我，时运倏倾。","族居萍散，遂殒家声。","苫块馀息，仅存其形。","于焉有心，冀我后生。","后生是畏，圣谟炳如。","维时孜孜，无忝厥初。","岂不尔念，为惜居诸。","无后非孝，匪才若虚。"],0,49,"宋"],["偈颂一百二十三首 其五十四","释崇岳","四言",["春风似箭，春雨如膏。","旷劫来事，不隔丝毫。"],0,222,"宋"],["偈颂一百三十三首 其三","释法薰","四言",["衲僧公验，突出难辨。","手眼通身，只得一半。"],0,31,"宋"],["偈颂一百二十三首 其一○四","释崇岳","四言",["第一义谛，分文不直。","略露机锋，青天霹雳。","恁么恁么，不识不识。"],0,222,"宋"],["赐宜春易太极","徐经孙","四言",["易有太极，在天地先。","两仪四象，是谓后天。","春台得之，云自希夷。","吉凶祸福，予以前知。","八十二宫，颇与俗殊。","数往知来，亶其然乎。"],0,232,"宋"],["偈颂一百四十二首 其一一一","释广闻","四言",["日南长至，吉无不利。","冻破泥团，花开碓嘴。"],0,10,"宋"],["赞五祖","释守卓","四言",["浊港转身，破头印法。","五叶芬芳，千徒杂踏。","于秀于能，谁离谁合。"],0,42,"宋"],["定身岩赞","惠洪","四言",["淮山深处，容我卓锡。","树下经行，岩间宴寂。","六十馀年，胁不至席。","天子三诏，掉头不应。","知不可致，南向加敬。","山摇海惊，天空地迥。","后代儿孙，则反于是。","如乳中虫，贪嗜世味。","我寻其迹，为陨涕泪。"],0,"x42","宋"],["偈颂十五首 其七","释法薰","四言",["以大圆觉，为我伽蓝。","头上著枷，脚下著杻。","身心安居，平等性智。","困鱼止沥，病鸟栖芦。"],0,31,"宋"],["偈颂十二首 其二","释如净","四言",["饥来吃饭，困来打眠。","炉鞴亘天，倒退三千。"],0,105,"宋"],["休堂颂","黄庭坚","四言",["头上安头，如何得休。","杀佛杀祖，方得按堵。","北郁单越，西瞿耶尼。","事同一家，吃饭著衣。","向上一路，千圣眨眼。","韩信打关，张良烧栈。"],0,"x66","宋"],["圣号雅二篇 其六","赵湘","四言",["烝哉皇极，道靡有息。","勤勤以谟，罔视其迹。","凿饮自鼓，耕食自绩。","维相以歌，勿荷后辟。"],0,126,"宋"],["偈颂七十六首 其六十八","释师范","四言",["龙蛇混杂，凡圣交参。","儱儱侗侗，颟颟顸顸。"],0,"x155","宋"]]