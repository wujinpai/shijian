[["桃源忆故人 寄忆","董元恺","词",["春寒泪滴罗衾暖。","料峭湘帘初卷。","昨夜玉人窗畔。","悄悄闻低唤。","寻思却是天涯远。","此际柔肠千转。","便有南归鱼雁。","极目关河断。"],0,"x435","清"],["三字令 其一 贞娘墓","董元恺","词",["云悄悄，灯荧荧。","雨泠泠。","凭吊处，惜娉婷。","烟为鬟，雾为鬓，归无形。","幽篁碧，晚枫青。","恨千龄。","玉箫歇，寒蛩鸣。","辛夷襦，芙蓉席，飞残萤。"],0,"x435","清"],["三字令 其二 闺怨，集唐词","董元恺","词",["香阁掩，泣残红。","绿阴浓。","花淡薄，月朦胧。","人去去，云杳杳，恨忡忡。","空相忆，画楼东。","此时逢。","消息远，锦书通。","万般心，千点泪，一时封。"],0,"x435","清"],["朝中措 题张真人鹤归亭，用欧公韵","董元恺","词",["当年虚靖已凌空。","胜迹古亭中。","萝洞昼栖云雾，石坛时响松风。","每闻猿啸，惊飞鹤驾，暮鼓晨钟。","便有药炉丹井，尘湖几见仙翁。"],0,"x435","清"],["眼儿媚 秋海棠","董元恺","词",["一帘花色写秋容。","低映碧窗红。","胭脂冷落，似颦无语，欲笑还慵。","断肠心事谁承问，旖旎不禁风。","泪痕染遍，亭亭倩影，点点芳丛。"],0,"x435","清"],["摊破浣溪沙 其一 闺情","董元恺","词",["荡漾馀花落镜奁。","终朝唤婢镇垂帘。","私幸向来凄闷惯，只恹恹。","手划阑干私自语，髻拖针线总慵拈。","别有关心人不觉，到眉尖。"],0,"x435","清"],["摊破浣溪沙 其二 春恨","董元恺","词",["处处风波暗未休。","晓来听雨替花忧。","想到碧窗携手地，忽凝眸。","半吐樱桃开靥晕，欲眠杨柳放眉愁。","懊恨一春憔悴甚，只如秋。"],0,"x435","清"],["喜团圆 将到家作","董元恺","词",["依稀又见，兰陵城郭，远火垂杨。","忽逢野老偏相识，惊问鬓毛苍。","遥知窗外，柳开新眼，梅送余香。","牵衣大妇，挽须小女，争拂风霜。"],0,"x435","清"],["河渎神 题二妃庙壁","董元恺","词",["落叶满鸣条。","柏宫方冢岧峣。","二妃遗像枕寒潮。","珠衣玉佩飘摇。","河流不向湘流绕。","泪痕此地多少。","恨与苍梧俱杳。","平阳亦有香草。"],0,"x435","清"],["阳台梦 纪梦","董元恺","词",["个人悄倚银屏立。","唾花衣袖朦胧碧。","眼波才动已知心，笑向纱幮侧。","隔帘声暗认，低唤枕函亲切。","睡情欲上忽三更，听姊规凄咽。"],0,"x435","清"],["柳梢青 其一 杨花","董元恺","词",["午院春深。","玉楼微度，画阁低侵。","乱卷愁来，轻沾恨去，一片伤心。","飘零幽梦难寻。","偏冷落、珠帘绣衾。","燕子争衔，罗衣暗惹，消息沉沉。"],0,"x435","清"],["柳梢青 其二 舟中偶见有感，和罗弘载韵","董元恺","词",["无限凭栏。","一泓秋水，两点春山。","照影轻盈，盘龙新髻，青雀丫鬟。","柔枝煞是堪攀。","憨笑处、琵琶暗弹。","白草黄沙，昏鸦冷雁，曾否开颜。"],0,"x435","清"],["贺圣朝 西江送富云麓学士入都","董元恺","词",["柳遮铃索西江路。","花唱骊驹暮。","鸾坡不借，片帆悬向，马当飞度。","连空水远举头日，近傍玉清风露。","故人天上讯狂生，只疏慵如故。"],0,"x435","清"],["茶瓶儿 王半焽江楼留饮岕线","董元恺","词",["新制凌家岕线。","碾玉尘、月团千片。","倾琼蕊色香兼擅。","映入幽兰葱茜。","寒泉溅、乳花泫。","冰瓷春满。","松风小啜过阳羡。","月冷空、江声断。"],0,"x435","清"],["少年游 江楼秋怀，和柳屯田韵","董元恺","词",["十年旧事上心头。","残月下江楼。","玉露初零，金风乍起，吹动一天愁。","衣香手粉曾留处，仿佛忆同游。","眼泪如潮，枕痕似水，终夜尽情流。"],0,"x435","清"],["偷声木兰花 其一 崧台岁暮，题家书尾，寄闺人","董元恺","词",["碧桃花发人离别。","匆匆又见花时节。","细数花前。","恰值花开未一年。","惊心蜡尽逢春暮。","朔雪严风春里度。","屈指春光。","轻暖轻寒到艳阳。"],0,"x435","清"],["偷声木兰花 其二 崧台岁暮，题家书尾，寄闺人","董元恺","词",["去年笠泽浮家去。","缥缈莫厘卿共住。","杨柳丝丝。","满箧登楼唱和诗。","而今零落荆钗伴。","憔悴罗襟红泪满。","地阔天长。","蛮雨蛮烟总断肠。"],0,"x435","清"],["偷声木兰花 其三 崧台岁暮，题家书尾，寄闺人","董元恺","词",["长江渺渺芙蓉渡。","横浦重重梅岭路。","万水千山。","唱尽新词行路难。","海南霜雪从无信。","点点偏催游子鬓。","玉臂云鬟。","懊恼三秋人未还。"],0,"x435","清"],["偷声木兰花 其四 崧台岁暮，题家书尾，寄闺人","董元恺","词",["男儿意气差无苦。","累汝兼持门与户。","典尽空箱。","泪裹珍珠仔细藏。","遥闻薄产丰年熟。","来岁官逋先赋足。","事事关心。","别有关心愁更深。"],0,"x435","清"],["偷声木兰花 其五 崧台岁暮，题家书尾，寄闺人","董元恺","词",["迢迢客路谁为主，纵是在家如逆旅。","飘泊天涯。","谁道天涯胜似家。","一年暂别休悲涕。","暂别百年能有几。","此后归来。","老我柔乡傍镜台。"],0,"x435","清"],["西江月 其一 过苏秦故里","董元恺","词",["不是秦邦金尽，那能赵印功高。","揣摩欲过洛阳桥，富贵徒欺妻嫂。","箧里阴符羞看，夜深刺股徒劳。","青溪休说寿松乔，笑尔车中难保。"],0,"x435","清"],["西江月 其二 携家宿南涧山房","董元恺","词",["照处石泉晓镜，卷时山月帘钩。","隔窗小婢侍梳头。","不语暗垂红袖。","细听枝间唤妇，相随竹里登楼。","布帆影漾绿杨舟。","昨夜溪边泛酒。"],0,"x435","清"],["应天长 其一 秋闺，集唐词","董元恺","词",["玉京人去秋萧索。","愁眉敛翠春烟薄。","倚兰桡，卷珠箔。","前事岂堪重想着。","酒醒情怀恶。","灯背小窗高阁。","离魂何处飘泊。","柳阴烟漠漠。"],0,"x435","清"],["应天长 其二 闺人刺绣，和王阮亭先生韵","董元恺","词",["水精帘卷东风院。","枝上流莺声百啭。","绿窗轻，香梦软。","清泪朝朝曾洗面。","砌痕深，花样浅。","出水芙蕖波溅。","绣到鸳鸯偏倦。","恼乱针和线。"],0,"x435","清"],["惜分飞 胆瓶中梅菊","董元恺","词",["冬尽平芜芳草绿。","开到春梅秋菊。","黄白新妆束。","亭亭一样人如玉。","淡月横斜疑影独。","却伴晚霜高躅。","风味看俱足。","林逋合傍陶潜宿。"],0,"x435","清"],["忆汉月 岭南芭蕉","董元恺","词",["终岁青青如许。","结就累累堪数。","绿阴满地绿天田，种熟万千丝缕。","细把愁心展，费几夜、春情机杼。","故乡风动北窗时，更著蕉衣销暑。"],0,"x435","清"],["滴滴金 咏腊梅花","董元恺","词",["玉人栀貌天然别。","换冰肌，涂娇额。","磬口檀心两奇绝。","映东篱颜色。","移来真蜡霜姿洁。","点酡酥，酿蜂蜜。","暖癸幽香擅冬日，逗春工消息。"],0,"x435","清"],["思远人 得闲信，和晏小山韵","董元恺","词",["劈开双鲤妆台信，报与平安客。","相思一点，伤心两字，远寄何由得。","东风泪裹珍珠滴。","和入乌丝墨。","染处忽惊红，似浓如淡，映桃花笺色。"],0,"x435","清"],["南柯子 春闺","董元恺","词",["柳影笼蛛网。","蕉阴映绮窗。","朝晖错认是残阳。","又是一番残梦，费思量。","清镜慵开匣，青衫慢𦶟香。","惊魂风里絮悠扬。","恰趁花间蝴蝶，过东墙。"],0,"x435","清"],["醉红妆 灯夜纪艳","董元恺","词",["相携女伴怯风凉。","欲添衣，又进房。","朝来新样绣鞋帮。","更换着，是谁长。","就中眉鬓独窥郎。","狂眼看，一时忙。","拾得玉𫸩犀合子，难暗认，试猜详。"],0,"x435","清"],["醉花阴 九日饮豫章城楼，和李清照重阳韵","董元恺","词",["城隅渌水明于画。","烟霭笼晴兽。","无恙是黄花，不奈西风，吹入征衫透。","一樽那管身前后。","好挹浮丘袖。","莫更去登高，满眼江山，赚得人清瘦。"],0,"x435","清"],["玉团儿 咏猫","董元恺","词",["深闺驯绕闲时节，卧花茵，香团白雪，爪住湘裙，回身欲捕，绣成双蝶。","春来更惹人怜惜，怪无端、鱼羹虚设。","暗响金铃，乱翻鸳瓦，把人抛撒。"],0,"x435","清"],["杏花天 咏千叶杏花","董元恺","词",["千丝雨湿东风剪。","短墙外、红轻翠软。","绛绡重叠胭脂浅。","艳夺桃花人面。","倚云栽、日边开遍。","和笑折、明霞舒卷。","一枝妒杀红儿见。","沽酒这家庭院。"],0,"x435","清"],["浪淘沙 七夕 新月一弓弯，乌鹊桥圜，云帡缥缈度银湾。天上恐无莲漏滴，忘却更残","董元恺","词",["莫为见时难，锦泪潸潸。","有人犹自独凭阑。","若果一年真一度，还胜人间。"],0,"x435","清"],["摘红英 美人饲金鱼","董元恺","词",["晴光漏。","清阴昼。","风吹细縠双纹皱。","春波影，秋波映。","一片香云，游鱼惯认。","横钗溜。","连钱覆。","殷勤粉饵烦纤手。","波痕定。","波心并。","嗔郎惊散，邀郎闲凭。"],0,"x435","清"],["双调望江南 西湖曲十首 其一","董元恺","词",["湖上水，风起浪纹平。","几叶丝垂鹅子淡，半篙烟染鸭头清。","镜里放船行。","珠帘卷，初映晓妆成。","翠聚两峰眉黛簇，碧含一水眼波明。","荇藻更交横。"],0,"x435","清"],["双调望江南 西湖曲十首 其二","董元恺","词",["湖上月，风露满身幽。","银汉直垂千顷碧，琉璃冷浸一天秋。","长啸倚楼头。","三潭好，辍棹且夷犹。","弄影欲骑鹏翼去，清光偏共酒樽留。","易值此宵不。"],0,"x435","清"],["双调望江南 西湖曲十首 其三","董元恺","词",["湖上柳，低傍六桥移。","罗幔暗窥慵望眼，画帘高卷细舒眉。","玉笛不胜吹。","谁攀折，才起欲眠时。","乱掷莺梭惊两两，轻翻燕剪几丝丝。","肠断柳枝词。"],0,"x435","清"],["双调望江南 西湖曲十首 其四","董元恺","词",["湖上花，掩映绿窗纱。","曲院风摇仙子步，苏堤春醉美人家。","烂漫自交加。","堪竞赏，开遍海棠花。","晓起一枝和露折，午阴几树带溪斜。","十里灿晴霞。"],0,"x435","清"],["双调望江南 西湖曲十首 其五","董元恺","词",["湖上女，三五唤同群。","浮渲梳头花样髻，轻拖窣地月华裙。","低拜岳王坟。","回步屧，敛袂向湖滨。","力怯却嫌夫婿隔，路欹微向侍儿嗔。","宜笑总宜颦。"],0,"x435","清"],["双调望江南 西湖曲十首 其六","董元恺","词",["湖上草，漠漠复迢迢。","绣陌浓铺罗绮席，香尘暗惹绿裙腰。","凭遍木兰桡。","寒食近，第一映波桥。","斜影铁嘶金勒动，泪痕珠送纸钱烧。","著处梦魂消。"],0,"x435","清"],["双调望江南 西湖曲十首 其七","董元恺","词",["湖上雨，景色淡空蒙。","几处楼台迷倒影，满溪烟树失高峰。","曲港小船通。","西泠路，千涧响淙淙。","破竹泉高天界水，翻经声和上方钟。","游屐片云封。"],0,"x435","清"],["双调望江南 西湖曲十首 其八","董元恺","词",["湖上舫，红粉漾晴空。","绣幕微褰清影里，纱窗半启碧波中。","小泊断桥东。","凭栏望，心事暗惺忪。","六曲银屏妆镜晓，一帘春水黛痕浓。","摇入藕花丛。"],0,"x435","清"],["双调望江南 西湖曲十首 其九","董元恺","词",["湖上酒，日带杖头钱。","竹叶杯浮桃叶伎，梨花春酿杏花天。","一醉酒家眠。","停觞处，珍重客中餐。","底事沉吟又如笑，几回温却又重寒。","愁绪忽漫漫。"],0,"x435","清"],["双调望江南 西湖曲十首 其十","董元恺","词",["湖上雪，六出正弥漫。","白尽青山绿鬓改，银装琼砌玉楼寒。","翠袖倚栏杆。","乘兴去，凄断六桥湾。","苏小梦迷油壁杳，林逋魂绕暗香闲。","斜湿酒旗还。"],0,"x435","清"],["芳草渡 松陵舟中送别","董元恺","词",["吴江碧，吴山青。","兰风起，满洞庭。","骊歌愁绝不堪听。","从兹去，郎乘马，妾扬舲。","还则愿。","尘吹转。","辙迹随郎近远。","怀明月，指双星。","相向冥。","郎抱影。","妾倚形。"],0,"x435","清"],["金凤钩 咏绣鞋","董元恺","词",["昨宵绣，幕曾近。","怪花底、湘帘初褪。","纤如钩月，柔如削玉，掌上看来越韵。","莲踪一捻莲痕印。","向洛浦、香尘微衬。","双双彩雀，盈盈罗袜，稳称凌波身分。"],0,"x435","清"],["鹧鸪天 其一 灯前花影","董元恺","词",["醒写精神醉写容。","柔枝无力倚帘栊。","衬将皓月分肥瘦，笼得轻烟别淡浓。","青镜畔，碧纱中。","兰膏烧彻转玲珑。","欲教移入罗帏里，好把红缸照院东。"],0,"x435","清"],["鹧鸪天 其二 月下灯花","董元恺","词",["金波滟滟玉缸融。","碧蕊离离白路浓。","笑剔芳心凝兔影，暗添喜色映蟾宫。","银汉北，画堂东。","花开偏照百花丛。","嫦娥此夜休垂泪，落尽垂珠一穗中。"],0,"x435","清"],["鹧鸪天 其一 闻鹧鸪","董元恺","词",["楚水吴山何限情。","透花窥鸟最分明。","惟奈瘴烟笼饮啄，亦悔梅岭阻归程。","一片雨，五音清。","无那春风欲送行。","秦人只解歌为曲，歌按秦楼梦不成。"],0,"x435","清"],["鹧鸪天 其二 春闺","董元恺","词",["弱柳千条杏一枝。","已凉天气未寒时。","故将别泪和乡泪，莫遣佳期更后期。","两不见，暗相思。","浅深更漏妾偏知。","低头闷把衣襟撚，为报春风且莫吹。"],0,"x435","清"],["鹧鸪天 其三 春情","董元恺","词",["远客辞家月再圆。","绿杨如发雨如烟。","梁间燕子闻长叹，楼上花枝照独眠。","兴又寝，倚阑干。","各自当情各自欢。","回身泣向寥天月，恰漏清光落枕边。"],0,"x435","清"],["鹧鸪天 其四 秋闺","董元恺","词",["山槛晴归漠漠烟。","绿窗红泪冷涓涓。","长疑好事皆虚事，可得潸然是偶然。","兰烛烬，江波连。","当时惆怅不曾眠。","起来自擘纱窗破，病眼开时月正圆。"],0,"x435","清"],["鹧鸪天 其五 即席","董元恺","词",["莫怪频频上此台。","翠萝深处遍苍苔。","能令瀑水清人境，更取峰霞入酒杯。","堤柳动，野荭开。","林下轻风待落梅。","从来此地黄昏散，往事空成半醉来。"],0,"x435","清"],["玉楼春 其一 春怀","董元恺","词",["丈夫飘荡今如此。","更上江楼望江水。","论交却忆十年时，怀袖未消三岁字。","江柳影寒新雨地。","无限幽芳徒欲寄。","二月春风最断肠，一梦不须追往事。"],0,"x435","清"],["玉楼春 其二 忆故园诸友","董元恺","词",["闻道毗陵诗酒兴。","何事经年断书信。","相期共斗管弦来，今日知音一留听。","玉漏声长灯耿耿。","星汉渐移庭竹影。","寒林晓际别生春，暗数残更不成寝。"],0,"x435","清"],["玉楼春 其三 春情","董元恺","词",["帘卷青山巫峡晓。","红艳影多风袅袅。","今日残花昨日开，月色更添春色好。","蝴蝶晴连池岸草。","客枕幽单看春老。","夜深微雨醉初醒，惆怅旧游无复到。"],0,"x435","清"],["玉楼春 其四 春怨","董元恺","词",["年年纵有春风便。","楚竹离声为君变。","点破繁华四五枝，零落胭脂两三片。","未解多情梦梁殿。","几度相思不相见。","为他人作嫁衣裳，粉泪凝珠滴红线。"],0,"x435","清"],["玉楼春 其五 秋村","董元恺","词",["日暮东风芳草绿。","衰柳寒芜绕茅屋。","百树鸡桑半顷麻，数尺丝纶一竿竹。","此处挂冠凉自足。","黄菊倚风村酒熟。","有时新月傍帘钩，唱到白苹洲畔曲。"],0,"x435","清"],["玉楼春 其六 山行有怀","董元恺","词",["京邑旧游劳梦想。","中岳深林人独往。","数村残照半岩阴，十亩春蔬一藜杖。","一度相思一惆怅。","心在君家辘轳上。","随风好去落谁家，杨柳败梢飞叶响。"],0,"x435","清"],["瑞鹧鸪 闺情，集唐诗","董元恺","词",["日照深红几树丝。","只应闲看一枝枝。","孤溪月满维舟夜，分隔休灯灭烛时。","多为过防成后悔，谁怜梦好转相思。","纤腰舞尽春杨柳，惟有春风仔细知。"],0,"x435","清"],["瑞鹧鸪 其一 赋得春雪梅花，和东坡韵","董元恺","词",["元辰稷雪雨廉纤。","春色寒威分外严。","冷蕊半成云母树，冰盘疑贮水晶盐。","集衣似觉凝香艳，索笑还宜卧画檐。","不道笛中歌一曲，东风吹彻万山尖。"],0,"x435","清"],["瑞鹧鸪 其二 赋得春雪梅花，和东坡韵","董元恺","词",["寒光初积暗金鸦。","九陌争传咏雪车。","上苑有香堪共影，群山无数独开花。","黄昏月动王恭氅，缟带烟迷苏小家。","应是争春梅雪共，广平新赋手频叉。"],0,"x435","清"],["瑞鹧鸪 其三 赋得春雪梅花，和东坡韵","董元恺","词",["仙人剪水合秾纤。","洒竹侵松势更严。","入户只应飞玉女，卷帘讵是刻无盐。","孤根欲暖霜滋晓，五出无尘月挂檐。","何事满空飘瑞叶，一枝斜压还峰尖。"],0,"x435","清"],["瑞鹧鸪 其四 赋得春雪梅花，和东坡韵","董元恺","词",["涂窗谁识暮栖鸦。","和雨和烟畏日车。","春到江南花是雪，月残辽海雪成花。","天因不夜银千顷，水更无声玉万家。","便使剡溪乘兴去，横枝遥见酒旗叉。"],0,"x435","清"],["南乡子 秋闺月夜","董元恺","词",["极目海天空。","碾就冰轮照碧峰。","渐有清光穿入户，玲珑。","玉臂云鬟素影中。","独自倚梧桐。","怅望银河待好风。","夜半若随千里梦，相逢。","皎洁随君处处同。"],0,"x435","清"],["南乡子 其一 下第别诸同年出都","董元恺","词",["春别洛阳城，又见新书甲乙名。","国器旧知收片玉，登瀛。","历历银钩指下生。","斜月入前楹。","心仰莲峰望太清。","春色年来谁是主，无成。","半在云霄觉更荣。"],0,"x435","清"],["南乡子 其二 西归道中","董元恺","词",["残月下寒沙。","北斗阑干南斗斜。","千里不辞行路远，天涯。","独自狂夫不忆家。","何处得停车。","又见秦城换物华。","白雪却嫌春色晚，飞花。","深掩虚窗卧碧纱。"],0,"x435","清"],["南乡子 其三 送金明府归里","董元恺","词",["文苑振金声。","竹绕琴堂水绕城。","愿以深心留善政，高名。","朝野咸推重太平。","县鼓应鸡鸣。","桥上春风绿野明。","若使巢由同此意，簪缨。","笑引江帆带月行。"],0,"x435","清"],["南乡子 其四 旅馆对月","董元恺","词",["月色白如霜。","一片山花落笔床。","检得旧书三四纸，成行。","惟到樽前似故乡。","不是少清光。","依旧明朝在路旁。","莫道蓟门秋信少，衡阳。","转觉愁随夜夜长。"],0,"x435","清"],["南乡子 其五 闺情","董元恺","词",["归棹隐孤舟。","水带离声入梦流。","锦字织成添别恨，悠悠。","笑摘青梅叫阿侯。","红烛乍迎秋。","风物凄凄宿雨收。","山色正来衔小苑，高楼。","莫向银台半夜游。"],0,"x435","清"],["南乡子 其六 闺思","董元恺","词",["谷鸟一声幽。","莫遣杨花笑白头。","先向红妆添晓梦，新愁。","云物凄清拂曙流。","共作草堂游。","次第看花直到秋。","况是故园摇落夜，登楼。","罗绮晴骄绿水洲。"],0,"x435","清"],["南乡子 其七 少年行","董元恺","词",["惊起欲栖乌。","骏马翩翩新虎符。","五凤街头闲勒辔，金吾。","犹暇怜诗爱酒无。","渺渺戍烟孤。","笑倚春风杖辘轳。","相忆杏花坛上去，樗蒲。","只有挼莎更一呼。"],0,"x435","清"],["南乡子 其八 旅怀","董元恺","词",["江静晚烟浓。","二十年来万事同。","夜半酒醒人不觉，秋风。","晓月当帘挂玉弓。","不复旧时容。","砚匣留尘尽日封。","汉水楚云千万里，无穷。","半在邯郸驿树中。"],0,"x435","清"],["南乡子 其九 春兴","董元恺","词",["岚翠湿人衣。","或棹轻舟或杖藜。","一院落花无客醉，莺啼。","逸处能高怨处低。","夜妒燕双栖。","回看池塘影渐稀。","唯有教坊南畔草，萋萋。","空使王孙见即迷。"],0,"x435","清"],["南乡子 其十 春情","董元恺","词",["更遣几年回。","石径春风长绿苔。","此夜断肠人不见，徘徊。","昨夜缘何入梦来。","江上落残梅。","莫惜芳时醉酒杯。","心似百花开未得，春催。","坐对寒松手自栽。"],0,"x435","清"],["南乡子 其十一 春雪早行","董元恺","词",["莫道梦魂遥。","六出飞花处处飘。","独倚破帘闲怅望，春朝。","雪满长安酒价高。","跃马上河桥。","菰叶风翻绿剪刀。","为近都门多送别，长条。","力不禁风旋旋销。"],0,"x435","清"],["南乡子 其十二 秋日遣兴","董元恺","词",["乘兴且长歌。","身外功名一任他。","自欲放怀犹未得，如何。","寂历秋花野意多。","芳草渐成窠。","镜水无风也自波。","纵有邻人解吹笛，谁过。","空苑凫鹥占浅莎。"],0,"x435","清"],["南乡子 其十三 秋感","董元恺","词",["香桂折新柯。","紫陌金堤映绮罗。","莫是长安行乐地，蹉跎。","旧路依然此重过。","顾影逗轻波。","到处闲门长薜萝。","休唱开元供奉曲，无多。","落叶纷纷暮雨和。"],0,"x435","清"],["南乡子 其十四 西江岁暮，送友入都","董元恺","词",["相亿一欣然。","何处韶光最可怜。","别后依依寒食里，东田。","沙岸蒲帆隔野烟。","湓水暮连天。","愁见孤城落日边。","共说京华旧游地，潸然。","明日春风又一年。"],0,"x435","清"],["南乡子 其十五 春闺即事","董元恺","词",["长望涕沾巾，深院无人独倚门。","惆怅春归留不得，黄昏。","静夜名香手自焚。","邀我对芳樽。","蝉翅低从两鬓分。","唯有风光与踪迹，销魂。","图遗萧郎问泪痕。"],0,"x435","清"],["南乡子 其十六 闻鹧鸪","董元恺","词",["格磔鹧鸪啼。","暖戏平芜锦翼齐。","日晚长烟高岸近，峰低。","苦竹岭头人未归。","此路不堪迷。","一向南飞又北飞。","惆怅一年春又去，依依。","莫动哀吟易惨凄。"],0,"x435","清"],["南乡子 其十七 病起读庄子","董元恺","词",["俯首视烟霞。","云蔽长安路更赊。","藜杖移时挑细药，幽花。","洞口人家日易斜。","不得问丹砂。","席上馀杯对早茶。","销得人间无限事，南华。","斗觉霜毛一半加。"],0,"x435","清"],["南乡子 其一 江楼","董元恺","词",["飒飒鬓毛苍。","北望伤神坐北窗。","厚禄故人书断绝，凄凉。","日满楼前江雾黄。","恩岂布衣忘。","青史无劳数赵张。","虚阁卷帘图画里，潇湘。","指点银瓶索酒尝。"],0,"x435","清"],["南乡子 其二 送友","董元恺","词",["春色泪痕边。","日短江湖白发前。","锦席淹留还出浦，回船。","忽漫相逢是别筵。","万一故人怜。","老去新诗谁与传。","古往今来皆涕泪，风烟。","信有人间行路难。"],0,"x435","清"],["南乡子 其三 南归，遇北来友人","董元恺","词",["容易失沉沦。","路难悠悠常傍人。","不为困穷宁有此，须亲。","白水青山空复春。","对酒满壶频。","户牖凭高发兴新。","正是江南好风景，逢君。","更恐归飞隔暮云。"],0,"x435","清"],["南乡子 其一 微泉阁遣怀，呈家叔","董元恺","词",["倚杖小池边。","半采红莲半白莲。","辜负春风杨柳曲，今年。","犹有些些旧管弦。","相对一陶然。","半醉行歌半坐禅。","绿竹挂衣凉处歇，时眠。","免被饥寒婚嫁牵。"],0,"x435","清"],["南乡子 其二 秋日怀友","董元恺","词",["非病亦非眠。","况是秋阴欲雨天。","惟觅少年心不得，依然。","老后谁能惜酒钱。","久结静中缘。","满地槐花满树蝉。","何处曾经同望月，堂前。","池畔犹应泊旧船。"],0,"x435","清"],["南乡子 闺情，集李义山句","董元恺","词",["恼带拂鸳鸯。","又入卢家妒玉堂。","见我佯羞频照影，游郎。","不信年华有断肠。","金斗熨沉香。","玉殿秋来夜正长。","直道相思了无益，轻狂。","欲拂尘时簟竟床。"],0,"x435","清"],["南乡子 其一 春闺","董元恺","词",["鹦鹉伴人愁。","情绪牵人不自由。","正是落花寒食夜，南楼。","半镜随郎葬杜邮。","敛笑慢回头。","韩寿香焦亦任偷。","此际别人应未觉，风流。","眼意心期卒未休。"],0,"x435","清"],["南乡子 其二 闺情","董元恺","词",["闲画两鸳鸯。","院宇秋明日日长。","蜀纸麝煤沾笔兴，茶香。","懒对菱花晕晓妆。","怯见上空床。","半夜潜身入洞房。","光景旋销惆怅在，凄凉。","风月应知暗断肠。"],0,"x435","清"],["虞美人 其一 本意","董元恺","词",["霜花溅血乌江路。","的是君王误。","鸿门玉斗怪当年。","不教虞兮舞剑、向樽前。","芳魂随向江东渡。","犹作花枝舞。","彘也堪怜雉也妖。","笑问汉王遗恨、几时消。"],0,"x435","清"],["虞美人 其二 过虞姬墓","董元恺","词",["孤坟遥枕荒祠右。","过客频回首。","帐中夜舞不胜情。","化作千年舞草、尚如生。","八千祗有虞兮在。","儿女英雄槩。","刘郎宫寝付寒烟。","留取美人黄土、大王前。"],0,"x435","清"],["虞美人 其一 闺情","董元恺","词",["玉炉香暖频添炷。","起坐浑无绪。","堕阶萦藓舞愁红。","薄晚春寒无奈、落花风。","楼高不见章台路。","更引流莺妒。","数声和月到帘栊。","惊破碧窗残梦、花屏空。"],0,"x435","清"],["虞美人 其二 闺恨","董元恺","词",["南园满地堆轻絮。","梁燕双来去。","归时休照烛花红。","楼上月明三五、琐窗中。","好是向人柔弱处。","一梦云兼雨。","觉来枕畔怯晨钟。","还是去年今日、恨应同。"],0,"x435","清"],["虞美人 其三 春情","董元恺","词",["已知前事无寻处。","春恨如何去。","晓莺帘外语花枝。","说尽人间天上、两心知。","枕上夜长长似岁。","思梦时时醒。","越罗衣褪郁金黄。","髻慢钗横无力、纵猖狂。"],0,"x435","清"],["春去也 春愁","董元恺","词",["春来风雨侬愁做。","送得春归，却是愁来路。","愁来原是共春来，春归不带愁同去。","愁欲留春少驻。","春竟抛愁独去。","何如索性不逢春，一年长在愁边住。"],0,"x435","清"],["鹊桥仙 其一 七夕柬范龙仙","董元恺","词",["蛛丝暗卜，彩线频穿，此夜倚栏多少。","纵教痴绝似牵牛，偏消受、天孙机巧。","百子池边，长生殿里，一点梦魂难到。","被驱原只为逋钱，料天也、应须一笑。"],0,"x435","清"],["鹊桥仙 其二 舟夕口占，赠萧北江","董元恺","词",["文园妙手，词坛骏足，兼擅谁如卿者。","横吹铁笛问婵娟，又何减、君家思话。","弦歌城外，射书濠畔，到处溪山如画。","凭阑永夜听清谈，看亹亹、从天而下。"],0,"x435","清"],["夜行船 其一 咏萤","董元恺","词",["露冷纱窗梧影暗。","却数点、疏星零乱。","叶底轻沾，花梢低映，长向琴书作伴。","飞上钗梁云影畔。","偏照出、晚妆娇情。","带雨才来，随风忽去，恐惹多情纨扇。"],0,"x435","清"]]