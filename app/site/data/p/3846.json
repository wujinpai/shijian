[["鹧鸪天 其十七","赵尊岳","词",["欲诉年时宛转心。","离歌按谱不成音。","参差竹较情长短，潋滟杯含意浅深。","愁伫雁，怯闻砧。","阑干也自倦凭临。","斜阳未省人惆怅，来照屏间孔雀金。"],0,"x236","近现代"],["鹧鸪天 其十八","赵尊岳","词",["粉倩夫渠逗晓凉。","翠深眉岫衬朝阳。","呢喃乳燕依烟树，夭矫朱藤引露床。","闲展卷，漫焚香。","如年佳日梦余长。","沉瓜浮李清无奈，更劝芳醪进一觞。"],0,"x236","近现代"],["鹧鸪天 其十九","赵尊岳","词",["无语斜晖送暮春。","晚晴犹说最宜人。","半黄杨柳牵情绪，未雪梨花作梦云。","寒尚峭，暖微醺。","青回草色似罗裙。","高唐十二峰何许，云便无心也忆君。"],0,"x236","近现代"],["生查子 其一","赵尊岳","词",["春红咽杜鹃，晚翠迷骢马。","说似不如归，璧月檀栾夜。","燕子最多情，争忍辞王谢。","应念倚阑人，望极斜阳下。"],0,"x236","近现代"],["生查子 其二","赵尊岳","词",["有恨枝上花，无定风前柳。","花柳恰撩人，可奈分携后。","芳池水自春，底事干卿皱。","道是不干卿，还更浓于酒。"],0,"x236","近现代"],["生查子 其三","赵尊岳","词",["垂杨千万丝，比似愁多少。","杜宇一声声，催得啼莺老。","深意拂云蓝，寄与君知道。","明镜玉芙蓉，长保朱颜好。"],0,"x236","近现代"],["生查子 其四","赵尊岳","词",["翠袖倚荪桡，花路迷烟浦。","得似彩鸳栖，已忍莲心苦。","眼底惜微波，欲托浑无语。","波外远山青，画出颦眉否。"],0,"x236","近现代"],["生查子 其五","赵尊岳","词",["微红泛脸波，薄醉融涡晕。","萦损玉炉烟，兰麝催人困。","衔花燕未归，帘幕黄昏近。","暝色度疏钟，故故传幽恨。"],0,"x236","近现代"],["生查子 其六","赵尊岳","词",["文鸳不解愁，秋信惊团扇。","障扇脱红衣，蚤被文鸳见。","露重月偏明，来照啼妆面。","望极楚云深，只赤凌波怨。"],0,"x236","近现代"],["生查子 其七","赵尊岳","词",["横塘并蒂花，花底双鸳住。","香梦莫频惊，越女摇船去。","娇云罨麝波，回首相思路。","载得月明归，记省鸳栖处。"],0,"x236","近现代"],["生查子 其八","赵尊岳","词",["罨翠画帘深，临水高楼住。","倒影俛遥山，忆别伤南浦。","凭阑伫夕阳，高处凉于雨。","清怨入云罗，呜咽春鸿语。"],0,"x236","近现代"],["生查子 其九","赵尊岳","词",["卐文阑巧回，心字香频袅。","玉笛落谁家，幽趣人知少。","辛苦盼团𪢮，嫞向姮娥道。","兰夜恰初三，妒煞纤眉好。"],0,"x236","近现代"],["生查子 其十","赵尊岳","词",["日斜山额黄，草暗裙腰绿。","无语凭阑干，倦倚湘江曲。","柳丝情短长，怪底三眠足。","燕燕不知愁，夜夜双双宿。"],0,"x236","近现代"],["生查子 其十一","赵尊岳","词",["春纤注玉徽，的的弦中意。","未解别离难，却道寻春易。","芳约旧湔裙，记拾溪头翠。","皱水作潆洄，得似关心事。"],0,"x236","近现代"],["生查子 其十二","赵尊岳","词",["金风玉露时，画意诗情足。","素月浣清光，掩映帘波绿。","吹残紫玉箫，不尽相思曲。","苦恨梦中逢，一例分携促。"],0,"x236","近现代"],["生查子 其十三","赵尊岳","词",["云山千万重，消息凭谁问。","风伫杏鬟香，雨忆梨涡润。","能得梦中来，便拟天涯近。","夜夜卜灯花，何止双鱼信。"],0,"x236","近现代"],["南乡子 其一","赵尊岳","词",["官渡狎春潮。","芳草堤边小画桥。","系得吴娃双桨住，娇娆。","解意新莺纤露条。","芳信近花朝。","水市饧香入洞箫。","无那绿波将别恨，云迢。","容易相逢梦亦遥。"],0,"x236","近现代"],["南乡子 其二","赵尊岳","词",["吹到杏花风。","薄困人如宿酒中。","蛱蝶柳花悠飏里，初逢。","浅约宫眉笑靥浓。","幽恨璅窗茸。","劳恰西飞燕又东。","两地相思谁与寄，应同。","愁煞雕阑一角红。"],0,"x236","近现代"],["南乡子 其三","赵尊岳","词",["小别恰成悲。","忍折长亭弱柳枝。","鬯好月圆花正发，相期。","闻早归来莫漫迟。","禁得几相思。","颠到由来为远离。","容易梦寻莺又唤，醒时。","画里屏山学翠眉。"],0,"x236","近现代"],["南乡子 其四","赵尊岳","词",["欲拾坠欢难。","彊把秦筝取次弹。","一桁湘帘闲卷处，花残。","翠袖香痕十二阑。","生怕锦衾寒。","拨火浓熏费麝檀。","明月可知人意倦，宵阑。","却照银屏画阁间。"],0,"x236","近现代"],["南乡子 其五","赵尊岳","词",["苦恨蕙炉香。","篆烟萦袅绣鸳鸯。","绣倦香销愁极目，银床。","月转庭梧影渐长。","仙袂露华凉。","玉清应怨锁瑶房。","如此凉天如此夜，能忘。","怪底人间铁石肠。"],0,"x236","近现代"],["南乡子 其六","赵尊岳","词",["芳约总成虚。","梦醒还怜抱影孤。","薄似云罗浑未信，难期。","念取韶华豆蔻初。","临水托双鱼。","珍重离情子细书。","别后玉容长想望，谁如。","消得文园病渴无。"],0,"x236","近现代"],["南乡子 其七","赵尊岳","词",["浅黛映纤眉。","杨柳阴中玉笛吹。","赚取多情双燕子，斜飞。","衔得香泥未肯归。","妍暖踏青期。","促绣闺中圣得知。","年少谁家金勒马，来迟。","紫陌尘香月上时。"],0,"x236","近现代"],["清平乐 其一","赵尊岳","词",["行行且住。","莫向天涯去。","吹尽柳绵芳草路。","总是旧经行处。","望中水碧山青。","长亭树色无情。","珍重玉珰缄札，防它去雁难凭。"],0,"x236","近现代"],["清平乐 其二","赵尊岳","词",["池塘梦草。","容易春来了。","不恨绿窗春睡少。","念取啼莺娇小。","东风倦倚筝琶。","峭寒犹怯纹纱。","惆怅佳人翠袖，凄其公子清华。"],0,"x236","近现代"],["清平乐 其三","赵尊岳","词",["花娇钿小。","心绪知多少。","春梦如烟萦碧草。","锦瑟年华愁老。","红笺自和新词。","绿窗莫问归期。","归在荼䕷开后，诗成燕子来时。"],0,"x236","近现代"],["清平乐 其四","赵尊岳","词",["金猊篆小。","日映云屏早。","昨夜东风春未老。","薄暖轻寒都好。","小窗罗幕低垂。","雕梁燕子来迟。","心事天涯芳草，眉痕花底新词。"],0,"x236","近现代"],["清平乐 其五","赵尊岳","词",["愁春不尽。","望断双鱼信。","飞絮落花欺翠鬓。","最是春酲初醒。","浮云西北高楼。","珠帘得似扬州。","可奈黄昏细雨，峭寒都在琼钩。"],0,"x236","近现代"],["清平乐 其六","赵尊岳","词",["画廊回处。","燕子双飞去。","细草如茵花满路。","迢递年时芳绪。","远山犹妒眉开。","钿车万一重来。","莫遣玉龙吹彻，吴侬最惜残梅。"],0,"x236","近现代"],["清平乐 其七","赵尊岳","词",["翠猗微皱。","佳约湔裙后。","花底持觞回彩袖。","𣨼酒情怀依旧。","归来杨柳梢头。","杜鹃说与春愁。","那更东风无赖，落红飞入层楼。"],0,"x236","近现代"],["清平乐 其八","赵尊岳","词",["瑶阶斗草。","响屧人来早。","香径落英嫞不扫。","恰似春光未老。","酬春写遍笺长。","余情更付壶觞。","消得海棠沉醉，红阑一角斜阳。"],0,"x236","近现代"],["清平乐 其九","赵尊岳","词",["绿颦红怨。","著意光风转。","别后思量谁得见。","一日绕花千遍。","银钩锦字分明。","赪鳞苍雁难凭。","祇有梁间燕子，见人无那深情。"],0,"x236","近现代"],["清平乐 其十","赵尊岳","词",["梦中芳意。","雨滴空阶碎。","坐拥罗衾思往事。","苦恨韶光如寄。","愁听邻院丝桐。","雨余残月朦胧。","依约两潮声里，低徊五十弦中。"],0,"x236","近现代"],["清平乐 其十一","赵尊岳","词",["银河乍转。","梦里春宵宴。","按舞羽衣疑月殿。","摇曳玉阶柳线。","碧城十二凄迷。","罗衾不耐单栖。","画里屏山只赤，琼宵何处丹梯。"],0,"x236","近现代"],["清平乐 其十二","赵尊岳","词",["踏青人去。","折柳和轻絮。","柳外啼鹃啼不住。","曾是钿车行处。","残阳淡入烟昏。","藏鸦不见斜门。","裘马五陵年少，风流也黯吟魂。"],0,"x236","近现代"],["清平乐 其十三","赵尊岳","词",["金尊彩袖。","频献鹅黄酒。","不数天魔狂妒柳。","妙舞紫云长寿。","珠喉玉指冰弦。","红羞翠掩灯前。","绰约杏花半吐，清辉明月初圆。"],0,"x236","近现代"],["清平乐 其十四","赵尊岳","词",["梦余人醒。","小立凭阑定。","疏雨横塘烟外影。","红蓼白苹初静。","云鸿万里南征。","家山何处归程。","早是琼箫吹彻，不成河满声声。"],0,"x236","近现代"],["清平乐 其十五","赵尊岳","词",["夫容开遍。","芳景随流转。","斜月半规秋一片。","写出湖山清怨。","柳丝萦系堤边。","而今可似当年。","何处数声羌笛，有人重上吴船。"],0,"x236","近现代"],["清平乐 其十六","赵尊岳","词",["梦回还记。","梦里欢娱事。","浓到郁金春酒味。","未抵芳心密意。","上阶斜月侵寻。","篆香暗袭兰襟。","依约小苹风度，画屏银烛宵深。"],0,"x236","近现代"],["清平乐 其十七","赵尊岳","词",["嘶骢倦去。","紫陌寻春路。","百六韶光闲里度。","怕见将离开处。","相思极目云端。","眉痕澹冶春山。","回首旧游何许，梦魂昨夜阑干。"],0,"x236","近现代"],["清平乐 其十八","赵尊岳","词",["兰因莫问。","拌得相思分。","总为旧游萦旧恨。","人远却教日近。","年时绮席金钟。","而今水复山重。","长是愔愔庭院，花开犹似初逢。"],0,"x236","近现代"],["玉楼春 其一","赵尊岳","词",["日高深院愁春莫。","倦绿成阴新网户。","流莺惊醒玉楼人，独倚画阑吹柳絮。","梦中为雨为云处。","醒了却教巫峡去。","无情柳絮逐东风，飞过年时携手路。"],0,"x236","近现代"],["玉楼春 其二","赵尊岳","词",["帘波拂晓屏山莫。","眉也乍舒寒约住。","总然寒尽不成欢，愁满落花芳草路。","路歧毕竟曾相遇。","相遇谁教轻别去。","垂杨也为系斑骓，绿到天涯肠断处。"],0,"x236","近现代"],["玉楼春 其三","赵尊岳","词",["红牙旧曲传香素。","金谱新腔移雁柱。","醉余好梦几回圆，赚得芳春无处去。","花枝长好春长住。","底事春风欺弱絮。","春风无力鬓云低，弹彻伊州羞自觑。"],0,"x236","近现代"],["玉楼春 其四","赵尊岳","词",["飞红作雨香成阵。","苦恨将离消息近。","当归何事不归来，欲向柳梢眉月问。","柳梢盼断人无信。","眉月那知心上恨。","灯花鹊喜更无凭，祇是韶光容易尽。"],0,"x236","近现代"],["玉楼春 其五","赵尊岳","词",["春深花下传觞宴。","拨尽新笋倾别怨。","片风丝雨短长亭，梦草铺茵晴未遍。","明朝得似今朝健。","也羡沙鸥无聚散。","莫辞襟袖更淋浪，消领玉奴深意劝。"],0,"x236","近现代"],["玉楼春 其六","赵尊岳","词",["杏钿昼暖琉璃静。","百啭黄鹂枝上听。","东风吹彻绣帘深，怪底愁春犹未醒。","宫眉浅画窥妆镜。","柳叶菱花红翠影。","画眉休画远山眉，山远归期难与定。"],0,"x236","近现代"],["玉楼春 其七","赵尊岳","词",["轻云阁雨时光好。","杨柳眠吃花信早。","青春明镜彩鸾娇，碧月雕梁新燕小。","桂堂东畔多幽草。","苦恨凤鞋纤印少。","朅来愁病两侵寻，总被多情风月笑。"],0,"x236","近现代"],["玉楼春 其八","赵尊岳","词",["一声羌笛离亭晚。","吹彻东风回柳眼。","相催无奈马嘶频，临别且教尊酒满。","音书易断情无断。","珍重天涯寒共暖。","天涯寒暖总凄凉，写遍长笺犹恨短。"],0,"x236","近现代"],["玉楼春 其九","赵尊岳","词",["杜鹃啼彻春难住。","芳草织成春去路。","残寒萧瑟掩斜门，丝雨廉纤沾舞絮。","春长无奈归期误。","说与东风真负负。","东风祇解飏残红，红到杜鹃啼彻处。"],0,"x236","近现代"],["玉楼春 其十","赵尊岳","词",["珠喉掩抑筝尘里。","得似君歌能有几。","轻翻翠袂遏行云，乍破银瓶倾碧水。","拨弦转轴轮纤指。","不尽弦中深浅意。","风流纵得博人怜，锦瑟华年须惜起。"],0,"x236","近现代"],["玉楼春 其十一","赵尊岳","词",["秋容净似春酲醒。","月到花阴花罨镜。","镜奁长对影娥池，潋碧风微眉语静。","流萤飞去蘼芜径。","芳树倦雅栖未定。","此时情景恰宜诗，诗兴朅来能几剩。"],0,"x236","近现代"],["玉楼春 其十二","赵尊岳","词",["粉娘妆面芙蓉似。","端合小颦题小字。","宵深无奈画屏寒，梦浅却消银烛泪。","尊前最忆年时事。","弦上难论无限意。","蛮笺十样寄深情，情重去鸿禁得未。"],0,"x236","近现代"],["玉楼春 其十三","赵尊岳","词",["啼莺似唤钿车住。","莫向长亭芳草路。","香轮轧轧碾珠尘，最是人间肠断处。","柳眉浅画遥山妒。","柳絮情多黏绣户。","斑骓也莫怯征程，懊恨阳关催别去。"],0,"x236","近现代"],["玉楼春 其十四","赵尊岳","词",["宿酲初醒忺临镜。","风峭微松云雨鬓。","小园新绿渐成阴，深院落红如有信。","花风数尽情无尽。","瘦损为谁嫞自问。","玉箫吹彻别离声，犹有画帘工罨恨。"],0,"x236","近现代"],["玉楼春 其十五","赵尊岳","词",["消磨长日无长计。","凭遍回廊花满地。","篆烟萦绕茜窗纱，缕缕似传心上意。","伤心本事皆前事。","灌溉愁根除有泪。","不须弹泪向东风，此恨问天天亦醉。"],0,"x236","近现代"],["玉楼春 其十六","赵尊岳","词",["高楼不似吴云近。","消息楼头何处问。","珠吭可是旧时莺，还向刺桐花里认。","人人芳约难凭信。","日日番风吹别恨。","番风送得锦书来，蚤是侬愁消领尽。"],0,"x236","近现代"],["玉楼春 其十七","赵尊岳","词",["流莺啼处金丝软。","春似画图新渲染。","泥香消得燕衔忙，花亸恰如人醉浅。","楼台夕照闻歌管。","拾翠归来浑未晚。","晚风无绪不知愁，款款兰衾嫞自展。"],0,"x236","近现代"],["玉楼春 其十八","赵尊岳","词",["红绡换曲谁论价。","醉倒歌楼明月夜。","烧残龙脑梦常温，倚立凤帏人似画。","含情顾影菱花下。","绿映鬟云妆堕马。","娇颦忽逗倦眉尖，似忆宵深灯畔话。"],0,"x236","近现代"],["玉楼春 其十九","赵尊岳","词",["娇莺弱柳能歌舞。","柳外骢嘶知几度。","不成歌舞不关情，底事花时轻别去。","游丝袅遍墙东路。","祇是风流难约住。","风流天付与疏狂，冶叶倡条知甚处。"],0,"x236","近现代"],["玉楼春 其二十","赵尊岳","词",["琼英妒煞朱颜媆。","巧绾绿云新掠鬓。","香罗省识瘦腰围，手把花枝嫞对镜。","玉郎别后无音信。","去燕来鸿难借问。","千红万紫织浓春，得似回文诗里恨。"],0,"x236","近现代"],["玉楼春 其二十一","赵尊岳","词",["一枝香玉梅初绽。","卐字沈熏烟未散。","锦翻新样被池鸳，花卜归期灯足雁。","寒消三九宜芳盏。","可奈清尊愁倚惯。","总然拌醉得瞢腾，梦里为欢终有限。"],0,"x236","近现代"],["减字木兰花 其一","赵尊岳","词",["征帆目送。","从此一春无好梦。","驻马谁家。","刬地东风是处花。","黄昏易过。","吹彻玉笙愁入破。","有恨难忘。","那更楼高近夕阳。"],0,"x236","近现代"],["减字木兰花 其二","赵尊岳","词",["嘶骢曾住。","花外系人心眼处。","落尽红英。","风雨声中昨夜情。","归期未稳。","数尽番风余别恨。","一自春前。","琴为嫞弹祇惯眠。"],0,"x236","近现代"],["减字木兰花 其三","赵尊岳","词",["红芳满路。","最忆年事行乐处。","不分东风。","花信更番荏苒中。","愁来欲遍。","比似行春腰脚健。","薄暖轻凉。","天气浑如意短长。"],0,"x236","近现代"],["洞仙歌","赵尊岳","词",["芳菲满眼，锦织长干道。","莫负芳期被春笑。","伫缃桃、露重丝柳风微，香尘起，玉勒雕鞍不少。","眉山分黛绿，绣闼璚奁，绰约韶容更谁好。","舄凤蹴，袖鸾拖，锦瑟华年，须不让、琪花瑶草。","怪廿四花风太忽忽，误旧垒红襟，者回迟到。"],0,"x236","近现代"],["菩萨蛮 其一","赵尊岳","词",["低徊南浦垂杨路。","绿阴前度分携处。","再见若无缘。","月华休更圆。","心随流水去。","泪作黄昏雨。","泪雨尚多情。","月圆愁煞人。"],0,"x236","近现代"],["菩萨蛮 其二","赵尊岳","词",["愔愔画阁双双燕。","柳昏花暝常相见。","相见隔帘波。","隔帘春几多。","帘波风约住。","莫放韶光去。","日暮碧云天。","相思年复年。"],0,"x236","近现代"],["菩萨蛮 其三","赵尊岳","词",["尊回听彻娇莺语。","狂花俊煞天魔舞。","锦罽画堂西。","绿椒新壁泥。","人愁春易老。","春似人长好。","香雾湿菭衣。","绿肥红未稀。"],0,"x236","近现代"],["菩萨蛮 其四","赵尊岳","词",["瓶花弄色三分吐。","笼莺学舌无多语。","窗影度迟迟。","绿杨春几枝。","屏山幽梦浅。","不似吴云远。","云外有高楼。","相思楼上头。"],0,"x236","近现代"],["菩萨蛮 其五","赵尊岳","词",["华琚瑶碧香罗雪。","雕阑倚遍桐阴月。","辛苦伫归人。","璇玑图未成。","幽怀何处在。","钿约长留待。","一角小楼红。","度箫无奈风。"],0,"x236","近现代"],["菩萨蛮 其六","赵尊岳","词",["春寒浅浅荼䕷雪。","玉奴妆镜羞明月。","月也妒春容。","画阑回脸红。","春城喧笛鼓。","何处无歌舞。","舞罢怯余寒。","为谁腰带宽。"],0,"x236","近现代"],["菩萨蛮 其七","赵尊岳","词",["东风款梦屏山曲。","天涯望极蘼芜绿。","尽意托鹍弦。","难将心绪传。","小红春唱慢。","筝柱移银雁。","占断艳阳时。","流云歌外低。"],0,"x236","近现代"],["菩萨蛮 其八","赵尊岳","词",["阑深影贮梨花白。","番风不送归来客。","容易得相逢。","绣帏香梦中。","鱼笺疏远信。","怕说归期近。","却忆别离时。","斜门眉月低。"],0,"x236","近现代"],["菩萨蛮 其九","赵尊岳","词",["一春长是思量苦。","思量博得人知否。","灰不尽相思。","除非金鸭知。","春深肠断处。","花落春归路。","已是绿阴时。","好春侬负伊。"],0,"x236","近现代"],["阮郎归 其一","赵尊岳","词",["柳昏花暝雨廉纤。","烟颦怯翠奁。","闷人天气暖寒兼。","炉香嫞自添。","风乍峭，日长厌。","春魂荡绣帘。","帘深犹凝伫新蟾。","斜红恋画檐。"],0,"x236","近现代"],["阮郎归 其二","赵尊岳","词",["花蹊春服纤蝉纱。","轻红衬浅霞。","余寒犹妒鬓边雅。","残阳不肯斜。","占好景，惜芳华。","番风数惯差。","楝花开后更无花。","萧条燕子家。"],0,"x236","近现代"],["阮郎归 其三","赵尊岳","词",["兰房妆罢晚晴初。","风流谁得如。","凝颦嫞展寄来书。","八行无那疏。","怜梦远，惜吟孤。","春云自卷舒。","那堪云散约长虚。","约虚何似无。"],0,"x236","近现代"],["阮郎归 其四","赵尊岳","词",["一秋心事冷吴霜。","月移更漏长。","带围宽尽沈东阳。","无愁可有乡。","山黛绿，钿花黄。","相思不尽狂。","狂余却忆旧凄凉。","萦回寸寸肠。"],0,"x236","近现代"],["阮郎归 其五","赵尊岳","词",["春城长忆旧歌钟。","花前琥珀浓。","碧阑干外露华浓。","灯痕晕靥红。","翻舞曲，展颦容。","柔情薄醉中。","醉余欢事几时重。","频番廿四风。"],0,"x236","近现代"],["浣溪沙 其一","赵尊岳","词",["缟袂扶将醉倚梅。","幺禽啼彻梦频催。","梦回犹自恋深杯。","拗铁为枝新样巧，镌琼作骨化工才。","月移疏影上窗来。"],0,"x236","近现代"],["浣溪沙 其二","赵尊岳","词",["晓翠屏山六扇开。","璚云依约护芳梅。","梦中花路似肠回。","疏影暗香翻艳曲，吟笺赋笔费清才。","红罗亭畔约重来。"],0,"x236","近现代"],["浣溪沙 其三","赵尊岳","词",["十二阑干似碧城。","千条弱柳解将迎。","𣨼人烟景况清明。","绣幂鸳鸯偏弄色，玉笼鹦鹉自呼名。","凭谁诉与此时情。"],0,"x236","近现代"],["浣溪沙 其四","赵尊岳","词",["十里妍风试玉鞭。","画楼西畔驻香鞯。","绿阴佳处夕阳天。","细草织茵缠锦道，落花霏雪缀琼筵。","游春须不羡游仙。"],0,"x236","近现代"],["浣溪沙 其五","赵尊岳","词",["懊恨当楼一抹山。","为谁空翠约轻寒。","杜鹃声里日长闲。","芳约总随幽梦远，倦云莫误锦书还。","半灰心字惜香残。"],0,"x236","近现代"],["浣溪沙 其六","赵尊岳","词",["为爱春晴不掩关。","碧桃门巷柳阴闲。","惜花长自怕花残。","画阁峭寒鹦未睡，绣帘深下燕初还。","四条弦子诉愁难。"],0,"x236","近现代"],["浣溪沙 其七","赵尊岳","词",["酒不消愁懒更沽。","东君怪底费工夫。","花如渲染柳如梳。","门映笑桃前度护，梁栖海燕旧时卢。","年芳得似梦痕无。"],0,"x236","近现代"],["浣溪沙 其八","赵尊岳","词",["芳树移阴昼浅长。","游蜂未减一春狂。","玉珰消息误檀郎。","秦月总虚箫凤约，楚风不度袖罗香。","残寒依约早秋凉。"],0,"x236","近现代"],["浣溪沙 其九","赵尊岳","词",["无雨无花也闭门。","梦余寻遍梦中痕。","声声杜宇忆王孙。","往事金炉消翠缕，新愁罗幕罥黄昏。","天涯芳草黯吟魂。"],0,"x236","近现代"],["浣溪沙 其十","赵尊岳","词",["暖入莺吭醉眼醒。","梦回犹凭枕檀听。","小屏山作雨余青。","娇靥杏花窥画阁，香巢乳燕认池亭。","清明过也足春情。"],0,"x236","近现代"],["浣溪沙 其十一","赵尊岳","词",["翠罨凉阴晚放舟。","莲娃妆面怕花羞。","便将秋泛作春游。","祇有鸳鸯无别恨，肯教鸥鹭占清流。","小红桥下碧矶头。"],0,"x236","近现代"],["浣溪沙 其十二","赵尊岳","词",["笃耨嫞烧镇日闲。","钿钗残梦落花间。","屏山犹学旧烟鬟。","倚袖暗惊寒料峭，映帘生怕月环弯。","柳丝难系坠时欢。"],0,"x236","近现代"],["浣溪沙 其十三","赵尊岳","词",["百蝶能消六幅裙。","梦魂辛苦唤真真。","镜屏前度恨犹新。","怨极只拌金谷酒，情多谁似玉楼人。","好花开处不芳春。"],0,"x236","近现代"],["浣溪沙 其十四","赵尊岳","词",["帘幕风微莫雨收。","夕阳西下碧云留。","一声长笛十分秋。","金鸭无温罗袖薄，最先凉是最高楼。","辞巢双燕有离愁。"],0,"x236","近现代"],["浣溪沙 其十五","赵尊岳","词",["不信高楼百尺危。","凤箫端合倚云吹。","断肠空有梦魂飞。","月浅可能知别愁，灯昏暂许诉心期。","金风玉露似年时。"],0,"x236","近现代"],["浣溪沙 其十六","赵尊岳","词",["开到将离蝶恋香。","远山禁得几秋藏。","生憎小玉劝持觞。","银雁费声筝柱短，彩鸾延伫眼波长。","峭风吹絮缀钗梁。"],0,"x236","近现代"],["浣溪沙 其十七","赵尊岳","词",["特地明妆俊似仙。","杏花天气月初弦。","脸红眉翠映琼筵。","禁得暗香萦舞罢，可无幽恨𣨼尊前。","莲花婀娜赚人怜。"],0,"x236","近现代"],["浣溪沙 其十八","赵尊岳","词",["记浣红薇序玉台。","纹窗网户旧曾来。","一弯眉月似秦淮。","宝瑟清弦离恨谱，轻罗小扇合欢裁。","错疑飞梦到天台。"],0,"x236","近现代"],["浣溪沙 其十九","赵尊岳","词",["酒罢华灯未肯收。","绪风珠露暗凝秋。","笛声惊起夜眠鸥。","欲托微波增怅望，惯吟佳句怯新愁。","碧云深处是朱楼。"],0,"x236","近现代"],["浣溪沙 其二十","赵尊岳","词",["沉醉东风第几回。","清歌宛宛亦仙才。","好春珍重碧桃开。","月乍笼云疑暂别，柳将飞絮约重来。","余情得似最深杯。"],0,"x236","近现代"]]