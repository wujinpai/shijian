[["南乡子 落花","柳是","词",["拂断垂垂雨。","伤心荡尽春风语。","况是樱桃薇院也。","堪悲。","又有个人儿似你。","莫道无归处。","点点香魂清梦里。","做杀多情留不得，飞去。","愿他少识相思路。"],0,101,"清"],["金明池 寒柳","柳是","词",["有恨寒潮，无情残照，正是萧萧南浦。","更吹起、霜条孤影，还记得、旧时飞絮。","况晚来、烟浪迷离，见行客、特地瘦腰如舞。","总一种凄凉，十分憔悴，尚有燕台佳句。","春日酿成秋日雨。","念畴昔风流，暗伤如许。","纵饶有、绕堤画舸，冷落尽、水云犹故。","念从前、一点春风，几隔着重帘，眉儿愁苦。","待约个梅魂，黄昏月淡，与伊深怜低语。"],0,101,"清"],["满庭芳 留别无瑕词史   见汤漱玉《玉台画史》","柳是","词",["紫燕翻风，青梅带雨，共寻芳草啼痕。","明知此会，不得久殷勤。","约略别离时候，绿杨外、多少销魂。","重提起、泪盈红袖，未说两三分。","纷纷。","从去后，瘦憎玉镜，宽损罗裙。","念飘零何处，烟水相闻。","欲梦故人憔悴，依稀只隔楚山云。","无非是、怨花伤柳，一样怕黄昏。"],0,101,"清"],["十六字令","王时翔","词",["行。","红叶阶前响屧声。","无人见，凉月照残更。"],0,9,"清"],["浪淘沙","王时翔","词",["寒入小楼昏。","月色三分。","枣花帘子水沉熏。","一样绣针金剪地，位置偏文。"],0,9,"清"],["浣溪沙三十八首 其一","王时翔","词",["消减惟应鹊镜知。","压肩浓绿鬓鬟欹。","病容扶起淡黄时。","碧院无人春寂寂，画楼有燕雨丝丝。","药烟影里过相思。"],0,9,"清"],["浣溪沙三十八首 其二","王时翔","词",["小蕊猩红启瓠犀。","绿阴门巷有莺啼。","半障罗扇眼波低。","影似风前荷泻露，情如雨后絮黏泥。","恹恹斜日度花西。"],0,9,"清"],["浣溪沙三十八首 其三","王时翔","词",["晓起贪凉梦未圆。","轻车细马各争前。","满塍禾黍淡香传。","斜月犹明初魄夜，远山已瘦乍秋天。","一襟离思散疏烟。"],0,9,"清"],["浣溪沙三十八首 其四","王时翔","词",["初旭铜钲挂影圆。","笋舆斜驻柳庄前。","邮亭卯酒一杯传。","清露凝珠芳草陌，碧云铺縠嫩晴天。","人家茅屋未炊烟。"],0,9,"清"],["浣溪沙三十八首 其五","王时翔","词",["老未成名岁月空。","依刘赖与素心同。","高谈清啸意何穷。","愧我挟书成腐竖，爱他屠狗是英雄。","闲搔短发向秋风。"],0,9,"清"],["浣溪沙三十八首 其六","王时翔","词",["感叹驱车古道旁。","周都汉室已沦亡。","千年一闪堕残阳。","清洛冰声流碎白，古原柳色带深黄。","早冬天更做荒凉。"],0,9,"清"],["浣溪沙三十八首 其七","王时翔","词",["客里愁深与病兼。","成皋晓发渡巉岩。","北来九月气先严。","初日翳沙如月淡，薄霜侵面似刀铦。","篮舆空护一重帘。"],0,9,"清"],["浣溪沙三十八首 其八","王时翔","词",["彩扇轻遮画烛红。","卷帘微步玉丁东。","眼波低剪篆丝风。","梅额有香人澹澹，梨云无梦月胧胧。","暗惊雕刻费春工。"],0,9,"清"],["浣溪沙三十八首 其九","王时翔","词",["半是含娇半是佣。","宝钗欲堕翠鬟松。","锦窝情态为谁浓。","春浅花新招蛱蝶，夜寒香烬绣芙蓉。","一弯愁思驻螺峰。"],0,9,"清"],["浣溪沙三十八首 其十","王时翔","词",["觅藕寻莲好涉江。","明星虽烂有惊庞。","炉烟消尽拨银釭。","梦嚅吹兰闻绣枕，月边和影并红窗。","不应犹道未双双。"],0,9,"清"],["浣溪沙三十八首 其十一","王时翔","词",["小阁芳兰供一枝。","黄昏烧烛看幽姿。","素屏纤影对移时。","巫峡休猜成楚梦，湘皋惟借入骚辞。","国香长系美人思。"],0,9,"清"],["浣溪沙三十八首 其十二","王时翔","词",["秀色由来可疗饥。","忘餐相对复相依。","无端杜宇唤春归。","圆怕珠光多不定，轻愁花片易教飞。","赤阑干畔凭斜晖。"],0,9,"清"],["浣溪沙三十八首 其十三","王时翔","词",["一寸柔肠万里纡。","好天良夜怅离居。","独揩清泪五更余。","情重何妨添病重，形疏祗恐是心疏。","西楼斜月竟何如。"],0,9,"清"],["浣溪沙三十八首 其十四","王时翔","词",["绣帐轻褰起欲扶。","翠尖如揭晓山图。","绮窗花笑一尘无。","路近蓝田多美玉，梦经沧海尽明珠。","人间犹有阮郎孤。"],0,9,"清"],["浣溪沙三十八首 其十五","王时翔","词",["杨柳梧桐翠色齐。","小鸳么凤镇双栖。","梦中仙路有丹梯。","玉簟分明花气重，琐窗萧淡月痕低。","惺忪那易到如泥。"],0,9,"清"],["浣溪沙三十八首 其十六","王时翔","词",["小院秋光似画佳。","海棠红映绿莎阶。","几番闲立写风怀。","锦瑟怨时知意忤，玉琴调处识心谐。","可能亲递凤皇钗。"],0,9,"清"],["浣溪沙三十八首 其十七","王时翔","词",["绣榻凝尘画烛灰。","四垂帘幕映苍苔。","怯春人卧燕飞回。","花信不随风信发，愁丝偏接雨丝来。","冷清清地自惊猜。"],0,9,"清"],["浣溪沙三十八首 其十八","王时翔","词",["流水桃花一段春。","移舟洞口祗逡巡。","路迷惆怅在风尘。","俗客自伤难换骨，仙源谁许易通津。","始知薄福是渔人。"],0,9,"清"],["浣溪沙三十八首 其十九","王时翔","词",["谁把雕笼翡翠分。","相思两地不相闻。","绣帘遮断郁金裙。","新恨多于春后草，幽期变似夏来云。","杨花时节倚西曛。"],0,9,"清"],["浣溪沙三十八首 其二十","王时翔","词",["细雨尖风欲断魂。","落红庭院又黄昏。","麝烟金鸭被微温。","无计可令春睡稳，空言亦是玉人恩。","分明曾许拭啼痕。"],0,9,"清"],["浣溪沙三十八首 其二十一","王时翔","词",["香玉初消不耐看。","谁怜弱骨更珊珊。","一声归也泪偷弹。","迹似燕来逢雁去，心同莲苦带梅酸。","枕头欹侧五更寒。"],0,9,"清"],["浣溪沙三十八首 其二十二","王时翔","词",["短阁清灯照影闲。","碧云香霭隔银湾。","萧萧暮雨洒花关。","燕语呢喃飘枕角，蝶魂离合向屏山。","依稀记捧玉纤弯。"],0,9,"清"],["浣溪沙三十八首 其二十三","王时翔","词",["十二红楼锁碧烟。","飞琼萼绿自婵娟。","骖鸾驾鹤戏芝田。","隔箔异香霏作雾，堕怀明月远于天。","玉箫声歇夜如年。"],0,9,"清"],["浣溪沙三十八首 其二十四","王时翔","词",["鬓发轻垂压紫绡。","蔷薇露浣玉葱娇。","倦容初起勾魂销。","日射粉梨光似颊，风搓丝柳细于腰。","小阑斜倚恁苗条。"],0,9,"清"],["浣溪沙三十八首 其二十五","王时翔","词",["画阁深沉烛影交。","镜台拈韵互推敲。","夜阑斜月在花梢。","皓齿半含窥浅笑，红霞微涨被轻嘲。","鸳鸯何事不同巢。"],0,9,"清"],["浣溪沙三十八首 其二十六","王时翔","词",["拨翠山光浸碧涛。","琳宫移步凤尖劳。","暮归红烛照吟毫。","画舫春游人更懒，绣帏浓睡日常高。","隔帘休把绮琴操。"],0,9,"清"],["浣溪沙三十八首 其二十七","王时翔","词",["玉藕丝长未上梭。","文鸳欲织又蹉跎。","最无聊处看横波。","人到淡黄方艳极，天交新绿得春多。","薄衾凉簟奈愁何。"],0,9,"清"],["浣溪沙三十八首 其二十八","王时翔","词",["一剪轻风一片霞。","玉钩新月画帘斜。","柳条纤软不胜鸦。","暧褪锦衾微见雪，香霏绡幔欲笼花。","可怜春梦落天涯。"],0,9,"清"],["浣溪沙三十八首 其二十九","王时翔","词",["标格寒梅韵海棠。","全身当得翠红乡。","更饶一种是纤长。","画槛风丝飘瘦影，绣裙烟缕立斜阳。","珠帘八尺限萧郎。"],0,9,"清"],["浣溪沙三十八首 其三十","王时翔","词",["珍重疏梅一树明。","晚烟漠漠月枝横。","对花吟更绕花行。","清影似嫌银烛烂，断魂应逐素云轻。","嗅香敲句过今生。"],0,9,"清"],["浣溪沙三十八首 其三十一","王时翔","词",["半倚雕阑半倚庭。","五更斜月五更星。","几多沉醉几多醒。","若有思兮云冉冉，最绡魂处影亭亭。","枉抛心力向银屏。"],0,9,"清"],["浣溪沙三十八首 其三十二","王时翔","词",["缥缈飞楼第一层。","蕊珠仙子梦同登。","琅函玉笈紫霞绫。","烛暗红蕤容半倚，月明朱槛避双凭。","似生怜又似生憎。"],0,9,"清"],["浣溪沙三十八首 其三十三","王时翔","词",["玉艳凌风飒飒秋。","彩云飞去怅难留。","暮烟新月下帘钩。","繁氏定情空有梦，江郎赋别只牵愁。","绿波春草在心头。"],0,9,"清"],["浣溪沙三十八首 其三十四","王时翔","词",["阆苑清虚碧海深。","玉柯琼干树愔愔。","风裳云帔称人心。","新月半墙仙凤杳，朝阳一角彩霞沉。","去来长是费思寻。"],0,9,"清"],["浣溪沙三十八首 其三十五","王时翔","词",["一镜香云绾玉簪。","两湾秋水带秋岚。","海中明月梦中探。","修竹多依花焰焰，古梅偏傍柳毵毵。","牵丝千尺老春蚕。"],0,9,"清"],["浣溪沙三十八首 其三十六","王时翔","词",["海燕双归宿画檐。","玉楼人远暮寒添。","夕阳红尽暗疏帘。","悄悄心期辜眼底，沉沉消息压眉尖。","锦衾空有泪珠淹。"],0,9,"清"],["浣溪沙三十八首 其三十七","王时翔","词",["离思纷纭那可芟。","消魂桥畔挂轻帆。","柳花憎杀点征衫。","远树重重还隐隐，乱山矗聂更巉巉。","痴心犹是望泥缄。"],0,9,"清"],["浣溪沙三十八首 其三十八","王时翔","词",["意外逢欢把玉纤。","夕阳罗袖傍疏帘。","黄花紫蟹正相兼。","飘荡风尘歌更怨，玲珑心地语犹尖。","夜深银蜡醉教添。"],0,9,"清"],["菩萨蛮四首 其一","王时翔","词",["银塘演漾飞㶉𫛶。","矮红阑畔绡裙立。","一路藕丝风。","水亭残雨中。","照溪妆里淡。","色妒芙蓉艳。","新霁嫩凉天。","月和团扇圆。"],0,9,"清"],["菩萨蛮四首 其二","王时翔","词",["晓妆才罢呵纤手。","熏炉半拥芙蓉袖。","压髻蜡梅香。","红绵映淡黄。","拂笺羞咏絮。","别欲题新句。","砚冻墨花干。","人怜玉指寒。"],0,9,"清"],["菩萨蛮四首 其三","王时翔","词",["翠翘偏侧瑶钗溜。","春葱低剔袜尖瘦。","扶影下苍苔。","闲愁何处来。","画眉元小鸟。","却爱名儿好。","欲比住雕笼。","锁郎香阁中。"],0,9,"清"],["菩萨蛮四首 其四","王时翔","词",["神僧不受萧梁佞。","折芦自渡江波莹。","九载坐嵩山。","西飞葱岭间。","兴亡经百代。","古洞依然在。","风急摆浮云。","驱车入暮尘。"],0,9,"清"],["采桑子三首 其一","王时翔","词",["梨花小院东风谢，无主残春。","燕子专人。","巷口斜阳记不真。","个侬背面罗窗下，粉泪偷匀。","立到黄昏。","淡月微风上绣裙。"],0,9,"清"],["采桑子三首 其二","王时翔","词",["凉波倒浸层楼影，疏柳寒塘。","帘里重阳。","一朵秋花点鬓黄。","无端惹起离人恨，不住回肠。","约略新妆。","曾把茱萸酒数行。"],0,9,"清"],["采桑子三首 其三","王时翔","词",["连朝梅雨端阳近，阿措花开。","深院闲阶。","鸟啄猩红下翠苔。","绿窗记得倾蒲酒，曾有人陪。","斜点金钗。","衬出香符彩胜来。"],0,9,"清"],["卜算子","王时翔","词",["病入薄游中，人落西风际。","一鬓秋兰记昔年，小阁偎侬醉。","今夜客窗清，月照蛩音细。","也不思量把酒杯，况有心情睡。"],0,9,"清"],["清平乐二首 其一","王时翔","词",["盈头花草。","又见双文了。","说道今朝天气好。","斜倚画阑浓笑。","多情谁似东风。","飘然直度帘栊。","吹出几重衫影，淡黄轻绿殷红。"],0,9,"清"],["清平乐二首 其二","王时翔","词",["水阑斜靠。","细看描花巧。","墨点朱唇含浅笑。","并向绿波低照。","金丸忽散鸳鸯。","可怜未尽柔肠。","半日清茶相对，不知几许猜详。"],0,9,"清"],["梁州令","王时翔","词",["红树青山曲，一带野花风飐。","拗归供作镜台秋，有人细与评浓淡。","纸窗入夜银灯闪。","写影明于染。","借成幽赏，拼坐深更，村酒香而酽。"],0,9,"清"],["南柯子十三首 其一","王时翔","词",["雁宿芦丛冷，鱼牵荇带长。","西风送我过横塘。","六幅银帆飞破、石湖光。","山脚轻烟碧，波心夕照黄。","行春桥上画衣香。","独树桃花八月、断人肠。"],0,9,"清"],["南柯子十三首 其二","王时翔","词",["叠𪩘云光接，浓阴树色连。","木兰艇子绿波湾。","风影轻翻红袖、拂低阑。","照水愁蛾敛，看山笑靥圆。","沉吟半刻亸香肩。","应有春游诗句、写吴笺。"],0,9,"清"],["南柯子十三首 其三","王时翔","词",["镂管拈沉绿，春裙剪淡黄。","描花隐约寄柔肠。","要绣红莲双朵、盖鸳鸯。","倦起凭雕槛，闲行转曲廊。","樱桃欲谢惜年芳。","独立无人深院、看斜阳。"],0,9,"清"],["南柯子十三首 其四","王时翔","词",["蕙帐人无赖，银屏恨不禁。","晓来新梦恁关心。","仿佛玉壶亲自、与君斟。","插髻花枝妥，钩帘草色深。","别时直望到如今。","归路粉云香雨、做春阴。"],0,9,"清"],["南柯子十三首 其五","王时翔","词",["碎绮裁春色，明霞晕玉容。","小楼人醉倚东风。","记得软杨丝里，一枝红。"],0,9,"清"],["南柯子十三首 其六","王时翔","词",["锦轴闲常卷，朱弦静不张。","西风帘下自然凉。","况是怯秋人起、独眠床。","语别双归燕，啼愁几暮螀。","小庭梧竹间青黄。","一带淡烟新月、接残阳。"],0,9,"清"],["南柯子十三首 其七","王时翔","词",["碧柳春檐雨，青梧夜阁风。","个人香梦恰朦胧。","又是和衣熟睡、小屏中。","薄鬓倾浓绿，清灯晕小红。","玉炉熏被半床空。","一缕水沉烟袅、绣芙蓉。"],0,9,"清"],["南柯子十三首 其八","王时翔","词",["丽影收青镜，香云绾碧螺。","盈盈一笑整裙拖。","今日薄绵初脱、换单罗。","扑蝶怀轻扇，听莺步浅莎。","柳阴垂处懒重过。","怕见画桥流水、落红多。"],0,9,"清"],["南柯子十三首 其九","王时翔","词",["东汉开禅教，西方购梵书。","神驹贝叶现明珠。","照遍千江祗是、一丸孤。","法字传来久，尘心到此无。","清凉台上景萧疏。","半世烧沙才得、饱香厨。"],0,9,"清"],["南柯子十三首 其十","王时翔","词",["圆毂如肠转，香膏与泪深。","已凉天气客初禁。","凭枕怯眠人静、暗沉吟。","澹月微窥幌，疏风半入林。","渡江乡梦一帆阴。","才到江南惊断、楚天砧。"],0,9,"清"],["南柯子十三首 其十一","王时翔","词",["策策商飙动，凄凄古意深。","金梁桥上月难禁。","不唱宪王乐府、试狂吟。","薄笑依银杏，清歌忆锦林。","红牙拍断桂堂阴。","只有荒鸡遥接、暮村砧。"],0,9,"清"],["南柯子十三首 其十二","王时翔","词",["握藕香沾雪，垂珠泪滴红。","分襟地是桂堂东。","一径斜斜铸就、寸心中。","梦易莺儿唤，书难燕子通。","晴丝轻袅断魂风。","小醉清愁无日、不朦眬。"],0,9,"清"],["南柯子十三首 其十三","王时翔","词",["客里新凉浅，闲中旧恨深。","杜兰香远思难禁。","小扇蚕书偷展、自微吟。","锦瑟尘悬壁，琼箫响散林。","石榴裙曝柳边阴。","怎忍寒衣独上、少君砧。"],0,9,"清"],["虞美人五首 其一","王时翔","词",["赌书笑覆龙团椀。","更握青湘管。","斜阳半射水晶帘。","分得玉台新体、试同拈。","晚庭风弄萧萧竹。","闲步携纤玉。","双肩戌削亸鬟鸦。","阶下没鞋红叶、拗秋花。"],0,9,"清"],["虞美人五首 其二","王时翔","词",["雨多五月轻绵在。","独客愁如海。","清吟未稳凭危阑。","一点归心飞入、暮云寒。","绿阴不隔藏娇院。","隐隐疏帘卷。","绕肠已是怕思家。","更见玉人头上、袅榴花。"],0,9,"清"],["虞美人五首 其三","王时翔","词",["白苹风急冲烟去。","只怕惊鸥鹭。","丝丝细雨湿轻帆。","卧看乱山泼翠、水挼蓝。","爱他缥缈峰尤好。","一带浓云绕。","欲寻野客结清游。","身作橙黄橘绿、画中秋。"],0,9,"清"],["虞美人五首 其四","王时翔","词",["渔帆漾漾西风小。","渐泊沙边岛。","将鱼换酒不论钱。","生怕芦花深处、水云寒。","怜余未逐鸱夷艇。","心折闲中景。","秋山红树夕阳村。","好种湖田十亩、老柴门。"],0,9,"清"],["虞美人五首 其五","王时翔","词",["柳阴阴下丝丝雨。","白傅堤边路。","翠峰云锁映春流。","应似玉人眉黛、镜中愁。","遥思分手南园地。","满径杨花坠。","数声横笛画船中。","唤起一襟离恨、散东风。"],0,9,"清"],["踏莎行三首 其一","王时翔","词",["嫩嫩烟丝，轻轻风絮。","绛旗斜飐秋千处。","花枝照得画楼空，薄情燕子和人去。","冷落阑干，凄清院宇。","夕阳西厂明残雨。","一双红豆寄相思，远帆点点春江路。"],0,9,"清"],["踏莎行三首 其二","王时翔","词",["杨叶楼中，枣花帘下。","盈盈有个人如画。","玲珑心地解怜人，嫣然一笑千愁卸。","兰桨催舟，金鞭拂马。","迢迢换了天涯也。","杜郎禅榻鬓丝风，今生甘守凄凉夜。"],0,9,"清"],["踏莎行三首 其三","王时翔","词",["玉镜台前，绛罗窗下。","修蛾彩笔曾亲画。","下阶双笑握纤纤，步摇替整琼钗卸。","地认蓝桥，琴疑司马。","狂言触拨生嗔也。","惊心端坐诵三缄，焚香乞忏无人夜。"],0,9,"清"],["更漏子二首 其一","王时翔","词",["碎萍青，圆荇碧。","舒翅蜻蜓斜立。","梧叶雨，藕花风。","水窗三面通。","是何人，当槛倚。","随意淡妆偏丽。","衫白伫，鬓乌丝。","红榴短短枝。"],0,9,"清"],["更漏子二首 其二","王时翔","词",["紫鸾双，青凤两。","缥缈碧城云上。","兰气近，王光分。","同披绿柳匀。","蓬莱路。","三千阻。","留下清风一树。","天似水，月如霜。","人间奈夜长。"],0,9,"清"],["蝶恋花六首 其一","王时翔","词",["潇洒园亭湖石好。","客未来时，只有茶烟袅。","山桂落残风自扫。","黄衣蝶抱秋棠老。","检校生涯闲不了。","暝色无端，飞上疏林表。","一曲清溪人独钓。","打头红叶栖鸦闹。"],0,9,"清"],["蝶恋花六首 其二","王时翔","词",["拈酒熏香都不耐。","钩起湘帘，晚色初堪爱。","微月小阑黄一派。","白棠花下沉吟拜。","拆去秋千幽径改。","斑竹围屏，隔著深深态。","手揽画裙双凤带。","衣寒蓦把东风怪。"],0,9,"清"],["蝶恋花六首 其三","王时翔","词",["凉透西风秋欲暮。","记起当年，清照消魂句。","人病不窥帘外路。","黄花自瘦无人处。","苦茗一瓯香一炷。","叠遍银笺，懒把秋词做。","昵语已遭归燕絮。","嫩晴天更阑珊雨。"],0,9,"清"],["蝶恋花六首 其四","王时翔","词",["晓揭风帘犹带倦。","独下瑶阶，绣履轻裙展。","朵朵香兰钗上颤。","苔衣露滑纤腰软。","花事阑珊飞絮满。","庭角残枝，幽鸟啼红怨。","多病药炉烟未断。","槛边莫信春寒浅。"],0,9,"清"],["蝶恋花六首 其五","王时翔","词",["碧树萧疏斜日漏。","雪藕调冰，已过炎蒸候。","几许西风吹薄袖。","画阑人似秋光瘦。","彩线慵拈谁耐绣。","玉骨支离，莫使新凉透。","露下虫声添僝僽。","月明珍重分携后。"],0,9,"清"],["蝶恋花六首 其六","王时翔","词",["古驿秋槐疏叶陨。","倦客无憀，脉脉斜晖尽。","几曲阑干凭不稳。","乱鸦啼处西风紧。","卖酒桥边青旆引。","一朵芙蓉，秀靥红生晕。","说与家乡山隐隐。","何烦笑向垆头问。"],0,9,"清"],["天仙子","王时翔","词",["江上萧骚枫几树。","一群冷雁飞芦渚。","澹黄云影落篷窗，疏疏雨。","斜斜去。","又被晚风轻约住。"],0,9,"清"],["一斛珠","王时翔","词",["夜来闻雨。","罗帏越觉孤眠苦。","玉人微病深深处。","一点红灯，燕子寒相语。","可惜春光留不住。","知他薄幸今何许。","卜花晓起添愁绪。","才卷珠帘，却又飞香絮。"],0,9,"清"],["临江仙七首 其一","王时翔","词",["柳径低迷画阁，萍池倒映红阑。","石榴一朵照香鬟。","眼波生细缬，眉月锁轻弯。","展卷乍临乌儿，拂尘旋试麋丸。","戏搴蕉叶代鱼笺。","玉纤书格美，雪腕钏光寒。"],0,9,"清"],["临江仙七首 其二","王时翔","词",["不断柔情春水似，迢迢那计西东。","午眠初起玉钗松。","画屏离思远，罗袖泪痕浓。","云水黏天楼外路，卷帘试认狂踪。","一双燕子夕阳中。","莫衔残鬓影，吹向落花风。"],0,9,"清"],["临江仙七首 其三","王时翔","词",["一段旅情无处着，闲眠中酒平分。","燕归窗黑又黄昏。","灯微屏背影，泪暗枕留痕。","梦入怨花伤柳地，分明有个人人。","压帘香气倚轻裙。","小园风雨后，扶病问残春。"],0,9,"清"],["临江仙七首 其四","王时翔","词",["灯火阑珊清漏急，夜深著体轻寒。","个人背立画屏间。","旧红衫袖薄，新绣缕鞋鲜。","一寸横波千丈恨，魂消似削双肩。","便蒙怜惜也徒然。","桂堂东畔路，弹泪巳三年。"],0,9,"清"],["临江仙七首 其五","王时翔","词",["紫楝飘香新竹粉，小楼树色愔愔。","一帘丝雨好闲吟。","龙唇砚近，素袖墨痕侵。","鲜美银鲥江上到，簇盘卢橘如金。","藏钩得胜称侬心。","玉壶清酒，自起为君斟。"],0,9,"清"],["临江仙七首 其六","王时翔","词",["桂楫银帆移画艇，春塘小泊清槐。","锦堤花印缕金鞋。","香含豆蔻，未上九雏钗。","年少儿郎空玉雪，争窥未惬幽怀。","就中倦客久风埃。","酒情诗思，犹惹眼波回。"],0,9,"清"],["临江仙七首 其七","王时翔","词",["红板桥头浓绿布，人家一带高槐。","鹧斑帘底逗弓鞋。","彩符欹侧，斜映水晶钗。","佳丽靓妆疑见画，枉牵孤客情怀。","笋舆迎去剩香埃。","碧云芳草，谁念首千回。"],0,9,"清"],["渔家傲","王时翔","词",["销夏湾头荷十丈。","娃儿十五清歌响。","素足红裙风荡漾。","能弄桨。","身轻舟小迎流上。","花里逢人羞欲障。","怜郎隔叶还偷望。","笑指鸳鸯飞两两。","君自想。","东边莲子西边浪。"],0,9,"清"],["钗头凤","王时翔","词",["琼窗口。","雕阑右。","轻烟半羃梨花瘦。","燕儿尾。","莺儿嘴。","都来勾引，酒情春思。","醉。","醉。","醉。","银灯后。","蛾眉皱。","知他一样孤眠否。","分离意。","相思味。","裙量绣带，袖弹红泪。","寄。","寄。","寄。"],0,9,"清"],["风入松","王时翔","词",["一峰晴翠暖烟熏。","游冶趁残春。","玉人笑语朱阑畔，依稀似、放诞文君。","短簿祠前相见，武当山后愁分。","锦鸳双履蹑轻云。","出没艳绡裙。","分明众里重回首，像多处、依恋斜曛。","应恨兰舟催发，整钗一照波纹。"],0,9,"清"],["苏幕遮","王时翔","词",["不须留，侬去罢。","才转身时，又作愁人话。","肠断春风杨柳下。","落日看看，早月儿来也。","两眉低，双袖把。","直恁情多，怎忍轻抛舍。","一笑重回离恨卸。","并坐红窗，且再过今夜。"],0,9,"清"],["芭蕉雨","王时翔","词",["墙脚水仙初发。","玉人抛绣线、潜来折。","纤指半擎清绝。","最爱红袖垂垂，香肩无骨。","疏棂眼尾乍接。","怎赤了双颊。","不是敢轻狂、相唐突。","须记取小年时，那夜阑角微风，帘衣新月。"],0,9,"清"],["感皇恩二首 其一","王时翔","词",["寒色乱昏鸦，小窗人醉。","袖捧金钗拥衣睡。","几条凉月，闲共碧笼烟细。","醒时眠不得、还重起。","旧梦已遥，后欢难继。","一点真诚感郎意。","倚屏无语，残灯落灺红碎。","只将鸳锦带、揩双泪。"],0,9,"清"],["感皇恩二首 其二","王时翔","词",["小阁俛澄湾，水窗低挂。","团扇纱裙坐良夜。","荷风消暑，叶叶清香无价。","月明星影淡、银河泻。","玉体易凉，冰肌生粟。","的皪真珠露流乍。","兰房深靓，背壁烛花将谢。","被轻珍簟滑、金钩下。"],0,9,"清"],["青玉案","王时翔","词",["暗飘玉笛高楼暮。","更谁管，人羁旅。","早睡何曾央梦去。","残灯挂壁，破窗鸣纸，一枕相思雨。","起来欲写相思句。","恼断愁肠心不聚。","须待与伊当面诉。","安排茶椀，画屏深处，镇日低低语。"],0,9,"清"]]