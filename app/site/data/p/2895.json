[["亲耕藉田七首 其七 归大次。","郊庙朝会歌辞","四言",["教民稼穑，不令而行。","进退有度，琚瑀锵鸣。","言还𤈶幄，礼则告成。","帝命率育，明德惟馨。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其十八 送神。曲同迎神。","郊庙朝会歌辞","四言",["荐彻豆笾，熙事备成。","灵兮将归，羽旄纷纭。","飘其逝矣，浮空𥬞云。","怅然顾瞻，有抚怀心。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其二十五 送神。曲同迎神。","郊庙朝会歌辞","四言",["虞至旦兮，灵亦有喜。","蹇欲骧兮，象舆已轙。","粥音送兮，灵聿归矣。","长无极兮，锡我以祉。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其三十四 送神。曲同迎神。","郊庙朝会歌辞","四言",["乃羞既彻，乃奏及阕。","无馂斯俎，式听致谒。","不蹇不蹶，不沸不决。","厉魃其祛，永庇有截。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其四十三 送神。曲同迎神。","郊庙朝会歌辞","四言",["灵既醉饱，礼斯彻兮。","灵亦乐康，乐斯阕兮。","云征飙举，不可尼兮。","荐福锡祉，曷有极兮。"],0,"x207","宋"],["孟夏雩祀二首 其一 太祖配坐奠币用《献安》。","郊庙朝会歌辞","四言",["昊天盖高，祀事为大。","严配皇灵，亿福来介。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其十四 南镇位。","郊庙朝会歌辞","四言",["维南有山，于彼会稽。","作镇在昔，神则司之。","厥有旧典，以祀以时。","百味维旨，灵其燕娭。"],0,"x207","宋"],["标指六偈 迷悟","释清远","四言",["迷者迷悟，悟者悟迷。","迷悟同体，悟者方知。","迷南为北，实情取则。","北本是南，悟无移忒。","返究迷缘，莫得来处。","忽悟正方，迷复何去。","其迷则迷，妄自高低。","生死恶觉，枉受胶黐。","达迷无妄，欢喜无量。","杀无明贼，祇在一饷。","一饷之间，冥通大千。","直下了了，三际虚玄。","无始时来，总由今日。","尽未来际，更不寻觅。","当念无念，灵光焰焰。","灵焰腾辉，心智难掩。","灵源荡碧，森罗普入。","海印发明，非关动息。","根尘不偶，心珠宁守。","返不我观，出兮还有。","有无齐出，无有踪迹。","智用虽奇，犹遭悟觅。","悟为法障，身招罔象。","犴貉无风，徒劳展掌。","祖父书契，本来家业。","旧日风光，不妨要截。","哆哆和和，依前疑著。","元无病痛，何劳说药。","足踏实地，开眼瞌睡。","大地茫茫，会我如是。","如是之法，不因迦叶。","是谁儿孙，喃喃乱说。","你解乱说，智者便瞥。","此门广大，愚人自𦶟。","自谤自𦶟，不干我事。","我是痴人，汝能灵利。"],0,116,"宋"],["绍定三年寿明仁福慈睿皇太后册宝九首 其八","郊庙朝会歌辞","四言",["徽音孔昭，宝传斯刻。","金昭玉粹，有烨斯册。","载祈载祝，以燕以翼。","宝之万年，与宋无极。"],0,"x207","宋"],["旃檀四十二臂观音赞","惠洪","四言",["汝意有言，枯杌作鬼。","我心不生，髑髅则水。","乃知妄觉，一法成二。","湛然圆明，百千一耳。","稽首大士，应物而形。","随其小大，如谷答声。","千臂执持，千眼观照。","以无心故，受用俱妙。","臂如青春，藏于化身。","随其枝叶，疏密精神。","唯此瑞相，四十二臂。","不越径寸，庄严毕备。","清凉宝月，或慈或威。","如欲举足，花轮乘之。","碧螺之间，有佛俨容。","如蟭螟虫，巢蚊睫中。","隐于石间，显出蚌蛤。","以无碍慈，不择清浊。","我观震旦，种性猛利。","由闻思入，甘露灭地。","愿加被我，障尽心开。","如观世音，无碍辩才。","我说此偈，万象合掌。","何以无碍，敲空作响。"],0,"x42","宋"],["宝祐二年皇子冠二十首 其十一","郊庙朝会歌辞","四言",["有宾在筵，有尊在户。","磬管将将，醮礼时举。","跪觞祝辞，以永燕誉。","宝祚万年，磐石巩固。"],0,"x207","宋"],["六句偈六首 其六 后念即圣","释清远","四言",["后念即圣，圣不能知。","铁牛过海，石女生儿。"],0,116,"宋"],["祫飨太庙 其十","郊庙朝会歌辞","四言",["嘉牲在俎，广乐在庭。","其所将者，曰躬曰诚。","神兮来歆，以安以宁。","以锡寿嘏，惟皇是膺。"],0,"x207","宋"],["偈颂一百三十三首 其七十五","释居简","四言",["黄檗下座，南泉上座。","常州纸贵，一状领过。"],0,"x94","宋"],["淳祐祭海神十六首 送神用《成安》。","郊庙朝会歌辞","四言",["告灵飨矣，锡我嘉祚。","干端坤倪，开豁呈露。","玄云聿收，群龙咸骛。","灭除凶灾，六幕清豫。"],0,"x207","宋"],["大观闻喜宴六首 其三","郊庙朝会歌辞","四言",["乐只君子，式燕又思。","服其命服，摄以威仪。","钟鼓既设，一朝酬之。","德音是茂，邦家之基。"],0,"x207","宋"],["苏养直与四僧书简帖赞","岳珂","四言",["彼黄四娘，诗于杜陵。","先南怀芝，果何等僧。","视其与游，尚或可喜。","于帖之存，以识骥尾。"],0,"x202","宋"],["食不继偈","惠洪","四言",["观饿鬼趣，论劫饥渴。","针锋其咽，火聚其发。","昼夜号呼，百千死活。","我常饱暖，今暂缺乏。","当生大悲，入此观法。"],0,"x42","宋"],["升堂颂古五十二首 其五十","释怀深","四言",["佛身无相，染净皆空。","妙体湛然，悟迷俱妄。"],0,"x134","宋"],["魏京诗 其七","刘敞","四言",["帝奋厥武，百万其士。","匪怒以棘，于三千里。"],0,"x51","宋"],["三清阁","吴愈","四言",["庐山之胜，秀出斗旁。","参于衡岳，镇东南方。","民人所瞻，神天攸宅。","赍梦之祥，乃兴自昔。","惟天聪明，矜此下民。","监求其莫，恐有不闻。","惟神司之，云轺风马。","乃诹乃访，周游天下。","不疾不速，不察而明。","天何言哉，民无嚬呻。","是为福庭，列圣祗敬。","锡羡𬯎祉，有感斯应。","明明我圣，惟一乃心。","不显亦临，敢有弗钦。","宝画金扁，徽称明诏。","日月之揭，山川有耀。","邃殿在后，新阁在前。","如君当御，而臣仰焉。","时节冠佩，会朝帝所。","达民之情，佑我圣主。","民戴我圣，与天无极。","天佑我宋，子孙千亿。","民拜稽首，愿垂表经。","从臣刻辞，永锡休声。"],0,193,"宋"],["缺月镜颂","黄庭坚","四言",["月坠镜中，无灭无生。","月虽缺半，影像圆成。"],0,"x66","宋"],["高宗祀明堂前朝享太庙二十一首 其二十 彻豆用《丰安》。","郊庙朝会歌辞","四言",["歆我齐明，威德如存。","牲牷是享，圭玉其温。","群公执事，亦既骏奔。","礼成告彻，咸福黎元。"],0,"x207","宋"],["颂古四十四首 其三十九","释师范","四言",["矜夸富贵，贱卖赤穷。","杀人可恕，无礼难容。"],0,"x155","宋"],["御赐真赞师演成四偈 其一","释宗杲","四言",["生灭不灭，如水中月。","不可揽触，妙在甄别。"],0,"x112","宋"],["英宗皇帝宁字御汉体书赞","岳珂","四言",["惟汉体书，笔法之变。","于帝王中，亦有羲献。","有煜昭陵，蒸云激电。","品冠一神，中寓万善。","于惟治平，问安视膳。","葩奇自然，得于目见。","傅英染华，躬侍笔砚。","既习既观，弗咤弗眩。","心法斯授，体势亦擅。","故于游戏，如墨裙练。","惟帝之圣，统接尧禅。","追怀羹墙，谋谨诒燕。","武存止戈，威寓不战。","五饵匈奴，三登海县。","耆髫茹粹，支夏解辫。","宁人之功，是履是践。","帝心敢知，畔援歆羡。","妙则已具，奎文式绚。","揭于座隅，以示警勤。","仁皇之仁，惟圣时宪。","猗与此宁，尸居龙见。","苞桑其存，伐柯不远。","事陋规随，戒存药眩。","有签维瑶，有轴维钿。","系此赞诗，于帖之殿。"],0,"x202","宋"],["淳化中朝会二十三首 皇帝初举酒用《祥麟》。","郊庙朝会歌辞","四言",["圣皇御宇，仁兽诞彰。","在郊旅贡，游畤呈祥。","星辰是禀，草木无伤。","纪异信史，登歌太常。"],0,"x207","宋"],["偈一百二十首 其七","释怀深","四言",["资福一窍，最玄最妙。","直下会得，教你冷笑。"],0,"x134","宋"],["辞世偈","释法照","四言",["佛寿八十，我多九年。","虚空掇转，大用现前。"],0,133,"宋"],["建隆干德朝会乐章二十八首 第五盏用《玉兔》。","郊庙朝会歌辞","四言",["盛德好生，网开三面。","明视标奇，昌辰乃见。","育质雪园，沦精月殿。","著于乐章，色含江练。"],0,"x207","宋"],["十月 其六","叶巽斋","四言",["庐山岩岩，江水汤汤。","磨而颂之，我公之功。","酿而酌之，公福无穷。","再拜稽首，以寿我公。"],0,180,"宋"],["高宗祀明堂前朝享太庙二十一首 其十七 亚献用《正安》。","郊庙朝会歌辞","四言",["威神在天，来格于诚。","既载清酤，有闻无声。","相予熙事，时赖宗英。","肃肃雍雍，允协思成。"],0,"x207","宋"],["十月 其七","叶巽斋","四言",["维此十月，其数无极。","自十而百，千万及亿。","四百甲子，周而复始。","书考中书，汾阳之比。"],0,180,"宋"],["题仲逸宣教三境图","释昙华","四言",["太清之云，镜中之尘。","从无住本，廓应如春。","妙玄不动，示现无垠。","三世普入，孰妄孰真。","现成公案，岂费精神。","当头一著，坐断要津。"],0,47,"宋"],["大观闻喜宴六首 其四","郊庙朝会歌辞","四言",["圣谟洋洋，纲纪四方。","烝我髦士，观国之光。","遐不作人，而邦其昌。","以燕天子，万寿无疆。"],0,"x207","宋"],["题猿石手卷二首 其一","陆文圭","四言",["空山暮雨，枯木晓霜。","此处闻声，若为断肠。"],0,"x149","宋"],["偈八首 其一","释思慧","四言",["板韵才终，鼓声三叠。","人天交接，龙象回旋。","祖佛家风，一时漏泄。"],0,103,"宋"],["御赐真赞师演成四偈 其二","释宗杲","四言",["常住不住，是真实义。","一幅丹青，辉天鉴地。"],0,"x112","宋"],["东坡画像赞","释居简","四言",["帝哀先生，为天下忌。","速反其辕，卒不慭遗。","遂骑箕尾，而分天章。","云汉昭回，衣被八荒。","载驱六丁，收拾文字。","神京遐陬，旁罗曲致。","落人间者，太山毫芒。","寒者绮纨，馁者稻粱。","取彼谮人，投畀豺虎。","既粱其饩，而纨其裤。","豢以人爵，俾敏厥修。","息公之谮，承天之休。"],0,"x94","宋"],["皇帝上太上皇帝寿乐曲 上寿用崇安之曲","崔敦诗","四言",["凝旒肃穆，鸣佩舂容。","有酒伊醑，管磬其从。","典礼绚缛，威仪恪共。","颂尧之寿，与天比隆。"],0,93,"宋"],["南郊大礼庆成诗五首 其五 发册文德殿","苏颂","四言",["大孝尊亲，治本人伦。","自家之政，所以刑民。","天正元日，帝郊毕禋。","将崇母仪，爰即嘉辰。","正朝干辟，羽卫星陈。","金石既作，公卿荐臻。","帝步西序，躬咨尔臣。","授以册宝，极其礼文。","群官在位，靡不欢欣。","谓天子孝，感于人神。","祝天子年，后于灵椿。","皇心匪懈，圣度惟新。"],0,"x85","宋"],["偈二十七首 其八","释绍隆","四言",["大智圆明，体无向背。","凝然湛寂，弥满太虚。","覆盖乾坤，常光独露。","削踪灭迹，离相绝名。"],0,252,"宋"],["偈颂十五首 其七","释宝印","四言",["佛高一丈，魔高一丈。","正觉山前，无风起浪。","金山个里，佛魔俱丧。","明星现时，且莫欺诳。","无牛乳糜，有德山棒。","为甚如此，真法供养。"],0,106,"宋"],["为李端愿居士说偈","释达观","四言",["三十八岁，懵然无知。","及其有知，何异无知。","滔滔汴水，隐隐隋堤。","师其归矣，箭浪东驰。"],0,2,"宋"],["续琴操哀江南 我操南音四之三","谢翱","四言",["我操南音，爰𮠨我酒。","风摧我裳，冰裂我手。","薄送于野，曷云同归。","自贻伊阻，不得奋飞。","持此盈觞，化为别泪。","昔也姬姜，今焉憔悴。","山高水远，无相见时。","各保玉体，将死为期。"],0,222,"宋"],["祫飨太庙 其十五","郊庙朝会歌辞","四言",["帝还于次，佩玉其徐。","帝色不渝，罔解如初。","凡百府司，各祗乃位。","敢不肃恭，以讫尔事。"],0,"x207","宋"],["许国公生辰 其三","彭龟年","四言",["人不自泰，以居故移。","人不自奢，由养所为。","胜之有道，惟书与诗。","愿言君子，载思载惟。"],0,223,"宋"],["瑞麦赞","林某","四言",["淳熙天子，御图三七。","协气所钟，嘉禾乃出。","巴夔之山，亘连阡陌。","或两其歧，或六其脊。","惟是西门，近郊所植。","六六同颖，函三为一。","兹诚创见，图写漏逸。","乃知人为，不逮天力。","上方寅畏，摈华务实。","臣不敢献，私志于室。","采诗之官，汗青之笔。","编诸诗书，示此其质。"],0,108,"宋"],["临终偈","释道冲","四言",["末后一句，无可商量。","只要个人，直下承当。"],0,206,"宋"],["畴依  其九","王柏","四言",["于皇周公，勤劳王家。","赤舄几几，德音不瑕。","思兼三王，以施四事。","坐以待日，制作大备。"],0,"x137","宋"],["听讲圆觉经有省作颂","释真慈","四言",["一颗明珠，在我这里。","拨著动著，放光动地。"],0,42,"宋"],["祫飨太庙 其十三","郊庙朝会歌辞","四言",["乐统大安，舞昭盛德。","合奏允谐，孔容有翼。","秉翟言竣，总干是力。","箫勺之仁，参和万国。"],0,"x207","宋"],["大观闻喜宴六首 其五","郊庙朝会歌辞","四言",["我求懿德，烝然来思。","笾豆静嘉，式燕绥之。","温温其恭，莫不令仪。","追琢其章，髦士攸宜。"],0,"x207","宋"],["元符祀感生帝五首 其五 送神用《普安》。","郊庙朝会歌辞","四言",["俯临下土，回复上天。","触类而长，荷福无边。"],0,"x207","宋"],["高宗祀明堂前朝享太庙二十一首 其十四 哲宗室用《重光》。","郊庙朝会歌辞","四言",["明哲煌煌，照临无疆。","丕承先志，嘉靖多方。","朝廷尊荣，民庶乐康。","珍符来应，锡兹重光。"],0,"x207","宋"],["示周子充写华严经","释宗杲","四言",["总别同异，成坏行布。","圆融无碍，尘人众刹。","非宽刹入，众尘非隘。","居士笔端，宣畅果海。","因源自在，我今说偈。","赞扬同证，一真法界。"],0,"x112","宋"],["维摩赞","释子益","四言",["俗气不除，病在一默。","扁鹊卢医，医你不得。"],0,63,"宋"],["明教禅师五种不坏赞 其三","释居简","四言",["宣明心声，若出金石。","汹涌辩河，不渗涓滴。","书献天子，天颜屡改。","一笑归来，此舌犹在。","韩吾不非，吾奚以为。","壅吾不夷，吾奚以驰。","一生事了，有死无憾。","身随劫烧，红开菡萏。"],0,"x94","宋"],["明教禅师五种不坏赞 其四","释居简","四言",["童真出家，死于童真。","出没卷舒，一坚密身。","嗟多欲人，曲为欲说。","于其根中，出火自焫。","猗欤哲人，哂乃覆辙。","以古为鉴，以身代舌。","火炎昆冈，玉石俱焚。","石付百粉，玉兮温温。"],0,"x94","宋"],["方丘乐歌 其六","郊庙朝会歌辞","四言",["荡荡坤德，物无不载。","柔顺利贞，含弘光大。","笾豆既陈，金石斯在。","四海永宁，福禄攸介。"],0,"x207","宋"],["偈颂八十七首 其八十","释慧开","四言",["三教圣人，同归一理。","理长则行，理短则止。","虚空无心，墙壁有耳。","不涉言诠，单提直指。","口缝才开，不是不是。"],0,65,"宋"],["牛山之木四章  其三","赵友直","四言",["木其荣矣，繁霜瘁之。","静言思之，中心怆而。"],0,49,"宋"],["淳熙三年发皇后册宝十三首 其十三","郊庙朝会歌辞","四言",["天监有周，是生太任。","亦有太姒，嗣其徽音。","孰如两宫，慈爱相承。","思齐之盛，复见于今。"],0,"x207","宋"],["庆元二年皇后册宝十三首 其十二","郊庙朝会歌辞","四言",["光佑晏宁，惠慈燕喜。","寿仁并崇，家邦均祉。","懿文交举，壶册嗣美。","维亿万年，爱敬惟似。"],0,"x207","宋"],["迎奉圣像四首 其二 圣祖位。","郊庙朝会歌辞","四言",["总化在天，保昌厥绪。","降格皇闱，琼轮载御。","藻仗星陈，睟容金铸。","佑我庆基，宅兹灵宇。"],0,"x207","宋"],["澄冯楫居士会药山问石头见性成佛公案偈","释宗杲","四言",["梵语唐言，打成一块。","咄哉俗人，得此三昧。"],0,"x112","宋"],["庆元二年皇后册宝十三首 其十一","郊庙朝会歌辞","四言",["象服之文，鹊巢之风。","化以妇道，觐于内宫。","采苹涧滨，采藻涧中。","夙夜在公，赞彼累功。"],0,"x207","宋"],["以鉴赠赵制置","袁燮","四言",["吁嗟此鉴，惟铜之精。","磨之治之，莹乎其明。","其明维何，洞烛毫发。","非由外至，实自中发。","我有良友，天支之英。","雄镇江淮，为时长城。","我宝此鉴，持以赠之。","此鉴此心，昭晰无疑。","鉴揭于斯，中涵万象。","物自不逃，初非鉴往。","人心至神，无体无方。","有如斯鉴，应而不藏。","鉴以尘昏，心以欲翳。","欲全其明，盍去其累。","经武折冲，厥任匪轻。","勿贪小利，勿徇虚名。","律身惟谨，上功必实。","欺心不萌，精忠贯日。","选择僚佐，为己强助。","众明翼之，厥光弥著。","昔者武侯，发教群下。","孜孜求益，不自满假。","陆抗摧敌，东还乐乡。","貌无矜色，谦冲如常。","两贤之心，惟其罔蔽。","千载凛然，犹有生气。","惟君天资，无歉古人。","愿如斯鉴，光景常新。"],0,215,"宋"],["四偈 称法行","惠洪","四言",["本无贪瞋，我持戒忍。","食不过中，手不操楯。","风必顿息，而浪渐尽。","离微细念，方名见性。"],0,"x42","宋"],["高宗祀明堂前朝享太庙二十一首 其七 翼祖室用《大顺》。","郊庙朝会歌辞","四言",["上帝监观，维仁是依。","继世修德，皇心顾之。","其顾伊何，在彼冀方。","施于子孙，降福穰穰。"],0,"x207","宋"],["偈颂三十首 其五","释慧晖","四言",["吾门广大，从古难入。","徒展两脚，不蹈阶级。","元非宫内，岂得建立。"],0,194,"宋"],["五祖演和尚赞二首  其一","释宗杲","四言",["赤骨力地，有𪛌无袴。","敢与海神，争先鬬富。"],0,"x112","宋"],["元符祀感生帝五首 其四 亚、终献用《文安》。","郊庙朝会歌辞","四言",["大君有命，阙典咸修。","帝歆明祀，佑圣千秋。"],0,"x207","宋"],["布袋赞 其一","释道璨","四言",["布袋无口，拄杖无枝。","靠定这个，有甚了期。"],0,93,"宋"],["偈颂一一二首 其二十八","释清远","四言",["圆明了知，不由心念。","抵死要道，堕坑落堑。"],0,116,"宋"],["偈颂十八首 其七","释广闻","四言",["一有多种，二无两般。","花根本艳，虎体元斑。"],0,10,"宋"],["偈送刚僧录入塔","曹勋","四言",["呜呼刚兄，相识半生。","慧林勤旧，崇先寓名。","五旬戒腊，八十寿龄。","平居慷慨，末后分明。","超山之麓，示人无生。","松鹤移巢，月冷风清。"],0,"x103","宋"],["绍兴祀岳镇海渎四十三首 其三十三 亚、终献。","郊庙朝会歌辞","四言",["肃肃其乂，既旨既溢。","迨其毕酌，偏兹博硕。","祀事既遂，不敢谇射。","神或醉止，我心斯怿。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其四十二 亚、终献。","郊庙朝会歌辞","四言",["俎豆纷披，金石繁会。","侑以贰尊，匪渎匪怠。","我仪既周，我心孔戒。","憺兮容与，彷佛如在。"],0,"x207","宋"],["宋颂九首 其一 圣武","石介","四言",["圣武惟扬，鹰师虎旅。","至于澶渊，执彼丑虏。","丑虏之来，蜂虿敢怒。","我师如林，不怒以惧。","既俘其帅，请示死所。"],0,105,"宋"],["绍兴亲享明堂二十六首 其十三 皇地祇位酌献用《彰安》。","郊庙朝会歌辞","四言",["地祀泰折，歌同我将。","黝牲纯洁，丝竹发扬。","博厚而久，含洪以光。","扶持宗社，曰笃不忘。"],0,"x207","宋"],["答开先老子万一山","汪元量","四言",["庐山五老，招我此行。","我琴不鼓，无亏无成。"],0,"x189","宋"],["荆溪道中四言送僧","孙觌","四言",["老蚕上薄，倦鸟投林。","牛闲人卧，荠麦交阴。","孤舟纵横，绿涨一寻。","好风徐来，清和满襟。","举杯属影，伴我孤斟。","老矣钟仪，尚操楚音。","高山流水，寓此琴心。","上人问我，何念之深。"],0,"x190","宋"],["题独鹿图","方回","四言",["谁尝失之，群起竞逐。","不见泰山，一得百覆。","文王之囿，草羡泉足。","生逢兹辰，呦呦攸伏。"],0,"x59","宋"],["范元长观梅诗帖赞","岳珂","四言",["范本蜀望，世仍忠嘉。","南渡而来，人门莫加。","帝咨典型，诏起幽遐。","翊美铜龙，执经金华。","笔取端重，而兼奇葩。","儒先所推，奚待诩夸。","有伟丰公，如璧不瑕。","卷怀枢庭，寓赏梅花。","公从北方，共之天涯。","均德比谊，而兼葭莩。","寒谷将春，轻阴不遮。","洁樽斯从，寄驿匪赊。","倡汝和予，屏淫斥哇。","托彼阴晴，以写正邪。","爱君之心，对越靡差。","一瞬百年，遗墨惊鸦。","臭兮同兰，好兮投瓜。","二公其仙，星箕汉槎。","如此帖者，可复得耶。","清并玉雪，秀同绮霞。","矢辞以藏，庸识名家。"],0,"x202","宋"],["皇帝上太上皇帝寿乐曲 升坐用圣安之曲","崔敦诗","四言",["簪缨列序，羽卫分行。","雉扇爰彻，天威炜煌。","清明在躬，颙颙昂昂。","咸拜稽首，万寿无疆。"],0,93,"宋"],["赞寂岩忠和尚","释心月","四言",["师之出处，师之面颜。","云横楚甸，雨过淮山。","阅其语录，见其作用。","玉转珠回，云兴泉涌。","寂岩之道，莫能形容。","我今赞之，持尺量空。"],0,188,"宋"],["偈颂三十首 其六","释慧晖","四言",["青山山上，白云云下。","户外水寒，波心船点。"],0,194,"宋"],["皇帝上太上皇帝寿乐曲 再举酒用大椿之曲","崔敦诗","四言",["培植自古，质淳以全。","凌傲霜雹，盘薄风烟。","朝菌焉识，楚蓂讵肩。","耸柯擢干，终古苍然。"],0,93,"宋"],["髑髅赞 其三","释慧空","四言",["假以四大，抽之一机。","空无作相，动转云为。","有能晓了，成佛无疑。","何待如是，然后知非。"],0,"x118","宋"],["印月","释月涧","四言",["性海湛如，心月皎如。","水与月融，月与水摄。","水月交光，印文呈露。","山河大地，万象森罗。","一印印定，虚彻洞明。","廓兮烱兮，以证来观。"],0,91,"宋"],["政和亲郊三首 皇帝升降用《干安》。","郊庙朝会歌辞","四言",["因山为高，爰陟其首。","玉趾躩如，在帝左右。","帝谓我王，予怀仁厚。","眷言顾之，永绥九有。"],0,"x207","宋"],["梦中作四言用前韵二首 其一","洪炎","四言",["事有怕爱，语分忙闲。","左右前后，内外中间。","青云千里，紫气浮关。","五星东井，微臣北山。"],0,110,"宋"],["庆元二年皇后册宝十三首 其十","郊庙朝会歌辞","四言",["天子九嫔，王宫六寝。","有烨令仪，载秩华品。","福履绥将，节用躬俭。","矢其德音，于以来谂。"],0,"x207","宋"],["颂古一百首 其十","释智愚","四言",["青山白云，碧溪萝月。","画虎成狸，只得一橛。"],0,"x153","宋"],["僧问四宾主因而有颂颂之 其八","释重显","四言",["主中之主，正令齐举。","长剑倚天，谁敢当御。"],0,"x156","宋"],["寄太康知县周宣德","徐积","四言",["冬之季月，月及上弦。","太康书来，慰此皤然。","并其成法，别为一书。","敏而有术，使我嗟吁。","考其大指，官之楷模。","官守其约，事总其要。","何弊不除，何隐弗照。","如陛高台，俯视四旁。","不持度量，是物可量。","挈裘之领，提纲之纲。","维简维能，维能维精。","维精维思，维思维诚。","既诚既明，既信既行。","日有馀力，民亦闲暇。","不肯顽恶，孰为欺诈。","不出一符，不遗一力。","或将尔车，或负尔穑。","四境之内，如云坌集。","一岁之事，先期以办。","私无所扰，公无所患。","至于盗贼，无处伏藏。","情既暴露，脱身奔亡。","吏案可空，刑书可阁。","俾尔室家，既安且乐。","岂唯太康，世蒙其业。","凡百有司，皆来取法。","勿毁其成，在彼后人。","勿有所嫉，勿摇勿倾。","如川斯流，勿窒其行。","美哉太康，不负厥官。","到官之日，坐席未安。","所成者大，所及者远。","何以加之，加于所勉。","又何加焉，不倦于终。","遗之无穷，智者之功。"],0,"x123","宋"],["赞达磨","释道颜","四言",["五乳峰前，九年冷坐。","孤风绝攀，名不敢涴。","断臂嗣芳，贱卖滞货。","螟蛉有子，负之蜾蠃。","即说咒曰，类我类我。"],0,47,"宋"],["畏爱吟","邵雍","四言",["人有正性，事事皆齐。","人无正性，事事皆隳。","失于用恩，以非为是。","失于用威，以是为非。","恩威既失，畏爱何知。","不知畏爱，何用恩威。","喜怒不节，鲜不至斯。","妇人男子，宜用戒之。"],0,"x57","宋"],["题禅堂壁间","米芾","四言",["水石相搏，风竹相吞。","炉烟方袅，草木自欣。"],0,245,"宋"]]