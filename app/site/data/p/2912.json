[["紫溪庄舍读癸丑壁间旧题转眼忽十八年同游十不存一滋兰弟亦作古人拂拭洒涕几不能去因诵欧公诗云人昔共游今有几树犹如此我何堪以是为韵感怀成十四章庚午四月中澣  其四","刘学箕","四言",["念昔童稚，泛然若舟。","惟我与君，孤诣同修。","博文约礼，匪遨匪游。","子方盛年，遽赴玉楼。"],0,98,"宋"],["上册宝十三首 退文舞、进武舞用《昭安》。","郊庙朝会歌辞","四言",["籥翟既陈，干戚斯扬。","进旅退旅，一弛一张。","其仪不忒，容服有光。","以宴以娭，德音不忘。"],0,"x207","宋"],["绍兴十四年奉上徽宗册宝三首 其三 上徽号用《显安》。","郊庙朝会歌辞","四言",["惟精惟一，乃圣乃神。","鸿名克扬，茂实斯宾。","如禹之功，如尧之仁。","孝思永慕，用诏无垠。"],0,"x207","宋"],["南霁云","石介","四言",["禄山炽乱，火焚昆岗。","炎炎二京，鞠为战场。","百官奔走，万乘苍黄。","孰城能守，孰地不亡。","瞻彼濉水，其流汤汤。","有城有民，在濉之阳。","远位巡上，巡智我彊。","以城授巡，巡亦克当。","贼从西来，杀气堂堂。","旌旗如林，对城而行。","巡远登城，辞毅色康。","城中之人，踊跃倍常。","贼知城坚，坐甲裹粮。","城中食尽，杀爱以尝。","士无二志，持病扶疮。","宁守城死，城不可降。","霁云勇烈，跳城轶出。","走泗投贺，求兵救乏。","贺饮霁云，牢醴罗列。","霁云避席，谓众云曰。","濉阳之人，不食一月。","义不独饱，食下辄咽。","以刀断指，左右流泣。","彼何人兮，忌忠嫉节。","心不感兮，贼功害伐。","不出一兵，坐观斧钺。","霁云心折，寸寸如铁。","霁云据鞍，怒发冲冠。","一矢以志，复来不完。","路人傍观，涕流汍澜。","远近闻者，为之辛酸。","力尽且穷，城孤无援。","至死不屈，万戈来攒。","精诚内发，颜色自安。","身轻鸿毛，名重泰山。","吾执唐刑，罔容于奸。","未诛禄山，先诛贺兰。"],0,105,"宋"],["熙宁以后祀高禖六首 其四 酌献用《祐安》。","郊庙朝会歌辞","四言",["昭荐精衷，灵承端命。","青帝顾怀，神禖储庆。","祚以蕃昌，协于熙盛。","螽斯众多，流于雅咏。"],0,"x207","宋"],["熙宁望祭岳镇海渎十七首 其六 南望迎神用《凝安》。","郊庙朝会歌辞","四言",["嵩嵇衡霍，暨厥海江。","时维长养，惠我南邦。","肆严牲币，神式来降。","以侑以妥，百福是庞。"],0,"x207","宋"],["深公出示崇宁超然相与之诗赞以伽陀","曹勋","四言",["崇师金声，居士玉振。","芝兰道同，万涂一进。","妙语领略，后学标准。","如是如是，云驶月运。"],0,"x103","宋"],["东莱吕氏官箴以觅举求上官保庇书为第一戒今仕者往往十犯八九虽贤不免陷焉为诗以谢兼用奉勉","陈宓","四言",["凡厥女子，号为无知。","十年不字，迟归有时。","正节必守，淑行惧亏。","孰谓君子，身不自持。","不艮其背，顾朵其颐。","自鬻苟售，宁不忸怩。","莫答盛意，聊赠鄙词。"],0,"x124","宋"],["熙宁祀皇地祇十二首 其二 升降用《靖安》。","郊庙朝会歌辞","四言",["有来穆穆，临此方丘。","其行风动，其止霆收。","躬事匪懈，丰盛洁羞。","百昌咸殖，允矣神休。"],0,"x207","宋"],["庆元三年奉上孝宗徽号三首 其二 册宝升殿用《显安》。","郊庙朝会歌辞","四言",["文金晶荧，册玉辉润。","统绍乎尧，德全于舜。","勤崇推高，子孝孙顺。","冠德百王，万年垂训。"],0,"x207","宋"],["饯赵文思崇鐖归上饶","赵汝腾","四言",["英英吾宗，神骏之姿。","笔有天巧，自铸伟词。","抱负不凡，植立甚奇。","爰初筮仕，即不诡随。","笑世滔滔，相与磷缁。","过予告别，凛然自期。","耻逐京尘，愿易丛祠。","莱衣奉亲，乐道忘饥。","予惟上饶，渊源未衰。","玉山文献，考亭所推。","章涧二泉，名论清规。","迩来后生，古为似之。","仁亲友兄，径坂是师。","子归取友，伯埙仲篪。","咫尺柯山，考德订疑。","他日成就，麟祥凤仪。"],0,47,"宋"],["大观三年释奠六首 其二 升降用《同安》。","郊庙朝会歌辞","四言",["生民以来，道莫与京。","温良恭俭，惟神惟明。","我洁尊罍，陈兹芹藻。","言升言旋，式崇斯教。"],0,"x207","宋"],["绍兴祀太社太稷十七首 彻豆用《娭安》。","郊庙朝会歌辞","四言",["报本之礼，载于甲令。","灵坛昭告，神既来听。","彻彼豆笾，精诚斯罄。","实惟丰年，农夫之庆。"],0,"x207","宋"],["紫溪庄舍读癸丑壁间旧题转眼忽十八年同游十不存一滋兰弟亦作古人拂拭洒涕几不能去因诵欧公诗云人昔共游今有几树犹如此我何堪以是为韵感怀成十四章庚午四月中澣  其五","刘学箕","四言",["朱垣素壁，醉墨漓淋。","虚堂重临，思古伤今。","文不忍诵，盟弗可寻。","即事即物，抆泪痛心。"],0,98,"宋"],["开禧三年成肃皇后祔庙一首 酌献用《歆安》。","郊庙朝会歌辞","四言",["天合重华，内治昭融。","承承继继，保佑恩隆。","归从阜陵，登祔太宫。","燕我后人，福禄来崇。"],0,"x207","宋"],["干德以后祀感生帝十首 彻豆用《肃安》。以下二首政和中制。","郊庙朝会歌辞","四言",["奉承明祀，惟羊惟牛。","卬盛于豆，备陈庶羞。","钟鼓喤喤，神具醉止。","其彻嘉笾，永绥福祉。"],0,"x207","宋"],["华之高寿鲁斋先生七十  其一八","金履祥","四言",["穆穆王子，毋靳尔猷。","以永斯文，邦家之休。"],0,83,"宋"],["绍兴以后蜡祭四十二首 大明位奠玉币用《钦安》。","郊庙朝会歌辞","四言",["晨曦未融，天宇澄穆。","有虔秉诚，将以币玉。","如在左右，罔不祗肃。","神兮安留，锡以祉福。"],0,"x207","宋"],["吏部员外郎傅公","《靖康小雅》作者","四言",["强敌寒盟，兵忽逾塞。","公持汉节，迓客于界。","控弦欻来，率土震骇。","外臣桀傲，自矜强大。","公誓不慑，有死无拜。","杀身成仁，播美千载。"],0,91,"宋"],["真宗奉圣祖玉清昭应宫十一首 其五 圣祖位酌献用《庆安》。","郊庙朝会歌辞","四言",["于昭灵贶，诞启鸿源。","功济庶汇，庆流后昆。","兰肴登俎，桂酒盈尊。","俯回飙驾，永庇云孙。"],0,"x207","宋"],["宁宗登门肆赦二首 其二 降坐用《干安》。","郊庙朝会歌辞","四言",["天日清晏，朝野靖安。","三灵答祉，万国腾欢。","帝命不违，王业艰难。","天子万年，永迪监观。"],0,"x207","宋"],["紫溪庄舍读癸丑壁间旧题转眼忽十八年同游十不存一滋兰弟亦作古人拂拭洒涕几不能去因诵欧公诗云人昔共游今有几树犹如此我何堪以是为韵感怀成十四章庚午四月中澣  其三","刘学箕","四言",["丱角灯窗，砚席是共。","春山朝吟，秋堂夜诵。","弃背三年，心骨沉痛。","几夜见君，似梦非梦。"],0,98,"宋"],["紫溪庄舍读癸丑壁间旧题转眼忽十八年同游十不存一滋兰弟亦作古人拂拭洒涕几不能去因诵欧公诗云人昔共游今有几树犹如此我何堪以是为韵感怀成十四章庚午四月中澣  其六","刘学箕","四言",["旧题墨妙，龙蛇户牖。","步骤欧虞，模倣颜柳。","醉里百篇，冥搜九有。","天胡夺我，张仲孝友。"],0,98,"宋"],["北山之高寿北山何先生  其九","金履祥","四言",["夫子由由，匪诡匪随。","匪傲匪求，云受奚为。","孑孑干旌，侯伯是将。","鳯皇于飞，亦集爰止。"],0,83,"宋"],["雍熙享先农六首馀同祈谷 其四 亚献用《正安》。","郊庙朝会歌辞","四言",["祀惟古典，食乃民天。","歆兹洁祀，以应祈年。"],0,"x207","宋"],["大中祥符封禅十首 其七 社首坛降神用《靖安》。","郊庙朝会歌辞","四言",["至哉坤元，资生伊始。","博厚称德，沈潜柔止。","降禅方位，聿修明祀。","寅恭吉蠲，永锡蕃祉。"],0,"x207","宋"],["崇恩太后升祔十四首 亚献用《神安》。","郊庙朝会歌辞","四言",["嫔于潜邸，爰正坤仪。","关雎化被，思齐名垂。","柔德益茂，家邦以熙。","皇心追崇，永羞牲粢。"],0,"x207","宋"],null,["北山之高寿北山何先生  其八","金履祥","四言",["夫子曰道，惟帝之蹈。","臣何容力，亦聿既耄。","天子曰吁。","鸿飞冥冥，罔终弃予。","廪于宫祠，寓我渠渠。"],0,83,"宋"],["绍兴二十八年祀圜丘 皇地祇位酌献用《光安》。御制。","郊庙朝会歌辞","四言",["厚德光大，承元之明。","兹潜莩吹，升于昭清。","冰天桂海，咸资化成。","恭酌彝醪，报本惟精。"],0,"x207","宋"],["熙宁以后享庙五首 其三 禘祫孟享、腊享宗正卿升殿用《正安》。","郊庙朝会歌辞","四言",["进退有容，服章有仪。","匪亟匪迟，降登孔时。"],0,"x207","宋"],null,["绍兴以后蜡祭四十二首 送神用《宣安》。","郊庙朝会歌辞","四言",["礼乐既成，神保聿归。","言归何所，地纪天维。","岂惟屡丰，嗣岁所祈。","亿万斯年，神来燕娭。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 送神用《宣安》。","郊庙朝会歌辞","四言",["礼备乐成，澹然将归。","其留消摇，象舆已轙。","偃蹇欲骧，羽毛纷委。","忽乘杳冥，遗此福祉。"],0,"x207","宋"],["庆元三年奉上孝宗徽号三首 其三 上徽号用《显安》。","郊庙朝会歌辞","四言",["金石充庭，珩璜在列。","绘画乾坤，形容日月。","巍巍功德，显显谟烈。","垂亿万年，鸿徽昭揭。"],0,"x207","宋"],["高宗明堂前朝献景灵宫十首 其八 彻馔用《吉安》。","郊庙朝会歌辞","四言",["洋洋降临，肃肃布列。","熙事既成，嘉笾告彻。","九天储庆，垂佑无缺。","寖明寖昌，绵绵瓜瓞。"],0,"x207","宋"],["孝宗明堂前享太庙三首 其一 徽宗室酌献用《承元》。","郊庙朝会歌辞","四言",["明明徽祖，抚世升平。","制礼作乐，发政施仁。","圣灵在天，德泽在民。","亿万斯年，保佑后人。"],0,"x207","宋"],["紫溪庄舍读癸丑壁间旧题转眼忽十八年同游十不存一滋兰弟亦作古人拂拭洒涕几不能去因诵欧公诗云人昔共游今有几树犹如此我何堪以是为韵感怀成十四章庚午四月中澣  其七","刘学箕","四言",["屈指友于，祇今存几。","自仲之去，失此奇伟。","言不胜情，心旌愤悱。","哀哉苍天，雨泪如洗。"],0,98,"宋"],["紫溪庄舍读癸丑壁间旧题转眼忽十八年同游十不存一滋兰弟亦作古人拂拭洒涕几不能去因诵欧公诗云人昔共游今有几树犹如此我何堪以是为韵感怀成十四章庚午四月中澣  其八","刘学箕","四言",["团团庭柯，清美无度。","今我来斯，忽然老树。","偃蹇轮囷，剥蚀摧蠹。","朱颜舜华，讵得如故。"],0,98,"宋"],["天安殿册封五岳帝一首 神出入用《正安》。","郊庙朝会歌辞","四言",["名岳奠方，帝仪克举。","吉日惟良，九宾咸旅。","温玉镂文，𫄸裳正宁。","礼备乐成，笃神之祜。"],0,"x207","宋"],["高宗郊前朝献景灵宫二十一首 其十一 圣祖位酌献用《祖安》。御制。","郊庙朝会歌辞","四言",["瑶源诞启，玉牒肇荣。","复育群有，监观圆清。","酒醴既洽，登荐惟诚。","无有后艰，骏惠云仍。"],0,"x207","宋"],null,["祭九鼎十二首 其七 夏至，彤鼎酌献用《成安》。","郊庙朝会歌辞","四言",["牺尊将将，徂基自堂。","牲牷肥腯，鼓钟喤喤。","肆予醴齐，椒馨𫗣香。","聿来歆顾，天祚永昌。"],0,"x207","宋"],["大晟府拟撰释奠十四首 彻豆用《娱安》。","郊庙朝会歌辞","四言",["牺象在前，豆笾在列。","以享以荐，既芬既洁。","礼成乐备，人和神悦。","祭则受福，率遵无越。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 后稷氏位酌献用《禔安》。","郊庙朝会歌辞","四言",["煌煌后稷，实配于天。","司啬作稼，民以有年。","匪神之私，岁以醴告。","酌彼泰尊，于德之报。"],0,"x207","宋"],null,["元祐祀九宫贵神二首 其二 送神用《景安》。","郊庙朝会歌辞","四言",["天之贵神，推移九宫。","厥位靡常，降康则同。","来集于坛，顾歆恪恭。","歌以送之，飙静旋穹。"],0,"x207","宋"],["孝宗明堂前朝献景灵宫八首 其二 圣祖位用《干安》。","郊庙朝会歌辞","四言",["骏命有开，庆基无穷。","祗率百辟，仰瞻睟容。","鼓钟斯和，黍稷斯丰。","灵其居歆，福禄来崇。"],0,"x207","宋"],["教官福唐刘季新写陋质道以羽客索赞还乡福乃提刑台治仆尝出使陛辞而留情见乎词","周必大","四言",["带山负海，都督全闽。","临遣绣斧，言辍其行。","梦想乐郊，或勤宵征。","令威化鹤，会游辽城。"],0,"x76","宋"],["祗奉天书六首 朝元殿酌献用《瑞安》。","郊庙朝会歌辞","四言",["妙道非常，神变无方。","惟天辅德，灵贶诞章。","玄文昭锡，宝历弥昌。","礼崇明祀，式荐馨香。"],0,"x207","宋"],["终南山入定猕猴赞","释慧空","四言",["方得其树，万壑千岩。","至令休复，屹若终南。","呼之六窗，寂尔不应。","惟彼呼者，乃出其定。"],0,"x118","宋"],["绍兴祀大火十二首 商丘宣明王位奠币用《嘉安》。","郊庙朝会歌辞","四言",["荧惑在天，惟火与合。","繄神主火，纯一不杂。","作配荧惑，祀功则然。","不腆之币，于以告虔。"],0,"x207","宋"],["上册宝十三首 罍洗用《嘉安》。","郊庙朝会歌辞","四言",["嘉肴旨酒，洁粢丰盛。","既盥而往，以我齐明。","有孚颙若，黍稷非馨。","神之格思，享于克诚。"],0,"x207","宋"],["明道亲享先农十首 其十 送神用《静安》。","郊庙朝会歌辞","四言",["献终豆彻，礼备乐成。","祠容肃肃，风驭冥冥。","三时务本，一垡躬耕。","人祇胥悦，祉福是膺。"],0,"x207","宋"],null,["哲宗传受国宝三首 其二 《神光》。","郊庙朝会歌辞","四言",["惟皇上德，伊嘏我王。","将受厥明，载锡之光。","于昭于天，晔晔煌煌。","缉熙钦止，其永无疆。"],0,"x207","宋"],["北山之高寿北山何先生  其一一","金履祥","四言",["岩岩北山，其高极天。","障此东南，利欲之澜。","敢拜稽首，天子万年。","充保四海，好德之端。","敢拜夫子，眉寿无愆。","金玉尔音，以永斯文。"],0,83,"宋"],["郊祀乐章 登门肆赦皇帝升御座宫架奏黄钟宫干安之曲","崔敦诗","四言",["大礼备矣，銮车阗阗。","帝来维何，赉及幅员。","有声伊肃，有容伊虔。","彼雉斯开，帝坐中天。"],0,93,"宋"],["熙宁祀皇地祇十二首 其七 太祖用《佑安》。","郊庙朝会歌辞","四言",["光大含弘，坤元之力。","海宇咸宁，烈祖之德。","作配方坛，不僭不忒。","子孙其承，毋替厥则。"],0,"x207","宋"],["司中司命五首 其四 酌献用《雍安》。","郊庙朝会歌辞","四言",["酌兹旨酒，既盈且芬。","式用来歆，衎衎熏熏。","何以宁神，荐有嘉笾。","何以锡民，曰惟丰年。"],0,"x207","宋"],["大观宗祀明堂五首 配位奠币用《信安》。","郊庙朝会歌辞","四言",["肇祀明堂，告成大报。","颙颙祗祗，率见昭考。","涓选休辰，齐明朝夕。","于惟皇王，孝思罔极。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其二 初献盥洗用《同安》。","郊庙朝会歌辞","四言",["青阳肇开，祀事孔饬。","郁人赞溉，其馨苾苾。","敬尔威仪，亦孔之则。","神之格思，无我有斁。"],0,"x207","宋"],["孝宗明堂前朝献景灵宫八首 其四 奉馔用《吉安》。","郊庙朝会歌辞","四言",["发祥仙源，流泽万世。","曷其报之，亲飨三岁。","相维列卿，洁粢是馈。","匪物之尚，诚之为至。"],0,"x207","宋"],["偈颂七十六首 其六十四","释师范","四言",["一见便见，更不再见。","张颠草书，李广神箭。"],0,"x155","宋"],["常祀五享三首 其二 太尉奠瓒用《嘉安》。","郊庙朝会歌辞","四言",["有秩时祀，匪怠匪渎。","有来宗工，载祗载肃。","厥作祼将，流黄瓒玉。","是享是宜，永绥多福。"],0,"x207","宋"],["祭九鼎十二首 其八 立秋，阜鼎酌献用《成安》。","郊庙朝会歌辞","四言",["明德崇享，磬筦锵锵。","铿兮佩举，峨冠齐庄。","肆陈有序，承箱是将。","其牲伊何，笾豆大房。"],0,"x207","宋"],["真宗告飨六首 其四 祀汾阴毕躬谢酌献用《显安》。","郊庙朝会歌辞","四言",["于昭列圣，休德清明。","威灵如在，享于克诚。","报功厚载，馨荐惟精。","归格饮至，礼备乐成。"],0,"x207","宋"],null,["大观祭风师六首 其五 亚、终献用《雍安》。","郊庙朝会歌辞","四言",["清酤洋洋，虔恭注兹。","条鬯敷宣，神用歆之。","尊罍静嘉，金奏谐熙。","于皇肆祀，休我群黎。"],0,"x207","宋"],null,["绍兴祀祚德庙八首 其四 彊济公位酌献用《成安》。","郊庙朝会歌辞","四言",["以身托孤，实惟死友。","抚妪长之，若父若母。","潜授于韩，克兴厥后。","崇庙以献，德侈报厚。"],0,"x207","宋"],["北堂 其二","黄公槐","四言",["瞻彼北堂，在彼永水。","白云之下，新丰之里。"],0,55,"宋"],["大晟府拟撰释奠十四首 送神用《凝安》。","郊庙朝会歌辞","四言",["有严学宫，四方来宗。","恪恭祀事，威仪雍雍。","歆兹惟馨，飙驭旋复。","明禋斯毕，咸膺百福。"],0,"x207","宋"],["紫溪庄舍读癸丑壁间旧题转眼忽十八年同游十不存一滋兰弟亦作古人拂拭洒涕几不能去因诵欧公诗云人昔共游今有几树犹如此我何堪以是为韵感怀成十四章庚午四月中澣  其一二","刘学箕","四言",["维亲与朋，杂然满坐。","华屋连甍，红紫緐伙。","半世重游，雾迷烟锁。","慨然抚膺，谬悠老我。"],0,98,"宋"],["汾阴十首 其七 饮福用《博安》。","郊庙朝会歌辞","四言",["寅威宝命，明祀惟虔。","协神备物，罔不吉蠲。","后祇格思，灵飙肃然。","诞受景福，遐哉亿年。"],0,"x207","宋"],null,["上册宝十三首 册宝升殿用《崇安》。","郊庙朝会歌辞","四言",["有犹有言，顺承天则。","聿崇号名，再扬典册。","朱英宝函，左右翼翼。","千秋万岁，保兹无极。"],0,"x207","宋"],["熙宁祀皇地祇十二首 其五 司徒奉俎用《承安》。","郊庙朝会歌辞","四言",["我修祀事，于何致诚。","罔敢怠佚，视兹硕牲。","纳烹荐俎，侑以和声。","格哉休应，世济皇明。"],0,"x207","宋"],["提举京城四壁守御刘公","《靖康小雅》作者","四言",["有赫刘公，心在王室。","气吞强敌，忠贯日月。","九鼎既沦，四溟荡潏。","公如山岳，万仞屹屹。","富贵莫诱，威武莫屈。","仗节而死，无愧委质。"],0,91,"宋"],["宁宗郊前朝献景灵宫二十四首 奉馔用《吉安》。","郊庙朝会歌辞","四言",["我簋斯盈，我簠斯实。","或剥或烹，或燔或炙。","有殽既将，为俎孔硕。","礼仪卒度，永锡尔极。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 诣望燎位用《干安》。","郊庙朝会歌辞","四言",["厥初生民，渊浚唯祖。","芳荐既辍，明燎具举。","德馨升闻，灵贶蕃诩。","怀濡上灵，佑周之祜。"],0,"x207","宋"],["入郭回度黄沙岭息木阴下口占古意","陈文蔚","四言",["孰驱我去，孰驱我归。","息荫乔木，清风吹衣。","火日炎空，聊此徘徊。","夷险自若，怨尤谁哉。","世间万事，付酒一杯。"],0,126,"宋"],["祗奉天书六首 泰山社首坛升降用《瑞安》。","郊庙朝会歌辞","四言",["玄穹眷怀，宝符申锡。","垂露腾文，粲然灵迹。","发祥吉图，纯熙写奕。","登荐钦崇，式昭天历。"],0,"x207","宋"],["元符大朝会三首 其二 再举酒用《寿星》。","郊庙朝会歌辞","四言",["倬彼星象，于昭于天。","维南有极，离丙之躔。","既明且大，应圣乘干。","诞受景福，亿万斯年。"],0,"x207","宋"],null,["雍熙享先农六首馀同祈谷 其六 送神用《静安》。","郊庙朝会歌辞","四言",["明禋绀坛，灵风肃然。","登歌已阕，神驭将旋。","道光帝籍，礼备公田。","鉴兹躬稼，永赐丰年。"],0,"x207","宋"],["熙宁望祭岳镇海渎十七首 其十五 北望迎神用《凝安》。","郊庙朝会歌辞","四言",["帝德乘坎，时御闭藏。","爰洁牲醴，兆兹北方。","海山攸宅，神施无疆。","具享蠲吉，降福孔穰。"],0,"x207","宋"],null,["绍兴以后蜡祭四十二首 神农氏位酌献用《禔安》。","郊庙朝会歌辞","四言",["先啬之功，神实称首。","以耜以耒，俶载南亩。","列籍皇坟，亿世是守。","何以为报，爰洁兹酒。"],0,"x207","宋"],["临终口占","赵孟僴","四言",["王室之懿，文山之客。","持此寸心，千古忠赤。"],0,19,"宋"],["绍兴以后蜡祭四十二首 大明位酌献用《择安》。","郊庙朝会歌辞","四言",["肇禋备祀，教民美报。","时和岁丰，奉醴以告。","惟照临功，等于载焘。","酌献云初，明神所劳。"],0,"x207","宋"],["真宗奉圣祖玉清昭应宫十一首 其十一 送圣用《真安》。","郊庙朝会歌辞","四言",["精心既达，真游允臻。","礼容斯举，福应惟醇。","将整仙驭，言还上旻。","永存嘉贶，用泰烝民。"],0,"x207","宋"],["大中祥符朝会五首 其四 四举酒用《灵鹤》。","郊庙朝会歌辞","四言",["玄文申锡，嘉祥绍至。","伟兹胎禽，羽族之异。","翻翰来仪，徘徊嘹唳。","祚圣储休，聿昭天意。"],0,"x207","宋"],["郊祀乐章 送神宫架奏圜钟宫诚安之曲一成","崔敦诗","四言",["奕奕宗祀，煌煌礼文。","高灵下堕，精意升闻。","熙事既毕，忽乘青云。","敢拜明况，永清世氛。"],0,93,"宋"],["太尉镇洮军节度使同知枢密院事种公","《靖康小雅》作者","四言",["壮哉此翁，谋深气劲。","终始一节，佑我三圣。","百战之馀，所料必胜。","提师入援，敌詟威令。","叠尽良策，众莫之听。","割地增币，强邻益横。","万里长城，恃为藩屏。","倏嗟不禄，乱何有定。","旌旗无光，兵民凄哽。","馀烈昭昭，方求独盛。"],0,91,"宋"],["北堂 其一","黄公槐","四言",["瞻彼北堂，在彼永阳。","白云之下，通化之乡。"],0,55,"宋"],["熙宁望祭岳镇海渎十七首 其十二 西望迎神用《凝安》。","郊庙朝会歌辞","四言",["品物顺说，时司金行。","于郊迎气，以望庶灵。","雅歌维乐，圭荐惟牲。","作民之祉，永相厥成。"],0,"x207","宋"],null,["大观祭风师六首 其六 送神用《欣安》。","郊庙朝会歌辞","四言",["窈冥无穷，肸蚃斯融。","来终嘉荐，归返遥空。","惟神之归，欣安导和。","惟神之泽，于彼滂沱。"],0,"x207","宋"],["熙宁蜡祭十三首 其五 酌献用《怿安》。","郊庙朝会歌辞","四言",["秩秩礼文，为坛四方。","嘉栗旨酒，百神迪尝。","敷与万物，既阜既昌。","伊乐厥福，传世无疆。"],0,"x207","宋"]]