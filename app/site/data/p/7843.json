[["浣溪沙•病况","彭孙遹","杂言",["却月横云悄未舒。","看花踏草兴全疏。","屏山寂寞夜何如。","烛灺香焦犹未寝，几回偷看寄来书。","感他珍惜怕他虚。"],0,252,"清"],["浣溪沙•春游","彭孙遹","杂言",["花柳暄萋不自堪。","柔莺历历燕喃喃。","断肠春色在江南。","麦陇摧风轻委浪，苹波蹙雨净拖蓝。","旗亭归去酒微酣。"],0,252,"清"],["浣溪沙•客中小寒食作","彭孙遹","杂言",["客里佳辰祇自怜。","白榆初改汉宫烟。","覆堤柳色正三眠。","芳树乍闻花气息，小楼几见月团圆。","教人无奈暮春天。"],0,252,"清"],["浣溪沙•踏青 其一","彭孙遹","杂言",["翠浪生纹涨曲池。","春深闺阁弄妆迟。","弓鞋罗袜踏青时。","鸦鬓轻分金缕缕，燕钗低飐玉差差。","杏花香雨细如丝。"],0,252,"清"],["浣溪沙•踏青 其二","彭孙遹","杂言",["一幅帆飞十里流。","白苹芳渚放轻舟。","洞天何处最深幽。","红杏枝头寒食雨，碧桃花外夕阳楼。","千条弱柳绾春愁。"],0,252,"清"],["浣溪沙•艳情","彭孙遹","杂言",["睡鸭凄清夜未眠。","银荷低照象床边。","七襄锦被八蚕绵。","皋厌细拖执簟上，诺龙私贮绣襟前。","玉郎长得玉人怜。"],0,252,"清"],["浣溪沙•闺思","彭孙遹","杂言",["蝉翼裁成称体衣。","妍和风日燕交飞。","远山泓黛一行低。","雨滴樱桃随泪落，心缄豆蔻怯人知。","残莺新絮断肠时。"],0,252,"清"],["浣溪沙•美人春睡","彭孙遹","杂言",["妆阁深深锁碧苔。","春眠娇倚避风台。","海棠着雨未全开。","金蝶暗宽文绮带，玉钩微卸锦綦鞋。","檀郎莫自䛏人来。"],0,252,"清"],["浣溪沙•銮江舟中，集刘随州句，寄孙无言","彭孙遹","杂言",["古木寒蝉满四邻。","萧条环堵绝风尘。","何年家住此江滨。","汉水楚云千万里，不堪秋草更愁人。","临岐南望一沾巾。"],0,252,"清"],["浣溪沙•初夏","彭孙遹","杂言",["小阁冰帘轴画叉。","水沉烟重晕轻纱。","鹊炉分火泼新茶。","绿竹传将欢子粉，红蕉怜杀美人花。","一池春雨闹鸣蛙。"],0,252,"清"],["伊川令•为阮亭题余氏女子绣洛神图","彭孙遹","杂言",["采珠拾翠纷来往。","罗袜轻盈样。","何处通辞波上。","肠断东阿才子，一赋千秋悲怆。","针神原是魏宫人，重拈出、洛灵小像。"],0,252,"清"],["卜算子•赋艳","彭孙遹","杂言",["又报玉梅开，笑泥青娥饮。","去岁留心直到今，醉里如何禁。","身作合欢床，臂作游仙枕。","打起黄莺不放啼，一晌留郎寝。"],0,252,"清"],["卜算子•夏至日","彭孙遹","杂言",["才过困人天，又把黄梅做。","试卷疏帘一倚阑，小雨吹红醋。","草草百年身，悔杀从前错。","来日还如去日长，没个安排处。"],0,252,"清"],["卜算子•有怀","彭孙遹","杂言",["簟影滑生云，莲袜清过水。","好月微风入夜分，记起当初事。","钿盒怅空存，愁病看如此。","仔细从前暗忖量，值个相思死。"],0,252,"清"],["丑奴儿令•雨窗读悔庵吊琵琶乐府","彭孙遹","杂言",["从头细数伤心事，幽怨琵琶。","哀拍胡笳。","一代红颜万里沙。","沉吟掩卷愁无限，风闹窗纱。","雨滴檐牙。","蛱蝶多情苦殉花。"],0,252,"清"],["丑奴儿令•临别","彭孙遹","杂言",["画桡约在春初发，暗数流光。","羞整新妆。","不到临时已断肠。","绣帏今夜人清悄，雨滴空堂。","花落空缸。","数尽更儿懒上床。"],0,252,"清"],["减字木兰花•重过鸳水客楼","彭孙遹","杂言",["鸳鸯湖畔。","曾醉娇歌听翠管。","湖雨湖烟。","不见于今又几年。","重来帆影。","兰叶苹花秋色净。","题句空留。","行里尘生水面楼。"],0,252,"清"],["菩萨蛮•京口遣信南归，因题书尾 其一","彭孙遹","杂言",["绣衾孤拥春寒峭。","窗前小玉迎人笑。","报道远人回。","郎君有信来。","循环都读遍。","腹内车轮转。","何日却归家。","恹恹瘦损花。"],0,252,"清"],["菩萨蛮•京口遣信南归，因题书尾 其二","彭孙遹","杂言",["中秋月落催兰棹。","清明寒食逡巡到。","青鸟纵传书。","不归仍是虚。","旧欢真似梦。","毕竟功名重。","含泪待归期。","从头细问伊。"],0,252,"清"],["菩萨蛮•京口遣信南归，因题书尾 其三","彭孙遹","杂言",["去年除夕兰缸下。","熏香被酒更深罢。","鸣指又嘉平。","迢遥蓟北行。","门庭清似水。","泪滴鸳鸯被。","夜夜捧心眠。","何人著意怜。"],0,252,"清"],["菩萨蛮•京口遣信南归，因题书尾 其四","彭孙遹","杂言",["断红小颊芙蓉浅。","檀痕新渍香襟暖。","雁字下平芜。","还胜雁也无。","情知归不得。","不是轻抛掷。","寄语好加餐。","春来风雨寒。"],0,252,"清"],["菩萨蛮•除夕，阮亭广陵署中守岁","彭孙遹","杂言",["节序惊心残腊尽。","同云襞雨寒犹紧。","小暖逼炉烟。","江春入旧年。","芳柑传绮席。","好事过除夕。","香雪动园梅。","春回人未回。"],0,252,"清"],["菩萨蛮•闺情","彭孙遹","杂言",["画檠朱烬花如雨。","当窗手弄春莺语。","半面最宜人。","屏山一线痕。","十重缃绮被。","赤翡交青翠。","生小怯孤眠。","郎衣手自牵。"],0,252,"清"],["菩萨蛮•春愁","彭孙遹","杂言",["平芜南浦萋萋碧。","殷勤别泪红巾湿。","花信半摧残。","高楼箫管闲。","金猊空自𦶟。","不解鸳鸯结。","何物似相思。","相思无尽时。"],0,252,"清"],["菩萨蛮•春寒","彭孙遹","杂言",["夜寒酒薄眠初觉。","一钩残月悬楼角。","小篆冷香筒。","香煤半粟红。","垂帘还涉想。","髣髴金钗响。","数尽短长更。","东方不肯明。"],0,252,"清"],["菩萨蛮•暮秋闺思","彭孙遹","杂言",["层波不转眉山蹙。","有人倚遍阑干曲。","云洗碧天空。","残阳雁背红。","寒林烟冥冥。","不见归帆影。","望断又今朝。","离魂脉脉销。"],0,252,"清"],["菩萨蛮•楼眺","彭孙遹","杂言",["一抹烟鬟青不了。","遥天几点寒鸦小。","落日挂帘钩。","卷帘人倚楼。","云帆何处度。","目尽江南路。","窈窕月华生。","断肠今夜明。"],0,252,"清"],["菩萨蛮•题青溪遗事画册和阮亭韵 其一 乍遇","彭孙遹","杂言",["南园粉絮漫天起。","玉阑干外花阴里。","初试薄罗衣。","金蝉颤欲飞。","无端郎蓦见。","划袜轻风扇。","惊起宿鸳鸯。","裙拖绣一双。"],0,252,"清"],["菩萨蛮•题青溪遗事画册和阮亭韵 其二 夜饮","彭孙遹","杂言",["春檠双吐绯罗烛。","文犀酒泛葡萄绿。","袅袅洞箫声。","牙娘按字清。","投琼聊作戏。","莫赚萧郎醉。","今夜好秋光。","月明衾枕凉。"],0,252,"清"],["菩萨蛮•题青溪遗事画册和阮亭韵 其三 私语","彭孙遹","杂言",["棠梨落尽花如雪。","双双照影昏黄月。","泓黛秀联娟。","云鬟亚玉肩。","凭阑罗袜倦。","坐损春衫茜。","小语怯听闻。","娇波横觑人。"],0,252,"清"],["菩萨蛮•题青溪遗事画册和阮亭韵 其四 围棋","彭孙遹","杂言",["湘兰九畹垂垂吐。","雕笼巧唤红鹦鹉。","长日试敲棋。","娇慵落子迟。","侬家夸好手。","赌胜朱樱口。","却敛细蛾儿。","含羞欲悔时。"],0,252,"清"],["菩萨蛮•题青溪遗事画册和阮亭韵 其五 迷藏","彭孙遹","杂言",["海棠开遍清和近。","轻蝉低掠双文鬓。","玉体藉花藏。","花深珠露凉。","青衣能暗逻。","莫使窥人躲。","人影堕高枝。","玲珑月一丝。"],0,252,"清"],["菩萨蛮•题青溪遗事画册和阮亭韵 其六 弹琴","彭孙遹","杂言",["梧桐深院鸣秋叶。","狄香小炷氤氲𦶟。","玉指弄哀弹。","琴心云水寒。","园丝珠作串。","字字含清怨。","清怨寄三湘。","眉峰九曲长。"],0,252,"清"],["菩萨蛮•题青溪遗事画册和阮亭韵 其七 窃听","彭孙遹","杂言",["朱丝宛转垂银蒜。","今宵底事抛针线。","怪杀太风流。","频频撼玉钩。","千般轻簿个。","可也羞灯火。","渐觉麝兰微。","画屏人欲迷。"],0,252,"清"],["菩萨蛮•题青溪遗事画册和阮亭韵 其八 读书","彭孙遹","杂言",["小窗鲜碧凝修竹。","窗前试展珠函读。","日永静无人。","风来散帙频。","新妆娇半面。","莫使悲团扇。","纤月挂檐头。","牙签索罢休。"],0,252,"清"],["菩萨蛮•题青溪遗事画册和阮亭韵 其九 潜窥","彭孙遹","杂言",["玄霜捣罢明于雪。","褰帷人似婵娟月。","何必怨羁雌。","有人帘外窥。","娇羞生不惯。","惊避檀郎看。","香汗玉肤潮。","无声落凤翘。"],0,252,"清"],["菩萨蛮•题青溪遗事画册和阮亭韵 其十 叶子","彭孙遹","杂言",["竹窗昼永清无事。","南朝旧谱翻新思。","奇正巧能兼。","犀筹手自拈。","郎休嗔叶子。","叶叶郎相似。","尽日掌中擎。","欢情一纸轻。"],0,252,"清"],["菩萨蛮•题青溪遗事画册和阮亭韵 其十一 情外","彭孙遹","杂言",["花梢豆蔻含春色。","风狂雨骤相狼藉。","懊恼锦屏空。","胭脂满地红。","诸姨偷觑着。","调笑多轻薄。","一曲后庭花。","前身张丽华。"],0,252,"清"],["菩萨蛮•题青溪遗事画册和阮亭韵 其十二 秘戏","彭孙遹","杂言",["枕函腻脸明双玉。","纤蛾接黛攒新绿。","欢泪粉香垂。","为郎忍片时。","金铺横屈戍。","皓腕频频觑。","觑向蜡灯中。","臂妆深浅红。"],0,252,"清"],["巫山一段云•雨窗与程村夜话","彭孙遹","杂言",["岁月闲中老，容华暗里消。","清槐好为系征舠。","浓绿染长桥。","听雨僧庐静，寻诗竹院遥。","烛花落尽又频挑。","不寝费兰膏。"],0,252,"清"],["巫山一段云•南谯道上","彭孙遹","杂言",["暮火投山郭，朝寒过驿桥。","江云一色秣陵潮。","抹断蒋山腰。","秋色低鸿雁，清霜急皂雕。","汀芦沙苇冷萧萧。","风雨入南谯。"],0,252,"清"],["巫山一段云•为侯大年赋催妆","彭孙遹","杂言",["侯第珠为帐，金闺钿作车。","水沉香炷博山炉。","今夜极欢娱。","顾影双龙镜，更衣百宝襦。","画眉深浅入时无。","笑指月生初。"],0,252,"清"],["柳含烟•本意","彭孙遹","杂言",["水驿下，戍楼前。","寒食清明过也，淡烟疏雨落花天。","恨绵绵。","风起坝桥如雪。","短叶长条堪折。","一春只觉别离多。","奈愁何。"],0,252,"清"],["谒金门•春梦","彭孙遹","杂言",["春愁积。","一片角声清急。","天上佳期无信息。","行云何处觅。","静掩流苏帐额。","还似见伊颜色。","梦破五更风瑟瑟。","纸窗凉月白。"],0,252,"清"],["好事近•落叶","彭孙遹","杂言",["一叶为谁飘，染就十分秋色。","欲借江郎青管，赋闺中新什。","小鬟石畔掬清泉，捧砚洗残墨。","好向断红纹里，认玉人书迹。"],0,252,"清"],["金蕉叶•新月","彭孙遹","杂言",["新蟾恰恰。","转花梢、照人半霎。","谁将明镜弹破，纤纤小指甲。","又似人儿瘦怯。","染轻云、犀梳倒插。","朝来铅粉洗净，蛾黄露一掐。"],0,252,"清"],["清平乐•吴中柬寄百旃","彭孙遹","杂言",["少年情绪。","分付东流去。","水上浮沤花上露。","一霎蜉蝣旦暮。","故人休问弹冠。","心随云水同寒。","觅得新来活计，笔床茶灶蒲团。"],0,252,"清"],["忆秦娥•黄蔷薇","彭孙遹","杂言",["清明近。","好风初占蔷薇信。","蔷薇信。","脂轻粉薄，天然檀晕。","夜来已觉春寒困。","晓妆约略黄儿褪。","黄儿褪。","幽香一滴，露珠新揾。"],0,252,"清"],["忆少年•忆远","彭孙遹","杂言",["闲来极目，朦胧不辨，江天云树。","怀中数行泪，向何人弹与。","日日潮回乌角渡。","赶不上、萧郎行处。","仙裙且休系，仗东风吹去。"],0,252,"清"],["更漏子•五日","彭孙遹","杂言",["展罗衣，宽宝缬。","团就一窝香雪。","珠箔下，画屏中。","重施绣抹胸。","梅雨溅，荷风扇。","钗上翠符频颤。","多少事，费沉吟。","日长倦不禁。"],0,252,"清"],["更漏子•午饮","彭孙遹","杂言",["额妆轻，眉影细。","发际莹莹光腻。","收宝镜，炷沉烟。","低头急绣缠。","菖蒲碧，榴房赤。","午酒中人无力。","罗袂薄，晚风凉。","幽兰被体香。"],0,252,"清"],["荆州亭•晚眺","彭孙遹","杂言",["小阁愁来独倚。","四合彤云垂地。","若要不思乡，夜夜除非沉醉。","酒后寒生半臂。","著处牵萦人意。","珍重旧罗巾，曾揾美人香泪。"],0,252,"清"],["甘草子•今夕","彭孙遹","杂言",["春恨。","耽过年时，今夕消除尽。","花月也羞明，两两生娇晕。","阶下绿茵青稳。","合眼处、兰缣初褪，一啮文犀为伊忍。","狂杀人风韵。"],0,252,"清"],["阮郎归•旅思","彭孙遹","杂言",["院门花影锁重重。","行云天外峰。","梦魂吹去杳无踪。","此时愁杀侬。","风剪剪，月胧胧。","春霜压被浓。","万千心事霎时中。","狂儿撼晓钟。"],0,252,"清"],["阮郎归•春晓","彭孙遹","杂言",["灵扉谁焉卷仙旌。","霞光透月棂。","几回欲去又消停。","朝寒不自胜。","明镜启，晓篝轻。","宫香分外清。","依微花气满云屏。","春禽无数声。"],0,252,"清"],["阮郎归•归思","彭孙遹","杂言",["玉河官酒送行时。","轻黄遍柳丝。","仙桥认取再来期。","花骢骄欲飞。","人事换，岁华非。","江云望眼迷。","年年风雪满征衣。","思归又怕归。"],0,252,"清"],["眉峰碧•春闺","彭孙遹","杂言",["漫把重帘约。","已觉朝寒略。","春色原来一夜深，看桃李、参差发。","红泪垂银蜡。","烟缕青于发。","午幕人声悄不闻，隔花细雨流莺滑。"],0,252,"清"],["眼儿媚•秋思","彭孙遹","杂言",["空阶夜雨滴心头。","凉雁过西楼。","一行秋色，十分归思，万点离愁。","自被浮名羁绊后，长似断蓬流。","凄凄双杵，朦朦残月，渺渺孤舟。"],0,252,"清"],["锦堂春•柬既庭","彭孙遹","杂言",["涂辙正妨我辈，溪山合老狂夫。","为报故人休复尔，钟鼓骇爰居。","心已絮泥灰木，身拚月媵花奴。","须知富贵非吾愿，遮莫执金吾。"],0,252,"清"],["桃源忆故人•社日","彭孙遹","杂言",["平皋翠縠浓于染。","一幅晴芜青茜。","旧社酒徒零乱。","添得红襟燕。","扮榆往事还重见。","窃炙归来春宴。","人在樱桃庭院。","今夜停针线。"],0,252,"清"],["摊破浣溪沙•读高季迪缶鸣集","彭孙遹","杂言",["何处登临忆侍郎。","无边草树路微茫。","依旧青丘湖下水，接东江。","旧宅已随烟里没，遗编曾向箧中藏。","叹息当时同辈少，压徐杨。"],0,252,"清"],["武陵春•和漱玉词，同阮亭作","彭孙遹","杂言",["柳亸莺娇蜂蝶闹，春色满枝头。","暮雨朝云不肯休。","遮莫太风流。","花满湘江波正绿，莫上木兰舟。","若向湘江共舣舟。","又添得、一般愁。"],0,252,"清"],["武陵春•将游吴门。先寄家兄云客","彭孙遹","杂言",["三月韶光应已暮，花事委行尘。","画帆拟泛石湖滨。","修禊及佳辰。","寄语流杯亭下客，沽酒莫辞贫。","风吹船玉皱红鳞。","一呕木兰春。"],0,252,"清"],["太常引•留别","彭孙遹","杂言",["脆红娇白媵残春。","香梦细于尘。","画阁又斜曛。","空羡杀、乌龙锦茵。","无边风浪，无凭书札，从此隔重𬮱。","一掬小江津。","浣不去、相思泪痕。"],0,252,"清"],["月中行•别意","彭孙遹","杂言",["越丝新襞小裙腰。","翠带逐风飘。","水葱仙席索春饶。","脉脉暗肌销。","银筝玉管无心弄，人静后、几点清谯。","相怜端的只今宵。","不睡也难消。"],0,252,"清"],["满宫花•南园","彭孙遹","杂言",["试青鞋，褰翠袖。","春色南园堆绣。","白头犹说广陵王，能使行人回首。","锦衣城，今在否。","见说当时宫囿。","陌上谁歌缓缓归，只有花开如旧。"],0,252,"清"],["少年游•席上有赠","彭孙遹","杂言",["花底新声，尊前旧侣，一醉尽生平。","司马无家，文鸯未嫁，赢得是虚名。","当时顾曲朱楼上，烟月十年更。","老我青袍，误人红粉，相对不胜情。"],0,252,"清"],["思越人•题余氏女子绣西子浣纱图，同程村、阮亭作","彭孙遹","杂言",["擘仙丝，写美𪾸，依然南国娉婷。","石畔浣纱今在否，溪流犹为人清。","兴亡吴越眉颦上。","鸱夷枉铸遗像。","日暮百花洲下路，珊珊步屧馀响。"],0,252,"清"],["醉花阴•和漱玉词，同阮亭作","彭孙遹","杂言",["花影枝枝摇午昼。","桂炷销狮兽。","愁病怯登高，几阵西风，吹得罗裳透。","阑干星月三更后。","玉露沾香袖。","心事寄谁行，约略腰身，转觉秋来瘦。"],0,252,"清"],["怨王孙•春暮和李易安同阮亭 其一","彭孙遹","杂言",["春阴晼晚。","蔷薇庭院。","谢女楼空，秦娥梦断。","倩柳色把情传。","结缠绵。","当初小喜将人惹。","还抛舍。","煞是无赖也。","别来又过寒食，几树横斜。","断肠花。"],0,252,"清"],["怨王孙•春暮和李易安同阮亭 其二","彭孙遹","杂言",["银箭声悄。","金屏思恼。","香梦和云，流莺弄晓。","一树树海棠红。","不禁风。","风狂雨骤伤心处。","花落去。","秾艳空辜负。","登楼一望天际，目尽南云。","镇思君。"],0,252,"清"],["双调望江南•初见","彭孙遹","杂言",["初见处，记得在东皋。","曾与酒人司白堕，便从仙籍识青腰。","颜色为谁娇。","行酒罢，灭烛更相邀。","并体花间刚恰好，凌波一捻已魂销。","何况是今宵。"],0,252,"清"],["浪淘沙•戏赠闺人","彭孙遹","杂言",["生计漫匆匆。","卖赋临邛。","黄金先为贳新丰。","伊唱吴趋侬起舞，激楚回风。","此处不留侬。","甚处留侬。","小朱慵粉若为容。","一事与卿权领取，酒诰花封。"],0,252,"清"],["浪淘沙•代答","彭孙遹","杂言",["晓起弄妆慵。","笑指吴佣。","白衣夫婿白头侬。","今日海裳花下饮，端与谁同。","云雨楚天重。","谁系郎踪。","任伊梦遍十三峰。","解识近来勤入道，懒向花丛。"],0,252,"清"],["浪淘沙•怀归","彭孙遹","杂言",["漏永夜如年。","拨尽炉烟。","乍晴又雨晚秋天。","切切暗虫窗外语，欲断还连。","寒色透重绵。","若个周旋。","自家将息自家怜。","何日归来相诉也，月下星前。"],0,252,"清"],["浪淘沙•客窗夜雨","彭孙遹","杂言",["寒雨太连绵。","一抹江天。","广陵钟断夜无眠。","何事秋声吹不了，长打窗前。","酒后转凄然。","著处堪怜。","故乡只在睡乡边。","好嘱梦儿归去也，片刻团圆。"],0,252,"清"],["杏花天•美人题红叶","彭孙遹","杂言",["安排秀句描秋思。","正沉吟、湘毫欲试。","风前红叶轻于纸。","薄命生憎似此。","堪惆怅、美人独自。","碧云杳、佳期未至。","有情尽解相思死。","消得银钩几字。"],0,252,"清"],["摘红英•客中闻卖花声","彭孙遹","杂言",["东风景。","吹芳信。","卖花声隔墙头粉。","耽人恨。","教人困。","赊得春光，为谁簪鬓。","青儿嫩。","红儿褪。","梦回蝴蝶难重认。","情儿闷。","心儿忖。","别来几日，玫瑰开尽。"],0,252,"清"],["红窗睡•舟泊庐山下寄吴尔世","彭孙遹","杂言",["薄暮江滨，晓竹寻烟见水面、渔灯三两。","香炉五老青冥上。","正峰峰相向。","犹记此中君独往。","料此后、云岩松瀑，依依梦想。","因风传语，道庐山无恙。"],0,252,"清"],["河传•和温飞卿","彭孙遹","杂言",["愁绪。","如许。","对清宵。","砌竹风敲萧萧。","一声两声魂欲销。","无聊。","冬缸凝玉膏。","却抱云和传素怨。","芳信晚。","肠并危弦断。","夜乌啼。","竹叶飞。","凄其。","小窗月又西。"],0,252,"清"],["鹧鸪天•戏题闺人团扇","彭孙遹","杂言",["兰吹和烟细不闻。","红蕤梦冷浸香云。","大垂手处千金意，小比肩时两玉人。","珠有晕，璧无痕。","怎生消得许多春。","愿将巫女峰头水，形影团来并一身。"],0,252,"清"],["鹧鸪天•偶赠","彭孙遹","杂言",["上社桥头斗彩千。","黄鹂巷口按歌年。","当筵绿酒从无误，隔坐抛钩绝可怜。","良宴会，好因缘。","玉儿颜色雪儿弦。","别来多少伤心句，写付吴中水碧笺。"],0,252,"清"],["鹧鸪天•咏美人眉","彭孙遹","杂言",["麝月才分一寸弯。","长颦短晕浅深间。","疗饥自有餐来色，消渴因看远际山。","螺子细，柳丝寒。","两峰天外碧相攒。","翠蛾一滴能传语，窨住春愁不放还。"],0,252,"清"],["鹧鸪天•咏美人指甲","彭孙遹","杂言",["知向窗中弄彩毫。","墨痕隐隐沁红么。","手挥玉柱频教剪，指拨沉烟旋欲焦。","风力折，嫩兰苕。","夜来轻蘸碧云醪。","芳心要使檀奴觉，一掐春肌晕未消。"],0,252,"清"],["步蟾宫•书姬人素领巾","彭孙遹","杂言",["一泓香雪团金钏。","卸仙铢、轻盈如剪。","分明只是洛川人，送微波、灵绡乍卷。","人间天上谁曾见。","生受了、玉柔花软。","情知薄福为伊消，拚不做、黑头王掾。"],0,252,"清"],["雨中花•解嘲","彭孙遹","杂言",["曲生已拜尚书尹。","毛生又摄中书品。","橘叟千头，竹君千户，尽领通侯印。","羽客乘轩花锡衮。","先生岂合长栖遁。","官柳排衙，官蛙叠鼓，官补南柯郡。"],0,252,"清"],["夜行船•花底私语","彭孙遹","杂言",["半蝉鸳绡轻蘸碧。","软春纤湘纨无力。","圆靥初分，横波欲泻，心事有谁知得。","解意芳姿偏作剧。","故意儿弄人羞涩。","笑指莲花，向侬偷问，可似粉郎颜色。"],0,252,"清"],["虞美人•咏虞美人花","彭孙遹","杂言",["香魂帐底随烟冷。","判与春风领。","柔枝留得可怜名。","一捻红衣犹似舞人轻。","娇歌小按伤心拍。","楚楚绡裳湿。","玉环飞燕已成尘。","不道虞兮原是此花身。"],0,252,"清"],["虞美人•偶赋","彭孙遹","杂言",["小楼昨夜霜华凝。","膏薄兰心冷。","红烟几缕暗香浓。","可惜一场欢会太匆匆。","今朝行到纱窗下。","刚值梳头罢。","回眸一笑转嫣然。","恰似三生石畔旧因缘。"],0,252,"清"],["虞美人•闺情","彭孙遹","杂言",["连枝兰烛荧荧影。","帘外秋风冷。","神丝绣褥郁金香。","不觉犀梳低堕枕函傍。","纤纤玉指如萌削。","数遍阳台约。","脂殷粉弱最伤情。","偏是行云梦好易为醒。"],0,252,"清"],["虞美人•灯下","彭孙遹","杂言",["绕廊试觅芳踪去。","数点苹花雨。","九微灯下见渠侬。","恰是巫山神女梦中逢。","月棱隐约唇朱小。","簇蝶湘裙袅。","玉箫吹彻兽烟温。","记得横波不转暗窥人。"],0,252,"清"],["虞美人•登太白酒楼和董苍水韵","彭孙遹","杂言",["青苍齐鲁垂垂小。","十二山河绕。","衔杯笑杀世人忙。","不道次公当日醒而狂。","骑鲸客去烟波暝。","碧落无音信。","振衣一上谪仙楼。","遥望长安不见使人愁。"],0,252,"清"],["南乡子•采兰","彭孙遹","杂言",["微雨过池塘。","玉骨才胜翠莞凉。","乍起犹然闲徙倚，纱窗。","一叶红蕖坠笔床。","楚畹媚幽芳。","小摘兰丛助晓妆。","半晌沉吟缘底事，思量。","有个人儿竟体香。"],0,252,"清"],["鹊桥仙•清明","彭孙遹","杂言",["烟芜泻浪，晴川铺练，一阵风来吹皱。","韶光百五禁烟时，又过了、几番花候。","夭桃染晕，垂杨拖线，万点春光泄漏。","口噙红豆寄多情，为谁把、相思尝透。"],0,252,"清"],["踏莎行•悼兄女","彭孙遹","杂言",["四韵拈成，六书摹遍，小窗夜夜温文选。","绣床竟日不闻声，间来学弄湘妃管。","白璧难坚，彩云易断。","此生何处重相见。","銮江一纸断肠书，泪痕遥洒登高宴。"],0,252,"清"],["踏莎行•春暮","彭孙遹","杂言",["莺掷金梭，柳抛翠缕。","盈盈娇眼慵难举。","落花一夜嫁东风，无情蜂蝶轻相许。","尺五楼台，秋千笑语。","青鞋湿透胭脂雨。","流波千里送春归，棠梨开尽愁无主。"],0,252,"清"],["踏莎行•题美人画扇","彭孙遹","杂言",["点点凌波，些些眉妩。","玉莲花下私行去。","花光脸色不分明，红酥欲凝娇无语。","醉玉如烟，汗妆如雨。","风流体态还如许。","罗衣恰好半身长，依稀已到销魂处。"],0,252,"清"],["踏莎行•将游岭南却寄","彭孙遹","杂言",["荔子香寒，珠官色冷，绿溪雨暗桄榔影。","枉将泪眼望南云，梦魂不渡梅花岭。","翠羽双飞，素馨千顷。","此方仍是繁华境。","仙梅开日是来时，一枝归把相思赠。"],0,252,"清"],["虞美人•锡山舟中独酌","彭孙遹","杂言",["玉卮如雪溶溶白。","卮酒还同色。","水云影里叩船舷。","无情月也解相怜。","为人圆。","垆头肯典鹴裘否。","归取文君酒。","碧桃花下醉摩娑。","秦筝赵瑟倚声歌。","乐谁多。"],0,252,"清"],["小重山•扶病","彭孙遹","杂言",["迟日园亭禊事收。","那时扶病送、上兰舟。","千丝万绪在心头。","方寸地，著得许多愁。","风雨几曾休。","怪来人意冷、似新秋。","晚天莫倚最高楼。","楼下水，一曲断肠流。"],0,252,"清"]]