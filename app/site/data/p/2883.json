[["天道夷简行","释文珦","四言",["天道夷简，荡荡巍巍。","人心不然，大行险巇。","转眼翻覆，诚不易知。","忠或见疏，信或见疑。","离间致入，宁复顾思。","昔者缱绻，终焉弃遗。","圣如周公，王犹不知。","孝若申生，姬能死之。","在彼盛时，尚有尔为。","况乎季世，颠倒是非。","谗人饱禄，志士苦饥。","俯仰今古，其谁不悲。","命悬于天，逆之为嗤。","冲静无患，进取必危。","守道安危，其殆庶几。","祸福之兆，可以理推。","夷齐去周，西山采薇。","黄绮避秦，商岩茹芝。","景行先哲，良足为规。","规而罔念，虽悔何追。"],0,"x80","宋"],["偈颂七十六首 其二十","释子益","四言",["欲明此道，须遇其人。","其人既遇，十倍收成。"],0,63,"宋"],["盆池吟","邵雍","四言",["有客无知，唯知不为。","不为无他，唯求不欺。","我有人是，人无我非。","因开瓮牖，遂凿盆池。","都邑地贵，江湖景奇。","能游泽国，不下堂基。","帘外青草，轩前黄陂。","壶中月落，鉴里云飞。","既有荷芰，岂无𦳓茨。","既有蝌蚪，岂无蛟螭。","亦或清浅，亦或渺弥。","亦或渌净，亦或涟漪。","风起苹藻，凉生袖衣。","林宗何在，范蠡何归。","密雪霏霏，轻冰披披。","垂柳依依，细雨微微。","可以观止，可以忘机。","可以照物，可以看时。","不乐乎我，更乐乎谁。","吾于是日，再见伏羲。"],0,"x57","宋"],["文宣王及其弟子赞 其十四","赵构","四言",["惟子有道，天与异容。","状虽云恶，德则其丰。","南止江沱，学者云从。","取士自兹，貌或非公。"],0,249,"宋"],["偈颂八十七首 其七十二","释慧开","四言",["摧邪显正，一印印定。","尽大地人，谛听谛听。"],0,65,"宋"],["偈三十五首 其十四","释祖珍","四言",["佛不远人，即心而证。","法无所著，触境皆如。"],0,155,"宋"],["元符亲郊五首 退文舞、迎武舞用《正安》。","郊庙朝会歌辞","四言",["左手执籥，右手秉翟。","进旅退旅，万舞有奕。"],0,"x207","宋"],["自赞","李迎","四言",["三仕三已，应缘而进。","一丘一壑，倦游而归。"],0,213,"宋"],["自赞 其一","释文准","四言",["我若自赞，云居罗汉。","我若自毁，无主饿鬼。","赞之不欣，毁之不嗔。","毁誉不动，东鲁西秦。"],0,254,"宋"],["偈颂一百六十九首 其十九","释智朋","四言",["禁足安居，一句直举。","匝地普天，四月十五。"],0,18,"宋"],["偈颂一百六十九首 其一五四","释智朋","四言",["即心是佛，非心非佛。","东涌西没，穿皮透骨。","十字街头，孤峰绝顶，是离窠臼，不离窠臼。"],0,18,"宋"],["偈三首 其一","释元静","四言",["君王了了，将帅惺惺。","一回得胜，六国平宁。"],0,187,"宋"],["偈颂一百二十三首 其十","释祖钦","四言",["晓天月白，古岸舟横。","一阳来复，吾道大亨。"],0,64,"宋"],["宋江三十六赞 其三十四 铁天王晁盖","龚开","四言",["毗沙天人，证紫金躯。","顽铁铸汝，亦出洪炉。"],0,103,"宋"],["对月了残经赞","释可湘","四言",["黑豆未芽，朝数暮数。","开得眼来，月圆当户。"],0,158,"宋"],["小道吟","邵雍","四言",["艺虽小道，事亦系人。","苟不造微，焉能入神。"],0,"x57","宋"],["偈颂一百零九首 其二十五","释可湘","四言",["中秋令节，升堂指月。","眨得眼来，楚天空阔。"],0,158,"宋"],["管鲍","舒岳祥","四言",["为管则易，为鲍则难。","相马失瘦，相士失寒。","管贫鲍富，坦然相安。","于利不疚，于义斯完。"],0,"x161","宋"],["偈颂十二首 其十","释如净","四言",["元正启祚，万物咸新。","伏惟大众，梅开早春。"],0,105,"宋"],["偈颂一百六十九首 其一六七","释智朋","四言",["西天此土，十万馀程。","胡言易会，汉语难明。"],0,18,"宋"],["和陶时运四首，并引 其四","苏轼","四言",["旦朝丁丁，谁款我庐。","子孙远至，笑语纷如。","剪䰂垂髫，覆此瓠壶。","三年一梦，乃复见余。"],0,"x67","宋"],["送范宣德","徐积","四言",["客有斯人，而有美质。","可养而充，其在不息。","养之以正，充之以义。","何适不可，何为弗至。"],0,"x123","宋"],["上广东漕使黄郎中  其七","曾丰","四言",["天相公生，成春收集。","充所养兮，粹乎成德。"],0,"x193","宋"],["上广东漕使黄郎中  其八","曾丰","四言",["公生京京，其器不盈。","公生裕裕，其色不矜。","不矜不盈，不与时争。","不盈不矜，不与物撄。","不撄不争，神观天清。","不争不撄，体气地宁。","天清地宁，松算椿龄。"],0,"x193","宋"],["自题小像","缪鉴","四言",["白髪苍颜，溪籐兔颖。","水月光中，梅花弄影。"],0,134,"宋"],["偈颂七十六首 其七十一","释子益","四言",["律管吹灰，勾芒布令。","六国风清，九天云静。"],0,63,"宋"],["偈颂一百三十三首 其九十七","释法薰","四言",["深闻浅悟，浅闻深悟。","只知贪程，不觉蹉路。"],0,31,"宋"],["赞四祖","释守卓","四言",["法法明心，尘尘垂手。","正出黄梅，傍生牛首。","巍巍双峰，天长地久。"],0,42,"宋"],["四圣赞 其三","释师体","四言",["稽首文殊，本非延促。","柏短松长，山青水绿。","星移斗转，日行月逐。","开眼合眼，一切具足。"],0,5,"宋"],["了翁","释妙伦","四言",["踏断草鞋，拗折拄杖。","彻底风流，匙挑不上。","拟问如何，擘面便掌。"],0,10,"宋"],["偈六十三首 其八","释道宁","四言",["真不掩伪，曲不藏直。","句里明人，言中辨的。","处处总持，头头弥勒。","拟议思量，当门荆棘。"],0,119,"宋"],["熙宁祀皇地祇十二首 其六 酌献用《和安》。","郊庙朝会歌辞","四言",["猗嗟富媪，博厚含弘。","发荣敷秀，动植兹丰。","爰酌兹酒，肸蚃交通。","众祥萃止，垂祜无穷。"],0,"x207","宋"],["四圣赞 其一","释师体","四言",["稽首释迦，现千百亿。","盐贵米贱，苦趁乐吃。","瞋喜爱憎，是非声色。","日炙风吹，一文不直。"],0,5,"宋"],["上广东漕使黄郎中  其四","曾丰","四言",["三春弸兮，中气彭兮。","季于孟仲，和之精兮。","至精收蒸，天相大明。","公生京京，集春之成。"],0,"x193","宋"],["景德祀皇地祇三首 其一 降神用《静安》。","郊庙朝会歌辞","四言",["至哉厚德，陟配天长。","沈潜刚克，广大无疆。","资生万物，神化含章。","同和八变，神灵效祥。"],0,"x207","宋"],["颂古三十八首 其八","释慧方","四言",["日面月面，头头出现。","捏聚放开，成团成片。"],0,45,"宋"],["颂古一百则 其四十二","释正觉","四言",["鸟之行空，鱼之在水。","江湖相忘，云天得志。","拟心一丝，对面千里。","知恩报恩，人间几几。"],0,"x88","宋"],["偈颂一百六十九首 其三十二","释智朋","四言",["动弦别曲，落叶知秋。","普天匝地，骑牛觅牛。"],0,18,"宋"],["偈八首 其六","释思慧","四言",["一法既通，万法无碍。","拈起笊篱，放下布袋。"],0,103,"宋"],["偈颂七十六首 其六十一","释子益","四言",["作家相见，啐啄尤乖。","达士相逢，握鞭回首。","捡点将来，已落第二。"],0,63,"宋"],["达磨大师赞","释清远","四言",["振摇梁魏，斟酌皮髓。","孰云西来，空椁而已。","素壁虚堂，少林熊耳。"],0,116,"宋"],["南山","陈谠","四言",["天造其山，在贵之阳。","二十四峰，拔地峭刚。","其山维何，如彼玉苍。","宅位于离，火德之祥。","南山何有，有方其岩。","若堂甚夷，若门者三。","穹者圆盖，植者羽参。","石像天成，匪凿匪劖。","陟彼山巅，有洞益奇。","南北户通，千里𫖯窥。","伊晋之洪，采荣于斯。","丹飞井霤，木润草滋。","昔我太宗，云章下贲。","于皇仁庙，奎文狎至。","岩处有辉，神护孔閟。","丕昭圣朝，声化远暨。","南山不骞，天子万年。","南山不朽，天子万寿。","无量惟寿，与天齐久。","小臣作诗，永飏于后。"],0,103,"宋"],["怀素千文帖赞","岳珂","四言",["鹍鹏徙海，龙蛇起陆。","思妙天随，神钟鬼哭。","垂露在手，非烟眩目。","锦绂琼机，光我韫椟。"],0,"x202","宋"],["文宣王及其弟子赞 其十五","赵构","四言",["夫孝要道，周训群生。","以纲百行，以通神明。","因子侍师，答问成经。","事亲之实，代为仪刑。"],0,249,"宋"],["和陶停云 其四","吴芾","四言",["吁嗟人世，如彼南柯。","正宜闲处，养此太和。","纵使得意，位高金多。","老不知止，宁逃谴呵。"],0,"x95","宋"],["建隆郊祀八首 其六 饮福用《禧安》。","郊庙朝会歌辞","四言",["洁兹五齐，酌彼六尊。","致诚斯至，率礼弥敦。","以介景福，永隆后昆。","重熙累洽，帝道攸尊。"],0,"x207","宋"],["休老堂铭","杨杰","四言",["妙高峰顶，不住正处。","毗耶离城，别闻一路。","铁钵铜瓶，葛巾草履。","付者不取，取者不付。","谷有归云，木凝甘露。","师子嚬伸，象王回顾。","门外老胡，一苇横度。"],0,102,"宋"],["文宣王及其弟子赞 其十三","赵构","四言",["养才以道，圣人兼济。","始谓不仁，问鲍良喜。","寓志农圃，似睽仁义。","学稼之辞，岂姑舍是。"],0,249,"宋"],["文宣王及其弟子赞 其三十八","赵构","四言",["任城建伯，其表曰选。","淑问雅驰，才华清远。","竞辰力行，爱日黾勉。","孔教崇崇，令绪显显。"],0,249,"宋"],["圣号雅二篇 其五","赵湘","四言",["天下既平，狄人既庭。","其棘匪劳，神圣以宁。","无乱斯聪，无惑斯明。","衣裳自垂，冕旒是凝。"],0,126,"宋"],["禅人写真请赞 其八","释昙华","四言",["拭眼堂前，临济正令。","且行一半，拈佛祖病。"],0,47,"宋"],["偈颂七十二首 其七十二","释祖钦","四言",["一种平怀，泯然自尽。","明暗情忘，事理平等。"],0,64,"宋"],["天时吟","邵雍","四言",["人作者事，天命者时。","时来易失，事去难追。"],0,"x57","宋"],["偈四首 其四","释鼎需","四言",["十四十五，明明已露。","更问如何，西天此土。"],0,10,"宋"],["偈颂一百三十三首 其八十九","释法薰","四言",["佛法二字，不怕烂却。","俊快衲僧，隔墙见角。","临济德山，蹉过一著。"],0,31,"宋"],["文宣王及其弟子赞 其三十五","赵构","四言",["在昔石邑，能知所尊。","懋依有德，克述无言。","鼓箧槐市，扬名里门。","此道久视，彼美长存。"],0,249,"宋"],["偈四首 其一","惠洪","四言",["举手炷香，而供养佛。","其心自知，应念获福。","举手操刀，恣行杀戮。","其心自知，死入地狱。","或杀或供，一手之功。","云何业报，罪福不同。","皆自横计，有如是事。","是故从来，枉沈生死。","雷长芭蕉，铁转磁石。","俱无作者，而有是力。","心不取境，境亦自寂。","故如来藏，不许有识。"],0,"x42","宋"],["建隆以来祀享太庙十六首 其十五 终献用《正安》。","郊庙朝会歌辞","四言",["常武徂征，诗人所称。","总干山立，厥象伊凝。"],0,"x207","宋"],["圆相赞","释智愚","四言",["黑月则隐，白月则现。","狐魅众生，乞无再面。"],0,"x153","宋"],["偈颂一百六十九首 其一六六","释智朋","四言",["夜半明星，打失眼睛。","胡人多诈，未可全凭。","遭他冤害，始报不平。"],0,18,"宋"],["上李侯","汪炎昶","四言",["贡以土作，法奠于禹。","篚纩与丝，青兖暨豫。","制有常经，无斯焉取。","世降土蹙，德不远柔。","或九州赋，萃于一州。","贸无为有，薄人于尤。","维皇启运，蠲我疾苦。","视青兖豫，不物而估。","上便下安，踵以为故。","虺蜮肆欺，蒙人瞭己。","几创茧丝，涂我赤子。","我侯曰嘻，害无我始。","蕴隆挥汗，义动省闱。","万钧回斡，民以恬熙。","匪人实难，孰心疲羸。","维此陋邦，桑稀田瘠。","苟重以此，其何能息。","自今寸缕，皆服侯德。","弭蝗固德，今兹之康。","此而非侯，篚贡是常。","吏因以蝗，厥祸弥长。"],0,181,"宋"],["偈颂一百四十一首 其一三四","释师范","四言",["二月十五，瞿昙灭度。","诸天悲泣，群魔鼓舞。"],0,"x155","宋"],["缘识 其十八","赵炅","四言",["大矣哉文，道合南薰。","包含六义，洞究三坟。","傍通造化，察变声闻。","垂其懿范，万一之分。"],0,"x63","宋"],["偈颂一百零九首 其六十二","释可湘","四言",["大化枢机，中流砥柱。","归吾掌握，当见设施。"],0,158,"宋"],["偈颂一百六十九首 其一五三","释智朋","四言",["至尊至贵，无去无来。","体若虚空，迥绝安排。"],0,18,"宋"],["戏作","邹浩","四言",["作自我作，止自我止。","莫被傍人，推倒扶起。"],0,"x157","宋"],["为黄仲宣赋山中四章章四句  其二","方回","四言",["山中之暮，岂不风雨。","心与一灯，耿耿千古。"],0,"x59","宋"],["偈颂一百零一首 其四十七","释慧性","四言",["声前一句，十方显露。","佛祖不知，衲僧罔措。"],0,46,"宋"],["偈颂一百四十一首 其三十二","释师范","四言",["摩腾入汉，平地风波。","达磨西来，重增殃祸。"],0,"x155","宋"],["偈六十九首 其五","释道宁","四言",["棋逢敌手，密行难藏。","琴遇知音，希声乃布。","摩竭正令，同道方知。","捏聚放开，悟迷一决。"],0,119,"宋"],["文宣王及其弟子赞 其六十八","赵构","四言",["雍容子皙，已望堂室。","幼则有造，成则祖述。","文采日化，儒效力弼。","永观厥成，德音秩秩。"],0,249,"宋"],["黄鲁直食面帖赞","岳珂","四言",["山谷书法，本于天才。","变而成家，如万壑崖。","骨瘦气清，霜寒籁哀。","故其言曰，法安出哉。","我师我心，奚彼之侪。","今观此书，自叶而荄。","敛其角圭，以复成才。","规矩崛奇，关机阖开。","故其跋曰，自本心来。","谁其知言，嘻噫絜斋。"],0,"x202","宋"],["偈六十九首 其八","释道宁","四言",["千圣不传，诸祖秘语。","不惜眉毛，为君亲举。","衲子抬眸，白云万里。"],0,119,"宋"],["偈颂一百三十三首 其一一一","释法薰","四言",["禁足护生，西天此土。","尽是死门，终非活路。"],0,31,"宋"],["辞世偈","释妙印","四言",["六十九年，一场大梦。","归去来兮，珍重珍重。"],0,112,"宋"],["偈颂一百零一首 其三十三","释慧性","四言",["摇唇鼓舌，展事投机。","千佛出世，不通忏悔。","焦巴焦巴，有叶无丫。","长天秋水，孤鹜落霞。"],0,46,"宋"],["明月  其一","陈杰","四言",["悠悠明月，载盈载缺，我酒在室。"],0,174,"宋"],["偈颂一百四十一首 其二十一","释师范","四言",["衲僧用处，了无定度。","握土成金，握金成土。"],0,"x155","宋"],["我客至止","苏洵","四言",["我客至止，我逆于门。","来升我堂，来饮我樽。","羞鳖不时，詈我不勤。","求我何多，请辞不能。","客谓主人，唯子我然。","求子之多，责子之深，期子于贤。"],0,70,"宋"],["文宣王及其弟子赞 其六十九","赵构","四言",["东平子产，性著盛时。","奉师于塾，讲道之微。","答问其敏，婉妙以思。","升降陛廉，尚想英姿。"],0,249,"宋"],["佛米赞","饶节","四言",["时平主圣，万国自靖。","不杀而成，不征而正。","矫矫虎臣，无所用命。","移将东南，介我佛会。","久闻吾曹，念佛三昧。","喑呜叱咤，化为佛声。","三令五申，易为佛名。","一佛一米，为米三升。","自升而斗，自斗而斛。","念之无穷，太仓不足。"],0,28,"宋"],["偈颂一百四十一首 其五十八","释师范","四言",["一冬二冬，叉手当胸。","珠钻九曲，直在其中。"],0,"x155","宋"],["为黄仲宣赋山中四章章四句  其一","方回","四言",["山中之朝，有溪可瓢。","饮我之水，亦逍以遥。"],0,"x59","宋"],["双柳","苏辙","四言",["我作新堂，中庭萧然，双柳对峙。","春阳既应，千条万叶，风濯雨洗。","如美妇人，正立栉发，发长至地。","微风徐来，掩冉相缪，乱而复理。","垂之为缨，绾之为结，屈伸如意。","燕雀翔舞，蜩蜇嘶鸣，不召而至。","清霜夜落，众叶如剪，颜色憔悴。","永愧松柏，岁寒不改，见叹夫子。","聊同渊明，攀条啸咏，得酒径醉。","一廛粗给，三黜不去，亦如展惠。"],0,"x135","宋"],["醇碧颂","黄庭坚","四言",["田子绿曲，妙在蒸蓼。","女酒兀者，美生其手。","挹彼而清，注兹无声。","其香馥郁，悦可饮者。","如春霡霂，清不病醨。","多不疾人，谁其吐之。","百室之醅，醇碧惟师。","老夫不饮，评以鼻慧。"],0,"x66","宋"],["偈三十五首 其二十八","释祖珍","四言",["有句无句，如藤倚树。","眼睛定动，失却巴鼻。"],0,155,"宋"],["孝宗明堂前享太庙三首 其二 高宗室用《大德》。","郊庙朝会歌辞","四言",["于皇时宋，自天保定。","高宗受之，再仆景命。","绍开中兴，翼善传圣。","何千万年，永绥厥庆。"],0,"x207","宋"],["绍兴亲享明堂二十六首 其二十三 送神用《诚安》。","郊庙朝会歌辞","四言",["奕奕宗祀，煌煌礼文。","高灵下堕，精意升闻。","熙事既毕，忽乘青云。","敢拜明贶，永清世氛。"],0,"x207","宋"],["偈颂一百二十三首 其十二","释崇岳","四言",["妙用纵横，十方坐断。","未谙此脉，举步犹难。"],0,222,"宋"],["偈颂二十二首 其九","释妙伦","四言",["渚流虹影，枢绕电光。","圣人出现，化洽殊方。"],0,10,"宋"],["偈二十四首 其六","释守卓","四言",["开眼即迷，闭眼即错。","古佛巴鼻，何处摸索。"],0,42,"宋"],["顿庵 其一","释慧空","四言",["万行不修，僧祇不历。","千佛数中，位居第一。"],0,"x118","宋"],["文宣王及其弟子赞 其五十九","赵构","四言",["人有贤否，道有废兴。","子如命何，营营震惊。","季孙虽惑，景伯莫平。","师资一言，秩祀亦惩。"],0,249,"宋"],["宋颂九首 其四 六合雷声","石介","四言",["旧是匈奴，为并左臂。","今附有德，不与贼子。","并人失恃，求就戮死。"],0,105,"宋"],["颂古二十一首 其二十一","释心月","四言",["龙起沧海，虎出林端。","直下来也，急著眼看。"],0,188,"宋"],["乾道七年恭上太上皇帝太上皇后尊号十一首 其二 中书令、侍中奉册宝诣殿下用《正安》。","郊庙朝会歌辞","四言",["宗郊斯成，交举典册。","汝辅汝弼，威仪是力。","陈于广庭，迨此上日。","巍巍煌煌，乌睹在昔。"],0,"x207","宋"],["安分吟","邵雍","四言",["轻得易失，多谋少成。","德无尽利，善无近名。"],0,"x57","宋"],["建隆以来祀享太庙十六首 其六 奉俎用《丰安》。","郊庙朝会歌辞","四言",["维牺维牲，以炰以烹。","植其鼗鼓，洁彼铏羹。","孔硕兹俎，于穆厥声。","肃雍显相，福禄来成。"],0,"x207","宋"],["冬至孟春孟夏季秋四祀上公摄事七首 司徒奉俎用《丰安》。","郊庙朝会歌辞","四言",["礼崇禋祀，神鉴孔明。","牲牷博腯，以炰以烹。","馨香蠲洁，品物惟精。","锡以纯嘏，享兹至诚。"],0,"x207","宋"],["哲宗传受国宝三首 其一","郊庙朝会歌辞","四言",["于穆我王，继序不忘。","明昭上帝，上帝是皇。","长发其祥，惠我无疆。","受命于天，既寿永昌。"],0,"x207","宋"]]