[["绍兴祀高禖十首 奉俎用《丰安》。","郊庙朝会歌辞","四言",["祗祓禖坛，洁蠲羊豕。","博硕肥腯，爰具牲醴。","执事骏奔，肃将俎几。","神其顾歆，永锡多子。"],0,"x207","宋"],["朝谒太清宫九首 其八 亚、终献用《大安》。","郊庙朝会歌辞","四言",["邈矣道祖，冥几惚恍。","常德不离，至真无象。","引位清穹，降祥神壤。","酌醴荐诚，控飙来享。"],0,"x207","宋"],["政和二年余谪海外馆琼州开元寺俨师院遇其游行市井宴坐静室作务时恐缘差失念作日用偈八首 其一","惠洪","四言",["一切境界，病眼倒见。","但静意根，空慧自现。"],0,"x42","宋"],["政和二年余谪海外馆琼州开元寺俨师院遇其游行市井宴坐静室作务时恐缘差失念作日用偈八首 其二","惠洪","四言",["一切境界，随念而至。","念未生时，髑髅是水。"],0,"x42","宋"],["政和二年余谪海外馆琼州开元寺俨师院遇其游行市井宴坐静室作务时恐缘差失念作日用偈八首 其四","惠洪","四言",["一日不作，一日不食。","谁其嗣之，我有遗则。"],0,"x42","宋"],["政和二年余谪海外馆琼州开元寺俨师院遇其游行市井宴坐静室作务时恐缘差失念作日用偈八首 其五","惠洪","四言",["折脚铛子，随处安置。","食无精粗，但欲接气。"],0,"x42","宋"],["政和二年余谪海外馆琼州开元寺俨师院遇其游行市井宴坐静室作务时恐缘差失念作日用偈八首 其七","惠洪","四言",["此障道法，上品盖缠。","是何时节，乃复安眠。"],0,"x42","宋"],["高宗郊前朝献景灵宫二十一首 其十 再诣圣祖位用《干安》。","郊庙朝会歌辞","四言",["于赫炎宋，十叶华耀。","属兹郊报，陟降在庙。","其降伊何，椒浆桂酒。","再拜斟酌，永御九有。"],0,"x207","宋"],["宋颂","赵湘","四言",["九区混茫，皇天锡皇。","羲教农化，勋纪华彰。","继华于禹，承禹于汤。","比于文武，逮其成康。","圣道攸传，富寿无疆。","隋之弃仁，天命不常。","歼厥侈毒，祚归巨唐。","唐孙复昏，荡于四方。","民瘼其咨，逾于怀襄。","草创中间，崩析滋章。","割山裂川，国为披猖。","氓不堪命，神恫其殃。","俾宋有图，横弛竖张。","日月五辰，齐其启光。","实维太祖，肇基建邦。","有若有苗，逆命弗祥。","爰整其师，赫怒斯扬。","荆舒既贡，南海趋跄。","庸蜀微卢，虽险无当。","惟尔曰夏，毒靡有流，民始克昌。","屡饥而馔，久渴而浆。","冰极授衣，暑烦降凉。","洎我圣君，传叶振芳。","圣神仁明，浩浩汪汪。","吴人来王，并汾慑降。","服不以戎，鼓罔其镗。","风雨攸暨，如禽集翔。","淳复天人，礼修夏商。","前正后直，左贤右良。","忠正并驱，回邪局藏。","鳏恤寡矜，寇屏宄亡。","药蒸石黎，法衡度量。","乃宅孝悌，乃谨序庠。","衣帛食肉，罔有攸伤。","关讥匪艰，什一靡庞。","虽有罟网，不罹污潢。","虽有山林，不乱斧斨。","虽有权衡，民不以强。","虽有郛郭，民不以防。","宗庙既清，郊社甚庄。","品物争瑞，史载交相。","未诰俗化，将时合苍。","盈耳四海，但闻洋洋。","其雍其熙，无施无为。","乾坤法之，治于垂衣。","蒙彼蚩蚩，不觉不知。","天下一致，夫何虑思。","清之净之，平之泰之。","倏变于道，殊途同归。","伟焉厥图，本蕃益枝。","百世之后，实流其奇。","史官既良，康哉具书。","古有吉甫，为宣王诗。","是故臣湘，作夫颂辞。","圣德形容，神明告兹。","狂斐恐慑，少颂史遗。"],0,126,"宋"],["绍兴以后祀感生帝十六首 望燎用《普安》。","郊庙朝会歌辞","四言",["礼文既洽，熏燎聿升。","嘉气四塞，丹诚上腾。","惟类之应，惟福之兴。","永炽天统，亿载灵承。"],0,"x207","宋"],["大观祀社稷九首 送神用《宁安》。","郊庙朝会歌辞","四言",["尊罍芬香，威仪肃雍。","灵心嘉止，洋洋交通。","神归降禧，年斯屡丰。","仓箱千万，慰予三农。"],0,"x207","宋"],["上册宝十三首 酌献用《明安》。","郊庙朝会歌辞","四言",["旨酒嘉栗，有𫗣其香。","衎我淑灵，歆此令芳。","德贻彤管，号正椒房。","神具醉止，降福穰穰。"],0,"x207","宋"],["政和二年余谪海外馆琼州开元寺俨师院遇其游行市井宴坐静室作务时恐缘差失念作日用偈八首 其六","惠洪","四言",["心欲驰散，即当摄来。","大火聚中，青莲花开。"],0,"x42","宋"],["绍兴祀神州地祇十六首 盥洗用《正安》。","郊庙朝会歌辞","四言",["晨炀致烟，浡然四施。","飘飘风马，彷佛来斯。","祀事维清，沃之盥之。","载涓载肃，罔有愧辞。"],0,"x207","宋"],["高宗明堂前朝献景灵宫十首 其十 望燎用《干安》。","郊庙朝会歌辞","四言",["奕奕原祠，有严毖祀。","礼仪孔宣，燔燎斯暨。","帝心肃祗，天步旋止。","熙事既成，永膺蕃祉。"],0,"x207","宋"],["出火祀大辰十二首 升殿用《正安》。","郊庙朝会歌辞","四言",["屹彼嘉坛，赤伏始届。","掞光耀明，洋乎如在。","俛仰重离，默与精会。","随我降升，肃听环佩。"],0,"x207","宋"],["大观祀社稷九首 奠币用《嘉安》。","郊庙朝会歌辞","四言",["于嘻阴祀，封土惟崇。","于时之吉，歆予鼓钟。","柔静化光，人赖其功。","陈兹量币，百货是隆。"],0,"x207","宋"],["绍兴祀高禖十首 升坛用《正安》。","郊庙朝会歌辞","四言",["有奕禖宫，在国之南。","坛壝既设，威仪孔严。","登祀济济，神兮顾瞻。","佑我皇祚，宜百斯男。"],0,"x207","宋"],["绍兴祀神州地祇十六首 彻豆用《成安》。","郊庙朝会歌辞","四言",["展牲告全，乃登于俎。","竣事而彻，侑以乐语。","奉厘宣室，祚我神主。","敛敷庶民，并受其祜。"],0,"x207","宋"],["绍兴以后时享二十五首 真宗室酌献用《熙文》。","郊庙朝会歌辞","四言",["于穆真皇，维烈有光。","丕承二后，奄奠万方。","威加戎狄，道格穹苍。","歆时禋祀，降福无疆。"],0,"x207","宋"],["寄徐端友立大寿其母夫人","赵汝腾","四言",["英英二徐，名德之雏。","早从烂柯，知所步趋。","南陔子职，夙夜尽劬。","九日黄花，采采盈裾。","请寿堂萱，大年方壶。","庞眉发鹤，重锦轩鱼。","母诏子前，问学勉诸。","参匪直养，心传泗洙。","诚身悦亲，授伋著书。","子曰懋哉，益厉厥初。","荣多遗母，文绣不如。","戏舞樽前，母为笑娱。","我寄四言，俾陈座隅。"],0,47,"宋"],["元符亲享明堂十一首 其九 饮福用《胙安》。","郊庙朝会歌辞","四言",["莫尊乎天，莫亲乎父。","既享既侑，诚申礼举。","戛击堂上，八音始具。","天子亿龄，饮神之胙。"],0,"x207","宋"],["建隆以来祀享太庙十六首 其七 酌献僖祖室用《大善》。","郊庙朝会歌辞","四言",["汤汤洪河，经启长源。","郁郁嘉木，挺生本根。","大哉崇基，出乎庆门。","发祥垂裕，永世贻孙。"],0,"x207","宋"],["颂古四十五首 其十三","释如珙","四言",["补陀岩上，白衣观音。","闻声悟道，见色明心。"],0,255,"宋"],["绍兴祀神州地祇十六首 送神用《宁安》。","郊庙朝会歌辞","四言",["云驭洋洋，既歆既顾。","悠然聿归，曷求厥路。","钦想颂堂，跛立以慕。","赉我肸蚃，莫不怿豫。"],0,"x207","宋"],["政和二年余谪海外馆琼州开元寺俨师院遇其游行市井宴坐静室作务时恐缘差失念作日用偈八首 其八","惠洪","四言",["沙弥嗜乳，作乳中虫。","三篾高道，一钵孤风。"],0,"x42","宋"],["临安北山大佛头颂","甄龙友","四言",["色如黄金，面如满月。","尽大地人，只见一橛。"],0,250,"宋"],["宁宗郊祀二十九首 诣饮福位用《干安》。","郊庙朝会歌辞","四言",["所飨惟清，所钦惟馨。","灵喜留俞，天景窈冥。","福禄来成，福禄来宁。","皇用时敛，寿我慈庭。"],0,"x207","宋"],["魏京诗 其十九","刘敞","四言",["泰山之封，后土之禅。","予监若兹，惟天是眷。"],0,"x51","宋"],["景德中朝会十四首 三举酒用《河清》。","郊庙朝会歌辞","四言",["德水汤汤，发源灵长。","皎鉴澄彻，千年效祥。","积厚流湿，资生阜昌。","朝宗润下，善利无疆。"],0,"x207","宋"],null,["建隆干德朝会乐章二十八首 第三盏用《紫芝》。","郊庙朝会歌辞","四言",["煌煌茂英，不根而生。","蒲茸夺色，铜池著名。","晨敷表异，三秀分荣。","书于瑞典，光我文明。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 少昊氏位酌献用《祐安》。","郊庙朝会歌辞","四言",["沆砀西颢，功载万世。","乘金宅兑，侑我明祀。","嘉觞布兰，牲玉洁精。","神之燕虞，肃用有成。"],0,"x207","宋"],["偈五首 其一","释宗琏","四言",["暗穿玉线，密度金针。","如水入水，似金博金。"],0,194,"宋"],["癸丑仲秋建安郡学丁奠退而作颂并勉同志之士颂曰","赵汝腾","四言",["建水怀襄，孔殿岿然。","文未坠地，道昭于天。","轮奂鼎新，丁奠揭虔。","肃肃冠佩，粲粲豆笾。","惟圣立范，载籍具传。","浑浑噩噩，书教百篇。","危微精一，纲领所先。","诗六义教，风雅颂全。","曰思无邪，蔽以一言。","易教精微，四德首元。","演六十四，母坤父干。","春秋事教，惟义与权。","行夏之时，独许颜渊。","乐教导和，钟鼓管弦。","雷出地豫，乐之大原。","礼教导中，三百三千。","其端辞逊，如始达泉。","垂兹六教，何千万年。","眷惟此邦，儒哲比肩。","厥有考亭，是绍涧瀍。","发挥六学，有功圣贤。","守吏初献，与士周旋。","祀毕作颂，同志勉旃。"],0,47,"宋"],["宁宗郊前朝献景灵宫二十四首 皇帝还位用《干安》。圣祖位奉玉币用《灵安》，高宗御制，见前。","郊庙朝会歌辞","四言",["桂宫耽耽，藻仪穆穆。","天回衮彩，风韶璜玉。","咸英皦亮，容典炳煜。","假我上灵，景命有仆。"],0,"x207","宋"],["上钦成皇后册宝六首 其三 盥洗用《嘉安》。","郊庙朝会歌辞","四言",["有炜柔仪，率履不越。","惠于初终，既明且达。","我将我享，相盥乃登。","胡臭亶时，攸介攸宁。"],0,"x207","宋"],["偈颂一百二十三首 其三十八","释普度","四言",["李白桃红，桃红李白。","或雨或晴，或寒或热。"],0,144,"宋"],["景祐祭文宣王庙六首 兖国公配位酌献用《成安》。哲宗朝增此一曲。","郊庙朝会歌辞","四言",["无疆之祀，配侑可宗。","事举以类，与享其从。","嘉栗旨酒，登荐惟恭。","降此遐福，令仪肃雍。"],0,"x207","宋"],null,["熙宁以后祀高禖六首 其二 升降用《正安》。","郊庙朝会歌辞","四言",["郊禖之应，肇自生商。","诞膺宝命，浚发其祥。","天材蕃衍，德称君王。","本支万世，与天无疆。"],0,"x207","宋"],["东山图赞 许玄度","叶梦得","四言",["扬眉轩然，意轶万里。","亦将焉往，而竟斯止。","曰远游者，以是为游。","疾走息阴，彼将安休。"],0,4,"宋"],["魏京诗 其十五","刘敞","四言",["尔视京魏，以作我都。","以赫厥灵，俾后勿逾。"],0,"x51","宋"],["宁宗郊祀二十九首 诣望燎位用《干安》。","郊庙朝会歌辞","四言",["莫神乎天，阳嘘而生。","日月星辰，皆干之精。","肆求厥类，与阳俱升。","视燎于坛，展也大成。"],0,"x207","宋"],["元德皇后升祔一首 《显安之曲》。","郊庙朝会歌辞","四言",["显矣皇妣，德侔柔祇。","升祔太室，协礼之宜。","耀彼宝册，列之尊彝。","惟诚是厚，永佑庆基。"],0,"x207","宋"],["王敏节欢喜帖赞","岳珂","四言",["秦火燎原，衣冠涂炭。","绕指之柔，出乎百锻。","如公之刚，犹死忧患。","时欤命欤，一览三叹。"],0,"x202","宋"],["绍兴二十八年祀圜丘 再诣盥洗用《干安》。","郊庙朝会歌辞","四言",["帝出于震，巽惟洁齐。","神明其德，乃称禋柴。","惟兹吉蠲，昭事聿怀。","重盥而祀，敷锡孔皆。"],0,"x207","宋"],["绍兴祀皇地祇十五首 盥洗用《正安》。","郊庙朝会歌辞","四言",["于穆盛礼，肃肃在宫。","蒇事有初，直于东荣。","涤濯是谨，惟寅惟清。","祗荐柔嘉，享兹克诚。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 神农位酌献用《穆安》。","郊庙朝会歌辞","四言",["肇降生民，有不粒食。","维时神农，乃为先啬。","尔耒尔耨，云谁之因。","酌以污尊，我思古人。"],0,"x207","宋"],["枢相宣抚虞公寿雅 汉清 其五","王质","四言",["公来自吴，襄民蹙蹙，止公毋蜀。"],0,"x37","宋"],["政和二年余谪海外馆琼州开元寺俨师院遇其游行市井宴坐静室作务时恐缘差失念作日用偈八首 其三","惠洪","四言",["道人何故，淫坊酒肆。","我自调心，非干汝事。"],0,"x42","宋"],null,["绍兴祀岳镇海渎四十三首 其四 东岳位酌献用《成安》。","郊庙朝会歌辞","四言",["岩岩天齐，自古在昔。","肤寸之云，四方其泽。","惟时东作，祀事乃饬。","惠我无疆，恩沾动植。"],0,"x207","宋"],["绍兴亲享明堂二十六首 其五 上帝位奠玉币用《镇安》。","郊庙朝会歌辞","四言",["皇皇后帝，周览四方。","眷我前烈，燕娭此堂。","金支秀发，黼帐高张。","世歆明祀，曰宋是常。"],0,"x207","宋"],["绍兴祀太社太稷十七首 太社位奠玉币用《嘉安》。秋腊太稷、土正、后稷通用。","郊庙朝会歌辞","四言",["赫赫媪神，稼穑是司。","方是藉敛，报本攸宜。","嘉坛建祀，玉帛陈仪。","明灵昭格，以介蕃厘。"],0,"x207","宋"],["汾阴十首 其九 后土庙降神用《靖安》。","郊庙朝会歌辞","四言",["博厚流形，秉阴成德。","柔顺利正，直方维则。","明祇格思，素汾之侧。","祗载吉蠲，宸心翼翼。"],0,"x207","宋"],["张安国书简帖赞","岳珂","四言",["汉轻法言，耳目所忽。","予藏于湖，亦近世物。","气并华剑，烈同段笏。","匪尚其容，亦尚其骨。"],0,"x202","宋"],["绍兴亲享明堂二十六首 其二十四 望燎用《仪安》。","郊庙朝会歌辞","四言",["载酌载献，以纯以精。","歌传夜诵，物备秋成。","报本斯极，听卑则明。","愿储景贶，福我群生。"],0,"x207","宋"],["司中司命五首 其三 奠币用《容安》。","郊庙朝会歌辞","四言",["我诚既洁，我豆既丰。","神来降斯，有俨其容。","荐此嘉币，肃肃雍雍。","何以侑之，于乐鼓钟。"],0,"x207","宋"],null,["皇后庙十五首 其四 酌献孝明皇后室用《惠安》。","郊庙朝会歌辞","四言",["祀事孔明，庙室惟肃。","铏登笾豆，金石丝竹。","既灌既荐，允恭允穆。","奉神如在，以介景福。"],0,"x207","宋"],["景德祀九宫贵神三首 其二 奠玉币、酌献用《嘉安》。","郊庙朝会歌辞","四言",["灵禋既肃，明神既秩。","在国之东，协日之吉。","升歌有仪，六变中律。","怀和万灵，降兹阴骘。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 再诣圣祖位用《干安》。","郊庙朝会歌辞","四言",["肇基骏命，巩右鸿业。","鼎玉龟符，垂固万叶。","灵贶具臻，神光烨烨。","晖祚无疆，规重矩叠。"],0,"x207","宋"],["宁宗郊前朝献景灵宫二十四首 终献用《冲安》。","郊庙朝会歌辞","四言",["灵舆蹇骧，毕觞泰筵。","贰飨允穆，祼将克竣。","垂恩储祉，锡羡永年。","将以庆成，燕及皇天。"],0,"x207","宋"],["枢相宣抚虞公寿雅 汉清 其九","王质","四言",["日月躞躞，勿黧公色。","霜露烈烈，勿华公发。"],0,"x37","宋"],null,["建隆以来祀享太庙十六首 其十 宣祖室用《大庆》。","郊庙朝会歌辞","四言",["艰难积行，绵长钟庆。","同人之时，得主乃定。","既叙宗祧，乃修舞咏。","经武开先，永昭丕命。"],0,"x207","宋"],null,["大观祀社稷九首 酌献用《嘉安》。","郊庙朝会歌辞","四言",["坤元生物，功利相宣。","蠲兹祀事，美报致虔。","清酤芬如，灵坛岿然。","酌尊奠觞，神其格焉。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 初献升降用《肃安》。","郊庙朝会歌辞","四言",["礼仪告具，心俨容庄。","工歌屡奏，声和义章。","崇坛陟降，济济跄跄。","灵光共仰，嘉荐芬芳。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 初献升降用《肃安》。","郊庙朝会歌辞","四言",["盥献恭庄，燎烟芬酷。","载陟载降，礼容可度。","钦惟尔神，上下肃肃。","成我稷黍，鉴此牲玉。"],0,"x207","宋"],null,["枢相宣抚虞公寿雅 汉清 其六","王质","四言",["金我襄城，汤我汉江。","春我之筐，秋我之箱。"],0,"x37","宋"],["明道亲享先农十首 其六 饮福用《禧安》。","郊庙朝会歌辞","四言",["神既至飨，福亦来酬。","申锡纯嘏，旨酒惟柔。","思文后稷，贻我来牟。","子孙千亿，丕荷天休。"],0,"x207","宋"],["绍兴祀九宫贵神十首 太一位酌献用《嘉安》。","郊庙朝会歌辞","四言",["惟天丕冒，彪列九神。","财成元化，阴骘下民。","有酒斯旨，登荐苾芬。","昭哉降鉴，茀禄来臻。"],0,"x207","宋"],["宁宗朝享三十五首 盥洗用《干安》。","郊庙朝会歌辞","四言",["天一以清，地一以宁。","维皇精专，承神明灵。","娥御堕津，渎祇扬溟。","盥事允严，先祖是听。"],0,"x207","宋"],null,["绍兴祀先农摄事七首 其三 奠币用《明安》。","郊庙朝会歌辞","四言",["灵斿载临，见先陈贽。","有严篚实，式将纯意。","肸蚃既接，礼行有次。","神兮安留，歆我禋祀。"],0,"x207","宋"],null,["绍兴祀皇地祇十五首 彻豆用《娱安》。","郊庙朝会歌辞","四言",["承天效法，其道贵诚。","牲羞黄犊，荐德之馨。","芳俎告毕，礼备乐盈。","既静既安，庶物沾生。"],0,"x207","宋"],["偈颂一百四十二首 其五十八","释广闻","四言",["不用低头，思量难得。","物有定价，钱是足陌。"],0,10,"宋"],["枢相宣抚虞公寿雅 汉清 其四","王质","四言",["公来自东，襄民蹙蹙，止公毋西。"],0,"x37","宋"],["大观三年释奠六首 其四 酌献用《成安》。","郊庙朝会歌辞","四言",["道德渊源，斯文之宗。","功名糠秕，素王之风。","硕兮斯牲，芬兮斯酒。","绥我无疆，与天为久。"],0,"x207","宋"],["皇后庙十五首 其六 孝章皇后室用《懿安》。","郊庙朝会歌辞","四言",["猗那淑圣，象应资生。","配天作合，与日齐明。","椒宫垂范，彤史扬名。","聿修毖祀，永奉粢盛。"],0,"x207","宋"],["绍兴朝会十三首 公卿入门用《正安》。升降同。","郊庙朝会歌辞","四言",["天子当阳，臣工率职。","流水朝宗，众星拱极。","环佩锵锵，威仪抑抑。","上下交欣，同心同德。"],0,"x207","宋"],["河东马步军副总管王公","《靖康小雅》作者","四言",["矫矫虎臣，捍城于并。","殚其智力，为国长城。","攻逾两时，敌不能乘。","无食无援，百雉乃倾。","负像赴水，义不苟生。","大节卓伟，千载光明。"],0,91,"宋"],["绍兴祀先农摄事七首 其六 亚、终献用《同安》。","郊庙朝会歌辞","四言",["旨具百味，酌备三畴。","贰觞既毕，礼洽意周。","庶几嘉飨，格神之幽。","相我穑事，锡以有秋。"],0,"x207","宋"],["绍兴朝日十首 奉俎用《丰安》。","郊庙朝会歌辞","四言",["扶桑朝暾，和气肸饬。","奉此牲牢，为俎孔硕。","芬馨进闻，介我黍稷。","所将以诚，兹用享德。"],0,"x207","宋"],["建隆干德朝会乐章二十八首 皇帝举酒第一盏用《白龟》。","郊庙朝会歌辞","四言",["圣德昭宣，神龟出焉。","载白其色，或游于川。","名符在沼，瑞应巢莲。","登歌丹陛，纪异灵篇。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其十 南方迎神用《凝安》。","郊庙朝会歌辞","四言",["朱明盛长，我祀用饬。","厥祀伊何，山川咸秩。","如将见之，绳绳齐栗。","神哉沛兮，消摇来格。"],0,"x207","宋"],["偈","释志清","四言",["天不能盖，地不能载。","徧界徧空，成团成块。"],0,187,"宋"],["枢相宣抚虞公寿雅 汉清 其八","王质","四言",["我孩婴婴，公昔体之，而曷置之。"],0,"x37","宋"],["绍兴祀神州地祇十六首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["缩酌以祼，既旨且多。","三献有序，情文愈加。","黄祇临享，锡以休嘉。","广兹灵祲，覃及迩遐。"],0,"x207","宋"],["朝谒太清宫九首 其二 宝册升殿用《大安》。","郊庙朝会歌辞","四言",["图书昭锡，典礼绍成。","烝民何幸，教父储灵。","钦承景贶，祗奉崇名。","致虔宝册，垂祐基扃。"],0,"x207","宋"],null,["景灵宫乐章 尚书彻馔吉安之曲","周麟之","四言",["普淖既荐，苾芬孔时。","神嗜而顾，有来宴娱。","飨矣将彻，载钦载祗。","展诗以侑，益臻厥熙。"],0,103,"宋"],["宁宗郊前朝献景灵宫二十四首 皇帝入门用《干安》。","郊庙朝会歌辞","四言",["閟幄邃深，云景杳冥。","天清日晬，展容玉庭。","缔基发祥，希夷降灵。","神其来燕，是飨是听。"],0,"x207","宋"],["朝谒太清宫九首 其四 奉玉币用《灵安》。","郊庙朝会歌辞","四言",["琳宫奕奕，黼坐煌煌。","玉帛成礼，飙驭延祥。","鸿仪有则，景福无疆。","嘉应昭协，丕犹诞扬。"],0,"x207","宋"],["补乐府十篇 其六 帝高辛氏之乐歌","曹勋","四言",["时雨蒙蒙，自西及东。","日月所至，罔不率从。","田有黍稷，原有榛栗。","尊卑秩秩，民有家室。","惟川冲冲，惟山崇崇。","允执厥中，臻于大同。"],0,"x103","宋"],["南窗植竹数百竿后数日蔚然俱青客问种竹法作四言以告之","周紫芝","四言",["平生寡友，形影相吊。","与君结交，相视一笑。","四方万里，动静险夷。","我惟子求，子必我随。","聿来湓江，屋庐既正。","相子攸居，我室乃定。","得子之宫，于窗之南。","风茎雨叶，蔚其𩭹𩭹。","人言死猫，可引活竹。","猫死地虚，根行竹绿。","又言无法，移必行迷。","仍标其根，以识东西。","区区百设，何乃多事。","事在眉睫，初无妙理。","穴地成坎，碎土加筛。","沃以斗水，和之成泥。","置竹其中，实之以土。","土燥润久，可月不雨。","逮其雨来，竹既已成。","热不受暑，寒不变青。","嗟哉此君，以节自负。","如遇君子，理宜调护。","君欲何法，无法可传。","并以告子，俾知竹贤。"],0,"x139","宋"]]