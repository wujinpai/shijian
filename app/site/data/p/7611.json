[["行香子·废寺","曾廉","词",["行过翠微，大众歔欷。","说如来、久闭金扉。","水精域里，无限凄其。","看粪著头，雨注面，草齐眉。","悟到三生，旧果依稀。","护法人、不彻元微。","若除魔道，重证禅机。","只贝叶经，伊蒲馔，水田衣。"],0,92,"清"],["行香子·生涯","曾廉","词",["白屋人家，丛棘篱笆。","傍柴门、池草鸣蛙。","有人借问，近日生涯。","有衡山姜，句曲杏，青门瓜。","藉藉纷纷，世事如麻。","叹金乌、容易西斜。","抚今思昔，无任咨嗟。","只武昌鱼，新丰酒，上林花。"],0,92,"清"],["行香子·有见","曾廉","词",["雨后晴天，犹带凉烟。","试罗衫、益觉翩翩。","合欢花下，顾影如仙。","只霎时闲，顺风去，下滩船。","隔个苹洲，绿树娟娟。","只从来、幽梦难圆。","游丝割去，又复缠绵。","看钓矶头，绿槐上，噪新蝉。"],0,92,"清"],["行香子·消暑","曾廉","词",["投去牙签，彩笔慵拈。","能得闲、拂拭苍髯。","算来人世，百味都兼。","有卢橘酸，黄蘖苦，蜜煎甜。","朱雀航边，未卷青帘。","又丹霄、挂了银蟾。","好寻酒伴，去避尘炎。","对云母屏，冰绡帐，水精帘。"],0,92,"清"],["蝶恋花 闺情","曾廉","词",["献鸟卖花时恰凑。","帘影重重，却有清香透。","竹榻憨眠衣折皱。","侍儿架上寻威斗。","碧玉方壶丝系就。","为要清凉，冰下沙仁酒。","时样窄衫还窄袖。","非关愁思腰支瘦。"],0,92,"清"],["蝶恋花·秋夜","曾廉","词",["翠阁朝朝还暮暮。","十颗青枫，九颗成红树。","寒壁秋虫偎枕语。","鹅更警夜同衙鼓。","人在江南将上住。","夜梦不成，梦即江南去。","容易江南烟水误。","梦魂怪熟江南路。"],0,92,"清"],["蝶恋花·秋感","曾廉","词",["碧绿清溪映绣户。","三四酒徒，欢笑摇船去。","当日醉眠横股处。","桃花十里遮无路。","楼上湘帘楼下树。","树影数寻，护得高楼住。","袅袅秋风天未曙。","打楼落叶纷如雨。"],0,92,"清"],["蝶恋花·戏赠","曾廉","词",["冠玉人材凌汉气。","表表风姿，堪作桃根婿。","桃叶桃根谁妩媚。","芙蓉出水原同蒂。","宋玉墙头依旧是。","何处楚宫，芦荻连烟水。","肯出晶帘催客醉。","樽前珍重东君意。"],0,92,"清"],["蝶恋花·春暮","曾廉","词",["落尽庭花春色暮。","湘竹帘开，款款微风度。","莲沼欣将泉水注。","未知山上泉来处。","把镜朝来私自觑。","何事匆匆，苦要临邛去。","独拨盘香烟几缕。","窗前鹦鹉闲无语。"],0,92,"清"],["蝶恋花·寄女儿","曾廉","词",["多病多愁因甚故。","有点聪明，却被聪明误。","月缺还圆晴又雨。","人生那有周全处。","尘俗难教仙诀悟。","积虑心头，有什么佳趣。","一桶鏖糟忙打去。","凭窗永日看山树。"],0,92,"清"],["蝶恋花·惜别","曾廉","词",["做客情怀难得说。","才喜相逢，莫便言离别。","虽使须眉森似铁。","陇头流水声声咽。","看看又过寒食节。","几日春风，老绿黄莺舌。","寻个歌儿歌一阕。","梨花满院飞如雪。"],0,92,"清"],["蝶恋花·瞿昙","曾廉","词",["请出瞿昙还束缚。","只恐等闲，失却僧家钵。","系臂白猿时自脱。","人生半死争毫末。","四万藏经嫌澹泊。","七宝宫前，三四天魔泼。","佛祖天魔谁更弱。","十方菩萨原同恶。"],0,92,"清"],["蝶恋花·春老","曾廉","词",["山外仙山尘不到。","碧玉阑干，稀见香车造。","花落酒徒无处闹。","一双胡蝶粘芳草。","漠漠天涯迟远耗。","听罢黄莺，又复蝉声噪。","绿鬓渐凋春渐老。","年年只祝人长好。"],0,92,"清"],["蝶恋花·伊人","曾廉","词",["夜雨焦窗灯一炷。","不悔孤居，只悔琼筵遇。","当日无言心已许。","人前解佩茫无绪。","扬子江边回棹处。","芦笋初生，又见飞芦絮。","芦絮漫天何处去。","伊人只隔江干树。"],0,92,"清"],["蝶恋花·秋千","曾廉","词",["桃李开时烟复雾。","是甚人家，桃李丛中住。","吹笛玉人知几许。","满村烟雾浓于雨。","烟雾徐开闻笑语。","一架秋千，搭上青霄去。","芳树彩绳魂系处。","年年得结神仙侣。"],0,92,"清"],["蝶恋花·有寄","曾廉","词",["月上阑干霜满地。","酒客诗人，同觅朱楼醉。","红烛烧残花更丽。","醉倒莫便腾腾睡。","山抹微云佳女婿。","云散山空，还复听歌吹。","移入新词名绿意。","尊前有个人儿媚。"],0,92,"清"],["蝶恋花·江楼","曾廉","词",["正是花时鸣鸟误。","好鸟迟鸣，已是春将暮。","豆子山前打瓦鼓。","青青豆子蒙蒙雨。","又复水生桃叶渚。","人倚阑干，红紫无重数。","若到花闲花共语。","花闲不醉休归去。"],0,92,"清"],["蝶恋花·游春","曾廉","词",["落尽梨花飞柳絮。","浅浅春寒，穿不绵衣住。","风里酒旗黏碧树。","当垆是有文君处。","一碟青青豌豆煮。","春在芳樽，莫道春无主。","欲理归鞍天又雨。","俊骓恋草慵于去。"],0,92,"清"],["蝶恋花·饼师","曾廉","词",["近日南人多北态。","十处人家，九处馒头卖。","蒸上馒头肥可爱。","只无黄米汤儿配。","更有饼师矜狡狯。","汤饼搓成，粗似条枚大。","豆子青皮和白菜。","清松胜似江南脍。"],0,92,"清"],["生查子 红豆","曾廉","词",["红豆与明珠，不识谁为宝。","红豆在心头，明珠空耳后。","珍重缕金衣，懒把蛾眉扫。","经岁复经年，看看红颜老。"],0,92,"清"],["生查子·山行","曾廉","词",["莽莽万重山，何处堪投宿。","此去有人家，坂上眠黄犊。","扶杖转山腰，败堵依修竹。","采药未归来，青藓生茅屋。"],0,92,"清"],["生查子·归舟","曾廉","词",["江上望渔阳，渺渺知何处。","昨日有人来，说是临邛去。","桃李才成阴，又见飞芦絮。","天际是归舟，系在江边树。"],0,92,"清"],["生查子·纱窗","曾廉","词",["江上晚晴天，伫立知何处。","向日是纱窗，只隔桃花树。","花落满前庭，悄悄无人语。","架上挂湘裙，便是屏风阻。"],0,92,"清"],["清平乐 咏事","曾廉","词",["与人难与。","拒又愁难拒。","明月权为林苑主。","差些无累黍。","原知非力能堪。","惟有再请瞿昙。","又得狙公妙术，仍是暮四朝三。"],0,92,"清"],["清平乐","曾廉","词",["雨余微霁。","果生难脱蒂。","要得收梢良不易。","且作须臾计。","各人自管行囊。","口称火色金光。","一旦胡卢打破，个中糜烂瓜瓤。"],0,92,"清"],["荷叶杯 马勃，俗曰马屁泡","曾廉","词",["珍重韩康箧里，牛溲马勃鼓留皮。","一团弹指似烟飞。","莫又负医师。","四十万头神骏，开元汧渭五云飞。","如今京洛草离离。","泡影使人疑。"],0,92,"清"],["荷叶杯·本意","曾廉","词",["几幅珠帘翠箔，笙歌声拥白头翁。","海霞色映一杯红。","衰老发春容。","无限荷花荷叶，池中百子已成空。","只今曲岸已梧桐。","叶叶向秋风。"],0,92,"清"],["荷叶杯·采莲","曾廉","词",["何处瓜皮艇子，闻声知是小吴娃。","荷花如脸脸如花。","一色泛朝霞。","一霎飘摇秋雨，银塘荷叶响沙沙。","打开浴鹭湿栖鸦。","暂向柳阴遮。"],0,92,"清"],["祝英台近 风雨","曾廉","词",["放珠帘，掩绣户。","双泪缀如缕。","谁解留人，最好是风雨。","纷纷镇日连宵，桃花流水，画桥断、征鞍无路。","且延伫。","楼外万水千山，重重总烟雾。","迢递修门，过访更何处。","倚屏还与思量，春寒如许。","倒莫被、角声催去。"],0,92,"清"],["祝英台近·留春","曾廉","词",["莫愁湖，桃叶渡。","旧是弄舟处。","正好春光，怕又逐潮去。","依稀极浦危楼，楼头人在，倚银管、教留春住。","又风雨。","六代花草凄迷，天低冶城树。","谁更寻芳，马迹半泥絮。","亦知春有时来，春来如故。","怕只是、美人迟暮。"],0,92,"清"],["祝英台近·赏春","曾廉","词",["正窗前，霞影绽。","侵晓雨初散。","小院沈沈，帘幕下银蒜。","有人慵自梳头，玉台斜倚，只频听、鸠鸣莺唤。","绿杨岸。","多少宝马香车，还张碧罗幔。","人影衣香，尽是看花伴。","不妨春信迟来，桃秾梨烂。","算赚了、一春多半。"],0,92,"清"],["祝英台近·大水","曾廉","词",["望苍茫，极平楚。","一霎没洲渚。","五月端阳，也似暮春雨。","匆匆水上桥头，篾篷横转，且凭系、檐前高树。","倚朱户。","试看桃叶帘前，年年艾如虎。","丹碧龙舟，准拟听箫鼓。","盼他兰桨东来，今天停渡。","怪不得、把佳期阻。"],0,92,"清"],["祝英台近·秋雨","曾廉","词",["登层楼，望极浦。","无限暮山阻。","镇日愁人，最苦是秋雨。","明明百炼钢金，又还分散。","巧缠绕、漫天丝缕。","甚头绪。","正想塞雁书来，寻看又无据。","渺渺珠宫，屈戍锁将住。","只今溅泪成河，惟凭柔橹。","轧轧向、斗牛摇去。"],0,92,"清"],["祝英台近·莫愁","曾廉","词",["有黄莺，穿碧树。","枝上作吴语。","谁料春来，困倦遽如许。","江南离别多年，重重烟水。","梦魂断、江南何处。","却回顾。","最是玄武青溪，画舫看无数。","云样罗衣，芬馥胜兰杜。","几时青鸟重来，春帆高举。","直飏向、郁金堂去。"],0,92,"清"],["昭君怨 送别","曾廉","词",["谁唱阳关三叠。","黄却满林秋叶。","旧恨与新愁。","倚楼头。","此日不应远出。","出又谁家安笔。","明岁菊花开。","待归来。"],0,92,"清"],["昭君怨·倾卮","曾廉","词",["一夜朔风何险。","白了青山千点。","江上望归舟。","水飞流。","新采黄獐初熟。","一瓮寒醪碧绿。","此际不倾卮。","待何时。"],0,92,"清"],["昭君怨·有赠","曾廉","词",["小亭莲花残否。","雅会红菱碧藕。","潋滟酒盈钟。","更情浓。","风动帘前画烛。","蹙蹙轻绡生縠。","一曲懊侬歌。","奈卿何。"],0,92,"清"],["昭君怨·有咏","曾廉","词",["应是画眉太懒。","泪滴春衫都满。","向抱欲相亲。","怯回身。","疏隔久成生客。","几载荡精销魄。","再过杏花楼。","断帘钩。"],0,92,"清"],["昭君怨·前题","曾廉","词",["谁信红鸾照就。","换了孤辰寡宿。","合起万闲楼。","贮春愁。","满院落花谁扫。","寂寞一原荒草。","同穴始甘心。","负情深。"],0,92,"清"],["画堂春 有咏","曾廉","词",["夜来喜子上窗纱。","海棠嫁了梅花。","画堂扶下七香车。","宫鬓堆鸦。","此日忽传意外，五张六角交差。","芝焚蕙叹共咨嗟。","幽恨无涯。"],0,92,"清"],["画堂春·清溪","曾廉","词",["纤尘隔断是清溪。","阿侬家在桥西。","辛夷花落海棠稀。","寂寂芳蹊。","侵晓日头初上，窗前绿树迷离。","一双燕子拂帘低。","莫滴芹泥。"],0,92,"清"],["画堂春·有赠","曾廉","词",["江豚正是上盘时。","桃花竹外枝枝。","蒌蒿满地嫩芦肥。","绿蚁盈卮。","难得芳春风景，小鬟恰到催诗。","裁笺点墨与填词。","喜上双眉。"],0,92,"清"],["画堂春·小院","曾廉","词",["扫过残霜见青苔。","何人小立香阶。","枝头干鹊喜晴晖。","应是人回。","小院谁敲绣户，传言驿使东来。","贻侬九凤紫金钗。","依旧天涯。"],0,92,"清"],["渔家傲 酒肆","曾廉","词",["座上红裙来进酒。","接杯不是乌衣手。","腹有藏珠钱在口。","君知否。","从今再莫轻屠狗。","只说黄金高北斗。","谁为鸡口非牛后。","怕见金毛狮子吼。","快些走。","管他荷叶莲蓬藕。"],0,92,"清"],["渔家傲·京师元夜","曾廉","词",["元夜六街聊散步。","一天明月无纤雾。","不见龙蟠师子舞。","寂无语。","家家门闭闻箫鼓。","门外纱灯金作柱。","卖茶店里多银树。","古事多年寻甚据。","空延伫。","不如归向醉乡去。"],0,92,"清"],["渔家傲·江上登高","曾廉","词",["欠了酒钱真个大。","酒家不要金鱼袋。","柑橘半黄人唤卖。","愁难耐。","年年又复添诗债。","江上秋云红复黛。","楼头便作登高会。","摘菊玉人亲与戴。","何时再。","春葱更为剥鲜蟹。"],0,92,"清"],["渔家傲·湖上有怀","曾廉","词",["手把荷花来劝酒。","荷花不及佳人手。","座上红莲更碧藕。","大开口。","人生难得王乔寿。","又是梧桐秋落后。","湘帘斐几还依旧。","昔日游龙今日狗。","咨嗟久。","风流谁似湖州守。"],0,92,"清"],["渔家傲·饮田家","曾廉","词",["炒了嫩鸡开老酒。","乡村风味何曾有。","边缺瓦盆谁道丑。","闲谈久。","主人更为加春韭。","风景看看寒食后。","墙头生笋围如缶。","见说养鹅求美妇。","具肥牡。","良辰再过倾三斗。"],0,92,"清"],["渔家傲·雪夜即席","曾廉","词",["萼绿仙人双眉靥。","微微听响长廊屧。","金缕裙子还百折。","彩云叠。","熏笼上立身如叶。","堂上五花地衣贴。","中庭大雪铺如■。","舞罢腰支微觉苶。","太轻捷。","夜寒那得穿花蝶。"],0,92,"清"],["渔家傲","曾廉","词",["裙色银红衫色酱。","商量问赠当何饷。","晴日邻姝相过访。","聊笑向。","手头攀住垂杨漾。","袅袅东风杨柳宕。","一时牵挂抬头望。","顾曲周郎曾昔傍。","心颇怅。","侍儿服饰都新样。"],0,92,"清"],["少年游 本意，用东坡体赠欧阳盐副子衡","曾廉","词",["人生须是少年游。","佳气满皇州。","从教卫玠，万人看杀，也是剧风流。","浙中副使朝天子，有骏马、更轻裘。","公子翩翩，据鞍顾盼，何用羡公侯。"],0,92,"清"],["少年游·赠章庶常曼仙","曾廉","词",["人生须是少年游。","绣阁喜凝眸。","翩翩夫婿，宫袍烂漫，谁更觅封侯。","秦淮河上宵开宴，有玉手、进金瓯。","罗绮丛中，笙歌队里，争拜锦缠头。"],0,92,"清"],["少年游·怀李公孙晓村","曾廉","词",["人生须是少年游。","佳梦话琼楼。","公孙潇洒，临风玉树，照彻大江秋。","阑干又看娟娟月，正绣箔、挂银钩。","何处吹箫，玉人袅袅，二十四桥头。"],0,92,"清"],["少年游·赠夏编修午彝","曾廉","词",["人生须是少年游。","韵事话瀛洲。","青春天气，丛丛宫树，掩映禁城楼。","郎君及第宫袍丽，响玉佩、近螭头。","走马天街，珠香翠暖，十里上银钩。"],0,92,"清"],["少年游·忆蒋述亭","曾廉","词",["人生须是少年游。","玉立足风流。","万言倚待，又能拔剑，啸傲小沧洲。","谁知识字将人误，若灶下、早封侯。","莽莽天风，驾舟黑海，何不便归休。"],0,92,"清"],["定风波 虞美人","曾廉","词",["家世千年赵上卿。","晚春丽质照人明。","西楚雄王如怒虎。","媚妩。","多情抵死惜倾城。","李代桃僵原恨事。","子细。","芙蓉贻累及娉婷。","岁岁年年能善舞。","无数。","黄鹂枝上叶歌声。"],0,92,"清"],["定风波·寻春","曾廉","词",["玉勒寻春日欲斜。","山围江郭水平沙。","好著丹青图画取。","去去。","绿杨深处是苏家。","行到垂杨逢绣阁。","寂寞。","美人东渡掩窗纱。","帘下侍儿新打扮。","试看。","越中生女尽如花。"],0,92,"清"],["定风波·寄何五","曾廉","词",["绮席金盘脍鲤鱼。","绣帘朱槛玉人居。","满院繁花红又紫。","只是。","风光不称白髭须。","却笑元龙豪气在。","狂态。","每来花下得踟蹰。","与子更横江海去。","佳处。","月明楼阁在空虚。"],0,92,"清"],["定风波·寄谢五","曾廉","词",["丛石孤桥屋似艭。","蔗园风物亚邗江。","夹路青青书带草。","刚好。","诗人终日倚书窗。","四十六年同作赋。","人诩。","六朝体格韵琤𪻐。","岂料如今俱白首。","惟有。","春来幽兴在兰茳。"],0,92,"清"],["定风波·寄乔一乔二","曾廉","词",["当日人呼大小乔。","只今鬓发日飘萧。","我亦石桥年少者。","奔马。","不知平地与云霄。","相去东西才百里。","何事。","天涯涕泪一身遥。","老病人扶难再拜。","何害。","如今一醉万愁消。"],0,92,"清"],["定风波·小鬟","曾廉","词",["不待闻歌唤奈何。","水精帘子是银河。","帘子打开垂首立。","情急。","今朝无黛点双蛾。","碧玉小家能大雅。","窗下。","不加脂粉媚情多。","袅袅花枝禅意在。","须戴。","何妨一笑见维摩。"],0,92,"清"],["定风波·秋集莫愁湖","曾廉","词",["湖上桃枝带柳条。","春来客子尽魂销。","箫管画船明月夜。","上下。","清虚天里打兰桡。","又是题糕重九节。","清绝。","钟山倒影倚青霄。","更与佳人携手看。","无限。","雨荷风叶共萧萧。"],0,92,"清"],["定风波·问柳轩小饮","曾廉","词",["朱雀桥边野草花。","秦淮浊水不关沙。","问柳轩前寻美酒。","翘首。","窗棂四面尽红纱。","本是六朝金粉地。","何意。","垂鞭不见五云车。","洞口桃花含笑处。","无语。","绿杨过去两三家。"],0,92,"清"],["定风波·即席","曾廉","词",["阶下泉声逼酒寒。","杨梅红透水精盘。","传杯三五纤纤手。","虽久。","月明犹在搭衣竿。","钟鼓楼前量刻漏。","挥袖。","人生何处不邯郸。","莫待黄粱春梦醒。","佳境。","离离花影满阑干。"],0,92,"清"],["定风波·宴李氏宅","曾廉","词",["卷石为山斗水池。","俨然湖上绿沦漪。","昨夜吹箫声满院。","相见。","生绡如雪照花枝。","荷叶苞羞持劝客。","殽核。","半红频果酒盈卮。","雅会乘今宜笑乐。","惊咢。","西风又是授衣时。"],0,92,"清"],["定风波·青溪小饮","曾廉","词",["玉槛银屏曲径通。","芳春收得入帘栊。","云在妆台山在镜。","探听。","杏花消息雨声中。","九十韶光疑是梦。","春冻。","街头已见卖花红。","拚与插花人一醉。","留意。","到头无计奈春风。"],0,92,"清"],["定风波·忆章曼仙","曾廉","词",["夜宴秦淮酒易酣。","翰林清致似刘惔。","自从别后无消息。","长忆。","执杯人比杏花憨。","二十三年何足数。","居处。","乌衣巷口柳毵毵。","庾信小园河渭上。","惆怅。","挥毫总是说江南。"],0,92,"清"],["定风波·小集十刹海酒楼","曾廉","词",["十刹层楼俯镜奁。","座中宾客朔南兼。","莲花四月开何早。","刚好。","香风冉冉透湘帘。","劝酒人来年二八。","怜杀。","揭帘如玉手纤纤。","共道市坊烧鸭美。","松齿。","一盘葱本医微甜。"],0,92,"清"],["调笑令 有寄","曾廉","词",["胡蝶。","胡蝶。","飞上美人画箑。","彩衣才得情亲。","江北江南暮春。","春暮。","春暮。","人影衣香遮路。"],0,92,"清"],["调笑令·喜子","曾廉","词",["喜子。","喜子。","展得美人皓齿。","昨宵裁就春衣。","寄语今岁早归。","归早。","归早。","几日妆楼尘扫。"],0,92,"清"],["调笑令·早蝉","曾廉","词",["春月。","春月。","照见花枝清绝。","玉人小立花边。","独听枝头早蝉。","蝉早。","蝉早。","莫又韶龄易老。"],0,92,"清"],["调笑令·孔雀","曾廉","词",["孔雀。","孔雀。","金翠斗人强弱。","若将孔雀夸侬。","侬是桃花嫩红。","红嫩。","红嫩。","日炙怕消风韵。"],0,92,"清"],["调笑令·缓归","曾廉","词",["么凤。","么凤。","飞上金钗微动。","侍儿制就罗衣。","陌上花开缓归。","归缓。","归缓。","犹趁琼楼月满。"],0,92,"清"],["调笑令·人立","曾廉","词",["双燕。","双燕。","飞入桃花深院。","水晶帘子初开。","人立阶前碧苔。","苔碧。","苔碧。","何处遥闻玉笛。"],0,92,"清"],["调笑令·银屏","曾廉","词",["春雨。","春雨。","沾润花丛如许。","丽人方倚银屏。","一见花开动情。","情动。","情动。","不记胡麻好种。"],0,92,"清"],["调笑令·兰桡","曾廉","词",["纤月。","纤月。","照彻凌波罗袜。","兰桡闲了三年。","只待人来荡船。","船荡。","船荡。","春在鸳鸯湖上。"],0,92,"清"],["八声甘州 寄女儿","曾廉","词",["烧香人、拜烂了蒲团，不如问心田。","看医方万卷，融然一喜，百病都捐。","不用思量旧事，东惹又西牵。","若果消心火，自少魔缠。","你父亲年虽老，新病瘳酒饭，都胜从前。","你母亲头腹，也好过当年。","我是神仙无思虑，你也应、学我作神仙。","从兹后，应知道，有个苍天。"],0,92,"清"],["南乡子 剪荷","曾廉","词",["烟水满池塘。","宛有佳人晒翠裳。","姣少衰迟俄顷事，思量。","难得花香叶又香。","白露剪残黄。","百子池边向靓妆。","却恨秋风团扇冷，郎当。","每替扬雄覆酱堈。"],0,92,"清"],["南乡子·春寒","曾廉","词",["花影漾重重。","锦被春寒未觉松。","更漏犹长人不寐，丁东。","檐马声嘶一夜风。","胡蝶入帘栊。","梦醒知在画帏中。","枕上诗成时自诵，玲珑。","日射纱窗四面红。"],0,92,"清"],["南乡子·玉漏","曾廉","词",["独酌亦何妨。","五夜秋来玉漏长。","月上纱窗人未寝，丁当。","环佩微闻响画廊。","握手怪冰凉。","瘦损蛮腰减晚妆。","十锦屏风兰麝透，仓皇。","人影依稀过粉墙。"],0,92,"清"],["南乡子·醉态","曾廉","词",["何处见烟螺。","十顷花香尽芰荷。","罗袜无尘纤步到，凌波。","正是云绡出绛河。","妙处在梨涡。","醉后宫商信口哦。","娇惰倩人扶不住，婆娑。","不待清歌唤奈何。"],0,92,"清"],["西江月 我佛","曾廉","词",["才见罢参下座，又传说戒升堂。","便将佛祖作魔王。","仍听群魔莽荡。","我佛自然依旧，群魔会复争强。","问谁护法是金刚。","只算元坛现相。"],0,92,"清"],["西江月·岁荒","曾廉","词",["一粥还添一饭。","算来何福能消。","饮河满腹便终朝。","省向人前问粜。","斥𫛩篱边鸣跃，大鹏天外逍遥。","牛山色对首阳骄。","只付沧波一笑。"],0,92,"清"],["西江月·啸庐小照","曾廉","词",["五十年来旧事，同吟池上梅花。","而今清泪落悲笳。","谁说词林风雅。","盈颔虽飘白雪，养神不用丹砂。","苍颜稍瘦目光加。","却老奇方无价。"],0,92,"清"],["西江月·笑咏","曾廉","词",["槛外青苍山在，门前清浅溪流。","仙人相与晚同舟。","佳梦从来难又。","碧水今名方顺，白云兼复温柔。","更从何处觅菟裘。","莫待生涯粗就。"],0,92,"清"],["西江月·社日","曾廉","词",["今日喜停针线，斜阳闲弄秋千。","困人正是杏花天。","借问如何消遣。","堪笑小姑居处，剧怜明月栾圆。","闭门花影自娟娟。","良夜迢迢深院。"],0,92,"清"],["西江月·苏院","曾廉","词",["粉蝶粘将衣桁，黄莺飞上花枝。","可人正是晚春时。","一幅花笺初试。","希逸儿名风月，韦郎宅枕山池。","神仙福地本无疑。","况有沈檀罗绮。"],0,92,"清"],["归国谣 嫦娥","曾廉","词",["真失措。","月宫巧把嫦娥锢。","行人不见眼前路。","嫦娥常在广寒府。","清光吐。","只消收得吴刚斧。"],0,92,"清"],["归国谣","曾廉","词",["嫦娥苦。","只因失却吴刚斧。","昔年仙桂今丛楚。","要得嫦娥消云雾。","天狗舞。","待看明月当三五。"],0,92,"清"],["归国谣","曾廉","词",["闲延伫。","天狗猖狂来复去。","嫦娥终古长天宇。","天家自有天家度。","起沈锢。","只要嫦娥传尺素。"],0,92,"清"],["河传","曾廉","词",["明镜。","朝映。","俏梨涡。","拈得桃花手挼。","最怜玉纤寒不呵。","由他。","春山轻点螺。","趁著春风花未谢。","诗赋罢。","攀绿秋千架。","乍新晴。","衣影明。","且停。","隔墙人语声。"],0,92,"清"],["河传","曾廉","词",["何处。","延伫。","绿蕉阴。","蒙得纱窗绿深。","隔窗玉人闲弄琴。","仙音。","梳头犹未簪。","一桁珠帘花影眩。","呼放燕。","才露芙蓉面。","海棠开。","休放杯。","有雷。","已看风雨来。"],0,92,"清"],["浪淘沙 蛾眉豆","曾廉","词",["苍翠正离披。","一架秋迟。","隔帘人影漫相疑。","晓日妆台初画处，未上胭支。","日夕劲风吹。","萧索疏篱。","𣨼人天气晚凉时。","连日沈沈阴不雨，愁绝蛾眉。"],0,92,"清"],["浪淘沙·有忆","曾廉","词",["休道硕人薖。","日暮残疴。","穷年寂寂守烟萝。","惟有蔚蓝天上月，依旧无他。","罗绮隔银河。","蹙蹙鳞波。","行宫门闭落花多。","杨柳灞桥人折尽，最忆秦娥。"],0,92,"清"],["浪淘沙","曾廉","词",["伯约计成空。","烟雾朦胧。","朝暾只在碧霄中。","滴下征衫无限泪，不是胡桐。","莫便惜龙钟。","原有天公。","芙蓉花待九秋红。","宝殿大樽千斛酒，良会重逢。"],0,92,"清"],["浪淘沙·不见","曾廉","词",["湖上问苏家。","门巷枇杷。","水晶窗下彩幡遮。","鹦鹉唤将帘打起，人面桃花。","小立自咨嗟。","冉冉年华。","绮筵散罢日西斜。","惆怅去年人不见，世事如麻。"],0,92,"清"],["浪淘沙·晴空","曾廉","词",["春夜颇冲融。","醉眼朦朣。","先生高卧杜楼中。","鸟语花开人睡醒，日上窗红。","倚槛仰晴空。","万里青铜。","飞鸿南北信难通。","举目何山犹是旧，郁郁葱葱。"],0,92,"清"],["踏莎行 初秋","曾廉","词",["月上窗棂，风生庭树。","初秋便觉天难曙。","今年多雨已深寒，草虫一夜床头语。","才见蓼花，未飞芦絮。","江湖寥阔空延伫。","几行锦字自何来，只应鸿雁知他处。"],0,92,"清"],["踏莎行·湖上","曾廉","词",["岸曲花飞，湖心鱼掉。","羊欣当日原年少。","苍茫五渚去人稀，孤篷休惹桃花笑。","万顷烟波，几回凭吊。","青山无数当斜照。","耳边多少鹧鸪啼，鹧鸪只在黄陵庙。"],0,92,"清"],["踏莎行·枉渚","曾廉","词",["一带篱笆，羝羊角痒。","才穿寸许便成丈。","茅山山上放悲声，恰闻沧海春潮声。","百尺石帆，凌风何往。","有人柳外敲孤桨。","张公吃酒李公颠，江头枉渚真成枉。"],0,92,"清"]]