[null,null,null,null,null,null,null,null,null,null,null,null,["水月亭","马辅","七言长篇",["阳来中坤坎波翻，月本于地仍东还。","谁为聚之古祗柏，涵碧湛湛琉璃盘。","珊瑚晶瑛澈凝湍，西风晚来觉秋宽。","海荡冰碎天飞旋，瞿昙指心以探禅。","魄死泽困与尔言，夜游倚声霓裳欢。","捉影或堕不可援，幻痴益多吾懔然。","明河绕衣吹佩环，毛发飘萧乱空寒。","颇欲乘槎此穷源，脱屣浊世抟林骞。","采华食叶为玉仙。"],0,25,"宋"],null,null,null,null,null,null,null,["题河南王氏所藏子敬帖","黄伯思","七言长篇",["君家大令书盈纸，笔势翩翩趣多媚。","虽云沓拖如少年，岂至拘挛同饿隶。","会稽七子五知名，此公风概尤超诣。","太极琁题犹重书，一时凛凛标英气。","半袖精裓众争求，数幅新裙世犹贵。","当时亲遇得已难，况复传今仅千岁。","龙珠归浦剑还津，此帖君藏真得地。","才披尺许目增明，鸾跂鸿惊欲飞逝。","硬黄响拓若传吾，完璧摹刊愿垂世。"],0,61,"宋"],null,null,null,null,null,null,null,null,null,null,null,null,null,["仙迹岩题诗二十三首 三清殿","佚名","七言长篇",["虚无混沌未分前，大道元居太极先。","自一而三同祖气，澄清高上积阳天。","挺锋镇北阐威权，剪伐魔精正法宣。","化育黎民臻大道，安宁家国享长年。","辨道焚修练性根，应时粥饭益真元。","斋馀有报君恩重，寿祝无疆帝道尊。","参稽道德本无言，不二门开阐古先。","多谢师尊传演教，要令后学悟真诠。","高敞山斋立乳巅，飘飖云驭聚群仙。","百灵听讲开坛夜，大法将临报语宣。","幽栖枹朴古先精，宴坐参同元化并。","一炷清香腾瑞霭，云端时透步虚声。","精思名扁列金题，冲素斋居与道齐。","德感天仙来听论，芝𫐌时降共参稽。","游幸名山德寿存，鼎新大殿显仁恩。","玉圭物物皆珍异，安奉严恭玉帝尊。","众圣环拱位中天，统济乾坤妙转旋。","高覆昆仑朝帝阙，注生回死福增延。","湍激清泉舞翠蛟，幽亭跨涧对岩坳。","我来憩此观嘉趣，一洗尘襟凡世抛。","重楼高耸丹霄外，深夜声摩碧落中。","神通无量鸿音远，永镇名山有显功。","圣像迁祠出禁扃，天恩遣使从神灵。","奉安钦敬祈民福，应感昭彰佑帝庭。","巍然垂象隐精思，著述丹书与世违。","真得紫文无上道，业成遗迹是题诗。","宝阁庄严金玄耀，风铃震响玉丁东。","甍飞杰出青霄上，道典珍藏在此中。","一片轮囷迹严存，无心出岫瑞腾坤。","不随风雨轻舒卷，触石凝然正性根。","大涤之西一穷生，源高樵者只闻声。","汲泉烹茗多甘味，内隐丹砂赤更清。","琳宫门外小桥东，石罅泉流细脉通。","清似玉壶承沆瀣，游人掬饮凛生风。","秀钟天柱产灵芝，造就仙芽发嫩旗。","采向先春烟露里，喊山凤尾岂为奇。","鲮鳗环绕井楯间，两目神光状类丹。","杖扑投渊阴雾锁，殿堂汹涌尽波澜。","仙芝灵术总芳妍，野草闲花各变迁。","古栎复荣松化石，药苗蕃植可延年。","覆石为亭武肃成，有仙来此变棋枰。","炷香五色祥光现，缥缈灵官朝玉京。","闲亭清憩觉情优，四顾岚光景色幽。","湍玉飞帘侵座冷，璇源本自接天流。"],0,"x115","宋"],null,null,null,null,null,["三月十三日夜五更闻杜鹃时成父欲入浙因赋六章章四句以送之","赵蕃","四言",["不如归去，苍山茂树。","独胡为乎，空此号謼。","归去来兮，斯言可师。","我今已归，胡能不知。","不如归去，春且云莫。","山中之乐，岂同岐路。","归去来兮，言发动随。","古之逸民，舍陶而谁。","不如归去，载丁载宁。","劝子勿去，子宁我听。","不如归去，子宁肯住。","归去来兮，早歌式微。"],0,"x36","宋"],null,["山行见月作","赵蕃","四言",["有风肃然，落于树巅。","使我沈疴，不药而痊。","意行何之，陟此云岭。","如梦而觉，如昏而醒。","东坡老翁，有言莫酬。","凉天佳月，即为中秋。","恨我无酒，负尔一醉。","酌兹寒泉，兀尔忘睡。"],0,"x36","宋"],["跋姜君弼课册","苏轼","四言",["云兴天际，歘若车盖。","凝𪾦未瞬，弥漫霮䨴。","惊雷出火，乔木麋碎。","殷地𦶟空，万夫皆废。","霤绠四坠，日中见昧。","移晷而收，野无完块。"],0,"x67","宋"],null,null,null,null,null,["迁善斋铭","王庭珪","四言",["击石出火，鼓钟得声。","不鼓不击，寂无声形。","人之有善，物中最灵。","揉以学问，其识乃明。","跛鼈千里，六骥不行。","玉不加琢，器何由成。","吾观成叔，挺挺有立。","学有渊源，家声爀熠。","深山大泽，龙蛇蟠蛰。","实无所迁，假迁而入。","犹天之升，不落阶级。","参辰殊途，追莫能及。"],0,"x198","宋"],["为黄仲宣赋山中四章章四句","方回","四言",["山中之朝，有溪可瓢。","饮我之水，亦逍以遥。","山中之暮，岂不风雨。","心与一灯，耿耿千古。","山中之人，耘夫耕民。","鲭厥五侯，其如子真。","于疏于𫏋，朋来其学。","彼恶知兹，山中之乐。"],0,"x59","宋"],["绍兴朝日十首 其二 降神用《高安》。","郊庙朝会歌辞","四言",["升晖丽天，阳德之母。","率无颇偏，兼烛下土。","恭事崇坛，礼乐具举。","顿御六龙，裴回容与。"],0,"x207","宋"],["夕月十首 其四 降神用《高安》。","郊庙朝会歌辞","四言",["穆穆流辉，太阴之精。","盈亏靡忒，寒暑以均。","克禋克祀，揆日涓辰。","牲硕酒旨，来燕来宁。"],0,"x207","宋"],["夕月十首 其三 降神用《高安》。","郊庙朝会歌辞","四言",["溯日著明，丽天作配。","洁诚以祠，礼行肃拜。","光凝冕服，气肃环佩。","庶几昭格，祗而不懈。"],0,"x207","宋"],["夕月十首 其二 降神用《高安》。","郊庙朝会歌辞","四言",["时维秋仲，夜寂天清。","实严姊事，用答阴灵。","坛壝斯设，黍稷惟馨。","云车来下，庶歆厥诚。"],0,"x207","宋"],["夕月十首 其一 降神用《高安》。","郊庙朝会歌辞","四言",["金行告遒，玉律分秋。","礼蒇西郊，毖祀聿修。","精意潜达，永孚于休。","神之听之，爰格飙斿。"],0,"x207","宋"],["大观祀社稷九首 其四 迎神用《宁安》。","郊庙朝会歌辞","四言",["笾豆斯陈，三牲告幽。","报本之礼，答神之休。","来歆芬香，丰登于秋。","仓箱千万，治符成周。"],0,"x207","宋"],["大观祀社稷九首 其三 迎神用《宁安》。","郊庙朝会歌辞","四言",["猗欤那欤，生养斯民。","家给人足，时底熙纯。","祗严明禋，于荐苾芬。","粢盛丰洁，神乃有闻。"],0,"x207","宋"],["大观祀社稷九首 其二 迎神用《宁安》。","郊庙朝会歌辞","四言",["惟谷之神，函育无穷。","百嘉蕃殖，民依厥功。","严饬坛壝，威仪肃雍。","神之来享，祈于登丰。"],0,"x207","宋"],["大观祀社稷九首 其一 迎神用《宁安》。","郊庙朝会歌辞","四言",["惟土之尊，民食资焉。","阴祀昭格，牲牢腥膻。","有功于民，告其吉蠲。","神之来享，云车翩翩。"],0,"x207","宋"],["大晟府拟撰释奠十四首 其四 迎神用《凝安》。","郊庙朝会歌辞","四言",["圣王生知，阐乃儒规。","诗书文教，万世昭垂。","良日惟丁，灵承不爽。","揭此精虔，神其来飨。"],0,"x207","宋"],["大晟府拟撰释奠十四首 其三 迎神用《凝安》。","郊庙朝会歌辞","四言",["巍巍堂堂，其道如天。","清明之象，应物而然。","时维上丁，备物荐诚。","维新礼典，乐谐中声。"],0,"x207","宋"],["大晟府拟撰释奠十四首 其二 迎神用《凝安》。","郊庙朝会歌辞","四言",["生而知之，有教无私。","成均之祀，威仪孔时。","维兹初丁，洁我盛粢。","永适其道，万世之师。"],0,"x207","宋"],["大晟府拟撰释奠十四首 其一 迎神用《凝安》。","郊庙朝会歌辞","四言",["大哉宣圣，道德尊崇。","维持王化，斯民是宗。","典祀有常，精纯并隆。","神其来格，于昭盛容。"],0,"x207","宋"],["出火祀大辰十二首 其三 降神用《高安》。","郊庙朝会歌辞","四言",["火在六气，独处其两。","感生维君，繄辰克相。","何以验之，占兹垂象。","腾驾苍虬，歘其来飨。"],0,"x207","宋"],["出火祀大辰十二首 其二 降神用《高安》。","郊庙朝会歌辞","四言",["乐音上达，粤惟出虚。","火性炎上，亦生于无。","我镛我磬，我笙我竽。","气同声应，昭哉合符。"],0,"x207","宋"],["出火祀大辰十二首 其一 降神用《高安》。","郊庙朝会歌辞","四言",["烨烨我宋，火德所畀。","用火纪时，允惟象类。","神以类歆，诚繇类至。","有感斯通，孚我阳燧。"],0,"x207","宋"],["纳火祀大辰十二首 其四 降神用《高安》。","郊庙朝会歌辞","四言",["明明我后，重祭钦祠。","有司肃事，式荐晨仪。","礼惟其称，物惟其时。","神之听之，福禄来为。"],0,"x207","宋"],["纳火祀大辰十二首 其三 降神用《高安》。","郊庙朝会歌辞","四言",["季秋之月，律中无射。","农事备收，火功告毕。","克禋克祀，有严有翼。","风马云车，尚其来格。"],0,"x207","宋"],["纳火祀大辰十二首 其二 降神用《高安》。","郊庙朝会歌辞","四言",["火星之躔，有烨其光。","表于辰位，伏于戌方。","时和岁稔，仁显用藏。","告尔万民，出纳有常。"],0,"x207","宋"],["纳火祀大辰十二首 其一 降神用《高安》。","郊庙朝会歌辞","四言",["赫赫皇图，炎炎火德。","侈神之赐，奄有方国。","粢盛既丰，俎豆有𫗣。","于万斯年，报祀无斁。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其四 赤帝降神用《高安》。","郊庙朝会歌辞","四言",["烨烨其光，炳炳其灵。","窅其如容，歘其如声。","扇以景风，导以朱斿。","我德匪类，神其安留。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其三 赤帝降神用《高安》。","郊庙朝会歌辞","四言",["八卦相荡，一气散施。","隆炽恢台，职神尸之。","肃肃飙御，神戾于天。","于昭神休，天子万年。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其二 赤帝降神用《高安》。","郊庙朝会歌辞","四言",["赤精之君，位于朱明。","茂育万物，假然长嬴。","我洁我盛，我蠲我诚。","神其下来，云车是承。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其一 赤帝降神用《高安》。","郊庙朝会歌辞","四言",["离明御正，德协于火。","有感其生，维帝是何。","帝图炎炎，贻福锡我。","鉴于妥虔，高灵下堕。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其四 黑帝降神用《高安》。","郊庙朝会歌辞","四言",["天地闭塞，盛德在水。","黑精之君，降福羡祉。","洋洋在上，若或见之。","齐庄承祀，其敢斁思。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其三 黑帝降神用《高安》。","郊庙朝会歌辞","四言",["北方之神，执权司冬。","三时务农，于焉告功。","礼备乐作，归功于神。","风马来游，永锡斯民。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其二 黑帝降神用《高安》。","郊庙朝会歌辞","四言",["良月盈数，四气推迁。","帝于是时，典司其权。","高灵下堕，降祉幅员。","神之听之，祀事罔愆。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其一 黑帝降神用《高安》。","郊庙朝会歌辞","四言",["吉日壬癸，律中应钟。","国有故常，北郊迎冬。","乃蒇祀事，必祗必恭。","明默虽异，感而遂通。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其四 白帝降神用《高安》。","郊庙朝会歌辞","四言",["执矩斯兑，实惟素灵。","受职储休，万宝以成。","飨于西郊，奠玉陈牲。","侑以雅乐，来歆克诚。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其三 白帝降神用《高安》。","郊庙朝会歌辞","四言",["昊天之气，揫敛万汇。","涓日洁齐，有严厥祀。","有牲维肥，有酒维旨。","神之燕娭，锡兹福祉。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其二 白帝降神用《高安》。","郊庙朝会歌辞","四言",["素精肇节，金行固藏。","气冲炎伏，明河翻霜。","功收有年，礼荐有章。","祇越眇冥，鸿基永昌。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其一 白帝降神用《高安》。","郊庙朝会歌辞","四言",["白藏启序，庶汇向成。","有严禋祀，用答幽灵。","风马云车，来燕来宁。","洋洋在上，休福是承。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其四 黄帝降神用《高安》。","郊庙朝会歌辞","四言",["澹兮抚琴，啾兮吹笙。","神之未来，肃穆以听。","缤纷羽旄，姣服在中。","神既来止，亦无惰容。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其三 黄帝降神用《高安》。","郊庙朝会歌辞","四言",["乐哉帝居，逝留无常。","尔信我宅，尔中我乡。","乃眷兹土，于赫君王。","翩然下来，去未遽央。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其二 黄帝降神用《高安》。","郊庙朝会歌辞","四言",["荪无不在，日与我居。","孰不可来，肸蚃斯须。","象服龙驾，渊渊鼓桴。","荪不汝多，多汝意孚。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其一 黄帝降神用《高安》。","郊庙朝会歌辞","四言",["维帝奠位，乃咸于时。","孰主张是，而枢纽之。","谷我腹我，比予于儿。","告我冠服，迨其委蛇。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其四 青帝降神用《高安》。","郊庙朝会歌辞","四言",["温然仁矣，熙然春矣。","龙驾帝服，穆将临矣。","我酒清矣，我肴烝矣。","我乐备矣，我神顾矣。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其三 青帝降神用《高安》。","郊庙朝会歌辞","四言",["神在途矣，习习以风。","百灵后先，敢一不恭。","奔走疠疫，祓除菑凶。","顾瞻下方，逍遥从容。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其二 青帝降神用《高安》。","郊庙朝会歌辞","四言",["神兮焉居，神在震方。","仁以为宅，秉天之阳。","神之来矣，道修以阻。","望神未来，使我心苦。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 其一 青帝降神用《高安》。","郊庙朝会歌辞","四言",["于神何司，而德于木。","肃然顾歆，则我斯福。","我祀孔时，我心载祗。","匪我之私，神来不来。"],0,"x207","宋"],["绍兴以后祀感生帝十六首 其四 降神用《大安》。","郊庙朝会歌辞","四言",["惟神之安，方解羽銮。","赤旗霞曳，从以炎官。","居歆嘉荐，肸蚃灵坛。","神之格矣，民讫多盘。"],0,"x207","宋"],["绍兴以后祀感生帝十六首 其三 降神用《大安》。","郊庙朝会歌辞","四言",["于物司火，于方峙南。","璇霄来下，羽卫毵毵。","祠官祝厘，联佩合簪。","本支有衍，则百斯男。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 其四 西方百神降神用《熙安》。","郊庙朝会歌辞","四言",["丰年穰穰，美芳职职。","笾豆方圆，其仪孔硕。","风马在御，云车载饬。","来顾来飨，维俟休德。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 其三 西方百神降神用《熙安》。","郊庙朝会歌辞","四言",["神罔小大，奠方兹土。","祭列坊庸，礼迨猫虎。","有功斯民，祀乃其所。","非稷馨香，厥福周溥。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 其二 西方百神降神用《熙安》。","郊庙朝会歌辞","四言",["魄生自西，照望太阳。","下暨诸神，贶施万方。","节适风雨，富我囷箱。","共承嘉祀，惟以迪尝。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 其一 西方百神降神用《熙安》。","郊庙朝会歌辞","四言",["玄冬肇祀，始于伊耆。","岁事聿成，庸答蕃厘。","眷言西顾，匪神司之。","归功尔神，翩其下来。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 其四 东方百神降神用《熙安》。","郊庙朝会歌辞","四言",["日昱乎昼，容光必照。","肸蚃之交，惟人所召。","有监在下，视兹升燎。","肃若其承，云骈星曜。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 其三 东方百神降神用《熙安》。","郊庙朝会歌辞","四言",["三时不害，四方顺成。","酬功报始，以我齐明。","豳颂土鼓，乐此嘉平。","降祥幅员，惠于函生。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 其二 东方百神降神用《熙安》。","郊庙朝会歌辞","四言",["惟大明尊，实首三辰。","功赫庶物，光被广轮。","岁方索飨，咸秩群神。","灵斿来下，尸此明禋。"],0,"x207","宋"]]