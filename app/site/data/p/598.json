[["续茅山秀才吟","顾况","残句",["驻马上山阿，风来屎气多。"],0,191,"唐"],["讥元载诗","高亭","残句",["上元官吏务剥削，江淮之人皆白著。"],0,93,"唐"],["嘲赵璘 其二","薛能","残句",["不知原在鞍轿里，将谓空驮席帽归。"],0,198,"唐"],["嘲赵璘 其三","薛能","残句",["火炉床上平身立，便与夫人作镜台。"],0,198,"唐"],["别庐州郡人","郑綮","残句",["唯有两行公廨泪，一时洒向渡头风。"],0,208,"唐"],["戏荅成汭","徐彦若","残句",["南海黄茅瘴，不死成和尚。"],0,61,"唐"],["荅妻","冯晖","残句",["休说办不办，且看瓮里飞出雁。"],0,204,"唐"],["被按自悔诗","刘炎","残句",["早知太守如虎狼，猎取膏粱以啗之。"],0,167,"唐"],["荅或人","张𬸦","残句",["宁可且将朱唇饮酒，谁能遂你黑齿常之。"],0,64,"唐"],["嘲崔嘏","施肩吾","残句",["二十九人及第，五十七眼看花。"],0,63,"唐"],["岭南诗句","苏芸","残句",["郭里多榕树，街中足使君。"],0,120,"唐"],["谐诗逸句 其一","包贺","残句",["雾是山巾子，船为水靸鞋。"],0,18,"唐"],["谐诗逸句 其二","包贺","残句",["櫂摇船掠鬓，风动水槌胸。"],0,18,"唐"],["谐诗逸句 其三","包贺","残句",["苦竹笋抽青橛子，石榴树挂小缾儿。"],0,18,"唐"],["题洞庭湖","蔡押衙","残句",["可怜洞庭湖，恰到三冬无髭须。"],0,216,"唐"],["戏令狐相","温庭筠","残句",["自从元老登庸后，天下诸胡悉带铃。"],0,"x28","唐"],["与罗隐互谑","顾云","残句",["青蝇被扇扇离席，白泽遭钉钉在门。"],0,190,"唐"],null,["嘲廪丘令丞","商则","残句",["令丞俱动手，县尉止回身。"],0,162,"唐"],["题汉祖庙","罗颖","残句",["项羽英雄犹不惧，可怜容得辟阳侯。"],0,4,"唐"],["自赋催妆诗","陈峤","残句",["彭祖尚闻年八百，陈郎犹是小孩儿。"],0,198,"唐"],null,["荅弟妇歇后语","李涛","残句",["慙无窦建，媿作梁山。"],0,35,"唐"],["与释惠江互谑","程紫霄","残句",["僧录琵琶腿，先生觱栗头。"],0,160,"唐"],["嘲主司崔澹","佚名","残句",["主司何事厌吾王，解把黄巢比武王。"],0,"x14","唐"],["嘲刘师老","佚名","残句",["大府朝天升穆老，尚书倒地落刘郎。"],0,"x14","唐"],["嘲郑薰","佚名","残句",["主司头脑太冬烘，错认颜标作鲁公。"],0,"x14","唐"],["嘲蒋蟠金丹","佚名","残句",["张鹄只消千驮绢，蒋蟠惟用一丸丹。"],0,"x14","唐"],["注苗张二进士题名","佚名","残句",["一双前进士，两个阿孩儿。"],0,"x14","唐"],["袁州人谑彭伉","佚名","残句",["湛贲及第，彭伉落驴。"],0,"x14","唐"],["洛中人语","佚名","残句",["昔楼师德园，今袁德师楼。"],0,"x14","唐"],["嘲毛炳彭会","佚名","残句",["彭生作赋茶三片，毛氏传诗酒半升。"],0,"x14","唐"],["右威卫嘲语","佚名","残句",["门缘御史塞，厅被校书侵。"],0,"x14","唐"],["南唐伶人献先主词","佚名","残句",["惟愿普天多瑞庆，柳条结絮鹅双生。"],0,"x14","唐"],["闽伶官戏主延政语","佚名","残句",["只闻有泗州和尚，不见有五县天子。"],0,"x14","唐"],["言志","佚名","残句",["腰缠十万贯，骑鹤上扬州。"],0,"x14","唐"],["判部民诉主簿牒","王鲁","残句",["汝虽打草，吾已惊蛇。"],0,136,"唐"],["戏为冥吏判","伶人","残句",["焦湖百里，一任作獭。"],0,156,"唐"],["刺左右膊句","张干","残句",["生不怕京兆尹，死不畏阎罗王。"],0,243,"唐"],["薛将军歌","佚名","残句",["将军三箭定天山，战士长歌入汉关。"],0,"x14","唐"],null,["桑条歌","佚名","残句",["桑条韦也，女时韦也乐。"],0,"x14","唐"],["景龙中嘲宰相歌","佚名","残句",["礼贤不解开东阁，燮理惟能闭北门。"],0,"x14"