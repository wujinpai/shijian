狱吏，今见白兔御史。"],0,"x14","唐"],["吏人语","佚名","残句",["不畏侯卿杖，惟畏尹卿笔。"],0,"x14","唐"],["选人语 其二","佚名","残句",["硕学师刘子，儒生用与言。"],0,"x14","唐"],["选人语 其三","佚名","残句",["今年柿子并遭霜，为语石榴须早摘。"],0,"x14","唐"],["韦氏语","佚名","残句",["大郎罢相，小郎拜相。"],0,"x14","唐"],["天授中语","佚名","残句",["遇徐杜者必生，遇来侯者必死。"],0,"x14","唐"],["题张昌仪门语","佚名","残句",["一两丝能得几时络。"],0,"x14","唐"],["时人号李知远语","佚名","残句",["李下无蹊。"],0,"x14","唐"],["又号李乂语","佚名","残句",["李下无蹊径。"],0,"x14","唐"],["时人为崔无诐语","佚名","残句",["皇后嫁女，天子娶妇。"],0,"x14","唐"],["神龙中语","佚名","残句",["崔冉郑，乱时政。"],0,"x14","唐"],["李处郁语","佚名","残句",["飧若入咽，百无一全。"],0,"x14","唐"],["景云初语","佚名","残句",["前有裴马，后有卢李。"],0,"x14","唐"],["先天时京中语","佚名","残句",["姜师度一心看地，傅孝忠两眼相天。"],0,"x14","唐"],["时人号王丘崔沔语","佚名","残句",["丘山岌岌连天峻，沔水澄澄彻底清。"],0,"x14","唐"],["吏部过官语","佚名","残句",["麟之口，光庭手。"],0,"x14","唐"]]