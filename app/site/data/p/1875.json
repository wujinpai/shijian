[null,null,null,null,null,null,null,null,null,null,null,["祗树庵","洪恩","七言长篇",["竹映窗前水漱门，数声幽鸟报朝昏。","行来恐踏苔痕破，目送山云过远村。","新植寒梅匝杏开，遍寻兰蕙绕篱栽。","香风吹落梨花雪，蜂蝶纷纷间错来。","山气笼从晓出云，一溪流水望中分。","岩花树树红相映，竹里横拖白练裙。","堪笑经年老蠹鱼，编编钻透未知书。","忽然眉底开双眼，始信从前不识渠。"],0,204,"明"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["十骥咏 御赐千里雪","卢象升","七言长篇",["疋练飞腾眼界空，白云为窟矫如鸿。","轻麾羽骑狼烟靖，长驾应推第一功。","历尽关山几万重，渥洼神骏喜相从。","五明共道非凡品，百战先登果异踪。","骧首云霄月影庞，胭脂丛里玉无双。","惊鸿舞燕何堪比，一骑横秋饮汉江。","细柳军容昔自奇，六花指点绕旌旗。","千群战骑争相逐，独向春风顾盼迟。","蔚也其文夺锦辉，中宵欲吼剑光飞。","瑞质不随玄雾隐，凯歌声彻五花𬴂。","记得临戎策马初，骅骝紫色映征裾。","慇勤好为求刍牧，遍历风霜体自如。","逐影霜蹄赋隙驹，追风铁骨傲征途。","宁将汗血求金紫，但愿功成列画图。","叆叇烟云覆碧蹄，朝来天厩暮辽西。","昨宵逐电分明见，八尺玄虬带障泥。","玉立亭亭孰与偕，空群逸足藐天涯。","当场一任玄黄战，騋牝三千独尔佳。","一夕金飙遍九垓，边庭将士诧龙媒。","孤臣久励凌霜操，唯带秋容马上来。"],0,176,"明"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["颂古诗","普慈","七言长篇",["泪满罗衣酒满卮，一声歌断怨伤离。","如今两地心中事，直是瞿昙也不知。","风波不动影沉沉，翠色全微碧色深。","应是水仙梳洗处，至今青黛镜中心。","抛却长竿卷却丝，手携蓑笠献新诗。","果然月照池如镜，不是渔人下钓时。","雨霁长空荡涤清，远山初出未知名。","夜来江上如钩月，时有惊鱼掷浪声。","掘沟引水浇蔬圃，插竹为篱护药苗。","杨柳如丝风易乱，梅花似雪日难消。"],0,101,"明"]]