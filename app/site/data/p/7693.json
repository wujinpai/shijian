[["如梦令 客中","陈世祥","词",["才看桂花黄絮。","待趁晚潮归去。","真正没来由，便把冬春发付。","还住。","还住。","又是紫薇一树。"],0,217,"清"],["如梦令 次梅木山夜坐韵","陈世祥","词",["钩月刺开云空。","帘外紫薇影重。","我也忆当初，听彻红楼狞凤。","都梦。","都梦。","一样悄然情动。"],0,217,"清"],["天仙子 苦雨","陈世祥","词",["织尽雨丝难作匹。","巡檐一鸟窥人立。","不知天有几多愁，风恁劈。","冷云积。","应缘误发残花檄。"],0,217,"清"],["定西番 冬日敬亭宴集","陈世祥","词",["镇日楼头相对，铺月澹，着云轻。","枕前横。","踏向棱棱冰壑，水泉流暗声。","三尺雏松剪剪，似雏僧。"],0,217,"清"],["长相思 郊行","陈世祥","词",["开花风。","落花风。","酒旗安顿小桥东。","教人驻玉骢。","一重溪。","两重溪。","弱柳遮藏曲曲篱。","黄莺独自啼。"],0,217,"清"],["相见欢 再晤西若","陈世祥","词",["轻轻飏起娇红。","小春风。","迎到栏杆侧畔、出帘栊。","敛眉语。","携手步。","意无穷。","那时去也魂断、画堂中。"],0,217,"清"],["醉太平 偶见","陈世祥","词",["珊珊玉钩。","飘飘翠帱。","倚栏觑见温柔。","是谁家画楼。","欲窥又羞。","欲行又留。","盼人频转清眸。","怎教人不愁。"],0,217,"清"],["昭君怨 春阴久寄姑孰","陈世祥","词",["烟雨萧萧寒重。","待盼青山成梦。","梦里是离愁。","古扬州。","江水巫山云远。","寸寸客怀如剪。","莫要写新诗。","晚来时。"],0,217,"清"],["女冠子 春日","陈世祥","词",["相思独自。","不及双双燕子。","镇相怜。","花影勤催日，炉香懒续烟。","梦中空有泪，镜里更无言。","任他飞燕子，不开帘。"],0,217,"清"],["点绛唇 闻笛","陈世祥","词",["烟霭全收，远空一色青如削。","笛声依约。","向酒肠频掠。","翻下庭花，字字相思托。","牵情着。","月儿将落。","人在栏杆角。"],0,217,"清"],["浣溪纱 午泛归西园","陈世祥","词",["蝶子寻花逐逐忙。","一溪春绿腻归航。","杏烟深处读书庄。","织柳欲成莺衬贴，垒巢未就燕商量。","迎人小犬出东墙。"],0,217,"清"],["浣溪纱 小窗","陈世祥","词",["流水流云入画图。","画来端的总模糊。","小窗笔墨太生疏。","乳燕听时如可解，落花扫去又谁铺。","焚香整日破工夫。"],0,217,"清"],["浣溪纱 阅世说新语","陈世祥","词",["头上还馀漉酒巾。","庭空不晒宝吾裈。","庾郎此日未知贫。","赤玉胸中无宿物，蓝田举体岂常人。","长卿慢世我思存。"],0,217,"清"],["浣溪纱 梦中作","陈世祥","词",["萍子横铺絮一池。","绿窗正拟落花题。","一春情事鬓先知。","未免多情风力倦，可能无恨月容衰。","扶持好梦与莺儿。"],0,217,"清"],["浣溪纱 赠采文","陈世祥","词",["雏笋初齐万绿香。","参红束素小儿郎。","生来宜近读书窗。","沉甲细添箫局火，岕尖鲜试越瓷汤。","学书教写十三行。"],0,217,"清"],["浣溪纱 再示采文","陈世祥","词",["香粉揉成玉琢将。","憨情嗔态总难忘。","个侬年纪正思量。","睡里着惊真觉怯，笑中推酒未全庄。","悄无人处可相当。"],0,217,"清"],["浣溪纱 初夏","陈世祥","词",["只说春归不惹愁。","辞春还与闷相勾。","草窠遍地碧如油。","莺舌已无前日滑，柳腰可似向来柔。","断肠都在最高楼。"],0,217,"清"],["浣溪纱 将雨","陈世祥","词",["莽雾痴云酿宿阴。","较侬愁绪一般深。","日长无事费沉吟。","要顿闲情拈蜡叶，怕粘冷梦熨香衾。","小窗今夜雨淋侵。"],0,217,"清"],["浣溪纱 赠琼孙","陈世祥","词",["自是缑山品绝伦。","珠匀玉莹想风神。","乳名直得唤珍珍。","摒当笔床都蕴藉，捧持酒盏更温文。","越歌应不忿庄辛。"],0,217,"清"],["归国遥 楼上","陈世祥","词",["非误。","沙觜水痕游子路。","只为远山相护。","把行人隔住。","看得暮云栖树。","晚风都似絮。","又是归鸦无数。","伤心和影诉。"],0,217,"清"],["巫山一段云 四月二十日","陈世祥","词",["是客云为梦，飘零惜去年。","断魂曾泥酒尊前。","衣带镇相怜。","旧曲闲翻谱，新声自注笺。","小窗心性夕阳天。","幽意若为传。"],0,217,"清"],["减字木兰花 晚闺","陈世祥","词",["愁人只影。","燕怕凄凉归不肯。","却去花间。","展转空将翎翅翻。","恼人明月。","悄地来窥藏不迭。","待向房中。","又是清清冷被笼。"],0,217,"清"],["减字木兰花 独坐","陈世祥","词",["曲栏新竹。","一碧碾成千个玉。","静掩篱门。","野鸟声声乱唤人。","绿阴如许。","小袂轻凉疑坠雨。","闲谱诗余。","遍向芭蕉叶上书。"],0,217,"清"],["减字木兰花 自遣","陈世祥","词",["忆春无几。","愁到而今今夏矣。","万顷寒云。","夏已赊秋二十分。","愁怀抖乱。","晴雨难凭谁可断。","雨意如疑。","点滴都无丝又丝。"],0,217,"清"],["减字木兰花 题宗梅岑小香居士像，同王西樵作","陈世祥","词",["吟情如许。","日向人间题好句。","谁信屯亶。","老矣吾徒三十年。","重寻旧稿。","人道君家当日好。","问取图中。","却逊吟情老更工。"],0,217,"清"],["菩萨蛮 闺怨","陈世祥","词",["落花万片如堪数。","和烟织就相思缕。","甚处叫黄鹂。","黄鹂却叫谁。","游丝无个事。","只管随花住。","归燕斗人愁。","双双踏玉钩。"],0,217,"清"],["菩萨蛮 社集看菊","陈世祥","词",["庭无凡卉花坛净。","小阑披拂随花性。","大釂总深觞。","花容入酒黄。","翠红兼艳紫。","白更佳如此。","醉倒便花前。","携花伴月眠。"],0,217,"清"],["菩萨蛮 客夜","陈世祥","词",["冷风索索寻窗纸。","那堪更是廉纤雨。","半睡过黄昏。","残灯偏着人。","闲愁无可破。","梦里成真个。","醒睡总来难。","双眸枕上干。"],0,217,"清"],["菩萨蛮 题闺人绣幅","陈世祥","词",["倪迂戏写秋山稿。","两间茅屋霜林晓。","屋后枕高滩。","萧萧竹几竿。","指尖聊染渲。","直作针神看。","小置画图中。","香闺一夜工。"],0,217,"清"],["菩萨蛮 夜饮梅花阁，用前韵却赠主人","陈世祥","词",["寻幽每爱郊园净。","晴郊得尽风云性。","新酿恰浮觞。","充盘一楙黄。","斓斑枫遍紫。","悔不秋来此。","一夕抵从前。","更深仍未眠。"],0,217,"清"],["菩萨蛮 赠友人","陈世祥","词",["句拈本色求圆净。","柳周香艳词天性。","佳句引传觞。","秦欧自压黄。","选花黄白紫。","馀色何堪此。","更要索从前。","挑灯共不眠。"],0,217,"清"],["菩萨蛮 幽晤","陈世祥","词",["上弦月落黄昏院。","惊人乍似双飞燕。","已是出来难。","疏屏又夜寒。","拼得相思各。","莫更人前谑。","欲语转娇睛。","知卿梦里曾。"],0,217,"清"],["菩萨蛮 闵际行花乳茶","陈世祥","词",["仙人高掌空青雨。","玉蓉几点花头乳。","一叶乍沉瓯。","春云自在流。","兰香谁可赠。","已证松萝圣。","瑞草陋阳坡。","除非访穆陀。"],0,217,"清"],["诉衷情 本意","陈世祥","词",["痴云痴雨宠风姨。","庭草尽情肥。","说来一春花事，都是恼人时。","花里坐，看花飞。","敛双眉。","多情燕子，片片飞花，拾上香泥。"],0,217,"清"],["谒金门 晚寒","陈世祥","词",["衣索索。","早被晚风知觉。","穿过绣帘来作恶。","故欺人软弱。","烛短香轻衾薄。","游子天涯无诺。","不记新秋珍重约。","共谁人恋着。"],0,217,"清"],["谒金门 晚醉","陈世祥","词",["无事好。","长得一庭芳草。","放着闲云闲不扫。","闭门云杳杳。","兴到酒瓢独舀。","便向苍苔醉倒。","睡起斜阳刚一觉。","掀髯还独笑。"],0,217,"清"],["好事近 山寺晓步","陈世祥","词",["细雨润园蔬，蔬甲一时如镞。","插槿篱门还闭，有高人睡足。","竹溪是处笋成林，新笋青于玉。","倦向溪边小坐，已尘襟都浴。"],0,217,"清"],["好事近 夏闺","陈世祥","词",["晓倦起来迟，已是蜂衙将散。","燕子一双私语，落衔来花瓣。","云头雨过响棱棱，打檐花冰绽。","又早半天晴碧，写峰峦千万。"],0,217,"清"],["更漏子 秋雨","陈世祥","词",["漏声残，灯影碎。","一个人儿怎睡。","闲绣被，冷香篝。","孤帏见也羞。","芭蕉树。","芭蕉雨。","恰似和谁共语。","雨滴沥，泪栏杆。","相陪消夜寒。"],0,217,"清"],["忆秦娥 美人足。以下三首社集分赋 其一","陈世祥","词",["双莲小。","是伊行处成香草。","成香草。","一弯三寸，量来还少。","午帘小立苔声悄。","绿阶点定相思稿。","相思稿。","若教掌上，着人情饱。"],0,217,"清"],["忆秦娥 其二 美人发","陈世祥","词",["才出幔。","玄云拖缕舒来缓。","舒来缓。","手围坠地，八盘加半。","香丝腻玉妆台畔。","约鬟未就嗔郎唤。","嗔郎唤。","枕函兰泽，怎教批判。"],0,217,"清"],["忆秦娥 其三 美人腰","陈世祥","词",["香罗幅。","柳丝一尺围红玉。","围红玉。","泥人入抱，刚刚如束。","欠伸无力牵郎宿。","欲扶不得娇难掬。","娇难掬。","回身笑睨，怕他明烛。"],0,217,"清"],["忆秦娥 东昌道中有怀","陈世祥","词",["天边月。","相思准备和他说。","和他说。","清光分照，料应关切。","风知帘缝勾香泄。","西楼月转鸣蛩咽。","鸣蛩咽。","月儿不管，闷怀空结。"],0,217,"清"],["忆秦娥 次梅木山夜坐韵","陈世祥","词",["和愁织。","络丝整夕无休息。","无休息。","睡乡佳境，怎生甜黑。","秋情如故人非昔。","灯光闪闪尖风勒。","尖风勒。","照人憔悴，这般颜色。"],0,217,"清"],["清平乐 雪","陈世祥","词",["云僵风败。","雪意妆来大。","梅影一窗摇浅墨。","陡地幻成银海。","前村樵径都迷。","诗人驴背才归。","忙唤童儿买酒，板桥西畔还西。"],0,217,"清"],["清平乐 次尤展成春闺韵","陈世祥","词",["嗔花怨草。","怎得心情好。","几日小姑猜着了。","故意诵郎诗稿。","愁来压梦难醒。","背人偏要潜行。","却被东风一吓，回廊敲动风筝。"],0,217,"清"],["清平乐 新柳","陈世祥","词",["十三娇女。","约略腰如许。","尽日临风摇弱缕。","无力向人前舞。","小桥正枕横塘。","高楼都在斜阳。","寄语东风且慢，莫教轻换鹅黄。"],0,217,"清"],["阮郎归 踏春","陈世祥","词",["宿花蝴蝶惹花飞。","纱窗闻画眉。","女儿生小在香闺。","开箱怜舞衣。","添线倦，卷帘迟。","栏杆让柳垂。","邻家相约踏春堤。","日长缓缓归。"],0,217,"清"],["三字令 思远","陈世祥","词",["衫袖怯，晚来风。","到梧桐。","初月碧，断霞红。","雁儿痴，排甚字，碍长空。","千种字，一函封。","在书中。","和雁说，为奴通。","但人归，奴不负，谢伊功。"],0,217,"清"],["眼儿媚 中秋","陈世祥","词",["露洗芙蓉弄晚红。","和月到帘栊。","去年此夜，今年此夜，一样秋中。","秦淮处处人如玉，箫管咽悲风。","阿谁领略，曲阑双凭，小语初浓。"],0,217,"清"],["柳梢青 小饮遂醉","陈世祥","词",["独把金卮。","烟轻露重，处处堪诗。","香正勾情，衫才泥腕，是倚楼时。","愁人多少相思。","酒醒后、帘吹月丝。","钟语初回，笛声又起，幽梦难支。"],0,217,"清"],["荷叶杯 多情","陈世祥","词",["自是多情难得。","端的。","解后在灯前。","一曲相思字字坚。","昨梦是双鸳。","不住将人低诵。","珍重。","但愿镇相随。","书窗安镜画修眉。","从此不孤飞。"],0,217,"清"],["西江月 醉醒","陈世祥","词",["惆怅梦魂何处，心烟一缕孤行。","伴人幽月到疏棂。","照破梦魂清冷。","醉也从教便醉，醒来依旧还醒。","枕边诗句阿谁听。","月送海棠花影。"],0,217,"清"],["西江月 阅世说新语","陈世祥","词",["我醉君须且去，人愁我欲言愁。","槃间瞿谷舞无休。","不许公荣二斗。","北海无尊可满，茅山有泪难收。","输他化蝶老庄周。","未醒之时识否。"],0,217,"清"],["少年游 姑溪八月十八日寄怀里中同学诸子","陈世祥","词",["去年此日，桂花影里，好句坐秋阴。","今年此日，桂花何在，欹枕一秋心。","卷帘还起，何来明月，窥梦到孤衾。","半秋匀染，已深深、潮长镇难禁。"],0,217,"清"],["河传 江望","陈世祥","词",["莽云，莽水。","一幅横披，何人佳制。","离奇空幻，百千万里。","都来双目里。","夕阳西下渔歌起。","烟如穗。","好向江头醉。","颓然云水之内。","梦魂真足寄。"],0,217,"清"],["河传 赠歌童","陈世祥","词",["听半。","听半。","个侬魂断。","吐玉揉香。","都来字字总成双。","鸳鸯。","不求凰。","曲终生遣寒窗暖。","春恨满。","写恨嫌笺短。","铸将金屋待卿藏。","端相。","温柔是此乡。"],0,217,"清"],["雨中花 采石矶怀古","陈世祥","词",["千里泠泠冰雪。","送过几多英杰。","送到如今，英雄巳尽，怒浪都空设。","醉向长江呼短楫。","恰好当头明月。","𫖯首浪排空，热酒浇来，滴滴英雄血。"],0,217,"清"],["探春令 本意","陈世祥","词",["桃花树上午莺眠，日影撩人倦。","把花枝、移上栏杆里。","被侍婢、和帘卷。","石泉烹雪云痕浅。","看春光成片。","几多时楼角，桥头杨柳，树树都垂线。"],0,217,"清"],["木兰花 村居初夏","陈世祥","词",["唤提壶，催布谷。","新笋初抽香簌簌。","支午倦，向回廊，静里一声风啄玉。","戏投竿，闲濯足。","一对鸳鸯无事浴。","斜日暮，起渔歌，晚云收尽天如沐。"],0,217,"清"],["卖花声 一醉","陈世祥","词",["书室纸为屏。","病懒常扃。","闲人无事学翻经。","折得梅花和雪嗅，片片泠泠。","钟语坐来听。","身世如萍。","向谁白眼向谁青。","自造中山千日酒，有醉无醒。"],0,217,"清"],["卖花声 本意","陈世祥","词",["小鸟斗啾啾。","香梦难留。","画楼人起正梳头。","买得一枝红颤颤，晓露微流。","一担把春收。","兜的相勾。","倚帘不语凝双眸。","插向鬓边还又住，恰为花愁。"],0,217,"清"],["临江仙 夏日","陈世祥","词",["庭阴日午长无事，被郎央及樗蒲。","枝枝打着教人输。","抛骰不语扯裙裾。","郎憨又把人央及，这回不比当初。","一盘赢得便欢娱。","赌郎新织藕丝襦。"],0,217,"清"],["河传 醉倒","陈世祥","词",["茗艼。","难醒。","支离倾仄，绝奇之影。","举杯问影尔何如。","乐乎。","酒肠今不枯。","从来醉境无人说。","凭千劫。","真醉不磨灭。","谁吾曹。","足酒豪。","明朝。","和天筑酒巢。"],0,217,"清"],["河传 李云田为少君宝镫买婢扫镜","陈世祥","词",["今日。","非昔。","向妆台畔，耐卿小立。","一双艳玉总生香。","问郎。","柔情那处长。","郎憨故把人来搅。","和人好。","不顾人儿恼。","对花枝。","不语时。","寻思。","愁深郎不知。"],0,217,"清"],["鹊桥仙 送别","陈世祥","词",["尊前云起，望中烟合，是处离愁如织。","烟云明日又相逢，怎便把、人儿分劈。","轻箫屡咽，好花频落，也为今朝珍惜。","纵然沉醉不知离，酒醒后、如何过得。"],0,217,"清"],["虞美人 春晚","陈世祥","词",["晴蜂暖蝶朝相语。","叹息春归去。","天涯青草镇茫茫。","唯有行人依旧、老他乡。","长江记是来时路。","却被山遮住。","殷勤为谢子规心。","不如鹧鸪知我、却还深。"],0,217,"清"],["虞美人 闺怨","陈世祥","词",["搓成梅子圆如豆。","是处清阴凑。","一双蛱蝶邻家。","可是绿阴深处、不留他。","看来蜂蝶和花好。","百遍随花绕。","只教春去任花飞。","怎不蜂蜂蝶蝶、也同归。"],0,217,"清"],["南乡子 冬夜","陈世祥","词",["雪压瓦楞寒。","阁着琵琶不忍弹。","今夜佩声偏觉冷，珊珊。","辜负玲珑玉一环。","锦被半床悭。","几遍添香只是单。","一朵灯花看妾笑，难难。","冬夜筹添不易阑。"],0,217,"清"],["南乡子 夏午觅睡","陈世祥","词",["消暑展桃笙。","五尺琉璃石上横。","问到睡乡才入境，心惊。","度枕松风恰一声。","倦耳付深扃。","莫使松风唤得醒。","分付童儿闻剥啄，休听。","也向槐安国里行。"],0,217,"清"],["南乡子","陈世祥","词",["怪来春、不和人聚。","知道将归，收拾花同去。","可怜全学薄情郎，处处园林留不住。","只有蝶儿相顾。","几多落花犹护。","也应念着寂寥人，时尝一到帘前路。"],0,217,"清"],["醉落魄 江上大风","陈世祥","词",["一轮明月。","正照得、云山如雪。","千里长江流不竭。","扣榜而歌，多少人兴灭。","飘零半世馀长铗。","醉来自把新诗说。","狂呼惊起蛟龙蛰。","掀倒青天，谁是英雄者。"],0,217,"清"],["小重山 宫词","陈世祥","词",["铜辇音稀梦未真。","笙歌他院落、总君恩。","金钗画月过黄昏。","凭谁伴、罗袖见秋痕。","眉淡不堪颦。","流苏还自下、倚香茵。","隔花宫漏悄无闻。","箫局火、香尽也难温。"],0,217,"清"],["踏莎行 简杨赤文兄弟","陈世祥","词",["书簏堆愁，酒痕成泪。","风光只解供憔悴。","古之贫者是何人，锦囊佳句来驴背。","是此生涯，尽多况味。","蠹馀鼠剩难教废。","今之贫者是何人，与君共拟诗瓢醉。"],0,217,"清"],["踏莎行 秋意","陈世祥","词",["团扇才轻，井梧初舍。","金风飒踏鸳鸯瓦。","绣帘未卷隔流萤，来回只在栏杆下。","露蕊柔零，月丝满泻。","小鬟多事将萤打。","扇儿悄动似能知，飞飞直上墙头者。"],0,217,"清"],["踏莎行 竹塘寺寓同夏坦仙夜话","陈世祥","词",["高笛横空，柔弦静月。","流萤几点都清绝。","坐来新露下梧桐，小凉时过罗衣折。","云练孤飞，河绳低掣。","百虫声里尘情歇。","十年消受是真闲，梦魂较比当时贴。"],0,217,"清"],["踏莎行 韫林为余书小青诗，仍属余代题","陈世祥","词",["梦影惊潮，梨魂碎水。","伤心尽在新词里。","西湖一碧葬琼花，杜鹃叫断孤山尾。","女子如斯，才人已矣。","古今多少如卿比。","莫将薄命为才嗟，艳思谁使文成绮。"],0,217,"清"],["鹊踏枝 病绪","陈世祥","词",["憨病如愁谁见慰。","着甚来由，陡地思量悔。","花片片飞春不系。","燕儿争取愁他坠。","翠损红零羞问婢。","只有菱花，是我真知己。","强起无情还欲睡。","罗帏更被香憔悴。"],0,217,"清"],["鹊踏枝 愁","陈世祥","词",["潦倒十年愁窟里。","病酒逋诗，意兴都无几。","愁绪世间何物比。","青衫湿似邗江水。","着地寻来谁可避。","好月名花，加倍添人泪。","最叵天公无意味。","生生风雨将春废。"],0,217,"清"],["鹊踏枝 上曲阳春日","陈世祥","词",["依旧春来生绿草。","风雪无端，偏阻行人道。","归梦不成频又觉。","可怜只是欢娱少。","也似江南山色好。","曾见花开，一样蜂儿闹。","闲着莫教楼上眺，乡心早比愁先到。"],0,217,"清"],["鹊踏枝 责草","陈世祥","词",["抹雨拖烟愁色重。","千里长途，为甚年年种。","惯把行人来断送。","楼头一望青无缝。","狼藉好花铺作供。","南北东西，是处惟伊横。","勾引香闺春绪动。","新泥污损鞋尖凤。"],0,217,"清"],["鹊踏枝 问柳","陈世祥","词",["烟柳成丝无甚系。","只是桥边，日日嘶征骑。","故把长条垂到地。","分明做就离亭意。","满院飞花狼藉坠。","坠向筵前，扑面如人泪。","卷作球儿吹又碎。","浮萍一夜遮池水。"],0,217,"清"],["鹊踏枝 冬闺","陈世祥","词",["可怜残腊无多许。","剩雪零冰，还做凄凉雨。","𦶟尽水沉无暖处。","好香不伴愁人住。","灯焰青荧花不吐。","冷梦依稀，欲记无头绪。","唤起侍儿痴不语，夜分应是多过午。"],0,217,"清"],["鹊踏枝 柬诸公敬亭宴集。代作","陈世祥","词",["记得瑶花栖绝𪩘。","转磴回溪，多少流云串。","俯看万松攒翠线。","南湖平展琉璃面。","想到高人能缱绻。","摇笔豪情，玉斝飞如箭。","新月晓霞天不倦。","千年韩李将无见。"],0,217,"清"],["鹊踏枝 春寒","陈世祥","词",["未及春来愁已及。","春到梅花，花朵还重袭。","饥雀啄抛红粒粒。","东君尽把幽香蛰。","酒倦诗逋成悒悒。","拟泛轻舟，怕见归潮急。","是处天涯愁尽入。","一窗风雨灯花涩。"],0,217,"清"],["渔家傲 渔父","陈世祥","词",["未织晚烟纷似絮。","涛牙嚼雪扁舟度。","网得鱼儿茭叶覆。","呼阿妇。","村中沽酒将钱去。","半醉归来船倚树。","大江多少风波路。","阿妇向前乂手诉。","君休误。","风波除却何方住。"],0,217,"清"],["渔家傲 烛花","陈世祥","词",["蜂蜡为谁开并萼。","铜龙已下重门钥。","多少相思无处着。","休见谑。","紫明知道人消索。","旧梦新愁眉上阁。","今春较比年来恶。","起剪烛花香灺落。","侬不错。","是花一样春飘泊。"],0,217,"清"],["醉春风 春叹","陈世祥","词",["闷雨和愁坠。","生把花时废。","近来整日下帘栊，睡。","睡。","睡。","香冷银囊，绣闲钿尺，只供憔悴。","醒梦难回避。","凄凉刚一味。","从今真正不思量，谇。","谇。","谇。","心系教枯，泪痕成积，枉然空费。"],0,217,"清"],["醉春风 久阴","陈世祥","词",["最是鸣鸠横。","硬与花成讼。","摧残万片葬新泥，痛。","痛。","痛。","屏曲香慵，帘旌腻逼，冷云无缝。","未把愁来送。","又把愁来种。","无聊觅得却愁方，梦。","梦。","梦。","白堕三升，黑甜一枕，讨他闲空。"],0,217,"清"],["天仙子 立夏","陈世祥","词",["酒恶更嗔花气袅。","起把落花和露扫。","黄鹂一个上枝头，来报道。","添烦恼。","今日五更春去了。","倦眼舒将烟渺渺。","是处溪山今绿绕。","却拈短棹问桃源，非故道。","人间杳。","繁阴如雨无啼鸟。"],0,217,"清"],["千秋岁","陈世祥","词",["愁城无外。","就里还无内。","多情伴我能无懈。","霜尖炉火弱，风闪灯光碎。","雁过也，声声凄苦真同派。","道力愁中耐。","仙骨愁中蜕。","星宿劫，愁难坏。","梦孤身怯影，围减腰憎带。","笑明朝，一年又去愁还在。"],0,217,"清"],["隔帘听 迟阿秀不即，至为西樵司勋赋","陈世祥","词",["看绽烛花双蒂，吐瓣人刚到。","罗帏笑揭声还悄。","悄悄问檀郎，为侬懊恼。","漏尽了。","怎和衣、枕头歪靠。","忙相抱。","檀郎轻笑。","试向卿卿道。","如年永夜铜壶杳。","听来偏错，故将人搅。","未天晓。","明朝细和伊表。"],0,217,"清"],["剔银灯 冬日敬亭宴集止宿","陈世祥","词",["趁得晴郊淡荡。","好载向、笋舆数两。","一线湖光，四围林影，衬出晚霞如绛。","扶筇山顶，便摘取、绛霞为酿。","吟就问天奇唱。","直唤醒、古人无恙。","刻烛诗成，倾瓢酒竭，我辈狂来差壮。","明朝重省，更笑倒、真狂非诳。"],0,217,"清"],["千秋岁 为吴尔世母节寿","陈世祥","词",["笑捧霞觞，代君陈祝。","万岁冰桃今岁熟。","四海交游歌寿母，三春风物先华屋。","伫期颐，褒节孝，君家独。","三十七年贞志笃。","三十七年庭训足。","兼父兼师心更曲。","当初茹苦唯熊胆，而今色养真仁粟。","湛夫人，百世后，留芳躅。"],0,217,"清"],["踏青游 清明日同西樵、介夫至法海寺","陈世祥","词",["烘日匀风，春光着人轻茜。","绣草路、泥香成片。","觅谁侬，和笑走，弓鞋初倦。","更是处、池塘簇蒲拖柳，闲杀画船歌板。","把酒楼头，凭阑望中平衍。","叹此日、春光都贱。","彩旗空，绒索冷，秋千荒院。","总听彻、归途小亭妖曲。","依旧楚天云远。"],0,217,"清"],["八六子 挑灯僧舍，风雪畏人，凄然有尘中之戚","陈世祥","词",["坐僧寮。","何来风雪，欺人窗纸频敲。","看壁上横刀自吼，床头斗酒孤倾，可怜缊袍。","是谁潦倒吾曹。","半枕故乡离梦，十年流水诗瓢。","不禁得短鬓，恰如秋叶，奇云灭影，好花减片，拼向水国几家渔父，烟林一个山樵。","兴还饶。","多他这卷离骚。"],0,217,"清"],["意难忘 送曹顾庵学士还武塘，同用高字","陈世祥","词",["客也无聊。","况栖迟岁晚，风物萧萧。","酒坛差共慰，墨阵颇能豪。","容笑傲、有吾曹。","垒块正须浇。","但输他、青衫湿了，还对檀槽。","夜阑月小天高。","更霜华痕重，逼向征袍。","谈深嫌漏急，曲缓寄弦幺。","无奈事、可怜宵。","别恨总难抛。","怕看来、晓江风色，似雪寒涛。"],0,217,"清"],["满江红 赋红白菊花","陈世祥","词",["润白柔红，都删去、人间颜色。","讶座上、并肩联袂，谁家双璧。","裴令正从粗服好，卫郎合向羊车觅。","判此生、饮兴伴伊家，千浮白。","香黯淡，无痕迹。","影历乱，难收拾。","看繁英烂蕊，万花如织。","叶索排当浑勉强，花头打掐真萧瑟。","问当年、篱下旧风流，谁能识。"],0,217,"清"],["满江红 社集又赋红白菊","陈世祥","词",["是处栽花，遍园林、寻常蹈袭。","尽岁月、留枝养叶，补疏删密。","骚客徒夸英正落，人间岂有花能实。","看如今、两树占秋芳，成花国。","十日坐，旃檀席。","五夜对，琼瑶壁。","更红情不艳，白光如拭。","浸玉寒泉明夜雪，助妆金盏酣朝日。","是臣髡、饮酒最欢时，甘千石。"],0,217,"清"],["满江红 梦中饮名酒追忆","陈世祥","词",["名酒招余，见尊斝、恭而竦立。","恰醅香到鼻，肃然三揖。","兰气故从幽谷吐，露华岂落人间迹。","笑当年、虎魄诧兰陵，非佳客。","髯也隘，悭一滴。","髡也妄，夸一石。","共此公相对，莫言朝夕。","兴发君能倾十斗，醉来我愿拼千日。","只李生、一斗百篇诗，真无敌。"],0,217,"清"]]