[["景祐以后乐章六首 其二 酌献用《厚安》。","郊庙朝会歌辞","四言",["祥标曾麓，德合方仪。","万邦展养，九御蒙慈。","孝恭祊祏，美播声诗。","淑灵顾享，申锡维祺。"],0,"x207","宋"],["绍兴二十八年祀圜丘 奉俎用《丰安》。","郊庙朝会歌辞","四言",["至大惟天，云何称德。","展诚致荐，牲用博硕。","诚以牲寓，帝由诚格。","居歆降祥，时万时亿。"],0,"x207","宋"],["送蒋宪颖叔","徐积","四言",["五岭之南，其极西徼。","其旁大海，木深山峭。","内有溪洞，外有交趾。","皮厚肉坚，铁为骨髓。","雉兔伏藏，猱猿突起。","动如飘风，猛如湍水。","独恩不畏，独威不怀。","扰之则去，抚之则来。","恩之与威，不可去一。","宽猛交济，不可无术。","坐当一面，则有帅臣。","按刑将漕，要皆得人。","以德以才，公称其选。","能不择官，义不辞远。","始闻有命，严装以需。","青毡角簟，药鼎茶炉。","琴堂旧谱，铃阁新书。","史帙签重，诗囊卷粗。","前施斋舫，后设行厨。","公既拜命，不敢宁居。","乃戒徒御，乃建帆樯。","鸣刁击鼓，旗帜开张。","州人感恩，父老童稚。","知不可留，以足顿地。","或前塞路，或后从行。","或献花酒，或犒从兵。","或望于野，或送一程。","即日渡江，江南春早。","雪尽冰消，江山如扫。","柳径桃蹊，梅花芳草。","沽酒村遥，卖鱼船小。","晨散乌群，暮归白鸟。","春正好时，已到岳阳。","岳阳楼下，苍苍茫茫。","岳阳楼上，飞沫浮光。","江山旧物，吴楚凄凉。","夜宿巴陵，晓过洞庭。","湖中水绿，湖口山青。","黄陵古祠，长沙古路。","潇江湘江，风烟古渡。","岳麓茶林，沙洲橘树。","此时春深，衡阳雁去。","时饮一杯，时吟几句。","更望九嶷，清诗无数。","揽辔登山，日日西南。","褰帷叱驭，车不停骖。","乃有部吏，乃有蛮酋。","青衫负弩，锦帕缠头。","公曰使者，实典兵刑。","增置强弩，多募土兵。","宜浚其隍，宜坚其城。","公曰弓手，宜如旧制。","加之训练，可使精锐。","可代城郭，为民捍蔽。","公曰民命，悬在狱官。","不可不慎，不可不宽。","宽于善良，勿失有罪。","恶人如虎，养之成害。","公曰生民，不可无教。","教民之官，县令最要。","今则不然，困于簿领。","甚者可除，烦者可省。","仍复乡官，则无所病。","凡我部吏，各恭厥职。","夜则精思，昼则宣力。","一节当官，赤心为国。","如此教告，如此施设。","吏则心服，民则心悦。","诸公闻之，荐者交章。","朝廷器之，下诏褒扬。","召而用之，优于冯唐。"],0,"x123","宋"],["颂古九十八首 其九十二","释印肃","四言",["玄沙大用，雪峰三弄。","大地山河，六遍震动。"],0,"x121","宋"],["别日何易行","释文珦","四言",["别日何易，会日何难。","道路修阻，山川郁盘。","寤寐怀思，涕泣汍澜。","思君不已，损我容颜。","时歌旧章，期以自宽。","歌终太息，反开忧端。","孤鸿嘹唳，过彼云间。","欲托遗音，遐征不还。","出户徘徊，风露凄寒。","明月皎皎，星斗阑干。","罗帷飘扬，顾影难安。","耿耿长夜，摧此心肝。"],0,"x80","宋"],["偈颂三十六首 其十六","释如珙","四言",["拈槌竖拂，好肉剜疮。","举今举古，开眼尿床。"],0,255,"宋"],["绍兴二十八年祀圜丘 出小次位用《干安》。","郊庙朝会歌辞","四言",["爰熙紫坛，天地并贶。","来燕来宁，毕陈郁鬯。","承神至尊，精意所乡。","告灵飨矣，祉福其畅。"],0,"x207","宋"],["华之高寿鲁斋先生七十  其六","金履祥","四言",["新宫岩岩，佩玉翩翩。","毋曰予耄，而将闭闗。"],0,83,"宋"],["夕月十首 酌献用《嘉安》。","郊庙朝会歌辞","四言",["白藏在序，享惟其时。","躬即明坛，礼惟载祗。","斟以瑶爵，神灵燕娭。","歆馨顾德，锡我蕃厘。"],0,"x207","宋"],["冬至孟春孟夏季秋四祀上公摄事七首 降神用《景安》。二章。","郊庙朝会歌辞","四言",["天何言哉，至清而健。","默定幽赞，降祥福善。","夙设圜坛，恭陈嘉荐。","贞驭下临，储休锡羡。","生物之祖，兴益之宗。","于国之阳，以禋昊穹。","六变降神，于论鼓钟。","亲德享道，锡羡无穷。"],0,"x207","宋"],["明堂庆成颂  其一○","徐鹿卿","四言",["相维辟公，耆俊布列。","珩璜锵鸣，笾豆丰洁。"],0,73,"宋"],["淳熙十二年加上太上皇帝太上皇后尊号十一首 其十一 内侍举太上皇后册宝诣读册宝位用《圣安》。","郊庙朝会歌辞","四言",["有美英瑶，于昭祥金。","为策为章，并著徽音。","德圣而尊，备举弥文。","亿载万年，永辅尧勋。"],0,"x207","宋"],["上耿泉生朝  其一○","杨简","四言",["惟公诞弥，良月惟时。","地数盈成，梦维熊罴。","何以寿之，南山维基，松柏维滋。","毋祝毋祈，公自有之。","某也作诗，于以敬之。"],0,118,"宋"],["绍兴祀太社太稷十七首 还位用《正安》。","郊庙朝会歌辞","四言",["国主太祀，地道聿神。","稷司百谷，利毓惟均。","练日新吉，粢盛𫗣芬。","神燕娭矣，福此下民。"],0,"x207","宋"],["以冰饷同舍","傅崧卿","四言",["蓬莱道山，群仙所游。","清异人境，不风自凉。","火云腾空，莫之能炎。","饷以冰雪，是谓附益。"],0,172,"宋"],["头陀赞","黄庭坚","四言",["梵语头陀，华言抖擞。","净一真心，振三毒垢。","如来亲试，迦叶称首。","圣教推崇，哲人遵守。","衣三食四，住处五名。","曰十二行，对治修行。","十三或八，要以三并。","练磨三境，摄化三乘。","起四欢喜，行四圣种。","以戒为基，止观相踵。","大矩崇规，炼金烹矿。","号菩萨僧，志惟坚勇。","知足少欲，伏我受根。","无取无著，情绝所存。","若有赞者，同赞世尊。","续佛慧命，开佛正门。","在昔能仁，嘱付弥勒。","守护三宝，后五百岁。","弥勒称扬，此行为最。","适当其时，应身出世。","阿兰若处，作众依归。","则先贤轨，发薙肩垂。","白麻劫贝，不随染衣。","表如玉雪，不受尘泥。","心寂为禅，心净为教。","内外相应，方名修道。","事贵简严，理惟幽奥。","不具信根，玄关莫造。","祈生兜率，天乐非贪。","菩提熏种，慈氏言参。","其或超越，罔假司南。","十方法界，同我伽蓝。"],0,"x66","宋"],["高宗郊祀前朝享太庙三十首 其五 尚书奉俎用《丰安》。","郊庙朝会歌辞","四言",["有硕其牲，登于大房。","肃展以享，庶几迪尝。","匪腯是告，我民其康。","保艾尔后，垂休无疆。"],0,"x207","宋"],["高宗建炎初祀昊天上帝 亚、终献用《文安》。","郊庙朝会歌辞","四言",["惟圣普临，顺皇之德。","典礼有彝，享祀不忒。","笾豆静嘉，降登肸饬。","神具醉止，景贶咸集。"],0,"x207","宋"],["庆梅州刘侯修葺程乡学宫落成  其二","林陶","四言",["宣圣南面，珠旒衮章。","十哲侑坐，群贤缋廊。","六斋分列，小学峙傍。","谈经议道，春祠秋尝。","我侯戾止，率由典常。"],0,67,"宋"],["进仰山瑞禾诗宋大雅十三章  其三","张商英","四言",["皇帝孝仁，羹墙神考。","遹追先猷，三代之道。","炳然规模，百世之宝。","敢弗祇从，率意改造。"],0,116,"宋"],["奉送驹父师川二郎中赴召四言","洪炎","四言",["火中暑退，庚伏在娄。","赫炽方炎，金石欲流。","之二大夫，服章紑紑。","文昌台郎，祗命是忧。","中江有舳，中涂有辀。","风樯雨毂，长夏为秋。","白云在天，崒如岩丘。","倏忽西东，不我告谋。","翩翩者鹄，俯瞩鱼游。","将逝复止，矫影河洲。","嗟予去国，三葛于休。","止车生耳，永谢鸣驺。","挥袂江干，长啸林幽。"],0,110,"宋"],["姜山静疑院铁磬老师通公真赞","刘一止","四言",["堂堂律师，了无上乘。","律彼后生，约束如绳。","我煞叩师，师笑而嘻。","曰我无心，法何所依。","以无心故，说持说犯。","以无法故，横竖钩贯。","我知是师，说本无说。","身心了然，片云孤月。","姜山嵯峨，宛在世外。","访师遗踪，惟铁磬在。","片云出山，孤月丽天。","铁磬不鸣，声满大千。"],0,239,"宋"],["进仰山瑞禾诗宋大雅十三章  其四","张商英","四言",["蔽自渊衷，恪遵熙丰。","法非补完，熙丰是同。"],0,116,"宋"],["偈颂六十七首 其五十三","释原妙","四言",["意句不到，宗说不通，盲龟跛鳖。","意句俱到，宗说俱通，盲龟跛鳖。"],0,137,"宋"],["进仰山瑞禾诗宋大雅十三章  其五","张商英","四言",["乃戢干戈，不勤远略。","烦敛是蠲，冗官是削。","屏斥浮虚，尊敦俭朴。","舳舻尾衔，溯流通洛。"],0,116,"宋"],["王廙问安王秋二帖赞","岳珂","四言",["摹法之精，必验以真。","我见枣刻，已同似人。","启以楷书，告以章草。","情敬之分，于此焉考。"],0,"x202","宋"],["进仰山瑞禾诗宋大雅十三章  其八","张商英","四言",["百度孔修，德泽滂流。","官知奉法，吏畏纳赇。","农夫熙熙，服我先畴。","桴鼓不鸣，奠枕靡忧。"],0,116,"宋"],["进仰山瑞禾诗宋大雅十三章  其九","张商英","四言",["职是善化，有赫临下。","阴阳泰通，薰蒸陶冶。","惠两柔风，太和塞野。","渗漉百嘉，芃芃禾稼。"],0,116,"宋"],["偈颂一百三十六首 其十六","释惟一","四言",["罗绮丛中，笙歌社里。","灯明如来，放光现瑞。"],0,143,"宋"],["进仰山瑞禾诗宋大雅十三章  其一","张商英","四言",["彼修者禾，其穗七兮。","夐古所无，今感格兮。"],0,116,"宋"],["绍兴二十八年祀圜丘 昊天上帝位奠玉币用《嘉安》。御制。","郊庙朝会歌辞","四言",["上穹昊天，日星垂曜。","照临下土，王国是保。","维玉与帛，寅恭昭报。","永左右之，钦若至道。"],0,"x207","宋"],["偈颂一百三十六首 其六十七","释惟一","四言",["今朝结制，制如何结。","内不放出，外不放入。","壁立千仞，千仞壁立。"],0,143,"宋"],["绍兴以后时享二十五首 彻豆用《兴安》。","郊庙朝会歌辞","四言",["礼备乐成，物称诚竭。","相维辟公，神人以说。","歌雍一章，诸宰斯彻。","天子万年，无竞维烈。"],0,"x207","宋"],["华之高寿鲁斋先生七十  其一一","金履祥","四言",["屹屹王子，三寿作朋。","视彼霸侯，曾是足论。"],0,83,"宋"],["淳熙十二年加上太上皇帝太上皇后尊号十一首 其二 中书令、侍中奉太上皇帝、太上皇后册宝诣殿下用《正安》。","郊庙朝会歌辞","四言",["二仪同尊，两耀齐光。","巍巍煌煌，不显亦彰。","实茂号荣，玉振金相。","于万斯年，既寿且昌。"],0,"x207","宋"],["偈颂一百三十六首 其八十二","释惟一","四言",["琢雪雕冰，攒花簇锦。","邻义昭昭，友义烱烱。","扶人上树，推人下井。","劫石可消，此恨难殒。"],0,143,"宋"],["杨岐会和尚赞","释智愚","四言",["灰头土面，弄假像真。","三脚驴子，独角麒麟。"],0,"x153","宋"],["建隆干德朝会乐章二十八首 其二 上寿用《禧安》。","郊庙朝会歌辞","四言",["舜韶更奏，尧酒浮觞。","皇情载怿，洪算无疆。","基隆郏鄏，德茂陶唐。","山巍日焕，地久天长。"],0,"x207","宋"],["绍兴淳熙分命馆职定撰十七首 文舞退、武舞进用《正安》。","郊庙朝会歌辞","四言",["温厚严凝，于皇上帝。","文德武功，列圣并配。","舞缀象成，肃雍进退。","秉翟踆踆，总干蹈厉。"],0,"x207","宋"],null,["绣释迦像并十八罗汉赞 第十二那迦犀那尊者","惠洪","四言",["苾刍捧塔，示空寂身。","于菟对我，示心境真。","手把宝书，而不展玩。","又示解空，文字不断。"],0,"x42","宋"],["夕月十首 奠玉币用《嘉安》。","郊庙朝会歌辞","四言",["少采陈仪，实曰坎祭。","礼备乐举，严恭将事。","于以奠之，嘉玉量币。","神兮昭受，阴骘万汇。"],0,"x207","宋"],["颂古九十八首 其七十九","释印肃","四言",["释梵天帝，宝冠履地。","不诵华严，佛不富贵。","离四句非，绝百非是。","绝百非非，离四句易。"],0,"x121","宋"],null,["宗忠简赠陈秀才诗帖赞","岳珂","四言",["赫蹄之纸，幅不盈咫。","字杂众体，诗具二美。","不轶不毁，相维天只。","意质功伟，有志视此。"],0,"x202","宋"],["宗忠简留守司二劄家书吾友三帖赞","岳珂","四言",["人心大义，不作不奋。","楚汉之间，较者尺寸。","翼翼京邑，九圣所都。","时方多艰，天下之枢。","势进则张，狙诈作使。","聚而遗毒，不人则己。","一退则衄，彼莫我宗。","于敌弗施，各逞其锋。","天方授吾，狼贪如罕。","使乘其弊，只轮不返。","机失于昨，何救匪今。","方愤之人，未弱之心。","京国有君，河外有统。","如彼见关，孰不鼓勇。","荦荦忠简，蓍数龟陈。","瞭其胸中，七十之身。","黄汪何知，爱以姑息。","捐之中原，俾自为敌。","谓不可敌，公方渡河。","连壁百万，马腾士歌。","公心何爱，愤至于死。","纽不在上，虽缔易弛。","荥阳勿守，汉业岂高。","屠狗贩侩，何吠不嘈。","公之皇皇，意固有谓。","究观后来，公则知至。","人谓公迹，如祖豫州。","河南晋土，未终其谋。","人谓公身，如葛丞相。","祁山屡出，竟沮凋丧。","惟我谓公，特知所先。","用公之言，必也万全。","三光其分，五岳其裂。","天乎奈何，谁实为孽。","精卫往矣，所填者波。","叫于九阍，公心不磨。"],0,"x202","宋"],["元符亲享明堂十一首 其一 皇帝升降用《仪安》。","郊庙朝会歌辞","四言",["严父配天，孝乎明堂。","与奠升阶，降音以将。","天步有节，帝容必庄。","辟公宪之，礼无不臧。"],0,"x207","宋"],["咸平亲郊八首 其五 酌献用《禧安》","郊庙朝会歌辞","四言",["大报于帝，盛德升闻。","醴齐良洁，粢盛苾芬。"],0,"x207","宋"],["元符亲郊五首 其五 送神用《景安》。","郊庙朝会歌辞","四言",["馨遗八尊，器空二簋。","至祝至虔，穹祇贶祉。"],0,"x207","宋"],["沈存中画像赞","李之仪","四言",["先天弗违，圣时以乘。","人谋鬼谋，其谁其能。","彼虽渊密，我则揆叙。","万目交张，维纲之举。","展也吾人，一世绝拟。","孰友多文，宛在中沚。","用此以通，亦以是穷。","自崖反矣，凛然孤风。"],0,"x203","宋"],["进仰山瑞禾诗宋大雅十三章  其六","张商英","四言",["泉币既平，商旅云行。","四民乐化，迭为重轻。"],0,116,"宋"],["绍兴以后时享二十五首 神宗室酌献用《大明》。","郊庙朝会歌辞","四言",["于昭神祖，运抚明昌。","肇新百度，克配三王。","遐荒底绩，圣武维扬。","永言执竞，上帝是皇。"],0,"x207","宋"],["偈颂六十七首 其四十七","释原妙","四言",["入我法中，不论凡圣。","动转施为，咸遵旧令。"],0,137,"宋"],["闻思大士入定相善财童子致恭揭谛神后卫因为之赞","陈长方","四言",["幪头叠足，敛目而禅。","闻思尽处，当念超然。","不起于座，遍群生前。","如行空月，影落百川。","提孩念道，访求知识。","海山绝处，慈容忽觌。","一俛仰间，今吾非昔。","回首百城，山川历历。","大士俨若，非空非有。","毁赞莫及，孰卫孰守。","唯此力人，雄风赳赳。","是亦孔门，御侮之友。"],0,142,"宋"],["华之高寿鲁斋先生七十  其一六","金履祥","四言",["北山之阳，其及王子。","毋然遁思，孤我帝祉。"],0,83,"宋"],["绍兴二十八年祀圜丘 入小次用《干安》。","郊庙朝会歌辞","四言",["恭展美报，聿修上仪。","礼乐和节，登降适宜。","德焉斯亲，神靡不娭。","海内承福，式固邦基。"],0,"x207","宋"],null,["高宗祀明堂前朝享太庙二十一首 其十九 饮福用《禧安》。","郊庙朝会歌辞","四言",["赫赫明明，德与天通。","施于孙子，福禄攸同。","日靖四方，民和年丰。","有秩斯祜，申锡无穷。"],0,"x207","宋"],["绍兴淳熙分命馆职定撰十七首 酌献用《德安》。","郊庙朝会歌辞","四言",["炎运中兴，苍生载宁。","九秩燕豫，三纪丰凝。","精祀上帝，陟配威灵。","锡羡胙祉，万世承承。"],0,"x207","宋"],["偈颂七十六首 其六十五","释师观","四言",["一日不作，一日不食。","木平搬土，石霜泥壁。","洪山断足，仰山作息。","澄翠门下，朝朝入室。","如上所供，并皆诣实。"],0,210,"宋"],["熙宁祀皇地祇十二首 其九 退文舞、迎武舞用《威安》。","郊庙朝会歌辞","四言",["雍雍肃肃，建我采旄。","舞以玉戚，不吴不敖。","其将其肆，脾臄嘉肴。","何以侑乐，钟鼓管箫。"],0,"x207","宋"],["高宗郊祀前朝享太庙三十首 其二十六 还位用《干安》。","郊庙朝会歌辞","四言",["帝既临享，步武鸣鸾。","陟降规矩，颙昂周旋。","登歌一再，典礼莫愆。","神之听之，祉福绵绵。"],0,"x207","宋"],["冬至孟春孟夏季秋四祀上公摄事七首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["秩秩礼文，肃肃严祀。","仰洽神休，式协民纪。","灌献有容，叙其俎簋。","明德惟馨，以介丕祉。"],0,"x207","宋"],["次公招看绿萼梅和韵","韩淲","四言",["春山有梅，萼绿香洁。","爱雪宜霜，凭风藉月。","花已开明，枝复横绝。","翠袖天寒，供吟试折。"],0,"x120","宋"],["大观祀社稷九首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["荐嘉亶时，洋洋来格。","载登兹坛，齐明维敕。","神用居歆，顺成农穑。","其崇若墉，其比如栉。"],0,"x207","宋"],["宁宗朝享三十五首 仁宗室用《美成》。","郊庙朝会歌辞","四言",["在宋四世，天子圣神。","用贤致治，约己裕民。","海内富庶，裔夷肃宾。","四十二年，尧舜之仁。"],0,"x207","宋"],["祫享八首 送神用《兴安》。","郊庙朝会歌辞","四言",["合祭大事，因时发天。","翼翼孝思，三献礼虔。","神兮乐康，飙驭言旋。","永福后人，于千万年。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 送神用《凝安》。","郊庙朝会歌辞","四言",["蹇兮纷纷，神实戾止。","以饮以食，以享以祀。","𣅺兮冥冥，神亦归止。","以醉以饱，以锡尔祉。"],0,"x207","宋"],null,["绍兴享先农十一首 其九 饮福用《禧安》。","郊庙朝会歌辞","四言",["幽明位异，施报理同。","克恭明神，降福乃丰。","我膺受之，来燕来崇。","岂伊专飨，于彼三农。"],0,"x207","宋"],["景德蜡祭百神三首 其三 送神用《高安》。","郊庙朝会歌辞","四言",["来顾来享，礼成乐备。","灵驭翩翩，云行雨施。"],0,"x207","宋"],["沈忠敏劳军帖赞","岳珂","四言",["仕同时也，志同归也。","相与以心，无町畦也。","职位接踵，亦相齐也。","噫嚱此帖，比传衣也。"],0,"x202","宋"],["绍兴亲享明堂二十六首 其六 皇地祇位奠玉币用《嘉安》。","郊庙朝会歌辞","四言",["至哉坤元，持载万物。","继天神圣，观世治忽。","颂祇之堂，荐以圭黻。","孰为邦休，四海无拂。"],0,"x207","宋"],["高宗明堂前朝献景灵宫十首 其六 文舞退、武舞进用《正安》。","郊庙朝会歌辞","四言",["进旅退旅，载执干戚。","不愆于仪，容服有赫。","式妥式侑，神保是格。","灵鉴孔昭，孝思维则。"],0,"x207","宋"],["建隆以来祀享太庙十六首 其五 又用《玉乌》。","郊庙朝会歌辞","四言",["素乌爰止，淳精允臧。","名符瑞牒，色应金方。","洁白容与，翘英奋扬。","孝思攸感，皇德逾张。"],0,"x207","宋"],null,["绍兴以后祀五方帝六十首 赤帝酌献用《祐安》。","郊庙朝会歌辞","四言",["四月维夏，兆于重离。","帝执其衡，物无疠疵。","于皇帝功，思乐旨酒。","奠爵既成，垂福则有。"],0,"x207","宋"],["高宗郊祀前朝享太庙三十首 其八 翼祖室酌献用《大顺》。","郊庙朝会歌辞","四言",["天命有开，维仁是依。","乃眷冀邦，于以顾之。","其顾伊何，发祥肇基。","施于孙子，虔奉孝思。"],0,"x207","宋"],["御史中丞秦公","《靖康小雅》作者","四言",["天崩地陷，革我洪图。","孰敢争之，维时醇儒。","祈复明辟，义在捐躯。","猛虎垂涎，遂捋其须。","骊龙不睡，乃探其珠。","身赴沙漠，名振九区。"],0,91,"宋"],["景灵宫乐章 皇帝还位干安之曲","周麟之","四言",["帝临閟庭，逆釐上灵。","神保安坐，肃若有承。","嘉觞既申，德闻惟馨。","灵光留俞，祚我亿龄。"],0,103,"宋"],["宁宗朝享三十五首 诣室用《干安》。","郊庙朝会歌辞","四言",["丹楹云深，芳勺宵奠。","乐华淳鬯，礼文炳绚。","有容有仪，载肃载见。","维时缉熙，世世以燕。"],0,"x207","宋"],["明堂庆成颂  其一三","徐鹿卿","四言",["曶焉低垂，非云非烟。","若降若接，郁郁纷纷。"],0,73,"宋"],["夕月十首 升殿用《正安》。","郊庙朝会歌辞","四言",["猗欤崇基，右平左墄。","祗率典常，届兹秋夕。","陟降惟寅，威仪抑抑。","神其鉴观，穰简是集。"],0,"x207","宋"],["送贾镇卿","徐积","四言",["萧县大夫，气质端劲。","其中所养，不邪而正。","正以辅才，恕以辅明。","面无谀色，口无谀声。","若斯人者，宜于王庭。","而况一县，为惠为泽。","恕所以惠，威所以立。","猛宽得中，韦抗是也。","诛奸殄寇，有贺齐者。","东汉庞参，作守汉阳。","政所以茂，实繄任棠。","以君之正，以君常德。","力追古人，是宜是适。"],0,"x123","宋"],["绍兴二十八年祀圜丘 亚献用《正安》。","郊庙朝会歌辞","四言",["阳丘其高，神祇并位。","既奠厥玉，既奉厥醴。","亦有嘉德，克相毖祀。","旨酒载爵，以成熙事。"],0,"x207","宋"],["绍兴享先农十一首 其五 酌献用《禧安》。","郊庙朝会歌辞","四言",["蠲涤盏斝，巾帨而升。","挹彼注兹，酒醴维清。","洋洋在上，享于克诚。","神其孚佑，以厚民生。"],0,"x207","宋"],["述易述雅二章与赵清臣制帅  其一","袁甫","四言",["六十四卦，惟谦纯吉。","九四大臣，居位以德。","满则易敧，盈兮斯食。","惟谦下人，不违天则。","此则伊何，元无损益。","澄然太空，秉心惟一。","明哲保身，神所辅翊。","持此㧑谦，与宋无极。"],0,229,"宋"],["绍兴朝会十三首 其二 群臣酒行用《正安》。","郊庙朝会歌辞","四言",["明明天子，万福来同。","嘉宾式燕，曷不肃雍。","燕以示慈，式礼莫愆。","乐胥君子，容止可观。"],0,"x207","宋"],["绍兴二十八年祀圜丘 诣饮福位用《干安》。","郊庙朝会歌辞","四言",["帝临崇坛，媪神其从。","祖宗并歆，福禄攸同。","兵寝刑措，时和岁丰。","其膺受之，将施无穷。"],0,"x207","宋"],["高宗郊祀前朝享太庙三十首 其二 皇帝升殿用《干安》。诣室、降殿并同。","郊庙朝会歌辞","四言",["皇皇大宫，丕显于穆。","休德昭清，元气回复。","芝叶蔓茂，桂华冯翼。","孝孙假斯，受兹介福。"],0,"x207","宋"],["建隆以来祀享太庙十六首 其二 皇帝行用《隆安》。","郊庙朝会歌辞","四言",["工祝升阶，宾尸在位。","祗达孝思，允修毖祀。","显相有仪，克恭乃事。","俨恪其容，通此精意。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 黄帝酌献用《祐安》。","郊庙朝会歌辞","四言",["黍以为翁，郁以为妇。","以侑元功，以酌大斗。","伊谁歆之，皇皇帝后。","伊谁嘏之，天子万寿。"],0,"x207","宋"],null,["建隆以来祀享太庙十六首 其十四 亚献用《正安》。","郊庙朝会歌辞","四言",["已象文治，乃观武成。","进退可度，威仪克明。"],0,"x207","宋"],["上广东漕使黄郎中  其二","曾丰","四言",["维春茸茸，惟和之功，惟阳之中。"],0,"x193","宋"],["绍兴以后祀五方帝六十首 青帝酌献用《祐安》。","郊庙朝会歌辞","四言",["百末布兰，我酒伊旨。","酌以匏爵，洽我百礼。","帝居青阳，顾予嘉觞。","右我天子，宜君宜王。"],0,"x207","宋"],null,["绍兴祀太社太稷十七首 升坛用《正安》。","郊庙朝会歌辞","四言",["神地之道，粒食有先。","岁谨祈报，礼严豆笾。","降登祼荐，罔或不虔。","以似以续，宜屡丰年。"],0,"x207","宋"],["绍兴以后时享二十五首 僖祖室酌献用《基命》。","郊庙朝会歌辞","四言",["于穆文献，自天发祥。","肇基明命，锡羡无疆。","子孙千亿，宗社灵长。","神之格思，如在洋洋。"],0,"x207","宋"],["述易述雅二章与赵清臣制帅  其二","袁甫","四言",["大雅不作，𬣙谟音希。","公既奏功，衮衣盍归。","归矢尔谟，琅琅厥辞。","用添帝聪，烛于几微。","天位孔艰，夙夜弼违。","逆耳为忠，隠情乃欺。","择乎二者，上帝监兹。","煌煌祖业，忠臣念之。"],0,229,"宋"]]