[["绍兴二十八年祀圜丘 饮福用《禧安》。","郊庙朝会歌辞","四言",["八音克谐，降神出祇。","风马云车，陟降在兹。","锡我纯嘏，我应受之。","一人有庆，燕及群黎。"],0,"x207","宋"],["绍兴朝会十三首 皇帝降坐用《干安》。","郊庙朝会歌辞","四言",["帝坐荧煌，廷绅肃穆。","对扬天休，各恭尔服。","颂声洋洋，弥文郁郁。","礼备乐成，永膺多福。"],0,"x207","宋"],["送梁子熙联句","苏舜元","四言",["大荣大辱，能生死人。","二物不并，以挠厥真。","之子病闷，肠如车轮。","劳忧到母，饶寒著身。","世俗卤莽，辄置莫亲。","文彩华艳，伏不得伸。","凄吟哀号，酸入四邻。","夜计破午，若燕作秦。","腹愤轧轧，胸奇陈陈。","淮国晚岭，吴渠春津。","去谢夙蕴，归逢故辛。","雌火相丑，刮凿遁屯。","驾风鞭霆，以脱凡鳞。"],0,146,"宋"],["上许州吕相公嗣崧许康诗二首 嗣崧诗 其三","宋祁","四言",["帝诏执事，彻申土疆，衍沃腴良。","赋舆溱溱，莫乐于申。","昔在四岳，佑尧象禹，为国心膂。","受民作邦，于今以光。"],0,"x49","宋"],["绍兴以后时享二十五首 送神用《兴安》。","郊庙朝会歌辞","四言",["霜露既降，时思展禋。","在天之御，眷然顾歆。","乐成礼备，言归靡停。","既安既乐，福禄来成。"],0,"x207","宋"],["熙宁蜡祭十三首 其三 奠币用《钦安》。","郊庙朝会歌辞","四言",["穰穰丰年，繄侯休德。","帅承天和，钦象古则。","嘉玉量币，奠容翼翼。","灵施暨民，罔有终极。"],0,"x207","宋"],["宋景文言志帖赞","岳珂","四言",["既有史才，又得墨妙。","今古言辞，事功谈笑。","蜀人之藏，曰维甘棠。","我时其传，以著不忘。"],0,"x202","宋"],["绍兴二十八年祀圜丘 还位用《干安》。","郊庙朝会歌辞","四言",["克昭王业，命成昊天。","泰畤禋燎，八陛惟圆。","肃然威仪，登降周旋。","是谓精享，神监吉蠲。"],0,"x207","宋"],["绍兴二十八年祀圜丘 还位用《干安》。","郊庙朝会歌辞","四言",["肆类上帝，怀柔百神。","槁秸既设，圭币既陈。","精诚潜交，已事而竣。","佑我亿载，基图日新。"],0,"x207","宋"],["绍兴二十八年祀圜丘 还位用《干安》。","郊庙朝会歌辞","四言",["帝出于震，孝奏上仪。","燔燎膻芗，神徕燕娭。","肃若旧典，罔或不祗。","既右飨之，翕受蕃厘。"],0,"x207","宋"],["绍兴朝会十三首 皇帝升坐用《干安》。","郊庙朝会歌辞","四言",["钩陈肃列，金奏充庭。","颙卬南面，如日之升。","垂衣拱手，治无能名。","顺履献岁，大安大荣。"],0,"x207","宋"],["闵雨诗 其一","刘敞","四言",["堪舆𬘡缊，一晦一明。","或沈而晦，或亢而旸。","自古已然，世习为常。"],0,"x51","宋"],["释迦如来出山像赞","释清远","四言",["妙色非身，形容乃普。","阎浮未下，双林已睹。","旷济功深，六年行苦。","尘沙相好，万亿刹土。","众生心净，佛日常午。","正念蒙光，迷人外取。","雕檀写氎，像未孩乳。","今兹范模，传从乃古。","象步出山，智珠河吐。","水月顿澄，豁开觉户。","瞻之仰之，岂敢自侮。","常在不灭，此言手舞。"],0,116,"宋"],["元符亲郊五首 其一 降神用《景安》，六变辞同。","郊庙朝会歌辞","四言",["无为靡远，深厚广圻。","祭神恭在，弁冕衮衣。","粢盛丰美，明德馨辉。","以祥以佑，非眇专祈。"],0,"x207","宋"],["四先生像赞 南轩张宣公","刘黻","四言",["玉质金相，卓尔良贵。","有鉴在心，明利与义。","大原斯阐，维世之模。","表里不贰，皇皇圣途。"],0,247,"宋"],["熙宁皇太后册宝三首 其二 升坐用《干安》。","郊庙朝会歌辞","四言",["峨峨绣扆，旋佩以登。","如彼杲日，凌天而升。","玉色下照，亹亹绳绳。","猗欤大孝，四海其承。"],0,"x207","宋"],["摄事十三首 太宗室用《大盛》。","郊庙朝会歌辞","四言",["穆穆太宗，与天合德。","昧旦丕显，干干翼翼。","敷佑下民，时帝之力。","永怀圣神，孝思罔极。"],0,"x207","宋"],["庆梅州刘侯修葺程乡学宫落成  其一","林陶","四言",["孰不为邦，孰守其乡。","如被锦衣，昼行辉煌。","侯曰上恩，曷敢弭忘。","何以报之，俾民向方。","言葺泮宫，于乡有光。"],0,67,"宋"],["题江贯道山水四言","林希逸","四言",["远山丛丛，远树蒙蒙。","咫尺万里，江行其中。","短长何岸，高低何峰。","彼坻彼洔，彼瀑彼洪。","晴岚乍豁，烟霭葱笼。","或断或属，且淡且浓。","尔崒奚寺，尔盘奚宫。","或垣阴翳，或梁嵌空。","有吠者厖，有樵者翁。","危樯落碇，短棹掀蓬。","往来异趣，寂动殊容。","羃翠其庭，岂非卢鸿。","略彴而渡，岂非龟蒙。","昔我经行，云山万重。","若淮南北，与江西东。","亦蓑而雨，亦帽而风。","乃今追惟，梦境相从。","及此开卷，恍然昔同。","谁居作者，造化论功。","淹总其裔，熙成是宗。","声闻九陛，既召而终。","谓彼树白，谶其身穷。","其然岂然，讯之天公。","此名穹壤，畴曰不逢。"],0,"x152","宋"],["淳熙二年发太上皇帝太上皇后册宝十一首 其六 太上皇帝升御坐用《干安》。降同。","郊庙朝会歌辞","四言",["天行惟健，天步惟安。","圣子中立，臣工四环。","民无能名，威不违颜。","宋德宜颂，汉仪可删。"],0,"x207","宋"],["明堂庆成颂  其二○","徐鹿卿","四言",["流民可绥，夷狄可灭。","天且弗违，人谁敢越。"],0,73,"宋"],["因香严和尚","释重显","四言",["我有一机，禅子须知。","烁迦罗眼，总是胶黐。","若人借问，伏惟伏惟。"],0,"x156","宋"],null,["汾阴十首 其十 酌献用《博安》。","郊庙朝会歌辞","四言",["至哉物祖，设象隆脽。","动静之德，翕辟攸宜。","嘉栗以荐，精祷洪厘。","茂宣阴贶，五谷蕃滋。"],0,"x207","宋"],["太学生徐公","《靖康小雅》作者","四言",["欃枪腾光，遂勃太阳。","六龙不翔，昧昧八荒。","公欲挟飞，再丽咸桑。","怒发烈烈，力镌暴羌。","白刃亘野，视犹猬芒。","凛凛之气，虽死不亡。"],0,91,"宋"],["崧高诗为九江赵使君寿  其一○","杨冠卿","四言",["其告维何，自今以始。","俾炽而昌，既多受祉。"],0,61,"宋"],["龙眠居士画十六大阿罗汉赞 其十三","李纲","四言",["俯身说法，未能忘言。","无量妙义，见于指端。","童子茗供，竹间治具。","涤烦消渴，惟此之故。"],0,"x136","宋"],["绍兴祈谷三首 其二 上帝位酌献用《嘉安》。","郊庙朝会歌辞","四言",["三阳肇新，万物资始。","精诚祈天，其听斯迩。","愿均雨旸，田畴之喜。","如坻如京，以备百礼。"],0,"x207","宋"],["题猿石手卷二首 其二","陆文圭","四言",["楚山无人，群戏树颠。","或据大石，如君长然。"],0,"x149","宋"],["正冬御殿上寿乐章八首 其三 赐群臣第一盏酒宫悬奏正安之曲","杨亿","四言",["思皇多士，靖恭著位。","鸣玉飞緌，锵锵济济。","宴有折俎，以示慈惠。","罔敢不祗，福禄来暨。"],0,"x47","宋"],["高宗祀明堂前朝享太庙二十一首 其二 升殿用《干安》。","郊庙朝会歌辞","四言",["肃哉清宫，𤈶珠照幄。","神之来思，八音振作。","赤舄龙章，奉玉惟恪。","匪今斯今，先民时若。"],0,"x207","宋"],["高宗郊前朝献景灵宫二十一首 其六 圣祖位奉玉币用《灵安》。","郊庙朝会歌辞","四言",["上灵始祖，云景元尊。","严祀夙展，六乐朱轩。","明玉之洁，丰帛之温。","畅乃继序，承德不愆。"],0,"x207","宋"],["陈忠肃书简帖赞","岳珂","四言",["士有直躬，夷险靡易。","事君以尧，距诐如墨。","笔力劲挺，德声昭植。","不倚不流，是谓心画。"],0,"x202","宋"],["刘忠定书简帖赞","岳珂","四言",["公心如铁，万仞壁立。","声名百年，翰墨十袭。","绝景独睨，奔尘莫及。","曰谁为之，目不妄入。"],0,"x202","宋"],["华之高寿鲁斋先生七十  其一二","金履祥","四言",["嵬嵬王子，我人所宗。","维北有斗，维岱在东。"],0,83,"宋"],["赠戴石玉","王炎午","四言",["琢之磨之，玉汝于成。","孰为玉工，师友父兄。","他山之石，今则在我。","彼璞之弃，我责之堕。","为瑚为琏，如圭如璋。","山泽之润，邦家之光。","玉不自毁，人自丧宝。","闻士称名，不离其道。"],0,67,"宋"],["景德祭社稷三首 其二 奠玉币、酌献用《嘉安》。","郊庙朝会歌辞","四言",["于穆大祀，功利相宣。","灵坛美报，历代昭然。","介以蕃祉，祚以丰年。","土爰稼穑，允协民天。"],0,"x207","宋"],["淳熙二年发太上皇帝太上皇后册宝十一首 其九 皇帝从太上皇后册宝诣宫中用《正安》。","郊庙朝会歌辞","四言",["丕显文王，之德之纯。","亦有太姒，式扬徽音。","维册维宝，乃玉乃金。","伊谁从之，一人事亲。"],0,"x207","宋"],["元符亲享明堂十一首 其十 彻豆用《歆安》。","郊庙朝会歌辞","四言",["穆穆在堂，肃肃在庭。","于显辟公，来相思成。","神既歆止，有闻无声。","锡我休嘉，燕及群生。"],0,"x207","宋"],["龙眠居士画十六大阿罗汉赞 其十六","李纲","四言",["岩谷窈窕，林芿扶疏。","瀑布淙射，蛇虫之居。","衲帔蒙头，安然入定。","孰能出之，其独也正。"],0,"x136","宋"],["布袋回头笑髑髅赞","释智愚","四言",["咄者髑髅，荒草堆头。","敛眉一笑，万壑云收。"],0,"x153","宋"],["偈颂六十五首 其三十七","释咸杰","四言",["呼猿洞口，虚空迸裂。","鸦飞不度，如行如说。"],0,92,"宋"],["寿马裕斋观文 山之高，三章，章四句。 其二","陈著","四言",["维石岩岩，维德之基。","天实为之，是以似之。"],0,"x92","宋"],["送汪宫教","徐积","四言",["尧亲其亲，教官得人。","所性忠厚，貌纯气真。","学为耕稼，经为本根。","实之为行，贲之为文。","辞令出口，法度在身。","大学小学，其谁弗循。","循之维何，维义是适。","不骄不肆，无邪无僻。","大者敬义，如汉元王。","小者乐善，如汉王苍。","乐善敬义，何有不臧。","保躬无悔，受福无疆。","无疆之福，维顺维忠。","维忠维顺，维师之功。"],0,"x123","宋"],["寿马裕斋观文 江之永，三章，章四句。 其三","陈著","四言",["清且沦漪，有美一人。","怀哉怀哉，率土之滨。"],0,"x92","宋"],["偈颂三十首 其十七","释慧晖","四言",["少室胡僧，履子留只。","米树应供，趺子出双。","新丰老人，问杀首座。","大阳兄者，兼养青鹞。"],0,194,"宋"],["华之高寿鲁斋先生七十  其八","金履祥","四言",["于时阿衡，一德之书。","于时尚父，犹蟠之居。"],0,83,"宋"],["闵雨诗 其二","刘敞","四言",["民生冥冥，靡究靡知。","其幸而吉，不幸而灾。","猖狂妄行，惟所遇之。"],0,"x51","宋"],["偈二十首 其十八","释鼎需","四言",["行罗汉慈，破结贼故。","行菩萨慈，安众生故。","行如来慈，续慧命故。"],0,10,"宋"],["夕月三首 其二 奠玉币、酌献用《嘉安》。","郊庙朝会歌辞","四言",["夕耀乘秋，功存宇县。","金奏在县，以时致荐。","祀事孔寅，明灵降眷。","洁粢丰盛，仓箱流衍。"],0,"x207","宋"],["华之高寿鲁斋先生七十  其一九","金履祥","四言",["吉甫作颂，其诗孔陋。","相彼兕觥，以介眉寿。"],0,83,"宋"],["华之高寿鲁斋先生七十  其一三","金履祥","四言",["亹亹王子，毋遏来学。","是洁是进，亦审亦度。"],0,83,"宋"],["祀先蚕六首 其四 酌献用《美安》。","郊庙朝会歌辞","四言",["盛服承祀，出自公桑。","衣不羽皮，利及万方。","百味旨酒，有𫗣其香。","神其歆止，洋洋在傍。"],0,"x207","宋"],["宁宗朝享三十五首 英宗室用《治隆》。","郊庙朝会歌辞","四言",["明明英后，仁孝俭恭。","丕显丕承，增光祖宗。","继志述事，遵制扬功。","万邦作孚，盛德形容。"],0,"x207","宋"],["偈颂三十六首 其二十四","释如珙","四言",["施供养者，受供养者。","俱无住著，获波罗蜜。"],0,255,"宋"],["高宗郊祀前朝享太庙三十首 其二十三 皇帝出小次用《干安》。","郊庙朝会歌辞","四言",["夙戒告备，礼节俯成。","妥侑惟干，氛氲夜澄。","有严有翼，列圣灵承。","于穆清閟，肃肃无声。"],0,"x207","宋"],["高沙曾良臣筑思堂以念亲傍辟书阁肖杨诚斋及予像求赞","周必大","四言",["德行渊骞，曾参曷遗。","盖生也后，其年可推。","遥遥华胄，古今与稽。","诚斋则贤，我愧思齐。"],0,"x76","宋"],["小师正恭写松源掩室并师山行图请赞 其二","释心月","四言",["清空片云，古潭万象。","飘然何来，湛然何往。","识则不识，知而无知。","铁壁银山，挨开者谁。"],0,188,"宋"],["景祐上辛祈谷二首 其二 酌献用《绍安》。","郊庙朝会歌辞","四言",["于穆神宗，惟皇永命。","荐醴六尊，声歌千咏。"],0,"x207","宋"],["次徐径坂四言韵 其二","赵汝腾","四言",["中庸致曲，学记琢玉。","子过仙柯，瞻彼淇绿。"],0,47,"宋"],["绣释迦像并十八罗汉赞 第三跋厘堕阇尊者","惠洪","四言",["神观静深，合爪钦视。","谁设华轮，前置净几。","髯王捧塔，自何而至。","中有全身，勿安舍利。"],0,"x42","宋"],["高宗郊前朝献景灵宫二十一首 其五 圣祖位用《干安》。","郊庙朝会歌辞","四言",["涓选休辰，有事嘉荐。","琅琅琼佩，陟降岩殿。","其陟伊何，币玉斯奠。","周旋中礼，千亿储羡。"],0,"x207","宋"],["祀先蚕六首 其六 送神用《祥安》。","郊庙朝会歌辞","四言",["神之来矣，灵风肃然。","云胡不留，归旐有翩。","乃举旧典，岁以告虔。","降福我邦，于万斯年。"],0,"x207","宋"],["乾道七年恭上太上皇帝太上皇后尊号十一首 皇帝从太上皇后册宝诣宫中用《正安》。","郊庙朝会歌辞","四言",["维册伊何，镂玉垂鸿。","维宝伊何，范金钮龙。","翊以𣊓御，间以笙镛。","谁敢不恭，天子寔从。"],0,"x207","宋"],["偈颂一百二十三首  其二九","释普度","四言",["圆同太虚，无欠无余。","良由取舍，所以不如。"],0,144,"宋"],["示赵与槟弘毅章","赵汝腾","四言",["天之苍苍，而在山中。","大畜之象，验之于躬。","六尺之微，万善毕丛。","往行前言，浩浩无穷。","一以贯之，何所不容。","两间非大，此之谓弘。","牝马之贞，行地无疆。","古往今来，其道有常。","是以资生，至哉化光。","君子体之，六二直方。","直内方外，何用不臧。","守此之毅，贲育非刚。","泗亭之参，以此任道。","繇轲而后，孰其深造。","濂洛儒先，知德之奥。","非苟知之，亦免允蹈。","兴夫请书，朝夕戴抱。","懋哉懋哉，至于华皓。"],0,47,"宋"],["熙宁皇太后册宝三首 其三 降坐用《干安》。","郊庙朝会歌辞","四言",["皇帝降席，流云四开。","尧趋舜步，下蹑天阶。","恭授宝册，翠旄裴回。","明明纯孝，鸿厘大来。"],0,"x207","宋"],["绣释迦像并十八罗汉赞 第十三因羯陀尊者","惠洪","四言",["情无住著，袒而凭几。","侍僧击磬，狻猊卧戏。","石屏倚天，下迸流水。","水声触眼，石光到耳。"],0,"x42","宋"],["景德朝日三首 降神用《高安》。六变。","郊庙朝会歌辞","四言",["阳德之母，羲御寅宾。","得天久照，首兹三辰。","正辞备物，肃肃振振。","沦精降监，克享明禋。"],0,"x207","宋"],["和李中甫知录采兰","释宝昙","四言",["翳翳林莽，孰艺其兰。","东风人群，俯仰棘间。","薜荔既艾，辛夷未繁。","寂寥前修，嘘唏孔颜。","藉尔芳芷，医余国膻。","我怀斯人，碧梧紫檀。","荏苒岁月，纷兮白颠。","十步闻芗，五步不悭。","佩帏幽幽，骐骥在闲。","未春叩户，苜蓿满盘。"],0,83,"宋"],["华之高寿鲁斋先生七十  其五","金履祥","四言",["有车班班，有来自东。","子曰予耄，落此新宫。"],0,83,"宋"],["绍兴二十八年祀圜丘 盥洗用《干安》。","郊庙朝会歌辞","四言",["帝顾明德，监于克诚。","齐戒涤濯，式示洁清。","郊丘合祛，享意必精。","既盥而荐，熙事备成。"],0,"x207","宋"],["颂古七首  其二","释祖璇","四言",["道吾作舞，一曲无谱。","若将耳闻，未敢相许。"],0,170,"宋"],["闵雨诗 其四","刘敞","四言",["伊年暮春，旱久不雨。","人曰时哉，历有常数。","禹汤之贤，莫能弗遇。"],0,"x51","宋"],["景德蜡祭百神三首 其一 降神用《高安》。","郊庙朝会歌辞","四言",["百物蕃阜，四方顺成。","通其八蜡，合乃嘉平。","旨酒斯醇，大庖孔盈。","万灵来格，威仪以成。"],0,"x207","宋"],null,["正月一日皇帝御大庆殿受文武百僚朝贺行上寿之仪乐章曲名 皇帝举第二盏酒奏寿星之曲","苏颂","四言",["倬彼见象，于昭于天。","维南有极，离丙之躔。","既明且大，应圣乘干。","诞受景福，亿万斯年。"],0,"x85","宋"],["宋初祀神州地祇三首 其二 奠玉币、酌献用《嘉安》。","郊庙朝会歌辞","四言",["肸蚃储灵，肃恭用币。","锵洋导和，洪休允契。","嘉气云蒸，浃于华裔。","式荐坤珍，聿符明世。"],0,"x207","宋"],["熙宁以后享庙五首 其二 送神用《兴安》。","郊庙朝会歌辞","四言",["钟鼓惟旅，笾豆孔时。","衎我祖宗，既右享之。","神亟来止，孝孙之喜。","神保聿归，孝孙之思。"],0,"x207","宋"],["赠衡阳簿林士恺","赵汝腾","四言",["吾党仲容，行修能通。","而志卓然，以慕直躬。","尝侪扣阍，力摧奸锋。","上旌其言，擢第南宫。","府庠诸生，坐斥匆匆。","君尽远诒，盍援掖逢。","予疏已先，所见略同。","每起敬爱，有烈士风。","予归里闬，时访藋蓬。","匪义不谈，惟理是穷。","告予戍及，栖枳湘中。","壮哉兹行，近紫盖峰。","刑使杰然，蜀彦之雄。","埋轮大勇，折槛精忠。","朝夕趋承，必得所从。","一被容接，终身登龙。","惟仕首辅，必廉必公。","惟学策要，必敬必恭。","胡张之乡，名理之宗。","公馀取友，以相磨砻。"],0,47,"宋"],["雨师五首 酌献，亚、终献用《雍安》。","郊庙朝会歌辞","四言",["寅恭我神，惟上之使。","俾成康年，民徯休祉。","折俎既登，𣂏酒既盈。","匪荐是专，配以明诚。"],0,"x207","宋"],["闵雨诗 其五","刘敞","四言",["帝独喟息，是岂足言。","化育万物，若镕以埏。","患在诚薄，不能动天。"],0,"x51","宋"],["上册宝十三首 亚、终献用《和安》。","郊庙朝会歌辞","四言",["望高六宫，位应四星。","辅佐君子，警戒相成。","袆衣褒崇，琛册追荣。","于以奠之，有椒其馨。"],0,"x207","宋"],["绍兴二十八年祀圜丘 还大次用《干安》。","郊庙朝会歌辞","四言",["舞具八佾，乐备六成。","大矣孝熙，厉意专精。","已事而竣，回轸还衡。","我应受之，以莫不增。"],0,"x207","宋"],["偈颂三十首 其十九","释慧晖","四言",["绿岩枯木，不落人间。","红谷芳草，不厌温寒。","西南东北，各不相关。","三段玄处，正开眼看。"],0,194,"宋"],["配食大成乐章 酌献郕国公","王应麟","四言",["心传忠恕，一以贯之。","爰述太学，万世训彝。","惠我光明，尊闻行知。","继圣迪后，是享是宜。"],0,45,"宋"],["绍兴以后时享二十五首 奉俎用《丰安》。","郊庙朝会歌辞","四言",["王假有庙，子孙保光。","奉牲以告，玉俎膏香。","专精厉意，神其迪尝。","休承灵意，申锡无疆。"],0,"x207","宋"],null,["绍兴祀高禖十首 青帝位酌献用《祐安》。伏羲、高辛酌献并同。","郊庙朝会歌辞","四言",["瑞鳦至止，祀事孔时。","酌以清酒，祼献载祗。","神具醉止，介我蕃禧。","乃占吉梦，维熊维罴。"],0,"x207","宋"],["翩翩春燕行","释文珦","四言",["翩翩春燕，厥有常心。","来以春阳，去以秋阴。","不爽于社，为时所钦。","玄衣济济，美度愔愔。","差池其羽，下上其音。","如服仁义，如鼓瑟琴。","缮垒杏梁，衔泥柳林。","宫房孔式，非僭非淫。","居处齐一，淑惠且任。","实生商后，匪曰凡禽。"],0,"x80","宋"],["建隆以来祀享太庙十六首 其十一 太祖室用《大定》。","郊庙朝会歌辞","四言",["猗欤太祖，受命于天。","化行区宇，功溢简编。","武威震耀，文德昭宣。","开基垂统，亿万斯年。"],0,"x207","宋"],["冬至孟春孟夏季秋四祀上公摄事七首 太尉行用《正安》。","郊庙朝会歌辞","四言",["礼经之重，祭典为宗。","上公摄事，登降弥恭。","庶品丰洁，令仪肃雍。","百神萃止，惟吉之从。"],0,"x207","宋"],["题陈和仲尊明亭","袁甫","四言",["非德不尊，非道不明。","爰取斯义，以名吾亭。","亭在山巅，气象巍然。","山从何来，蜿蜿蜒蜒。","我坐亭上，极目一望。","群峰毕朝，尊无与抗。","我抚亭下，万状难写。","一一分明，入我盏斝。","有时携筇，偕二三朋。","莫知我心，独抚孤松。"],0,229,"宋"],["明堂庆成颂  其一四","徐鹿卿","四言",["肸蚃潜通，受胙饮福。","移班紫宸，嵩呼三祝。"],0,73,"宋"],["魏京诗 其二十三","刘敞","四言",["河水东注，昭哉禹绩。","时万斯年，天子之德。"],0,"x51","宋"],["昔我往矣思君子也高阳之从事过瀛之野作河广诗而匿其名使者唐侯独见而知之故赋是诗","赵鼎臣","四言",["昔我往矣，作为此诗。","凡百君子，谅不我知。","惟彼硕人，眷眷怀顾。","彼何人斯，可与晤语。","召彼故老，周爰咨询。","予忖度之，所谓伊人。","实获我心，将恐将惧。","颜如渥丹，畏此谴怒。","维彼硕人，顾我则笑。","如切如磋，匪怒伊教。","自古在昔，哀鸣嗷嗷。","袖如充耳，莫我肯劳。","嗟我农夫，出自幽谷。","如蜩如螗，其何能淑。","维彼硕人，追琢其章。","欲报之德，不可弭忘。"],0,126,"宋"],["高宗郊祀前朝享太庙三十首 其十八 降殿用《干安》。","郊庙朝会歌辞","四言",["明德惟馨，进止回复。","裼袭安恭，严若惟谷。","诚意昭融，群工袂属。","成此祲容，生乎齐肃。"],0,"x207","宋"],["高宗郊祀前朝享太庙三十首 其二十九 降殿用《干安》。","郊庙朝会歌辞","四言",["于皇上天，钦哉成命。","集于冲人，丕承列圣。","爰熙紫坛，于庙告庆。","肸蚃潜通，休祥荐应。"],0,"x207","宋"],["明堂庆成颂  其一九","徐鹿卿","四言",["一念之善，神人具懽。","朝野传夸，中外镇安。"],0,73,"宋"],["华之高寿鲁斋先生七十  其三","金履祥","四言",["翼翼王子，教行于东。","思乐东州，舞雩之风。"],0,83,"宋"]]