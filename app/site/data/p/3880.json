[["采薇歌","伯夷","先秦",["登彼西山兮，采其薇矣。","以暴易暴兮，不知其非矣。","神农虞夏，忽焉没兮，吾适安归矣？","吁嗟徂兮，命之衰矣。"],{"ad":"先秦"},129,"先秦"],["荆轲歌","荆轲","先秦",["风萧萧兮易水寒。","壮士一去兮不复还。"],{"ad":"先秦"},77,"先秦"],["南海仙人祝辞","南海五仙人","先秦",["愿此阛阓，永无荒饥。"],{"ad":"先秦"},195,"先秦"],["白水诗","佚名","先秦",["浩浩白水。","倏倏之鱼。","君来召我。","我将安居。","国家未立。","从我焉如。"],{"ad":"先秦"},"x0","先秦"],["白水诗","佚名","先秦",["浩浩者水。","育育者鱼。","未有室家。","而召我安居。"],{"ad":"先秦"},"x0","先秦"],["《后汉书》引逸诗","佚名","先秦",["皎皎练丝。","在所染之。"],{"ad":"先秦"},"x0","先秦"],["佹诗","佚名","先秦",["天地易位。","四时易乡。","列星陨坠。","旦暮晦盲。","幽暗登昭。","日月下藏。","公正无私。","反见纵横。","志爱公利。","重楼疏堂。","无私罪人。","憼革二兵。","道德纯备。","谗口将将。","仁人绌约。","敖暴擅强。","天下幽险。","恐失世英。","龟龙为蝘蜓。","鸱枭为凤凰。","比干见刳。","孔子拘匡。","昭昭乎其知之明也。","郁郁乎其遇时之不祥也。","拂乎其欲礼义之大行也。","暗乎天下之晦盲也。","皓天不复。","忧无疆也。","千秋必反。","古之常也。","弟子勉学。","天不忘也。","圣人共手。","时几将矣。","念彼远方。","何其塞矣。","仁人绌约。","暴人衍矣。","忠臣危殆。","谗人般矣。","璇玉瑶珠。","不知佩也。","杂布与锦。","不知异也。","闾娵子奢。","莫之媒也。","嫫母力父。","是之喜也。","以盲为明。","以聋为聪。","以危为安。","以吉为凶。","呜呼上天。","曷维其同。"],{"ad":"先秦"},"x0","先秦"],["峤诗","佚名","先秦",["何自南极。","至于北极。","绝境越国。","弗愁道远。"],{"ad":"先秦"},"x0","先秦"],["《家语》引逸诗","佚名","先秦",["皇皇上天。","其命不忒。","天之以善。","必报其德。"],{"ad":"先秦"},"x0","先秦"],["大唐歌","佚名","先秦",["舟张辟雍，鸧鸧相从。","八风回回，凤皇喈喈。"],{"ad":"先秦"},"x0","先秦"],["子桑琴歌","佚名","先秦",["父邪母邪。","天乎人乎。"],{"ad":"先秦"},"x0","先秦"],["丰歌","佚名","先秦",["凤皇下丰。"],{"ad":"先秦"},"x0","先秦"],["五子歌","佚名","先秦",["皇祖有训。民可近。","不可下。民惟邦本。","本固邦宁。予视天下愚夫愚妇。","一能胜予。怨岂在明。","不见是图。予临兆民。","懔乎若朽索之驭六马。为人上者。","奈何不敬。训有之。","内作色荒。外作禽荒。","甘酒嗜音。峻宇雕墙。","有一于此。未或不亡。","惟彼陶唐。有此冀方。","今失厥道。乱其纪纲。","乃底灭亡。明明我祖。","万邦之君。有典有则。","贻厥子孙。关石和钧。","王府则有。荒坠厥绪。","覆宗绝祀。呜呼曷归。","予怀之悲。万姓仇予。","予将畴依。郁陶乎予心。","颜厚有忸怩。弗慎厥德。","虽悔可追。"],{"ad":"先秦"},"x0","先秦"],["《孔丛子》引遗谚","佚名","先秦",["尧舜千钟。","孔子百觚。","子路嗑嗑。","尚饮十榼。"],{"ad":"先秦"},"x0","先秦"],["长水童谣","佚名","先秦",["城门当有血。","城没陷为湖。"],{"ad":"先秦"},"x0","先秦"],["丘陵歌","佚名","先秦",["登彼丘陵。","峛崺其阪。","仁道在迩。","求之若远。","遂迷不复。","自婴屯蹇。","喟然回虑。","题彼泰山。","郁确其高。","梁甫回连。","枳棘充路。","陟之无缘。","将伐无柯。","患兹蔓延。","惟以永叹。","涕𫕥潺湲。"],{"ad":"先秦"},"x0","先秦"],["包山谣","佚名","先秦",["禹得金简玉字书。","藏洞庭包山湖。"],{"ad":"先秦"},"x0","先秦"],["去鲁歌","佚名","先秦",["彼妇之口。","可以出走。"