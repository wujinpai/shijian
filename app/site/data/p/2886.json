[["偈颂一百二十三首 其三十一","释崇岳","四言",["入门正路，不容回互。","千人万人，当阳蹉过。"],0,222,"宋"],["颂古三十三首 其三十一","释师观","四言",["牛过窗棂，错为安名。","大唐国里，不见一人。"],0,210,"宋"],["明日大夫  其三","曾丰","四言",["明日大夫，何日侯兮。","有白其苴，男爵优兮。","匪朝伊夕，九冕旒兮。","功崇业广，亘千秋兮。"],0,"x193","宋"],["偈二十二首 其十","释洵","四言",["掩室摩竭，正令已行。","杜口毗耶，全机脱略。","更来开口，犹欠三拳。","拟欲吞声，不消一镢。"],0,32,"宋"],["墨梅 其一","家铉翁","四言",["非香之香，非色之色。","伴我孤吟，风清月白。"],0,96,"宋"],["灯花","刘敞","四言",["火中有芝，殊干连叶。","顷刻三秀，烂其煜煜。","孰为而生，孰为而滋。","既富且寿，君子正之。"],0,"x51","宋"],["山之高三章  其二","张玉娘","四言",["采苦采苦，于山之南。","忡忡忧心，其何以堪。"],0,210,"宋"],["铅汞颂","周无所住","四言",["欲识铅汞，情性二物。","二物和合，还丹了毕。"],0,69,"宋"],["偈十九首 其六","释守卓","四言",["步步登高，从空放下。","南北东西，曾无缝罅。","教外别传，一切话霸。"],0,42,"宋"],["颂古十八首  其八","释宝印","四言",["山之峩峩，水之汤汤。","冷眼觑著，无处惭惶。"],0,106,"宋"],["淳熙三年发皇后册宝十三首 其三","郊庙朝会歌辞","四言",["刻简以珉，铸宝以金。","持节伊谁，时惟四邻。","自我文德，达之穆清。","委蛇委蛇，往迄于成。"],0,"x207","宋"],["淳熙十六年皇后册宝十三首 其十二","郊庙朝会歌辞","四言",["正位长秋，容典备矣。","王假有家，人伦至矣。","俪极伣天，多受祉矣。","蛰蛰螽斯，宜孙子矣。"],0,"x207","宋"],["高宗祀明堂前朝享太庙二十一首 其十三 神宗室用《大明》。","郊庙朝会歌辞","四言",["烝哉维后，继明体神。","宪章文武，宜民宜人。","经世之道，功格于天。","子孙严祀，无穷之传。"],0,"x207","宋"],["偈颂一百二十三首 其九十九","释崇岳","四言",["借手行拳，惊群动众。","龙门上客，未举先知。","若不然者，灵隐失利。"],0,222,"宋"],["宋江三十六赞 其四 大刀关胜","龚开","四言",["大刀关胜，岂云长孙。","云长义勇，汝其后昆。"],0,103,"宋"],["偈十九首 其七","释守卓","四言",["风非别凉，火是本热。","冷坐九年，元来未瞥。"],0,42,"宋"],["偈颂一百三十三首 其十三","释法薰","四言",["新年佛法，一切成现。","明去暗来，三头两面。","灵利衲僧，犹隔一线。","更问如何，脑后拔箭。"],0,31,"宋"],["淳熙三年发皇后册宝十三首 其四","郊庙朝会歌辞","四言",["册行何向，于门东偏。","礼备乐成，合扇鸣鞭。","皇举玉趾，如天之旋。","燕及家邦，亿万斯年。"],0,"x207","宋"],["德兴邑廨石刻 其一","佚名","四言",["仕宦之身，天涯海畔。","行商之身，南州北县。","不如田舍，长拘见面。","门无官府，身即强健。","麻麦遍地，猪羊满圈。","不知金贵，唯闻粟贱。","夏新绢衣，秋新米饭。","安稳眠睡，直千直万。"],0,"x115","宋"],["淳熙十六年皇后册宝十三首 其十一","郊庙朝会歌辞","四言",["鱼轩鼎来，象服是宜。","班于内庭，率礼惟祗。","化以妇道，时惟母仪。","是庆是类，于胥乐兮。"],0,"x207","宋"],["熙宁中朝会三首 其三 三举酒用《灵芝》。","郊庙朝会歌辞","四言",["皇仁溥博，品物蕃滋。","庆祥回复，秀发神芝。","灵华双举，连叶四施。","披图按牒，永享纯禧。"],0,"x207","宋"],["贪义吟","邵雍","四言",["贪人之恶，其过莫大。","贪人之善，是亦为罪。"],0,"x57","宋"],["淳熙三年发皇后册宝十三首 其五","郊庙朝会歌辞","四言",["椒涂兰驭，河润山容。","副笄在首，袆衣被躬。","静女其姝，实翼实从。","自彼西合，聿来殿中。"],0,"x207","宋"],["淳熙三年发皇后册宝十三首 其十一","郊庙朝会歌辞","四言",["硕人其颀，公侯之妻。","翟茀以朝，象服是宜。","如星之共，溯月之辉。","母仪既瞻，群心则夷。"],0,"x207","宋"],["淳熙三年发皇后册宝十三首 其十二","郊庙朝会歌辞","四言",["窈窕淑女，备六服兮。","陟降多仪，耸群目兮。","内治允备，阴教肃兮。","宜君宜王，绥有福兮。"],0,"x207","宋"],["皇雅十首  其一○","尹洙","四言",["蜀民呼歌，天子威灵。","保我者封，暴我者刑。","匪功是私，匪弱是陵。","天子惠民，畴敢不承。"],0,108,"宋"],["景祐祭文宣王庙六首 送神用《凝安》。","郊庙朝会歌辞","四言",["肃肃庠序，祀事惟明。","大哉宣父，将圣多能。","歆馨肸蚃，回驭凌兢。","祭容斯毕，百福是膺。"],0,"x207","宋"],["宋江三十六赞 其五 活阎罗阮小七","龚开","四言",["地下阎罗，追魂摄魄。","今其活矣，名喝太伯。"],0,103,"宋"],["淳熙三年发皇后册宝十三首 其七","郊庙朝会歌辞","四言",["规殿沉沉，叶气旼旼。","明章妇顺，表正人伦。","蹑是左墄，暨于中庭。","尚宫显相，罔有弗钦。"],0,"x207","宋"],["淳熙三年发皇后册宝十三首 其九","郊庙朝会歌辞","四言",["容典既膺，壶仪既正。","羽卫外列，扬颜中映。","如帝如天，以庄以靓。","六宫承式，二南流咏。"],0,"x207","宋"],["淳熙三年发皇后册宝十三首 其六","郊庙朝会歌辞","四言",["德隆位尊，礼厚文缛。","乃篆斯金，乃镂斯玉。","群公盈门，执事有肃。","愿言保之，永镇坤轴。"],0,"x207","宋"],["米元章临王献之东问帖赞","岳珂","四言",["字有十五，如月当户。","腾辉以望，靡忒今古。","匪献莫具，匪芾莫祖。","谁其修之，有玉其斧。"],0,"x202","宋"],["偈颂一百六十九首 其三十三","释智朋","四言",["心月孤圆，光吞万像，起模画样。","光非照境，境亦非存，收拾不上，光境俱亡。"],0,18,"宋"],["偈颂七十二首 其十七","释祖钦","四言",["发越朕兆，未形消息。","提持佛祖，未行号令。","虚空斫额，万象拱听。"],0,64,"宋"],["临碣石 其三","曹勋","四言",["陟彼崇高，慨览遐宇。","前迹可究，兴亡可悟。","安得英雄，廓彼神武。","泽及飞沉，致馨梁甫。"],0,"x103","宋"],["德兴邑廨石刻 其二","佚名","四言",["我田我地，我桑我梓。","只知百里，不知千里。","我饥有粮，我渴有水。","百里之官，得人生死。","孤儿寡妇，一张白纸。","入著县门，冤者有理。","上官不嗔，民即欢欣。","上官不富，民免辛苦。","生我父母，养我明府。","苗稼萋萋，曷东曷西。","父母之乡，天子马蹄。"],0,"x115","宋"],["夕月三首 其一 降神用《高安》。六变。","郊庙朝会歌辞","四言",["凝阴禀粹，照临八埏。","丽天垂象，继日代明。","一气资始，四时运行。","灵祇昭格，备物荐诚。"],0,"x207","宋"],["颂古三十一首 其三十一","释安永","四言",["击碎髑髅，敲出骨节。","明眼人前，自彰丑拙。"],0,145,"宋"],["元符祭神州地祇二首 其一 迎神用《宁安》。八变。","郊庙朝会歌辞","四言",["膴膴浚邦，皇天是宅。","必有幽赞，聪明正直。","布列笾豆，考击金石。","中外谧宁，繄神之力。"],0,"x207","宋"],["题雪溪图四言","周密","四言",["宇宙无声，天地一色。","扁舟何人，去来无迹。","言虽不传，意自有得。","千古真清，万里虚白。"],0,"x75","宋"],["四偈 随缘行","惠洪","四言",["此生梦幻，缘业所转。","随其所遭，敢择贵贱。","眠食既足，馀复何羡。","缘尽则行，无可顾恋。"],0,"x42","宋"],["配食大成乐章 酌献沂国公","王应麟","四言",["公传自曾，孟传自公。","有的绪承，允得其宗。","提纲开缊，乃作中庸。","侑于元圣，亿载是崇。"],0,45,"宋"],["题棺木","王文卿","四言",["我身是假，松板非真。","牢笼俗眼，跳出红尘。"],0,79,"宋"],["有触者犊","苏洵","四言",["有触者犊，再箠不却。","为子已触，安所置角。","天实畀我，子欲已我。","恶我所为，盍夺我有。","子欲不触，盍索之笠。"],0,70,"宋"],["赞护教 其三 南岳靖王","释印肃","四言",["以南权正，无心应物。","威德标宗，不可轻忽。"],0,"x121","宋"],["庆元二年皇后册宝十三首 其六","郊庙朝会歌辞","四言",["袆帟流光，沙祥增衍。","编玉镂德，螭金溢篆。","粹猷藻黻，徽文华显。","二南声诗，于时昭阐。"],0,"x207","宋"],["圣号雅二篇 其三","赵湘","四言",["皇实法之，配道无作。","始则以宽，终靡庸度。","呜呼下民，亦孔之莫。","皇鉴下土，将安将乐。","皇视四方，匪丑匪恶。","法尔天永，民祷斯恪。"],0,126,"宋"],["芋庵宗慧禅师真赞","陆游","四言",["煨懒残芋，打涂毒鼓。","舌本雷霆，毫端风雨。"],0,"x41","宋"],["寄君时一章章四句二章章三句二章章五句  其一","彭汝砺","四言",["我治斯何，曰治吾身。","我事斯何，曰事吾亲。"],0,"x143","宋"],["偈六十三首 其三十七","释道宁","四言",["应机不妙，展事难谐。","检点将来，弄巧成拙。"],0,119,"宋"],["潭州新学诗","王安石","四言",["有嘉新学，潭守所作。","守者谁欤，仲庶氏吴。","振养矜寡，衣之褰襦。","黔首鼓歌，吏静不求。","乃相庙序，生师所庐。","上漏旁穿，燥湿不除。","曰嘻迁哉，迫阨卑污。","当其坏时，适可以谋。","营地虑工，伐楩楠槠。","撤故就新，为此渠渠。","潭人来止，相语而喜。","我知视成，无豫经始。","公升在堂，从者如水。","公曰诲汝，潭之士子。","古之读书，凡以为己。","躬行孝悌，由义而仕。","神听汝助，况于闾里。","无实而荂，非圣自是。","虽大得意，吾犹汝耻。","士下其手，公言无尤。","请诗我歌，以远公休。"],0,"x48","宋"],["颂古一百二十一首 其五十五","释宗杲","四言",["好个话端，阿谁解举。","举得十分，未敢相许。"],0,"x112","宋"],["幽明吟","邵雍","四言",["明有日月，幽有鬼神。","日月照物，鬼神依人。","明由物显，幽由人陈。","人物不作，幽明何分。"],0,"x57","宋"],["颂古五十三首 其四十五","释文礼","四言",["有句无句，如藤倚树。","回避无门，毒蛇当路。","树倒藤枯，句归何处。","明眼衲僧，一场罔措。"],0,108,"宋"],["庆元二年皇后册宝十三首 其一","郊庙朝会歌辞","四言",["干健坤顺，群生首资。","日常月升，四时叶熙。","帝嗣天历，后崇母仪。","黼黻承晖，王化是基。"],0,"x207","宋"],["绍兴以后祀感生帝十六首 感生帝位酌献用《崇安》。","郊庙朝会歌辞","四言",["盛德在火，相我炎祚。","典祀有常，牲玉维具。","风马云车，翩翩来顾。","式蕃帝祉，后昆有裕。"],0,"x207","宋"],["偈颂二十五首 其四","释如净","四言",["炉炭为床，镬汤为座。","口吐黑烟，弥天罪过。"],0,105,"宋"],["绍兴亲享明堂二十六首 其八 太宗位奠币用《化安》。","郊庙朝会歌辞","四言",["帝神来格，靡祀不从。","侑坐而食，独升祖宗。","在庭祗肃，展采错重。","三献之礼，百年之容。"],0,"x207","宋"],["第十五祖真赞","惠洪","四言",["石彪肉醉，木驹夜嘶。","我此三昧，非识情知。","应缘而现，不落思惟。","是故钵水，以针投之。","如仲尼韶，如子期琴。","又如萧何，而识淮阴。","无言可寄，无迹可寻。","粲然现前，传之以心。","穴像之目，我岂慢神。","指树之耳，我知其因。","物我如是，所立皆真。","随其妙用，见我全身。","稽首真慈，为僧中王。","如万星月，见者清凉。","尚以众生，不信为伤。","盖盲者咎，非光掩藏。"],0,"x42","宋"],["和陶停云四首，并引 其四","苏轼","四言",["对弈未终，摧然斧柯。","再游兰亭，默数永和。","梦幻去来，谁少谁多。","弹指太息，浮云几何。"],0,"x67","宋"],["绍兴十三年发皇后册宝十三首 其三","郊庙朝会歌辞","四言",["穆穆睟容，如天之临。","赫赫明命，如玉之音。","虔恭出门，礼容兢兢。","涂山生启，夏道以兴。"],0,"x207","宋"],["上广东漕使黄郎中  其一","曾丰","四言",["维春泄泄，维阳之气，维和之至。"],0,"x193","宋"],["思惟相观音赞 其二","释心月","四言",["燕语莺吟，鸦鸣鹊噪。","声有差殊，闻无颠倒。","闻性既寂，声尘亦空。","一点悲心，在处圆通。"],0,188,"宋"],["正性吟","邵雍","四言",["未生之前，不知其然。","既生之后，乃知有天。","有天而来，止物之性。","君子践形，小人轻命。"],0,"x57","宋"],["偈颂六十首 其十","释昙华","四言",["少室峰前，漆桶话堕。","曹溪路上，赚杀阇梨。"],0,47,"宋"],["文宣王及其弟子赞 其三十七","赵构","四言",["彼美邽子，先圣是承。","墙仞已及，堂陛将升。","良玉斯琢，寒水必冰。","锡壤平陆，茂实骞腾。"],0,249,"宋"],["崔伯易画像赞","陆游","四言",["古之君子，学以为己。","可行则行，可止则止。","仕以行义，止以远耻。","世衰道微，岂复知此。","蚩蚩始学，青紫思拾。","万马并驰，孰能独立。","始虽弗急，后亦汲汲。","我思崔公，涕泗横集。"],0,"x41","宋"],["大中祥符五岳加帝号祭告八首 其五 西岳。","郊庙朝会歌辞","四言",["瞻言太华，奠方作镇。","典册是膺，等威以峻。","上公奉仪，祀宗荐信。","介祉万邦，永配坤顺。"],0,"x207","宋"],["为救一后生作","释道济","四言",["后生后生，忽犯天嗔。","前生恶业，今生缥身。","老僧救汝，归奉母亲。","诸恶莫作，免得祸临。"],0,220,"宋"],["绍兴亲享明堂二十六首 其四 盥洗用《仪安》。","郊庙朝会歌辞","四言",["肇开九筵，维古之仿。","皇皇大神，来顾来享。","庶仪交修，百辟显相。","微诚自中，交际天壤。"],0,"x207","宋"],["文宣王及其弟子赞 其五十六","赵构","四言",["手足甚亲，志异出处。","魋将为乱，子乃脱去。","在污能絜，危而有虑。","内省若斯，何忧何惧。"],0,249,"宋"],["偈颂一百零九首 其十九","释可湘","四言",["门外门内，一时分付。","若是俊流，何必重举。"],0,158,"宋"],["亲祀南郊诗","蔡襄","四言",["天畀元统，赤运开祉。","圣祖神宗，海域平砥。","思皇真考，岳封汾祀。","饵系戎胡，包束戈矢。","丕显灵德，光被万里。","民寿而康，恩及萧苇。","恭惟皇帝，继文之始。","兢兢日慎，夙夜勤只。","哀怜困穷，有如在己。","惟刑是恤，弗繇怒喜。","躬服俭约，黜弃浮侈。","罔有逸欲，日惟三纪。","大中则经，兴亡则史。","阴阳时序，日纬躔轨。","乐律本原，礼法根柢。","兵韬术数，万微精旨。","该通变贯，咸烛厥理。","岁舍壬午，盗发南鄙。","帝曰汝青，治办行李。","毋大诛割，定患则已。","猎猎灵旗，启道径指。","凶渠踣仆，俘徒授耳。","岭服既平，勋赏周被。","封殁录孥，门户晔炜。","粤兹明年，农家丰美。","廛庐积腐，庾漕储峙。","帝咨相臣，匪台德尔。","穹昊眷赉，祖考佑俾。","何施不报，将祀郊畤。","号令四下，若建瓴水。","荒服述职，奔走输委。","仲冬丙寅，斋寝以俟。","先时霾晦，飙籁号起。","真意益庄，降鉴伊迩。","夜漏适中，星露云靡。","大辂既驭，清阳出晷。","休光无垠，令容有伟。","爰翊殊庭，奠享仙机。","高灵委蛇，元气旭卉。","阴施自远，大功续似。","拥格纯禧，益厚丕址。","入宿庙下，月魄初朏。","龙章采藻，瓒爵擎跪。","拜于祢宫，慈颜仅咫。","至诚馨香，甘荐涤瀡。","哀念劬劳，譬瞻岵屺。","濯泪沾圭，将逡复止。","京都之南，崇丘迤逦。","飞螭蹑尘，法乘徐柅。","地环帟幄，霄揭隅雉。","警角飘萧，彀骑连累。","言降言陟，实惟告已。","烛错宵明，坛圪空紫。","交佩陆离，庶旄飒𫄥。","乐变神格，列周甲癸。","三后咸在，上苍临视。","皇皇富媪，从执笾簋。","七精闪忽，五镇瑰玮。","星官下翔，涛祗腾跱。","等级卑高，食饮嘘哆。","欣歆告言，奏福来底。","更御步辇，夹途军垒。","钲鼓惊轰，跳呼牛鬼。","异域穷陬，黄发稚齿。","动荡成波，欢喧成市。","端闱停午，玉色尚扆。","赦泽春行，幽加蛰蚁。","废滞振拔，垢瑕刷洗。","宽贷赋取，削减逋诡。","皇帝慈孝，下民胥拟。","皇帝恩仁，四国倾倚。","皇帝曰咨，群公卿士。","舜隆联夔，商圮朋嚭。","孰忠予是，孰谗予匪。","入官多门，孰予窒弭。","蓄兵过制，孰予究揣。","百姓窘穷，其患孰弛。","外夷狃骄，其强孰箠。","驱人以法，曾莫如耻。","化民成俗，曾莫如礼。","百官敕业，相予表里。","登任俊良，刬斥奸宄。","天锡帝年，万有亿秭。","天锡圣嗣，诜诜众子。","干刚不息，章明度揆。","无疆惟民，惟帝其侍。","臣襄咏歌，直道是履。"],0,"x158","宋"],["畴依  其一九","王柏","四言",["恭惟道统，一绝千载。","何绝之久，何续之易。","师友之盛，东南洋洋。","曰尹曰谢，曰游曰杨。"],0,"x137","宋"],["大中祥符五岳加帝号祭告八首 其四 南岳。","郊庙朝会歌辞","四言",["作镇炎夏，畜兹灵光。","敷与万物，既阜既昌。","爰刻温玉，式荐徽章。","昭嘏神意，福熙穰穰。"],0,"x207","宋"],["章献明肃皇太后恭谢太庙 其一","郊庙朝会歌辞","四言",["于穆宋庙，肇允基扃。","文母来献，国祚咸宁。","永言昭格，式荐惟馨。","亦既降止，聿柄神灵。"],0,"x207","宋"],["章献明肃皇太后恭谢太庙 其二","郊庙朝会歌辞","四言",["九奏允谐，皇灵来暨。","备物芬馨，昭违精意。","升降有仪，群臣序位。","享于克诚，万福攸至。"],0,"x207","宋"],["章献明肃皇太后恭谢太庙 其五","郊庙朝会歌辞","四言",["太宫尔肃，烈祖巍巍。","上炳淳耀，下流德晖。","诒谋燕翼，奄宅邦畿。","子孙千亿，历数同归。"],0,"x207","宋"],["章献明肃皇太后恭谢太庙 其十","郊庙朝会歌辞","四言",["赫赫皇祖，万邦之君。","功崇偃革，德盛兴文。","圣谟宏达，至教氤氲。","子孙百世，祗荐苾芬。"],0,"x207","宋"],["执剑吕洞宾赞","释慧开","四言",["露刃单提，行杀活令。","斩贪嗔痴，群魔乞命。","夫是之谓，纯阳真人。","激浊扬清，摧邪显正。"],0,65,"宋"],["谢秀才晦庵","徐积","四言",["山有武夷，水有建溪。","有猿有鹤，有庵可栖。","有庵可栖，云乎不归。"],0,"x123","宋"],["谢世颂三首 其二","吴潜","四言",["大带深衣，缁冠素履。","籍以纸衾，覆以布被。","一物不将，敛形而已。","其人伊何，履斋居士。"],0,"x177","宋"],["高宗郊祀前朝享太庙三十首 其三十 还大次用《干安》。","郊庙朝会歌辞","四言",["盛德丰功，一祖六宗。","钦翼燕诒，禋享是崇。","厉意齐精，假庙惟恭。","率礼周旋，福禄来同。"],0,"x207","宋"],["哲宗发皇后册宝三首 其三","郊庙朝会歌辞","四言",["宣哲维公，就位肃庄。","册宝具举，丕显其光。","出于宸闱，鼓钟喤喤。","母仪天下，万寿无疆。"],0,"x207","宋"],["颂古五首 其二","释文准","四言",["我手佛手，十八十九。","云散月明，痴人夜走。"],0,254,"宋"],["偈二十七首 其十八","释绍隆","四言",["物宜求新，人宜求旧。","不起于座，现诸威仪。"],0,252,"宋"],["绍兴以后祀五方帝六十首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["贰觞具举，承神嘉虞。","神具醉止，眷焉此都。","我岁方新，我亩伊殖。","时旸时雨，繄神之力。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["盥爵奠斝，载虔载恭。","笾豆静嘉，于乐鼓钟。","礼备三献，神具醉止。","孰显神德，扬光纷委。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["羽觞更陈，厥味清凉。","饮之不烦，又有蔗浆。","夜未艾止，明星浮浮。","愿言妥灵，灵兮淹留。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["肃成万物，泬寥其秋。","惟兹祀事，戾止灵斿。","酌献具举，典礼是求。","冀福斯民，黍稷盈畴。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["万汇揫敛，时惟冬序。","蠢尔黎氓，入此室处。","酌献告神，礼以时举。","赖此阴骘，民有所怙。"],0,"x207","宋"],["章献明肃皇太后恭谢太庙 其七","郊庙朝会歌辞","四言",["奕奕清庙，巍巍帝基。","诒谋积德，累洽熏熙。","粢盛丰洁，礼容肃祗。","俯歆明荐，永锡蕃禧。"],0,"x207","宋"],["偈颂一百四十一首 其一二三","释师范","四言",["浅闻深悟，深闻不悟。","迷逢达磨，赵婆呷醋。"],0,"x155","宋"],["治乱吟","邵雍","四言",["财利为先，笔舌用事。","饥馑相仍，盗贼蜂起。","孝悌为先，日月长久。","时和岁丰，延年益寿。"],0,"x57","宋"],["皇雅十首  其二","尹洙","四言",["自昔外禅，曰经曰营。","令以挟制，政以阴倾。","帝初治兵，志勤于征。","奄受神器，匪谋而成。"],0,108,"宋"],["章献明肃皇太后恭谢太庙 其十三","郊庙朝会歌辞","四言",["籥翟既备，干戚是陈。","德业昭著，用和神人。"],0,"x207","宋"],["补乐府十篇 其九 夏后氏之乐歌","曹勋","四言",["于皇上圣，临御有赫。","洪流汤汤，弗降弗辟。","命于帝庭，纂服是膺。","随山浚川，海宇攸宁。","五服既宅，贡有常职。","恩覃遐荒，惟帝之力。","元圭告功，敢不承式。","地平天成，垂休罔极。"],0,"x103","宋"],["文宣王及其弟子赞 其三十四","赵构","四言",["贤行颜叔，亲承尼父。","志锐所期，道尊是辅。","泥在钧陶，木就规矩。","终縻好爵，扬名东武。"],0,249,"宋"],["景祐大享明堂二首 其一 真宗配位奠币用《诚安》。","郊庙朝会歌辞","四言",["思文圣考，对越在天。","侑神作主，奉币申虔。"],0,"x207","宋"],["清凉大法眼禅师真赞","惠洪","四言",["非风幡动，非风铃语。","见闻起灭，了无处所。","何以明之，俱寂静故。","此光明藏，平等显露。","由本无明，爱欲悭妒。","如隔日疟，痛自遮护。","有能了者，即同本悟。","索尔虚闲，随缘静住。","一切仍旧，自无染污。","为物作则，崄崖之句。","不可犯干，如大火聚。"],0,"x42","宋"]]