[["公无渡河三首 其二","胡应麟","四言",["公无渡河，一苇奈何。","河水万丈，出没蛟鼍。"],0,"x278","明"],["公无渡河三首 其三","胡应麟","四言",["公无渡河，谗言孔多。","不见申屠，负石投河。"],0,"x278","明"],["短歌行","胡应麟","四言",["日吉时良，嘉宾满堂。","星河在天，蟋蟀在房。","欢娱易终，白发苦蚤。","金罍玉尊，长夜倾倒。","舞袖纷纭，兰膏载焚。","卫女齐姜，左右如云。","有美一人，稚齿倩盼。","携手同车，光华粲粲。","翩若游龙，遨嬉八埏。","荡意平心，永宅大年。"],0,"x278","明"],["善哉行","胡应麟","四言",["来日大难，肠干体疲。","今日不乐，岁月如驰。","访我亲知，总角燕好。","逾陌度阡，以赠芳草。","何以延宾，清酒百壶。","何以销忧，五木摴蒱。","美人满堂，巧笑便辟。","更长烛明，今夕何夕。","南箕在楹，北斗在檐。","星河陆离，肴醴泛澜。","忽逢安期，馈我灵药。","主客再拜，洗盏酬酢。","共饵大还，身轻翼舒。","乘云御龙，游戏六虚。"],0,"x278","明"],["安东平 其一","胡应麟","四言",["严冬凛烈，北风雨霜。","河大水冰，断绝车航。"],0,"x278","明"],["安东平 其二","胡应麟","四言",["客子远游，夐夐秦越。","囊无赀粮，带断裘结。"],0,"x278","明"],["安东平 其三","胡应麟","四言",["我有绨袍，以遗故人。","物薄意厚，贵称君身。"],0,"x278","明"],["安东平 其四","胡应麟","四言",["微物在机，是侬手织。","千缕一丈，三丈一袭。"],0,"x278","明"],["安东平 其五","胡应麟","四言",["东平刘生，远持遗郎。","愿得邀郎，早还故乡。"],0,"x278","明"],["白石郎","胡应麟","四言",["侬居清溪，郎居白石。","途中相遇，宛若旧识。"],0,"x278","明"],["短歌行","欧大任","四言",["乐乐自生，人穷反本。","生世几何，倏忽已晚。","去者日疏，来者日亲。","水流同源，木生同根。","父母兄弟，岂伊异人。","况有旨酒，云胡弗欢。","白日冉冉，明膏继夕。","调轸鼓丝，乐我亲戚。","春有催耕，秋有促织。","岁事方勤，及此游息。","今日同堂，明日异乡。","听我短歌，心如之何。"],0,"x279","明"],["独漉篇","欧大任","四言",["独漉独漉，摩肩击毂。","但欲去速，不忧车覆。","有狐绥绥，阪田之垂。","我欲疾驱，手无戈殳。","煌煌黼裳，翩翩四牡。","出入道途，称者盈口。","敝裘毁车，谁知贤愚。","珠玉在途，瓦砾何殊。","原也悬鹑，于彼蓬蒿。","端木驷马，举世贤豪。","嗟念古人，竭力躬耕。","一日及养，三公匪荣。","富不可求，荣不可冒。","我岂不闻，我不敢告。","富而可求，智者媚灶。","从吾所好，卿勿复道。"],0,"x279","明"],["辟廱","程敏政","四言",["有严辟廱，四方之则。","孰其师之，一人孔硕。","眷此硕人，明德是崇。","穆其家风，自清惠公。","侍禁有声，出教国子。","横金服绯，再命伊始。","戟门夜启，舍菜于庭。","硕人顾瞻，是仪是刑。","朝鼓镗镗，硕人升坐。","诸生执经，或右或左。","相帝之治，爰藉群才。","迟此硕人，乐哉斯培。","材成孔多，功亦云懋。","耆俊之求，入副元后。","允兹明良，庶事攸康。","蔚有耿光，吾道之昌。"],0,"x280","明"],["双瑞","程敏政","四言",["义兴之郊，有山隆隆。","孰窆其亲，有孝徐公。","有庐萧萧，倚山之麓。","徐公是居，哀慕孔笃。","爰有鸠二，来巢于梁。","其色缟缟，如君子裳。","雁雁于飞，日泳于渚。","濯濯其仪，扰而不去。","观者动色，异口同词。","有瑞徐公，维天锡之。","一锡不已，乃至于再。","发彼庆源，如水斯溉。","济济徐公，改服来朝。","贰命秩宗，维庆之昭。","允显其身，亦显其子。","奕世光荣，维庆之似。","维孝锡类，庆与之俱。","孰瑞之诬，而大其闾。","庆也无涯，勖哉令德。","匪瑞之夸，繄孝之式。"],0,"x280","明"],["思亲堂","程敏政","四言",["有堂渠渠，有客佖佖。","言思其亲，日甚一日。","堂上有山，堂下有江。","伊亲之思，江山靡长。","赫赫宫保，维客之季。","煌煌命书，屡贲于隧。","客拜稽首，家庆孔延。","维菽与水，下不及泉。","乃作斯堂，奉妣暨考。","若著若存，于以终老。","繄罔极兮，孰逃亲仁。","越终慕兮，孰非子身。","客哉孝思，亦既耄矣。","德既邵矣，式克肖矣。","孝思维则，世征于堂。","爰锡厥类，斯堂之光。"],0,"x280","明"],["寿鞠","程敏政","四言",["有寿者鞠，其色孔黄。","月日维九，荐此令芳。","有寿者鞠，其味孔甘。","和以醇酒，礼庭燕酣。","诞是花辰，维泌焦父。","异世同生，曾大二祖。","维泌焦父，子为从臣。","有来恩纶，及是花辰。","永言礼庭，鞠本坚好。","载植载培，对尔寿考。","永言礼庭，鞠蘤滋蕃。","积庆开先，宜尔孙玄。"],0,"x280","明"],["言志赠友人","刘崧","四言",["深山邃谷，虎豹所凭。","玄雾翳云，蛟龙斯升。","芸芸暮蜉，缉缉秋蝇。","嘅彼下士，志何由兴。","岁年云徂，冰雪侵凌。","眷彼皓首，含涕抚膺。","契予夙好，嘉尔友朋。","亦有旨酒，如溜如渑。","可以乐衎，高融咸登。","仰睇白日，翩其相仍。","道谊罔敦，忧患式增。","不曰尼父，饮水曲肱。","媚货附桓，圣人不能。","我行东原，以陟崚嶒。","言采荣木，手挽其藤。","素秋以风，霜露乃凝。","黄鹄斯举，天高气澄。","送子于迈，服子徽称。","理棹河湄，赪霞晨蒸。","何以益我，敦教而承。","友道之薄，噫其春冰。","尔弘其居，夕惕兢兢。","人亦有言，谷增而陵。","圣途云遐，气力曷胜。","勖尔踯躅，暨于𬸣腾。"],0,"x31","明"],["题唐子华江居平远图","刘崧","四言",["宛其长洲，在彼中流。","上列灌木，旁引高丘。","彼君子居，于林之右。","言敞东轩，缅觌平岫。","盘石在渚，丛荫在门。","有风夏凉，维日冬温。","岂无方舟，可以游钓。","言曳其杖，于焉遐眺。","油油行云，靡靡逝波。","岁既晏矣，云如之何。","鸟鸣于谷，鱼丽于罶。","君子之居，君子之友。"],0,"x31","明"],["题宁都州学图","刘崧","四言",["出自西门，至于泮宫。","我游伊何，以观民风。","乃觏新殿，翼翼崇崇。","伊谁修之，维郑之功。","郑其戾止，弁巾俅俅。","爰率童冠，以咏以游。","属兹暮春，言眺中州。","慷当以歌，企彼前修。","何以乐此，薄写我心。","濯缨于泉，援琴于林。","求我良友，言陟云岑。","苒苒云木，交交鸣禽。","山则有石，川则有波。","君子维教，乃切乃磋。","翩其白驹，越于涧阿。","逝将去此，忧如之何。","日月于迈，山川逶迤。","怀君之来，方何为期。","爰绘于图，亦颂以诗。","归言观之，式慰尔思。"],0,"x31","明"],["题兰 其一","刘崧","四言",["山则有石，谷则有兰。","我思美人，兹之永叹。"],0,"x31","明"],["题兰 其二","刘崧","四言",["奕奕翠羽，翘翘紫蕤。","何以求之，山阿水涯。"],0,"x31","明"],["题兰 其三","刘崧","四言",["回风猗猗，白石皓皓。","山中无人，念此芳草。"],0,"x31","明"],["题兰 其四","刘崧","四言",["深林之幽，式闻其香。","安得佩之，蓉裾芰裳。"],0,"x31","明"],["尚友斋为旷伯逵赋","刘崧","四言",["繄予之生，乃后古人。","岂不尚友，远而莫因。","譬彼方夜，思见出日。","狂走大呼，秪益其疾。","及求吾心，夫岂远而。","昼读其书，夜梦见之。","我疑其生，世谓其死。","不曰斯今，亦有君子。","有鸟有鸟，鸣于高林。","彼君子兮，怀之好音。","视彼日月，滔滔其迈。","人而离居，曷云不戒。","闻子今日，涉江远来。","何以来思，赠之琼瑰。","穆穆其风，菀菀者柳。","何以永日，且以酌酒。","泛泛中流，招之以舟。","一日不见，余心则忧。","居则同襺，出则更屧。","云胡拒之，彼则有挟。","我友旷逵，友道则隆。","维彼所尚，实获我同。","蓬依于麻，禾乱于莠。","嗟尔君子，式尚尔友。"],0,"x31","明"],["题画鱼四章","刘崧","四言",["我观于河，其鱼维鲭。","岂有泼泼，而困于笭。","我观于河，其鱼维鲌。","水深月寒，闻其瀺泎。","我观于河，其鱼维鳜。","群鲜则微，孰饮尔噬。","我观于河，其鱼维鲤。","雷雨斯作，一举万里。"],0,"x31","明"],["题九鸶图","刘崧","四言",["振振者鹭，在渚之薮。","我仪图之，其丽维九。","顾盼和鸣，八跱一飞。","昂首跂足，觊其具依。","彼飞而旋，亦念群处。","清风载飏，濯濯其羽。","乃㒽渚曲，维石巉㟽。","上延松梅，下翳丛筱。","爰得其所，游咏一方。","或群而飞，盖未可量。","嘉尔君子，洁白无二。","可仪于朝，亦簉于位。","嗟嗟百鸷，不如一鹗。","式咏振振，以继舞籥。"],0,"x31","明"],["南门司柝诗赠玉珊克温","刘崧","四言",["鸣柝何所，南门之下。","孰其司之，肃肃有仪。","出日自东，我柝既闲。","行道憧憧，我辟我关。","日之既夕，行道涤涤。","我时其闭，我柝载击。","柝声扬扬，万夫之防。","一息弗戒，予职之荒。","相彼高车，其禄有馀。","虑殚力劬，忧患是居。","我司我柝，是力是度。","贫卑之居，君子之乐。","古之抱关，亦有晨门。","勿果忘哉，敬尔司存。"],0,"x31","明"],["观澜","刘崧","四言",["子曷观乎，维水有澜。","其澜伊何，厥观实难。","我观河江，其量弗殚。","积石岷峨，本钜力完。","万折千支，潗湁弥漫。","激为大波，溁为文湍。","其来无穷，其回无端。","既来既回，齐并汨攒。","如车之旋，如风之抟。","浩乎沛而，莫之或干。","相彼断港，潢污所敦。","漂浮几何，忽焉中干。","有斐汤君，维学是安。","作亭浠厓，物无遁观。","临渊者危，望洋者叹。","卓彼孟轲，是仰是钻。","我诗于楹，永以弗刊。"],0,"x31","明"],["墨龙赞为萧时卿赋","刘崧","四言",["跃于墨池，见其鬣鬐。","雷动云从，而时雨之。"],0,"x31","明"],["比丘观音赞","刘崧","四言",["补陀如如，人天具瞻。","现真实相，不假庄严。","如莲得水，灌溉滋悦。","如水注瓶，表里洞彻。","光弥觉海，香满旃檀。","得大自在，作如是观。"],0,"x31","明"],["题镜面二水图","刘崧","四言",["此二水者，实本一源。","或翔而潮，或激而湍。","海阔风高，云蒸雾抟。","混然同归，庶无异观。"],0,"x31","明"],["题山云居图为樊都事仲郛赋","刘崧","四言",["我居何所，南山之下。","油油者云，窈窈其阻。","衡门在阿，翳彼嘉林。","上有鸣鸟，怀之好音。","良晨载兴，游睇川沚。","榛蹊邈绵，有客戾止。","琴瑟在庭，清樽载罗。","扫地布席，援弦咏歌。","我歌我酬，白云在谷。","聊可为娱，孰云不足。","云之升矣，风或飏之。","曾于是处，而忘世为。","凄其渰矣，雨亦濡只。","群生烝烝，泽施曷已。","云敛而舒，山高以深。","彼君子兮，悠悠我心。"],0,"x31","明"],["题画松泉为张别驾","陈献章","四言",["吉水流石，涧生两松。","树洗耳挂，飘无此佳。","处幸逢尧，舜那无巢。"],0,"x209","明"],["拨闷","陈献章","四言",["久病在床，展转莫舒。","我欲观化，有握其枢。","人有善愿，天必从之。","我病几时，我念西驰。","我行次且，如饥思食。","如寒思衣，动惟厥时。","匪亟匪徐，鱼跃鸢飞。","乃见真机，天岂不知。","天偶遗之，吾将尤谁。","我聊任之，拨闷以诗。"],0,"x209","明"],["示湛雨","陈献章","四言",["有学无学，有觉无觉。","千金一瓢，万金一诺。","于维圣训，先难后获。","天命流行，真机活泼。","水到渠成，鸢飞鱼跃。","得山莫杖，临济莫渴。","万化自然，太虚何说。","绣罗一方，金针谁掇。"],0,"x209","明"],["示黄昊","陈献章","四言",["高明之至，无方不覆。","反求诸身，霸柄在手。"],0,"x209","明"],["与民泽","陈献章","四言",["圣人之学，惟求尽性。","性即理也，尽性至命。","理由化迁，化以理定。","化不可言，守之在敬。","有一其中，养吾德性。"],0,"x209","明"],["独漉篇","顾璘","四言",["独漉独漉，水多泥滑。","泥滑道阻，伤我车毂。","持膏作烛，将以照夜。","虚花掩光，不逮槃下。","猛虎在山，百兽畏威。","陷阱三日，垂首诉饥。","铁生矿中，入冶为器。","剑负威神，锤则委地。","男儿生身，万事纲纪。","突梯无施，不如女子。"],0,"x282","明"],["白露","顾璘","四言",["白露凄凄，原草具腓。","日月于迈，载授我衣。","北山有堂，江注其麓。","薄言出游，以写心曲。","山木斓斑，江云差池。","乐以旨酒，委蛇委蛇。","尔樵尔渔，来往无怒。","尔农获斯，黍稷如岵。","戋戋守臣，实蹈百愆。","何以逭之，曰维丰年。","丰年伊何，维民之德。","民之颂之，天子之泽。"],0,"x282","明"],["澹岩题石","顾璘","四言",["玄云结宇，白日回光。","神灵所辟，仙真斯藏。"],0,"x282","明"],["禽言六首 其一 行不得哥哥","顾璘","四言",["楚山造天，楚水扬波。","轻舟良马，败亦孔多。","二物不备，将奈楚何。","行得不得，寄言尔哥。"],0,"x282","明"],["禽言六首 其三 姑恶","顾璘","四言",["姑兮我母，胡宁我虐。","弗慎于仪，衅自下作。","母也尔容，姑乃义合。","上行其义，怨者归薄。","是究是图，诚匪姑恶。"],0,"x282","明"],["禽言六首 其四 泥滑滑","顾璘","四言",["终风发发，周道如刷。","零雨沾之，足不得劄。","匪足不劄，覆车及辖。","尔行弗时，勿谓泥滑。"],0,"x282","明"],["禽言六首 其六 看蚕看火","顾璘","四言",["蚕生于原，匪温斯瘅。","火以炀之，烈则杀我。","尔将崇利，毋贻我祸。","既看我蚕，请看尔火。"],0,"x282","明"],["题玉虚岩四句","顾璘","四言",["苍云抉肤，碧玉琢肋。","真宰运斤，成此仙宅。"],0,"x282","明"],["霖雨歌七首 其二","顾璘","四言",["赫赫皇邑，戢戢王基。","亢阳肆烈，下民其咨。","天子有德，百僚师师。","奏假且严，受于神祗。","霖雨既降，百物咸熙。","鞠哉之咏，媲美周诗。"],0,"x282","明"],["越裳操","胡奎","四言",["有雉有雉，来于越裳。","文王之德，孚于万方。","远人其归，家国永昌。"],0,"x283","明"],["涂山操","胡奎","四言",["有白者狐，九尾差差。","时哉时哉，应彼昌期。","水土底平，告功锡圭。","坤德承干，维王之基。"],0,"x283","明"],["思亲操","胡奎","四言",["儿陶于河，有乌傞傞。","儿渔于泽，有乌翼翼。","彼乌返哺，历山之下。","归哉归哉，慰我父母。"],0,"x283","明"],["步出夏门行","胡奎","四言",["步出夏门，言登泰山。","道逢赤松，方瞳玉颜。","飞霞为佩，明月为环。","授我宝诀，惠我大丹。","回视东海，黄尘蔽天。","骖麟翳凤，逍遥永年。"],0,"x283","明"],["艾如张二首 其二","胡奎","四言",["东山有凤，西山有麟。","张罗于野，其心匪仁。","天池之鹏，扶摇直上。","翼如垂云，安畏尔网。"],0,"x283","明"],["梅子潭纪梦","陈恭尹","四言",["浮云离离，飒其风雨。","扁舟独寐，梦我严父。","曰嗟曰嗟，汝行良苦。","悠悠道路，矧兹鼙鼓。","自汝之先，未绝如缕。","有孑其传，于今为五。","无曰予薄，诸灵所怙。","敬汝慎汝，无忘先祖。","再拜以跽，小子稽首。","暂别我父，日月以久。","郁郁予心，如结予口。","牵衣欲言，捧亲之手。","其衣烨然，其手载温。","乃欣乃奔，乃蹶于门。","起而傍偟，尚闻其言。","疾呼我父，其人曷存。","维舟摇摇，维雨彭彭。","风回一壑，万竹之声。","牛衣转侧，如卧春冰。","行渐老大，实惭所生。","激激潭水，舟乎济之。","浩浩亲恩，心乎系之。","烈已前人，乌乎继之。","我歌我谣，庶几励之。"],0,"x284","清"],["陇头流水歌辞三首","陈恭尹","四言",["陇头流水，流离四注。","念我劳人，终身霜露。","弱水可途，坚冰在须。","时无英雄，咄哉丈夫。","上阪下阪，秦川在眼。","左手把鞭，足不能前。"],0,"x284","清"],["黄河谣二首 其一","陈恭尹","四言",["口哆声嗔，招舟孟津。","马饮浊浪，人立浊尘。"],0,"x284","清"],["黄河谣二首 其二","陈恭尹","四言",["贵舆贱骑，飞躯逐利。","老反山阿，白头入地。"],0,"x284","清"],["题虬髯客图","陈恭尹","四言",["九州可赠，百万何惜。","骑驴出门，书生失色。"],0,"x284","清"],["短歌行","卢龙云","四言",["日月其逝，岁不我留。","有酒盈觞，难以解忧。","忧心如焚，迭用悲惧。","春花既陨，夏叶空存。","秋飙入林，木叶萧森。","寒蝉鸣树，感物悲深。","容华易衰，盛时难再。","今我不乐，忽焉改岁。","为乐如何，有酒当歌。","人之云远，别日苦多。"],0,"x285","明"],["励俗诗","卢龙云","四言",["缅想哲人，弗移于俗。","履洁含贞，卓矣芳躅。","慎修永思，不远而复。","视履考祥，前车戒覆。","主善为师，终始不渝。","时怀靡及，敢玩细娱。","毋荒毋怠，以步以趋。","朝夕匪懈，动与道俱。","如彼农亩，期于必获。","如彼梓材，岂徒朴斲。","是蓘是藨，涂其丹艧。","曾谓伊人，余反不若。","不若惟何，玩愒孔多。","光阴荏苒，岁月虚过。","克念则圣，力岂殊科。","中流一柱，实障颓波。"],0,"x285","明"],["悯谗诗","卢龙云","四言",["彼苍者天，照临下土。","人之讹言，莫克先睹。","断干单縻，沉舟积羽。","野鸟为鸾，众言成虎。","朝比埙篪，暮若仇虏。","风运铅刀，雷鸣瓦釜。","嗟彼谮人，德𬨎鲜举。","惟谗罔极，百行胥愆。","卒混苍素，莫辨媸妍。","谓夷匪圣，谓跖为贤。","措躬无地，防口若川。","于余何罪，视履则旋。","中心自悼，顾影私怜。","悲因抱玉，愁将绝弦。","惟天之命，不爽其应。","始以迹暌，终于实胜。","金石难渝，姜桂有性。","彼昏不知，具曰予圣。","此道其常，厥惟天定。","祸福由人，堪以自镜。","君子闻言，靡惑于听。"],0,"x285","明"],["闲居二首 其一","卢龙云","四言",["茫茫道路，何时可息。","载驰载驱，不遑自逸。","鸟倦知还，言返我室。","左右图书，长吟抱膝。"],0,"x285","明"],["闲居二首 其二","卢龙云","四言",["爰居爰处，葆我天和。","衔杯授简，其乐如何。","驷马高盖，忧患孔多。","人亦有言，对酒当歌。"],0,"x285","明"],["述祖德八首有引 其一","卢龙云","四言",["于穆令祖，贻翼远猷。","启我邦族，溯源分流。","昭穆渐渺，敦叙难周。","于以萃涣，庙貌惟修。"],0,"x285","明"],["述祖德八首有引 其二","卢龙云","四言",["宋室方乱，各念尔家。","卜宅来宇，在海之涯。","施于孙子，代有国华。","云谁荒度，其功孔嘉。"],0,"x285","明"],["述祖德八首有引 其三","卢龙云","四言",["胡闰乱华，抗迹遗世。","秉尚伊何，累仁积义。","启佑斯勤，引而勿替。","浚发其祥，承休滋大。"],0,"x285","明"],["述祖德八首有引 其四","卢龙云","四言",["明德方茂，南粤甫宁。","实兹戎卫，尺籍是兢。","乃疆乃亩，定之宗盟。","黾勉王事，保我后生。"],0,"x285","明"],["述祖德八首有引 其五","卢龙云","四言",["伍世其昌，逮我王父。","克俭克勤，诗书烈祖。","表正乡闾，回澜砥柱。","责报于天，如携如取。"],0,"x285","明"],["述祖德八首有引 其六","卢龙云","四言",["仁考绍之，守而勿失。","忠厚传家，数世如一。","岂误儒冠，龙章有秩。","手泽恒存，敢忘嗣述。"],0,"x285","明"],["述祖德八首有引 其七","卢龙云","四言",["嗟余小子，祗命亲庭。","绎思我祖，先志是承。","爰有堂构，以妥先灵。","以享以祀，明德斯馨。"],0,"x285","明"],["述祖德八首有引 其八","卢龙云","四言",["戚戚兄弟，念祖攸行。","令仪令德，孰敢不经。","夙兴夜寐，无忝所生。","自求多福，罔坠家声。"],0,"x285","明"],["咏史六首 其一","卢龙云","四言",["炎德方盛，恭修玄默。","抚下以仁，民无不获。","感春之和，蠲租赐帛。","诽谤既除，土木必惜。","四海阜安，罔罹兵革。"],0,"x285","明"],["咏史六首 其二","卢龙云","四言",["继体英谊，洞悉闾阎。","赏罚必信，综核惟严。","横经论决，称制时临。","循良增秩，慰我苍黔。","远夷效顺，海宇熙恬。"],0,"x285","明"],["咏史六首 其三","卢龙云","四言",["四七之际，烨矣中兴。","首厘冤狱，出系省刑。","日赅朝罢，复引谈经。","却献抑瑞，驰役缓征。","宽仁及下，柔道致平。"],0,"x285","明"],["咏史六首 其四","卢龙云","四言",["日表龙姿，高出千古。","妙选瀛洲，学舍千庑。","减膳赈饥，恤民疾苦。","谏比韦弦，虚怀罕伍。","睿藻昭宣，经文纬武。"],0,"x285","明"],["咏史六首 其五","卢龙云","四言",["太平天子，日临讲幄。","赐酺赋诗，与众共乐。","召对群材，激扬清浊。","亲录系囚，惧刑之虐。","罢献五坊，汰侈还朴。"],0,"x285","明"],["咏史六首 其六","卢龙云","四言",["恭俭之君，四纪如一。","延义迩英，大书无逸。","好生缓刑，惧灾修德。","罢榷蠲逋，库珠助籴。","贪黩必防，罔私山泽。"],0,"x285","明"],["三士道人自赞","郭之奇","四言",["诗骚作性，兰雪居胸。","神希太始，气轹王公。","束发筮仕，南北西东。","三仕三已，国尔忘躬。","天光云影，得丧穷通。","老依玄老，空此百空。","遭逢一经，身许丹青。","忧时遁俗，意洁情馨。","翁马恒失，庄蝶未醒。","甘苦异节，壮老殊形。","收而远志，归我澹宁。","古之遗直，今之沉冥。"],0,"x286","明"],["八章 其三 瀑布","郭之奇","四言",["湖山相联，云汉中悬。","湖山相得，星河下食。","溯流在央，莫褰衣裳。","从水一方，中心委徨。","大之岩谷，小之石木。","悠悠藻洒，望北飞瀑。"],0,"x286","明"],["八章 其一 朱矶","郭之奇","四言",["湖沙漠漠，非人所乐。","坤德相愁，呼山出脚。","土石开夷，牛羊可托。","一二樵渔，鸠群聚息。","蒙谷飞泉，云光洒落。","朝夕油油，自我布濩。","字以朱矶，宝兹民瘼。"],0,"x286","明"],["八章 其二 星墩","郭之奇","四言",["飞金逐玉，爰失其足。","澹澹冥湖，逝肯来浴。","在水在天，日光共瞩。","曷不乘浮，畏彼槎触。"],0,"x286","明"],["八章 其四 虾蟆石","郭之奇","四言",["视水临形，审志却停。","鱼龙迷惑，风雨冥冥。","千年坐立，不顽不灵。"],0,"x286","明"],["八章 其五 大姑鞋","郭之奇","四言",["我闻在昔，随刊日迈。","不胈不毛，维禹亦惫。","爰有明神，阴从协劢。","既位江湖，无远弗届。","弃屦中流，防风却拜。","定履千年，今人曰篑。","吁嗟今人，少见多怪。"],0,"x286","明"],["八章 其六 石钟","郭之奇","四言",["动静相持，元声以时。","微风击拊，迭奏争奇。","和之一之，乐其可知。","高山漠漠，流水弥弥。"],0,"x286","明"],["八章 其七 小姑钗","郭之奇","四言",["矻矻中阿，独立无颇。","出水峨峨，其仪孔多。","追嗣流光，以琢以磨。","容被草木，鬒发斜拖。","皇皇翠碧，离陆相和。","胡帝胡天，此山此河。","人亦有言，姑钗则那。","虽则姑钗，未可婆娑。","匪春不黛，匪秋不波。","匪云不艳，匪雨不酡。","行朝行暮，亦莫敢过。"],0,"x286","明"],["八章 其八 马当山","郭之奇","四言",["湖软江雄，追飞自东。","天龙下制，岁久难同。","因思马力，俾山立功。","锡形汗潴，秋骊春骢。","饮之满腹，策之驱风。","羁络烟水，吸吐蜺虹。","千里伏枥，万载行空。","维江与汉，会势其中。","崩腾迅激，将为马穷。","吁嗟马兮，惟力之冯。","既食人禄，遑恤我躬。","吁嗟马兮，惟力之终。"],0,"x286","明"],["八月四章","郭之奇","四言",["八月秋风，在河在嵩。","我思之人，天中水中。","之人未从，我心忡忡。","彼何人兮，秋其可同。","秋风既清，苇秀绩成。","我思之人，如裳如缨。","缁衣未迎，授衣有惊。","岂曰无衣，与女同籯。","秋风既肃，壶断枣剥。","我思之人，如胸如腹。","之人未谷，逝敢谋独。","岂曰无谋，惟心惟目。","秋风吹兮，秋日微兮。","苍苍蒹葭，白露肥兮。","我心伤悲，旦夕飞兮。","蒹葭在水，秋未违兮。","伊人在水，秋未归兮。"],0,"x286","明"],["鹿鸣三章","郭之奇","四言",["呦呦鹿鸣，天中有声。","诸宾百执，以及群英。","君子之吉，其光孔明。","人之好我，示我邦桢。","成人小子，誉髦斯平。","邦桢既获，我将我迎。","载玄载黄，篚筐是盛。","威仪百出，雅什三赓。","礼乐相食，诗章有名。","伐鼓坎坎，酒满歌行。","鼓瑟吹笙，至于卒成。","鹿鸣呦呦，天中有游。","芃芃棫朴，有乔有樛。","未见君子，载沉载浮。","苍苍在水，及彼葭秋。","凄凄露白，浥彼河洲。","刍荛遗之，君子求之。","薄言伐之，薄言揫之。","渒彼方舟，洄之游之。","载于王国，薪之槱之。","惟薪惟槱，君子之求。","君子有酒，嘉宾是酬。","呦呦鸣鹿，天中有族。","多士跄跄，诸宾穆穆。","凡我君子，并受王福。","载命而来，求人以复。","厥初求人，时维造育。","百年维树，三载维畜。","山川授灵，鬼神告牍。","自外及中，罔不夜夙。","有德成人，匪余敢独。","人之好我，旨酒甘蓄。","多士诸宾，暨其有禄。"],0,"x286","明"],["言旋","郭之奇","四言",["征车言旋，黄花在馆。","天末一兄，同羁相暖。","闻问人文，及途安坦。","陈杯发颜，深宵尘散。"],0,"x286","明"],["家谋","郭之奇","四言",["既劳王役，徐定家谋。","翼翼归燕，望南语秋。","萧萧征马，遇云衔愁。","延目南云，庶及春舟。"],0,"x286","明"],["寒菊四章","郭之奇","四言",["凄葭一方，寒菊相俟。","何以酬兹，晨阶夕几。","欣慨其间，心目依倚。","未敢从人，重觞泛此。","人之初筵，浮英宜咥。","人之载号，幽性宜疾。","人亦有言，斯维隐逸。","独立秋风，斑斑文质。","我爱陶潜，菊之胜友。","饥坐东篱，无钱得酒。","白衣不来，金英堪糗。","高怀逸咨，相彰益寿。","岂其高怀，惟陶之辙。","岂其逸恣，惟菊之悦。","寄情则然，实爱秋洁。","载寒载阳，孤梅来雪。"],0,"x286","明"],["世心","郭之奇","四言",["无怀时远，世心日波。","怀山襄岛，万石嵚峨。","相济胡少，相溺胡多。","诗云深浅，易象冯河。","我生天末，如江有沱。","手无舟揖，若巨川何。","庶思考槃，于涧于阿。","乐兹渊止，枕漱而歌。"],0,"x286","明"],["众口","郭之奇","四言",["结绳时远，众口喁𪡋。","载声于腕，墨深管铦。","陷文不顾，甘谀乐疢，讳疾忘砭。","谁能响迩，或恐扬𬊈。","宜彼金人，铭背三缄。"],0,"x286","明"],["追昔","郭之奇","四言",["嗛嗛为膏，亦愧颐朵。","戋戋微名，亦劳𫐘轲。","追昔念为，历世真左。","谓影如形，望人于我。","茫茫众生，不皆祝蠃。","参差岐途，毫厘福祸。","时密性疏，道迂行惰。","异气同居，焉不受簸。","屈志交游，姑获面可。","譬彼方舟，未知楫柁。","问讯风波，安救覆坠。","永言念兹，惕然中火。"],0,"x286","明"],["勖今","郭之奇","四言",["外物欣己，亦念吾庐。","徂春及冬，庭扉自如。","栖无风雨，出亦马车。","见华则悦，先贤戒子。","战胜何日，逝敢踌躇。","既观天与，复溯人初。","繇路居宅，孰为毁誉。","功崇惟积，业坠惟疏。","其日其月，岁不我徐。","谁能壮老，独费居诸。","幸甚勖今，勉足澄馀。","无怠无偷，仅不生虚。"],0,"x286","明"],["汉谣四首 其一","郭之奇","四言",["祖龙璧归，秦鹿奔棘。","沐猴锦衣，楚骓泣北。","吁嗟赤蛇，居马上得。"],0,"x286","明"],["汉谣四首 其二","郭之奇","四言",["采龙既成，生彘可食。","沟鸿反飞，江乌队翊。","吁嗟兔死，不令狗匿。"],0,"x286","明"],["汉谣四首 其三","郭之奇","四言",["商山四鸿，同哺雉鷇。","姁翼既成，彘首宜秃。","吁嗟鸩杯，反令雏哭。"],0,"x286","明"],["汉谣四首 其四","郭之奇","四言",["雉则彘人，𪸩耳剔目。","大则崇王，橶腋反触。","吁嗟苍龙，久据梦腹。"],0,"x286","明"],["蓬栖","郭之奇","四言",["人亦有言，心远地偏。","时心既缺，道心乃全。","损之又损，玄之又玄。","门于众妙，宅此深坚。","辞喧入静，羃翠开烟。","取予情性，作尔林泉。","白云芳草，相视曰然。","我知二物，亦可千年。"],0,"x286","明"],["山水之闲","郭之奇","四言",["宇宙虽遐，古今若寄。","高深何物，天地所遗。","水山之闲，是当有异。","仁者见仁，智者见智。","余及水山，与亭为四。","形则万殊，情本一致。","幽谷相求，玄迹多秘。","退而寻之，乃获其至。"],0,"x286","明"],["空山十首 其一 山有云","郭之奇","四言",["山中何有，云在其中。","以光为影，以色为空。","我观其变，变乃无穷。","以今萧索，出古鸿蒙。","用汝作霖，汝昌厥功。","在山者独，在天者同。"],0,"x286","明"]]