[["偈","释圆济","四言",["雨过山青，云开月白。","带雪寒松，摇风庭柏。"],0,32,"宋"],["神功盛德诗  其二四","华镇","四言",["济济朝廷，有名有实。","多士在服，百工励翼。","礼乐兴矣，刑政既达。","郁乎有文，绍周之则。"],0,"x106","宋"],["乾道七年恭上太上皇帝太上皇后尊号十一首 其八 太傅奉太上皇后册宝升殿用《圣安》。","郊庙朝会歌辞","四言",["乾元资始，坤元资生。","允也圣德，同实异名。","春王三朝，典册并行。","咨尔上公，相仪以登。"],0,"x207","宋"],["采蕺 其三","王十朋","四言",["厥草匪甘，厥蔬匪香。","维其味之，岂曰嗜之。","心焉孔焦，胆焉亟尝。","唯其苦之，是以取之。"],0,"x61","宋"],["偈颂三首 其一","释行巩","四言",["横眸碧汉，万国风清。","垂手红尘，千峰日出。"],0,241,"宋"],["放翁自赞四首 其二","陆游","四言",["名动高皇，语触秦桧。","身老空山，文传海外。","五十年间，死尽流辈。","老子无才，山僧不会。"],0,"x41","宋"],["石霜普照珂禅师赞","惠洪","四言",["漆瞳照座，骨相巉岩。","横拈麈拂，寒拥云衫。","五住名刹，道振湘南。","是谁之子，亲见云庵。"],0,"x42","宋"],["暑热","白玉蟾","四言",["玉友避嫌，竹奴专宠。","听官丐闲，诗勇不将。"],0,"x77","宋"],["和陶命子韵示津调官 其五","吴芾","四言",["勿谓吾身，有才有德。","可以安世，可以益国。","不善用之，鲜不为忒。","所以古人，戒之在得。"],0,"x95","宋"],["临终辞众偈","释元聪","四言",["来未尝来，去未尝去。","七十四年，月印寒渚。"],0,28,"宋"],["偈八首 其七","释仁勇","四言",["大方无外，大圆无内。","无内无外，圣凡普会。","瓦砾生光，须弥粉碎。","无量法门，百千三昧。"],0,187,"宋"],["永嘉真觉大师真赞","惠洪","四言",["情根无功，意识无作。","现量圆成，见闻知觉。","如镜受灯，光无坏杂。","烈火焚烧，河流湍逝。","谷风怒号，大地依止。","俱无知思，亦复如是。","此涅槃门，如鼓涂毒。","曹溪挝之，闻者僵仆。","以椎授公，万像惊缩。","光明之语，粲如日星。","精严之行，清如玉冰。","惟不传者，与空相应。","我初学道，如握与拳。","晚乃觉之，如手安然。","有时而用，搏取大千。"],0,"x42","宋"],["太常乐章三十首 其五 皇帝酌献第一室奏大善之舞曲","杨亿","四言",["肃肃艺祖，肇基洪源。","权舆光大，燕翼贻孙。","载祀惟永，庆流后昆。","威灵在天，顾我司存。"],0,"x47","宋"],["道从上人","释祖钦","四言",["惟道是从，惟心是宗。","空即是色，色即是空。","梦幻了了，来去匆匆。","水中之月，树上之风。","作如是观，无塞不通。"],0,64,"宋"],["紫岩九章章八句上寿张丞相  其一","张元干","四言",["赫赫紫岩，白虹贯渊。","玉生其中，匪雕匪镌。","登于廊庙，圭璋浑全。","温如之质，所宝象贤。"],0,"x183","宋"],["和陶时运四首，并引 其二","苏轼","四言",["下有澄潭，可饮可濯。","江山千里，供我遐瞩。","木固无胫，瓦岂有足。","陶匠自至，啸歌相乐。"],0,"x67","宋"],["汾阳昭禅师真赞","惠洪","四言",["维摩杜口，释迦饶舌。","动容顾瞻，非默非说。","虽宣一字，不露点墨。","稽首汾阳，千圣同辙。"],0,"x42","宋"],["和陶时运四首，并引 其一","苏轼","四言",["我卜我居，居非一朝。","龟不吾欺，食此江郊。","废井已塞，乔木干霄。","昔人伊何，谁其裔苗。"],0,"x67","宋"],["颂古","释昙华","四言",["居士倒地，灵照扶起。","乞儿伎俩，讨甚巴鼻。"],0,47,"宋"],["家国吟","邵雍","四言",["邪正异心，家国同体。","邪能败亡，正能兴起。"],0,"x57","宋"],["和冯济川题枯髅图","释法清","四言",["形骸在此，其人何在。","日炙风吹，掩彩掩彩。"],0,141,"宋"],["偈颂四十二首 其九","释祖先","四言",["马祖升堂，百丈卷席。","正令不行，拗曲作直。"],0,54,"宋"],["嵩禅师赞","惠洪","四言",["欧阳之学，师宗于世。","其徒喧阗，攻我以喙。","童首儒林，气索力屈。","公于是时，粹然一出。","天纵之辩，武库纵横。","璜玑捍我，如护目睛。","义如串肉，理如析薪。","一时名誉，耸动缙绅。","世尊举身，毛孔俱笑。","如公语言，笔下皆妙。","六物不坏，未易致诘。","岂其践履，明验之力。","宗教之衰，河坏山摧。","冠巾缁衲，其寒如灰。","拂拭尘翳，见冰雪容。","拜起而喟，涕落无从。"],0,"x42","宋"],["和陶命子韵示津调官 其四","吴芾","四言",["乔木千寻，竟困斧柯。","屈原特立，终陨汨罗。","水行地中，尚值坳窊。","纵如贾谊，犹滞长沙。"],0,"x95","宋"],["赞死心禅师偈 其一","释惟久","四言",["韶阳死心，灵源甚深。","耳中见色，眼里闻声。","凡明圣昧，后富前贫。","利生济物，点铁成金。","丹青徒状，非古非今。"],0,117,"宋"],["文宣王及其弟子赞 其十","赵构","四言",["谦德知二，器实瑚琏。","动必几先，孰并其辩。","一使存鲁，五国有变。","终相其主，誉处悠远。"],0,249,"宋"],["哑子观音赞","释子益","四言",["赞者舌秃，画者口哑。","篮里锦鳞，愈增高价。"],0,63,"宋"],["颂古七十六首  其七五","释士珪","四言",["口是祸门，电掣雷奔。","娑竭出海，震动乾坤。"],0,232,"宋"],["长沙岑大虫真赞","惠洪","四言",["长沙大虫，声威甚重。","独眠空林，百兽震恐。","寂子儿戏，见不知畏。","引手捋须，几缺其耳。","大空小空，是虎是你。","如备与觉，可撩其尾。","嗟今衲子，眼如裴旻。","但见其彪，安识虎真。","我拜公像，非存非没。","百尺竿头，行尘勃勃。"],0,"x42","宋"],["赞死心禅师偈 其二","释惟久","四言",["死心非真，真非死心。","虚空无状，妙有无形。","绝后再苏，亲见死心。"],0,117,"宋"],["转轮八花诗 其六","项安世","四言",["槁枯滋泽，偃屈抽芒。","稻畦远翠，蕙径幽香。","皂舆喜洽，风流激扬。"],0,"x55","宋"],["宽猛吟","邵雍","四言",["宽则民慢，猛则民残。","宽猛相济，其民自安。"],0,"x57","宋"],["观音真赞 其三","释慧空","四言",["此大开士，愿力弘深。","初无自相，随众生心。","或以土木，至于缕线。","但有少缘，悉皆出现。","终不自言，我自于谁。","惟令见者，默尔知归。"],0,"x118","宋"],["皇雅十首  其七","尹洙","四言",["蜀都既平，将臣失律。","此众悍骄，彼民危栗。","当涂叫呶，合万为一。","匪怀则威，帝心是恤。"],0,108,"宋"],["颂古五首 其三","释慧光","四言",["偷吃油糍，卖弄口觜。","年老成魔，谩神吓鬼。"],0,255,"宋"],["和陶命子韵示津调官 其九","吴芾","四言",["既有馀力，且亲灯火。","读破万卷，百倍于我。","我恨书少，意不自可。","汝能雪耻，天亦见假。"],0,"x95","宋"],["偈颂一百六十九首 其一五五","释智朋","四言",["丛林圣制，有解有结。","透脱重关，红炉点雪。"],0,18,"宋"],["荣木和陶靖节韵","程洵","四言",["我卜我居，游息在兹。","有荣者木，日封殖之。","本根既固，发生以时。","我时倾瞻，中心慨而。","维人之生，孰本孰根。","惟皇降衷，天理具存。","是曰成性，道义之门。","钦斯承斯，大化以敦。","嗟彼世人，自安浅陋。","德不图新，恶或念旧。","有干惟禄，有觊惟富。","孰能毅然，不为利疚。","我怀师训，罔敢失坠。","匪道曷从，匪义曷畏。","圣门虽远，率焉以冀。","庶几疲驽，久亦告至。"],0,115,"宋"],["颂古五首 其四","释文准","四言",["人人生缘，北律南禅。","道吾打鼓，华亭撑船。"],0,254,"宋"],["须菩提赞","释师观","四言",["老老大大，岩中宴坐。","帝释雨花，见个什么。"],0,210,"宋"],["十画四言","孔平仲","四言",["亨倅沉俗，泥虬卧虹。","星君促面，省座班封。","修治克茂，果有昌宗。","耻于便幸，宜效孤忠。"],0,"x150","宋"],["荣木","范成大","四言",["薰风南来，木荣于兹。","木荣几时，黄落从之。","逝其须臾，坐成四时。","今我不学，殆其已而。","天旋地游，日月其根。","形息气徂，不亡者存。","去乡离家，莫肯过门。","猗欤先师，不我疵陋。","褰衣示珠，俾我复旧。","自我来归，十年不富。","孰蠹孰蛊，惟汝自疚。","冉冉荣木，霜华将坠。","天黑路长，屹蹶可畏。","隶也不力，奚取六骥。","脂车著鞭，一息而至。"],0,"x52","宋"],["禅人写余真求赞 其二","释慧方","四言",["古松怪石，全体是我。","若谓一如，莫教话堕。"],0,45,"宋"],["题枯髅图","冯楫","四言",["形骸在此，其人何在。","乃知一灵，不属皮袋。"],0,78,"宋"],["天禧三年册皇太子一首","郊庙朝会歌辞","四言",["明离之象，少阳之位。","固邦为本，体天作贰。","仪范克温，礼章斯备。","丕宣令猷，恭守宗器。"],0,"x207","宋"],["为黄仲宣赋山中四章章四句  其三","方回","四言",["山中之人，耘夫耕民。","鲭厥五侯，其如子真。"],0,"x59","宋"],["颂古四十四首 其一","释法泰","四言",["生无所生，死无所死。","风动尘飞，波澄浪止。","和合离散，随处发现。","满月弯弓，双雕一箭。"],0,238,"宋"],["山行见月作 其三","赵蕃","四言",["东坡老翁，有言莫酬。","凉天佳月，即为中秋。"],0,"x36","宋"],["观世音赞六首 其六","黄庭坚","四言",["敬礼补陀，岩下水边。","十方三世，无不现前。","愿我亦证，空觉极圆。","处处悲救，火中生莲。"],0,"x66","宋"],["淳化乡饮酒三十三章  其一七","郊庙朝会歌辞","四言",["崇丘峨峨，动植斯属。","高既自遂，大亦自足。","和风斯扇，膏雨斯沐。","我仁如天，以亭以育。"],0,"x207","宋"],["新安吕公尚书夫人坟","徐积","四言",["彼美新安，有水有山。","有坟岿然，百五十年。","爰有曾孙，赤韨朱轩。","来守兹土，以慰斯坟。","扫除必躬，奉祠必亲。","水毛陆产，膋牲上尊。","百物皆具，千兵骏奔。","观者如堵，从者如云。","心追无穷，诚通无垠。","溟漠之魄，恍惚之魂。","如辟其涂，如启其门。","如兴于寝，如作于室。","如出黄泉，如见白日。"],0,"x123","宋"],["兴祖","释崇岳","四言",["有祖以来，世不可陪。","当机日用，著著全该。"],0,222,"宋"],["皇雅十首  其一四","尹洙","四言",["帝怀永图，治古是宪。","四方守臣，惟屏惟翰。","在昔艰难，弗惠训典。","跨都连城，高牙以建。","有土有民，肆乃征缮。","以息以容，终焉叛涣。","凡今帅臣，狃厥闻见。","匪革乱原，曷清多难。"],0,108,"宋"],["偈二十七首 其十一","释守净","四言",["慧不厌修，福不厌作。","福慧双收，如虎戴角。","作既无作，修亦无修。","青山绿水，短棹孤舟。","格外之谈，迥出常流。"],0,166,"宋"],["宋江三十六赞 其三 玉麒麟卢俊义","龚开","四言",["白玉麒麟，见之可爱。","风尘大行，皮毛终坏。"],0,103,"宋"],["寂音自赞四首 其四","惠洪","四言",["随缘放旷，索尔虚闲。","未埋白骨，且看青山。"],0,"x42","宋"],["偈颂一百六十九首 其一一八","释智朋","四言",["木骨金妆，似则也似。","瞬目扬眉，西天此土。"],0,18,"宋"],["龙山补亡，并引 其一","苏轼","四言",["征西天府，重九令节。","驾言龙山，宴凯群哲。","壶歌雅奏，缓带轻帢。","胡为中觞，一笑粲发。","楩楠竞秀，榆柳独脱。","骥𫘧交骛，驽蹇先蹶。","楚狂醉乱，陨帽莫觉。","戎服囚首，枯颅茁发。","惟明将军，度量豁达。","容此下士，颠倒冠袜。","宰夫杨觯，兕觥举罚。","请歌《相鼠》，以侑此爵。"],0,"x67","宋"],["龙山补亡，并引 其二","苏轼","四言",["吾闻君子，蹈常履素。","晦明风雨，不改其度。","平生丘壑，散发箕裾。","坠车天全，颠沛何惧。","腰适忘带，足适忘屦。","不知有我，帽复奚数。","流水莫系，浮云暂寓。","飘然随风，非去非取。","我冠明月，佩服宝璐。","不缨而结，不簪而附。","歌诗宁择，请饮《相鼠》。","罚此陋人，俾出童羖。"],0,"x67","宋"],["殉节诗  其四","方氏","四言",["举世须眉，何殊巾帼。","偏我妇人，尚知报国。"],0,228,"宋"],["宋江三十六赞 其一 呼保义宋江","龚开","四言",["不假称王，而呼保义。","岂若狂卓，专犯忌讳。"],0,103,"宋"],["辞众颂","释了证","四言",["来时本无，去亦非有。","珍重诸人，月明清昼。"],0,201,"宋"],["三次四言韵二首 其一","洪炎","四言",["入圣有域，存诚以闲。","德不德上，材不材间。","堂上不粪，门设常关。","鄙哉丘垤，覆篑为山。"],0,110,"宋"],["三次四言韵二首 其二","洪炎","四言",["编贝皓齿，含朱绛唇。","甄陶圆熟，琢削细匀。","不笑不言，倚席以颦。","商略有此，为若而人。"],0,110,"宋"],["汉诏郡县行乡饮酒礼颂诗 其八","洪遵","四言",["咏仁蹈德，骎骎措刑。","舄弈千载，薰为太平。"],0,18,"宋"],["公迈何遄  其一","曾丰","四言",["公之西矣，蜀人是谣，都人是嚣。","诏予华衮，亟哉来朝。","彩熊既税，彩鹢既发。","月逗岁遛，竣其未达。","都人曰嘻，吾国君师。","欲猷欲为，未得良毗。","公归何迟。"],0,"x193","宋"],["赠庞公","徐积","四言",["司马德操，来就庞公。","杖履直入，名姓不通。","坐其堂上，指挥呼索。","催令作黍，云我有客。","庞公妻子，堂下罗列。","拜且听命，奔走陈设。","此时庞公，适自外归。","忽见司马，其喜可知。","一堂之上，相从笑语。","其旁观者，莫分客主。","我读其书，爱其古风。","真厚如此，精诚交通。","量如溟海，义薄云空。","至于妻子，亦为叹者。","苟非其人，往往见骂。","盖有是夫，而有是妇。","能佐夫义，善敬夫友。","可警薄俗，可示厥后。"],0,"x123","宋"],["偈二首 其一","释继成","四言",["太阳门下，日日三秋，从东过西。","明月堂前，时时九夏，指鹿为马。"],0,16,"宋"],["辞众偈","释法祚","四言",["七十七年，幻缘忽破。","秋水无痕，霜天月堕。"],0,41,"宋"],["慈感圭老请赞无量寿像","释居简","四言",["十方取土，曰清泰城。","又曰极乐，与苦浊邻。","厌苦知乐，不毫忽间。","一念勇往，即念而瞷。","惟忆惟念，匪疾匪迟。","忆而不忘，念兹在兹。","如求亡子，如丧考妣。","如疢需石，如渴需水。","以如是故，曾何远人。","人人亡羊，入生死轮。","法法惟心，心亦非心。","郑卫嘈杂，水鸟树林。","悠悠渐修，额额阐提。","同摄罔遗，妙在不疑。","疑则疑城，日劫倍蓰。","东隅既失，桑榆可冀。","粤若二仲，达圆顿机。","路壅般舟，手自剪夷。","池栽芬陁，社结名胜。","一十有八，是修是证。","天台嗣响，的传自衡。","和者如云，调高倡宏。","六朝逮今，衣冠缁褐。","愚夫愚妇，爰同此筏。","哂乃二瓠，载沉载浮。","即窒即海，善柳柳州。","见月因摽，执指成咎。","舍有相佛，观无量寿。"],0,"x94","宋"],null,["偈颂一百六十九首 其七十九","释智朋","四言",["莺老花残，春事已过。","明眼衲僧，多是蹉过。","楝花信风，不肯放过。","万户千门，一时俱过。","筑著磕著，是谁之过。","转换不得，也要验过。"],0,18,"宋"],["五方帝 其八","郊庙朝会歌辞","四言",["帝乘中央，沉载函蒙。","经纬四方，物性滋丰。","金石之荐，象德以宫。","神锡嘉虞，介祉无穷。"],0,"x207","宋"],["偈颂四首 其三","释道济","四言",["一块两块，佛也不怪。","一醒两醒，佛也不嗔。","一碗两碗，佛也不管。"],0,220,"宋"],["郊祀庆成诗","陈襄","四言",["皇帝即位，厉精求治。","翼翼兢兢，以畏天异。","乃见宗庙，乃严郊祭。","赫赫烈祖，陟配上帝。","皇帝肇祀，心虔诚至。","斋居撤膳，夙兴弗寐。","不履黄道，不御小次。","出宿于庙，阴雨翳翳。","既其徂郊，日出晰晰。","登丘奏假，天地澄霁。","礼终乐阕，神贶来暨。","皇帝还跸，千乘万骑。","雷动天旋，臣民欣慰。","御楼肆赦，躬册丹地。","恩流泽洽，周匝无际。","惟诚感神，惟德销沴。","皇帝能飨，时赐坐致。","臣愿皇帝，事天寅畏。","左右惟贤，安民惟惠。","无咈忠谏，无轻政事。","日新一日，庶答天意。"],0,50,"宋"],["和陶命子韵示津调官 其六","吴芾","四言",["我幸此生，不忘本始。","身虽朝廷，心实田里。","所以暮年，知足知止。","以进为忧，以退为喜。"],0,"x95","宋"],["自戒","徐元杰","四言",["震畏四知，我畏我知。","心之所畏，天不可欺。"],0,242,"宋"],["黄杨","王十朋","四言",["嘉彼黄杨，郁焉其苍。","匪瓮而圆，匪盖而张。","百干同根，森如弟昆。","千枝其子，万叶其孙。","惟此黄杨，先子所植。","草木有义，先子之德。","愿言我家，兄弟子孙。","如此嘉树，永为义门。"],0,"x61","宋"],["悟首座图余幻质复求为赞","释清远","四言",["廓然无圣，俨尔有容。","明明绝眹，密密垂踪。","昔也怀宝，枯木藏龙。","今其示人，巨岳乔松。","龙吞万类，松茂三冬。","神而不改，风云必从。","吾形既得，尔道自钟。","褒斜路险，汉水朝宗。"],0,116,"宋"],["太庙","郊庙朝会歌辞","四言",["大享合宫，于礼莫盛。","入太室祼，遍于列圣。","陟降有仪，一主乎敬。","祀事孔明，邦家之庆。"],0,"x207","宋"],["畴依  其七","王柏","四言",["於穆文王，顺帝之则。","身蒙大难，小心翼翼。","三分有二，以服事殷。","可谓至德，万邦仪刑。"],0,"x137","宋"],["碧云 其三","赵蕃","四言",["寒镫既张，幽室有光。","岂无他人，惟子之良。","闭彼柴荆，今夕斯长。"],0,"x36","宋"],["偈颂七十一首 其三十八","释了惠","四言",["权实双行，主宾互立。","拿空塞空，以的破的。"],0,62,"宋"],["淳化乡饮酒三十三章  其二三","郊庙朝会歌辞","四言",["郁郁芳兰，佩服珍之。","温温恭人，福履绥之。"],0,"x207","宋"],["三月十三日夜五更闻杜鹃时成父欲入浙因赋六章章四句以送之  其二","赵蕃","四言",["归去来兮，斯言可师。","我今已归，胡能不知。"],0,"x36","宋"],["辞世颂","释普度","四言",["八十二年，驾无底船。","踏翻归去，明月一天。"],0,144,"宋"],["偈颂十二首 其一","释道璨","四言",["无个入处，奔走杀人。","有个入处，碍塞杀人。"],0,93,"宋"],["至道元年册皇太子二首 其二","郊庙朝会歌辞","四言",["皇储既建，圣祚无疆。","鸾旌列叙，鸡戟分行。","前星有烂，瑞日重光。","际天接圣，温文允臧。"],0,"x207","宋"],["至道元年册皇太子二首 其一","郊庙朝会歌辞","四言",["主鬯之重，允属贤明。","承华肇启，上嗣腾英。","礼修乐举，育德开荣。","一人元良，万邦以宁。"],0,"x207","宋"],["偈颂九首 其七","释玿","四言",["与么文彩，甚生标格。","直下承当，迥超言默。"],0,109,"宋"],["采薇吟","仇远","四言",["采薇采薇，西山之西。","薇死复生，不生夷齐。","陟彼西山，我心悲兮。"],0,"x84","宋"],["禅人画师像请赞 其四","释如珙","四言",["持刀杀人，人心不死。","赤手杀人，人心不死。","伎俩俱尽，人心自死。"],0,255,"宋"],["畴依  其五","王柏","四言",["昔在帝尧，咨舜一语。","允执厥中，舜亦命禹。","危微精一，义复兼举。","三圣授受，独盛前古。"],0,"x137","宋"],["畴依  其八","王柏","四言",["武王达孝，善继善述。","盟津既誓，干戈载戢。","访于箕子，洪范以陈。","惟皇建极，反复丁宁。"],0,"x137","宋"],["续琴操哀江南 瞻彼江汉四之二","谢翱","四言",["瞻彼江汉，截淮及楚。","起兵海隈，亡命无所。","枕戈待旦，愤不顾身。","我视王室，谁非国人。","噫嘻昊天，使汝缧绁。","奸党心寒，健儿胆裂。","黄河万里，冰雪峨峨。","尔死得死，我生谓何。"],0,222,"宋"],["偈四首 其二","释天游","四言",["三百五百，铜头铁额。","木笛横吹，谁来接拍。"],0,192,"宋"],["公迈何遄  其三","曾丰","四言",["公之南矣，潭人是怀，洪人是留。","议夺朱幡，亟哉还休。","御者既靷，饯者既挽。","俄驰顷驱，僄其未返。","洪人曰嘕，吾土山川。","有真有仙，可伴长年。","公迈何遄。"],0,"x193","宋"],["和陶命子韵示津调官 其八","吴芾","四言",["我不望汝，勋业济时。","纵得入侍，朝夕论思。","欲供子职，何如在兹。","人能尽孝，忠岂远而。"],0,"x95","宋"],["畴依  其三","王柏","四言",["虞舜侧微，重华协帝。","父顽母嚚，烝烝以乂。","天理之极，人伦之至。","恭己当天，云行雨施。"],0,"x137","宋"],["迎奉圣像四首 其一 玉皇位。","郊庙朝会歌辞","四言",["玉虚上帝，金像睟容。","宅真云构，练日龟从。","维皇对越，率礼寅恭。","灵心丕应，福禄来崇。"],0,"x207","宋"],["所居三章二章章八句一章章十句  其一","洪皓","四言",["昔我所居，巨室髙门。","或出或处，笑傲乾坤。","终日熙熙，省定晨昏。","致君泽民，兹志常存。"],0,68,"宋"],["玄牝颂","周无所住","四言",["万物芸芸，各归其根。","识得根源，玄牝虚传。"],0,69,"宋"],["赤城六章章四句  其五","释居简","四言",["伊我无酒，注彼觩兕。","愿公华衮，式昌厥嗣。"],0,"x94","宋"],["宋江三十六赞 其二 智多星吴学究","龚开","四言",["古人用智，义国安民。","惜哉所予，酒色粗人。"],0,103,"宋"],["舜泉诗","苏辙","四言",["历山岩岩，虞舜宅焉。","虞舜徂矣，其神在天。","其德在人，其物在泉。","神不可亲，德用不知。","有冽斯泉，下民是祗。","泉流无疆，有永我思。","源发于山，施于北河。","播于中逵，汇为澄波。","有鳖与鱼，有菱与荷。","蕴毒是泄，污浊以流。","埃𡏖消亡，风火灭收。","丛木敷荣，劳者所休。","谁为旱灾，靡物不伤。","天地耗竭，泉亦沦亡。","民咸不宁，曰不享耶。","时雨既澍，百谷既登。","有流泫然，弥坎而升。","沟洫满盈，𫚥黾沸腾。","匪泉实来，帝实顾余。","执其羔豚，苹藻是菹。","帝今在堂，泉复如初。"],0,"x135","宋"],["偈","释智孜","四言",["五十春秋，如电如露。","月映寒江，分明归去。"],0,220,"宋"],["颂古十七首 其七","释师观","四言",["傀儡棚头，全火祗候。","明眼人前，一场漏逗。"],0,210,"宋"],["上广东漕使黄郎中  其六","曾丰","四言",["天相公生，成春收集。","挺所钟兮，醇乎成质。"],0,"x193","宋"],["偈二十七首 其二十一","释绍隆","四言",["放一线道，曲为今时。","性地未明，须凭指注。"],0,252,"宋"],["颂古五十七首 其二","释道昌","四言",["二俱不了，随合多少。","纵使夜行，投明未到。"],0,23,"宋"],["颂古七十六首  其一五","释士珪","四言",["百丈野狐，塞鴈衔芦。","李广神箭，张颠草书。"],0,232,"宋"],["义利吟","邵雍","四言",["君子尚义，小人尚利。","尚利则乱，尚义则治。"],0,"x57","宋"],["真炉鼎颂","周无所住","四言",["头上顶天，脚下踏地。","中有一物，煅成宝器。"],0,69,"宋"],["赤城六章章四句  其六","释居简","四言",["亦复愿公，啸吟紫微。","㑭我紫微，嬉其莞而。"],0,"x94","宋"],["颂古五十七首 其四十四","释道昌","四言",["前面有虎，元来是汝。","更问如何，冤苦冤苦。"],0,23,"宋"],["颂古五十七首 其五十五","释道昌","四言",["针头削铁，佛面刮金。","无处若有，出手便惊。"],0,23,"宋"],["颂古三十六首 其十一","释惟一","四言",["即心是佛，砒霜狼毒。","起死回生，不消一服。"],0,143,"宋"],["偈四首 其四","释思慧","四言",["南询诸友，踏破草鞋。","绝学无为，坐消日月。","凡前易脱，圣解难忘。","但有纤毫，皆成渗漏。","可中为道，似地击山。","应物显形，如驴觑井。","纵无计较，途辙已成。","若论相应，转没交涉。","勉诸仁者，莫错用心。","各自归堂，更求何事。"],0,103,"宋"],["苏李松石图赞","张侃","四言",["东坡先生，锦绣心胸。","戏作怪石，一时告功。","当其落笔，雨霈风从。","齐安赤壁，惠州鹤峰。","十年饱览，孰可撄锋。","温润枯淡，变态不同。","一卷之石，作倚盘松。","龙眠居士，孰羁其踪。","一瞬八表，如鹤在空。","东坡颂美，佳名日穹。","明窗展观，松古石窿。","天下之宝，岂间穷通。","东坡之节，龙眠之隐。","一异出处，如琴加轸。","吁嗟二公，人中之龙。","百馀岁后，仰止英风。","我生后时，何以形容。","纪述惟赞，愧非扬雄。"],0,"x146","宋"],["偈颂十八首 其五","释如净","四言",["净慈法座，木头一棚。","横撑竖撑，黑漆光生。"],0,105,"宋"],["摄事十三首 其十一 真宗室用《大明》。","郊庙朝会歌辞","四言",["煌煌真宗，善继善承。","经武耀德，臻于治平。","对祀礼乐，丕昭鸿名。","陟配文庙，皇图永宁。"],0,"x207","宋"],["和陶命子韵示津调官 其三","吴芾","四言",["曰岂不欲，效彼群龙。","润泽万物，助成岁功。","潜而不用，夫岂自封。","惧将有悔，不显其踪。"],0,"x95","宋"],["升堂颂古五十二首 其四十","释怀深","四言",["道源不远，性海非遥。","但向己求，莫从他觅。","觅亦不得，得亦不真。","修是他心，不如自性。","自性清净，即是法身。"],0,"x134","宋"],["偈六十三首 其十三","释道宁","四言",["兵随印转，将逐符行。","把断要关，不通音信。"],0,119,"宋"],["死心禅师舍利赞","惠洪","四言",["地水火风，动暖坚湿。","是中何从，出此坚实。","盖众生心，引大法力。","化为光明，圆粹五色。","稽首死心，骂人老贼。"],0,"x42","宋"],["乾道七年恭上太上皇帝太上皇后尊号十一首 其六 太上皇帝升御坐。降同。","郊庙朝会歌辞","四言",["穆穆圣颜，安安天步。","有缛者仪，以莫不举。","天人和同，恩泽洋普。","亿载万年，为众父父。"],0,"x207","宋"],["颂古六首 其五","释崇岳","四言",["大机圆应，大用直截。","雪峰云门，只得一橛。","毕竟如何，不说不说。"],0,222,"宋"],["宋江三十六赞 其九 病尉迟孙立","龚开","四言",["尉迟壮士，以病自名。","端能去病，国功可成。"],0,103,"宋"],["太常乐章三十首 其二十八 皇帝南郊回御楼将索扇奏隆安之曲","杨亿","四言",["应门有翼，羽卫斯陈。","山龙衮冕，律度声身。","峨峨奉璋，肃肃九宾。","清明在躬，志气如神。"],0,"x47","宋"],["有美人兮四章  其一","赵友直","四言",["有美人兮，在天之东。","瞻之勿及，我心憧憧。"],0,49,"宋"],["偈颂二十一首 其十一","释普宁","四言",["向上一路，千圣不传。","等闲踏著，不直半钱。"],0,119,"宋"],["偈颂四十一首 其一","释慧晖","四言",["山上栏外，水下槛前。","夜兔光雪，昼乌辉火。","黄头出妙，净名入玄。","胡僧印心，卢公传衣。","张三野曲，李四樵歌。","船动碧波，海浸孤天。"],0,194,"宋"],["终风操","王令","四言",["云之扬扬，油油其蒙。","望我以雨，卒从以风。","云之油油，扬扬其去。","我挽不可，泣立以伫。","终风不休，终云不留。","不雨我田，不谷我收。","岩岩南山，有川其下。","徒能必云，不能必雨。","蓁蓁者林，有越而樛。","人伐以归，我徂安休。","嗟今之人，顾己是求。","有颀者木，曷为而材。","大折以薪，小生何哉。","嗟今之人，谁同我哀。"],0,"x68","宋"],["淳化乡饮酒三十三章  其二四","郊庙朝会歌辞","四言",["关雎跄跄，集水之央。","好求贤辅，同扬德光。"],0,"x207","宋"],["疑信吟","邵雍","四言",["人无轻信，事无多疑。","轻信招衅，多疑招离。"],0,"x57","宋"],["紫岩九章章八句上寿张丞相  其二","张元干","四言",["紫岩赫赫，众山维则。","秉国之钧，百僚是式。","志殄仇方，力复明辟。","时方中兴，勋冠今昔。"],0,"x183","宋"],["偈颂六十五首 其二十八","释咸杰","四言",["月圆月缺，循途守辙。","打破牢关，天宽地宽。"],0,92,"宋"],["次程帅劝农和陶诗韵","陈造","四言",["我官于房，庸谂房民。","是腹枵然，惟贮一真。","服事告工，以成以因。","雄也言之，参天以人。","燥之润之，是有黍稷。","天不竟刈，物岂自植。","系人之力，温饱稼穑。","惟蚕而衣，如稼而食。","盍槌于家，盍桑于陆。","饲眠后先，如族昭穆。","爰缲爰织，如寇之逐。","悠悠玩日，迄莫归宿。","孰溉不车，曾不计久。","孰视槁干，徒用播耦。","吴丰楚约，谁非朕亩。","穗斯茧斯，均措厥手。","彼多其储，汝则易匮。","效劳计工，宁终不冀。","蹀躞十驾，与骥一至。","枵中赤立，吾代尔愧。","吏职民忧，无庸汝鄙。","农以济学，繄吾素履。","岂曰多言，率遵前轨。","教诏顺从，庶或兼美。"],0,"x178","宋"],["偈颂八十七首 其十二","释慧开","四言",["闹市红尘，入廛垂手。","才涉思惟，劈脊便搂。"],0,65,"宋"],["无心颂","张伯端","四言",["堪笑我心，如顽如鄙。","兀兀腾腾，任物安委。","不解修行，亦不造罪。","不曾利人，亦不私己。","不持戒律，不徇忌讳。","不知礼乐，不行仁义。","人间所能，百无一会。","饥来吃饭，渴来饮水。","困则打睡，觉则行履。","热则单衣，寒则盖被。","无思无量，何忧何喜。","不悔不谋，无念无意。","凡生荣辱，逆旅而已。","林木栖鸟，亦可为比。","来且不禁，去亦不止。","不避不来，无赞无毁。","不厌丑恶，不羡善美。","不趣静室，不远闹市。","不说人非，不夸己是。","不厚尊崇，不薄贱稚。","亲爱冤仇，大小内外。","哀乐得丧，钦侮险易。","心无两睹，坦然一揆。","不为福先，不为祸始。","感而后应，迫而后起。","不畏锋刀，焉怕虎兕。","随物称呼，岂拘名字。","眼不就色，声不来耳。","凡所有相，皆属妄伪。","男女形声，悉非定体。","体相无心，不染不碍。","自在逍遥，物莫能累。","妙觉光圆，映彻表里。","包裹六极，无有遐迩。","光兮非光，如月在水。","取舍既难，复何比拟。","了兹妙用，迥然超彼。","或问所宗，此而已矣。"],0,152,"宋"],["偈颂一百六十九首 其十一","释智朋","四言",["伶利衲僧，动无思算。","合水和泥，田头地畔。","搆得完全，只得一半，穷坑难满。"],0,18,"宋"],["紫岩九章章八句上寿张丞相  其四","张元干","四言",["紫岩广兮，作镇坤位。","尽臣之道，厚德以载。","开国南阳，厥绪光大。","是似是续，福禄未艾。"],0,"x183","宋"],["偈颂八十七首 其二","释慧开","四言",["礼拜即是，不礼即是。","黄面瞿昙，在我脚底。"],0,65,"宋"],["臭庵","释师范","四言",["全无气息，直是薰人。","无鼻孔者，方堪与邻。"],0,"x155","宋"],["颂古六十二首 其三十六","释清远","四言",["春寒料峭，冻杀年少。","切忌参商，别无奇妙。","低头侍奉，欢喜问讯。","佛法商量，伤子性命。"],0,116,"宋"],["郴州干明进和尚舍利赞","惠洪","四言",["李广射虎，石为之穿。","耿恭祝井，涸为之泉。","忠孝所致，如响答焉。","公亦何为，饥餐困眠。","人初莫测，公岂自言。","戏为火浴，朽者明鲜。","舍利粲粲，玉碎珠圆。","乃至所养，盖其云全。","天全之妙，非粗不传。","如春在花，如意在弦。","嗤嗤横目，气凌云天。","死未及寒，化为腥膻。","矧投于火，不作腥烟。","安有万手，收此精坚。","维德之一，堙所拳拳。","死生之大，卒莫能迁。","公初设心，唯此是专。","不祈人知，人趋如川。","终必有验，理之固然。","我作赞词，丰碑以镌。"],0,"x42","宋"],["偈颂八十七首 其一","释慧开","四言",["父子不传，百无一有。","狭路相逢，推门落臼。"],0,65,"宋"],["正因法孙命工绘吾幻质炷礼请赞","释普宁","四言",["个样面嘴，阿谁敢拟。","威凛凛生，气愤愤地。","临济德山，望风敬畏。","和苏噜之。"],0,119,"宋"],["上广东漕使黄郎中  其五","曾丰","四言",["三春彭兮，和气弸兮。","季于孟仲，和之英兮。","至英收凝，天相丕乎。","公生裕裕，集春之成。"],0,"x193","宋"],["偈颂三十首 其二十","释印肃","四言",["化藏经语，结般若因，度有缘众。","一卷一千，共亦不共。","才出头来，便得受用。","此经无价，拟议不中。","除非自肯，破尘了梦。","见佛不空，塔成无缝。","半偈舍身，古今尊重。","劫火不烧，魔不能动。","佛祖皆宗，天龙普供。","万莫放过，千亿珍重。"],0,"x121","宋"],["明月  其三","陈杰","四言",["白日苦短，而夜苦长。","迟尔不来，明月靡常。"],0,174,"宋"],["山行见月作 其一","赵蕃","四言",["有风肃然，落于树巅。","使我沈疴，不药而痊。"],0,"x36","宋"],["晁无咎金山诗帖赞","岳珂","四言",["我登吞海，而帖适至。","事虽偶然，不啻有意。","彼江山者，秀无古今。","丘壑市朝，则二其必。","阿大中郎，煌煌虎节。","金闺卷怀，亦既殊辙。","同此登览，而趣不同。","云霄并翔，翚翟冥鸿。","矢词胸襟，浩荡万里。","比兴所存，二疏是企。","清诗胜景，何地无之。","不絷不维，景则我随。","征尘障天，我亦倦翼，遗墨未渝，微躬奚息。","南零之波，上派于湓。","诗其警予，以谂侯门。"],0,"x202","宋"],["淳熙十二年加上太上皇帝太上皇后尊号十一首 其三 皇帝奉太上皇帝册宝授太傅。太上皇后册宝同。","郊庙朝会歌辞","四言",["我尊我亲，承天之祉。","寿名兼美，家国咸喜。","公傅秉礼，宝册有炜。","惟千万祀，令闻不已。"],0,"x207","宋"],["文宣王及其弟子赞 其二十八","赵构","四言",["婉彼子羔，受业先圣。","宗庙之问，一出乎正。","克笃于孝，非愚乃令。","师知其生，有辉贤行。"],0,249,"宋"],["偈三首 其一","释克文","四言",["云门抽顾，自有来由。","一点不到，休休休休。"],0,13,"宋"],["偈颂一百四十二首 其九十二","释广闻","四言",["达磨面壁，云门念七。","玉本无瑕，雕文丧德。"],0,10,"宋"],["文宣王及其弟子赞 其二十一","赵构","四言",["邈矣子季，睢阳是伯。","屏息受业，延教登席。","未践四科，困涉六籍。","祀典载之，好是正直。"],0,249,"宋"],["南风歌","薛季宣","四言",["忾彼夏日，熇熇其暑。","毒我下民，辟焉无所。","忾彼夏夜，郁蒸其雨。","民之愠结，莫安其处。","凯风自南，发于茂林。","实彼百谷，纾我愠心。"],0,"x194","宋"],["文宣王及其弟子赞 其三十二","赵构","四言",["室家壮年，无子则逐。","见于信史，全齐之俗。","原本厥初，师言可复。","以学则知，揆之宜笃。"],0,249,"宋"],["迎奉圣像四首 其三 太祖位。","郊庙朝会歌辞","四言",["烝哉大君，聿怀帝祖。","镕范真仪，奉尊灵宇。","至感祥开，洪辉物睹。","瞻谒尽恭，飞英率土。"],0,"x207","宋"],["绝命诗","邓得遇","四言",["宋室忠臣，邓氏孝子。","不忍偷生，宁甘溺死。","彭咸故居，乃吾潭府。","屈公子平，乃吾伴侣。","优哉悠哉，吾得其所。"],0,148,"宋"],["正冬御殿上寿乐章八首 其二 皇帝举第二爵酒登歌奏祥麟之曲","杨亿","四言",["帝图会昌，仁兽效祥。","双觡共抵，示武不伤。","四灵为畜，玄枵耀芒。","公族信厚，元元阜康。"],0,"x47","宋"],["偈颂七十六首 其二十一","释师范","四言",["倾盖相逢，已成多事。","侧鞭回首，早涉繁词。"],0,"x155","宋"],["偈颂七十六首 其七十六","释师观","四言",["来时无踪，去时无迹。","七十五年，青天霹雳。"],0,210,"宋"],["题崇德君所画雀竹蜩螗图赞","黄庭坚","四言",["蒿下蹄间，斥𫛩饮啄。","争雄穹枝，竿网将作。","蝉嘒竹间，自谓得己。","螗螂从之，鸡鸣不已。"],0,"x66","宋"],["偈颂一百三十三首 其四十三","释居简","四言",["跛跛挈挈，百丑千拙。","斗诸方胜，胜诸方劣。"],0,"x94","宋"],["衡山南台寺飞来罗汉赞","惠洪","四言",["惟毗尼藏，称性之印。","印一切法，无有少剩。","而此尊者，跏趺不瞬。","外寂中空，幻灭都尽。","诸佛子等，勿故起妄。","于是像中，作去来想。","昔本不来，今亦焉往。","即一切法，离一切相。","如一月真，无二无别。","于众水中，同时见月。","像非异同，月岂生灭。","以应缘故，光影清绝。","钟山众泉，石井异味。","灵隐众山，小岭异翠。","此岭此泉，皆飞而至。","示根境法，其实同体。","如此大士，诸法成就。","南岳庐山，宴坐驰走。","而事藏界，随处而有。","虽证无生，亦不灭受。"],0,"x42","宋"],["葛文康书简帖赞","岳珂","四言",["辞以情达，义以气激。","以素心期，托名手笔。","都曹之获，中寓其一。","尚想风流，太平人物。"],0,"x202","宋"],["偈颂一百三十三首 其九十一","释法薰","四言",["雪峰辊毬，禾山打鼓。","要觅旨归，月不破五。"],0,31,"宋"],["紫岩九章章八句上寿张丞相  其七","张元干","四言",["土宇未复，繄公辟之。","士风未变，繄公革之。","军律未振，繄公鼓之。","国论未定，繄公断之。"],0,"x183","宋"],["紫岩九章章八句上寿张丞相  其三","张元干","四言",["紫岩高兮，上摩穹窿。","雨露润泽，风云会同。","表宋宗臣，礼泰智崇。","皇以昭之，简在帝衷。"],0,"x183","宋"],["乾道七年恭上太上皇帝太上皇后尊号十一首 其三 皇帝奉太上皇帝册宝授太傅用《礼安》。奉太上皇后同。","郊庙朝会歌辞","四言",["仪物陈矣，礼乐明矣。","天子戾止，诒尔臣矣。","陟降维则，恭且勤矣。","茫茫四海，德教形矣。"],0,"x207","宋"],["陶隐居画像赞","苏庠","四言",["蕊珠妙言，字照编简。","云霾三馆，其人则远。","世衰道丧，完节者鲜。","临终之叹，作世和篇。"],0,60,"宋"],["紫岩九章章八句上寿张丞相  其八","张元干","四言",["来朝伊何，筑隄于沙。","对扬伊何，言宣其麻。","明明天子，坐于正衙。","徯公来归，相我邦家。"],0,"x183","宋"],["三昧诸颂 其五","释印肃","四言",["神光遍界，体若金刚。","威神力固，邪宗销亡。"],0,"x121","宋"],["赵平甫幽居八操 其一 筠居操","杨万里","四言",["公子诛茅，不木不土。","此君惠然，聿来胥宇。"],0,"x54","宋"],["正冬御殿上寿乐章八首 其六 皇帝举第四爵酒登歌奏河清之曲","杨亿","四言",["德水汤汤，发源灵长。","皎鉴澄澈，千年效祥。","积厚流湿，资生阜昌。","朝宗润下，善利无疆。"],0,"x47","宋"],["偈颂一百三十三首 其一○九","释法薰","四言",["当头一句，无过直与。","南山有口，不敢错举，笑破露柱。"],0,31,"宋"],["龙门常住图师真知事求赞","释清远","四言",["寥廓无状，孰为龙门。","有指南路，绝刀斧痕。","因缘去住，任物所论。","黄竹寒湫，晓而复昏。"],0,116,"宋"],["颂古四十八首 其一","释慧开","四言",["狗子佛性，全提正令。","才涉有无，丧身失命。"],0,65,"宋"],["广慧法师赞","陆游","四言",["东土震旦，西方极乐。","一緉草鞋，到处行脚。"],0,"x41","宋"],["颂古三十一首 其三","释安永","四言",["鱼行水浊，鸟飞毛落。","大士横身，不受斧凿。"],0,145,"宋"],["颂古三十一首 其六","释安永","四言",["丧尽家财，无本可据。","赤手杀人，弥天罪过。"],0,145,"宋"],["偈颂一百六十九首 其五十一","释智朋","四言",["此大楼阁，无住无去。","此楼阁门，无开无闭。","作者同归，不劳弹指。"],0,18,"宋"],["文宣王及其弟子赞 其十二","赵构","四言",["礼之有本，子能启问。","大哉斯言，光昭明训。","德辉泰山，诬祭莫奋。","崇兹祀典，盍永令闻。"],0,249,"宋"],["文宣王及其弟子赞 其五十八","赵构","四言",["学者行道，敝缊亦称。","使齐光华，偶为肥轻。","周急之言，君子所令。","答问允严，理皆先经。"],0,249,"宋"],["命子篇","赵友直","四言",["悠悠我祖，肇自轩辕。","迄于赵城，因而氏焉。","汉家涿郡，继族于燕。","卜迁大梁，世系绵绵。","宋自中叶，徙都南塘。","武显扈跸，聿居虞乡。","于赫文杏，奕世其芳。","符德象贤，谱牒有光。","顾及于我，时运倏倾。","族居萍散，遂殒家声。","苫块馀息，仅存其形。","于焉有心，冀我后生。","后生是畏，圣谟炳如。","维时孜孜，无忝厥初。","岂不尔念，为惜居诸。","无后非孝，匪才若虚。"],0,49,"宋"],["偈颂一百二十三首 其五十四","释崇岳","四言",["春风似箭，春雨如膏。","旷劫来事，不隔丝毫。"],0,222,"宋"],["偈颂一百三十三首 其三","释法薰","四言",["衲僧公验，突出难辨。","手眼通身，只得一半。"],0,31,"宋"],["偈颂一百二十三首 其一○四","释崇岳","四言",["第一义谛，分文不直。","略露机锋，青天霹雳。","恁么恁么，不识不识。"],0,222,"宋"],["赐宜春易太极","徐经孙","四言",["易有太极，在天地先。","两仪四象，是谓后天。","春台得之，云自希夷。","吉凶祸福，予以前知。","八十二宫，颇与俗殊。","数往知来，亶其然乎。"],0,232,"宋"],["偈颂一百四十二首 其一一一","释广闻","四言",["日南长至，吉无不利。","冻破泥团，花开碓嘴。"],0,10,"宋"],["赞五祖","释守卓","四言",["浊港转身，破头印法。","五叶芬芳，千徒杂踏。","于秀于能，谁离谁合。"],0,42,"宋"],["定身岩赞","惠洪","四言",["淮山深处，容我卓锡。","树下经行，岩间宴寂。","六十馀年，胁不至席。","天子三诏，掉头不应。","知不可致，南向加敬。","山摇海惊，天空地迥。","后代儿孙，则反于是。","如乳中虫，贪嗜世味。","我寻其迹，为陨涕泪。"],0,"x42","宋"],["偈颂十五首 其七","释法薰","四言",["以大圆觉，为我伽蓝。","头上著枷，脚下著杻。","身心安居，平等性智。","困鱼止沥，病鸟栖芦。"],0,31,"宋"],["偈颂十二首 其二","释如净","四言",["饥来吃饭，困来打眠。","炉鞴亘天，倒退三千。"],0,105,"宋"],["休堂颂","黄庭坚","四言",["头上安头，如何得休。","杀佛杀祖，方得按堵。","北郁单越，西瞿耶尼。","事同一家，吃饭著衣。","向上一路，千圣眨眼。","韩信打关，张良烧栈。"],0,"x66","宋"],["圣号雅二篇 其六","赵湘","四言",["烝哉皇极，道靡有息。","勤勤以谟，罔视其迹。","凿饮自鼓，耕食自绩。","维相以歌，勿荷后辟。"],0,126,"宋"],["偈颂七十六首 其六十八","释师范","四言",["龙蛇混杂，凡圣交参。","儱儱侗侗，颟颟顸顸。"],0,"x155","宋"],["太常乐章又七首 其七 饮福酒广安曲","杨亿","四言",["簠簋既陈，吉蠲登荐。","洗心防邪，肃祗祭典。","陟降惟寅，笾豆有践。","百禄咸宜，淳耀丕显。"],0,"x47","宋"],["标指六偈 入道","释清远","四言",["道本无瑕，拟心已差。","才生眹兆，遍界空花。","若欲全举，除非直与。","不用增添，现成规矩。","洞彻根源，法法周圆。","灵明法尔，妙绝言诠。","言诠不得，得亦差忒。","迥出根尘，古今取则。","存不可见，亡兮对面。","匪存匪亡，森罗自现。","心外无法，法外无心。","心法齐照，境智甚深。","心忘照灭，境智同歇。","一道通同，十方俱摄。","生死涅槃，元无两般。","四生六道，息苦停酸。","平等大道，无有邪正。","胡汉不来，欲何为镜。","像虚镜皎，镜像斯照。","像去镜亡，千圣非妙。","此门难入，唯君自息。","若入此门，半钱不直。","不直半钱，万国争观。","所以说云，大道体宽。"],0,116,"宋"],["祭见首座","释善珍","四言",["佛法下衰，众魔峥嵘。","如虎而祴，白昼市行。","晚交得君，如黄河清。","君与予谈，洞见底里。","予建一事，君曰可纪。","予出一辞，君曰入理。","狂猘狺狺，嗾之者谁。","君蹑予足，怒形于辞。","古有徇义，舍父背师。","曷不千指，曷不百岁。","神祐靡专，贵奸寿悖。","谓天昭昭，天实茫昧。","君素清苦，简洁自持。","如政黄牛，标韵过之。","有德操才，得疾亦奇。","浮华眼前，道义千古。","昔有微言，噤不敢吐。","含哀以告，君必领悟。"],0,45,"宋"],["颂古四十八首 其四十一","释慧开","四言",["西来直指，事因嘱起。","挠聒丛林，元来是你。"],0,65,"宋"],["颂古三十一首 其四","释安永","四言",["白日青天，开眼放尿。","黄面瞿昙，一场漏逗。"],0,145,"宋"],["对月了残经赞","释绍昙","四言",["五教三乘，之绕葛藤。","一言道尽，玉兔东升。"],0,"x108","宋"],["绣释迦像并十八罗汉赞 第九戍博迦尊者","惠洪","四言",["此琉璃瓶，中迸五色。","是功德聚，善慈根力。","僧俗俨然，殊迹同道。","即事之理，一体三宝。"],0,"x42","宋"],["偈六十九首 其三十四","释道宁","四言",["衲子玄关，群生命脉。","锋芒未兆，便好承当。","文彩才彰，翻成影事。","空劫已前，乾坤未剖。","凝然一片，非圣非凡。","不涉熏修，岂从外有。"],0,119,"宋"],["颂古 其四十四","释道颜","四言",["百丈野狐，塞雁衔芦。","李广神箭，张颠草书。"],0,47,"宋"],["偈颂一百三十三首 其五十三","释法薰","四言",["禅非意想，道绝功勋。","青天白日，有迷路人。"],0,31,"宋"],["和陶停云 其三","吴芾","四言",["我顷虽达，不足为荣。","拟攀逸轨，少适真情。","遐赏风味，魂梦宵征。","葛巾藜杖，彷佛如生。"],0,"x95","宋"],["宋江三十六赞 其十 浪里白跳张顺","龚开","四言",["雪浪如山，汝能白跳。","愿随忠魂，来驾怒潮。"],0,103,"宋"],["偈颂八十七首 其七十四","释慧开","四言",["诸方浩浩，举古明今。","送人上树，不是好心。"],0,65,"宋"],["偈颂八十七首 其七十三","释慧开","四言",["遇家里人，说家里事。","一句无私，龙翔凤翥。"],0,65,"宋"],["夕日操 其二","王令","四言",["煜煜夕日，不尚有朝。","皦皦君子，去谁繇招。","死如可从，生百不聊。"],0,"x68","宋"],["绍兴中兴上复古诗","张嵲","四言",["天监我宋，受命以人。","咋为乱阶，以启圣人。","皇帝嗣位，其仁如春。","万邦欣载，共惟帝臣。","垂衣高拱，惟务俭勤。","恤民不怠，懋穑劝分。","卑宫勿饰，服御无文。","膳食取具，不羞庶珍。","内官弗备，简御嫱嫔。","抑损戚畹，登崇搢绅。","吏除苛绕，狱去放分。","刑罚不试，号令不频。","旰食宵衣，导率以身。","行之期年，天下归仁。","皇帝躬行，过于尧禹。","如天不言，乃帝之所。","内资禀命，外须训抚。","不有相贤，孰资察补。","天舍其衷，遗之硕辅。","实惟旧臣，乃吾肱股。","昔以梦求，今以德错。","皇帝曰咨，惟予与汝。","我唱而和，无或疑阻。","如手如臂，如心如膂。","如彼事神，汝为椒糈。","如彼琴瑟，相待戛拊。","相臣受命，于帝其训。","敢惮夙宵，以图淑问。","衣不及带，冠不暇正。","内事抚摩，外修好聘。","忍尤攘纷，徂惟求定。","皇帝之孝，克迈帝舜。","相臣佐之，兹惟无竞。","上感穹昊，下格殊邻。","以暴为恩，易顽以驯。","母后既归，东朝侍御。","天下载欢，若饥得哺。","天子躬俭，惟亲是丰。","未明求衣，朝长乐宫。","礼备家人，养以天下。","先意承旨，事无违者。","天子行孝，天下承风。","胥训胥效，比屋可封。","乃建中宫，以母四海。","诗首关雎，易称中馈。","天子之尊，亦资内助。","上奉慈颜，下式寰宇。","事亲底豫，化民致和。","始于壸阈，邦国是讹。","太学肇建，四方是极。","增博士员，导以经术。","有来英髦，充牣上京。","三年大比，以考其成。","异时之用，维公维卿。","石渠广内，图书之渊。","羽陵之蠹，断简之编。","是息是游，英俊在焉。","逸群之彦，比迹卿云。","怀材待问，发闻扬芬。","驰骋古今，上下典坟。","考正律度，是为景钟。","导和殖财，国用以丰。","不窕不槬，咸中典刑。","有涣其章，上公是铭。","兹器惟则，允为国经。","德爵之亚，莫尚惟齿。","班序颠毛，以为民纪。","乡饮既行，郡邑是遵。","洙泗之风，无复龂龂。","井田既坏，民困劫假。","乃正经界，以实多寡。","赋入既均，贫富不病。","非上恤之，孰拯其命。","诞弥之节，式宴示慈。","乐不计费，孰敢节之。","皇帝曰咨，费财无艺。","亲降德音，以禁肆侈。","天下欢然，称盛德事。","匪帝命之，臣子曷议。","著之令甲，付之史官。","永永万年，无或敢干。","人事既洽，惟神是事。","于庙于郊，各尽其礼。","其郊维何，蒇事圜丘。","帝御六龙，冕十二旒。","既新宫架，既备礼服。","有洁其牲，有温其玉。","合袪天地，侑以祖考。","乐奏六变，其音肆好。","问谁相祀，实维上公。","登降跪起，有肃其容。","天地并况，瑞物来下。","天子万年，以有神嘏。","其庙维何，可以观德。","德盛不祧，祀事不忒。","祖庙既饬，旅楹有闲。","原庙继作，以游衣冠。","若节春秋，皇帝戾止。","荐献有容，祖考咸喜。","礼成而退，祗奉不渎。","天子万年，永绥遐福。","天神贵者，莫尊太一。","置祠为民，其宫有洫。","既仿谬忌，道开八通。","皇帝临飨，威神是崇。","天人相际，福禄攸同。","国南千亩，是为帝籍。","天子肇祀，以祈黍稷。","我黍与与，我稷翼翼。","以享以祀，以为民食。","福禄绥之，万世无斁。","乃营吉壤，肇建高禖。","何以歆之，帝德不回。","瑞乙既至，后率所御。","以弗以祈，有秩斯祜。","千亿之祥，兆于帝武。","天锡皇帝，圣钦不迟。","事神保民，以莫不祗。","上帝临之，云何以报。","维年屡丰，诸福是效。","非维丰之，又布濩之。","东西北南，咸锡予之。","稼茂于野，粟积于仓。","礼义兴行，民俗以臧。","桴鼓不鸣，狱讼衰息。","人有盖藏，道无捐瘠。","和气所蒸，化为瑞物。","甘露零庭，近在郊邑。","有木呈祥，合枝共柢。","考传验符，远人不贰。","或剖其中，自然成文。","太平是告，希代莫闻。","丰年屡应，众瑞应图。","皇帝谦恭，不以自居。","图回庶事，益慎厥初。","君臣相戒，可否吁俞。","政过三代，言成典谟。","历选后辟，前载所无。","在昔中兴，周汉二宣。","夏康商宗，汉祖晋元。","咸用干戈，配天祀夏。","其臣歌颂，或列于雅。","方之皇帝，爝火太阳。","顾无歌诗，垂世用光。","词臣伏罪，无以塞责。","谁其诗之，以佐皇德。","下臣张嵲，过不自揆。","日官西掖，待罪文字。","敢颂厥美，以赞后功。","江汉崧高，不足比隆。"],0,"x133","宋"],["正冬御殿上寿乐章八首 其八 礼毕降坐宫悬奏隆安之曲","杨亿","四言",["被衮当阳，穆穆皇皇。","击石拊石，颂声洋洋。","和乐优洽，终然允臧。","礼成而退，荷天百祥。"],0,"x47","宋"],["偈颂八十七首 其七十一","释慧开","四言",["是圣是凡，过这边立。","拟议不来，青天霹雳。"],0,65,"宋"],["偈六十九首 其三十二","释道宁","四言",["透脱玄关，更无凝滞。","一瞖落眼，空华乱坠。"],0,119,"宋"],["偈颂一百四十二首  其一一五","释广闻","四言",["世事悠悠，不如山丘。","卧藤萝下，块石枕头。"],0,10,"宋"],["偈颂八十七首 其三十二","释慧开","四言",["目前无法，意在目前。","目前荐得，正好吃拳。"],0,65,"宋"],["偈颂一百四十二首 其一三五","释广闻","四言",["智门莲花，赵州庭柏。","不用低头，思量难得。"],0,10,"宋"],["偈颂十七首 其七","释师范","四言",["六爻既穷，阴魔自殄。","一阳来复，吾道大亨。"],0,"x155","宋"],["颂古十七首 其八","释鼎需","四言",["盐贵米贱，诸事成现。","拟欲商量，脑后拔箭。"],0,10,"宋"],["偈颂八十七首 其十六","释慧开","四言",["灵山话月，曹溪指月，寒山比月。","从上佛祖，纳尽败阙。"],0,65,"宋"],["偈颂一百三十三首 其三十四","释法薰","四言",["一不成一，二不成二。","喝水成水，敲骨出髓。","眼有瞳人，色斯举矣。"],0,31,"宋"],["偈颂一百三十三首 其五十二","释法薰","四言",["身心一如，身外无馀。","长安虽乐，不是久居。"],0,31,"宋"],["偈颂八十七首 其四十九","释慧开","四言",["热喝粗拳，佛来也打。","临济德山，一时擒下。"],0,65,"宋"],["经史阁四言诗","张衡","四言",["玄黄氤氲，混沌未死。","道隠冥默，文鬰雕跂。","蚩蚩熙熙，结绳而治。","谁凿七窍，鸿蒙拊髀。","马图鸟迹，仿佛文字。","羲轩勋华，授受一理。","典谟训诰，浑浑无拟。","天生素王，躬服仁义。","宪章祖述，参赞经纬。","经揭日月，史严辞事。","九流说铃，诸子疣赘。","秦灰小厄，鲁壁阐秘。","白首齐生，口诵臆记。","枝叶扶疏，风流委靡。","汉兴购求，六经大备。","舒向校雠，班马传纪。","尔雅同风，沿袭世次。","宋三百年，超轶姚姒。","际海薄天，声教渐被。","惟此东邑，蔼蔼多士。","孔墙巍巍，重屋丹绮。","群玉之府，五经之笥。","排签插架，堆案盈几。","藻饰皇猷，驰骋帝轨。","兰薰颜冉，玉洁曾史。","物忌太盛，道有中否。","何物坏宅，有士抱器。","坛荒杏老，墉鼠穴虺。","川竭珠逃，椟破玉毁。","炷灯拭案，篇𡏖简毁。","观鹳雅鸦，鲁鱼亥豕。","斲轮糟粕，负蛉口耳。","忘筌舍蹄，出足弃履。","文未丧天，道不坠地。","起废者谁，孟母之子。","薄言采藻，于彼沼沚。","鸠工捐资，不捐廪饩。","榱桷得宜，轮奂有炜。","肩摩踵接，出入槐市。","非此乔木，畴克大庇。","非我宗匠，孰主张是。","祖有令德，世济其美。","休声日流，与道终始。"],0,36,"宋"],["偈颂八十七首 其四十八","释慧开","四言",["灵山一会，泥团土块。","问讯烧香，和赃捉败。"],0,65,"宋"],["颂古二十九首 其十八","释师体","四言",["之乎者也，雪月风花。","头面各别，事同一家。"],0,5,"宋"],["偈颂十五首 其三","释法薰","四言",["以大圆觉，为我伽蓝。","望云上树，身心安居。","平等性智，熟睡寐语。"],0,31,"宋"],["偈颂一百三十三首 其六十三","释法薰","四言",["慧日峰高，门庭壁立。","放一线开，从这里入。"],0,31,"宋"],["和君时十章章四句  其一○","彭汝砺","四言",["我田我田，以迟尔归。","何速于行，姑乐我私。"],0,"x143","宋"],["颂古二十九首 其十六","释师体","四言",["贫无所依，两亲相击。","旱地雷声，青天霹雳。"],0,5,"宋"],["太常乐章又七首 其一 白帝迎神高安曲","杨亿","四言",["西颢腾精，天地始肃。","盛德在金，百嘉阜育。","彍弩射牲，筑场登谷。","明灵格思，旄罕纷属。"],0,"x47","宋"],["宋江三十六赞 其十二 短命二郎阮小二","龚开","四言",["灌口少年，短命何益。","曷不监之，清源庙食。"],0,103,"宋"],["和陶停云 其二","吴芾","四言",["眷兹衡宇，草树溟蒙。","坐对五柳，遥望九江。","亦足寄傲，东轩南窗。","独恨无人，载酒相从。"],0,"x95","宋"],["紫岩九章章八句上寿张丞相  其六","张元干","四言",["北堂之尊，命妇称首。","逢是谷旦，酌以大斗。","公如老莱，衣衮裳绣。","式歌且舞，以介眉寿。"],0,"x183","宋"],["偈颂一百三十三首 其一○六","释法薰","四言",["一夏过半，久参事慢。","伶俐衲僧，一咬便断。"],0,31,"宋"],["皇雅十首  其八","尹洙","四言",["帝曰将臣，予嘉乃庸。","废命毒民，尔弗有终。","邦典用疑，惟罪惟功。","靡殛而削，协于厥中。"],0,108,"宋"],["东坡先生赞 其二","李之仪","四言",["天作斯文，万物所印。","时惨时舒，与天同运。","其谁特立，卓哉吾人。","黄且落矣，蔚然常春。","见险弗止，自信无闷。","求仁得仁，于我何怨。","光时显被，外薄四夷。","载瞻载仰，百世之师。"],0,"x203","宋"],["和陶命子韵示津调官 其七","吴芾","四言",["汝能传家，一第已及。","使进而为，不患无立。","奈何亲老，奉亲为急。","莫待异时，徒然涕泣。"],0,"x95","宋"],["东坡先生赞 其一","李之仪","四言",["东坡仙人，岷峨异禀。","道日而升，弗类斯摈。","有继皇皇，期之奠枕。","谁其止之，成是贝锦。","天作人远，言何从谂。","闻已耸然，见孰不凛。"],0,"x203","宋"],["魏京诗 其十","刘敞","四言",["驱之浑浑，攘之贲贲。","靡有辀张，歼厥鲸鲲。"],0,"x51","宋"],["监乐堂","王灼","四言",["隆然新堂，治所中间。","江岭环匝，州瘠以寒。","吾氓蚩蚩，吏有夺欺。","侯登新堂，来辑来绥。","新堂隆然，侯远近望。","力纾吾氓，俾获其仰。","瘠吾与食，寒吾与纩。","导尔嬉娱，废尔凄怅。","堂富众产，左右后前。","沼鲂屿鸟，春棠夏莲。","莫莫者葛，荫五亩馀。","尔动尔植，其宁尔居。","侯宴新堂，宾僚接席。","观者墙立，垂髫戴白。","歌钟既合，手之舞之。","祝侯寿考，与江岭期。"],0,117,"宋"],["送尚辞","释重显","四言",["浮图之子，履道为贵。","天兮地兮，何泰何否。","动无饰非，静还雕伪。","辞也云行，后生可畏。"],0,"x156","宋"],["文宣王及其弟子赞 其十九","赵构","四言",["人禀秀德，气貌或同。","而子俨然，温温其容。","两端发问，未答机锋。","以礼节和，斯言可宗。"],0,249,"宋"],["文宣王及其弟子赞 其二十五","赵构","四言",["周衰伪隆，政在群公。","廉耻道微，家臣聿崇。","不为屈节，㧑默自容。","子于是时，凛然清风。"],0,249,"宋"],null,["文宣王及其弟子赞 其十八","赵构","四言",["轼彼穷阎，达士所宾。","邦无道谷，进退孰伦。","敝衣非病，无财乃贫。","赐虽不怿，清节照人。"],0,249,"宋"],["绿菜赞","黄庭坚","四言",["蔡蒙之下，彼江一曲。","有茹生之，可以为蔌。","蛙𧏖之衣，采采盈掬。","吉蠲洗泽，不溷沙砾。","芼以辛咸，宜酒宜𫗧。","在吴则紫，在蜀则绿。","其臭味同，远故不录。","谁其发之，班我旨蓄。","维女博士，史君炎玉。"],0,"x66","宋"],["云兴于山","苏洵","四言",["云兴于山，霿霿为雾。","匪山不仁，天实不顾。","山川我享，为我百诉。","岂不畏天，哀此下土。","班班鸤鸠，谷谷晨号。","天乎未雨，余不告劳。","谁为山川，不如羽毛。"],0,70,"宋"],["棹歌联句","白玉蟾","四言",["西风起兮，落叶黄兮，黍稷香兮。","击空明兮，溯流光兮，天一方兮。","彼美人兮，遥相望兮，彼苍茫兮。","系孤舟兮，蓼花傍兮，啼寒螀兮。"],0,"x77","宋"],["偈颂一百零一首 其七十","释慧性","四言",["点捡将来，罪过不少。","只凭拄杖，一切靠倒。"],0,46,"宋"],["熙宁中朝会三首 其二 再举酒用《嘉禾》。","郊庙朝会歌辞","四言",["彼美嘉禾，一茎九穗。","农畴告祥，史牒书瑞。","击壤欢歌，如京委积。","留献春种，昭锡善类。"],0,"x207","宋"],["紫岩九章章八句上寿张丞相  其九","张元干","四言",["紫岩之松，在涧之沚。","下有茯苓，兔丝蔓只。","结为琥珀，深根固柢。","愿公难老，受兹燕喜。"],0,"x183","宋"],["适薄歌","薛季宣","四言",["瞻彼薄兮，俗灏灏兮。","父母邦兮，蔑强暴兮。","瞻彼薄兮，俗洋洋兮。","父母邦兮，蔑暴强兮。","茫茫禹迹，紊其经纪。","适彼薄兮，言归父母。"],0,"x194","宋"],["偈颂一百零九首 其六十一","释可湘","四言",["了了无言，蓦胸一拳。","蜃江水急，不许泊船。"],0,158,"宋"],["善恶吟  其一","邵雍","四言",["瞽鲧有子，尧舜无嗣。","余庆余殃，何故如此。"],0,"x57","宋"],["皇雅十首  其三○","尹洙","四言",["皇德在仁，寖而成风。","公侯卿士，靡不率从。","麛卵萌生，咸保厥终。","不鄙不夭，乐哉融融。"],0,108,"宋"],["颂古十二首 其六","释法泰","四言",["得人一牛，还人一马。","有往有来，可知礼也。"],0,238,"宋"],["颂古三十三首 其十二","释师观","四言",["不落不昧，东倒西擂。","铁壁银山，一时粉碎。","不昧不落，且无造作。","诚哉是言，不从人学。"],0,210,"宋"],["偈二首 其二","释觉","四言",["仰之弥高，不隔丝毫。","要津把断，佛祖难逃。","钻之弥坚，真体自然。","鸟啼华笑，在碧岩前。","瞻之在前，非正非偏。","十方坐断，威镇大千。","忽焉在后，一场漏逗。","堪笑云门，藏身北斗。"],0,217,"宋"],["辞世","释慧性","四言",["七十八年，内空外空。","撒手便行，万古清风。"],0,46,"宋"],["梁溪四友赞序 其三 幽芳赞","李纲","四言",["天地和气，萃于幽芳。","言茁其芽，薰然国香。","绿叶紫茎，素荣缥房。","纫以为佩，御彼不祥。","采自深林，置于座侧。","不改其度，其香满室。","与子为友，心同德一。","优哉游哉，聊以永日。"],0,"x136","宋"],["赞童科安医师","释月涧","四言",["惟吾一指，造大极玄。","视天下人，咸若小儿。","起膏肓疾，犹谈笑然。","貌可丹青，玄孰传焉。"],0,91,"宋"],["魏京诗 其二十","刘敞","四言",["翼翼之土，天子国之。","穆穆原庙，圣人则之。"],0,"x51","宋"],["正冬御殿上寿乐章八首 其一 皇帝举寿酒宫悬奏和安之曲","杨亿","四言",["天威煌煌，山龙采章。","庭实旅百，上公奉觞。","拱揖群后，端委垂裳。","永锡难老，万寿无疆。"],0,"x47","宋"],["文宣王及其弟子赞 其四十三","赵构","四言",["惟子挺生，道德之门。","佩服至论，鲤则弟昆。","三得三亡，所问殊温。","君子归宓，义不掩恩。"],0,249,"宋"],["偈颂一百零九首 其三十四","释可湘","四言",["咬定牙关，全提杀活。","刳文殊胫，拔维摩舌。","更有一机，不说不说。"],0,158,"宋"],null,["鼷鼠操","王令","四言",["鼷鼠鼷鼠，实食其牛，牛则不知。","彼牛彼牛，既卜以郊，伤则免之。"],0,"x68","宋"],["偈颂一百二十三首 其二十八","释崇岳","四言",["当阳显赫，神龙妙诀。","倒岳倾湫，雷轰电掣。"],0,222,"宋"],["偈颂一百二十三首 其三十二","释崇岳","四言",["要行便行，要坐便坐。","自古自今，只是这个。"],0,222,"宋"],["偈颂一百二十三首 其一一七","释崇岳","四言",["世尊良久，维摩默然。","便恁么去，十万八千。"],0,222,"宋"],["偈颂一百二十三首 其十六","释崇岳","四言",["晷运推移，日南长至。","上下四维，庆无不利。"],0,222,"宋"],["颂古十三首 其七","释德光","四言",["赵州勘婆，百发百中。","趁得老鼠，打破油瓮。"],0,208,"宋"],["题徐寿画牛","仇远","四言",["此大武者，二十八蹄。","茂树之下，丰草萋萋。","牧童且嬉，夕阳未西。","何如桃林，归去来兮。"],0,"x84","宋"],["偈颂一百零二首 其三十二","释绍昙","四言",["无量劫来，七颠八倒。","打破虚空，全身入草。"],0,"x108","宋"],["迎奉圣像四首 其四 太宗位。","郊庙朝会歌辞","四言",["于显神宗，德洽区中。","祥金烁冶，范兹睟容。","殊庭胥宇，备物致恭。","明威有赫，降福来同。"],0,"x207","宋"],["所居三章二章章八句一章章十句  其二","洪皓","四言",["今我所居，圭窦荜门。","俯首折腰，如坐覆盆。","终日𫍢𫍢，形弊神昏。","死所未知，旧事谁论。"],0,68,"宋"],["偈六十三首 其二十","释道宁","四言",["凛凛玄风，尘尘三昧。","信手拈来，曾无障碍。","不用安排，素非憎爱。","透过斯关，逍遥自在。"],0,119,"宋"],["偈颂二十九首 其十九","释云","四言",["支提门下，五日一参。","我才合掌，汝便和南。","龙象蹴蹋，非驴所堪。"],0,181,"宋"],["赵郡王施斗彩法被荐女因为说偈","释居简","四言",["倚福修慧，深丹浓翠。","倚慧修福，砌锦层縠。","福慧两全，众彩明鲜。","紫不乱朱，缟不碍玄。","惟茜惟碧，参鳞差翼。","空王座上，一片如织。","善哉命妇，巧思精究。","劝化诸女，如出一手。","惟此命妇，诸善女人。","于寿域中，克康克宁。","女子有行，归宁母家。","载殒淑身，发明心花。"],0,"x94","宋"],["宋江三十六赞 其三十 美髯公朱仝","龚开","四言",["长髯郁然，美哉丰姿。","忍使尺宅，而见愁眉。"],0,103,"宋"],["偈颂一百三十三首 其一","释居简","四言",["趁鼠入角，吹糠著米。","直下翻身，剑去久矣。"],0,"x94","宋"],["建隆郊祀八首 其五 酌献用《禧安》。","郊庙朝会歌辞","四言",["丹云之爵，金龙之杓。","挹于尊罍，是曰清酌。"],0,"x207","宋"],["偈八首 其八","释慧远","四言",["拗折秤锤，掀翻露布。","突出机先，鸦飞不度。"],0,154,"宋"],["心迹吟","邵雍","四言",["圣人了心，贤人了迹。","了心无穷，了迹无极。"],0,"x57","宋"],["招陈顾魂挽词","徐积","四言",["鱼有所归，鸟有所栖。","孤坟累累，子将何依。","束子之装，裹子之粮。","促登汝航，往归汝乡。"],0,"x123","宋"],["偈颂三首 其三","释行巩","四言",["雪峰辊毬，禾山打鼓。","秘魔擎叉，道吾作舞。"],0,241,"宋"],["颂古十七首 其十三","释师观","四言",["虚空迸裂，当处超越。","堪笑云门，多这一橛。"],0,210,"宋"],["偈颂一百零九首 其二","释可湘","四言",["摩竭陀国，亲行此令。","从上以来，孰敢违命。"],0,158,"宋"],["炬长老请赞","释法薰","四言",["刀不自截，水不自洗。","我真我赞，成何道理。","请之既坚，却之不已。","有一句子，玄沙道底。"],0,31,"宋"],["偈颂一百零二首 其五十三","释慧远","四言",["古圣伽蓝，一切成见。","未跨三门，先见佛殿。"],0,154,"宋"],["颂古十一首 其五","释子益","四言",["出与未出，莲花荷叶。","老倒智门，舌头无骨。"],0,63,"宋"],["偈颂十二首 其十二","释原妙","四言",["不得者个，争得那个。","既得那个，忘却者个。"],0,137,"宋"],["用宣禅人求赞","释宗杲","四言",["宣传吾真，吾为宣说。","眨上眉毛，大巧若拙。"],0,"x112","宋"],["偈颂四十一首 其三十","释慧晖","四言",["小春霜刃，大家雪机。","一堂禅侣，三世结制。","时光可惜，岁花不留。","自晨至暮，吃饭饮茶。","道者一个，无得禅心。","从生至老，著衣谈笑。","道流半个，莫知自心。","徒劳念情，不识玄旨，苦哉悲矣。","贫道孤老，走年难系。","谨劝云众，一生归信。"],0,194,"宋"],["天道夷简行","释文珦","四言",["天道夷简，荡荡巍巍。","人心不然，大行险巇。","转眼翻覆，诚不易知。","忠或见疏，信或见疑。","离间致入，宁复顾思。","昔者缱绻，终焉弃遗。","圣如周公，王犹不知。","孝若申生，姬能死之。","在彼盛时，尚有尔为。","况乎季世，颠倒是非。","谗人饱禄，志士苦饥。","俯仰今古，其谁不悲。","命悬于天，逆之为嗤。","冲静无患，进取必危。","守道安危，其殆庶几。","祸福之兆，可以理推。","夷齐去周，西山采薇。","黄绮避秦，商岩茹芝。","景行先哲，良足为规。","规而罔念，虽悔何追。"],0,"x80","宋"],["偈颂七十六首 其二十","释子益","四言",["欲明此道，须遇其人。","其人既遇，十倍收成。"],0,63,"宋"],["盆池吟","邵雍","四言",["有客无知，唯知不为。","不为无他，唯求不欺。","我有人是，人无我非。","因开瓮牖，遂凿盆池。","都邑地贵，江湖景奇。","能游泽国，不下堂基。","帘外青草，轩前黄陂。","壶中月落，鉴里云飞。","既有荷芰，岂无𦳓茨。","既有蝌蚪，岂无蛟螭。","亦或清浅，亦或渺弥。","亦或渌净，亦或涟漪。","风起苹藻，凉生袖衣。","林宗何在，范蠡何归。","密雪霏霏，轻冰披披。","垂柳依依，细雨微微。","可以观止，可以忘机。","可以照物，可以看时。","不乐乎我，更乐乎谁。","吾于是日，再见伏羲。"],0,"x57","宋"],["文宣王及其弟子赞 其十四","赵构","四言",["惟子有道，天与异容。","状虽云恶，德则其丰。","南止江沱，学者云从。","取士自兹，貌或非公。"],0,249,"宋"],["偈颂八十七首 其七十二","释慧开","四言",["摧邪显正，一印印定。","尽大地人，谛听谛听。"],0,65,"宋"],["偈三十五首 其十四","释祖珍","四言",["佛不远人，即心而证。","法无所著，触境皆如。"],0,155,"宋"],["元符亲郊五首 退文舞、迎武舞用《正安》。","郊庙朝会歌辞","四言",["左手执籥，右手秉翟。","进旅退旅，万舞有奕。"],0,"x207","宋"],["自赞","李迎","四言",["三仕三已，应缘而进。","一丘一壑，倦游而归。"],0,213,"宋"],["自赞 其一","释文准","四言",["我若自赞，云居罗汉。","我若自毁，无主饿鬼。","赞之不欣，毁之不嗔。","毁誉不动，东鲁西秦。"],0,254,"宋"],["偈颂一百六十九首 其十九","释智朋","四言",["禁足安居，一句直举。","匝地普天，四月十五。"],0,18,"宋"],["偈颂一百六十九首 其一五四","释智朋","四言",["即心是佛，非心非佛。","东涌西没，穿皮透骨。","十字街头，孤峰绝顶，是离窠臼，不离窠臼。"],0,18,"宋"],["偈三首 其一","释元静","四言",["君王了了，将帅惺惺。","一回得胜，六国平宁。"],0,187,"宋"],["偈颂一百二十三首 其十","释祖钦","四言",["晓天月白，古岸舟横。","一阳来复，吾道大亨。"],0,64,"宋"],["宋江三十六赞 其三十四 铁天王晁盖","龚开","四言",["毗沙天人，证紫金躯。","顽铁铸汝，亦出洪炉。"],0,103,"宋"],["对月了残经赞","释可湘","四言",["黑豆未芽，朝数暮数。","开得眼来，月圆当户。"],0,158,"宋"],["小道吟","邵雍","四言",["艺虽小道，事亦系人。","苟不造微，焉能入神。"],0,"x57","宋"],["偈颂一百零九首 其二十五","释可湘","四言",["中秋令节，升堂指月。","眨得眼来，楚天空阔。"],0,158,"宋"],["管鲍","舒岳祥","四言",["为管则易，为鲍则难。","相马失瘦，相士失寒。","管贫鲍富，坦然相安。","于利不疚，于义斯完。"],0,"x161","宋"],["偈颂十二首 其十","释如净","四言",["元正启祚，万物咸新。","伏惟大众，梅开早春。"],0,105,"宋"],["偈颂一百六十九首 其一六七","释智朋","四言",["西天此土，十万馀程。","胡言易会，汉语难明。"],0,18,"宋"],["和陶时运四首，并引 其四","苏轼","四言",["旦朝丁丁，谁款我庐。","子孙远至，笑语纷如。","剪䰂垂髫，覆此瓠壶。","三年一梦，乃复见余。"],0,"x67","宋"],["送范宣德","徐积","四言",["客有斯人，而有美质。","可养而充，其在不息。","养之以正，充之以义。","何适不可，何为弗至。"],0,"x123","宋"],["上广东漕使黄郎中  其七","曾丰","四言",["天相公生，成春收集。","充所养兮，粹乎成德。"],0,"x193","宋"],["上广东漕使黄郎中  其八","曾丰","四言",["公生京京，其器不盈。","公生裕裕，其色不矜。","不矜不盈，不与时争。","不盈不矜，不与物撄。","不撄不争，神观天清。","不争不撄，体气地宁。","天清地宁，松算椿龄。"],0,"x193","宋"],["自题小像","缪鉴","四言",["白髪苍颜，溪籐兔颖。","水月光中，梅花弄影。"],0,134,"宋"],["偈颂七十六首 其七十一","释子益","四言",["律管吹灰，勾芒布令。","六国风清，九天云静。"],0,63,"宋"],["偈颂一百三十三首 其九十七","释法薰","四言",["深闻浅悟，浅闻深悟。","只知贪程，不觉蹉路。"],0,31,"宋"],["赞四祖","释守卓","四言",["法法明心，尘尘垂手。","正出黄梅，傍生牛首。","巍巍双峰，天长地久。"],0,42,"宋"],["四圣赞 其三","释师体","四言",["稽首文殊，本非延促。","柏短松长，山青水绿。","星移斗转，日行月逐。","开眼合眼，一切具足。"],0,5,"宋"],["了翁","释妙伦","四言",["踏断草鞋，拗折拄杖。","彻底风流，匙挑不上。","拟问如何，擘面便掌。"],0,10,"宋"],["偈六十三首 其八","释道宁","四言",["真不掩伪，曲不藏直。","句里明人，言中辨的。","处处总持，头头弥勒。","拟议思量，当门荆棘。"],0,119,"宋"],["熙宁祀皇地祇十二首 其六 酌献用《和安》。","郊庙朝会歌辞","四言",["猗嗟富媪，博厚含弘。","发荣敷秀，动植兹丰。","爰酌兹酒，肸蚃交通。","众祥萃止，垂祜无穷。"],0,"x207","宋"],["四圣赞 其一","释师体","四言",["稽首释迦，现千百亿。","盐贵米贱，苦趁乐吃。","瞋喜爱憎，是非声色。","日炙风吹，一文不直。"],0,5,"宋"],["上广东漕使黄郎中  其四","曾丰","四言",["三春弸兮，中气彭兮。","季于孟仲，和之精兮。","至精收蒸，天相大明。","公生京京，集春之成。"],0,"x193","宋"],["景德祀皇地祇三首 其一 降神用《静安》。","郊庙朝会歌辞","四言",["至哉厚德，陟配天长。","沈潜刚克，广大无疆。","资生万物，神化含章。","同和八变，神灵效祥。"],0,"x207","宋"],["颂古三十八首 其八","释慧方","四言",["日面月面，头头出现。","捏聚放开，成团成片。"],0,45,"宋"],["颂古一百则 其四十二","释正觉","四言",["鸟之行空，鱼之在水。","江湖相忘，云天得志。","拟心一丝，对面千里。","知恩报恩，人间几几。"],0,"x88","宋"],["偈颂一百六十九首 其三十二","释智朋","四言",["动弦别曲，落叶知秋。","普天匝地，骑牛觅牛。"],0,18,"宋"],["偈八首 其六","释思慧","四言",["一法既通，万法无碍。","拈起笊篱，放下布袋。"],0,103,"宋"],["偈颂七十六首 其六十一","释子益","四言",["作家相见，啐啄尤乖。","达士相逢，握鞭回首。","捡点将来，已落第二。"],0,63,"宋"],["达磨大师赞","释清远","四言",["振摇梁魏，斟酌皮髓。","孰云西来，空椁而已。","素壁虚堂，少林熊耳。"],0,116,"宋"],["南山","陈谠","四言",["天造其山，在贵之阳。","二十四峰，拔地峭刚。","其山维何，如彼玉苍。","宅位于离，火德之祥。","南山何有，有方其岩。","若堂甚夷，若门者三。","穹者圆盖，植者羽参。","石像天成，匪凿匪劖。","陟彼山巅，有洞益奇。","南北户通，千里𫖯窥。","伊晋之洪，采荣于斯。","丹飞井霤，木润草滋。","昔我太宗，云章下贲。","于皇仁庙，奎文狎至。","岩处有辉，神护孔閟。","丕昭圣朝，声化远暨。","南山不骞，天子万年。","南山不朽，天子万寿。","无量惟寿，与天齐久。","小臣作诗，永飏于后。"],0,103,"宋"],["怀素千文帖赞","岳珂","四言",["鹍鹏徙海，龙蛇起陆。","思妙天随，神钟鬼哭。","垂露在手，非烟眩目。","锦绂琼机，光我韫椟。"],0,"x202","宋"],["文宣王及其弟子赞 其十五","赵构","四言",["夫孝要道，周训群生。","以纲百行，以通神明。","因子侍师，答问成经。","事亲之实，代为仪刑。"],0,249,"宋"],["和陶停云 其四","吴芾","四言",["吁嗟人世，如彼南柯。","正宜闲处，养此太和。","纵使得意，位高金多。","老不知止，宁逃谴呵。"],0,"x95","宋"],["建隆郊祀八首 其六 饮福用《禧安》。","郊庙朝会歌辞","四言",["洁兹五齐，酌彼六尊。","致诚斯至，率礼弥敦。","以介景福，永隆后昆。","重熙累洽，帝道攸尊。"],0,"x207","宋"],["休老堂铭","杨杰","四言",["妙高峰顶，不住正处。","毗耶离城，别闻一路。","铁钵铜瓶，葛巾草履。","付者不取，取者不付。","谷有归云，木凝甘露。","师子嚬伸，象王回顾。","门外老胡，一苇横度。"],0,102,"宋"],["文宣王及其弟子赞 其十三","赵构","四言",["养才以道，圣人兼济。","始谓不仁，问鲍良喜。","寓志农圃，似睽仁义。","学稼之辞，岂姑舍是。"],0,249,"宋"],["文宣王及其弟子赞 其三十八","赵构","四言",["任城建伯，其表曰选。","淑问雅驰，才华清远。","竞辰力行，爱日黾勉。","孔教崇崇，令绪显显。"],0,249,"宋"],["圣号雅二篇 其五","赵湘","四言",["天下既平，狄人既庭。","其棘匪劳，神圣以宁。","无乱斯聪，无惑斯明。","衣裳自垂，冕旒是凝。"],0,126,"宋"],["禅人写真请赞 其八","释昙华","四言",["拭眼堂前，临济正令。","且行一半，拈佛祖病。"],0,47,"宋"],["偈颂七十二首 其七十二","释祖钦","四言",["一种平怀，泯然自尽。","明暗情忘，事理平等。"],0,64,"宋"],["天时吟","邵雍","四言",["人作者事，天命者时。","时来易失，事去难追。"],0,"x57","宋"],["偈四首 其四","释鼎需","四言",["十四十五，明明已露。","更问如何，西天此土。"],0,10,"宋"],["偈颂一百三十三首 其八十九","释法薰","四言",["佛法二字，不怕烂却。","俊快衲僧，隔墙见角。","临济德山，蹉过一著。"],0,31,"宋"],["文宣王及其弟子赞 其三十五","赵构","四言",["在昔石邑，能知所尊。","懋依有德，克述无言。","鼓箧槐市，扬名里门。","此道久视，彼美长存。"],0,249,"宋"],["偈四首 其一","惠洪","四言",["举手炷香，而供养佛。","其心自知，应念获福。","举手操刀，恣行杀戮。","其心自知，死入地狱。","或杀或供，一手之功。","云何业报，罪福不同。","皆自横计，有如是事。","是故从来，枉沈生死。","雷长芭蕉，铁转磁石。","俱无作者，而有是力。","心不取境，境亦自寂。","故如来藏，不许有识。"],0,"x42","宋"],["建隆以来祀享太庙十六首 其十五 终献用《正安》。","郊庙朝会歌辞","四言",["常武徂征，诗人所称。","总干山立，厥象伊凝。"],0,"x207","宋"],["圆相赞","释智愚","四言",["黑月则隐，白月则现。","狐魅众生，乞无再面。"],0,"x153","宋"],["偈颂一百六十九首 其一六六","释智朋","四言",["夜半明星，打失眼睛。","胡人多诈，未可全凭。","遭他冤害，始报不平。"],0,18,"宋"],["上李侯","汪炎昶","四言",["贡以土作，法奠于禹。","篚纩与丝，青兖暨豫。","制有常经，无斯焉取。","世降土蹙，德不远柔。","或九州赋，萃于一州。","贸无为有，薄人于尤。","维皇启运，蠲我疾苦。","视青兖豫，不物而估。","上便下安，踵以为故。","虺蜮肆欺，蒙人瞭己。","几创茧丝，涂我赤子。","我侯曰嘻，害无我始。","蕴隆挥汗，义动省闱。","万钧回斡，民以恬熙。","匪人实难，孰心疲羸。","维此陋邦，桑稀田瘠。","苟重以此，其何能息。","自今寸缕，皆服侯德。","弭蝗固德，今兹之康。","此而非侯，篚贡是常。","吏因以蝗，厥祸弥长。"],0,181,"宋"],["偈颂一百四十一首 其一三四","释师范","四言",["二月十五，瞿昙灭度。","诸天悲泣，群魔鼓舞。"],0,"x155","宋"],["缘识 其十八","赵炅","四言",["大矣哉文，道合南薰。","包含六义，洞究三坟。","傍通造化，察变声闻。","垂其懿范，万一之分。"],0,"x63","宋"],["偈颂一百零九首 其六十二","释可湘","四言",["大化枢机，中流砥柱。","归吾掌握，当见设施。"],0,158,"宋"],["偈颂一百六十九首 其一五三","释智朋","四言",["至尊至贵，无去无来。","体若虚空，迥绝安排。"],0,18,"宋"],["戏作","邹浩","四言",["作自我作，止自我止。","莫被傍人，推倒扶起。"],0,"x157","宋"],["为黄仲宣赋山中四章章四句  其二","方回","四言",["山中之暮，岂不风雨。","心与一灯，耿耿千古。"],0,"x59","宋"],["偈颂一百零一首 其四十七","释慧性","四言",["声前一句，十方显露。","佛祖不知，衲僧罔措。"],0,46,"宋"],["偈颂一百四十一首 其三十二","释师范","四言",["摩腾入汉，平地风波。","达磨西来，重增殃祸。"],0,"x155","宋"],["偈六十九首 其五","释道宁","四言",["棋逢敌手，密行难藏。","琴遇知音，希声乃布。","摩竭正令，同道方知。","捏聚放开，悟迷一决。"],0,119,"宋"],["文宣王及其弟子赞 其六十八","赵构","四言",["雍容子皙，已望堂室。","幼则有造，成则祖述。","文采日化，儒效力弼。","永观厥成，德音秩秩。"],0,249,"宋"],["黄鲁直食面帖赞","岳珂","四言",["山谷书法，本于天才。","变而成家，如万壑崖。","骨瘦气清，霜寒籁哀。","故其言曰，法安出哉。","我师我心，奚彼之侪。","今观此书，自叶而荄。","敛其角圭，以复成才。","规矩崛奇，关机阖开。","故其跋曰，自本心来。","谁其知言，嘻噫絜斋。"],0,"x202","宋"],["偈六十九首 其八","释道宁","四言",["千圣不传，诸祖秘语。","不惜眉毛，为君亲举。","衲子抬眸，白云万里。"],0,119,"宋"],["偈颂一百三十三首 其一一一","释法薰","四言",["禁足护生，西天此土。","尽是死门，终非活路。"],0,31,"宋"],["辞世偈","释妙印","四言",["六十九年，一场大梦。","归去来兮，珍重珍重。"],0,112,"宋"],["偈颂一百零一首 其三十三","释慧性","四言",["摇唇鼓舌，展事投机。","千佛出世，不通忏悔。","焦巴焦巴，有叶无丫。","长天秋水，孤鹜落霞。"],0,46,"宋"],["明月  其一","陈杰","四言",["悠悠明月，载盈载缺，我酒在室。"],0,174,"宋"],["偈颂一百四十一首 其二十一","释师范","四言",["衲僧用处，了无定度。","握土成金，握金成土。"],0,"x155","宋"],["我客至止","苏洵","四言",["我客至止，我逆于门。","来升我堂，来饮我樽。","羞鳖不时，詈我不勤。","求我何多，请辞不能。","客谓主人，唯子我然。","求子之多，责子之深，期子于贤。"],0,70,"宋"],["文宣王及其弟子赞 其六十九","赵构","四言",["东平子产，性著盛时。","奉师于塾，讲道之微。","答问其敏，婉妙以思。","升降陛廉，尚想英姿。"],0,249,"宋"],["佛米赞","饶节","四言",["时平主圣，万国自靖。","不杀而成，不征而正。","矫矫虎臣，无所用命。","移将东南，介我佛会。","久闻吾曹，念佛三昧。","喑呜叱咤，化为佛声。","三令五申，易为佛名。","一佛一米，为米三升。","自升而斗，自斗而斛。","念之无穷，太仓不足。"],0,28,"宋"],["偈颂一百四十一首 其五十八","释师范","四言",["一冬二冬，叉手当胸。","珠钻九曲，直在其中。"],0,"x155","宋"],["为黄仲宣赋山中四章章四句  其一","方回","四言",["山中之朝，有溪可瓢。","饮我之水，亦逍以遥。"],0,"x59","宋"],["双柳","苏辙","四言",["我作新堂，中庭萧然，双柳对峙。","春阳既应，千条万叶，风濯雨洗。","如美妇人，正立栉发，发长至地。","微风徐来，掩冉相缪，乱而复理。","垂之为缨，绾之为结，屈伸如意。","燕雀翔舞，蜩蜇嘶鸣，不召而至。","清霜夜落，众叶如剪，颜色憔悴。","永愧松柏，岁寒不改，见叹夫子。","聊同渊明，攀条啸咏，得酒径醉。","一廛粗给，三黜不去，亦如展惠。"],0,"x135","宋"],["醇碧颂","黄庭坚","四言",["田子绿曲，妙在蒸蓼。","女酒兀者，美生其手。","挹彼而清，注兹无声。","其香馥郁，悦可饮者。","如春霡霂，清不病醨。","多不疾人，谁其吐之。","百室之醅，醇碧惟师。","老夫不饮，评以鼻慧。"],0,"x66","宋"],["偈三十五首 其二十八","释祖珍","四言",["有句无句，如藤倚树。","眼睛定动，失却巴鼻。"],0,155,"宋"],["孝宗明堂前享太庙三首 其二 高宗室用《大德》。","郊庙朝会歌辞","四言",["于皇时宋，自天保定。","高宗受之，再仆景命。","绍开中兴，翼善传圣。","何千万年，永绥厥庆。"],0,"x207","宋"],["绍兴亲享明堂二十六首 其二十三 送神用《诚安》。","郊庙朝会歌辞","四言",["奕奕宗祀，煌煌礼文。","高灵下堕，精意升闻。","熙事既毕，忽乘青云。","敢拜明贶，永清世氛。"],0,"x207","宋"],["偈颂一百二十三首 其十二","释崇岳","四言",["妙用纵横，十方坐断。","未谙此脉，举步犹难。"],0,222,"宋"],["偈颂二十二首 其九","释妙伦","四言",["渚流虹影，枢绕电光。","圣人出现，化洽殊方。"],0,10,"宋"],["偈二十四首 其六","释守卓","四言",["开眼即迷，闭眼即错。","古佛巴鼻，何处摸索。"],0,42,"宋"],["顿庵 其一","释慧空","四言",["万行不修，僧祇不历。","千佛数中，位居第一。"],0,"x118","宋"],["文宣王及其弟子赞 其五十九","赵构","四言",["人有贤否，道有废兴。","子如命何，营营震惊。","季孙虽惑，景伯莫平。","师资一言，秩祀亦惩。"],0,249,"宋"],["宋颂九首 其四 六合雷声","石介","四言",["旧是匈奴，为并左臂。","今附有德，不与贼子。","并人失恃，求就戮死。"],0,105,"宋"],["颂古二十一首 其二十一","释心月","四言",["龙起沧海，虎出林端。","直下来也，急著眼看。"],0,188,"宋"],["乾道七年恭上太上皇帝太上皇后尊号十一首 其二 中书令、侍中奉册宝诣殿下用《正安》。","郊庙朝会歌辞","四言",["宗郊斯成，交举典册。","汝辅汝弼，威仪是力。","陈于广庭，迨此上日。","巍巍煌煌，乌睹在昔。"],0,"x207","宋"],["安分吟","邵雍","四言",["轻得易失，多谋少成。","德无尽利，善无近名。"],0,"x57","宋"],["建隆以来祀享太庙十六首 其六 奉俎用《丰安》。","郊庙朝会歌辞","四言",["维牺维牲，以炰以烹。","植其鼗鼓，洁彼铏羹。","孔硕兹俎，于穆厥声。","肃雍显相，福禄来成。"],0,"x207","宋"],["冬至孟春孟夏季秋四祀上公摄事七首 司徒奉俎用《丰安》。","郊庙朝会歌辞","四言",["礼崇禋祀，神鉴孔明。","牲牷博腯，以炰以烹。","馨香蠲洁，品物惟精。","锡以纯嘏，享兹至诚。"],0,"x207","宋"],["哲宗传受国宝三首 其一","郊庙朝会歌辞","四言",["于穆我王，继序不忘。","明昭上帝，上帝是皇。","长发其祥，惠我无疆。","受命于天，既寿永昌。"],0,"x207","宋"],["文文山画像赞","刘辰翁","四言",["闲居忽忽，万古咄咄。","天风惨然，如动生发。","如何寻约，亦念束刍。","岂其英爽，犹累形躯。","同时之人，能不颡泚。","昔忌其生，今妒其死。"],0,"x164","宋"],["偈颂一百三十三首 其五十三","释居简","四言",["门对庐山，岸横湓浦。","把定要津，鸦飞不渡。"],0,"x94","宋"],["景祐祀感生帝二首 其二 酌献用《肃安》。","郊庙朝会歌辞","四言",["龙德而隐，源流则长。","宜乎亿祀，侑享弥昌。"],0,"x207","宋"],["忠烈诗","徐积","四言",["在昔皇祐，蛮党交构。","聚为伏枭，起为攫兽。","出人不意，其锋甚锐。","州无敌兵，城无守备。","所在奔亡，贼势益张。","横身捍蔽，爰有晋康。","羸兵数百，摧坚沮敌。","殊死血战，气吞逆贼。","按剑一呼，眦裂吻拆。","凶焰方炽，公方虎视。","人方忧死，饱食鼾睡。","勇如项籍，哀歌恻恻，为虞姬泣。","康州不然，忘其妻息。","猛如敖曹，强梁粗豪，伏藏于桥。","康州不然，坐叱凶妖。","李陵壮夫，终降匈奴，老母何辜。","颜鲁虽贤，所守不坚，大节不全。","奇哉康州，其勇绝类。","以义配勇，其本在内。","不动如山，不倾如地。","何物可摇，何兵可制。","如令不死，社稷所恃。","如令复生，可备宿卫。","佩刀骖乘，势戟殿陛。","用之朝廷，朝廷之纲。","使当一面，胜于金汤。","无疆无界，人迹鬼方。","知有斯人，中国之光。","若斯人者，决不徇利。","肝胆可沥，头璧可碎。","生乎由是，死乎由是。","生亦可贵，死亦可贵。","死而有子，时方三岁。","死中得活，此乃天意。","使世其家，世为忠义。","子子孙孙，永不失坠。","我为此诗，激励万世。"],0,"x123","宋"],["宋颂九首 其六 六合雷声","石介","四言",["往在艺祖，未遑拓㝢。","遗我圣宗，启此北土。","敢告太庙，惟皇孝武。"],0,105,"宋"],["皇后庙十五首 其十四 终献用《顺安》。","郊庙朝会歌辞","四言",["荐献有终，礼容斯穆。","以奉嘉觞，以膺多福。"],0,"x207","宋"],["颂古十七首 其十六","释师观","四言",["佛法王法，更无两样。","直下一刀，未为谛当。"],0,210,"宋"],["偈颂一百六十九首 其一五八","释智朋","四言",["贫到无锥，正好进步。","王舍城中，有条活路。","一声金锡，千门万户。","全放全收，全宾全主。","多宝如来，何曾过去。"],0,18,"宋"],["久旱吟","邵雍","四言",["久旱望雨，久雨思晴。","天之常道，人之常情。"],0,"x57","宋"],["偈十三首 其十","释慧空","四言",["一沤未起，古帆未挂。","风信不来，无人举棹。"],0,"x118","宋"],["雪峰真觉禅师赞","释心月","四言",["出岭超方，九上三到。","一槌便成，未是性燥。","诵过水偈，闻色空义。","搅炒肝肠，睡不成睡。","棒头领旨，句下明宗。","夜半鳌山，如鹤抛笼。","象骨岩高，中有鳖鼻。","千五百人，中伤者几。","三毬并辊，大用全提。","石火莫及，电光罔追。","大地撮来，如粟米粒。","今昔行人，看之不出。","望州乌石，日炙风吹。","万福曾郎，眼戴双眉。"],0,188,"宋"],["偈颂一百二十三首 其九十四","释祖钦","四言",["元宵令节，且喜天晴。","高烧银烛，照佛光明。"],0,64,"宋"],["三界唯心万法唯识","释守卓","四言",["三界唯心，海岳销沈。","万法唯识，青黄曲直。","天上人间，乃规乃则。","眼耳即真，见闻俱惑。","孰为言宣，讵假玄默。","混尔圆常，分尔百亿。","迷悟不来，尘毛匪忒。"],0,42,"宋"],["偈二十四首 其七","释守卓","四言",["会与不会，拈却一对。","直截如何，风不鸣条，雨不破块。"],0,42,"宋"],["颂古 其九十七","释道颜","四言",["时时日日，日日时时。","七颠八倒，孰是孰非。"],0,47,"宋"],["宋颂九首 其五 六合雷声","石介","四言",["抚我则怀，并人肯来。","降旗出城，并门夜开。","并土既平，吾王休哉。"],0,105,"宋"],["朝阳三章  其三","袁甫","四言",["日之出矣，万象光明。","凤之仪矣，箫韶之音。","观彼仪凤，以观我生。","生生不息，匪亏匪盈。","面此朝阳，默养和平。"],0,229,"宋"],["怀素秋风帖赞","岳珂","四言",["憭栗之秋，骚人所悲。","彼僧何为，乃写以辞。","绝艺出尘，亦寄焉耳。","云烟苍茫，在此幅纸。"],0,"x202","宋"],["偈颂六十五首 其二","释普济","四言",["大包虚空，细入无间。","突出当阳，如何履践。"],0,73,"宋"],["偈颂九十三首 其五十三","释梵琮","四言",["据此座者，说无味话。","上下三指，彼此七马。"],0,100,"宋"],["颂古三十一首 其三十一","释如本","四言",["匙挑不上，箸拨不开。","合掌赞言，善哉善哉。"],0,205,"宋"],["偈颂一百二十三首 其八","释普度","四言",["龙门万仞，到者还稀。","不犯清波，如何进步。"],0,144,"宋"],["强斋高使君金书诸经赞","释居简","四言",["淀蓝蘸楮，屑金作字。","去字与楮，经果何似。","曰此诸经，即楮与金。","续父厥志，写佛语心。","惟佛语心，粤如父志。","一点画中，具无量义。","字可悉数，义则无量。","欲了其源，冥去来相。","强斋大士，年八十馀。","目如心明，作蝇头书。","于一蝇头，分可为二。","尘毛太华，弗巨弗细。","佛神力故，初不作难。","是故北涧，作如是观。"],0,"x94","宋"],["偈颂一百二十三首 其八十六","释崇岳","四言",["有句无句，如藤倚树。","孟八郎汉，便恁么去。","苏噜苏噜。"],0,222,"宋"],["偈颂一百二十三首 其一二三","释崇岳","四言",["达磨达磨，不识这个。","直指单传，胡挥乱做。"],0,222,"宋"],["李运使赞","惠洪","四言",["风度凝远，和气如春。","绿发授道，精敏绝伦。","名冠缙绅，挺然忠义。","知国知兵，如唐陆贽。","顷者天府，奉使江南。","昼锦之荣，父老聚观。","顿节西州，盗发江浙。","提师百万，荡其窟穴。","凯旋而还，口不言功。","但欲使民，生于死中。","重临南楚，化行郡邑。","如春在花，不见痕迹。","恢躁坦夷，易亲难忘。","视其胸次，山包海藏。","宜宿玉堂，宜在黄阁。","跬步可待，昂霄耸壑。","长沙之民，自怀其私。","龛此画像，饮食必祠。"],0,"x42","宋"],["偈颂二十五首 其十九","释智愚","四言",["春风如刀，春雨如膏。","衲僧门下，何用忉忉。"],0,"x153","宋"],["文宣王及其弟子赞 其十六","赵构","四言",["子长宏度，高出伦辈。","虽在缧绁，知非其罪。","纯德备行，夫子所采。","以子妻之，尤知英概。"],0,249,"宋"],["偈颂一百三十三首 其二十七","释法薰","四言",["一言道尽，却成两橛。","击鼓升堂，子承父业。"],0,31,"宋"],["偈颂七十六首 其十一","释师观","四言",["断人性命，不劳馀刃。","四海一家，风恬浪静。"],0,210,"宋"],["祫享八首 初献、顺祖酌献用《大宁》。","郊庙朝会歌辞","四言",["于赫皇祖，浚发其祥。","德盛流远，奕世弥昌。","孝孙有庆，嘉荐令芳。","神保是享，锡羡无疆。"],0,"x207","宋"],["偈颂七十六首  其七四","释师范","四言",["扰扰怱怱，晨鸡暮钟。","瑞岩不会，唤主人翁。"],0,"x155","宋"],["颂古四十八首 其四十五","释慧开","四言",["他弓莫挽，他马莫骑。","他非莫辨，他事莫知。"],0,65,"宋"],["妙湛禅师月岩舍利赞","释居简","四言",["及笄洗妆，一花一香。","舍父求度，回度厥父。","父子学空，机先有锋。","父死开法，镆铘出匣。","归奉其母，孤山之浒。","示生有灭，笑与母诀。","火后舍利，粲如繁星。","如金之晶，如玉之明。","堂堂月岩，如空行月。","何庸留此，自暴丑拙。"],0,"x94","宋"],["宣律师赞","惠洪","四言",["此毗尼藏，三世完坚。","愿王手封，款识具全。","死生之烈，不能变迁。","何以至之，正知则然。","何人逸想，以笔墨传。","跏趺俯视，颓然深渊。","天神护持，弟子敬虔。","我拜稽首，泪滴九泉。","法道凌夷，障云盖缠。","乃于是时，瞻此释天。"],0,"x42","宋"],["题赵鸥波高士图","钱仲鼎","四言",["在昔洛阳，雪深丈馀。","士也高卧，来令尹车。","今年吴淞，雪复何如。","积素一色，鸥鹭有无。","之子江皋，修亭是居。","有琴有书，有酒有鱼。","赏静独眺，聊以自娱。","挹兹清风，凛凛起予。","此景此图，再卷再舒。"],0,219,"宋"],["夕月三首 其三 送神用《高安》。","郊庙朝会歌辞","四言",["夙陈笾豆，洁诚致祈。","垂休保佑，景祚巍巍。"],0,"x207","宋"],["春日  其三","陈杰","四言",["翩翩黄鸟，载好其羽。","鲜鲜游子，式歌且舞。","曾孙万年，敬我有土。"],0,174,"宋"],["畴依  其一三","王柏","四言",["至哉子思，忧道失传。","推本遗训，中庸一编。","提挈纲维，开示蕴奥。","无声无臭，孰窥其妙。"],0,"x137","宋"],["得失吟","邵雍","四言",["人有贤愚，事无巨细。","得不艰难，失必容易。"],0,"x57","宋"],["偈颂一百二十三首 其三十五","释崇岳","四言",["荐福住院，事事成现。","露柱灯笼，三门佛殿。","若上若下，和光同尘。","有时又却，神头鬼面。"],0,222,"宋"],["疏黑白无从","释重显","四言",["天地不仁，万化蠢蠢。","若谓非缘，竹何从笋。","发兮发兮，黑白是准。"],0,"x156","宋"],["颂古三十八首 其六","释慧方","四言",["布毛一吹，当下知归。","冷光遍地，独露针锥。"],0,45,"宋"],["偈颂一百零三首  其二七","释月涧","四言",["击鼓升堂，分明指示。","冬至月尾，卖牛买被。"],0,91,"宋"],["山行见月作 其二","赵蕃","四言",["意行何之，陟此云岭。","如梦而觉，如昏而醒。"],0,"x36","宋"],["盘居六章  其一","项安世","四言",["宝峰之阴，其山深深。","有美一人，琼弁玉簪。"],0,"x55","宋"],["偈颂八十五首 其十一","释妙伦","四言",["布袋打开，拄杖拈起。","去也由你，住也由你。"],0,10,"宋"],["苏文忠归颍帖赞","岳珂","四言",["事师之情，期以百世。","言虽不多，意则独至。","识以岁月，越王之孙。","式时览观，用考大伦。"],0,"x202","宋"],null,["黄鲁直催绣词帖赞","岳珂","四言",["词以寓意，何适非理。","游戏翰墨，亦或张弛。","此篇所传，观蜡之比。","乐而不淫，庶几在此。"],0,"x202","宋"],["偈颂二十五首 其五","释如净","四言",["有问有答，屎尿狼藉。","无问无答，雷霆霹雳。"],0,105,"宋"],["偈颂七十二首 其四十五","释祖钦","四言",["动即影现，觉即冰生。","见闻俱尽，视听如盲。"],0,64,"宋"],["文宣王及其弟子赞 其四十一","赵构","四言",["至圣立教，子祺安雅。","擅誉鲁邦，启祚钜野。","炜矣风猷，时哉用舍。","出伦离类，后学是假。"],0,249,"宋"],["圆寂庵铭","杨杰","四言",["万法一源，万念一息。","法无不圆，念无不寂。","强名而名，车尘马迹。","是庵何如，风清月白。"],0,102,"宋"],["偈二十四首 其三","释守卓","四言",["真不掩伪，开眼瞌睡。","曲不藏直，犹较些子。","鱼目明珠，都卢在汝。","更拟如何，未敢相许。"],0,42,"宋"],["偈颂七十二首 其二十八","释祖钦","四言",["电光莫追，石火犹迟。","搆弗及处，心不可识，智不可知。"],0,64,"宋"],["方丘乐歌 其一","郊庙朝会歌辞","四言",["至哉坤仪，万汇资生。","称物平施，流谦变盈。","礼修泰折，祭极精诚。","皇皇灵眷，永奠寰瀛。"],0,"x207","宋"],["颂古五首 其四","释守仁","四言",["锯解秤锤，油煎石磉。","两手擎来，有功者赏。"],0,198,"宋"],["禅宗无门关总颂","释慧开","四言",["大道无门，千差有路。","透得此关，乾坤独步。"],0,65,"宋"],["方丘乐歌 其四","郊庙朝会歌辞","四言",["礼行方泽，文物备举。","惟皇地祇，昭格来下。","奠瘗玉帛，纯诚内著。","神保是享，陟降斯祐。"],0,"x207","宋"],["答问颂五首 其一","释守卓","四言",["有宾有主，父子规程。","子无线索，妙辨纵横。"],0,42,"宋"],["偈颂七十二首 其九","释祖钦","四言",["白衣拜相，平地登仙。","是人知有，别无秘传。"],0,64,"宋"],["偈颂七十二首 其二十二","释祖钦","四言",["吃饭著衣，事事成现。","俯仰折旋，一见便见。"],0,64,"宋"],["颂古一百首 其三十一","释智愚","四言",["不落因果，突出野狐。","人心似铁，官法如炉。","不昧因果，得脱野狐。","顶上无骨，颔下有须。"],0,"x153","宋"],["方丘乐歌 其二","郊庙朝会歌辞","四言",["礼有五经，无先祭礼。","即时伸虔，惟时盥洗。","品物吉蠲，威仪济济。","锡之纯嘏，来歆恺悌。"],0,"x207","宋"],["景德以后祀五方帝十六首 其三 送神用《高安》。","郊庙朝会歌辞","四言",["备物致用，荐羞神明。","礼成乐举，克享克禋。"],0,"x207","宋"],["景德以后祀五方帝十六首 其七 送神用《高安》。","郊庙朝会歌辞","四言",["笾豆有践，黍稷惟馨。","礼终三献，神归杳冥。"],0,"x207","宋"],["景德以后祀五方帝十六首 其十 送神用《高安》。","郊庙朝会歌辞","四言",["土德居中，方舆配位。","乐以送神，式申昭事。"],0,"x207","宋"],["景德以后祀五方帝十六首 送神用《高安》。","郊庙朝会歌辞","四言",["飚轮戾止，景烛灵坛。","金奏绎如，白露漙漙。"],0,"x207","宋"],["景德以后祀五方帝十六首 其十六 送神用《高安》。","郊庙朝会歌辞","四言",["管磬咸和，礼献斯毕。","灵驭言旋，神降之吉。"],0,"x207","宋"],["偈颂一百二十三首 其五","释祖钦","四言",["济北之道，出乎平常。","语默动静，脱体全彰。","三玄三要，松直棘曲。","四宾四主，凫短鹤长。"],0,64,"宋"],["偈颂七十二首 其六十七","释祖钦","四言",["寸长尺短，三平二满。","觌面相呈，语言道断。"],0,64,"宋"],["偈颂七十二首 其二十四","释祖钦","四言",["山花似锦，涧水如蓝。","面目现在，谁是同参。"],0,64,"宋"],["赞护教 其四 关王","释印肃","四言",["困权反正，办道玉泉。","无相无空，义足先天。"],0,"x121","宋"],["六世祖师画像赞 六祖","惠洪","四言",["是风幡动，眼自遮护。","非风幡动，心则显露。","是谓曹溪，显及要旨。","欲证之者，勿留汝意。","暂时敛念，妙寂了然。","汝自受用，密非我边。","负石舂粮，趁獐逐兔。","镜中之空，欲寻无路。"],0,"x42","宋"],["庆元二年皇后册宝十三首 其七","郊庙朝会歌辞","四言",["翚珩焕采，趋节风韶。","陟降墄陛，奉将英瑶。","辟道承薰，嫔仪扬翘。","是敬是祗，德音孔昭。"],0,"x207","宋"],["和陶归鸟 其三","吴芾","四言",["翩翩归鸟，虑患徘徊。","四顾万里，独有故栖。","故栖来反，所愿已谐。","毋思寥廓，扰扰此怀。"],0,"x95","宋"],["望故庐一首","周紫芝","四言",["龟城去江，邈在一隅。","我家龟舫，亦足轩渠。","草耕木茹，瓮牖蓬枢。","有客二人，寔邀望舒。","长须之奴，玉川之庐。","何必仙去，方丈蓬壶。","何必校书，起居何如。","无祸为福，徐行当车。","我乎谁交，谁乎我徒。","春蛙嘈杂，夏木扶疏。","大盗遽起，山摧海枯。","我焚其巢，将焉适欤。","善刀而藏，为之踟蹰。","望我故处，宛其在涂。","我友云亡，云谁与娱。","愿洗甲兵，肉四海臞。","奠我新宅，以饱三馀。"],0,"x139","宋"],["明月  其二","陈杰","四言",["皎皎明月，载缺载盈，我酒在庭。"],0,174,"宋"],["皇雅十首  其二九","尹洙","四言",["前世理官，倚法以刻。","匪彼为仇，盖曰任职。","今之蔽狱，务正其辟。","鉴于前人，繄我仁德。"],0,108,"宋"],["偈颂七十二首 其三十四","释祖钦","四言",["人与境空，境与人会。","百尺竿头，一采两赛。"],0,64,"宋"],["偈颂七十二首 其六十一","释祖钦","四言",["动即影现，拂即成痕。","听其自在，万法无根。"],0,64,"宋"],["偈颂七十二首 其六十三","释祖钦","四言",["形名未立，朕兆未分。","全无巴鼻，彻底浑仑。"],0,64,"宋"],["彼莲之美  其三","曾丰","四言",["厥华尚赤，故为火德。","厥德靡常，虚室生白。"],0,"x193","宋"],["偈颂七十二首 其四十七","释祖钦","四言",["本无位次，不涉安排。","泯然自尽，一种平怀。"],0,64,"宋"],["盘居六章  其二","项安世","四言",["云居之阳，其水洋洋。","有美一人，霞衣月裳。"],0,"x55","宋"],["偈颂一百四十一首  其一○七","释师范","四言",["二由一有，一亦莫守。","一心不生，万法无咎。"],0,"x155","宋"],["荐席","释慧开","四言",["乱草窠中，打成一片。","坐卧寂然，真机顿现。"],0,65,"宋"],["文宣王及其弟子赞 其二十六","赵构","四言",["遐想子期，挟策圣帷。","涉道是嗜，惟士可縻。","在德既贤，在名乃垂。","洋洋之风，逮今四驰。"],0,249,"宋"],["仁宗皇帝二诗御汉体书赞","岳珂","四言",["鸿荒有开，昉颉鸟迹。","字学之兴，亦既象物。","汉有议郎，曰臣蔡邕。","帛书发奇，出淳古踪。","千龄寥寥，嗣响逾邈。","贞观御床，淳化秘阁。","云汉之章，施于仁皇。","厥维天葩，源宋跨唐。","万几燕闲，成是肆笔。","弛张异用，游戏如一。","士俗之成，玄默自躬。","见于首篇，尚䌹之风。","安不忘危，尤示注意。","笔墨之馀，又形拊髀。","庆历之治，太平极功。","帝心所存，天地与同。","春朝鸣珂，秋塞沈柝。","一视之仁，昭此圣学。","海岳八极，羲娥九霄。","媲于宝藏，万世见尧。"],0,"x202","宋"],["颂古三十三首 其二十一","释师观","四言",["拈得便用，胡麻厮缴。","冷地看来，知恩者少。"],0,210,"宋"],["愿成四胜深心偈","晁迥","四言",["豁然悟空，了然见性。","凝然不动，寂然无思。"],0,199,"宋"],["颂古三首  其三","释钦","四言",["有句无句，明来暗去。","活捉生擒，捷书露布。","如藤倚树，物以类聚。","海外人参，蜀中附子。","树倒藤枯，切忌名模。","句归何所，苏𠰷苏𠰷。","呵呵大笑，破镜不照。","大地茫茫，一任𨁝跳。"],0,219,"宋"],["诫子吟","邵雍","四言",["鸡能警旦，马能代行。","犬能守御，牛能力耕。","人禀天地，万物之灵。","妒贤嫉能，不如不生。"],0,"x57","宋"],["文宣王及其弟子赞 其七十二","赵构","四言",["彭衙高士，经籍是亲。","赞成德艺，协于彝伦。","厎绩圣道，斯肖素臣。","优哉游哉，学以致身。"],0,249,"宋"],["淳熙三年发皇后册宝十三首 其十","郊庙朝会歌辞","四言",["葛覃节用，樛木逮下。","形为嫔则，夙已心化。","兹临长秋，遂正诸夏。","以庆以祈，百祥来迓。"],0,"x207","宋"],["和陶归鸟 其四","吴芾","四言",["翩翩归鸟，顾影萧条。","亦既休息，敛此风标。","仍遇俦匹，其鸣交交。","营巢虽苦，亦复亡劳。"],0,"x95","宋"],["偈颂九十三首 其五十五","释梵琮","四言",["旧店重开，全无买卖。","拟欲近前，知君纳败。"],0,100,"宋"],["庆元二年皇后册宝十三首 其八","郊庙朝会歌辞","四言",["帝奉太室，后仪成之。","帝养三宫，后志承之。","德如关雎，盛如螽斯。","宜君宜王，百世本支。"],0,"x207","宋"],["偈六十三首 其五十五","释道宁","四言",["大道皎然，本无迷悟。","杳忘三际，超越上乘。","透古透今，非玄非妙。","通同法界，一种平怀。","古路无私，何人措足。"],0,119,"宋"]]