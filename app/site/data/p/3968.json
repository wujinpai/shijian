[["任昉引古诗论魏武陵","佚名","隋",["石犬不可吠。","铜驼徒尔为。"],{"ad":"隋"},"x239","隋"],["任昉引古诗论香泉","佚名","隋",["安得香水泉，濯朗衣上尘。"],{"ad":"隋"},"x239","隋"],["陌上桑","佚名","隋",["日出秦楼明，条垂露尚盈。","蚕饥心自急，开奁妆不成。"],{"ad":"隋"},"x239","隋"],["攀杨枝","佚名","隋",["自从别君来，不复著绫罗。","画眉不注口，施朱当柰何。"],{"ad":"隋"},"x239","隋"],["乐府诗","佚名","隋",["梧宫秋。","吴王愁。"],{"ad":"隋"},"x239","隋"],["企喻歌 其二","佚名","隋",["放马大泽中，草好马著膘。","牌子铁裲裆，?矛鸐尾条。"],{"ad":"隋"},"x239","隋"],["企喻歌 其三","佚名","隋",["前行看后行，齐著铁裲裆。","前头看后头，齐著铁?矛。"],{"ad":"隋"},"x239","隋"],["琅琊王歌辞 其二","佚名","隋",["琅琊复琅琊，琅琊大道王。","阳春二三月，单衫绣裲裆。"],{"ad":"隋"},"x239","隋"],["琅琊王歌辞 其三","佚名","隋",["东山看西水，水流盘石间。","公死姥更嫁，孤儿甚可怜。"],{"ad":"隋"},"x239","隋"],["琅琊王歌辞 其四","佚名","隋",["琅琊复琅琊，琅琊大道王。","鹿鸣思长章，愁人思故乡。"],{"ad":"隋"},"x239","隋"],["琅琊王歌辞 其五","佚名","隋",["长安十二门，光门最妍雅。","渭水从垄来，浮游渭桥下。"],{"ad":"隋"},"x239","隋"],["琅琊王歌辞 其六","佚名","隋",["琅琊复琅琊，女郎大道王。","孟阳三四月，移铺逐阴凉。"],{"ad":"隋"},"x239","隋"],["琅琊王歌辞 其七","佚名","隋",["客行依主人，愿得主人强。","猛虎依深山，愿得松柏长。"],{"ad":"隋"},"x239","隋"],["琅琊王歌辞 其八","佚名","隋",["𢙓马高缠鬃，遥知身是龙。","谁能骑此马，唯有广平公。"],{"ad":"隋"},"x239","隋"],["钜鹿公主歌辞 其一","佚名","隋",["官家出游雷大鼓。","细乘犊车开后户。"],{"ad":"隋"},"x239","隋"],["钜鹿公主歌辞 其二","佚名","隋",["车前女子年十五。","手弹琵琶玉节舞。"],{"ad":"隋"},"x239","隋"],["钜鹿公主歌辞 其三","佚名","隋",["钜鹿公主殷照女。","皇帝陛下万几主。"],{"ad":"隋"},"x239","隋"],["紫骝马歌辞 其一","佚名","隋",["烧火烧野田，野鸭飞上天。","童男娶寡妇，壮女笑杀人。"],{"ad":"隋"},"x239","隋"],["紫骝马歌辞 其二","佚名","隋",["高高山头树，风吹叶落去。","一去数千里，何当还故处。"],{"ad":"隋"},"x239","隋"],["紫骝马歌辞 其四","佚名","隋",["遥看是君家，松柏冢累累。","兔从狗窦入，雉从梁上飞。"],{"ad":"隋"},"x239","隋"],["紫骝马歌辞 其五","佚名","隋",["中庭生旅谷，井上生旅葵。","舂谷持作饭，采葵持作羹。"],{"ad":"隋"},"x239","隋"],["紫骝马歌辞 其六","佚名","隋",["羹饭一时熟，不知饴阿谁。","出门东向望，泪落沾我衣。"],{"ad":"隋"},"x239","隋"],["紫骝马歌","佚名","隋",["独柯不成树，独树不成林。","念郎锦裲裆，恒长不忘心。"],{"ad":"隋"},"x239","隋"],["黄淡思歌 其一","佚名","隋",["归归黄淡思，逐郎还去来。","归归黄淡百，逐郎何处索。"],{"ad":"隋"},"x239","隋"],["黄淡思歌 其二","佚名","隋",["心中不能言，腹作车轮旋。","与郎相知时，但恐傍人闻。"],{"ad":"隋"},"x239","隋"],["黄淡思歌 其三","佚名","隋",["江外何郁拂，龙洲广州出。","象牙作帆樯，绿丝作帏𫄴。"],{"ad":"隋"},"x239","隋"],["黄淡思歌 其四","佚名","隋",["绿丝何葳蕤。","逐郎归去来。"],{"ad":"隋"},"x239","隋"],["地驱乐歌 其一","佚名","隋",["青青黄黄，雀石颓唐。","槌杀野牛，押杀野羊。"],{"ad":"隋"},"x239","隋"],["地驱乐歌 其二","佚名","隋",["驱羊入谷，自羊在前。","老女不嫁，蹋地唤天。"],{"ad":"隋"},"x239","隋"],["地驱乐歌 其三","佚名","隋",["侧侧力力，念君无极。","枕郎左臂，随郎转侧。"],{"ad":"隋"},"x239","隋"],["地驱乐歌 其四","佚名","隋",["摩将郎须，看郎颜色。","郎不念女，不可与力。"],{"ad":"隋"},"x239","隋"],["地驱乐歌","佚名","隋",["月明光光星欲堕。","欲来不来早语我。"],{"ad":"隋"},"x239","隋"],["雀劳利歌辞","佚名","隋",["雨雪霏霏雀劳利。","长觜饱满觜饥。"],{"ad":"隋"},"x239","隋"],["慕容垂歌辞三曲 其一","佚名","隋",["慕容攀墙视，吴军无边岸。","我身分自当，枉杀墙外汉。"],{"ad":"隋"},"x239","隋"],["慕容垂歌辞三曲 其二","佚名","隋",["慕容愁愤愤，烧香作佛会。","愿作墙里燕，高飞出墙外。"],{"ad":"隋"},"x239","隋"],["慕容垂歌辞三曲 其三","佚名","隋",["慕容出墙望，吴军无边岸。","咄我臣诸佐，此事可惋叹。"],{"ad":"隋"},"x239","隋"],["陇头流水歌 其二","佚名","隋",["西上陇阪，羊肠九回。","山高谷深，不觉脚酸。"],{"ad":"隋"},"x239","隋"],["陇头流水歌 其三","佚名","隋",["手攀弱枝。","足逾弱泥。"],{"ad":"隋"},"x239","隋"],null,["陇头歌辞 其二","佚名","隋",["朝发欣城，暮宿陇头。","寒不能语，舌卷入喉。"],{"ad":"隋"},"x239","隋"],null,["隔谷歌 其一","佚名","隋",["兄在城中弟在外。","弓无弦。","箭无栝。","食粮乏尽若为活。","救我来。","救我来。"],{"ad":"隋"},"x239","隋"],["隔谷歌 其二","佚名","隋",["兄为俘虏受困辱。","骨露力疲食不足。","弟为官吏马食粟。","何惜钱刀来我赎。"],{"ad":"隋"},"x239","隋"],["淳于王歌 其一","佚名","隋",["肃肃河中育，育熟须含黄。","独坐空房中，思我百媚郎。"],{"ad":"隋"},"x239","隋"],["淳于王歌 其二","佚名","隋",["百媚在城中，千媚在中央。","但使心相念，高城何所妨。"],{"ad":"隋"},"x239","隋"],["东平刘生歌","佚名","隋",["东平刘生安东子。","树木稀。","屋里无人看阿谁。"],{"ad":"隋"},"x239","隋"],["捉搦歌 其一","佚名","隋",["粟谷难舂付石臼。","弊衣难护付巧妇。","男儿千凶饱人手。","老女不嫁只生口。"],{"ad":"隋"},"x239","隋"],["捉搦歌 其二","佚名","隋",["谁家女子能行步。","反著夹禅后裙露。","天生男女共一处。","愿得两个成翁妪。"],{"ad":"隋"},"x239","隋"],["捉搦歌 其三","佚名","隋",["华阴山头百丈井。","下有流水彻骨冷。","可怜女子能照影。","不见其馀见斜领。"],{"ad":"隋"},"x239","隋"],["捉搦歌 其四","佚名","隋",["黄桑柘屐蒲子履。","中央有丝两头系。","小时怜母大怜婿。","何不早嫁论家计。"],{"ad":"隋"},"x239","隋"],["折杨柳歌辞 其一","佚名","隋",["上马不捉鞭，反折杨柳枝。","蹀座吹长笛，愁杀行客儿。"],{"ad":"隋"},"x239","隋"],["折杨柳歌辞 其二","佚名","隋",["腹中愁不乐，愿作郎马鞭。","出入擐郎臂，蹀座郎膝边。"],{"ad":"隋"},"x239","隋"],["折杨柳歌辞 其三","佚名","隋",["放马两泉泽，忘不著连羁。","担鞍逐马走，何见得马骑。"],{"ad":"隋"},"x239","隋"],["折杨柳枝歌","佚名","隋",["门前一株枣，岁岁不知老。","阿婆不嫁女，那得孙儿抱。"],{"ad":"隋"},"x239","隋"],["幽州马客吟歌辞 其二","佚名","隋",["荧荧帐中烛，烛灭不久停。","盛时不作乐，春花不重生。"],{"ad":"隋"},"x239","隋"],["幽州马客吟歌辞 其三","佚名","隋",["南山自言高，只与北山齐。","女儿自言好，故入郎君怀。"],{"ad":"隋"},"x239","隋"],["幽州马客吟歌辞 其四","佚名","隋",["郎著紫裤褶，女著彩夹裙。","男女共燕游，黄花生后园。"],{"ad":"隋"},"x239","隋"],["幽州马客吟歌辞 其五","佚名","隋",["黄花郁金色，绿蛇衔珠丹。","辞谢床上女，还我十指环。"],{"ad":"隋"},"x239","隋"],["慕容家自鲁企由谷歌","佚名","隋",["郎在十重楼，女在九重阁。","郎非黄鹞子，那得云中雀。"],{"ad":"隋"},"x239","隋"],["高阳乐人歌 其一","佚名","隋",["可怜白鼻䯄，相将入酒家。","无钱但共饮，画地作交赊。"],{"ad":"隋"},"x239","隋"],["高阳乐人歌 其二","佚名","隋",["何处䑜觞来，两颊色如火。","自有桃花容，莫言人劝我。"],{"ad":"隋"},"x239","隋"],["咸阳宫人为咸阳王禧歌","佚名","隋",["可怜咸阳王。","奈何作事误。","金床玉几不能眠。","夜踏霜与露。","洛水湛湛弥岸长。","行人那得渡。"],{"ad":"隋"},"x239","隋"],["河北民为裴侠歌","佚名","隋",["肥鲜不食，丁庸不取。","裴公贞惠，为世规矩。"],{"ad":"隋"},"x239","隋"],["时人为上高里歌","佚名","隋",["洛阳城北上高里。","殷之顽民昔所止。","今日百姓造瓮子。","人皆弃去住者耻。"],{"ad":"隋"},"x239","隋"],["湘川渔者歌","佚名","隋",["帆随湘转。","望衡九面。"],{"ad":"隋"},"x239","隋"],["赵郡为李曾谣","佚名","隋",["诈作赵郡鹿。","犹胜常山粟。"],{"ad":"隋"},"x239","隋"],["河东民为元淑谣","佚名","隋",["泰州河东，杼柚代舂。","元公至止，田畴始理。"],{"ad":"隋"},"x239","隋"],["宣武孝明时谣","佚名","隋",["狐非狐。","貉非貉。","焦梨狗子齿断索。"],{"ad":"隋"},"x239","隋"],["孝明时洛下谣","佚名","隋",["铜拔打铁拔。","元家世将末。"],{"ad":"隋"},"x239","隋"],["清河民为宋世良谣 其一","佚名","隋",["宁度东吴会稽。","不历成公曲堤。"],{"ad":"隋"},"x239","隋"],["清河民为宋世良谣 其二","佚名","隋",["曲堤虽险贼何益。","但有宋公自屏迹。"],{"ad":"隋"},"x239","隋"],["洛中童谣二首 其一","佚名","隋",["三月末。","四月初。","杨灰簸土觅真珠。"],{"ad":"隋"},"x239","隋"],["洛中童谣二首 其二","佚名","隋",["头去项，脚根齐。","驱上树，不须梯。"],{"ad":"隋"},"x239","隋"],["西魏时童谣","佚名","隋",["獾獾头团𪢮。","河中狗子破尔苑。"],{"ad":"隋"},"x239","隋"],["东魏童谣","佚名","隋",["可怜青雀子，飞来邺城里。","羽翮垂欲成，化作鹦鹉子。"],{"ad":"隋"},"x239","隋"],["东魏武定末童谣","佚名","隋",["百尺高竿摧折。","水底燃灯灯灭。"],{"ad":"隋"},"x239","隋"],["祖珽引魏世谣","佚名","隋",["河南种谷河北生。","白杨树头金鸡鸣。"],{"ad":"隋"},"x239","隋"],["柳楷引谣","佚名","隋",["鸾生十子九子瑖。","一子不瑖关中乱。"],{"ad":"隋"},"x239","隋"],["诘汾力微谚","佚名","隋",["诘汾皇帝无妇家。","力微皇帝无舅家。"],{"ad":"隋"},"x239","隋"],["时人为李崇元融语","佚名","隋",["陈留章武，伤腰折股。","贪人败类，秽我明主。"],{"ad":"隋"},"x239","隋"],["时人为安丰中山济南三王语","佚名","隋",["三王楚楚尽琳琅。","未若济南备圆方。"],{"ad":"隋"},"x239","隋"],["时人为祖莹袁翻语","佚名","隋",["京师楚楚。","袁与祖。","洛阳翩翩。","祖与袁。"],{"ad":"隋"},"x239","隋"],["同门生为李谧语","佚名","隋",["青成蓝，蓝谢青。","师何常，在明经。"],{"ad":"隋"},"x239","隋"],["时人为元颐元钦语","佚名","隋",["皇宗略略。","寿安思若。"],{"ad":"隋"},"x239","隋"],["时人为王嶷语","佚名","隋",["实痴实昏。","终得保存。"],{"ad":"隋"},"x239","隋"],["百姓为公孙轨语","佚名","隋",["驴无强弱，辅脊自壮。"],{"ad":"隋"},"x239","隋"],["时人为王遵业王延明语","佚名","隋",["英英济济。","王家兄弟。"],{"ad":"隋"},"x239","隋"],["桑干乡里为房景伯语","佚名","隋",["有义有礼。","房家兄弟。"],{"ad":"隋"},"x239","隋"],["时人为崔楷语","佚名","隋",["莫?獬。","付崔楷。"],{"ad":"隋"},"x239","隋"],["李彪引谚","佚名","隋",["一日不书。","百事荒芜。"],{"ad":"隋"},"x239","隋"],["邢峦引俗谚","佚名","隋",["耕则问田奴，绢则问织婢。"],{"ad":"隋"},"x239","隋"],["高谦之引谚","佚名","隋",["迷而知反。","得道未还。"],{"ad":"隋"},"x239","隋"],["贼为杨津语","佚名","隋",["不畏利槊坚城。","惟畏杨公铁星。"],{"ad":"隋"},"x239","隋"],["相府为裴汉语","佚名","隋",["日下粲烂有裴汉。"],{"ad":"隋"},"x239","隋"],["杨衒之引语","佚名","隋",["洛阳男儿急作髻。","瑶光寺尼夺作婿。"],{"ad":"隋"},"x239","隋"],["杨衒之引谣语","佚名","隋",["狱中无系囚，舍内无青州。","假令家道恶，腹中不怀愁。"],{"ad":"隋"},"x239","隋"],null,null,["杨衒之引游侠语","佚名","隋",["不畏张弓拔刀。","唯畏白堕春醪。"],{"ad":"隋"},"x239","隋"],["杨衒之引秦民语","佚名","隋",["快马健儿。","不如老妪吹篪。"],{"ad":"隋"},"x239","隋"]]