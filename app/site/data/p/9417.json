[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["失题 其一","汪藻","五言长篇",["我生痛不辰，尘网苦相缚。","壮岁赋归田，未占林泉福。","夜警蚩尤旗，昼闻山崩谷。","寇氛日又逼，东南尽茶毒。","避乡非惜命，污秽不忍触。","此身长逝矣，无玷喻白玉。"],0,132,"清"]]