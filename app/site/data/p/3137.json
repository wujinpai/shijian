[["句 其十五","楼楚材","残句",["有时移向西堂去，一座青山逐手来。"],0,96,"宋"],["句 其一","吴璋","残句",["各自芬芳花默默，两相呼唤鸟津津。"],0,98,"宋"],["句 其五","林敏功","残句",["近方薝卜黄，远比茉莉小。"],0,40,"宋"],["句","胡山甫","残句",["病起百花开。"],0,174,"宋"],["廉水渡","崔觐","残句",["江水不流廉节去，清名长解胜贪泉。"],0,216,"宋"],["句 其八","徐俯","残句",["字直千金师智永，句称八米继卢郎。"],0,156,"宋"],["句 其五","林希","残句",["雨过淮山格嫩绿，日衔沧海露残红。"],0,13,"宋"],["句 其六","欧阳𫓧","残句",["月白玄猿哭，更残络纬悲。"],0,114,"宋"],["句 其四十一","释惠崇","残句",["楼中天姥月，座上杜陵人。"],0,69,"宋"],["句","吴申李","残句",["潮头高卷岸，雨脚半吞山。"],0,41,"宋"],["句 其二十二","楼楚材","残句",["器量不争正二月。"],0,96,"宋"],["句","崔子方","残句",["白日行空阔，青灯耿夜阑。"],0,164,"宋"],["句 其五","谢希孟","残句",["艳阳一何好，零落千载冤。"],0,69,"宋"],["句 其四","刘望之","残句",["剩破朱红供短发，南荒来校世间书。"],0,87,"宋"],["句 其二","赵汝腾","残句",["蕙菊未开倾竹叶，柴桑有梦绕篮舆。"],0,47,"宋"],["句 其一","蔡卞","残句",["对掌紫枢参大政，同扶赫日上中天。"],0,96,"宋"],["句 其七","王琪","残句",["张亢触墙成八字。"],0,242,"宋"],["句  其二","陈与行","残句",["霜间开紫蒂，露下发金英。"],0,203,"宋"],["句 其四十九","陶弼","残句",["山险不能留霸业，水声唯解送年华。"],0,254,"宋"],["句 其五十二","释惠崇","残句",["关河双鬓白，风雪一灯青。"],0,69,"宋"],["句","袁倚","残句",["江头晓夜日月出，九顶三峨相吐吞。"],0,101,"宋"],["句 其八","王庭珪","残句",["月影印仙迹，花香供笔灵。"],0,"x198","宋"],["句  其一○","释蕴常","残句",["月生更爱栏干影。"],0,79,"宋"],["句 其五","元绛","残句",["联名适似三株树，传玩惊看五朵云。"],0,98,"宋"],["句 其五","王庭珪","残句",["鹭洲盘地轴，螺浦泻天津。"],0,"x198","宋"],["句","刘爚","残句",["云影犹带湿，日光初漏明。"],0,186,"宋"],["句 其一","梅挚","残句",["寺僧日扣妆钟起，园客时翻辇路耕。"],0,94,"宋"],["句 其一","朱复之","残句",["忽听夏禽三五弄，新红突过石榴枝。"],0,190,"宋"],["句","饶道深","残句",["落霞断岸斜阳里，万里江天画不成。"],0,172,"宋"],["句 其二","吕午","残句",["四时鸥鹭窥图画，千古鱼龙听管弦。"],0,65,"宋"],["句 其一","李𬭚","残句",["绿净随时看上鱼。"],0,151,"宋"],["句  其一","释法灯","残句",["云失溪月寒。"],0,94,"宋"],["句 其一","张潞","残句",["未能子字民，但欲兄事钱。"],0,35,"宋"],["句  其八","宋庠","残句",["竹坞度钟声。"],0,"x167","宋"],["句 其四十七","陶弼","残句",["枭鸣社旁树，盗发冢中金。"],0,254,"宋"],["句 其四十二","释惠崇","残句",["人归冈舍迥，雁遇诸田遥。"],0,69,"宋"],["句 其七十八","释惠崇","残句",["丹枫映郭迥，绿屿背江深。"],0,69,"宋"],["句 其八十五","释惠崇","残句",["古戍生烟直，平沙落日迟。"],0,69,"宋"],["句 其一","石延年","残句",["月如无恨月长圆。"],0,42,"宋"],["句","张伯玉","残句",["红梅花下一樽酒，抛掷清香是负伊。"],0,85,"宋"],["句  其三","林敏功","残句",["路寻流水远。"],0,40,"宋"],["南越行（句）","翁宏","残句",["因寻买珠客，误入射猿家。"],0,201,"宋"],["句 其三","宋京","残句",["日约绣绷长一线。"],0,2