[["东坡像赞","陆游","四言",["我游钧天，帝之所都。","是老先生，玉色敷腴。","顾我而叹，闵世垢浊。","笑谓侍仙，畀以灵药。","稽首径归，万里天风。","碧山巉然，月堕江空。"],0,"x41","宋"],["神功盛德诗  其六","华镇","四言",["偏师四指，露檄旁招。","负固衔璧，知几造朝。","凌江绝岭，曾不崇朝。","蜀道失险，关烽聿销。"],0,"x106","宋"],["偈颂一百六十首 其六十","释宗杲","四言",["南泉无过，口能招祸。","赵州礼拜，草贼大败。","径山不管，结案据款。","文殊普贤，且过一边。"],0,"x112","宋"],["寄君时六章章四句  其五","彭汝砺","四言",["勇兮勇兮，子我所器。","子诚不已，我今所畏。"],0,"x143","宋"],["文宣王及其弟子赞 其四十","赵构","四言",["肃肃曹伯，王室之裔。","积习乐道，切瑳明义。","惟善则主，尔德是类。","史笔有焕，令名永纪。"],0,249,"宋"],["偈","徐守信","四言",["天地一尺，四海一滴。","把眼一眨，不见踪迹。"],0,181,"宋"],["偈颂一百三十三首 其四十一","释法薰","四言",["举古举今，和泥合水。","说心说性，画虎成狸。"],0,31,"宋"],["神功盛德诗  其七","华镇","四言",["恢恢皇纲，周汉之后。","唐嗣不武，实弛其纽。","自我维之，律此群丑。","式相上帝，以奠九有。"],0,"x106","宋"],["赠朱世英","惠洪","四言",["老妻营炊，稚子汲水。","庞公扫除，丹霞适至。","弃帚迎朋，一笑相视。","不必灵照，多说道理。"],0,"x42","宋"],["神功盛德诗  其九","华镇","四言",["蕞尔汾晋，秽我王路。","天诛久稽，爰赫斯怒。","大明继昭，晞彼朝露。","文轨攸同，平平天步。"],0,"x106","宋"],["文宣王及其弟子赞 其三十一","赵构","四言",["惟禽之问，从容其鲤。","求以异闻，诗礼云尔。","请一得三，诚退而喜。","且知将圣，不私其子。"],0,249,"宋"],["文宣王及其弟子赞 其六十一","赵构","四言",["君子若人，单父之政。","引肘寤君，放鱼禀令。","傅郭勿获，遂能制命。","百代理邑，用规观听。"],0,249,"宋"],["偈六十九首 其一","释道宁","四言",["宝座既登，清风四起。","要津把断，凡圣俱亡。","放一线道，别露风规。","具眼禅人，一任施设。"],0,119,"宋"],["古器图赞","刘跂","四言",["想古之人，悠哉邈乎。","我获其器，赋象在图。","有客见之，笑此展转。","阅斯勤斯，其人云远。","我欲晓客，耿不能言。","退观古人，恍独如存。","千载寥寥，不在图外。","谓不信者，取器以对。"],0,94,"宋"],["好恶吟","邵雍","四言",["恶死好生，去害就利。","天下之人，其情无异。"],0,"x57","宋"],["三月十三日夜五更闻杜鹃时成父欲入浙因赋六章章四句以送之  其六","赵蕃","四言",["不如归去，子宁肯住。","归去来兮，早歌式微。"],0,"x36","宋"],["酬海宗二侍者 其二","释重显","四言",["兰之得荪，其道必存。","扶吾病起，古风入门。","二兮一兮，且论勿论。"],0,"x156","宋"],["偈颂七十一首 其二十四","释了惠","四言",["诸佛诸祖，邪入肺腑。","无药可医，无术可取。"],0,62,"宋"],["赤城六章章四句  其四","释居简","四言",["千里寿公，祷公寿康。","惠洽兆庶，日飞百觞。"],0,"x94","宋"],["野狐话颂","释空","四言",["含血噀人，先污其口。","百丈野狐，失头狂走。","蓦地唤回，打个筋斗。"],0,74,"宋"],["文宣王及其弟子赞 其三十","赵构","四言",["秦有子南，蜚声述作。","守道之渊，成德之博。","范若铸金，契犹发药。","历世明祀，少梁宠爵。"],0,249,"宋"],["偈六十九首 其二十三","释道宁","四言",["大道无私，要由心悟。","心无形状，全物而彰。","妙契斯关，万缘俱备。"],0,119,"宋"],["四皓歌 其三","刘敞","四言",["高岩有薇，深谷有芝。","人生实难，委曲何为。"],0,"x51","宋"],["枕头","释慧开","四言",["轮回根本，莫著相好。","铁脊梁汉，因他放倒。"],0,65,"宋"],["颂古一百二十一首 其八十","释宗杲","四言",["有礼有乐，有唱有酬。","人平不语，水平不流。"],0,"x112","宋"],["寄君时四章章四句  其一","彭汝砺","四言",["我脂我车，陟彼高冈。","母也吾怀，匪居或忘。"],0,"x143","宋"],["寄君时四章章四句  其一","彭汝砺","四言",["我灌我园，有采之心。","于以撷之，既有且多。"],0,"x143","宋"],["偈六十九首 其三","释道宁","四言",["没弦琴韵，罕遇知音。","无影林中，难寻足迹。","同声同气，方辨端倪。","不是当家，徒劳侧耳。"],0,119,"宋"],["题秋堂四兰 其四 雪","释绍昙","四言",["幽石封白，深林掩芳。","隐德不耀，何矜色香。"],0,"x108","宋"],["祭先农","李新","四言",["帝先农功，曰惟孟春。","载耒与耜，昕及南亩。","穜稑薿薿，以布以种。","帝躬三推，土膏雷动。","百工比栉，其耕泽泽。","岁约有年，裕帝之德。","我艺我黍，我敛我稷。","为醴为酪，斟酌吉礼。","吉礼既至，神祇来游。","燕及祖考，万邦作休。","降福孔穰，𫗣芬其羞。","于以正辞，亦又何求。"],0,"x163","宋"],["三月十三日夜五更闻杜鹃时成父欲入浙因赋六章章四句以送之  其四","赵蕃","四言",["归去来兮，言发动随。","古之逸民，舍陶而谁。"],0,"x36","宋"],["四皓歌 其一","刘敞","四言",["与汝携手，南山之阿。","富贵多忧，孰知其他。"],0,"x51","宋"],["四皓歌 其二","刘敞","四言",["大风横厉，江海荡波。","嗟汝鳞介，伤如之何。"],0,"x51","宋"],["文宣王及其弟子赞 其二十","赵构","四言",["伯夫荥阳，实惟令德。","优入圣门，过不留迹。","道以目传，妙则心识。","倚欤伟欤，后代之则。"],0,249,"宋"],["文宣王及其弟子赞 其五十","赵构","四言",["有怀子折，全鲁之彦。","儒行既名，聊伯乃建。","兢兢受道，奕奕峨弁。","懿选嘉访，世享馨荐。"],0,249,"宋"],["迷悟吟","邵雍","四言",["君子改过，小人饰非。","改过终悟，饰非终迷。","终悟福至，终迷祸归。"],0,"x57","宋"],["和陶劝农六首，并引 其四","苏轼","四言",["听我苦言，其福永久。","利尔耝耜，好尔邻偶。","斩艾蓬藋，南东其亩。","父兄搢梃，以抶游手。"],0,"x67","宋"],["嘉定十五年皇帝受恭膺天命之宝三首 其二","郊庙朝会歌辞","四言",["于穆我皇，之德之纯。","涵濡群生，矧我遗民。","连齐跨晋，输贡效珍。","土宇日辟，一视同仁。"],0,"x207","宋"],["把手吟","邵雍","四言",["富贵把手，贫贱掣肘。","贫贱把手，富贵掣肘。","金石之交，死且不朽。","市井之交，自难长久。"],0,"x57","宋"],["寄君时六章章四句  其四","彭汝砺","四言",["勿谓过小，我姑为之。","千里之差，始于毫厘。"],0,"x143","宋"],["偈颂一百零二首 其七十八","释慧远","四言",["春日迟迟，春风浩浩。","绿水绕腰，青山戴帽。","柳绿花红，鸦鸣鹊噪。","大施门开，何处著到。"],0,154,"宋"],["有美人兮四章  其四","赵友直","四言",["有美人兮，在天之北。","怀之勿已，我心恻恻。"],0,49,"宋"],["偈一百二十首 其一○八","释怀深","四言",["水中盐味，色里胶青。","决定是有，不见其形。"],0,"x134","宋"],["偈三首 其三","惠洪","四言",["不知即问，不见即讨。","圆满现前，何须更道。","维坚密身，生死病老。","面前塔子，不可推倒。"],0,"x42","宋"],["颂古十七首 其十四","释道行","四言",["如何是佛，口是祸门。","一钱不直，卖与买人。"],0,75,"宋"],["偈颂七十一首 其十八","释了惠","四言",["楚江南畔，甬水东边。","有一句子，不方不圆。","四七二三，望风结舌。","德山临济，退后垂涎。"],0,62,"宋"],["文宣王及其弟子赞 其三十三","赵构","四言",["纪伯子鲁，圣学是务。","厉己斯的，好问乃裕。","周旋中规，容止可度。","允矣昔贤，后世所慕。"],0,249,"宋"],["日用","惠洪","四言",["昼为情缘，夜为恶想。","譬如血脉，流注不断。","笑喜怒骂，折旋俯仰。","我观个中，无三界相。","山河大地，与意俱丧。","十方分身，向此安葬。","耳中有尘，捕风缚响。","舌头无骨，如拳展掌。","婴儿哆啝，语无背向。","终必得物，人不敢诳。","是坚密身，独露万象。","才落意地，即同侣伴。"],0,"x42","宋"],["五方帝 其五","郊庙朝会歌辞","四言",["圣考能飨，宗祀熙成。","骏烈惟帝，于皇执衡。","茂育元运，降祚丕平。","载清斯酌，庸罄精诚。"],0,"x207","宋"],["寄君时四章章四句  其三","彭汝砺","四言",["我思昔人，亦采其薇。","我乐所安，奚愠其微。"],0,"x143","宋"],["四不可吟","邵雍","四言",["言不可妄，行不可隳。","命不可忽，天不可违。"],0,"x57","宋"],["封本堂","徐积","四言",["物无其实，其名弗至。","实以先之，名以次之。","事无其实，君子弗名。","可表其实，可考其行。","名以表之，行以考之。","信斯名者，斯民可见。","乐斯名者，斯堂可燕。","可燕可歌，使臣之光。","有孚实惠，民悦无疆。"],0,"x123","宋"],null,["采蕺 其四","王十朋","四言",["我陟高岗，瞻望东越。","访王之祀，旷古有阙。","宜庙于山，世享不绝。","何以荐之，蕺茗是撷。"],0,"x61","宋"],["寄君时六章章四句  其三","彭汝砺","四言",["勿谓道远，我至之难。","我勇以前，人孰我先。"],0,"x143","宋"],["养雁","仇远","四言",["雍雍阳鸟，其居朔方。","朅来江南，雪霜备尝。","意不耐暑，虑尔早亡。","乃安水土，羽毛无伤。","仰羡鹓雏，俯趋鹜行。","负影只立，何如还乡。","秋风日高，稻粱已黄。","且谋一饱，勿思翱翔。"],0,"x84","宋"],["信士画真请赞 其五","释印肃","四言",["苍天苍天，悟无生法。","谈不说禅，开两片皮。","括地该天，如何是佛，十万八千。"],0,"x121","宋"],["思虑吟","邵雍","四言",["思虑未起，鬼神莫知。","不由乎我，更由乎谁。"],0,"x57","宋"],["冽井  其三","王柏","四言",["有冽彼泉，弦歌之东。","所谓伊人，宛在其中。","我心既得，皇恤我躬。","匪一死之，义之从容。"],0,"x137","宋"],["渊圣皇帝题十八学士颂","李纲","四言",["英英策府，十八学士。","森如骥𫘧，才德兼备。","太宗御之，六辔耳耳。","嘶风𥬞云，一日千里。","丹青之妙，写于缣素。","千载风流，遇之旦暮。","于穆渊圣，天纵多能。","游戏翰墨，识其姓名。","人物图绘，及兹宸藻。","是为三绝，万世之宝。","沙漠苦寒，翠华未还。","伤心北顾，喟其涕潸。","安得杰才，如彼诸子。","扶翊中微，国势振起。","岂无赵卒，为御以归。","老臣衰疾，跂而望之。"],0,"x136","宋"],["三月某日有感而书","杜范","四言",["敏不可恃，钝宜自强。","诗酒荒嬉，恐暴汝良。","我日衰惰，赖汝以张。","安肆日偷，古训洋洋。","我与伯氏，短檠夜书。","矻矻待旦，我所不如。","每一念之，抆涕痛乎。","嗣而昌之，其后人欤。"],0,115,"宋"],["和君时十章章四句  其一","彭汝砺","四言",["猗彼君子，笃志乎道。","道之云远，于焉慥慥。"],0,"x143","宋"],["新池答问","陈宓","四言",["即宅见湖，移园就宅。","以果易谷，以宽补窄。","以娱亲姻，以燕宾客。","曰田曰园，孰失孰得。"],0,"x124","宋"],["送云鹤山人","徐积","四言",["星非甘公，卦非焦赣。","善言五部，枝干迭用。","所据甚精，所发必中。","辅之以教，其益弥众。","以刚止邪，以柔止讼。","躁者使静，义者使动。","仁使之修，虐戒之纵。","险者使平，浮者使重。","如此庶乎，殆可折衷。","行矣勉之，斯言可诵。"],0,"x123","宋"],["小车吟","邵雍","四言",["有客无知，唯知有家。","有家能归，其归非遐。","灵台莹静，天壤披葩。","书用大笔，出乘小车。","身为男子，生于中华。","又居洛阳，为幸何多。","天地中央，帝王贞宅。","汉唐遗烈，气象自佳。","圣贤区宇，士人渊薮。","仁义场圃，闻见无涯。","里巷相切，亲朋相过。","人疑日驭，我谓星查。","或游金谷，或泛月波。","或经履道，或过铜驼。","进退云水，舒卷烟霞。","揄扬风月，抬帖莺花。","性喜饮酒，饮喜微酡。","饮未微酡，口先吟哦。","吟哦不足，遂及浩歌。","浩歌不足，无可奈何。"],0,"x57","宋"],["嘉定十五年皇帝受恭膺天命之宝三首 其三","郊庙朝会歌辞","四言",["我祖我宗，德厚泽深。","于皇继序，益单厥心。","天人协扶，一统有临。","乾坤清夷，振古斯今。"],0,"x207","宋"],["颂古十八首 其十二","释宝印","四言",["何必不必，金刀玉尺。","甜者如檗，苦者如蜜。","二十年来，无处雪屈。"],0,106,"宋"],["偈颂七十六首 其二","释师观","四言",["坐断要津，全提正令。","佛祖到来，也须乞命。"],0,210,"宋"],["赠别李次翁","黄庭坚","四言",["利欲薰心，随人翕张。","国好骏马，尽为王良。","不有德人，俗无津梁。","德人天游，秋月寒江。","映彻万物，玲珑八窗。","于爱欲泥，如莲生塘。","处水超然，出泥而香。","孔窍穿穴，明冰其相。","维乃根华，其本含光。","大雅次翁，用心不忘。","日问月学，旅人念乡。","能如斯莲，汔可小康。","在俗行李，密密堂堂。","观物慈哀，涖民爱庄。","成功万年，付之面墙。","草衣石质，与世低昂。"],0,"x66","宋"],["昕侍者求赞","释清远","四言",["吾行尔随，吾唤尔应。","唯随与应，不欠不剩。","因吾识尔，此像果亲。","静而瞻之，道实绝伦。"],0,116,"宋"],["文宣王及其弟子赞 其五十二","赵构","四言",["黄伯著祀，公孙是云。","弥缝中道，协辅斯文。","藏修方异，渐渍其勤。","史词不忘，播为清芬。"],0,249,"宋"],["文宣王及其弟子赞 其五十一","赵构","四言",["先觉既位，簪履并驰。","尚德君子，尔乃兼之。","羿奡可惭，禹稷可师。","三复此道，载观白圭。"],0,249,"宋"],["接待","释慧开","四言",["洋铜汁羹，热铁丸饭。","滴粒才沾，通身腐烂。"],0,65,"宋"],["偈颂七十一首 其十九","释了惠","四言",["隔江回首，已涉波澜。","官路交肩，犹添荆棘。"],0,62,"宋"],["偈颂一百二十三首 其五十六","释崇岳","四言",["石巩张弓，鲁祖面壁。","正令不行，拗曲作直。"],0,222,"宋"],["牙药","释慧开","四言",["点著些儿，妙不可述。","才开臭口，验得骨出。"],0,65,"宋"],["采蕺 其二","王十朋","四言",["陟彼越山，言采其茗。","我思古人，中心炳炳。","维国有耻，夕弗遑瞑。","焦心以思，沼吴之境。"],0,"x61","宋"],["送山阳宰","徐积","四言",["大夫三年，平恕如一。","静而不烦，民安厥室。","大夫去矣，何以述之。","我述民言，民实德之。"],0,"x123","宋"],["凝华殿帖子","赵禥","四言",["帝德巍巍，温恭允塞。","心传精微，惟尧是则。"],0,42,"宋"],["和君时十章章四句  其九","彭汝砺","四言",["为山一篑，惧乎或止。","道之云远，曷云其已。"],0,"x143","宋"],["寄君时六章章四句  其一","彭汝砺","四言",["我思古人，克诚其心。","如陟于高，如临于深。"],0,"x143","宋"],["文宣王及其弟子赞 其二十三","赵构","四言",["惟时义方，有子诚孝。","怡怡圣域，俱膺是道。","暮春舞雩，咏歌至教。","师故与之，和悦宜召。"],0,249,"宋"],["有客","释智圆","四言",["有客有客，来扣我门。","相见无言，自昼达昏。","支肘凭栏，俯仰乾坤。","百年瞬息，得丧谁论。","远山青青，巨浸浑浑。","忽然归去，目击道存。"],0,"x101","宋"],["和君时十章章四句  其三","彭汝砺","四言",["孰违孰从，曰吾从义。","孰去孰与，曰吾由礼。"],0,"x143","宋"],["克商操","薛季宣","四言",["天命文考，剪灭大商。","发将天命，戈矛有光。","非余武兮，独夫自亡。","非余武兮，天启先王。"],0,"x194","宋"],["寄君时六章章四句  其六","彭汝砺","四言",["子能吾取，吾谁之匿。","子铭于盘，以视朝夕。"],0,"x143","宋"],["师自作真赞 其四","释守卓","四言",["南海之滨，兔生两角。","幕阜之顶，硗硗确确。","从十年游，脚跟皴剥。","讨甚机锋，七错八错。"],0,42,"宋"],["颂古二十五首 其二十四","释崇岳","四言",["腊月烧山，天宽地宽。","筑著磕著，彻骨毛寒。"],0,222,"宋"],["颂古九首 其三","释梵言","四言",["田中插锹，床上推枕。","千手千眼，不审不审。"],0,152,"宋"],["自警 其一","赵禥","四言",["孳孳为善，无怠讲习。","心思唐虞，圣道可入。"],0,42,"宋"],["祭佛照塔","释善珍","四言",["师在干淳，名塞穹壤。","据妙喜室，鞭挞龙象。","诸子迭出，如凤如麟。","如雷破蛰，何草不春。","余不肖孙，亦忝备位。","芜辞匪渎，惟以识愧。"],0,45,"宋"],["盘居六章  其五","项安世","四言",["渐以中上，屯以正行。","匪盘之异，惟物之情。"],0,"x55","宋"],["嘉定十五年皇帝受恭膺天命之宝三首 其一","郊庙朝会歌辞","四言",["我祖受命，恭膺于天。","爰作玉宝，载祗载虔。","申锡无疆，神圣有传。","昭兹兴运，于万斯年。"],0,"x207","宋"],["文宣王及其弟子赞 其六十","赵构","四言",["仕进之道，要在究习。","具臣而居，咎欲谁执。","斯未能信，谦以有立。","阙里说之，多士莫及。"],0,249,"宋"],["颂古二十一首  其一六","释正觉","四言",["大地火发，间不容发。","南海昆仑，天寒不袜。","祖祖相传，一头搕𣜂。"],0,"x88","宋"],["新田诗","王安石","四言",["离离新田，其下流水。","孰知其初，灌莽千里。","其南背江，其北逾淮。","父抱子扶，十百其来。","其来仆仆，镘我新屋。","赵侯劬之，作者不饥。","岁仍大熟，饱及鸡鹜。","僦船与车，四鄙出谷。","今游者处，昔止者流。","维昔牧我，不如今侯。","侯来适野，不有观者。","税于水滨，问我鳏寡。","侯其归矣，三岁于兹。","谁能止侯，我往求之。"],0,"x48","宋"],["和君时十章章四句  其八","彭汝砺","四言",["无悔无尤，是则养亲。","尔慎旃哉，以慰母心。"],0,"x143","宋"],["春秋赞","赵禥","四言",["微显阐幽，三体五例。","严乎成言，褒贬一字。"],0,42,"宋"],["再次四言韵二首 其一","洪炎","四言",["执虎入圈，絷驹在闲。","志六合外，身十亩间。","组系单于，泥封函关。","乐我丛桂，淮南小山。"],0,110,"宋"],["石藏玉赞","陈著","四言",["天下之宝，惟玉为最。","然不受触，触之则碎。","如何如何，可全其粹。","亦曰珍藏，光华自贲。"],0,"x92","宋"]]