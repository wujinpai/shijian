[["句","倪翼","残句",["三尺有关人命重，一官虽去我身轻。"],0,190,"宋"],["句 其一","方维","残句",["青胆雄于金斗大，赤心坚比铁山高。"],0,58,"宋"],["句 其二","伍彬","残句",["踪迹未辞鸳鹭客，梦魂先到鹧鸪村。"],0,124,"宋"],["句","三学诸生","残句",["庾岭梅花清似玉，一番香要一番寒。"],0,24,"宋"],["句 其一","江砢","残句",["西风野如赭，见者辄吐舌。"],0,62,"宋"],["句 其九","张载","残句",["无疑菱荇香。"],0,93,"宋"],["句  其六","李壁","残句",["鸦健触翻红䔩䔩，鸥闲占断碧粼粼。"],0,80,"宋"],["句 其十一","丁谓","残句",["物华如阵笔如锋，沈谢曹刘是七雄。"],0,131,"宋"],["句 其二","张道洽","残句",["早缘服玉肌能白，不为薰衣骨亦香。"],0,5,"宋"],["句  其一九","李彭","残句",["微风披拂香来去。"],0,"x111","宋"],["句","张纮","残句",["时见空中飞八百，每闻岸上叫三千。"],0,140,"宋"],["句 其三","秦观","残句",["高邮西北多巨湖，累累相贯如连珠。"],0,"x62","宋"],["句  其四","寇准","残句",["汉水泱泱绕凤林，岘山南路白云深。"],0,12,"宋"],["句","游酢","残句",["青山控野双门壮，白浪排空万马来。"],0,218,"宋"],["句 其一","庞籍","残句",["毗耶长者入街初。"],0,21,"宋"],["句","嵊县令","残句",["一时分付雪儿歌。"],0,13,"宋"],["句  其六","释赞宁","残句",["何用密防奸。"],0,241,"宋"],["句 其四","米芾","残句",["饭白云留子，茶甘露有兄。"],0,245,"宋"],["句","荣倪","残句",["多谢喧喧雀，时来破寂寥。"],0,146,"宋"],null,["句  其一○三","释晓莹","残句",["即看青女夜飞霜。"],0,182,"宋"],["句 其三","李廌","残句",["安得吾皇四百州，皆如此邦二千石。"],0,"x127","宋"],["句 其四十五","晏殊","残句",["腊雪半含梅粉白，春风先著柳梢黄。"],0,186,"宋"],["句 其六","谢逸","残句",["百叶梅梢拂掠黄，风摇雨练亦凄凉。"],0,154,"宋"],["句  其二○","李彭","残句",["风流尽付小园春。"],0,"x111","宋"],["句 其一","方翥","残句",["秋明河汉外，月近南斗旁。"],0,64,"宋"],["句 其九","杨亿","残句",["江南堤柳拂人头，李白题诗遍酒楼。"],0,"x47","宋"],["句 其四","冯京","残句",["吟气老怀长剑古，醉胸横得太行宽。"],0,129,"宋"],["句 其二","释延寿","残句",["牛胎生象子，碧海起红尘。"],0,138,"宋"],["句 其六","尤袤","残句",["剩对风花吟柳絮，更将冰水瀹芎苗。"],0,11,"宋"],["句  其八","李彭","残句",["兹意与谁传。"],0,"x111","宋"],["句","李伯祥","残句",["夜过修竹院，醉打老僧门。"],0,207,"宋"],["句 其四","韩驹","残句",["劝我卷风金叵罗。"],0,"x104","宋"],["句 其三十九","释惠崇","残句",["寒禽栖古柳，破月入微云。"],0,69,"宋"],["句","章少隐","残句",["片片梅花随雨脱，浑疑春雪堕林梢。"],0,234,"宋"],["句 其三","释从垣","残句",["习字带秋收柿叶，学诗和月咽梅花。"],0,168,"宋"],["句 其十六","张舜民","残句",["小园寂寞锁春风，初见梅花一树红。"],0,209,"宋"],["句","余良弼","残句",["江流不复三峡险，天际自此中州宽。"],0,122,"宋"],["句","侯彭老","残句",["清绝洗妖氛。"],0,248,"宋"],["句 其二","李若水","残句",["一庭鸟迹天书怪，八尺簟纹人字寒。"],0,167,"宋"],["句 其二十三","吴光","残句",["弹压京畿贤大尹，藩宣上国古贤侯。"],0,174,"宋"],["句 其二","梅询","残句",["我有集仙经始在，劳君一到为重修。"],0,129,"宋"],["句 其五","钱惟演","残句",["客亭厌见名长短，村酒那能辨圣贤。"],0,175,"宋"]