[["苏小小歌","佚名","隋",["妾乘油壁车，郎骑青骢马。","何处结同心，西陵松柏下。"],{"ad":"隋"},"x239","隋"],["广平百姓为李波小妹语","佚名","隋",["李波小妹字雍容。","褰裙逐马如卷蓬。","左射右射必叠双。","妇女尚如此。","男子那可逢。"],{"ad":"隋"},"x239","隋"],["送别诗","佚名","隋",["杨柳青青著地垂，杨花漫漫搅天飞。","柳条折尽花飞尽，借问行人归不归。"],{"ad":"隋"},"x239","隋"],["炀帝幸江南时闻民歌","佚名","隋",["我儿征辽东，饿死青山下。","今我挽龙舟，又困随堤道。","方今天下饥，路粮无些小。","前去三千程，此身安可保。","寒骨枕荒沙，幽魂泣烟草。","悲损门内妻，望断吾家老。","安得义男儿，焚此无主尸。","引其孤魂回，负其白骨归。"],{"ad":"隋"},"x239","隋"],["乌夜啼 其二","佚名","隋",["长樯铁鹿子，布帆阿那起。","诧侬安在间，一去数千里。"],{"ad":"隋"},"x239","隋"],["时人为檀道济歌","佚名","隋",["可怜白浮鸠。","枉杀檀江州。"],{"ad":"隋"},"x239","隋"],["时人为檀道济歌","佚名","隋",["生人作死别，荼毒当奈何。"],{"ad":"隋"},"x239","隋"],["读曲歌","佚名","隋",["死罪刘领军，误杀刘第四。"],{"ad":"隋"},"x239","隋"],["刘敬叔引诗","佚名","隋",["鸡山别飞响，雉涧和清音。"],{"ad":"隋"},"x239","隋"],["民间为谢灵运谣","佚名","隋",["四人挈衣裙，三人捉坐席。"],{"ad":"隋"},"x239","隋"],["元嘉中魏地童谣","佚名","隋",["轺车北来如穿雉。","不意虏马饮江水。","虏主北归石济死。","虏欲渡江天不徙。"],{"ad":"隋"},"x239","隋"],["臧质引童谣","佚名","隋",["虏马渡江水，佛狸死卯年。"],{"ad":"隋"},"x239","隋"],["元嘉末童谣","佚名","隋",["钱唐出天子。"],{"ad":"隋"},"x239","隋"],["民间为奚显度谣","佚名","隋",["宁得建康压额。","不能受奚度拍。"],{"ad":"隋"},"x239","隋"],["泰始中童谣","佚名","隋",["东城出天子。"],{"ad":"隋"},"x239","隋"],["永光初谣言","佚名","隋",["湘州出天子。"],{"ad":"隋"},"x239","隋"],["元徽中童谣","佚名","隋",["襄阳白铜蹄。","郎杀荆州儿。"],{"ad":"隋"},"x239","隋"],["东阳为释慧约谣","佚名","隋",["少达妙理娄居士。"],{"ad":"隋"},"x239","隋"],["时人为刘劭刘骏语","佚名","隋",["遥望建康城，江水逆流萦。","前见子杀父，后见弟杀兄。"],{"ad":"隋"},"x239","隋"],["麦城俗谚","佚名","隋",["东驴西磨。","麦城自破。"],{"ad":"隋"},"x239","隋"],["颜延之引谚","佚名","隋",["富则盛。","贫则病。"],{"ad":"隋"},"x239","隋"],["清溪谚","佚名","隋",["扬州青。","是鬼营。"],{"ad":"隋"},"x239","隋"],["释慧通引谚","佚名","隋",["指南为北，自谓不惑。","指西为东，自谓不蒙。"],{"ad":"隋"},"x239","隋"],["时人为丁旿语","佚名","隋",["勿跋扈。","付丁旿。"],{"ad":"隋"},"x239","隋"],["南豫州军士为王玄谟宗越语","佚名","隋",["宁作五年徒，不逢王玄谟。","玄谟犹尚可，宗越更杀我。"],{"ad":"隋"},"x239","隋"],["鼓山俗语","佚名","隋",["南彭北鼓。","相去十五。"],{"ad":"隋"},"x239","隋"],["京邑为何勖孟灵休语","佚名","隋",["安成食。","临汝饰。"],{"ad":"隋"},"x239","隋"],["时人为王延之王僧虔语","佚名","隋",["二王居平。","不送不迎。"],{"ad":"隋"},"x239","隋"],["京师为东安斗场二寺僧语","佚名","隋",["斗场禅师窟，东安谈义林。"],{"ad":"隋"},"x239","隋"],["时人为胡母颢语","佚名","隋",["禾绢闭眼诺。","胡母大张橐。"],{"ad":"隋"},"x239","隋"],["百姓为袁粲褚彦回语","佚名","隋",["可怜石头城。","宁为袁粲死。","不作褚渊生。"],{"ad":"隋"},"x239","隋"],["齐宋以来民间语","佚名","隋",["扰攘建武上。"],{"ad":"隋"},"x239","隋"],["时人评八僧语","佚名","隋",["生睿发天真，严观洼流得。","慧义彭亨进，寇渊千默塞。"],{"ad":"隋"},"x239","隋"],["时人为释道经慧静语","佚名","隋",["洛下长大耳，东阿黑如墨。","有问无不酬，有酬无不塞。"],{"ad":"隋"},"x239","隋"],["碧玉歌 其一","佚名","隋",["碧玉破瓜时，郎为情颠倒。","芙蓉陵霜荣，秋容故尚好。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其二","佚名","隋",["闻欢大养蚕，定得几许丝。","所得何足言，奈何黑瘦为。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其三","佚名","隋",["夜相思。","投壶不得箭。","忆欢作娇时。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其四","佚名","隋",["开门枕水渚。","三刀治一鱼。","历乱伤杀汝。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其五","佚名","隋",["未敢便相许。","夜闻侬家论。","不持侬与汝。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其六","佚名","隋",["懊恼不堪止。","上床解要绳。","自经屏风里。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其八","佚名","隋",["将懊恼。","石阙昼夜题。","碑泪常不燥。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其九","佚名","隋",["别后常相思。","顿书千丈阙。","题碑无罢时。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十","佚名","隋",["奈何许。","所欢不在间。","娇笑向谁绪。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十一","佚名","隋",["隔津欢。","牵牛语织女。","离泪溢河汉。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十二","佚名","隋",["啼相忆。","泪如漏刻水。","昼夜流不息。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十三","佚名","隋",["著处多遇罗。","的的往年少。","艳情何能多。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十四","佚名","隋",["无故相然我。","路绝行人断。","夜夜故望汝。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十五","佚名","隋",["一坐复一起。","黄昏人定后。","许时不来已。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十六","佚名","隋",["摩可浓。","巷巷相罗截。","终当不置汝。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十七","佚名","隋",["不能久长离。","中夜忆欢时。","抱被空中啼。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十八","佚名","隋",["腹中如汤灌。","肝肠寸寸断。","教侬底聊赖。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其十九","佚名","隋",["相送劳劳渚。","长江不应满。","是侬泪成许。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其二十一","佚名","隋",["郎情难可道。","欢行豆挟心。","见荻多欲绕。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其二十二","佚名","隋",["松上萝。","愿君如行云。","时时见经过。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其二十三","佚名","隋",["夜相思。","风吹窗帘动。","言是所欢来。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其二十四","佚名","隋",["长鸣鸡。","谁知侬念汝。","独向空中啼。"],{"ad":"隋"},"x239","隋"],["华山畿二十五首 其二十五","佚名","隋",["腹中如乱丝。","愦愦适得去。","愁毒已复来。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其一","佚名","隋",["花钗芙蓉髻，双鬓如浮云。","春风不知著，好来动罗裙。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其二","佚名","隋",["念子情难有。","已恶动罗裙。","斩侬入怀不。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三","佚名","隋",["红蓝与芙蓉，我色与欢敌。","莫案石榴花，历乱听侬摘。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四","佚名","隋",["千叶红芙蓉，照灼绿水边。","馀花任郎摘，慎莫罢侬连。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其五","佚名","隋",["思欢久。","不爱独枝莲。","只惜同心藕。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其六","佚名","隋",["打坏木栖床，谁能坐相思。","三更书石阙，忆子夜啼碑。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其七","佚名","隋",["奈何不可言。","朝看莫牛迹。","知是宿蹄痕。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其八","佚名","隋",["娑拖何处归，道逢播掿郎。","口朱脱去尽，花钗复低昂。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其九","佚名","隋",["所欢子。","莲从胸上度。","刺忆庭欲死。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其十","佚名","隋",["揽裳踱。","跣把丝织履。","故交白足露。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其十一","佚名","隋",["上知所。","所欢不见怜。","憎状从前度。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其十二","佚名","隋",["思难忍。","络罂语犹壶。","倒写侬顿尽。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其十三","佚名","隋",["上树摘桐花，何悟枝枯燥。","迢迢空中落，遂为梧子道。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其十七","佚名","隋",["縠衫两袖裂，花钗鬓边低。","何处分别归，西上古馀啼。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其十八","佚名","隋",["所欢子。","不与他人别。","啼是忆郎耳。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其十九","佚名","隋",["披被树明灯，独思谁能忍。","欲知长寒夜，兰灯倾壶尽。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其二十","佚名","隋",["坐起叹汝好。","愿他甘丛香。","倾筐入怀抱。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其二十二","佚名","隋",["忆欢不能食。","徘徊三路间。","因风觅消息。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其二十三","佚名","隋",["朝日光景开，从君良燕游。","愿如卜者策，长与千岁龟。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其二十四","佚名","隋",["所欢子。","问春花可怜。","括插袮裆里。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其二十五","佚名","隋",["芳萱初生时，知是无忧草。","双眉画未成，那能就郎抱。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其二十六","佚名","隋",["百花鲜。","谁能怀春日。","独入罗帐眠。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其二十七","佚名","隋",["闻欢得新侬。","四支懊如垂。","鸟散放行路。","井中百翅不能飞。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其二十八","佚名","隋",["怜欢敢唤名，念欢不呼字。","连唤欢复欢，两誓不相弃。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十","佚名","隋",["白门前。","乌帽白帽来。","白帽郎是侬。","良不知乌帽郎是谁。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十一","佚名","隋",["初阳正二月，草木郁青青。","蹑履步前园，时物感人情。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十二","佚名","隋",["青幡起御路，绿柳荫驰道。","欢赠玉树筝，侬送千金宝。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十三","佚名","隋",["桃花落已尽，秋思犹未央。","春风难期信，托情明月光。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十四","佚名","隋",["计约黄昏后，人断犹未来。","闻欢开方局，已复将谁期。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十五","佚名","隋",["自从别郎后，卧宿头不举。","飞龙落药店，骨出只为汝。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十六","佚名","隋",["日光没已尽，宿鸟纵横飞。","徙倚望行云，躞蹀待郎归。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十七","佚名","隋",["百度不一回，千书信不归。","春风吹杨柳，华艳空徘徊。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十八","佚名","隋",["音信阔弦朔，方悟千里遥。","朝霜语白日，知我为欢消。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其三十九","佚名","隋",["合冥过藩来，向晓开门去。","欢取身上好，不为侬作虑。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四十","佚名","隋",["五鼓起开门，正见欢子度。","何处宿行还，衣被有霜露。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四十一","佚名","隋",["本自无此意，谁交郎举前。","视侬转迈迈，不复来时言。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四十二","佚名","隋",["自我别欢后，叹音不绝响。","茱萸持捻泥，龛有杀子像。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四十三","佚名","隋",["家贫近店肆，出入引长事。","郎君不浮华，谁能呈实意。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四十四","佚名","隋",["念日行不遇，道逢播掿郎。","查灭衣服坏，白肉亦黯疮。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四十五","佚名","隋",["歔欷暗中啼，斜日照帐里。","无油何所苦，但使天明尔。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四十六","佚名","隋",["黄丝咡素琴，泛弹弦不断。","百弄任郎作，唯莫广陵散。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四十八","佚名","隋",["诈我不出门，冥就他侬宿。","鹿转方相头，丁倒欺人目。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其四十九","佚名","隋",["欢但且还去，遗信相参伺。","契儿向高店，须臾侬自来。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其五十","佚名","隋",["欲行一过心，谁我道相怜。","摘菊持饮酒，浮华著口边。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其五十一","佚名","隋",["语我不游行，常常走巷路。","败桥语方相，欺侬那得度。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其五十二","佚名","隋",["阔面行负情，诈我言端的。","画背作天图，子将负星历。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其五十三","佚名","隋",["君行负怜事，那得厚相于。","麻纸语三葛，我薄汝粗疏。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其五十四","佚名","隋",["黄天不灭解，甲夜曙星出。","漏刻无心肠，复令五更毕。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其五十六","佚名","隋",["空中人。","住在高樯深合里。","书信了不通。","故使风往尔。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其五十七","佚名","隋",["侬心常慊慊，欢行由豫情。","雾露隐芙蓉，见莲讵分明。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其五十八","佚名","隋",["非欢独慊慊，侬意亦驱驱。","双灯俱时尽，奈许两无由。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其五十九","佚名","隋",["谁交强缠绵，常持罢作虑。","作生隐藕叶，莲侬在何处。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其六十","佚名","隋",["相怜两乐事，黄作无趣怒。","合散无黄连，此事复何苦。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其六十一","佚名","隋",["谁交强缠绵，常持罢作意。","走马织悬帘，薄情奈当驶。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其六十三","佚名","隋",["百忆却欲噫，两眼常不燥。","蕃师五鼓行，离侬何太早。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其六十四","佚名","隋",["含笑来向侬，一抱不能置。","领后千里带，那顿谁多媚。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其六十五","佚名","隋",["欢相怜。","今去何时来。","裲裆别去年。","不忍见分题。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其六十六","佚名","隋",["欢相怜。","题心共饮血。","流头入黄泉。","分作两死计。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其六十七","佚名","隋",["娇笑来向侬，一抱不能已。","湖燥芙蓉萎，莲汝藕欲死。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其六十八","佚名","隋",["欢心不相怜，慊苦竟何已。","芙蓉腹里萎，莲汝从心起。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其六十九","佚名","隋",["下帷掩灯烛，明月照帐中。","无油何所苦，但使天明侬。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其七十","佚名","隋",["执手与欢别，欲去情不忍。","馀光照已藩，坐见离日尽。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其七十一","佚名","隋",["种莲长江边，藕生黄蘖浦。","必得莲子时，流离经辛苦。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其七十二","佚名","隋",["人传我不虚，实情明把纳。","芙蓉万层生，莲子信重沓。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其七十三","佚名","隋",["闻乖事难怀，况复临别离。","伏龟语石板，方作千岁碑。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其七十四","佚名","隋",["钤荡与时竞，不得寻倾虑。","春风扇芳条，常念花落去。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其七十五","佚名","隋",["坐倚无精魂，使我生百虑。","方局十七道，期会是何处。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其七十七","佚名","隋",["十期九不果，常抱怀恨生。","然灯不下炷，有油那得明。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其七十八","佚名","隋",["自从近日来，了不相寻博。","竹帘裲裆题，知子心情薄。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其七十九","佚名","隋",["下帷灯火尽，朗月照怀里。","无油何所苦，但今天明尔。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其八十","佚名","隋",["近日莲违期，不复寻博子。","六筹翻双鱼，都成罢去已。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其八十三","佚名","隋",["侬亦粗经风。","罢顿葛帐里。","败许尘疏中。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其八十四","佚名","隋",["紫草生湖边，误落芙蓉里。","色分都未获，空中染莲子。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其八十五","佚名","隋",["闺合断信使，的的两相忆。","譬如水上影，分明不可得。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其八十六","佚名","隋",["逍遥待晓分，转侧听更鼓。","明月不应停，特为相思苦。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其八十七","佚名","隋",["罢去四五年，相见论故情。","杀荷不断藕，莲心已复生。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其八十八","佚名","隋",["辛苦一朝欢，须臾情易厌。","行膝点芙蓉，深莲非骨念。"],{"ad":"隋"},"x239","隋"],["读曲歌八十九首 其八十九","佚名","隋",["慊苦忆侬欢，书作后非是。","五果林中度，见花多忆子。"],{"ad":"隋"},"x239","隋"],["石城乐 其二","佚名","隋",["阳春百花生，摘插环髻前。","捥指蹋忘愁，相与及盛年。"],{"ad":"隋"},"x239","隋"],["石城乐 其三","佚名","隋",["布帆百馀幅，环环在江津。","执手双泪落，何时见欢还。"],{"ad":"隋"},"x239","隋"],["石城乐 其四","佚名","隋",["大艑载三千，渐水丈五馀。","水高不得渡，与欢合生居。"],{"ad":"隋"},"x239","隋"],["莫愁乐 其一","佚名","隋",["莫愁在何处，莫愁石城西。","艇子打两桨，催送莫愁来。"],{"ad":"隋"},"x239","隋"],["莫愁乐 其二","佚名","隋",["闻欢下扬州，相送楚山头。","探手抱腰看，江水断不流。"],{"ad":"隋"},"x239","隋"],["乌夜啼 其三","佚名","隋",["辞家远行去，侬欢独离居。","此日无啼音，裂帛作还书。"],{"ad":"隋"},"x239","隋"],["乌夜啼 其四","佚名","隋",["可怜乌臼鸟，强言知天曙。","无故三更啼，欢子冒暗去。"],{"ad":"隋"},"x239","隋"],["乌夜啼 其五","佚名","隋",["乌生如欲飞，飞飞各自去。","生离无安心，夜啼至天曙。"],{"ad":"隋"},"x239","隋"],["乌夜啼 其六","佚名","隋",["笼窗窗不开，荡户户不动。","欢下葳蕤龠，交侬那得往。"],{"ad":"隋"},"x239","隋"],["乌夜啼 其七","佚名","隋",["远望千里烟，隐当在欢家。","欲飞无两翅，当奈独思何。"],{"ad":"隋"},"x239","隋"],["乌夜啼 其八","佚名","隋",["巴陵三江口，芦荻齐如麻。","执手与欢别，痛切当奈何。"],{"ad":"隋"},"x239","隋"],["襄阳乐 其二","佚名","隋",["上水郎担篙，下水摇双橹。","四角龙子幡，环环江当柱。"],{"ad":"隋"},"x239","隋"],["襄阳乐 其三","佚名","隋",["江陵三千三，西塞陌中央。","但问相随否，何计道里长。"],{"ad":"隋"},"x239","隋"],["襄阳乐 其四","佚名","隋",["人言襄阳乐，乐作非侬处。","乘星冒风流，还侬扬州去。"],{"ad":"隋"},"x239","隋"],["襄阳乐 其五","佚名","隋",["烂漫女萝草，结曲绕长松。","三春虽同色，岁寒非处侬。"],{"ad":"隋"},"x239","隋"],["襄阳乐 其六","佚名","隋",["扬州蒲锻环，百钱两三丛。","不能买将还，空手揽抱侬。"],{"ad":"隋"},"x239","隋"],["襄阳乐 其八","佚名","隋",["恶见多情欢，罢侬不相语。","莫作乌集林，忽如提侬去。"],{"ad":"隋"},"x239","隋"],["寿阳乐 其一","佚名","隋",["可怜八公山。","在寿阳。","别后莫相忘。"],{"ad":"隋"},"x239","隋"],["寿阳乐 其二","佚名","隋",["东台百馀尺。","凌风云。","别后不忘君。"],{"ad":"隋"},"x239","隋"],["寿阳乐 其三","佚名","隋",["梁长曲水流。","明如镜。","双林与郎照。"],{"ad":"隋"},"x239","隋"],["寿阳乐 其四","佚名","隋",["辞家远行去。","空为君。","明知岁月驶。"],{"ad":"隋"},"x239","隋"],["寿阳乐 其五","佚名","隋",["笼窗取凉风。","弹素琴。","一叹复一吟。"],{"ad":"隋"},"x239","隋"],["寿阳乐 其六","佚名","隋",["夜相思。","望不来。","人乐我独愁。"],{"ad":"隋"},"x239","隋"],["寿阳乐 其七","佚名","隋",["长淮何烂漫。","路悠悠。","得当乐忘忧。"],{"ad":"隋"},"x239","隋"],["寿阳乐 其八","佚名","隋",["上我长濑桥。","望归路。","秋风停欲度。"],{"ad":"隋"},"x239","隋"],["寿阳乐 其九","佚名","隋",["衔泪出伤门。","寿阳去。","必还当几载。"],{"ad":"隋"},"x239","隋"],["西乌夜飞 其二","佚名","隋",["暂请半日给，徙倚娘店前。","目作宴瑱饱，腹作宛恼饥。"],{"ad":"隋"},"x239","隋"],["西乌夜飞 其三","佚名","隋",["我昨忆欢时，揽刀持自刺。","自刺分应死，刀作杂楼僻。"],{"ad":"隋"},"x239","隋"],["西乌夜飞 其五","佚名","隋",["感郎崎岖情，不复自顾虑。","臂绳双入结，遂成同心去。"],{"ad":"隋"},"x239","隋"],["宋宗庙登歌八首 其一 北平府君歌","佚名","隋",["绵绵遐绪，明昭载融。","汉德未远，尧有遗风。","于穆皇祖，永世克隆。","本支惟庆，贻厥靡穷。"],{"ad":"隋"},"x239","隋"],["宋宗庙登歌八首 其二 相国掾府君歌","佚名","隋",["乃立清庙，清庙肃肃。","乃备礼容，礼容穆穆。","显允皇祖，昭是嗣服。","锡兹繁祉，聿怀多福。"],{"ad":"隋"},"x239","隋"],["宋宗庙登歌八首 其三 开封府君歌","佚名","隋",["四县既序，箫管既举。","堂献六瑚，庭万八羽。","先王有典，克禋皇祖。","不显洪烈，永介休祜。"],{"ad":"隋"},"x239","隋"],["宋宗庙登歌八首 其四 武原府君歌","佚名","隋",["钟鼓喤喤，威仪将将。","温恭礼乐，致享曾皇。","迈德垂仁，系轨重光。","天命纯嘏，惠我无疆。"],{"ad":"隋"},"x239","隋"],["宋宗庙登歌八首 其五 东安府君歌","佚名","隋",["铄矣皇祖，帝度其心。","永言配命，播兹徽音。","思我茂猷，如玉如金。","骏奔在陛，是鉴是歆。"],{"ad":"隋"},"x239","隋"],["宋宗庙登歌八首 其六 孝皇帝歌","佚名","隋",["烝哉孝皇，齐圣广渊。","发祥诞庆，景祚自天。","德敷金石，道被管弦。","有命既集，徽风永宣。"],{"ad":"隋"},"x239","隋"],["宋宗庙登歌八首 其七 高祖武皇帝歌","佚名","隋",["惟天有命，眷求上哲。","赫矣圣武，抚运桓扰。","功并敷土，道均汝坟。","止戈曰武，经纬称文。","鸟龙失纪，云火代名。","受终改物，作我宋京。","至道惟王，大业有劭。","降德兆民，升歌清庙。"],{"ad":"隋"},"x239","隋"],["宋宗庙登歌八首 其八 七庙享神歌","佚名","隋",["奕奕寝庙，奉璋在庭。","笙龠既列，牺象既盈。","黍稷匪芳，明祀惟馨。","乐具礼充，洁羞荐诚。","神之格思，介以休祯。","济济群辟，永观厥成。"],{"ad":"隋"},"x239","隋"],["宋泰始歌舞曲十二首 其二 圣祖颂","佚名","隋",["圣祖惟高德，积勋代晋历。","永建享鸿基，万古盛音册。","睿文缵宸驭，广运崇帝声。","衍德被仁祉，留化洽民灵。","孝建缔孝业，允协天人谋。","宇内齐政轨，宙表烛威流。","钟管腾列圣，彝铭贲重猷。"],{"ad":"隋"},"x239","隋"],["宋泰始歌舞曲十二首 其三 明君大雅","佚名","隋",["明君应干数，扰乱绍颓基。","民庆来苏日，国颂薰风诗。","天步或暂艰，列蕃扇迷慝。","庙胜敷九代，神谟洞七德。","文教洗昏俗，武谊清祲埏。","英勋冠帝则，万寿永齐天。"],{"ad":"隋"},"x239","隋"],["宋泰始歌舞曲十二首 其五 天符颂","佚名","隋",["天符革运，世诞英皇。","在馆神炫，既壮龙骧。","六钟集表，四纬骈光。","于穆配天，永休厥祥。"],{"ad":"隋"},"x239","隋"],["宋泰始歌舞曲十二首 其六 明德颂","佚名","隋",["明德孚教，幽苻丽纪。","山鼎见奇，醴液涵祉。","鹓雏耀仪，驺虞游趾。","福延亿祚，庆流万祀。"],{"ad":"隋"},"x239","隋"],["宋泰始歌舞曲十二首 其七 帝图颂","佚名","隋",["帝图凝远，瑞美昭宣。","济流月镜，鹿毳霜鲜。","甘露降和，花雪表年。","孝德载衍，芳风永传。"],{"ad":"隋"},"x239","隋"],["宋泰始歌舞曲十二首 其八 龙跃大雅","佚名","隋",["龙跃戎府，玉耀蕃宫。","岁淹豫野，玺属嫔中。","江波澈映，石柏开文。","观毓花蕊，楼凝景云。","白乌三获，甘液再呈。","嘉穟表沃，连理协成。","德充动物，道积通神。","宋业允大，灵瑞方臻。"],{"ad":"隋"},"x239","隋"],["宋泰始歌舞曲十二首 其九 淮祥风","佚名","隋",["淮祥应。","贤彦生。","翼赞中兴致太平。"],{"ad":"隋"},"x239","隋"],["宋泰始歌舞曲十二首 其十 宋世大雅","佚名","隋",["宋世宁，在泰始。","醉酒欢，饱德喜。","万国朝，上寿酒。","帝同天，惟长久。"],{"ad":"隋"},"x239","隋"],["宋泰始歌舞曲十二首 其十二 白纻篇大雅","佚名","隋",["在心曰志发言诗，声成于文被管丝。","手舞足蹈欣泰时，移风易俗王化基。","琴角挥韵白云舒，箫韶协音神凤来。","拊击和节咏在初，章曲乍毕情有馀。","文同轨一道德行，国靖民和礼乐成。","四县庭响美勋英，八列陛唱贵人声。","舞饰丽华乐容工，罗裳映日袂随风。","金翠列辉蕙麝丰，淑姿秀体允帝衷。"],{"ad":"隋"},"x239","隋"],["宋凤凰衔书伎辞","佚名","隋",["大宋兴隆膺灵符。","凤鸟感和衔素书。","嘉乐之美通玄虚。","惟新济济迈唐虞。","巍巍荡荡道有馀。"],{"ad":"隋"},"x239","隋"],["青溪小姑歌二首 其一","佚名","隋",["日暮风吹，叶落依枝。","丹心寸意，愁君未知。"],{"ad":"隋"},"x239","隋"],["青溪小姑歌二首 其二","佚名","隋",["歌阕夜已久，繁霜侵晓幕。","何意空相守，坐待繁霜落。"],{"ad":"隋"},"x239","隋"],["郭长生吹笛歌","佚名","隋",["闲夜寂已清，长笛亮且鸣。","若欲知我者，姓郭名长生。"],{"ad":"隋"},"x239","隋"],["聂包鬼歌","佚名","隋",["花盈盈。","正间行。","当归不闻死复生。"],{"ad":"隋"},"x239","隋"],["陵欣歌","佚名","隋",["生时世上人，死作狱中鬼。","不得还坟墓，灰没有馀罪。"],{"ad":"隋"},"x239","隋"],["鬼谣歌","佚名","隋",["死树今更青，吴平寻当归。","适闻杀此树，已复有光辉。"],{"ad":"隋"},"x239","隋"],["鬼歌","佚名","隋",["坐侬孔雀楼，遥闻凤凰鼓。","下我邹头山，仿佛见梁鲁。"],{"ad":"隋"},"x239","隋"],["犬妖歌","佚名","隋",["言我不能歌，听我歌梅花。","今年故复可，柰汝明年何。"],{"ad":"隋"},"x239","隋"],["鹤吟","佚名","隋",["畴昔聆好音，日月心延伫。","如何遇良人，中怀邈无绪。"],{"ad":"隋"},"x239","隋"],["永明初歌","佚名","隋",["白马向城啼，欲得城边草。"],{"ad":"隋"},"x239","隋"],["百姓为东昏侯歌","佚名","隋",["阅武堂。","种杨柳。","至尊屠肉。","藩妃酤酒。"],{"ad":"隋"},"x239","隋"],["沈麟士引童谣","佚名","隋",["金鹅鸣。","沈氏兴。","代代出公卿。"],{"ad":"隋"},"x239","隋"],["张敬儿自为歌谣","佚名","隋",["天子在何处，宅在赤谷口。","天子是阿谁，非猪如是狗。"],{"ad":"隋"},"x239","隋"],["永明中虏中童谣","佚名","隋",["黑水流北。","赤火入齐。"],{"ad":"隋"},"x239","隋"],["永明中魏地童谣","佚名","隋",["赤火南流丧南国。"],{"ad":"隋"},"x239","隋"],["永元元年童谣","佚名","隋",["洋洋千里流，流翣东城头。","乌马乌皮裤，三更相告诉。","脚跛不得起，误杀老姥子。"],{"ad":"隋"},"x239","隋"],["永元中童谣","佚名","隋",["野猪虽嗃嗃，马子空闾渠。","不知龙与虎，饮食江南墟。","七九六十三，广莫人无馀。","乌集传舍头，今汝得宽休。","但看三八后，摧折景阳楼。"],{"ad":"隋"},"x239","隋"],["山阴民为丘仲孚谣","佚名","隋",["二傅沈刘。","不如一丘。"],{"ad":"隋"},"x239","隋"],["东昏侯时宫中谣","佚名","隋",["赵鬼食鸭肃刂。","诸鬼尽著调。"],{"ad":"隋"},"x239","隋"],["时人为桓康语","佚名","隋",["欲侜张。","问桓康。"],{"ad":"隋"},"x239","隋"],["荀伯玉闻青衣小儿语","佚名","隋",["草中肃。","九五相追逐。"],{"ad":"隋"},"x239","隋"],["时人为荀伯玉语","佚名","隋",["十敕五令。","不如荀伯玉命。"],{"ad":"隋"},"x239","隋"],["时人为萧晃语","佚名","隋",["焕焕萧四伞。"],{"ad":"隋"},"x239","隋"],["时人为刘绘语","佚名","隋",["刘绘贴宅，别开一门。"],{"ad":"隋"},"x239","隋"],["时人为张周刘三姓语","佚名","隋",["三人共宅夹清漳。","张南周北刘中央。"],{"ad":"隋"},"x239","隋"],["时人为沈麟士语","佚名","隋",["吴差山中有贤士。","开门教授居成市。"],{"ad":"隋"},"x239","隋"],["南州为江革语","佚名","隋",["故人不道智，新人佞散骑。","莫知度不度，新人不如故。"],{"ad":"隋"},"x239","隋"],["都下民语","佚名","隋",["欲求贵职依刀敕。","须得富豪事御力。"],{"ad":"隋"},"x239","隋"],["共戏乐 其一","佚名","隋",["齐世方昌书轨同。","万宇献乐列国风。"],{"ad":"隋"},"x239","隋"],["共戏乐 其二","佚名","隋",["时泰民康人物盛。","腰鼓铃柈各相竞。"],{"ad":"隋"},"x239","隋"],["共戏乐 其三","佚名","隋",["长袖翩翩若鸿惊。","纤腰袅袅会人情。"],{"ad":"隋"},"x239","隋"],["共戏乐 其四","佚名","隋",["观风采乐德化昌。","圣皇万寿乐未央。"],{"ad":"隋"},"x239","隋"],["杨叛儿 其一","佚名","隋",["截玉作手钩，七宝光平天。","绣沓织成带，严帐信可怜。"],{"ad":"隋"},"x239","隋"],["杨叛儿 其三","佚名","隋",["送郎乘艇子，不作遭风虑。","横篙掷去桨，愿倒逐流去。"],{"ad":"隋"},"x239","隋"],["杨叛儿 其四","佚名","隋",["七宝珠络鼓，教郎拍复拍。","黄牛细犊儿，杨柳映松柏。"],{"ad":"隋"},"x239","隋"],["杨叛儿 其五","佚名","隋",["欢欲见莲时，移湖安屋里。","芙蓉绕床生，眠卧抱莲子。"],{"ad":"隋"},"x239","隋"],["杨叛儿 其六","佚名","隋",["闻欢远行去。","送欢至新亭。","津逻无侬名。"],{"ad":"隋"},"x239","隋"],["杨叛儿 其七","佚名","隋",["落秦中庭生，诚知非好草。","龙头相钩连，见枝如欲绕。"],{"ad":"隋"},"x239","隋"],["杨叛儿 其八","佚名","隋",["杨叛西随曲，柳花经东阴。","风流随远近，飘扬闷侬心。"],{"ad":"隋"},"x239","隋"],["乐辞","佚名","隋",["绣幕围香风。","耳节朱丝桐。","不知理何事。","浅立经营中。","爱惜加穷裤。","防闲托守宫。","今日牛羊上丘陇。","当年近前面发红。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其一 肃咸乐谢超宗","佚名","隋",["夤承宝命，严恭帝绪。","奄受敷锡，升中拓宇。","亘地称皇，罄天作主。","月域来宾，日际奉土。","开元首正，礼交乐举。","六典联事，九官列序。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其二 引牲乐","佚名","隋",["皇乎敬矣，恭事上灵。","昭教国祀，肃肃明明。","有牲有涤，有洁在俎。","以荐王衷，以答神祜。","陟配在京，降德在民。","奔精望夜，高燎伫晨。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其三 嘉荐乐","佚名","隋",["我恭我享，惟孟之春。","以孝以敬，立我烝民。","青坛奄霭，翠幕端凝。","嘉俎重荐，兼籍再升。","设业设虡，展容玉庭。","肇禋配祀，克对上灵。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其四 昭夏乐","佚名","隋",["惟圣飨帝，惟孝飨亲。","礼行宗祀，敬达郊禋。","金枝中树，广乐四陈。","月御案节，星驱扶轮。","遥光远驾，曜曜振振。","告成大报，受厘元神。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其五 永至乐","佚名","隋",["紫坛望灵，翠幕伫神。","率天奉贽，罄地来宾。","神贶并介，泯祗合祉。","恭昭鉴享，肃光孝祀。","威蔼四灵，洞曜三光。","皇德全被，大礼流昌。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其六 登歌","佚名","隋",["报惟事天，祭实尊灵。","史正嘉兆，神宅崇祯。","五畤昭鬯，六宗彝序。","介丘望尘，皇轩肃举。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其八 武德宣烈乐","佚名","隋",["功烛上宙，德耀中天。","风移九域，礼饰八埏。","四灵晨炳，五纬宵明。","膺历缔运，道茂前声。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其九 高德宣烈乐王俭","佚名","隋",["飨帝严亲，则天光大。","舄奕前古，荣镜无外。","日月宣华，卿云流霭。","五汉同休，六幽咸泰。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其十 嘉胙乐谢超宗","佚名","隋",["鬯嘉礼。","承休锡。","盛德符景纬。","昌华应帝策。","圣蔼耀昌基。","融祉晖世历。","声正涵月轨。","书文同日迹。","宝瑞昭神图。","灵贶流瑞液。","我皇崇晖祚。","重芬冠往籍。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其十一 昭夏乐","佚名","隋",["荐飨洽，礼乐该。","神娱展，辰旆回。","洞云路，拂璇阶。","紫雰蔼，青霄开。","眷皇都，顾玉台。","留昌德，结圣怀。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其十二 昭远乐","佚名","隋",["天以德降，地以礼报。","牲尊俯陈，柴币仰燎。","事展司采，敬达瑄芗。","烟贽青昊，震飏紫场。","陈馨示策，肃志宗禋。","礼非物备，福唯诚陈。"],{"ad":"隋"},"x239","隋"],["齐南郊光章十三首 其十三 休成乐","佚名","隋",["昭事上祀，飨荐具陈。","回銮转翠，拂景翔宸。","缀县敷畅，钟石昭融。","羽炫深晷，龠曀行风。","肆序辍度，肃礼停文。","四金耸卫，六驭齐轮。"],{"ad":"隋"},"x239","隋"],["齐北郊乐歌六首 其一 昭夏乐谢超宗","佚名","隋",["诏礼崇营，敬飨玄畤。","灵正丹帷，月肃紫墀。","展荐登华，风县凝锵。","神惟戾止，郁葆遥庄。","昭望岁芬，环游辰太。","穆哉尚礼，横光秉蔼。"],{"ad":"隋"},"x239","隋"],["齐北郊乐歌六首 其二 登歌","佚名","隋",["伫灵敬享，禋肃彝文。","县动声仪，荐絜牲芬。","阴祇以贶，昭祀式庆。","九服熙度，六农祥正。"],{"ad":"隋"},"x239","隋"],["齐北郊乐歌六首 其三 地德凯容乐","佚名","隋",["缮方丘，端国阴。","掩圭晷，仰灵心。","诏源委，遍丘林。","礼献物，乐荐音。"],{"ad":"隋"},"x239","隋"],["齐北郊乐歌六首 其四 昭德凯容乐","佚名","隋",["庆图浚邈，蕴祥秘瑶。","伣天炳月，嫔光紫霄。","邦化灵懋，阃则风调。","俪德方仪，徽载以昭。"],{"ad":"隋"},"x239","隋"],["齐北郊乐歌六首 其五 昭夏乐","佚名","隋",["荐神升，享序楙。","淹玉俎，停金奏。","宝旆转，旒驾旋。","溢素景，郁紫躔。","灵心顾，留宸眷。","洽外瀛，瑞中县。"],{"ad":"隋"},"x239","隋"],["齐北郊乐歌六首 其六 隶幽乐","佚名","隋",["后皇嘉庆，定祗玄畤。","承帝休图，祗敷灵祉。","篚幂周序，轩朱凝会。","牲币芬坛，精明伫盖。","调川瑞昌，警岳祥泰。"],{"ad":"隋"},"x239","隋"],null,["齐明堂乐歌十五首 其二","佚名","隋",["尊事威仪，辉容昭序。","迅恭明神，絜盛牲俎。","肃肃严宫，蔼蔼崇基。","皇灵降止，百祗具司。","戒诚望夜，端烈承朝。","依微昭旦，物色轻宵。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其三 引牲乐","佚名","隋",["惟诚絜飨，惟孝尊灵。","敬度黍稷，敬涤牺牲。","骍茧在豢，载溢载丰。","以承宗祀，以肃皇衷。","萧芳四举，华火周传。","神鉴孔昭，嘉足三牷。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 嘉荐乐二首 其四","佚名","隋",["肇禋戒祀，礼容咸举。","六典饰文，九司照序。","牲柔既昭，牺刚既陈。","恭涤惟清，敬事惟神。","加笾再御，兼俎重荐。","节动轩越，声流金县。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其五","佚名","隋",["奕奕閟幄，亹亹严闱。","絜诚夕鉴，端服晨晖。","圣灵戾止，翊我皇则。","上绥四宇，下洋万国。","永言孝飨，孝飨有容。","傧僚赞列，肃肃雍雍。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其六 昭夏乐","佚名","隋",["地纽谧，干枢回。","华盖动，紫微开。","旌蔽日，车若云。","驾六龙，乘烟煴。","烨帝景，耀天邑。","圣祖降，五云集。","懋粢盛，絜牲牷。","百礼肃，群司虔。","皇德远，大孝昌。","贯九幽，洞三光。","神之安，解玉銮。","景福至，万宇欢。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其七 登歌","佚名","隋",["雍台辨朔，泽宫选辰。","絜火夕炤，明水朝陈。","六瑚贲室，八羽华庭。","昭事先圣，怀濡上灵。","肆夏式敬，升歌发德。","永固洪基，以绥万国。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其八 凯容宣烈乐","佚名","隋",["酾醴具登，嘉佾咸荐。","飨洽诚陈，礼周乐遍。","祝辞罢裸，序容辍县。","跸动端庭，銮回严殿。","神仪驻景，华汉高虚。","作灵案卫，三只解途。","翠盖澄耀，罼帟凝宸。","玉镳息节，金辂怀音。","戒诚达孝，底心肃感。","追凭皇鉴，思承渊范。","神锡懋祉，四纬昭明。","仰福帝徽，俯齐庶生。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其九 青帝歌","佚名","隋",["参映夕，驷昭晨。","灵乘震，司青春。","雁将向，桐始蕤。","和风舞，暄光迟。","萌动达，万品亲。","润无际，泽无垠。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其十 赤帝歌","佚名","隋",["龙精初见。","大火中。","朱光北至。","圭景同。","帝在在离。","寔司衡。","雨水方降。","木槿荣。","庶物盛长。","咸殷阜。","恩泽四溟。","被九有。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其十一 黄帝歌","佚名","隋",["履艮宅中宇，司绳总四方。","裁化遍寒燠，布政司炎凉。","至分乘经晷，闭启集恒度。","帝晖缉万有，皇灵澄国步。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其十二 白帝歌","佚名","隋",["百川若镜。","天地爽且明。","云冲气举。","盛德在素精。","庶类收成。","岁功行欲宁。","浃地奉渥。","罄宇承帝灵。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其十三 黑帝歌","佚名","隋",["岁既暮日方驰，灵乘坎德司规。","玄云合晦鸟蹊，白灵繁亘天涯。","晨晷促夕漏延，太阴极微阳宣。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其十四 嘉胙乐","佚名","隋",["神荐洽。","福胙昌。","圣皇膺嘉佑。","帝业凝休祥。","居极乘景运。","宅德瑞中王。","澄明临四奥。","精华延八乡。","洞海同声惠。","澈宇丽干光。","灵庆缠世祉。","鸿烈永无疆。"],{"ad":"隋"},"x239","隋"],["齐明堂乐歌十五首 其十五 昭夏乐","佚名","隋",["蕴礼容。","馀乐度。","灵方留。","景欲暮。","开九重。","肃五达。","凤参差。","龙已沫。","云既动。","河既梁。","万里照。","四空香。","神之车。","归清都。","璇庭寂。","玉殿虚。","鸿化疑。","孝风炽。","顾灵心。","结皇思。","鸿庆遐鬯。","嘉荐令芳。","翊帝明德。","永祚深光。"],{"ad":"隋"},"x239","隋"],["齐前后舞歌二首 其一 前舞阶步歌","佚名","隋",["天挺圣哲，三方维纲。","川岳伊宁，七曜重光。","茂育万物，众庶咸康。","道用潜通，仁施遐扬。","德厚坤极，功高昊苍。","舞象盛容，德以歌章。","八音既节，龙跃凤翔。","皇基永树，二仪等长。"],{"ad":"隋"},"x239","隋"],["齐前后舞歌二首 其二 后舞阶步歌","佚名","隋",["皇皇我后，绍业盛明。","涤拂除秽，宇宙载清。","允执中和，以莅苍生。","玄化远被，兆世轨形。","何以崇德，乃作九成。","妍步恂恂，雅曲芬馨。","八风清鼓，应以祥祯。","泽浩天下，功齐百灵。"],{"ad":"隋"},"x239","隋"],["齐鼙舞曲三首 其二 圣主曲辞","佚名","隋",["圣主受天命，应期则虞唐。","升旒综万机，端扆驭八方。","盈虚自然数，揖让归圣明。","北化陵河塞，南威越沧溟。","广德齐七政，敷教腾三辰。","万宇必承庆，百福咸来臻。","圣皇应福始，昌德洞佑先。"],{"ad":"隋"},"x239","隋"],["齐鼙舞曲三首 其三 明君辞","佚名","隋",["明君御四海，总鉴尽人灵。","仰成恩已洽，竭忠身必荣。","圣泽洞三灵，德教被八乡。","草木变柯叶，川岳洞嘉祥。","愉乐盛明运，舞蹈升太时。","微霜永昌命，轨心长欢怡。"],{"ad":"隋"},"x239","隋"],["齐民昌辞","佚名","隋",["齐世昌。","四海安乐齐太平。","人命长。","当结久。","千秋万岁皆老寿。"],{"ad":"隋"},"x239","隋"],["荆州民为始兴王憺歌","佚名","隋",["始兴王。","民之爹。","赴人急。","如水火。","何时复来哺乳我。"],{"ad":"隋"},"x239","隋"],["北军为韦睿歌","佚名","隋",["不畏萧娘与吕姥。","但畏合肥有韦武。"],{"ad":"隋"},"x239","隋"],["鄱阳民为陆襄歌二首 其一","佚名","隋",["鲜于平后善恶分。","民无枉赖陆君。"],{"ad":"隋"},"x239","隋"],["鄱阳民为陆襄歌二首 其二","佚名","隋",["陆君政，无怨家。","斗既罢，仇共车。"],{"ad":"隋"},"x239","隋"],["南豫州民为夏侯兄弟歌","佚名","隋",["我之有州，赖彼夏侯。","前兄后弟，布政优优。"],{"ad":"隋"},"x239","隋"],["梁武帝接民间为萧恪歌","佚名","隋",["江千万。","蔡五百。","王新车。","庾大宅。","主人愦愦不如客。"],{"ad":"隋"},"x239","隋"],["北方童谣","佚名","隋",["荆山为上格，浮山为下格。","潼沱为激沟，并灌钜野泽。"],{"ad":"隋"},"x239","隋"],["洛阳童谣","佚名","隋",["名军大将莫自牢。","千兵万马避白袍。"],{"ad":"隋"},"x239","隋"],["梁武帝时谣","佚名","隋",["莫匆匆。","且宽公。","谁当作天子。","草覆车边已。"],{"ad":"隋"},"x239","隋"],["昭明为太子时谣","佚名","隋",["鹿子开城门，城门鹿子开。","当开复未开，使我心徘徊。","城中诸少年，逐欢归去来。"],{"ad":"隋"},"x239","隋"],["普通中童谣","佚名","隋",["青丝白马寿阳来。"],{"ad":"隋"},"x239","隋"],["侯景时的脰乌童谣","佚名","隋",["的脰乌。","拂朱雀。","还与吴。"],{"ad":"隋"},"x239","隋"],["侯景即位时童谣","佚名","隋",["脱青袍。","著芒𪨗。","荆州天子挺应著。"],{"ad":"隋"},"x239","隋"],["江陵童谣","佚名","隋",["苦竹町。","市南有好井。","荆州军。","杀侯景。"],{"ad":"隋"},"x239","隋"],["湘东王府中为鱼宏徐绲谣","佚名","隋",["北路鱼。","南路徐。"],{"ad":"隋"},"x239","隋"],["柳达摩引北方童谣","佚名","隋",["石头捣两裆。","捣青复捣黄。"],{"ad":"隋"},"x239","隋"],["梁时童谣","佚名","隋",["虏万夫。","入五湖。","城南酒家使虏奴。"],{"ad":"隋"},"x239","隋"],["梁末童谣","佚名","隋",["可怜巴马子，一日行千里。","不见马上郎，但有黄尘起。","黄尘污人衣，皂荚相料理。"],{"ad":"隋"},"x239","隋"],["百姓为萧正德父子谣","佚名","隋",["宁逢五虎入市。","不欲见临贺父子。"],{"ad":"隋"},"x239","隋"],["鸟山童谣","佚名","隋",["鸟山出天子。"],{"ad":"隋"},"x239","隋"],["三馀童谣","佚名","隋",["夫子之居在三馀。"],{"ad":"隋"},"x239","隋"],["谚语后人引梁世谚论史职","佚名","隋",["上车不落则著作，体中保如则秘书。"],{"ad":"隋"},"x239","隋"],["梁元帝引谚论占雨","佚名","隋",["雨月额千里赤。"],{"ad":"隋"},"x239","隋"],["刘昼引谚","佚名","隋",["力贵突。","智贵卒。"],{"ad":"隋"},"x239","隋"],["刘昼引古谚","佚名","隋",["深不绝涓泉，稚子浴其渊。","高不绝丘陵，跛羊游其巅。"],{"ad":"隋"},"x239","隋"],["任昉引南海俗谚","佚名","隋",["蛇珠千枚。","不及玫瑰。"],{"ad":"隋"},"x239","隋"],["任昉引越人谚","佚名","隋",["种千亩木奴。","不如一龙珠。"],{"ad":"隋"},"x239","隋"],["颜之推引江南谚论书法","佚名","隋",["尺牍书疏，千里面目。"],{"ad":"隋"},"x239","隋"],["时人为张氏语","佚名","隋",["充融卷稷，是为四张。"],{"ad":"隋"},"x239","隋"],["时人为王谢子弟语","佚名","隋",["谢有览举。","王有养炬。"],{"ad":"隋"},"x239","隋"],["时人为张融陆杲语","佚名","隋",["无对日下，惟舅与甥。"],{"ad":"隋"},"x239","隋"],["时人为何子朗语 其一","佚名","隋",["东海三何。","子朗最多。"],{"ad":"隋"},"x239","隋"],["时人为何子朗语 其二","佚名","隋",["人中爽爽何子朗。"],{"ad":"隋"},"x239","隋"],["时人为王志王彬语","佚名","隋",["三真六草。","为天下宝。"],{"ad":"隋"},"x239","隋"],["时人为鲍正语","佚名","隋",["无处不逢鸟噪，无处不逢鲍佐。"],{"ad":"隋"},"x239","隋"],["巴东行人为庾子舆语","佚名","隋",["淫预如幞本不通。","瞿塘水退为庾公。"],{"ad":"隋"},"x239","隋"],["时人为玉莹语","佚名","隋",["欲向南，钱可贪。","遂向东，为黄铜。"],{"ad":"隋"},"x239","隋"],["省中为贺琛语","佚名","隋",["上殿不下有贺雅。"],{"ad":"隋"},"x239","隋"],["时人为丁觇语","佚名","隋",["丁君十纸。","不敌王褒数字。"],{"ad":"隋"},"x239","隋"],["都下为禅师语","佚名","隋",["斗场禅师窟，安东谈议林。"],{"ad":"隋"},"x239","隋"],["任昉引古诗论魏武陵","佚名","隋",["石犬不可吠。","铜驼徒尔为。"],{"ad":"隋"},"x239","隋"],["任昉引古诗论香泉","佚名","隋",["安得香水泉，濯朗衣上尘。"],{"ad":"隋"},"x239","隋"],["陌上桑","佚名","隋",["日出秦楼明，条垂露尚盈。","蚕饥心自急，开奁妆不成。"],{"ad":"隋"},"x239","隋"],["攀杨枝","佚名","隋",["自从别君来，不复著绫罗。","画眉不注口，施朱当柰何。"],{"ad":"隋"},"x239","隋"],["乐府诗","佚名","隋",["梧宫秋。","吴王愁。"],{"ad":"隋"},"x239","隋"],["企喻歌 其二","佚名","隋",["放马大泽中，草好马著膘。","牌子铁裲裆，?矛鸐尾条。"],{"ad":"隋"},"x239","隋"],["企喻歌 其三","佚名","隋",["前行看后行，齐著铁裲裆。","前头看后头，齐著铁?矛。"],{"ad":"隋"},"x239","隋"],["琅琊王歌辞 其二","佚名","隋",["琅琊复琅琊，琅琊大道王。","阳春二三月，单衫绣裲裆。"],{"ad":"隋"},"x239","隋"],["琅琊王歌辞 其三","佚名","隋",["东山看西水，水流盘石间。","公死姥更嫁，孤儿甚可怜。"],{"ad":"隋"},"x239","隋"],["琅琊王歌辞 其四","佚名","隋",["琅琊复琅琊，琅琊大道王。","鹿鸣思长章，愁人思故乡。"],{"ad":"隋"},"x239","隋"],["琅琊王歌辞 其五","佚名","隋",["长安十二门，光门最妍雅。","渭水从垄来，浮游渭桥下。"],{"ad":"隋"},"x239","隋"],["琅琊王歌辞 其六","佚名","隋",["琅琊复琅琊，女郎大道王。","孟阳三四月，移铺逐阴凉。"],{"ad":"隋"},"x239","隋"],["琅琊王歌辞 其七","佚名","隋",["客行依主人，愿得主人强。","猛虎依深山，愿得松柏长。"],{"ad":"隋"},"x239","隋"],["琅琊王歌辞 其八","佚名","隋",["𢙓马高缠鬃，遥知身是龙。","谁能骑此马，唯有广平公。"],{"ad":"隋"},"x239","隋"],["钜鹿公主歌辞 其一","佚名","隋",["官家出游雷大鼓。","细乘犊车开后户。"],{"ad":"隋"},"x239","隋"],["钜鹿公主歌辞 其二","佚名","隋",["车前女子年十五。","手弹琵琶玉节舞。"],{"ad":"隋"},"x239","隋"],["钜鹿公主歌辞 其三","佚名","隋",["钜鹿公主殷照女。","皇帝陛下万几主。"],{"ad":"隋"},"x239","隋"],["紫骝马歌辞 其一","佚名","隋",["烧火烧野田，野鸭飞上天。","童男娶寡妇，壮女笑杀人。"],{"ad":"隋"},"x239","隋"],["紫骝马歌辞 其二","佚名","隋",["高高山头树，风吹叶落去。","一去数千里，何当还故处。"],{"ad":"隋"},"x239","隋"],["紫骝马歌辞 其四","佚名","隋",["遥看是君家，松柏冢累累。","兔从狗窦入，雉从梁上飞。"],{"ad":"隋"},"x239","隋"],["紫骝马歌辞 其五","佚名","隋",["中庭生旅谷，井上生旅葵。","舂谷持作饭，采葵持作羹。"],{"ad":"隋"},"x239","隋"],["紫骝马歌辞 其六","佚名","隋",["羹饭一时熟，不知饴阿谁。","出门东向望，泪落沾我衣。"],{"ad":"隋"},"x239","隋"],["紫骝马歌","佚名","隋",["独柯不成树，独树不成林。","念郎锦裲裆，恒长不忘心。"],{"ad":"隋"},"x239","隋"],["黄淡思歌 其一","佚名","隋",["归归黄淡思，逐郎还去来。","归归黄淡百，逐郎何处索。"],{"ad":"隋"},"x239","隋"],["黄淡思歌 其二","佚名","隋",["心中不能言，腹作车轮旋。","与郎相知时，但恐傍人闻。"],{"ad":"隋"},"x239","隋"],["黄淡思歌 其三","佚名","隋",["江外何郁拂，龙洲广州出。","象牙作帆樯，绿丝作帏𫄴。"],{"ad":"隋"},"x239","隋"],["黄淡思歌 其四","佚名","隋",["绿丝何葳蕤。","逐郎归去来。"],{"ad":"隋"},"x239","隋"],["地驱乐歌 其一","佚名","隋",["青青黄黄，雀石颓唐。","槌杀野牛，押杀野羊。"],{"ad":"隋"},"x239","隋"],["地驱乐歌 其二","佚名","隋",["驱羊入谷，自羊在前。","老女不嫁，蹋地唤天。"],{"ad":"隋"},"x239","隋"],["地驱乐歌 其三","佚名","隋",["侧侧力力，念君无极。","枕郎左臂，随郎转侧。"],{"ad":"隋"},"x239","隋"],["地驱乐歌 其四","佚名","隋",["摩将郎须，看郎颜色。","郎不念女，不可与力。"],{"ad":"隋"},"x239","隋"],["地驱乐歌","佚名","隋",["月明光光星欲堕。","欲来不来早语我。"],{"ad":"隋"},"x239","隋"],["雀劳利歌辞","佚名","隋",["雨雪霏霏雀劳利。","长觜饱满觜饥。"],{"ad":"隋"},"x239","隋"],["慕容垂歌辞三曲 其一","佚名","隋",["慕容攀墙视，吴军无边岸。","我身分自当，枉杀墙外汉。"],{"ad":"隋"},"x239","隋"],["慕容垂歌辞三曲 其二","佚名","隋",["慕容愁愤愤，烧香作佛会。","愿作墙里燕，高飞出墙外。"],{"ad":"隋"},"x239","隋"],["慕容垂歌辞三曲 其三","佚名","隋",["慕容出墙望，吴军无边岸。","咄我臣诸佐，此事可惋叹。"],{"ad":"隋"},"x239","隋"],["陇头流水歌 其二","佚名","隋",["西上陇阪，羊肠九回。","山高谷深，不觉脚酸。"],{"ad":"隋"},"x239","隋"],["陇头流水歌 其三","佚名","隋",["手攀弱枝。","足逾弱泥。"],{"ad":"隋"},"x239","隋"],null,["陇头歌辞 其二","佚名","隋",["朝发欣城，暮宿陇头。","寒不能语，舌卷入喉。"],{"ad":"隋"},"x239","隋"],null,["隔谷歌 其一","佚名","隋",["兄在城中弟在外。","弓无弦。","箭无栝。","食粮乏尽若为活。","救我来。","救我来。"],{"ad":"隋"},"x239","隋"],["隔谷歌 其二","佚名","隋",["兄为俘虏受困辱。","骨露力疲食不足。","弟为官吏马食粟。","何惜钱刀来我赎。"],{"ad":"隋"},"x239","隋"],["淳于王歌 其一","佚名","隋",["肃肃河中育，育熟须含黄。","独坐空房中，思我百媚郎。"],{"ad":"隋"},"x239","隋"],["淳于王歌 其二","佚名","隋",["百媚在城中，千媚在中央。","但使心相念，高城何所妨。"],{"ad":"隋"},"x239","隋"],["东平刘生歌","佚名","隋",["东平刘生安东子。","树木稀。","屋里无人看阿谁。"],{"ad":"隋"},"x239","隋"],["捉搦歌 其一","佚名","隋",["粟谷难舂付石臼。","弊衣难护付巧妇。","男儿千凶饱人手。","老女不嫁只生口。"],{"ad":"隋"},"x239","隋"],["捉搦歌 其二","佚名","隋",["谁家女子能行步。","反著夹禅后裙露。","天生男女共一处。","愿得两个成翁妪。"],{"ad":"隋"},"x239","隋"],["捉搦歌 其三","佚名","隋",["华阴山头百丈井。","下有流水彻骨冷。","可怜女子能照影。","不见其馀见斜领。"],{"ad":"隋"},"x239","隋"],["捉搦歌 其四","佚名","隋",["黄桑柘屐蒲子履。","中央有丝两头系。","小时怜母大怜婿。","何不早嫁论家计。"],{"ad":"隋"},"x239","隋"],["折杨柳歌辞 其一","佚名","隋",["上马不捉鞭，反折杨柳枝。","蹀座吹长笛，愁杀行客儿。"],{"ad":"隋"},"x239","隋"],["折杨柳歌辞 其二","佚名","隋",["腹中愁不乐，愿作郎马鞭。","出入擐郎臂，蹀座郎膝边。"],{"ad":"隋"},"x239","隋"],["折杨柳歌辞 其三","佚名","隋",["放马两泉泽，忘不著连羁。","担鞍逐马走，何见得马骑。"],{"ad":"隋"},"x239","隋"],["折杨柳枝歌","佚名","隋",["门前一株枣，岁岁不知老。","阿婆不嫁女，那得孙儿抱。"],{"ad":"隋"},"x239","隋"],["幽州马客吟歌辞 其二","佚名","隋",["荧荧帐中烛，烛灭不久停。","盛时不作乐，春花不重生。"],{"ad":"隋"},"x239","隋"],["幽州马客吟歌辞 其三","佚名","隋",["南山自言高，只与北山齐。","女儿自言好，故入郎君怀。"],{"ad":"隋"},"x239","隋"],["幽州马客吟歌辞 其四","佚名","隋",["郎著紫裤褶，女著彩夹裙。","男女共燕游，黄花生后园。"],{"ad":"隋"},"x239","隋"],["幽州马客吟歌辞 其五","佚名","隋",["黄花郁金色，绿蛇衔珠丹。","辞谢床上女，还我十指环。"],{"ad":"隋"},"x239","隋"],["慕容家自鲁企由谷歌","佚名","隋",["郎在十重楼，女在九重阁。","郎非黄鹞子，那得云中雀。"],{"ad":"隋"},"x239","隋"],["高阳乐人歌 其一","佚名","隋",["可怜白鼻䯄，相将入酒家。","无钱但共饮，画地作交赊。"],{"ad":"隋"},"x239","隋"],["高阳乐人歌 其二","佚名","隋",["何处䑜觞来，两颊色如火。","自有桃花容，莫言人劝我。"],{"ad":"隋"},"x239","隋"],["咸阳宫人为咸阳王禧歌","佚名","隋",["可怜咸阳王。","奈何作事误。","金床玉几不能眠。","夜踏霜与露。","洛水湛湛弥岸长。","行人那得渡。"],{"ad":"隋"},"x239","隋"],["河北民为裴侠歌","佚名","隋",["肥鲜不食，丁庸不取。","裴公贞惠，为世规矩。"],{"ad":"隋"},"x239","隋"],["时人为上高里歌","佚名","隋",["洛阳城北上高里。","殷之顽民昔所止。","今日百姓造瓮子。","人皆弃去住者耻。"],{"ad":"隋"},"x239","隋"],["湘川渔者歌","佚名","隋",["帆随湘转。","望衡九面。"],{"ad":"隋"},"x239","隋"],["赵郡为李曾谣","佚名","隋",["诈作赵郡鹿。","犹胜常山粟。"],{"ad":"隋"},"x239","隋"],["河东民为元淑谣","佚名","隋",["泰州河东，杼柚代舂。","元公至止，田畴始理。"],{"ad":"隋"},"x239","隋"],["宣武孝明时谣","佚名","隋",["狐非狐。","貉非貉。","焦梨狗子齿断索。"],{"ad":"隋"},"x239","隋"],["孝明时洛下谣","佚名","隋",["铜拔打铁拔。","元家世将末。"],{"ad":"隋"},"x239","隋"],["清河民为宋世良谣 其一","佚名","隋",["宁度东吴会稽。","不历成公曲堤。"],{"ad":"隋"},"x239","隋"],["清河民为宋世良谣 其二","佚名","隋",["曲堤虽险贼何益。","但有宋公自屏迹。"],{"ad":"隋"},"x239","隋"],["洛中童谣二首 其一","佚名","隋",["三月末。","四月初。","杨灰簸土觅真珠。"],{"ad":"隋"},"x239","隋"],["洛中童谣二首 其二","佚名","隋",["头去项，脚根齐。","驱上树，不须梯。"],{"ad":"隋"},"x239","隋"],["西魏时童谣","佚名","隋",["獾獾头团𪢮。","河中狗子破尔苑。"],{"ad":"隋"},"x239","隋"],["东魏童谣","佚名","隋",["可怜青雀子，飞来邺城里。","羽翮垂欲成，化作鹦鹉子。"],{"ad":"隋"},"x239","隋"],["东魏武定末童谣","佚名","隋",["百尺高竿摧折。","水底燃灯灯灭。"],{"ad":"隋"},"x239","隋"],["祖珽引魏世谣","佚名","隋",["河南种谷河北生。","白杨树头金鸡鸣。"],{"ad":"隋"},"x239","隋"],["柳楷引谣","佚名","隋",["鸾生十子九子瑖。","一子不瑖关中乱。"],{"ad":"隋"},"x239","隋"],["诘汾力微谚","佚名","隋",["诘汾皇帝无妇家。","力微皇帝无舅家。"],{"ad":"隋"},"x239","隋"],["时人为李崇元融语","佚名","隋",["陈留章武，伤腰折股。","贪人败类，秽我明主。"],{"ad":"隋"},"x239","隋"],["时人为安丰中山济南三王语","佚名","隋",["三王楚楚尽琳琅。","未若济南备圆方。"],{"ad":"隋"},"x239","隋"],["时人为祖莹袁翻语","佚名","隋",["京师楚楚。","袁与祖。","洛阳翩翩。","祖与袁。"],{"ad":"隋"},"x239","隋"],["同门生为李谧语","佚名","隋",["青成蓝，蓝谢青。","师何常，在明经。"],{"ad":"隋"},"x239","隋"],["时人为元颐元钦语","佚名","隋",["皇宗略略。","寿安思若。"],{"ad":"隋"},"x239","隋"],["时人为王嶷语","佚名","隋",["实痴实昏。","终得保存。"],{"ad":"隋"},"x239","隋"],["百姓为公孙轨语","佚名","隋",["驴无强弱，辅脊自壮。"],{"ad":"隋"},"x239","隋"],["时人为王遵业王延明语","佚名","隋",["英英济济。","王家兄弟。"],{"ad":"隋"},"x239","隋"],["桑干乡里为房景伯语","佚名","隋",["有义有礼。","房家兄弟。"],{"ad":"隋"},"x239","隋"],["时人为崔楷语","佚名","隋",["莫?獬。","付崔楷。"],{"ad":"隋"},"x239","隋"],["李彪引谚","佚名","隋",["一日不书。","百事荒芜。"],{"ad":"隋"},"x239","隋"],["邢峦引俗谚","佚名","隋",["耕则问田奴，绢则问织婢。"],{"ad":"隋"},"x239","隋"],["高谦之引谚","佚名","隋",["迷而知反。","得道未还。"],{"ad":"隋"},"x239","隋"],["贼为杨津语","佚名","隋",["不畏利槊坚城。","惟畏杨公铁星。"],{"ad":"隋"},"x239","隋"],["相府为裴汉语","佚名","隋",["日下粲烂有裴汉。"],{"ad":"隋"},"x239","隋"],["杨衒之引语","佚名","隋",["洛阳男儿急作髻。","瑶光寺尼夺作婿。"],{"ad":"隋"},"x239","隋"],["杨衒之引谣语","佚名","隋",["狱中无系囚，舍内无青州。","假令家道恶，腹中不怀愁。"],{"ad":"隋"},"x239","隋"],null,null,["杨衒之引游侠语","佚名","隋",["不畏张弓拔刀。","唯畏白堕春醪。"],{"ad":"隋"},"x239","隋"],["杨衒之引秦民语","佚名","隋",["快马健儿。","不如老妪吹篪。"],{"ad":"隋"},"x239","隋"],["阚骃引语","佚名","隋",["沛国龙穴至山乘。","诈托旅使若奔丧。","道遇寇抄失资粮。"],{"ad":"隋"},"x239","隋"],null,["郦道元引俗谚论清泉河","佚名","隋",["高梁无上源，清泉无下尾。"],{"ad":"隋"},"x239","隋"],["郦道元引古语论南北岈","佚名","隋",["南岈北岈。","万有馀家。"],{"ad":"隋"},"x239","隋"],["郦道元引涝滩净滩谚","佚名","隋",["冬涝夏净。","断官使命。"],{"ad":"隋"},"x239","隋"],["郦道元引语","佚名","隋",["绵洛为没沃。"],{"ad":"隋"},"x239","隋"],["高允引谚","佚名","隋",["其益如毫。","其损如刀。"],{"ad":"隋"},"x239","隋"],["贾思协引谚论力耕","佚名","隋",["智如禹汤，不如常耕。"],{"ad":"隋"},"x239","隋"],["贾思协引谚论种谷树木","佚名","隋",["一年之计，莫如种谷。","十年之计，莫如树木。"],{"ad":"隋"},"x239","隋"],["贾思协引谚论锄地","佚名","隋",["锄头三寸泽。"],{"ad":"隋"},"x239","隋"],["贾思协引谚论养牛马","佚名","隋",["羸牛劣马。","寒食下。"],{"ad":"隋"},"x239","隋"],["贾思协引河西语","佚名","隋",["贷我东墙。","偿我田粱。"],{"ad":"隋"},"x239","隋"],["仇儒造妖言","佚名","隋",["燕东倾。","赵当续。","欲知其名。","淮水不足。"],{"ad":"隋"},"x239","隋"],["魏孝武帝迁长安时谚","佚名","隋",["荧惑入南斗。","天子下殿走。"],{"ad":"隋"},"x239","隋"],["阿那环","佚名","隋",["闻有匈奴主，杂骑起尘埃。","列观长平坂，驱马渭桥来。"],{"ad":"隋"},"x239","隋"],["杨白花","佚名","隋",["阳春二三月。","杨柳齐作花。","春风一夜入闺闼。","杨花飘荡落南家。","含情出户脚无力。","拾得杨花泪沾臆。","秋去春还双燕子。","愿衔杨花入窠里。"],{"ad":"隋"},"x239","隋"],["化胡歌七首 其一","佚名","隋",["我往化胡时，头载通天威。","金紫照虚空，燄燄有光晖。","胡王心懭戾，不尊我为师。","吾作变通力，要之出神威。","麾月使东走，须弥而西颓。","足踏干川桥，日月左右回。","天地昼暗昏，星辰牙差驰。","众灾竞地起，良医绝不知。","胡王心怖怕，叉手向吾啼。","作大慈悲教，化之渐微微。","落簪去一食，右肩不著衣。","男曰忧婆塞，女曰忧婆夷。","化胡今宾服，游神于紫微。"],{"ad":"隋"},"x239","隋"],["化胡歌七首 其二","佚名","隋",["我在舍卫时。","约敕瞿昙身。","汝共摩诃萨。","赍经教东秦。","历落神州界。","迫至东海间。","广宣至尊法。","教授聋俗人。","与子威神法。","化道满千年。","年终时当还。","慎莫恋中秦。","致令天气怒。","太上踏地瞋。","寺庙崩倒澌。","龙王舐经文。","八万四千弟子。","一时受大缘。","轮转五道头。","万元一升仙。","吾子三天上。","悯子泪流连。","念子出行道。","不能却死缘。","不能陵虚空。","束身入黄泉。","天门地户塞。","一去不能还。","虽得存禋嗣。","使子常塞心。","逆天违地理。","灾考加子身。","神能易生死。","由子行不真。","三十六天道。","终卒归无形。","我身西化时。","登上华狱山。","举目看昆仑。","须弥了了悬。","矫翼履清虚。","倏忽到西天。","但见西王母。","严驾欲东旋。","玉女数万千。","姿容甚丽妍。","天姿绝端严。","齐执皇灵书。","诵读仙圣经。","养我同时姝。","将我入天庭。","皇老东向坐。","身体皦然明。","授我仙圣道。","接度天下贤。"],{"ad":"隋"},"x239","隋"],["化胡歌七首 其三","佚名","隋",["我昔西化时。","登上华狱山。","北向视玄冥。","秦川荡然平。","汉少杂类多。","不信至真言。","吾后千馀年。","白骨如丘山。","尸骸路草野。","流血成洪渊。","不忍见子苦。","故作大秦吟。","哀叹二十颂。","以示通中贤。","见机降时世。","不值苦以辛。"],{"ad":"隋"},"x239","隋"],["化胡歌七首 其四","佚名","隋",["我昔化胡时，西登太白山。","修身岩石里，四向集诸仙。","玉女檐浆酪，仙人歌玉文。","天龙翼从后，白虎口驰刚。","玄武负钟鼓，朱雀持幢幡。","化胡成佛道，丈六金刚身。","时与决口教，后当存经文。","吾升九天后，克木作吾身。"],{"ad":"隋"},"x239","隋"],["化胡歌七首 其五","佚名","隋",["我昔离周时，西化向罽宾。","路由函关去，会见尹喜身。","尹喜通窈冥，候天见紫云。","知吾当西过，沐浴齐戒身。","日夜立香火，约敕守门人。","执简迎谒请，延我入皇庭。","叩搏亦无数，求欲从我身。","道取人诚信，三日口不言。","吾知喜心至，遗喜五千文。","欲得求长生，读之易精神。","将喜入西域，迁喜为真人。"],{"ad":"隋"},"x239","隋"],["化胡歌七首 其六","佚名","隋",["我西化胡时。","涉天靡不遥。","牵天覆六合。","艰难身尽婴。","胡人不识法。","放火烧我身。","身亦不缺损。","乃复沉深浏。","龙王折水脉。","复流不复行。","愚人皆哀叹。","枉此贤人身。","吾作腾波气。","起立上著天。","日月头上皦。","光照亿万千。","胡王心方悟。","知是我圣人。","叩头求悔过。","今欲奉侍君。","伏愿降灵气。","怒活国土人。","吾视怨家如赤子。","不顾仇以嫌。","化命一世士。","坐卧诵经文。","身无荣华饰。","后毕得升天。","吾告时世人。","三界里中贤。","欲求长生道。","莫爱千金身。","出身著死地。","返更得生缘。","火中生莲花。","尔乃是至真。","莫有生煞想。","得道升清天。","未负即真信。","丧子千金身。"],{"ad":"隋"},"x239","隋"],["化胡歌七首 其七","佚名","隋",["我昔学道时。","登崖历长松。","盘屈幽谷里。","求觅仙圣公。","食服泥洹散。","渐得不死踪。","九重室中得见不死童。","身体绝华丽。","二仪中无双。","遗我元气乐药。","忽然天圣聪。"],{"ad":"隋"},"x239","隋"],["尹喜哀叹五首 其一","佚名","隋",["尹喜告世人。","欲求长生道。","莫求时世荣。","我昔得道时。","身为关府君。","一日三赏赐。","杂彩以金银。","不以为己有。","施与贫穷人。","白日沾王事。","夜便习灵仙。","餐松食苦柏。","微命乃得存。","精诚神明佑。","守真仰苍天。","感得天地道。","遇见老君身。","难我以父母。","却遗五千文。","秘室熟读之。","三年易精神。","授我仙圣方。","都体解自然。"],{"ad":"隋"},"x239","隋"],["尹喜哀叹五首 其二","佚名","隋",["我昔上九天，下向视玄冥。","但见飞仙士，列翼影清天。","朝宗九天主，太上皇老君。","涤荡六府中，受读仙圣文。","王乔得圣道，游行五岳间。","服气食玉英，受命与天并。"],{"ad":"隋"},"x239","隋"],["尹喜哀叹五首 其三","佚名","隋",["昔往学道时，登岳历高冈。","动见百丈谷，赫赤道里长。","有无极神气，何以到西方。","元以度赤谷，垂泪数千行。","自念宿罪重，五内心摧伤。"],{"ad":"隋"},"x239","隋"],["尹喜哀叹五首 其四","佚名","隋",["我昔求道时，径历数千崖。","浮游八荒外，徒跣身无衣。","东过日出界，西寻清山累。","足底重䟢生，手中抱少微。","道见西王母，问我子何归。","耻身不学道，意欲觅仙师。","感我精诚至，乞我鞋以衣。","尔乃得学道，仙气渐微微。","父母怪我晚，昼夜悲嗥啼。","大道与俗返，一往不复归。","高志日日远，不觉心肝摧。","虽得不死道，日月垂微微。","心精不退转，今作天人师。"],{"ad":"隋"},"x239","隋"],["尹喜哀叹五首 其五","佚名","隋",["昔往学道时，踪迹亦难寻。","东到日出界，树木郁郁深。","南到阎浮提，大火烧我身。","西到俱地?，但见金城门。","青龙绕城腹，白虎守城前。","冲天金楼殿，太上居湛然。","光影耀虚空，仙人绝端严。","齐执黄卷书，口诵长生文。","北向入玄冥，大水湛湛深。","绕天数百迎，足底重䟢生。","尔乃得仙道，把揽天地神。","子能述吾道，白日得升天。"],{"ad":"隋"},"x239","隋"],["太上皇老君哀歌七首 其一","佚名","隋",["三十六宫主。","太上皇老君。","哀悯下世士。","垂神教世贤。","子欲修冥福。","先当体窈冥。","生时得尊贵。","不如过去荣。","仙驾龙车。","迎子游清天。","上登金楼殿。","坐卧虚空间。","行则飞仙从。","威仪上柱天。","朝登天东头。","暮到于天西。","戏乐九天外。","纵意极周旋。","驱使役百鬼。","总统于万金。"],{"ad":"隋"},"x239","隋"],["太上皇老君哀歌七首 其二","佚名","隋",["吾哀世愚民，不信冥中神。","恃力害良善，不避贤行人。","驰马骋东西，自谓常无前。","善恶毕有报，业缘须臾间。","神明在上见，遣使直往牵。","从上头底收，系著天牢门。","五毒更㸦加，恶神来克侵。","口吟不能言，妻子呼仓天。","莫怨神不佑，由子行不仁。"],{"ad":"隋"},"x239","隋"],["太上皇老君哀歌七首 其三","佚名","隋",["吾哀时世人，不信于神明。","先人与种福，子孙履上行。","衣厚饭得饱，灾考不到门。","口气头嘘天，自谓常终日。","看师真辽然，得病叩头请。","外恭心不敬，神明以知人。","三魂系地狱，七魄悬著天。","三魂消散澌，五神不安宁。","伺命来执宰，丞相踏地瞋。","左神不削死，右神不著生。","生神不卫护，煞神来入身。","或患腰背痛，或患头目疼。","百脉不复流，奋忽入黄泉。","天门地户闭，一去不复还。"],{"ad":"隋"},"x239","隋"],["太上皇老君哀歌七首 其四","佚名","隋",["吾哀世愚人，不信冥中神。","生时不恭敬，死便偿罪缘。","典官逐后驱，牵北走东西。","抱沙填江海，负石累高山。","白日不得食，夜分不得眠。","朝与杖一百，暮与鞭一千。","不堪考对苦，卖罪与生人。","两两共相牵，遂至死灭门。","皆由不敬道，神明考㰅人。","何不敬真神，生死得升天。","生荣死者乐，生死得蒙恩。"],{"ad":"隋"},"x239","隋"],["太上皇老君哀歌七首 其五","佚名","隋",["吾哀时世人，不信冥中神。","一门有十息，纵意行不仁。","神明鉴无外，终不滥煞人。","或夭华秀子，或夭妙少年。","门崩户以坏，学者如浮云。","死亦不脱岁，悲哭仍相寻。","妻子沉堙澌，一身孤独存。","呼天天玄远，呼地地亦深。","不能自怨责，各道怨师尊。","虽欲思善道，十子不复还。"],{"ad":"隋"},"x239","隋"],["太上皇老君哀歌七首 其六","佚名","隋",["吾告时世人，修道宜殷勤。","恩亦不虚生，神明必报人。","昔有刘仲伯，精诚于道门。","勤恶使从善，岁会集群贤。","香火日夜勤，亦能感仓天。","命尽应当死，众神与表天。","三魂飞杨澌，七魄入死星。","右神削死藉，左神著生名。","伺命来极济，左相踏地瞋。","普告二十狱，拔出仲伯身。","三魂还复流，七魄还入身。","血脉还运转，百节方更坚。","面目更端严，肉骨更鲜明。","死臣三七日，寝尸还更生。"],{"ad":"隋"},"x239","隋"],["太上皇老君哀歌七首 其七","佚名","隋",["吾告时世人，髐骨不别真。","闲时不共语，急便来求人。","死者如流水，去者如浮云。","秦川屯军马，中庭生丛榛。","百中不留一，到思吾本言。","何不学仙道，人身常得存。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其一","佚名","隋",["一变之时。","生在南方亦如火。","出胎堕地能独坐。","合口诵经声璅璅。","眼中泪出珠子䂺。","父母世间惊怪我。","复畏寒冻来结果。","身着天衣谁知我。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其二","佚名","隋",["二变之时。","生在西岳在汉川。","寄生王家练精神。","出胎堕地谁语言。","晃晃昱昱似金银。","三十六色绮罗文。","国王欢喜会群臣。","英儒雅士平论。","忽然变化作大人。","发眉皓白头柱天。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其三","佚名","隋",["三变之时。","变形易体在北方。","出胎堕地能居床。","合口诵经声琅琅。","额上三午十二行。","两手不门把文章。","配名天地厚阴阳。","从石入金快翱翔。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其四","佚名","隋",["四变之时。","生在东方身青葱。","出胎堕地能瞳舂。","合口诵经声雍雍。","白日母抱夜乘龙。","昆仑山上或西东。","上天入地登虚空。","仙人侍从数万里。","当此之时神气通。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其五","佚名","隋",["五变之时。","生在中都在洛川。","嵩高少室岭岑颠。","中央修福十万年。","教授仙人数万千。","齐得升天入青云。","降鉴周室八百年。","运终数尽向罽宾。","化胡成佛还东秦。","敷杨道教整天文。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其六","佚名","隋",["六变之时。","生在干地西北角。","图画天地立五岳。","处置星辰叙四渎。","二十八宿注乡曲。","日月照曜为下国。","走如流水得周局。","智者察之知急速。","雨泽以时熟五䅽。","万人食之大化足。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其七","佚名","隋",["七变之时。","生在北方在海嵎。","出胎堕地声由由。","好喜歌舞无忧愁。","造作音乐作箜篌。","万帝来请用解忧。","黄河为路行竟头。","一身涉世快游游。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其八","佚名","隋",["八变之时。","生在东北在艮地。","图尽天地我次比。","白衣居士维靡诘。","欲结坐禅须谙气。","通畅经书有舍利。","见吾相好须信企。","感子单诚不延次。","齐得升天不堕地。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其九","佚名","隋",["九变之时。","下人黄泉正地柱。","开辟天地施地户。","四气非阳立冥所。","虽有人民不能语。","吾入身中施六府。","胁为傍通心为主。","从此以来能言语。","尊卑大小有次绪。","万天称传道为父。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其十","佚名","隋",["十变之时。","生在东南出风门。","尽出天道安山川。","置立五岳集灵仙。","吹嘘寒暑生万民。","烦气众生人得真。","置立五藏施心神。","动作六神能语言。","有生有死须臾间。","如水东流何时还。","邂逅相代不得停。","何不习善求长生。","槃散流俗入胶盆。","不能免离丧子身。","欲求度世于中禅。","搦心不坚固仙根。","音聋音哑都不伦。","由子前身谤经文。","论说道士毁圣人。","在恶必报受罪缘。","但勤自责莫怨天。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其十一","佚名","隋",["十一变之时。","生在南方阎浮地。","造作天地有作为。","化生万物由婴儿。","阴阳相对共相随。","众生禀气各自为。","番息众多满地池。","生活自卫由乘靡。","劫数灭尽一时亏。","洪水滔天到月支。","选擢种民留伏羲。","思之念之立僧秪。","唯有大圣共相知。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其十二","佚名","隋",["十二变之时。","生在西南在黄昏。","时人厌贱还?身。","善权方略更受新。","寄胎托俗蟒蛇身。","胎中诵经不遇人。","左胁而出不由关。","堕地七步杂秽间。","九龙洗浴人不闻。","国王欢喜立东宫。","与迎新妇守衢夷。","八百伎女营乐身。","八研四升不破禅。","破散库藏施贫人。","道十八人诣宫门。","贾作大丑婆罗门。","借问太子何时还。","王心不语动王情。","骑王白象触王瞋。","先师知意不与言。","?著擅特在丘。","投身饿虎求道门。","变为白狗数百身。","稽骨须弥示后人。","传语后学须精勤。","莫贪秽辱丧子身。","沉累六趣更生难。","不信我语至时看。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其十三","佚名","隋",["十三变之时。","变形易体在罽宾。","从天而下无根元。","号作弥勒金刚身。","胡人不识举邪神。","兴兵动众围圣人。","积薪国北烧老君。","太上慈悯怜众生。","渐渐诱进说法轮。","剔其须发作道人。","横被无领涅槃僧。","蒙头著领待老君。","手捉锡杖惊地虫。","卧便思神起诵经。","佛气错乱欲东秦。","梦应明帝张愆迎。","白象驮经诣洛城。","汉家立子无人情。","舍家父母习沙门。","亦无至心逃避兵。","不玩道法贪治生。","搦心不坚还俗经。","八万四千应罪缘。","破塔怀庙诛道人。","打?铜像削取金。","未荣几时还造新。","虽得存立帝恐心。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其十四","佚名","隋",["十四变之时。","变形易像在金卫。","沙门闱城说经偈。","至著罪人未可济。","胡人闻之心恐怪。","将从群党来朝拜。","叩头悔过求受戒。","克肌克骨誓不退。","烧指练臂自盟誓。","男不妻娶坐思禅。","死为尸陁喂鹰鹯。","迁神涅槃舍利弗。","骨得八百升散诸国。","如此迁达离烦欲。","苦身求道立可得。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其十五","佚名","隋",["十五变之时。","西向教化到罽宾。","胡国相厘还迦夷。","侵境暴耗买育人。","男子守塞忧婆夷。","吾入国中作善词。","说化男子受三归。","渐渐诱进说法轮。","剔其须发作道人。","阳为和上阴阿尼。","假作父母度僧尼。","师徒相度理无私。","迁神涅槃归紫微。","四镇安穆和我神。","胡人思念长吁啼。","铸作金像法我形。","三时入礼求长生。","寂寂寞寞不应人。","低头视地仰看天。","大圣正真何时还。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其十六","佚名","隋",["十六变之时。","生在蒲林号有遮。","大富长者树提阇。","有一手巾像龙蛇。","遣风吹去到王家。","国王得之大叹咤。","兴兵动众来向家。","离舍百里见莲花。","国有审看一月夜。","王心恶之欲破家。","忽然变化白净舍。","出家求道号释迦。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其十七","佚名","隋",["五百岁之时。","乘龙驾虎道得昌。","汉地广大历记长。","三十六人计弟兄。","超度北阙云中翔。","新卢酒出俱行尝。","娥媚出边作细昌。","当此之时乐未央。","伊耶乐生寿命长。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其十八","佚名","隋",["六百岁之时。","一世以去二世归。","城郭如故时人非。","观者众多知我谁。","死生各异令人悲。","何不学道世欲衰。","踟蹰西北长吁谁。","伊耶乐生治太微。"],{"ad":"隋"},"x239","隋"],["斛律丰乐歌","佚名","隋",["朝亦饮酒醉。","暮亦饮酒醉。","日日饮酒醉。","国计无取次。"],{"ad":"隋"},"x239","隋"],["兖州民为郑氏父子歌","佚名","隋",["大郑公。","小郑公。","相去五十载。","风教尚犹同。"],{"ad":"隋"},"x239","隋"],["邯郸郭公歌","佚名","隋",["邯郸郭公九十九。","技两渐尽入滕口。","大儿缘高冈。","雉子东南走。","不信吾言时。","当看岁在酉。"],{"ad":"隋"},"x239","隋"],["济北民为崔伯谦歌","佚名","隋",["崔府君。","能治政。","易鞭鞭。","布威德。","民无争。"],{"ad":"隋"},"x239","隋"],["文宣时谣","佚名","隋",["马子入石室。","三千六百日。"],{"ad":"隋"},"x239","隋"],["废帝时童谣三首 其一","佚名","隋",["白头羊毣秃。","羖𦍠历头生角。"],{"ad":"隋"},"x239","隋"],["废帝时童谣三首 其二","佚名","隋",["羊羊吃野草。","不吃野草远我道。","不远打尔脑。"],{"ad":"隋"},"x239","隋"],["废帝时童谣三首 其三","佚名","隋",["阿?姑。","祸也。","道人姑夫。","死也。"],{"ad":"隋"},"x239","隋"],["孝昭时童谣","佚名","隋",["中兴寺内白凫翁。","四方侧听声雍雍。","道人闻之夜打钟。"],{"ad":"隋"},"x239","隋"],["武成殂后谣","佚名","隋",["千钱买果园，中有芙蓉树。","破家不分明，莲子随它去。"],{"ad":"隋"},"x239","隋"],["武平元年童谣","佚名","隋",["狐截尾。","你欲除我我除你。"],{"ad":"隋"},"x239","隋"],["武平中童谣","佚名","隋",["和士开。","七月三十日。","将你向南台。"],{"ad":"隋"},"x239","隋"],["武平中童谣","佚名","隋",["七月刈禾伤早。","九月吃糕正好。","十月洗荡饭瓮。","十一月出却赵老。"],{"ad":"隋"},"x239","隋"],["曲严祖珽为斛律光造谣二首 其一","佚名","隋",["百升飞上天。","明月照长安。"],{"ad":"隋"},"x239","隋"],["曲严祖珽为斛律光造谣二首 其二","佚名","隋",["高山不推自崩。","槲木不扶自竖。","盲老公背上下大斧。","饶舌老母不得语。"],{"ad":"隋"},"x239","隋"],["武成时童谣","佚名","隋",["九龙母死不作孝。"],{"ad":"隋"},"x239","隋"],["北齐末邺中童谣","佚名","隋",["金作扫帚玉作把，净扫殿屋迎西家。"],{"ad":"隋"},"x239","隋"],["武平末童谣","佚名","隋",["黄花势欲落。","清尊但满酌。"],{"ad":"隋"},"x239","隋"],["徐之范引童谣","佚名","隋",["周里跂求伽。","豹祠嫁石婆。","斩冢作媒人。","唯得一量紫𫄧靴。"],{"ad":"隋"},"x239","隋"],["杨子术引谣言","佚名","隋",["卢十六。","稚十四。","犍子拍头三十二。"],{"ad":"隋"},"x239","隋"],null,["齐人为苏珍之宋世轨语","佚名","隋",["决定嫌疑苏珍之，视表见里宋世轨。"],{"ad":"隋"},"x239","隋"],["省中为祖珽裴让之语","佚名","隋",["多奇多能祖孝征，能赋能诗裴让之。"],{"ad":"隋"},"x239","隋"],["文林馆中为陆乂语","佚名","隋",["五经无对。","有陆乂。"],{"ad":"隋"},"x239","隋"],["颜之推引俗谚论教子","佚名","隋",["教妇初来。","教儿婴孩。"],{"ad":"隋"},"x239","隋"],["颜之推引谚论治家","佚名","隋",["落索阿姑餐。"],{"ad":"隋"},"x239","隋"],["时人为陈元康语","佚名","隋",["三崔二张。","不如一康。"],{"ad":"隋"},"x239","隋"],["邺下为陆仲让语","佚名","隋",["讲义两行得中郎。"],{"ad":"隋"},"x239","隋"],["时人为唐邕白建言","佚名","隋",["并州赫赫唐与白。"],{"ad":"隋"},"x239","隋"],["时人为裴皇甫二姓兄弟语","佚名","隋",["诹胜于让。","和不如亮。"],{"ad":"隋"},"x239","隋"],["时人为冯祖赵三氏子语","佚名","隋",["冯祖及赵，秽我凤池。"],{"ad":"隋"},"x239","隋"],["御史台中为宋游道语","佚名","隋",["见贼能讨。","宋游道。"],{"ad":"隋"},"x239","隋"],["时人为宋游道陆操语","佚名","隋",["游道狝猴面。","陆操科斗形。","意识不关貌。","何谓丑者必无情。"],{"ad":"隋"},"x239","隋"],["邺下为李氏兄弟语","佚名","隋",["学则浑绘纬，口则绘纬浑。"],{"ad":"隋"},"x239","隋"],["时人为义深语","佚名","隋",["剑戟森森。","李义深。"],{"ad":"隋"},"x239","隋"],["时人为阳休之语","佚名","隋",["能赋能诗。","阳休之。"],{"ad":"隋"},"x239","隋"],["时人为阴凤语","佚名","隋",["阴生读书不免痴。","不识双凤脱人衣。"],{"ad":"隋"},"x239","隋"],["时人为法上谚","佚名","隋",["沙弥若来。","高座逢灾。"],{"ad":"隋"},"x239","隋"],["大禘圜丘及北郊歌辞十三首 其一 肆夏","佚名","隋",["肇应灵序，奄字黎民。","乃朝万国，爰征百神。","只展方望，幽显咸臻。","礼崇声协，贽列圭陈。","翼差鳞次，端拱垂绅。","来趋动色，式赞天人。"],{"ad":"隋"},"x239","隋"],["大禘圜丘及北郊歌辞十三首 其二 高明乐","佚名","隋",["惟神鉴矣，皇灵肃止。","圜璧展事，成文即始。","士备八能，乐合六变。","风凑伊雅，光花袭荐。","宸卫腾景，灵驾霏烟。","严坛生白，绮席凝玄。"],{"ad":"隋"},"x239","隋"],["大禘圜丘及北郊歌辞十三首 其三 昭夏乐","佚名","隋",["刚柔凤位，惟皇配之。","言肃其礼，念畅在兹。","饰牲举兽，载歌且舞。","既设伊腯，致精灵府。","物色惟典，斋沐加恭。","宗族咸暨，罔不率从。"],{"ad":"隋"},"x239","隋"],["大禘圜丘及北郊歌辞十三首 其四 昭夏乐","佚名","隋",["展礼上月，肃事应时。","茧栗为用，交畅有期。","弓矢斯发，瓮簝将事。","圆神致祀，率由先志。","和以銮刀，臭以血膋。","至哉敬矣，厥义孔高。"],{"ad":"隋"},"x239","隋"],["大禘圜丘及北郊歌辞十三首 其五 皇夏乐","佚名","隋",["帝敬昭宣，皇诚萧致。","玉帛齐轨，屏摄咸次。","三垓上列，四陛旁升。","龙陈万骑，凤动千乘。","神仪天蔼，睟容离曜。","金根停轸，奉光先导。"],{"ad":"隋"},"x239","隋"],["大禘圜丘及北郊歌辞十三首 其六 皇夏乐","佚名","隋",["紫坛云暧，绀幄霞褰。","我其陟止，载致其虔。","百灵竦听，万国咸仰。","人神咫尺，玄应肸蚃。"],{"ad":"隋"},"x239","隋"],["大禘圜丘及北郊歌辞十三首 其七 高明乐","佚名","隋",["上下眷，旁午从。","爵以质，献以恭。","咸斯畅，乐唯雍。","孝敬阐，临万邦。"],{"ad":"隋"},"x239","隋"],["大禘圜丘及北郊歌辞十三首 其八 高明乐","佚名","隋",["自天子之，会昌神道。","丘陵肃事，克光天保。","九关洞开，百灵环列。","八樽呈备，五声投节。"],{"ad":"隋"},"x239","隋"],["大禘圜丘及北郊歌辞十三首 其九 武德乐","佚名","隋",["配神登圣，主极尊灵。","敬宣昭烛，咸达窅冥。","礼弘化定，乐赞功成。","穰穰介福，下被群生。"],{"ad":"隋"},"x239","隋"]]