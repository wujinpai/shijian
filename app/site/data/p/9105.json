[null,null,["【正宫】白鹤子","关汉卿","五言绝句",["四时春富贵，万物酒风流。","澄澄水如蓝，灼灼花如绣。"],0,"x215","元"],["句 其五","赵佶","七言绝句",["方当月白风清夜，正是霜高木落时。","落花满地春光晚，芳草连云暮色深。"],0,"x109","金"],["宫词 其四","赵佶","七言绝句",["宫嫔馀乐称幽闲，不喜浓妆斗媚颜。","浣罢竹风蠲浊虑，一轮明月照屏山。"],0,"x109","金"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["宫词 其一","赵佶","七言绝句",["晓景熙熙竹影疏，柔闲初理薄妆馀。","心情酷爱清虚乐，琴阮相兼一几书。"],0,"x109","金"]]