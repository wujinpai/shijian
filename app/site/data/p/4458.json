[["王国祀仁祖庙乐八章 其一 迎神奏淳和之曲","宋濂","四言",["皇图聿崇，茅社受封。","礼分虽异，孝思则同。","缅怀世德，源深流鸿。","报本有祀，式昭神功。"],0,58,"明"],["王国祀仁祖庙乐八章 其二 奉牲奏庆和之曲","宋濂","四言",["王国之东，清庙翼翼。","奉我皇祖，享祀弗忒。","荐以牲牷，敢曰充腯。","神其迪尝，纯嘏是锡。"],0,58,"明"],["王国祀仁祖庙乐八章 其三 初献奏保和之曲","宋濂","四言",["皇祖载德，既淳且仁。","弗耀其身，委祉后人。","眷兹藩服，典祀维寅。","清醴方荐，歆其苾芬。"],0,58,"明"],["王国祀仁祖庙乐八章 其四 亚献奏清和之曲","宋濂","四言",["穆穆灵宫，庭燎有炜。","贰觞载升，神其乐止。","其乐伊何，锡我繁祉。","磐石之宗，本支百世。"],0,58,"明"],["王国祀仁祖庙乐八章 其五 终献奏成和之曲","宋濂","四言",["神兮下临，陟降在庭。","不见其形，如闻其声。","冷风萧然，达于两楹。","礼成三终，神保攸宁。"],0,58,"明"],["王国祀仁祖庙乐八章 其六 饮福奏咸和之曲","宋濂","四言",["神具醉止，威仪孔肃。","曰尔孝孙，来饮尔福。","介尔眉寿，膺尔百禄。","子孙保之，以引以续。"],0,58,"明"],["王国祀仁祖庙乐八章 其七 彻豆奏嘉禾之曲","宋濂","四言",["礼备乐举，祀事攸宜。","孰其尸之，废彻不迟。","皇哉神惠，覃及我私。","灵氛将逝，如何勿思。"],0,58,"明"],["王国祀仁祖庙乐八章 其八 送神奏德和之曲","宋濂","四言",["杳兮忽兮，神运无迹。","鸾驭上征，星流飙疾。","其灵在天，其主在室。","亿万斯年，孝思无斁。"],0,58,"明"],["宋铙歌鼓吹曲十二首 其九 王师伐江南江南主李煜䧏时彗出柳历舆儿为彗出柳第九","宋濂","四言",["维彗出柳，六合布新。","矧此弹丸，何敢不臣。","雕弓宛转，铁骑参潭。","天堑未度，已无江堧。","帝诏将臣，俟其来宾。","慎毋疾击，以病吾民。","长蛇成围，不异祥麟。","孱王既䧏，市无惊尘。","大宣皇化，覃于至仁。"],0,58,"明"],["风树亭诗","宋濂","四言",["山有嘉树，油然发荣。","岂不欲静，风挠之鸣。","我思我亲，颜猊日改。","子欲养之，亲不子待。","呜呼噫嚱，孔怀孔悲。","山高海深，孰堪喻之。","内而九藏，外而四体。","皆亲之枝，同一根柢。","根既拨矣，而枝独存。","夙夜哀号，莫达九原。","白杨萧萧，泉扃夜閟。","我亲我思，得无蕉瘁。","亲不可见，音容是求。","求之不得，血泪交流。","作亭墓隅，是曰风树。","仰之瞻之，心焉孔瘁。"],0,58,"明"],["灵槐诗","宋濂","四言",["难谌惟帝，厥命孔赫。","鉴于九有，显相有德。","先宋九君，既南而微。","微不遂倾，世臣毗之。","世臣之家，鄮山之下。","岁时来归，旗节车马。","冯轼而趋，衮衣佩璜。","其绶伊何，将相之章。","雄城渠渠，黎庶如雨。","相臣戾止，耄倪咸喜。","岂无公侯，孰能后昆。","三相二王，国存与存。","谁其尸之，其德有始。","既受多祜，又有孙子。","钜海汤汤，朔风荒荒。","不沦于危，不显其光。","孰云菑播，而不有获。","天将昌之，嘉征允灼。","崇堂有庭，其左有槐。","匪植而生，惟德是培。","天实培之，或戕于人。","人力虽劳，其能胜天。","南园膴膴，有萌期蘖。","其本如达，靡有摧害。","始轧而卑，忽拔而穹。","其兆斯何，宜卿宜公。","明明天子，俊乂是使。","矧兹世家，王公之嗣。","嗟尔君子，天休汝膺。","何以占之，灵槐在庭。"],0,58,"明"],["赠阎希曾参政山东诗","宋濂","四言",["山东钜藩，统府惟六。","民物阜蕃，土地饶沃。","宸衷轸之，百司棋布。","谁挈其纲，政乃无斁。","乃诏近臣，尔钝尔往。","宣朕至怀，参佐其长。","臣钝曰吁，臣恐弗胜。","方岳重镇，厥任匪轻。","帝曰俞哉，尔毋固辞。","精白一心，力行无疑。","钝拜稽首，即日启行。","君臣一心，共底隆平。","我知阎子，有学有文。","五色灿然，出类超群。","子之往矣，期建功勋。","贮见政绩，迈于古人。","古人有云，尽瘁国事。","子尚勉旃，服之毋忒。"],0,58,"明"],["有田","张养浩","四言",["有田负郭，伊迩匪辽。","我倦而归，于焉逍遥。","爰力于书，且勤于苗。","朝斯夕斯，以咏以谣。","式结今好，言报夙劳。","山既我狎，川亦余媚。","维禽维鱼，亦莫余畏。","林则有风，洞则有云。","酿则有秫，馔则有芹。","樵则有柯，钓则有纶。","维人至乐，曰丘曰壑。","得而颛之，何有人爵。","彼爵与名，岂不我荣。","其或舍旃，允有未任。","允有未任，且以鼓琴。"],0,31,"元"],["题钟馗","张昱","四言",["梦以自见，正以辟邪。","赐之袍笏，人耶鬼耶？"],0,"x243","明"],["萧权府三害图","李俊民","四言",["长桥之蛟，南山之虎。","在彼州曲，父老所苦。","岂独若此，亦有周处。","周乃慨然，耻闻斯语。","薄险投深，踊跃健武。","尔蛟既除，尔虎既去。","周乃自励，履规蹈矩。","卒以将种，效忠典午。","按剑平西，贞节克举。","瑕以瑜掩，过以功补。","身虽云亡，名播千古。"],0,"x244","金"],["止姚亚之刲羊","李俊民","四言",["养生之鞭，陇种之苗。","欲鲁去朔，在齐闻韶。","咄嗟老饕，腹如瓠枵。","踏破菜园，合吃藤条。"],0,"x244","金"],["焦天禄野叟听音图","李俊民","四言",["梨园弟子，天宝之后。","谁其知音，百岁遗叟。","曲终怅然，泪迸林薮。","时清眼明，万事缄口。"],0,"x244","金"],["唐叔王韦生卧虎图","李俊民","四言",["梁鸯之养，或失其时。","曹公之肉，不救其饥。","羊质而皮，狐假而威。","谁能于此，辩是与非。"],0,"x244","金"],["学中史正之会客","李俊民","四言",["有怀伊人，在泮饮酒。","我客戾止，其尝旨否。","未见君子，我心孔疚。","惠然肯来，小大稽首。"],0,"x244","金"],["烟江绝岛图","李俊民","四言",["江风不波，峭壁森立。","冥冥飞鸿，翔而后集。"],0,"x244","金"],["双松古渡图","李俊民","四言",["倾盖相逢，堂堂两公。","寂寥渡口，以济不通。"],0,"x244","金"],["古柏寒泉图","李俊民","四言",["冬夏长青，昼夜不舍。","拔本塞源，岂知量者。"],0,"x244","金"],["纸扇","李俊民","四言",["竹疏而骨，楮剥而肤。","权以行巽，风乎坐隅。"],0,"x244","金"],["棕扇","李俊民","四言",["直节贯中，怒发冲上。","朝蝇暮蚊，畏风长往。"],0,"x244","金"],["扇面画竹","凌云翰","四言",["故人清风，美人明月。","胡为来哉，君子之节。"],0,"x246","元"],["郭景谅画","凌云翰","四言",["月来中天，琴声以和。","爰有君子，于焉咏歌。","松风递清，石泉流响。","顾瞻白云，入我遐想。","有道之裔，媲美林宗。","假此图画，像此从容。","云月无穷，松泉有待。","善琴弗鼓，万境斯在。"],0,"x246","元"],["旭斋诗","凌云翰","四言",["九日为旭，羿不能射。","荒唐之言，孰有知者。","旭日始旦，出日东方。","君子昭德，如彼朝阳。","以诚而倾，类葵与藿。","日入日出，我息我作。","惟刘氏子，志于高明。","爰有斋居，以旭自名。","日新又新，用之曷匮。","其休以德，其拙以伪。","我作此诗，惟明自资。","孰传草圣，为汝书之。"],0,"x246","元"],["时雨","赵秉文","四言",["天降时雨，山川出云。","天相休运，是生世臣。","维我世臣，乃国于莘。","天子命之，牧尔邦民。","北风喈喈，雨雪霏霏。","嗟我晋人，而疮而痍。","吹之呴之，摩之拊之。","于燠其寒，于饱其饥。","既瘳既夷，不嚬以嘻。","孰为豺虎，载栅载垒。","孰为蟊贼，载芟载理。","无扰我乡，我乡我里。","无伐我桑，我桑我梓。","远夷駾矣，我民休矣。","公在在堂，如春斯温。","激矢在壶，折冲于樽。","民安于廛，兵安于屯。","公在在堂，锦衣绣裳。","敝予改为，斯民不忘。","公在在堂，绣裳锦衣。","我民之思，无以公归。"],0,"x220","金"],["皇武","赵秉文","四言",["皇奋厥武，如雷如霆。","犷彼远夷，载震载惊。","帝命相臣，苏我疲民。","维时莘公，展也大成。","公自平阳，移镇于秦。","世皆谓公，有脚阳春。","公在在秦，百年无兵。","世皆谓公，斯民德星。","维此二方，不宁不令。","帅臣议征，发言盈庭。","公奏累上，如山不倾。","世皆谓公，汉之营平。","既宅三辅，复保五城。","以迄于今，夏人请盟。","维将尽能，维公竭诚。","公拜稽首，天子之明。","我公归矣，我民思矣。","诏公复起，周邦咸喜。","愿公百年，以佐天子。","罔俾樊侯，于周专美。"],0,"x220","金"],["旌表孝义金门","郑元祐","四言",["出吴东门，沄沄其水。","傅陆以居，居民栉齿。","不有孝义，众何所恃？","孝义伊何？","曰维金氏。","百五十祀，业儒循轨。","事亲养志，同气敬顺。","兄掌家钥，弟秉文印。","不矜而誉，不言而信。","里举乡推，事腾于朝。","用旌其门，以阐教条。","张书扁式，与表迩远。","守臣树声，加示庆典。","坊名孝义，大厥里门。","彰善瘅恶，周书具存。","吴固沃土，才隳于膴。","风颓俗靡，事鲜俪古。","求若孝义，几何其心？","堪继公艺，价重南金。","克孝克义，我谣我歌。","借耰阋墙，敦化猗那。"],0,"x254","元"],["高昌契侯三节堂","郑元祐","四言",["惟天启契，产自辇水。","润被北庭，侯济厥美。","挺事昌朝，忠武罕比。","戡金平宋，策审功侈。","入毗庙堂，黔黎安只。","蛮酋兽犷，侯辕南指。","忠愤踊跃，奋莫顾己。","忠诚贯天，白虹触起。","孱孱孤嫠，哭侯孔哀。","誓死靡他，夫人贞哉。","贞哉夫人，夫死儿乳。","教儿能孝，父志在汝。","齿方成童，母病弗疗。","刲肱和糜，人孰儿诏？","彼美至性，移孝而忠。","抚字列城，继侯英风。","侯既有子，且复有孙。","孙皆读书，益大侯门。","相继掇科，荐承宠光。","侯其来归，英爽乐康。","子佩金符，孙萦紫绶。","世讶其隆，侯植之厚。","三节一贯，何有夷险？","恊于王风，永配令典。"],0,"x254","元"],["可斋","郑元祐","四言",["大哉宣圣，以诗教我。","兴观群怨，皆与曰可。","诚笃是学，感发志意。","善善恶恶，庶全美刺。","诗人得失，于焉考见。","妍媸在已，反省毋眩。","和以处众，不至于流。","设使雷同，其道亦缪。","惩创羞恶，中惟一致。","温柔敦厚，慎勿暴气。","用以事亲，孝哉有子。","移以为忠，曾不越此。","鸟兽草木，名类匪一。","惟笃学问，旁资多识。","是我宣圣，以诗设教。","下逮百王，是则是效。","嘉子嗜学，尤勤于诗。","以可名斋，义实在兹。","六义具存，既殚源委。","以咏以歌，性情斯理。"],0,"x254","元"],["登鸿山吊梁伯鸾","郑元祐","四言",["我以饥驱，爰求乐土。","居近山麓，山名孔膴。","问之父老，曰伯鸾父。","尝登兹山，览历平楚。","因以名山，义匪夸诩。","注意山栖，兹非其所。","敬吊夫子，愿嗣德音。","隼栖择高，鱼游择深。","夫子当时，五噫讴吟。","出都接浙，笑掷华簪。","归隐杵臼，佣力是任。","配谐德曜，雍雍鼓琴。","上窥羲轩，下混古今。","以乐此心，俪古傲今。","而我肱折，不知息心。","年登知命，尚浮尚沈。","圣域缅邈，世途崎崟。","矢从夫子，投迩深窅。","既齐物我，兼忘昏晓。","万里非旷，一隙非小。","毋曰昭昭，示人皦皦。","聊从兹逝，以谢胶扰。","夫子不违，罔知适从。","蝇附以骥，菟罥以松。","有薪朝炊，有稻夜砻。","式依夫子，娱老考终。","优哉悠哉，歌以相舂。"],0,"x254","元"],["兰","郑元祐","四言",["恊以鼓琴，世谁知音？","采苢纫佩，湘江水深。","兰生棘中，如石轥玉。","玉受不瑳，幽香满谷。"],0,"x254","元"],["为李绎成悼其妻冯氏","郑元祐","四言",["彼美者媛，令姿静淑。","姆教在鞶，懿范端肃。","择配皙士，闻望右族。","读书思荣，焚膏继晷。","媛来主馈，克承夫志。","载缉载纫，裳衣补缀。","奉飧举案，翼若始祭。","倏遭百罹，彩凤分飞。","鼓盆哭哀，语及涕洟。","人孰无妇？","妇贤而暌。","永怀弗谖，爰形声诗。"],0,"x254","元"],["春晖楼","郑元祐","四言",["阳春有晖，泛在物表。","寸草承之，弗间其小。","春晖熙熙，彼草离离。","区萌就质，芃芃茂斯。","诗人载歌，悉物之情。","子于父母，恩莫与京。","亲恩之大，春阳之溥。","子心如草，肤寸思补。","爰搆重屋，以奉父母。","以介眉寿，其乐吁吁。","旨甘滫澻，奉亲之常。","寸草之微，那报春阳？","孝子爱日，孝子养志。","敬亲之枝，勿蹈非礼。","扬亲之誉，悠久不已。","是谓可报，寸草春晖。","万一攸在，吾祈与归。"],0,"x254","元"],["春晖，美华孝子也","郑元祐","四言",["阳春有晖，物其是依。","何独寸草？","春阳载辉。","菲菲芳草，沐沐春阳。","德泽之漙，寸草之长。","子之于母，其恩莫大。","鞠育成人，恩等覆载。","儿之出矣，念儿衣单。","为缝为纫，惟恐或寒。","是意之微，孰为识者？","有唐诗人，孟氏东野。","华彦清父，奉其母仪。","春草名轩，本乎孟诗。","嗟彦清父，嘅亲早寡。","奉母斯轩，饮酒伐鼓。","有孙在膝，有孙授室。","儿在母前，诸孙林立。","母喜谓儿，尔父殁时。","天高地厚，茕茕孤嫠。","安知今日，孙又抱子？","是皆尔父，积庆有此。","儿闻母言，悲喜盈襟。","歌我声诗，以慰母心。"],0,"x254","元"],["明良诗 其一","吴当","四言",["于赫皇祖，肇基朔土。","惟时忠襄，实佐神武。"],0,"x255","元"],["明良诗 其二","吴当","四言",["天戈攸指，罔不率俾。","忠武之才，雄特瑰伟。"],0,"x255","元"],["明良诗 其三","吴当","四言",["逮乎忠宣，相我世皇。","式开治平，统一万方。"],0,"x255","元"],["明良诗 其四","吴当","四言",["猗与文忠，礼乐是式。","克赞英庙，以匡以翼。"],0,"x255","元"],["明良诗 其五","吴当","四言",["硕硕元勋，后先四王。","维君之明，维臣之良。"],0,"x255","元"],["明良诗 其六","吴当","四言",["侃侃开府，尚德象贤。","承厥父祖，佛时仔肩。"],0,"x255","元"],["明良诗 其七","吴当","四言",["惟皇之念，翰墨是锡。","倅尔嘉名，休光有奕。"],0,"x255","元"],["明良诗 其八","吴当","四言",["云汉于昭，发耀天藻。","垂美无疆，永以为宝。"],0,"x255","元"],["明良诗 其九","吴当","四言",["翼翼厥明，终始典学。","陈善责难，世臣攸托。"],0,"x255","元"],["明良诗 其十","吴当","四言",["以道事君，汝翼汝为。","股肱左右，庶底缉熙。"],0,"x255","元"],["明良诗 其十一","吴当","四言",["明良之逢，有典有则。","世笃忠贞，式报天德。"],0,"x255","元"],["恒德斋为开府明良公作 其一","吴当","四言",["于穆天命，恒久不已。","往禅来续，与道为体。"],0,"x255","元"],["恒德斋为开府明良公作 其二","吴当","四言",["惟圣有德，率性之常。","不二不杂，悠久无疆。"],0,"x255","元"],["恒德斋为开府明良公作 其三","吴当","四言",["君子是则，勉勉不息。","终始弗渝，夙夜无斁。"],0,"x255","元"],["恒德斋为开府明良公作 其四","吴当","四言",["赫赫元勋，昔佐皇祖。","配德惟一，永锡胤祚。"],0,"x255","元"],["恒德斋为开府明良公作 其五","吴当","四言",["侃侃闻孙，靖共在位。","式谨尔常，以赞天子。"],0,"x255","元"],["恒德斋为开府明良公作 其六","吴当","四言",["佩舄雍雍，退食自公。","肃慎斋居，用省厥躬。"],0,"x255","元"],["恒德斋为开府明良公作 其七","吴当","四言",["协于克一，责难将美。","征其化成，万国咸理。"],0,"x255","元"],["恒德斋为开府明良公作 其八","吴当","四言",["惟巽而动，勿承以羞。","亿万斯年，于昭匹休。"],0,"x255","元"],["极高明亭诗为曾以敬作 其一","吴当","四言",["春木载荣，朝阳孔曦。","悠悠白云，华盖之西。"],0,"x255","元"],["极高明亭诗为曾以敬作 其二","吴当","四言",["爰有新亭，翼翼中峙。","式究尔宁，君子攸止。"],0,"x255","元"],["极高明亭诗为曾以敬作 其三","吴当","四言",["其止维何，朝弦莫歌。","道其问学，弗辟弗颇。"],0,"x255","元"],["极高明亭诗为曾以敬作 其四","吴当","四言",["斯道之著，皎焉日星。","发育峻极，敛之灵扃。"],0,"x255","元"],["极高明亭诗为曾以敬作 其五","吴当","四言",["弥纶六合，迥绝寥廓。","周知旁行，卓彼先觉。"],0,"x255","元"],["极高明亭诗为曾以敬作 其六","吴当","四言",["如俯层台，洞视靡遗。","如持悬鉴，罔有蔽亏。"],0,"x255","元"],["极高明亭诗为曾以敬作 其七","吴当","四言",["知崇效天，礼卑法地。","成性之存，内外交致。"],0,"x255","元"],["极高明亭诗为曾以敬作 其八","吴当","四言",["万物毕备，一贯斯全。","参乎有唯，思也是传。"],0,"x255","元"],["极高明亭诗为曾以敬作 其九","吴当","四言",["予忝承学，子实名裔。","自顾无闻，祇用生愧。"],0,"x255","元"],["极高明亭诗为曾以敬作 其十","吴当","四言",["惟博反约，实基三省。","敢曰尚友，愿以自警。"],0,"x255","元"],["庆原堂诗为萍乡刘氏作 其一","吴当","四言",["惟楚萍乡，邑里有堂。","繄昔刘氏，肇基于唐。"],0,"x255","元"],["庆原堂诗为萍乡刘氏作 其二","吴当","四言",["雄虎之台，郁郁丘土。","其伏未耀，本干深固。"],0,"x255","元"],["庆原堂诗为萍乡刘氏作 其三","吴当","四言",["子孙多贤，冠佩蝉联。","积善储和，溯流而源。"],0,"x255","元"],["庆原堂诗为萍乡刘氏作 其四","吴当","四言",["福庆之实，既坚既栗。","晔晔灵芝，毓秀于室。"],0,"x255","元"],["庆原堂诗为萍乡刘氏作 其五","吴当","四言",["历宋而元，流庆未已。","袒免同居，表德闾里。"],0,"x255","元"],["庆原堂诗为萍乡刘氏作 其六","吴当","四言",["山冢之迁，有霆有雷。","尚复多祉，源源其来。"],0,"x255","元"],["庆原堂诗为萍乡刘氏作 其七","吴当","四言",["奕奕君子，实居后麓。","既休既宁，以踵芳躅。"],0,"x255","元"],["庆原堂诗为萍乡刘氏作 其八","吴当","四言",["绳绳厥承，忠厚之教。","庶其绍之，以食斯报。"],0,"x255","元"],["庆原堂诗为萍乡刘氏作 其九","吴当","四言",["太史有记，邦人足征。","式勖来嗣，勒诗尔楹。"],0,"x255","元"],["咸阳王功德诗 其一","吴当","四言",["在昔皇祖，有赫神武。","维忠宣王，杰出西土。"],0,"x255","元"],["咸阳王功德诗 其二","吴当","四言",["佐命而兴，来受圭组。","宪宗伐蜀，往补戎伍。"],0,"x255","元"],["咸阳王功德诗 其三","吴当","四言",["于穆世皇，天戈载扬。","亲拔云南，用逖蛮方。"],0,"x255","元"],["咸阳王功德诗 其四","吴当","四言",["滇之宗臣，乃悖纪纲。","复叛不顺，袭盗以狂。"],0,"x255","元"],["咸阳王功德诗 其五","吴当","四言",["天子曰嘻，孰称予使。","爰命忠惠，以绥以抚。"],0,"x255","元"],["咸阳王功德诗 其六","吴当","四言",["谕之恩信，涤汝烦苦。","简节疏目，咸得理所。"],0,"x255","元"],["咸阳王功德诗 其七","吴当","四言",["乃疆乃理，奠尔城邑。","市有居货，屋有陶甓。"],0,"x255","元"],["咸阳王功德诗 其八","吴当","四言",["我田我池，粳稌黍稷。","训厥士女，污俗斯革。"],0,"x255","元"],["咸阳王功德诗 其九","吴当","四言",["既庶既富，建学立教。","笾豆鼓钟，于乐孔庙。"],0,"x255","元"],["咸阳王功德诗 其十","吴当","四言",["诗书歌弦，孰则孰效。","折其狂猘，笃尔忠孝。"],0,"x255","元"],["咸阳王功德诗 其十一","吴当","四言",["步不出国，侯幽侯深。","部曲联绎，干戈若林。"],0,"x255","元"],["咸阳王功德诗 其十二","吴当","四言",["久而弥孚，向义骎骎。","锡贡无已，大赂南金。"],0,"x255","元"],["咸阳王功德诗 其十三","吴当","四言",["天祚皇国，克生伟人。","历年孔多，以福远民。"],0,"x255","元"],["咸阳王功德诗 其十四","吴当","四言",["远民之安，克顺克正。","惟王之贤，天子之圣。"],0,"x255","元"],["咸阳王功德诗 其十五","吴当","四言",["元臣云亡，远民孔哀。","风马云车，曷往曷来。"],0,"x255","元"],["咸阳王功德诗 其十六","吴当","四言",["新庙既作，执事有恪。","王其享兹，用配诸葛。"],0,"x255","元"],["咸阳王功德诗 其十七","吴当","四言",["锡爵启封，皇则悼之。","嗣德象贤，天实报之。"],0,"x255","元"],["咸阳王功德诗 其十八","吴当","四言",["诜诜孙子，有引无替。","太史作诗，式昭永世。"],0,"x255","元"],["性乐堂诗 其一","吴当","四言",["繄厥成性，浩然其天。","灵明洞彻，溥博渊泉。","万物毕备，众善具全。","反身而诚，乐莫大焉。"],0,"x255","元"],["性乐堂诗 其二","吴当","四言",["惟尔学者，夙夜有恪。","循端致曲，实充实扩。","昭兹本善，以踵先觉。","观其回通，亦底克乐。"],0,"x255","元"],["性乐堂诗 其三","吴当","四言",["翼翼高堂，攸介攸宁。","天光丕容，匪间显冥。","灼之当为，勇往是程。","其则不远，勒诗在楹。"],0,"x255","元"],["集义斋诗为太行高氏作 其一","吴当","四言",["瞻彼嘉木，太行之阴。","盘盘幽谷，侃侃素心。"],0,"x255","元"],["集义斋诗为太行高氏作 其二","吴当","四言",["缅焉兴怀，古道是式。","惟心之宜，至当有则。"],0,"x255","元"],["集义斋诗为太行高氏作 其三","吴当","四言",["我其扩之，制事不违。","用达万变，审乎先几。"],0,"x255","元"],["集义斋诗为太行高氏作 其四","吴当","四言",["灼知勇为，乃积乃充。","无间微显，集于厥躬。"],0,"x255","元"]]