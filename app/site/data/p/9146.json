[null,["五杂俎","刘基","杂言",["五杂俎，原上翮。","往复还，小贩客，不得巳，滹沱麦。","五杂俎，百衲衣。","往复还，燕双飞，不得巳，赋式微。","五杂俎，市卖果。","往复还，邮传马，不得巳，死垓下。"],0,"x223","明"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["五杂组","宋褧","杂言",["五杂组，䗖𬟽掣。","往复还，寒暑节。","不获已，新昏别。","五杂组，眼缬眩。","往复还，乌衣燕。","不获已，沙场战。","五杂组，袆翟衣。","往复还，大明辉。","不获己，妻儿饥。"],0,"x247","元"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["祀蚕姑火龙词四章","杨维桢","杂言",["火之龙兮，云弗从，雨弗降。","三眠始，三眠终。","火之龙兮，桑以谷，丝以腹，茧以屋。","象水火兮，以金以玉。","火之龙兮，蛹以蛾，蛾以卵，卵复化，龙之神兮实多。","惟龙之神兮，有大功于人。","又杀身以成仁，徇道而忠益信。","火之龙兮，其节甚高。","彼麋爵者谁兮，生宠死则逃。","剥民之膏，粥人之国，而死与叛鬼曹。","火龙德，德可褒。"],0,"x216","明"]]