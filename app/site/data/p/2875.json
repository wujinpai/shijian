[["缘识 其二十一","赵炅","四言",["继出宠材，睹奥自开。","揣摩三教，百行俱来。","真宗起思，抚掌堪咍。","识业之敏，谈论熙哉。"],0,"x63","宋"],["偈颂二十九首 其七","释清了","四言",["虚玄及尽，见处偏枯。","明湛不摇，想中渗漏。"],0,233,"宋"],["偈颂一百三十三首 其一○一","释居简","四言",["今日因甚，作者模样。","觌面相呈，当仁不让。"],0,"x94","宋"],["古镜铭","释慧方","四言",["有古菱花，物来斯现。","演若倍瞻，仰山亲荐。","迷悟虽殊，寒光不变。","恶像弗祛，丽质奚羡。","历照千差，肯随物转。","觑破前尘，是谁对面。"],0,45,"宋"],["颂古二十一首 其八","释居简","四言",["三蛇九鼠，一亩之地。","干木随身，逢场作戏。"],0,"x94","宋"],["偈颂一百三十三首 其九","释居简","四言",["节外生枝，劣中取胜。","辍己为人，无乃太甚。"],0,"x94","宋"],["北窗伊吾 其二","赵戣","四言",["伊吾维吾，瓮牖绳枢。","爰升其华，秋月冰壶。"],0,237,"宋"],["怀旧一首","周紫芝","四言",["三月既晦，维暮之春。","居我穷巷，门无杂宾。","谁与晤语，千载一人。","歌此好言，以侑清樽。","酌我春醪，载笑载欣。","言念我友，在彼彭门。","江𣸣之别，于今三年。","夐夐只影，祗复自怜。","素书聿至，式慰我心。","蔚我嘉木，有莺在林。","尚求其友，载好其音。","人而不如，有怀其愔。","何当言归，昔盟是寻。","眷此二老，实为兰金。"],0,"x139","宋"],["九月","曾丰","四言",["九月庚庚，金风𩙯𩙯。","菊之有之，强名金精。","九月庚庚，玉露泠泠。","菊之有之，强名玉英。","精英为菊，薄畀其赢。","公于精英，裒其大成。"],0,"x193","宋"],null,["新渠诗 其五","苏轼","四言",["筑室于唐，孔硕且坚。","生为唐民，饱粥与𫗴。","死葬于唐，祭有鸡豚。","天子有命，我惟尔安。"],0,"x67","宋"],["赤城六章章四句  其二","释居简","四言",["峩峩赤城，磅礴九地。","斯人笃生，水瘦石悴。"],0,"x94","宋"],null,["绍兴朝会十三首 其一 酒一行用文舞。","郊庙朝会歌辞","四言",["帝德诞敷，销烁群慝。","近悦远来，惟圣时克。","玉振金声，治功兴起。","韶箾象之，尽善尽美。"],0,"x207","宋"],["太常乐章三十首 其二十三 引群官作正安之曲","杨亿","四言",["万邦来同，九宾在位。","奉璋荐绅，陟降庭止。","文思安安，威仪棣棣。","臣哉邻哉，介尔蕃祉。"],0,"x47","宋"],["偈颂一百零一首 其十","释慧性","四言",["言发非声，舌头无骨。","色前不物，狐狸恋窟。"],0,46,"宋"],["示杨德逢","王安石","四言",["我行其野，春日迟迟。","有菀者柳，在水之湄。","有鸣仓庚，岂曰不时。","求其友声，颉之颃之。","嗟我怀人，何日忘之。","六日不詹，方何为期。","期逝不至，我心西悲。","跂予望之，其室则迩。","一者之来，我心则喜。","我之怀矣，升彼虚矣。","爱而不见，云何吁矣。"],0,"x48","宋"],["新渠诗 其四","苏轼","四言",["侯谓新民，尔既来止。","其归尔邑，告尔邻里。","良田千万，尔择尔取。","尔耕尔食，遂为尔有。"],0,"x67","宋"],["偈","释德韶","四言",["通玄峰顶，不是人门。","心外无法，满目青山。"],0,178,"宋"],["虎号南山  其一","黄庭坚","四言",["虎号南山，北风雨雪。","百夫莫为，其下流血。","相彼暴政，几何不虎。","父子相戒，是将食汝。"],0,"x66","宋"],["观物吟","邵雍","四言",["一气才分，两仪已备。","圆者为天，方者为地。","变化生成，动植类起。","人在其间，最灵最贵。"],0,"x57","宋"],["观物吟","邵雍","四言",["如鸾如凤，意思安详。","所生之人，非忠则良。","如鼠如雀，意思惊躩；","所生之人，不凶则恶。"],0,"x57","宋"],["观物吟","邵雍","四言",["画工状物，经月经年。","轩鉴照物，立写于前。","鉴之为明，犹或未精。","工出人手，平与不平。","天下之平，莫若于水。","止能照表，不能照里。","表里洞照，其唯圣人。","察言观行，罔或不真。","尽物之性，去己之情。","有德之人，而必有言。","能言之人，未必能行。"],0,"x57","宋"],["观物吟","邵雍","四言",["居暗观明，居静观动。","居简观繁，居轻观重。","所居者寡，所观则众。","匪居匪观，众寡何用。"],0,"x57","宋"],["太常乐章三十首 其三 皇帝奠币奏瑞文之曲","杨亿","四言",["淳精育物，瑞木成文。","元气陶冶，非烟郁纷。","玄贶昭格，至和所薰。","登歌祼献，肸蚃如闻。"],0,"x47","宋"],["瞻彼南山诗 其五","司马光","四言",["帝曰卿士，左右之臣。","四方无虞，矜尔之勤。","式观且游，从予一人。","于壸于闳，于堂于陈。","金石之符，翰墨之珍。","匪予汝夸，祖考之勋。"],0,"x40","宋"],["明教禅师五种不坏赞 其二","释居简","四言",["去窒而聪，去塞而通。","于无数声，齐万窍风。","风止声消，音响寂绝。","谷神不死，听火焰说。","说无所说，闻无所闻。","烟灭灰飞，所亡者存。","以是耳根，示尔四众。","厚德宏功，千二百种。"],0,"x94","宋"],["偈颂一百六十九首 其一○五","释智朋","四言",["虚空迸绽，山岳起舞。","拔舌犁耕，罪恶俱露。"],0,18,"宋"],["观物吟","邵雍","四言",["时有代谢，物有枯荣。","人有衰盛，事有废兴。"],0,"x57","宋"],["观物吟","邵雍","四言",["物不两盛，事难独行。","荣瘁迭起，贤愚并行。"],0,"x57","宋"],["贺刘仓使生朝  其一","曾丰","四言",["眷此良月，开此良辰。","水德奫奫，羽音诩诩。","玉曜在戌，旁烛于寅。","仁气收薰，天地氤氲。","武夷鞠淳，甫生及申，将秉周钧。"],0,"x193","宋"],["瞻彼南山诗 其四","司马光","四言",["赫赫明明，天命有严。","命我祖考，九土是监。","倭𫘛之东，蛮蜑之南。","享献有时，靡敢不詹。","閟兹馀文，复阁岩岩。","万世是承，四方是瞻。"],0,"x40","宋"],["缘识 其三十六","赵炅","四言",["大道何异，俗情如花。","生前境趣，车碾黄砂。","无垢住相，勿用称夸。","非亲我亲，六合为家。"],0,"x63","宋"],["欧阳文忠索碑遣居二帖赞","岳珂","四言",["公于率更，每称吾家。","是书之传，似耶非耶。","书出于心，既劲且方。","世多公书，行或未藏。","易方而圆，飘飘若仙。","楷以其人，行以其天。","堂堂斯文，维轲与雄。","我观二书，如或见公。"],0,"x202","宋"],["偈","释静","四言",["声前认得，已涉廉纤。","句下承当，犹为钝汉。","电光石火，尚在迟疑。","点著不来，横尸万里。"],0,226,"宋"],["绍兴朝会十三首 其一 酒载行用武舞。","郊庙朝会歌辞","四言",["用戒不虞，谁能去兵。","师出以律，动必有名。","折彼遐冲，布昭圣武。","和众安民，时惟多助。"],0,"x207","宋"],["绍兴朝会十三首 其二 酒载行用武舞。","郊庙朝会歌辞","四言",["止戈曰武，惟圣为能。","御得其道，无敢不庭。","整我六师，稽诸七德。","不吴不扬，有严有翼。"],0,"x207","宋"],["宝祐二年皇子冠二十首 其一","郊庙朝会歌辞","四言",["于皇帝德，乃圣乃神。","本支百世，立爱惟亲。","敬共冠事，以明人伦。","承天右序，休命用申。"],0,"x207","宋"],["宝祐二年皇子冠二十首 其四","郊庙朝会歌辞","四言",["路寝辟门，黼坐恭己。","群公在庭，所重维礼。","正心齐家，以燕翼子。","于万斯年，王心载喜。"],0,"x207","宋"],["颂古四首 其四","释休","四言",["赵州门前，毒蛇当路。","踏著咬你，退步退步。"],0,51,"宋"],["禅人并化主写真求赞 其四○一","释正觉","四言",["龟兮蓍兮，祛执决疑。","师兮范兮，扶斜理差。","定彻其底，慧穷其涯。","箭撞筈破，珠旋影随。"],0,"x88","宋"],["如大师求赞","释清远","四言",["比类则疏，现形仍普。","得在一瞬，照穷千古。","云起吟龙，风生啸虎。","赞之绝辞，瞻焉奚睹。"],0,116,"宋"],["宝祐二年皇子冠二十首 其三","郊庙朝会歌辞","四言",["礼国之本，冠礼之始。","宾升自西，维宾之位。","于著于阼，维子之义。","厥惟钦哉，敬以从事。"],0,"x207","宋"],["是非吟","邵雍","四言",["是短非长，好丹非素。","一生区区，未免爱恶。","爱恶不去，何由是非。","爱恶既去，是非何为。"],0,"x57","宋"],["绍兴雩祀一首","郊庙朝会歌辞","四言",["苍苍昊穹，覆临下土。","钦惟岁事，民所依怙。","爰竭精虔，礼典斯举。","甘泽以时，介我稷黍。"],0,"x207","宋"],["颂古八首 其六","释深","四言",["行喝也打，礼拜也打。","临济大师，可知礼也。"],0,189,"宋"],["元符祀感生帝五首 其三 帝位酌献。","郊庙朝会歌辞","四言",["乐和凤律，酒奠牺尊。","神明斯享，礼盛难论。"],0,"x207","宋"],["意外吟","邵雍","四言",["事出意外，人难智求。","自非妄动，恶用多愁。","既有误中，宁无暗投。","能知此说，天下何忧。"],0,"x57","宋"],["淳熙十六年皇后册宝十三首 其三","郊庙朝会歌辞","四言",["有玺范金，有册镂琼。","汝使汝介，持节以行。","礼始文德，达于穆清。","是恪是虔，依我和声。"],0,"x207","宋"],["月代","许月卿","四言",["月代太阳，太阳代月。","君逸臣劳，职分无越。","穆穆皇皇，明明在烈。","光于四方，罔不秉哲。","火明水清，坎离斯设。","日月有明，容光靡阙。","无非教也，教亦不屑。","金取其清，分明之精。","东有启明，西有长庚。","金清月白，助天日明。","日明相续，万物咸睹。","匪今斯今，不瞽万古。"],0,152,"宋"],["偈颂七十六首 其四十","释师观","四言",["时不待人，月不破五。","那一著子，未敢相许。"],0,210,"宋"],["奢侈吟","邵雍","四言",["侈不可极，奢不可穷。","极则有祸，穷则有凶。"],0,"x57","宋"],["禅人并化主写真求赞 其二六八","释正觉","四言",["识得本真，不随生灭。","霁云磨空，秋波濯月。"],0,"x88","宋"],["偈八首 其三","释慧远","四言",["天道亏盈，地道变盈。","鬼神害盈，人道恶盈。"],0,154,"宋"],["偈颂三十四首 其五","释如净","四言",["瞿昙顶骨，夫子眼睛。","两彩一赛，玉振金声。"],0,105,"宋"],["颂古二十一首 其一","释居简","四言",["吹糠著米，翻成特地。","不因一事，不长一智。"],0,"x94","宋"],["宝祐二年皇子冠二十首 其二","郊庙朝会歌辞","四言",["丰芑诒谋，建尔元子。","揆礼仪年，筮宾敬事。","八音克谐，嘉宾至止。","于以冠之，成其福履。"],0,"x207","宋"],["宝祐二年皇子冠二十首 其五","郊庙朝会歌辞","四言",["有来振振，月重轮兮。","瑜玉在佩，綦组明兮。","左征右羽，德结旌兮。","步中采荠，矩彟循兮。"],0,"x207","宋"],["赤城六章章四句  其一","释居简","四言",["赤城峩峩，霞摽错摩。","笃生斯人，绝超凡科。"],0,"x94","宋"],["皇雅十首  其六","尹洙","四言",["矫矫虎士，载摧其壁。","于嗟孟侯，亦果其策。","迎师而降，靡抗锋镝。","岂独身谋，完是宗国。"],0,108,"宋"],["辞世偈","杨杰","四言",["无一可恋，无一可舍。","太虚空中，之乎者也。","将错就错，西方极乐。"],0,102,"宋"],["皇雅十首  其五","尹洙","四言",["主用西师，岷梁弗宾。","匪曰负固，实交晋人。","予训予誓，合我将臣。","正厥有罪，无庸伤民。"],0,108,"宋"],["和陶答庞参军六首 其三","苏轼","四言",["将行复止，眷言孜孜。","苟有于中，倾倒出之。","奕奕千言，粲焉陈诗。","觞行笔落，了不容思。"],0,"x67","宋"],["丞相二章  其一","梅尧臣","四言",["丞相之拜，冠弁旅至。","乘马载驱，如彼巨潴。","有鴈有鹜，有龟有鱼。","烝然来萃，翔泳啸呼。"],0,"x65","宋"],["丞相二章  其二","梅尧臣","四言",["丞相之去，乃还印绶。","乃饬车轮，如彼涸津。","时靡翔羽，时靡游鳞。","寂兮寂兮，岂有嘉宾。"],0,"x65","宋"],["瞻彼南山诗 其一","司马光","四言",["瞻彼南山，有梌有棠。","维叶牂牂，君子之燕。","笾豆洋洋，鼎俎将将。","百羞阜昌，上下乐康。","邦家之光，君子万年。","抚有四荒，受禄无疆。"],0,"x40","宋"],["瞻彼南山诗 其二","司马光","四言",["瞻彼南山，有椐有栩。","维叶湑湑，君子之燕。","清酒有藇，壶樽有楚。","酌言赐之，命之釂之。","上下以序，君子万年。","永绥兆民，受天之祜。"],0,"x40","宋"],["六得吟","邵雍","四言",["眼能识得，耳能听得，口能道得，手能做得，身能行得，心能放得。","六者尽能，与天同德。","饮食起居，出处语默。","不止省心，又更省力。"],0,"x57","宋"],["偶得吟","邵雍","四言",["皋陶遇舜，伊尹逢汤。","武丁得傅，文王获姜，齐知管仲，汉识张良。","诸葛开蜀，玄龄启唐。"],0,"x57","宋"],["和陶答庞参军六首 其四","苏轼","四言",["丱妙侍侧，两髦丫分。","歌舞寿我，永为欢欣。","曲终凄然，仰视浮云。","此曲此声，何时复闻。"],0,"x67","宋"],["嘉泰三年皇后册宝十三首 其一","郊庙朝会歌辞","四言",["茂建坤极，容典聿新。","天命所赞，慈训是遵。","肃涓谷旦，躬御紫宸。","鸿禧累福，骈赉翕臻。"],0,"x207","宋"],["采菊  其二","黄庭坚","四言",["薄言采之，遵彼山曲。","汝来迟迟，去我何速。","伊时之人，谁适与同。","不与我好，殆其觏凶。"],0,"x66","宋"],["和陶答庞参军六首 其五","苏轼","四言",["击鼓其镗，船开橹鸣。","顾我而言，雨泣载零。","子卿白首，当还西京。","辽东万里，亦归管宁。"],0,"x67","宋"],["总颂","释师体","四言",["释迦观音，文珠普贤。","蓦鼻牵来，作一串穿。","横拖倒拽，痛报深冤。","弥天罪过，一任流传。"],0,5,"宋"],["应龙吟","邵雍","四言",["龙者阳类，与时相须。","首出庶物，同游六虚。","能潜能见，能吸能呼。","能大能小，能有能无。"],0,"x57","宋"],["瞻彼南山诗 其六","司马光","四言",["多士庶尹，群公百辟。","拜手稽首，答扬休德。","既醉既饱，慎思尔职。","罔顾尔私，罔爱尔力。","惇忠祗敕，永奉丕则。","立民之极，载祀千亿。"],0,"x40","宋"],["安乐吟","邵雍","四言",["安乐先生，不显姓氏。","垂三十年，居洛之涘。","风月情怀，江湖性气。","色斯其举，翔而后至。","无贱无贫，无富无贵；","无将无迎，无拘无忌。","窘未尝忧，饮不至醉。","收天下春，归之肝肺。","盆池资吟，瓮牖荐睡。","小车赏心，大笔快志。","或戴接䍠，或著半臂；","或坐林间，或行水际。","乐见善人，乐闻善事；","乐道善言，乐行善意。","闻人之恶，若负芒刺；","闻人之善，如佩兰蕙。","不佞禅伯，不谀方士。","不出户庭，直际天地。","三军莫凌，万钟莫致。","为快活人，六十五岁。"],0,"x57","宋"],["偈三首 其二","释道和","四言",["观身实相，观佛亦然。","这里见得，黄面瞿昙。","隐身无地，其或渺漫。","不分照顾，眉毛鼻孔。"],0,233,"宋"],["遗诗","朱宫人","四言",["既不辱国，幸免辱身。","世食宋禄，羞为北臣。","妾辈之死，守于一贞。","忠臣孝子，期以自新。"],0,168,"宋"],["和陶答庞参军六首 其六","苏轼","四言",["感子至意，托辞西风。","吾生一尘，寓形空中。","愿言谦亨，君子有终。","功名在子，何异我躬。"],0,"x67","宋"],["盘居六章  其三","项安世","四言",["山之纡纡，密云所庐。","彼盘之人，亦丰厥储。"],0,"x55","宋"],["偈","释灯","四言",["天不能盖，地不能载。","一室无私，何处不在。"],0,44,"宋"],["皇雅十首  其一七","尹洙","四言",["晋郊既平，九区以宁。","陈功太庙，告假威灵。","在昔武王，于商观兵。","维我艺祖，亦勤于征。","匪贷晋罪，俟厥贯盈。","圣作圣继，巍巍相承。","皇矣二后，功莫与京。"],0,108,"宋"],["皇雅十首  其九","尹洙","四言",["帝曰孟侯，受封于楚。","淑旗雕戈，备物异数。","俾尔族姻，及乃文武。","服在王庭，靡不有序。"],0,108,"宋"],["偈颂十一首 其六","释了演","四言",["前来半斤，后来八两。","斤两分明，一对漆桶。"],0,235,"宋"],["偈颂一百六十九首 其一二○","释智朋","四言",["象王行处，狐兔绝踪。","水月现时，风云自异。"],0,18,"宋"],["瞻彼南山诗  其三","司马光","四言",["瞻彼南山，有杞有枞。","维叶逢逢，君子之燕。","管丝噰噰，奏鼓𪔳𪔳。","自堂徂庭，上下肃雍。","靡有不恭，君子万年。","令德高明，高明有融。"],0,"x40","宋"],["皇雅十首  其四","尹洙","四言",["帝朝法宫，左右宗公。","忮夫悍士，以雍以容。","尔居尔室，尔工尔农。","既息既养，惟天子功。"],0,108,"宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其五","郊庙朝会歌辞","四言",["纯佑我宋，母仪四朝。","拥翼孙谋，如虞承尧。","仁覃函夏，喜浮庆霄。","福禄万年，金玉孔昭。"],0,"x207","宋"],["临终偈","释系南","四言",["罗汉今日，倒骑铁马，逆上须弥。","踏破虚空，不留朕迹。"],0,156,"宋"],["玉岩","释居简","四言",["颓然顽石，粹然妙蕴。","全假全真，壁立万仞。"],0,"x94","宋"],["偈颂七十六首 其三十九","释师范","四言",["佛祖命脉，洞然明白。","黑漆屏风，松萝亮隔。"],0,"x155","宋"],["题壁间 其二","米芾","四言",["水月虚怀，烟霞浪迹。","但莫憎爱，洞然明白。"],0,245,"宋"],["庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其七","郊庙朝会歌辞","四言",["曾孙致养，五福骈臻。","太极所运，两仪三辰。","辉光日新，启佑后人。","永翼瑶图，亿万尧春。"],0,"x207","宋"],["皇雅十首  其一九","尹洙","四言",["帝赉高年，式宴且喜。","种种黄发，族立而议。","我生艰难，暴乱以继。","耳狃金鼓，目狎戎器。","皇其我图，亲讲农事。","有子有孙，力田孝悌。","鼓舞至仁，薰焉如醉。"],0,108,"宋"],["偈颂十首 其二","释德光","四言",["机轮转处，作者犹迷。","祖令当行，魔军胆丧。"],0,208,"宋"],["皇雅十首  其二四","尹洙","四言",["帝谋公卿，列侯庶校。","咸曰彼心，暴戾阴狡。","既扰我疆，复利吾宝。","无若励兵，袭其还道。"],0,108,"宋"],["园樱伤老也 其二","司马光","四言",["园有弱柳，圃有肥韭。","我酒既有，我殽既阜。","载笑载歌，以宴我友。","今我不乐，年其无久。"],0,"x40","宋"],["处身吟","邵雍","四言",["君子处身，宁人负己，己无负人。","小人处事，宁己负人，无人负己。"],0,"x57","宋"],["新渠诗 其一","苏轼","四言",["新渠之水，其来舒舒。","溢流于野，至于通衢。","渠成如神，民始不知。","问谁为之？","邦君赵侯。"],0,"x67","宋"]]