[["郇公厨语","佚名","残句",["人欲不饭筋骨舒，夤缘须入郇公厨。"],0,"x14","唐"],["四俊语","佚名","残句",["令君四俊，苗吕崔员。"],0,"x14","唐"],["八友语","佚名","残句",["殷颜柳陆，李萧邵赵。"],0,"x14","唐"],["罗吉口号","佚名","残句",["罗钳吉网。"],0,"x14","唐"],["里闾诅语","佚名","残句",["若违教，值三豹。"],0,"x14","唐"],["真源邑语","佚名","残句",["南金口，明府手。"],0,"x14","唐"],["称二王语","佚名","残句",["朝廷左相笔，天下右丞诗。"],0,"x14","唐"],["戏谏司语","佚名","残句",["韩谏议虽分左右，归拾遗莫辨存亡。"],0,"x14","唐"],["魏博语","佚名","残句",["长安天子，魏府牙军。"],0,"x14","唐"],null,["又号牛李","佚名","残句",["门生故吏，不牛则李。"],0,"x14","唐"],["郑仁表自语","佚名","残句",["天瑞有五色云，人瑞有郑仁表。"],0,"x14","唐"],["湖苏二郡语","佚名","残句",["湖接两头，苏联三尾。"],0,"x14","唐"],["广明初都人语","佚名","残句",["黄贼打黑贼。"],0,"x14","唐"],["郎吏语","佚名","残句",["司门水部，入省不数。"],0,"x14","唐"],["御史台语","佚名","残句",["事长如事端。"],0,"x14","唐"],["京兆府语","佚名","残句",["不立两县令，不坐两少尹。"],0,"x14","唐"],["翰林谏议语","佚名","残句",["饶道斗上坡去，亦须却下坡来。"],0,"x14","唐"],["举子语","佚名","残句",["槐花黄，举子忙。"],0,"x14","唐"],["明经进士语","佚名","残句",["三十老明经，五十少进士。"],0,"x14","唐"],["杂帖语","佚名","残句",["常杂鲍帖。"],0,"x14","唐"],["闽人语","佚名","残句",["欧阳独步，藻蕴横行。"],0,"x14","唐"],["大中后进士语","佚名","残句",["欲得命通，问瑝嵎都雍。"],0,"x14","唐"],["科目举人语","佚名","残句",["未见王窦，徒劳漫走。"],0,"x14","唐"],["戏杜审权语","佚名","残句",["座主审权，门生处权。"],0,"x14","唐"],["崔沆放牓时人语","佚名","残句",["座主门生，沆瀣一家。"],0,"x14","唐"],["唐末五代人语","佚名","残句",["及第不必读书，作官何须事业。"],0,"x14","唐"],["号沈宋语","佚名","残句",["苏李居前，沈宋比肩。"],0,"x14","唐"],["号钱郎语","佚名","残句",["前有沈宋，后有钱郎。"],0,"x14","唐"],["潘何诗赋语","佚名","残句",["潘纬十年吟古镜，何涓一夜赋潇湘。"],0,"x14","唐"],["魏薛草书语","佚名","残句",["前有虞褚，后有薛魏。"],0,"x14","唐"],["薛稷书语","佚名","残句",["买褚得薛不落节。"],0,"x14","唐"],["时人为刘毕语","佚名","残句",["刘郎中松树孤标，毕庶子松根绝妙。"],0,"x14","唐"],["时人为黄筌语","佚名","残句",["黄筌画鹤，薛稷减价。"],0,"x14","唐"],["道杰语","佚名","残句",["大头杰，难杀人。"],0,"x14","唐"],["马周疏引俚语","佚名","残句",["贫不学俭，富不学奢。"],0,"x14","唐"],["杜甫引俚语","佚名","残句",["城南韦杜，去天尺五。"],0,"x14","唐"],["孙光宪琐言引古语 一","佚名","残句",["乘船走马，去死一分。"],0,"x14","唐"],["孙光宪琐言引古语 二","佚名","残句",["好事不出门，恶事行千里。"],0,"x14","唐"],["杜重威引俚语","佚名","残句",["逢贼得命，更望复子。"],0,"x14","唐"],["建安语","佚名","残句",["龙门一半在闽川。"],0,"x14","唐"],["江陵语","佚名","残句",["琵琶多于饭甑，措大多于鲫鱼。"],0,"x14","唐"],["汾晋间语","佚名","残句",["欲作千箱主，问取黄金母。"],0,"x14","唐"],["秦中儿童语","佚名","残句",["颠当牢守门，蠮螉寇汝无处奔。"],0,"x14","唐"],["沧洲语","佚名","残句",["不戴金莲花，不得到仙家。"],0,"x14","唐"],["段成式《酉阳杂俎》引古语","佚名","残句",["三守庚申三尸伏，七守庚申七尺灭。"],0,"x14","唐"],["佛书引语 一","佚名","残句",["停囚长智。"],0,"x14","唐"],["佛书引语 二","佚名","残句",["赤脚人趁兔，著𫖇人吃肉。"],0,"x14","唐"],["中宗引谚","佚名","残句",["冬至长于岁。"],0,"x14","唐"],["贾言忠引谚","佚名","残句",["军无媒，中道回。"],0,"x14","唐"],["李𪟝引谚别张文瓘","佚名","残句",["千里相送，终于一别。"],0,"x14","唐"],["路励行引谚","佚名","残句",["一人在朝，百人缓带。"],0,"x14","唐"],["郝南容引谚","佚名","残句",["三公后，出死狗。"],0,"x14","唐"],["员庄谚","佚名","残句",["上有天堂，下有员庄。"],0,"x14","唐"],["娄师德引谚","佚名","残句",["卒客无卒主人。"],0,"x14","唐"],["台中谚","佚名","残句",["免巡未推，只得自知。"],0,"x14","唐"],["宋守敬引谚","佚名","残句",["双陆无休势。"],0,"x14","唐"],["雒谷谚","佚名","残句",["謥洞入黄泉。"],0,"x14","唐"],["三门谚","佚名","残句",["古无门匠墓。"],0,"x14","唐"],["张果引谚","佚名","残句",["娶妇得公主，平地生公府。"],0,"x14","唐"],["哥舒翰引谚","佚名","残句",["狐向窟嗥不祥。"],0,"x14","唐"],["代宗引谚","佚名","残句",["不痴不聋，不作阿家阿翁。"],0,"x14","唐"],["河北谚","佚名","残句",["山东一条葛，无事莫撩拨。"],0,"x14","唐"],["李振引谚","佚名","残句",["百岁奴事三岁主。"],0,"x14","唐"],["王彦章引谚","佚名","残句",["人死留名，豹死留皮。"],0,"x14","唐"],["孙光宪《北梦琐言》引谚","佚名","残句",["小舅小叔，相追相逐。"],0,"x14","唐"],["谚 一","佚名","残句",["枣子塞鼻孔，悬栖阁却种。"],0,"x14","唐"],["谚 二","佚名","残句",["蝉鸣蛁蟟唤，黍种餻糜断。"],0,"x14","唐"],["宁茵事谚","佚名","残句",["鹁鸠树上鸣，意在麻子地。"],0,"x14","唐"],["鸬鹚谚","佚名","残句",["鸬鹚不打脚下塘。"],0,"x14","唐"],["盐铁谚","佚名","残句",["扬一益二。"],0,"x14","唐"],["冯翊谚","佚名","残句",["苦泉羊，洛水浆。"],0,"x14","唐"],["舆地志引谚","佚名","残句",["生东吴，死丹徒。"],0,"x14","唐"],["益阳谚","佚名","残句",["长沙益阳，一时相卬。"],0,"x14","唐"],["郦道元引橘洲谚","佚名","残句",["昭潭无底橘洲浮。"],0,"x14","唐"],["江右四郡谚","佚名","残句",["筠袁赣吉，脑后插笔。"],0,"x14","唐"],["人为徐闻县谚","佚名","残句",["欲拔贫，诣徐闻。"],0,"x14","唐"],["荆棺峡谚","佚名","残句",["九子不葬父，一女打荆棺。"],0,"x14","唐"],["南中谚","佚名","残句",["秋收稻，夏收头。"],0,"x14","唐"],["事狐神谚","佚名","残句",["无狐魅，不成村。"],0,"x14","唐"],["李哲家怪引谚","佚名","残句",["一鸡死，一鸡鸣。"],0,"x14","唐"],["许氏碑阴谜","佚名","残句",["谈马砺毕，王田数七。"],0,"x14","唐"],["牛口谣","佚名","残句",["豆入牛口，势不得久。"],0,"x14","唐"],["调露初京城民谣","佚名","残句",["侧堂堂，挠堂堂。"],0,"x14","唐"],["杨柳谣","佚名","残句",["杨柳杨柳漫头驼。"],0,"x14","唐"],["天枢谣","佚名","残句",["一条麻索挽，天枢绝去也。"],0,"x14","唐"],["武后时谣","佚名","残句",["张公吃酒李公醉。"],0,"x14","唐"],["武后时童谣","佚名","残句",["红绿复帬长，千里万里犹香。"],0,"x14","唐"],["黄犊子谣","佚名","残句",["黄㹀犊子挽纼断，两脚蹋地鞋𪎱断。"],0,"x14","唐"],["安乐寺童谣","佚名","残句",["可怜安乐寺，了了树头悬。"],0,"x14","唐"],["羊头山谣","佚名","残句",["羊头山北作朝堂。"],0,"x14","唐"],["金桥童谣","佚名","残句",["圣人执节度金桥。"],0,"x14","唐"],["天宝中京兆谣","佚名","残句",["欲得米麦贱，无过追李岘。"],0,"x14","唐"],["天宝初语","佚名","残句",["义髻抛河里，黄帬逐水流。"],0,"x14","唐"],["杨氏谣","佚名","残句",["男不封侯女作妃，君看女却是门楣。"],0,"x14","唐"],["张权舆作裴度伪谣","佚名","残句",["非衣小儿坦其腹，天上有口被驱逐。"],0,"x14","唐"],["马仆射谣","佚名","残句",["斋钟动也，和尚不上堂。"],0,"x14","唐"],["僖宗时童谣","佚名","残句",["金色虾蟆争努眼，飜却曹州天下反。"],0,"x14","唐"],["黄巢军中谣","佚名","残句",["逢儒则肉师必覆。"],0,"x14","唐"],["后唐军士谣","佚名","残句",["除去菩萨，扶立生铁。"],0,"x14","唐"]]