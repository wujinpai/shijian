[["文文山画像赞","刘辰翁","四言",["闲居忽忽，万古咄咄。","天风惨然，如动生发。","如何寻约，亦念束刍。","岂其英爽，犹累形躯。","同时之人，能不颡泚。","昔忌其生，今妒其死。"],0,"x164","宋"],["偈颂一百三十三首 其五十三","释居简","四言",["门对庐山，岸横湓浦。","把定要津，鸦飞不渡。"],0,"x94","宋"],["景祐祀感生帝二首 其二 酌献用《肃安》。","郊庙朝会歌辞","四言",["龙德而隐，源流则长。","宜乎亿祀，侑享弥昌。"],0,"x207","宋"],["忠烈诗","徐积","四言",["在昔皇祐，蛮党交构。","聚为伏枭，起为攫兽。","出人不意，其锋甚锐。","州无敌兵，城无守备。","所在奔亡，贼势益张。","横身捍蔽，爰有晋康。","羸兵数百，摧坚沮敌。","殊死血战，气吞逆贼。","按剑一呼，眦裂吻拆。","凶焰方炽，公方虎视。","人方忧死，饱食鼾睡。","勇如项籍，哀歌恻恻，为虞姬泣。","康州不然，忘其妻息。","猛如敖曹，强梁粗豪，伏藏于桥。","康州不然，坐叱凶妖。","李陵壮夫，终降匈奴，老母何辜。","颜鲁虽贤，所守不坚，大节不全。","奇哉康州，其勇绝类。","以义配勇，其本在内。","不动如山，不倾如地。","何物可摇，何兵可制。","如令不死，社稷所恃。","如令复生，可备宿卫。","佩刀骖乘，势戟殿陛。","用之朝廷，朝廷之纲。","使当一面，胜于金汤。","无疆无界，人迹鬼方。","知有斯人，中国之光。","若斯人者，决不徇利。","肝胆可沥，头璧可碎。","生乎由是，死乎由是。","生亦可贵，死亦可贵。","死而有子，时方三岁。","死中得活，此乃天意。","使世其家，世为忠义。","子子孙孙，永不失坠。","我为此诗，激励万世。"],0,"x123","宋"],["宋颂九首 其六 六合雷声","石介","四言",["往在艺祖，未遑拓㝢。","遗我圣宗，启此北土。","敢告太庙，惟皇孝武。"],0,105,"宋"],["皇后庙十五首 其十四 终献用《顺安》。","郊庙朝会歌辞","四言",["荐献有终，礼容斯穆。","以奉嘉觞，以膺多福。"],0,"x207","宋"],["颂古十七首 其十六","释师观","四言",["佛法王法，更无两样。","直下一刀，未为谛当。"],0,210,"宋"],["偈颂一百六十九首 其一五八","释智朋","四言",["贫到无锥，正好进步。","王舍城中，有条活路。","一声金锡，千门万户。","全放全收，全宾全主。","多宝如来，何曾过去。"],0,18,"宋"],["久旱吟","邵雍","四言",["久旱望雨，久雨思晴。","天之常道，人之常情。"],0,"x57","宋"],["偈十三首 其十","释慧空","四言",["一沤未起，古帆未挂。","风信不来，无人举棹。"],0,"x118","宋"],["雪峰真觉禅师赞","释心月","四言",["出岭超方，九上三到。","一槌便成，未是性燥。","诵过水偈，闻色空义。","搅炒肝肠，睡不成睡。","棒头领旨，句下明宗。","夜半鳌山，如鹤抛笼。","象骨岩高，中有鳖鼻。","千五百人，中伤者几。","三毬并辊，大用全提。","石火莫及，电光罔追。","大地撮来，如粟米粒。","今昔行人，看之不出。","望州乌石，日炙风吹。","万福曾郎，眼戴双眉。"],0,188,"宋"],["偈颂一百二十三首 其九十四","释祖钦","四言",["元宵令节，且喜天晴。","高烧银烛，照佛光明。"],0,64,"宋"],["三界唯心万法唯识","释守卓","四言",["三界唯心，海岳销沈。","万法唯识，青黄曲直。","天上人间，乃规乃则。","眼耳即真，见闻俱惑。","孰为言宣，讵假玄默。","混尔圆常，分尔百亿。","迷悟不来，尘毛匪忒。"],0,42,"宋"],["偈二十四首 其七","释守卓","四言",["会与不会，拈却一对。","直截如何，风不鸣条，雨不破块。"],0,42,"宋"],["颂古 其九十七","释道颜","四言",["时时日日，日日时时。","七颠八倒，孰是孰非。"],0,47,"宋"],["宋颂九首 其五 六合雷声","石介","四言",["抚我则怀，并人肯来。","降旗出城，并门夜开。","并土既平，吾王休哉。"],0,105,"宋"],["朝阳三章  其三","袁甫","四言",["日之出矣，万象光明。","凤之仪矣，箫韶之音。","观彼仪凤，以观我生。","生生不息，匪亏匪盈。","面此朝阳，默养和平。"],0,229,"宋"],["怀素秋风帖赞","岳珂","四言",["憭栗之秋，骚人所悲。","彼僧何为，乃写以辞。","绝艺出尘，亦寄焉耳。","云烟苍茫，在此幅纸。"],0,"x202","宋"],["偈颂六十五首 其二","释普济","四言",["大包虚空，细入无间。","突出当阳，如何履践。"],0,73,"宋"],["偈颂九十三首 其五十三","释梵琮","四言",["据此座者，说无味话。","上下三指，彼此七马。"],0,100,"宋"],["颂古三十一首 其三十一","释如本","四言",["匙挑不上，箸拨不开。","合掌赞言，善哉善哉。"],0,205,"宋"],["偈颂一百二十三首 其八","释普度","四言",["龙门万仞，到者还稀。","不犯清波，如何进步。"],0,144,"宋"],["强斋高使君金书诸经赞","释居简","四言",["淀蓝蘸楮，屑金作字。","去字与楮，经果何似。","曰此诸经，即楮与金。","续父厥志，写佛语心。","惟佛语心，粤如父志。","一点画中，具无量义。","字可悉数，义则无量。","欲了其源，冥去来相。","强斋大士，年八十馀。","目如心明，作蝇头书。","于一蝇头，分可为二。","尘毛太华，弗巨弗细。","佛神力故，初不作难。","是故北涧，作如是观。"],0,"x94","宋"],["偈颂一百二十三首 其八十六","释崇岳","四言",["有句无句，如藤倚树。","孟八郎汉，便恁么去。","苏噜苏噜。"],0,222,"宋"],["偈颂一百二十三首 其一二三","释崇岳","四言",["达磨达磨，不识这个。","直指单传，胡挥乱做。"],0,222,"宋"],["李运使赞","惠洪","四言",["风度凝远，和气如春。","绿发授道，精敏绝伦。","名冠缙绅，挺然忠义。","知国知兵，如唐陆贽。","顷者天府，奉使江南。","昼锦之荣，父老聚观。","顿节西州，盗发江浙。","提师百万，荡其窟穴。","凯旋而还，口不言功。","但欲使民，生于死中。","重临南楚，化行郡邑。","如春在花，不见痕迹。","恢躁坦夷，易亲难忘。","视其胸次，山包海藏。","宜宿玉堂，宜在黄阁。","跬步可待，昂霄耸壑。","长沙之民，自怀其私。","龛此画像，饮食必祠。"],0,"x42","宋"],["偈颂二十五首 其十九","释智愚","四言",["春风如刀，春雨如膏。","衲僧门下，何用忉忉。"],0,"x153","宋"],["文宣王及其弟子赞 其十六","赵构","四言",["子长宏度，高出伦辈。","虽在缧绁，知非其罪。","纯德备行，夫子所采。","以子妻之，尤知英概。"],0,249,"宋"],["偈颂一百三十三首 其二十七","释法薰","四言",["一言道尽，却成两橛。","击鼓升堂，子承父业。"],0,31,"宋"],["偈颂七十六首 其十一","释师观","四言",["断人性命，不劳馀刃。","四海一家，风恬浪静。"],0,210,"宋"],["祫享八首 初献、顺祖酌献用《大宁》。","郊庙朝会歌辞","四言",["于赫皇祖，浚发其祥。","德盛流远，奕世弥昌。","孝孙有庆，嘉荐令芳。","神保是享，锡羡无疆。"],0,"x207","宋"],["偈颂七十六首  其七四","释师范","四言",["扰扰怱怱，晨鸡暮钟。","瑞岩不会，唤主人翁。"],0,"x155","宋"],["颂古四十八首 其四十五","释慧开","四言",["他弓莫挽，他马莫骑。","他非莫辨，他事莫知。"],0,65,"宋"],["妙湛禅师月岩舍利赞","释居简","四言",["及笄洗妆，一花一香。","舍父求度，回度厥父。","父子学空，机先有锋。","父死开法，镆铘出匣。","归奉其母，孤山之浒。","示生有灭，笑与母诀。","火后舍利，粲如繁星。","如金之晶，如玉之明。","堂堂月岩，如空行月。","何庸留此，自暴丑拙。"],0,"x94","宋"],["宣律师赞","惠洪","四言",["此毗尼藏，三世完坚。","愿王手封，款识具全。","死生之烈，不能变迁。","何以至之，正知则然。","何人逸想，以笔墨传。","跏趺俯视，颓然深渊。","天神护持，弟子敬虔。","我拜稽首，泪滴九泉。","法道凌夷，障云盖缠。","乃于是时，瞻此释天。"],0,"x42","宋"],["题赵鸥波高士图","钱仲鼎","四言",["在昔洛阳，雪深丈馀。","士也高卧，来令尹车。","今年吴淞，雪复何如。","积素一色，鸥鹭有无。","之子江皋，修亭是居。","有琴有书，有酒有鱼。","赏静独眺，聊以自娱。","挹兹清风，凛凛起予。","此景此图，再卷再舒。"],0,219,"宋"],["夕月三首 其三 送神用《高安》。","郊庙朝会歌辞","四言",["夙陈笾豆，洁诚致祈。","垂休保佑，景祚巍巍。"],0,"x207","宋"],["春日  其三","陈杰","四言",["翩翩黄鸟，载好其羽。","鲜鲜游子，式歌且舞。","曾孙万年，敬我有土。"],0,174,"宋"],["畴依  其一三","王柏","四言",["至哉子思，忧道失传。","推本遗训，中庸一编。","提挈纲维，开示蕴奥。","无声无臭，孰窥其妙。"],0,"x137","宋"],["得失吟","邵雍","四言",["人有贤愚，事无巨细。","得不艰难，失必容易。"],0,"x57","宋"],["偈颂一百二十三首 其三十五","释崇岳","四言",["荐福住院，事事成现。","露柱灯笼，三门佛殿。","若上若下，和光同尘。","有时又却，神头鬼面。"],0,222,"宋"],["疏黑白无从","释重显","四言",["天地不仁，万化蠢蠢。","若谓非缘，竹何从笋。","发兮发兮，黑白是准。"],0,"x156","宋"],["颂古三十八首 其六","释慧方","四言",["布毛一吹，当下知归。","冷光遍地，独露针锥。"],0,45,"宋"],["偈颂一百零三首  其二七","释月涧","四言",["击鼓升堂，分明指示。","冬至月尾，卖牛买被。"],0,91,"宋"],["山行见月作 其二","赵蕃","四言",["意行何之，陟此云岭。","如梦而觉，如昏而醒。"],0,"x36","宋"],["盘居六章  其一","项安世","四言",["宝峰之阴，其山深深。","有美一人，琼弁玉簪。"],0,"x55","宋"],["偈颂八十五首 其十一","释妙伦","四言",["布袋打开，拄杖拈起。","去也由你，住也由你。"],0,10,"宋"],["苏文忠归颍帖赞","岳珂","四言",["事师之情，期以百世。","言虽不多，意则独至。","识以岁月，越王之孙。","式时览观，用考大伦。"],0,"x202","宋"],null,["黄鲁直催绣词帖赞","岳珂","四言",["词以寓意，何适非理。","游戏翰墨，亦或张弛。","此篇所传，观蜡之比。","乐而不淫，庶几在此。"],0,"x202","宋"],["偈颂二十五首 其五","释如净","四言",["有问有答，屎尿狼藉。","无问无答，雷霆霹雳。"],0,105,"宋"],["偈颂七十二首 其四十五","释祖钦","四言",["动即影现，觉即冰生。","见闻俱尽，视听如盲。"],0,64,"宋"],["文宣王及其弟子赞 其四十一","赵构","四言",["至圣立教，子祺安雅。","擅誉鲁邦，启祚钜野。","炜矣风猷，时哉用舍。","出伦离类，后学是假。"],0,249,"宋"],["圆寂庵铭","杨杰","四言",["万法一源，万念一息。","法无不圆，念无不寂。","强名而名，车尘马迹。","是庵何如，风清月白。"],0,102,"宋"],["偈二十四首 其三","释守卓","四言",["真不掩伪，开眼瞌睡。","曲不藏直，犹较些子。","鱼目明珠，都卢在汝。","更拟如何，未敢相许。"],0,42,"宋"],["偈颂七十二首 其二十八","释祖钦","四言",["电光莫追，石火犹迟。","搆弗及处，心不可识，智不可知。"],0,64,"宋"],["方丘乐歌 其一","郊庙朝会歌辞","四言",["至哉坤仪，万汇资生。","称物平施，流谦变盈。","礼修泰折，祭极精诚。","皇皇灵眷，永奠寰瀛。"],0,"x207","宋"],["颂古五首 其四","释守仁","四言",["锯解秤锤，油煎石磉。","两手擎来，有功者赏。"],0,198,"宋"],["禅宗无门关总颂","释慧开","四言",["大道无门，千差有路。","透得此关，乾坤独步。"],0,65,"宋"],["方丘乐歌 其四","郊庙朝会歌辞","四言",["礼行方泽，文物备举。","惟皇地祇，昭格来下。","奠瘗玉帛，纯诚内著。","神保是享，陟降斯祐。"],0,"x207","宋"],["答问颂五首 其一","释守卓","四言",["有宾有主，父子规程。","子无线索，妙辨纵横。"],0,42,"宋"],["偈颂七十二首 其九","释祖钦","四言",["白衣拜相，平地登仙。","是人知有，别无秘传。"],0,64,"宋"],["偈颂七十二首 其二十二","释祖钦","四言",["吃饭著衣，事事成现。","俯仰折旋，一见便见。"],0,64,"宋"],["颂古一百首 其三十一","释智愚","四言",["不落因果，突出野狐。","人心似铁，官法如炉。","不昧因果，得脱野狐。","顶上无骨，颔下有须。"],0,"x153","宋"],["方丘乐歌 其二","郊庙朝会歌辞","四言",["礼有五经，无先祭礼。","即时伸虔，惟时盥洗。","品物吉蠲，威仪济济。","锡之纯嘏，来歆恺悌。"],0,"x207","宋"],["景德以后祀五方帝十六首 其三 送神用《高安》。","郊庙朝会歌辞","四言",["备物致用，荐羞神明。","礼成乐举，克享克禋。"],0,"x207","宋"],["景德以后祀五方帝十六首 其七 送神用《高安》。","郊庙朝会歌辞","四言",["笾豆有践，黍稷惟馨。","礼终三献，神归杳冥。"],0,"x207","宋"],["景德以后祀五方帝十六首 其十 送神用《高安》。","郊庙朝会歌辞","四言",["土德居中，方舆配位。","乐以送神，式申昭事。"],0,"x207","宋"],["景德以后祀五方帝十六首 送神用《高安》。","郊庙朝会歌辞","四言",["飚轮戾止，景烛灵坛。","金奏绎如，白露漙漙。"],0,"x207","宋"],["景德以后祀五方帝十六首 其十六 送神用《高安》。","郊庙朝会歌辞","四言",["管磬咸和，礼献斯毕。","灵驭言旋，神降之吉。"],0,"x207","宋"],["偈颂一百二十三首 其五","释祖钦","四言",["济北之道，出乎平常。","语默动静，脱体全彰。","三玄三要，松直棘曲。","四宾四主，凫短鹤长。"],0,64,"宋"],["偈颂七十二首 其六十七","释祖钦","四言",["寸长尺短，三平二满。","觌面相呈，语言道断。"],0,64,"宋"],["偈颂七十二首 其二十四","释祖钦","四言",["山花似锦，涧水如蓝。","面目现在，谁是同参。"],0,64,"宋"],["赞护教 其四 关王","释印肃","四言",["困权反正，办道玉泉。","无相无空，义足先天。"],0,"x121","宋"],["六世祖师画像赞 六祖","惠洪","四言",["是风幡动，眼自遮护。","非风幡动，心则显露。","是谓曹溪，显及要旨。","欲证之者，勿留汝意。","暂时敛念，妙寂了然。","汝自受用，密非我边。","负石舂粮，趁獐逐兔。","镜中之空，欲寻无路。"],0,"x42","宋"],["庆元二年皇后册宝十三首 其七","郊庙朝会歌辞","四言",["翚珩焕采，趋节风韶。","陟降墄陛，奉将英瑶。","辟道承薰，嫔仪扬翘。","是敬是祗，德音孔昭。"],0,"x207","宋"],["和陶归鸟 其三","吴芾","四言",["翩翩归鸟，虑患徘徊。","四顾万里，独有故栖。","故栖来反，所愿已谐。","毋思寥廓，扰扰此怀。"],0,"x95","宋"],["望故庐一首","周紫芝","四言",["龟城去江，邈在一隅。","我家龟舫，亦足轩渠。","草耕木茹，瓮牖蓬枢。","有客二人，寔邀望舒。","长须之奴，玉川之庐。","何必仙去，方丈蓬壶。","何必校书，起居何如。","无祸为福，徐行当车。","我乎谁交，谁乎我徒。","春蛙嘈杂，夏木扶疏。","大盗遽起，山摧海枯。","我焚其巢，将焉适欤。","善刀而藏，为之踟蹰。","望我故处，宛其在涂。","我友云亡，云谁与娱。","愿洗甲兵，肉四海臞。","奠我新宅，以饱三馀。"],0,"x139","宋"],["明月  其二","陈杰","四言",["皎皎明月，载缺载盈，我酒在庭。"],0,174,"宋"],["皇雅十首  其二九","尹洙","四言",["前世理官，倚法以刻。","匪彼为仇，盖曰任职。","今之蔽狱，务正其辟。","鉴于前人，繄我仁德。"],0,108,"宋"],["偈颂七十二首 其三十四","释祖钦","四言",["人与境空，境与人会。","百尺竿头，一采两赛。"],0,64,"宋"],["偈颂七十二首 其六十一","释祖钦","四言",["动即影现，拂即成痕。","听其自在，万法无根。"],0,64,"宋"],["偈颂七十二首 其六十三","释祖钦","四言",["形名未立，朕兆未分。","全无巴鼻，彻底浑仑。"],0,64,"宋"],["彼莲之美  其三","曾丰","四言",["厥华尚赤，故为火德。","厥德靡常，虚室生白。"],0,"x193","宋"],["偈颂七十二首 其四十七","释祖钦","四言",["本无位次，不涉安排。","泯然自尽，一种平怀。"],0,64,"宋"],["盘居六章  其二","项安世","四言",["云居之阳，其水洋洋。","有美一人，霞衣月裳。"],0,"x55","宋"],["偈颂一百四十一首  其一○七","释师范","四言",["二由一有，一亦莫守。","一心不生，万法无咎。"],0,"x155","宋"],["荐席","释慧开","四言",["乱草窠中，打成一片。","坐卧寂然，真机顿现。"],0,65,"宋"],["文宣王及其弟子赞 其二十六","赵构","四言",["遐想子期，挟策圣帷。","涉道是嗜，惟士可縻。","在德既贤，在名乃垂。","洋洋之风，逮今四驰。"],0,249,"宋"],["仁宗皇帝二诗御汉体书赞","岳珂","四言",["鸿荒有开，昉颉鸟迹。","字学之兴，亦既象物。","汉有议郎，曰臣蔡邕。","帛书发奇，出淳古踪。","千龄寥寥，嗣响逾邈。","贞观御床，淳化秘阁。","云汉之章，施于仁皇。","厥维天葩，源宋跨唐。","万几燕闲，成是肆笔。","弛张异用，游戏如一。","士俗之成，玄默自躬。","见于首篇，尚䌹之风。","安不忘危，尤示注意。","笔墨之馀，又形拊髀。","庆历之治，太平极功。","帝心所存，天地与同。","春朝鸣珂，秋塞沈柝。","一视之仁，昭此圣学。","海岳八极，羲娥九霄。","媲于宝藏，万世见尧。"],0,"x202","宋"],["颂古三十三首 其二十一","释师观","四言",["拈得便用，胡麻厮缴。","冷地看来，知恩者少。"],0,210,"宋"],["愿成四胜深心偈","晁迥","四言",["豁然悟空，了然见性。","凝然不动，寂然无思。"],0,199,"宋"],["颂古三首  其三","释钦","四言",["有句无句，明来暗去。","活捉生擒，捷书露布。","如藤倚树，物以类聚。","海外人参，蜀中附子。","树倒藤枯，切忌名模。","句归何所，苏𠰷苏𠰷。","呵呵大笑，破镜不照。","大地茫茫，一任𨁝跳。"],0,219,"宋"],["诫子吟","邵雍","四言",["鸡能警旦，马能代行。","犬能守御，牛能力耕。","人禀天地，万物之灵。","妒贤嫉能，不如不生。"],0,"x57","宋"],["文宣王及其弟子赞 其七十二","赵构","四言",["彭衙高士，经籍是亲。","赞成德艺，协于彝伦。","厎绩圣道，斯肖素臣。","优哉游哉，学以致身。"],0,249,"宋"],["淳熙三年发皇后册宝十三首 其十","郊庙朝会歌辞","四言",["葛覃节用，樛木逮下。","形为嫔则，夙已心化。","兹临长秋，遂正诸夏。","以庆以祈，百祥来迓。"],0,"x207","宋"],["和陶归鸟 其四","吴芾","四言",["翩翩归鸟，顾影萧条。","亦既休息，敛此风标。","仍遇俦匹，其鸣交交。","营巢虽苦，亦复亡劳。"],0,"x95","宋"],["偈颂九十三首 其五十五","释梵琮","四言",["旧店重开，全无买卖。","拟欲近前，知君纳败。"],0,100,"宋"],["庆元二年皇后册宝十三首 其八","郊庙朝会歌辞","四言",["帝奉太室，后仪成之。","帝养三宫，后志承之。","德如关雎，盛如螽斯。","宜君宜王，百世本支。"],0,"x207","宋"],["偈六十三首 其五十五","释道宁","四言",["大道皎然，本无迷悟。","杳忘三际，超越上乘。","透古透今，非玄非妙。","通同法界，一种平怀。","古路无私，何人措足。"],0,119,"宋"]]