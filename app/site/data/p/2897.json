[["绍兴以后蜡祭四十二首 神农位酌献。曲同大明。","郊庙朝会歌辞","四言",["惟酒欣欣，惟神冥冥。","是顾是飨，来燕来宁。","耒耜之利，神所肇兴。","万世永赖，无斁其承。"],0,"x207","宋"],["华阴有山行","释文珦","四言",["华阴有山，上与天齐。","仰望莫及，云烟朝𬯀。","人迹罕到，群仙所栖。","餐食沆瀣，乘驾虹霓。","下视万国，大仓一稊。","我欲从之，恨无飞梯。","何当遭逢，授以刀圭。","俾我服饵，妙合天倪。","发白而黑，齿落而儿。","身复少彊，靡资提携。","一息万里，匪拘东西。","蓬瀛阆苑，嬉游忻忻。","纳交松乔，誓无乖暌。","得玄秘道，终然弗迷。"],0,"x80","宋"],["东山图赞 支道林","叶梦得","四言",["一世所驱，颠倒轩裳。","是身何依，独委支郎。","从容三人，亦蹑其后。","人谁无言，联一举手。"],0,4,"宋"],["偈颂一一二首 其五十","释清远","四言",["作无作作，贯色通声。","水中盐味，不见其形。"],0,116,"宋"],["淳熙三年发皇后册宝十三首 其一","郊庙朝会歌辞","四言",["赫赫惟皇，如日之光。","肃肃惟后，如月之常。","礼行一时，明照无疆。","天子莅止，畴敢不庄。"],0,"x207","宋"],["赵忠定濠梁帖赞","岳珂","四言",["真宰之出，维天降才。","既玉于成，勋名九垓。","山川出云，时雨必至。","道之将行，公揭魁瑞。","问学已正，渊源已充。","险夷一涂，奚有于躬。","绍熙季年，国势𣕕杌。","手扶重轮，公为时出。","屹若九鼎，不震不摇。","公秉国成，端委以朝。","拔茅斯征，苞桑斯戒。","匪兕之时，乘否于泰。","有棐至诚，云开于衡。","顾不能排，噂𠴲背憎。","公能者天，岂曰臧氏。","汗青万年，则有公议。","我昔龀齿，拜公江干。","公顾而奇，信乎庭兰。","三十八年，始得遗帖。","忧边谨微，抑寓相业。","字端而庄，德谦而光。","于闲暇时，宪型四方。","书藏在奁，百世如对。","尚想公仪，洒扫进退。"],0,"x202","宋"],["绍兴祀岳镇海渎四十三首 其三十九 北镇位。","郊庙朝会歌辞","四言",["赫赫作镇，幽朔之垂。","兼福我民，食哉具宜。","克配彼岳，有严等衰。","蠲我灌礼，其敢不祗。"],0,"x207","宋"],["又同尘庵","释宗杲","四言",["尘无自性，揽真成立。","拟和其光，同亦俱失。","外既匪宽，内亦不窒。","是义非虚，亦复非实。","庵中主人，如玉处石。","作如是观，千载一息。"],0,"x112","宋"],["颂古四十八首  其三七","释慧开","四言",["言无展事，语不投机。","承言者丧，滞句者迷。"],0,65,"宋"],["高宗建炎初祀昊天上帝 望燎用《正安》。","郊庙朝会歌辞","四言",["灵承上帝，精意感通。","馨香旁达，粢盛既丰。","登降有仪，祀备乐终。","神之听之，福禄来崇。"],0,"x207","宋"],["马郎妇赞","释普济","四言",["有愿必从，无刹不现。","鬓乱钗横，金沙滩畔。","稽首皈依，漏卮难满。"],0,73,"宋"],["宝祐二年皇子冠二十首 其十九","郊庙朝会歌辞","四言",["玄衮黼裳，垂徽永世。","勉勉成德，是在元子。","胙土南宾，厥旨孔懿。","充一忠字，作百无愧。"],0,"x207","宋"],["为郭功甫偈 其一","释守端","四言",["牛来山中，水足草足。","牛出山去，东触西触。"],0,58,"宋"],["绍兴淳熙分命馆职定撰十七首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["总章灵承，维国之常。","礼乐宣鬯，降升齐庄。","竭诚尽志，荐兹累觞。","于昭在上，申锡无疆。"],0,"x207","宋"],["颂古九十八首 其十八","释印肃","四言",["通宗透说，魂飞识灭。","呈见无体，如水中月。","金毛师子，说无说说。","若人不会，弄巧成拙。"],0,"x121","宋"],["太庙瑞芝颂","王炎","四言",["宋绍天命，列圣重光。","丕绪舄奕，施于无疆。","少海日升，庆元五祀。","渊默面南，格于天地。","于穆清庙，玉芝呈瑞。","蔓蔓其华，丽于丹楹。","匪根斯殖，匪葩斯荣。","和气融液，不春而生。","其瑞维何，祖宗咸喜。","神孙致孝，孺慕无已。","有开必先，产祥𬯎祉。","其孝维何，神明可通。","问安寝门，四辅翼从。","洗爵为寿，雍雍在宫。","莫大之庆，朝野攸同。","赉尔高年，曰予锡类。","颁爵辅臣，曰汝予助。","三宫岂乐，万姓歌舞。","维我高庙，中兴集勋。","神器所传，艺祖之孙。","重华之断，寿康之仁。","凝神冲漠，不俟倦勤。","群黎属望，天启元子。","四圣揖逊，千古颛美。","主鬯匪易，秉心肃庄。","以奉重闱，媚于慈皇。","崇德尚贤，心膂股肱。","尽摈浮伪，慈皇是承。","酬酢万微，未明当依。","不蔽不疑，慈皇是以。","民附于仁，天鉴厥诚。","对越在上，祖宗之灵。","贶以瑞物，胙其德馨。","昔在绍兴，芝尝再茁。","仁皇英皇，二祖之室。","曾孙笃之，克肖其德。","受是珍符，宠绥四国。","曷以祝之，万寿无极。","又曷申之，子孙千亿。","有德有瑞，隐显合符。","自今以始，史将娄书。","皇德日新，勿替厥初。"],0,"x33","宋"],["辞众偈","释景深","四言",["不用剃头，何须澡浴。","一堆红焰，千足万足。"],0,43,"宋"],["明月  其四","陈杰","四言",["载脂我车，载秣我马。","煌煌于征，明月在下。"],0,174,"宋"],["澹岩","谢用宾","四言",["云山野客，家在浯溪。","乘风而来，泛月而归。"],0,150,"宋"],["颂古四十八首 其三十九","释慧开","四言",["急流垂钓，贪饵者著。","口缝才开，性命丧却。"],0,65,"宋"],["绍兴十年发皇太后册宝八首 其二 中书令奉册诣皇帝褥位用《礼安》。","郊庙朝会歌辞","四言",["声乐备陈，礼容罔忒。","相维辟公，虔奉玉册。","皇则受之，慕形于色。","既寿且康，与天无极。"],0,"x207","宋"],["太常乐章三十首 其八 酌献第四室奏大庆之舞曲","杨亿","四言",["洸洸我祖，时惟鹰扬。","潜德弗耀，发源灵长。","肆类配天，永思不忘。","来顾来享，百福是将。"],{"yz":[]},"x47","宋"],["猪头和尚赞","释法薰","四言",["手把猪头，易见难识。","莫教说破，分文不直。"],0,31,"宋"],["和子瞻次韵陶渊明停云诗 其一","苏辙","四言",["云跨南溟，南北一雨。","瞻望匪遥，槛阱斯阻。","梦往从之，引手相抚。","笑言未半，舍我不伫。"],0,"x135","宋"],["张宣公书简帖赞","岳珂","四言",["紫岩之传，原委一忠。","溯而伊濂，根本一中。","事君致身，其用则同。","自我淑人，派于五峰。","力久积真，至公而充。","淳熙之间，天下为公。","守道彬彬，洙泗之风。","公于是时，不下禹功。","据德游艺，言立志通。","故其遗书，笔意俱工。","我得而藏，敢忘所宗。","渊渊其心，皓皓其容。","学冠穹壤，名侪岱嵩。","万世仰之，曰人中龙。"],0,"x202","宋"],["元侍者求赞","释清远","四言",["道虽光明，形则山野。","提折脚铛，住深兰若。","拙韵无取，陋容谁写。","常在左右，觉元侍者。"],0,116,"宋"],["颂古十三首 其二","释德光","四言",["一亩之地，三蛇九鼠。","子细看来，是何面胔。"],0,208,"宋"],["沙弥文信大悲颂","黄庭坚","四言",["通身是眼，不见自己。","欲见自己，频掣驴耳。","通身是手，不解著鞭。","白牛懒惰，空打车辕。","通身是佛，顶戴弥陀。","头上安头，笑杀涪皤。"],0,"x66","宋"],["偈二首 其一","释道闲","四言",["全机敌胜，犹在半途。","啐啄同时，白云万里。","才生朕兆，已落二三。","不露锋铓，成何道理。","诬人之罪，以罪加之。"],0,95,"宋"],["绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其十","郊庙朝会歌辞","四言",["涓辰协吉，时维春元。","上册三殿，旷古无前。","思齐重闱，积庆有源。","是尊是崇，帝心载虔。"],0,"x207","宋"],["淳熙二年发太上皇帝太上皇后册宝十一首 其十一 内侍官举太上皇后册诣读册位用《圣安》。举宝同。","郊庙朝会歌辞","四言",["珉玉玢豳，袅蹄精良。","既刻厥文，亦铸之章。","象德维何，至静而方。","辅我光尧，万寿无疆。"],0,"x207","宋"],["大观秋分夕月四首 其三 酌献。","郊庙朝会歌辞","四言",["名稽汉仪，歌参唐宗。","往于卿少，乘秋气中。","周天而行，如姊之崇。","可飞霞佩，下琉璃宫。"],0,"x207","宋"],["明日北风尤甚不可行再谗","陈舜俞","四言",["我行楚滨，洪波是涵。","飘风不惠，停舳相衔。","我实有辞，将伯是谗。","越明日作，若怒弗咸。","大吹振荡，厥声唬喊。","龙凭虎借，播谷摇岩。","止莫能维，行不可帆。","谁令其然，维伯所监。","我名有谗，实意以祷。","终使不往，宁弗之报。","泛泛行者，有游有漕。","罔不衣食，或俱幼老。","出其孔艰，仁者攸好。","吹而顺之，毋忽予告。"],0,133,"宋"],["和子瞻次韵陶渊明停云诗 其二","苏辙","四言",["晚稻欲登，白露霄蒙。","人饮嘉平，浆酒如江。","我独何为，观成于窗。","此心了然，来无所从。"],0,"x135","宋"],["高丽炉一枚寄虎丘结老为说偈言","曹勋","四言",["兹炉之先，鲸波空际。","有国曰韩，以陶以器。","奉之函丈，宝烟轻细。","此一瓣香，用严报地。"],0,"x103","宋"],["政和鹿鸣宴五首 其一","郊庙朝会歌辞","四言",["思乐泮水，承流辟雍。","思皇多士，贲然来从。","雍雍济济，四方攸同。","登于天府，维王是崇。"],0,"x207","宋"],["颂古十七首 其十七","释师观","四言",["指天指地，无处回避。","瞿昙瞿昙，讨甚巴鼻。"],0,210,"宋"],["李伯时画像赞","王庭珪","四言",["非佛非仙，亦非儒者。","硉硉矹矹，名满天下。","孰貌其真，非真非假。","读东坡诗，乃识此画。"],0,"x198","宋"],["鼎需禅人求赞","释宗杲","四言",["身心一如，身外无馀。","咄这瞎驴，付与鼎需。"],0,"x112","宋"],["宋江三十六赞 其二十五 立地太岁阮小五","龚开","四言",["东家之西，即西家东。","汝虽特立，何有吾宫。"],0,103,"宋"],["瑞芝赞","李纲","四言",["太虚磅礴，钟此和气。","庆门其昌，而产斯瑞。","厥瑞维何，灵芝煌煌。","孝诚所致，文字之祥。","有开必先，其应以类。","力学显亲，孰孝于是。","勉修远业，自奋于时。","匪我云然，芝实告之。"],0,"x136","宋"],["乾道七年恭上太上皇帝太上皇后尊号十一首 其一 册宝降殿用《正安》。","郊庙朝会歌辞","四言",["元祀介福，孰绥孰将。","归于尊亲，孝哉君王。","载镂斯牒，载琢斯章。","得名得寿，如虞如唐。"],0,"x207","宋"],["魏京诗 其八","刘敞","四言",["如虎如貔，如霆如雷。","靡有远迩，天子其来。"],0,"x51","宋"],["玉真瑞世颂","白玉蟾","四言",["西华王母，紫虚元君。","咀嚼九日，偃仰三云。","毛竹秦娥，箫台周女。","夜骑天风，晓诣帝所。","琪花开盛，凤鸟歌雍。","霞旌舞翠，烟幢丽空。","金茎露飞，玉树月淡。","苍苔丹墀，红药宋槛。","北斗后德，阳春母仪。","飙乘鹤驱，霓裳羽衣。","懿淑靖都，恭柔慧闲。","金玉渊海，琼瑶丘山。","圣学光明，宝翰芳美。","四海歌谣，关雎麟趾。","仙仪冲粹，道性熙怡。","福禄来为，葛藟螽斯。","金鼎凝霜，玉炉煅月。","芝田黄芽，桂馆白雪。","青鸟不至，翠蓬忘归。","玉真瑞世，吾教光辉。","详延方士，酬酢道要。","营魄守雌，玄牝观妙。","广寒兔老，衡岳松青。","至尊万寿，永保坤宁。"],0,"x77","宋"],["正冬御殿上寿乐章八首 其四 皇帝举第三爵酒登歌奏丹凤之曲","杨亿","四言",["矫矫长离，振羽来仪。","和音中律，藻翰扬辉。","珍符沓至，品物攸宜。","至德玄感，受天之祺。"],{"yz":[]},"x47","宋"],["赠林耕叟赴湖帅幕","赵汝腾","四言",["东莱之师，是为拙斋。","学无不究，道无不该。","体统纯正，规模拓恢。","卓成一家，犹斗之魁。","未及百年，遗响冷灰。","我守宝婺，四学是开。","以导生徒，俾绍东莱。","回首七霜，谅多成材。","英英耕叟，我友自孩。","吐词不群，制行亦瑰。","勉以朱学，持论不回。","仆家源流，是拥是培。","仲尼得伋，垂教方来。","拙斋有孙，其道未颓。","且告瓜熟，定王之台。","僮马载驰，羔雁屡催。","予闻湘流，夙称圣涯。","懋陵之邦，元公所胎。","南轩昭昭，五峰巍巍。","岂无秀民，可与摩揩。","求仁得仁，懋哉懋哉。"],0,47,"宋"],["颂古三十一首 其十七","释安永","四言",["快人一言，快马一鞭。","停囚长智，十万八千。"],0,145,"宋"],["宋颂九首 其一 明道","石介","四言",["明肃惟母，实勤养抚。","有臣有虎，有离有附。","请王禄产，请庙考祖。","古人有作，规吕矩武。"],0,105,"宋"],["布袋赞 其五","释居简","四言",["正续无名，散圣无位。","秦汉不收，惭愧惭愧。"],0,"x94","宋"],["嘉禾颂七章章四句  其三","吴泳","四言",["中和既时，重颖既垂。","自向其本，岂不尔思。"],0,222,"宋"],["奉礼帖赞","岳珂","四言",["群贤修禊，书法遂东。","永欣之传，盛于越中。","褚虽莫留，犹有远公。","至今千岩，飒然清风。"],0,"x202","宋"],["荷鹭 其二","释智愚","四言",["蒲叶吹秋，水天漠漠。","敛影肃心，意不在啄。"],0,"x153","宋"],["绍定三年寿明仁福慈睿皇太后册宝九首 其五","郊庙朝会歌辞","四言",["皇仪有炜，彩舁次升。","沈沈邃殿，穆穆天廷。","坤德罙隆，皇图永宁。","咨尔廷臣，摄齐以登。"],0,"x207","宋"],["淳熙十二年加上太上皇帝太上皇后尊号十一首 其一 大庆殿发册宝降殿用《正安》。","郊庙朝会歌辞","四言",["维天盖高，维地克承。","父尊母亲，天地难名。","疆名广大，建号安荣。","衍登寿嘏，阐绎皇明。"],0,"x207","宋"],["杏壳观音菩萨赞","惠洪","四言",["对现色身，色身三昧。","如无边春，透尘透海。","使诸众生，道与神会。","知寂灭法，不以身碍。","随欲观者，非小非大。","此银杏壳，纤秾向背。","百福庄严，千花自在。","稽首大慈，如大地载。","如皎空月，无所覆盖。","舍精进幢，如坚刚铠。","太虚殒消，我愿不退。"],0,"x42","宋"],["偈颂一百四十二首 其一○五","释广闻","四言",["写王公符，用商君令。","师多鬼乱，药多病甚。"],0,10,"宋"],["还神冈圆首座戒刀颂","黄庭坚","四言",["平生受用，三尺吹毛。","欢喜斩新，拾得孟劳。","梦中唤起，犹自忉忉。","我王库中，无如是刀。"],0,"x66","宋"],["梁溪四友赞序 其一 岁寒赞","李纲","四言",["霜霰既零，草木殄瘁。","惟兹岁寒，独立不改。","寸苗初植，未离蓬艾。","挺然凌云，色参天黛。","虬枝茂叶，舞影垂阴。","清风徐来，虎啸龙吟。","与子为友，贵相知心。","何以乐之，写此素琴。"],0,"x136","宋"],["汉诏郡县行乡饮酒礼颂诗 其七","洪遵","四言",["笙流觯扬，少长位辨。","已事而竣，不诫用劝。"],0,18,"宋"],["汉诏郡县行乡饮酒礼颂诗 其九","洪遵","四言",["干清坤夷，轩豁呈露。","万祥毕溱，登三咸五。"],0,18,"宋"],["感秋诗 其三","许琮","四言",["风起木非，菀焉者歇。","故乡在念，何以视月。","众念思归，鸟情望碧。","嗷嗷鸣雁，集彼中泽。","我独伊何，罗此网罗。","父兮母兮，生我实多。"],0,6,"宋"],["皇祐亲享明堂六首 其三 酌献曰《庆安》。","郊庙朝会歌辞","四言",["肃肃路寝，相维明堂。","二仪鉴止，三圣侑旁。","灵期欣合，祠节齐庄。","至诚并贶，降福无疆。"],0,"x207","宋"],["宋颂九首 其二 明道","石介","四言",["政在房帷，小人乘时。","十年于兹，惟几惟微。","圣人如天，不识不知。","龙晦其威，神藏其为。"],0,105,"宋"],["颂古四十四首 其十","释师范","四言",["日面月面，突出难辨。","拟欲抬眸，空中两片。"],0,"x155","宋"],["绍兴以后祀五方帝六十首 有熊氏位奠币用《嘉安》。","郊庙朝会歌辞","四言",["维有熊氏，以土胜王。","其后皆沿，兹德用壮。","黼黻幅舄，裳衣是创。","币之玄𫄸，对此昭亮。"],0,"x207","宋"],["大宋中兴雅","李正民","四言",["炎正中微，泰极而否。","边陲云扰，中原糜沸。","靖康之元，逼我京师。","金汤弛备，兵缠紫微。","天方佑宋，帝在济阳。","貔貅十万，左右陈行。","旌旗蔽野，戈鋋彗云。","八神警跸，七萃骏奔。","移师商丘，亿兆乐推。","讴歌狱讼，竭蹶咸归。","爰登宝位，爰绍丕基。","兢兢业业，一日万机。","既巡淮甸，乃涖浙江。","遣使聘问，原隰相望。","两宫未复，夙夜靡遑。","经之营之，十有馀年。","戊午之秋，使车来旋。","谓彼邻国，远达温言。","欲讲盟好，厥志已坚。","使在淮浦，众言盈庭。","如蜩如螗，如沸如羹。","更唱迭和，万口狺狺。","帝若不闻，默与神谋。","圣志先定，惟相是诹。","轺车戾止，和好是求。","复我河南，旧县与州。","疆界方交，左贤被罪。","谋臣既歼，信誓中悔。","古贤继之，矜其勇鸷。","氛尘冥冥，侵我淮泗。","帝赫斯怒，张我皇威。","乃敕六将，建尔鼓旗。","追奔逐北，于淮之湄。","师入陈许，亦反濉涣。","两都震惧，人心冰泮。","元戎𫘝马，往告于金。","群情愕眙，罔敢来侵。","皇天悔祸，殊邻革心。","按兵于境，旧盟是寻。","锡以金帛，稛载方舟。","皇华络绎，典礼具修。","载书孔明，戎车遄迈。","质于鬼神，万世永赖。","龙楯来归，兆庶雨泣。","圣心孺慕，哀恫罔极。","百神毕会，缵禹之迹。","永祐后昆，山川叶吉。","长乐就养，袆衣褕翟。","万寿称觞，怡心顺色。","晨羞既进，夕膳载加。","天子之孝，修于邦家。","归马散牛，句戈束矢。","大将释师，军政咸理。","淮滨之民，夜眠晏起。","秉尔耒耜，或耘或宣，惟仲山甫。","爱莫助之，民鲜克举。","我宋之隆，君臣会通。","咸有一德，协于尹躬。","中兴之功，薰灼夷夏。","臣作是诗，以继周雅。"],0,144,"宋"],["高宗郊祀前朝享太庙三十首 其二十二 终献用《正安》。","郊庙朝会歌辞","四言",["疏幂三举，诚意一纯。","孰陪予祀，公族振振。","神具醉止，燕娭窈冥。","于万斯年，绥我思成。"],0,"x207","宋"],["东坡画应身弥勒赞","惠洪","四言",["唯老东坡，秀气如春。","游戏翰墨，挝雷翻云。","偶寄逸想，幻此沙门。","了无一事，荷囊如奔。","憨腮皤腹，行若不闻。","众生狂迷，以利欲昏。","如一器中，闹万虻蚊。","吾未暇度，驼卧猿蹲。","傲睨一世，随处乾坤。"],0,"x42","宋"],["绍兴以后祀五方帝六十首 赤帝奠玉币用《嘉安》。","郊庙朝会歌辞","四言",["太微呈祥，炎德克彰。","佑我基命，格于明昌。","一纯二精，有严典祀。","于以奠之，以介繁祉。"],0,"x207","宋"],["和晋斋兄韵","袁甫","四言",["斟酌元气，斗为帝车。","四时迭运，其信也且。","天道不言，莫非教欤。","日之升矣，云翳扫除。","本无体质，湛然太虚。","历山舜耕，雷泽舜渔。","天德首出，兹焉权舆。","晋斋作诗，诲语勤劬。","我处山樊，饮水饭蔬。","一雨苏旱，民气欢如。","东邻杀牛，西邻刲猪。","市贾不售，始到吾庐。","买来烹之，每食无馀。","凉哉枕簟，凄其葛𦈌。","忽念世涂，滔滔沦胥。","自昔兴亡，具载诗书。","蛊弊极矣，谁与爬梳。","已而谛思，惊饵如鱼。","谁谓王门，可轻曳裾。","观诗末章，荷兄警予。","老冉冉至，虚度望舒。","学贵密察，勿事恢疏。","一念微差，恶草必锄。","真刚大勇，那可踌躇。","未济濡尾，既济濡袽。","元自昭晰，无惑可祛。","拜兄忠告，其敢忘诸。","且此养疴，谁毁谁誉。"],0,229,"宋"],["寒山持经拾得手接 其一","释师范","四言",["手持经卷，付与同伦。","己所不欲，勿施于人。"],0,"x155","宋"],["高宗建炎初祀昊天上帝 文舞退、武舞进用《正安》。","郊庙朝会歌辞","四言",["大德曰生，阴阳寒暑。","乐舞形容，干戚籥羽。","一弛一张，退旅进旅。","神安乐之，祉锡绵宇。"],0,"x207","宋"],["初荣  其二","曾丰","四言",["𦱊𦱊者梅，十月初荣。","于郡之厅，有罍有觥。","主礼孔诚，洽其欢声。","之子初荣，为乡为馨。","匪乡之馨，维郡之馨。"],0,"x193","宋"],["宋颂九首 其四 明道","石介","四言",["圣人之兴，雷动干行。","进退大臣，颜色和平。","诛逐群竖，左右不惊。"],0,105,"宋"],["偈颂六十五首 其四十四","释普济","四言",["迦叶首传，龙潭吹灭。","一灯一灯，灯灯不绝。"],0,73,"宋"],["偈颂五十一首 其二十六","释道冲","四言",["摩竭掩室，净名杜口。","天网恢恢，疏而不漏。","是汝诸人，作么生透。"],0,206,"宋"],["宋江三十六赞 其十九 霹雳火秦明","龚开","四言",["霹雳有火，摧山破岳。","天心无妄，汝孽自作。"],0,103,"宋"],["绍定三年寿明仁福慈睿皇太后册宝九首 其三","郊庙朝会歌辞","四言",["帝阙肃开，天阶坦履。","霓旌羽盖，导仪护卫。","匪夸雕瑑，匪矜繁丽。","兹谓盛仪，亿载千岁。"],0,"x207","宋"],["六世祖师画像赞 四祖","惠洪","四言",["破头峰下，龙象杂遝。","衣付小儿，道传懒衲。","乃尔相违，求人为法。","天书至门，坚卧不答。","念诸众生，捕风捉影。","十地治之，犹未苏醒。","师发笑曰，何必眩瞑。","但勿强名，自然无病。"],0,"x42","宋"],["天台三大士像赞","释清远","四言",["岩岩天台，旷阔寰宇。","大士不我，毫端莫取。","蜀客心狂，纤尘一缕。","屈指拊掌，松石猛虎。","生涯何有，流传今古。","静对虚堂，非谓无补。"],0,116,"宋"],["元符万宁宫庆成颂","赵佶","四言",["句曲之山，有居其颠。","谁氏之子，象帝之先。","启迪后人，淑修其身。","守静而笃，是为葆真。","在昔元符，作室其下。","经始勿亟，以遗来者。","我应受之，嗣绍厥绪。","我仪图之，缮此栋宇。","考彼宫宇，因心而友。","不日成之，克相其后。","乃益其名，曰维万宁。","书以揭之，用妥明灵。","道大无方，体用有常。","以德则帝，以业而王。","坐进此道，与道无极。","神之听之，洽此万国。"],0,"x109","金"],["宋颂九首 其三 明道","石介","四言",["明道四月，睿德明发。","帝褰帘箔，出临轩榻。","总揽万机，指挥六合。"],0,105,"宋"],["绍兴释奠武成王七首 其五 留侯位酌献。","郊庙朝会歌辞","四言",["眷彼留侯，奇筹赞汉。","依乘风云，勒成功旦。","克配明禋，仪刑有焕。","英气如生，来格来衎。"],0,"x207","宋"],["颂古一百二十一首 其九十八","释宗杲","四言",["直出直入，当面不识。","更拟如何，著甚死急。"],0,"x112","宋"],["清凉国师真赞","黄庭坚","四言",["宝月清凉，寂照法界。","以沙门相，藏世间解。","谷响入耳，性不可为。","青莲出水，深不可窥。","万象纷披，花开古锦。","启迫群氓，与甘露饮。","哲人去矣，资何所参。","即事之理，塔锁终南。"],0,"x66","宋"],["常祀皇地祇五首 其四 退文舞、迎武舞用《威安》。","郊庙朝会歌辞","四言",["进旅退旅，载扬干扬。","不愆于仪，容服有章。","式绥式侑，神保是听。","鼓之舞之，神永安宁。"],0,"x207","宋"],["偈颂二十五首 其六","释普岩","四言",["坐而不住，住而不坐。","滴水生冰，因风吹火。"],0,182,"宋"],["辞世颂","释智愚","四言",["八十五年，佛祖不识。","掉臂便行，太虚绝迹。"],0,"x153","宋"],["大观宗祀明堂五首 酌献用《孝安》。","郊庙朝会歌辞","四言",["若昔大猷，孝思维则。","永言孝思，丕承其德。","于昭明威，侑于上帝。","赉我思成，永绥福祉。"],0,"x207","宋"],["摄事十三首 顺祖室用《大宁》。","郊庙朝会歌辞","四言",["思文圣祖，长发其祥。","锡羡蕃衍，德厚流光。","眷命自天，卜世聿昌。","祗肃孝享，降福无疆。"],0,"x207","宋"],["景德以后祀五方帝十六首 其二 奠玉币、酌献并用《嘉安》。","郊庙朝会歌辞","四言",["条风始至，盛德在木。","平秩东作，种献穜穋。","律应青阳，气和玉烛。","惠彼兆民，以介景福。"],0,"x207","宋"],["偈颂七十六首 其四十六","释师观","四言",["伎俩有尽，我默无穷。","达磨不识，眼瞎耳聋。"],0,210,"宋"],["庆元二年皇后册宝十三首 其十三","郊庙朝会歌辞","四言",["天心仁佑，坤德世昭。","灼有慈范，著于累朝。","俭以赞虞，勤以承尧。","是用则效，共励夙宵。"],0,"x207","宋"],["偈颂七十六首 其三十四","释师范","四言",["二由一有，一亦莫守。","文殊普贤，泥猪疥狗。"],0,"x155","宋"],["景德朝日三首 送神用《高安》。","郊庙朝会歌辞","四言",["县象著明，照临下土。","降福穰穰，德施周普。"],0,"x207","宋"],["虾子赞","释梵琮","四言",["斗里跳出，手中捏定。","不入水泥，丧却性命。"],0,100,"宋"],["题于壁","赵卯发","四言",["国不可负，城难以降。","夫妇俱死，节义成双。"],0,174,"宋"],["离卦赞","赵禥","四言",["日月丽天，德备中正。","明以继明，圣而益圣。"],0,42,"宋"],["六世祖师画像赞 二祖","惠洪","四言",["顶峰朝露，神光夜生。","堪任单传，荷担上乘。","自寻其心，不见归宿。","如视环轮，求其断续。","用狱除间，履瘦知肥。","淫坊酒肆，尽其尘机。","雪中斫臂，愿续佛寿。","儿孙闻之，竖毛呵手。"],0,"x42","宋"],["春禽杂言","洪咨夔","四言",["仓庚仓庚，集谷之苕。","谓汝也幽，而岂其乔。","勃鸠勃鸠，有安斯巢。","矜妇之功，不念鹊劳。","决决杜鹃，念归何悲。","岂知汝归，不如未归。","翩翩玄鸟，群雏相依。","羽毛浃矣，同乳异飞。","负阴抱阳，均此一气。","孰使然哉，凄其永忾。"],0,"x128","宋"]]