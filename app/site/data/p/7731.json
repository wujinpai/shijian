[["清平乐 与仙品妹联句","孙云凤","词",["月明风细。","云淡鱼鳞碎。","身倚阑干心似醉。","种种别离滋味。","今宵烛剪窗纱。","明年书寄天涯。","帘幕愁深燕子，烟波梦绕芦花。"],0,229,"清"],["忆秦娥 送仙品妹","孙云凤","词",["莺啼急。","落花满地无人惜。","无人惜。","尊前别酒，天涯行客。","匆匆折柳流觞节。","孤舟风味谁禁得。","谁禁得。","暮鸦残照，水声山色。"],0,229,"清"],["少年游 立夏","孙云凤","词",["著柳烟浓，送春雨细，犹觉峭寒生。","帘影参差，绿阴长昼，枝上杜鹃声。","去年今日阑干外，日暖午风轻。","红摘樱桃，青拈梅子，何处寄离情。"],0,229,"清"],["柳梢青","孙云凤","词",["红药东风。","绿阴疏雨，何处鸣鸠。","门掩残春，帘垂清昼，人倚高楼。","绵绵不断离愁。","似芳草、萋萋遍洲。","天若有情，月如无恨，水亦西流。"],0,229,"清"],["浪淘沙","孙云凤","词",["风静绣帘闲。","燕语梁间。","小楼诗酒忆当年。","今日西窗重剪烛，细雨轻寒。","花事正阑珊。","又唱阳关。","夕阳春水木兰船。","斜立画屏烟篆冷，月到阑干。"],0,229,"清"],["菩萨蛮","孙云凤","词",["小庭春去重帘下。","东风一霎吹花谢。","底事惜分飞。","隔窗啼子规。","举头还见月。","脉脉伤行色。","今夜莫教寒。","有人罗袂单。"],0,229,"清"],["点绛唇","孙云凤","词",["折柳尊前，离亭歌罢西风冷。","路遥酒醒。","立尽斜阳影。","流水行云，从此知难定。","阑休凭。","月残烟暝。","总是凄凉境。"],0,229,"清"],["清平乐","孙云凤","词",["看花赌酒。","乐事何年又。","门巷销魂重插柳。","细雨禁烟时候。","庭中明月团𪢮。","天涯芳草纤绵。","夜夜小楼春梦，随风飞度关山。"],0,229,"清"],["菩萨蛮","孙云凤","词",["晴丝摇曳东风午。","纱窗梦绕屏山路。","日暖杏花香。","小庭春昼长。","燕归帘莫卷。","幽思天涯远。","新月半黄昏。","行人江上村。"],0,229,"清"],["菩萨蛮","孙云凤","词",["日长深柳黄鹂啭。","绣床风紧红丝乱。","微雨又残春。","落花深掩门。","高楼眉暗蹙。","芳草依然绿。","酒醒一灯昏。","思多梦似真。"],0,229,"清"],["菩萨蛮","孙云凤","词",["炉烟袅袅人初定。","纱窗月上梨花影。","春色自年年。","故人山上山。","露寒风更急。","此景还如昔。","记得倚栏干。","夜深人未眠。"],0,229,"清"],["点绛唇","孙云凤","词",["一枕秋声，残灯梦断分襟处。","一番愁绪。","阶下梧桐雨。","记得匆匆，深院留春住。","帘垂户。","莺啼燕语。","日暖花阴午。"],0,229,"清"],["一落索 寄仙品","孙云凤","词",["茸茸芳草烟笼碧。","又逢春色。","落花啼鸟已销魂，忍更作、天涯客。","阶下苔生行迹。","断无消息。","小楼一夜雨和风，都吹入、凄凉笛。"],0,229,"清"],["清平乐","孙云凤","词",["绣帘慵卷。","篆缕回肠转。","临镜自思人近远。","忘了画眉深浅。","单衣初试寒轻。","锦屏闲却银筝。","又是清明时节，落花窗外啼莺。"],0,229,"清"],["菩萨蛮","孙云凤","词",["阴阴细柳深深院。","日长睡起帘初卷。","花底蝶成团。","背人偷倚栏。","绿窗春绣倦。","意绪柔丝乱。","枝上子规啼。","辽阳音信稀。"],0,229,"清"],["相见欢","孙云凤","词",["梧桐淡影层楼。","下帘钩。","消得几番疏雨、几番秋。","金炉篆。","风吹乱。","写春愁。","何处飞来残梦、五更头。"],0,229,"清"],["清平乐","孙云凤","词",["日长春去。","只是无情绪。","柳下重门花下路。","记得旧曾游处。","轻寒小雨初晴。","暖风处处啼莺。","阑外海棠花谢，天涯归信无凭。"],0,229,"清"],["清平乐","孙云凤","词",["留春不住。","一任春归去。","门外马嘶芳草路。","花落子规啼处。","陌头柳色青青。","丝丝欲绾离情。","闲却鸳鸯绣谱，画屏独背银灯。"],0,229,"清"],["忆秦娥 立夏寄仙品","孙云凤","词",["人天末。","绿肥红瘦和谁说。","和谁说。","故乡樱笋，他乡风月。","闲庭春去愁还结。","脆圆荐酒酴醾节。","酴醾节。","此时此景，一般伤别。"],0,229,"清"],["点绛唇 春草。忆仙品","孙云凤","词",["翠倚疏帘，昨宵梦冷池塘雨。","天涯离绪。","岁岁和春住。","又是年时，烟锁垂杨渡。","斜阳暮。","片帆何处。","绿遍归来路。"],0,229,"清"],["浣溪沙","孙云凤","词",["愁里韶华别后心。","冷吟闲坐又春深。","青梅如豆柳成阴。","晓镜刍尼啼绿树，夜窗蟢子上罗襟。","天涯何事信沉沉。"],0,229,"清"],["清平乐 雨夜怀仙品妹","孙云凤","词",["风寒雨细。","酿作愁滋味。","鸳枕半欹人不寐。","点滴绿蕉声碎。","当时剪烛窗西。","而今月黑云迷。","记共海棠深夜，玉阶飞上罗衣。"],0,229,"清"],["菩萨蛮 回文寄仙品妹","孙云凤","词",["小帘疏雨花飞晓。","晓飞花雨疏帘小。","寒峭觉衾单。","单衾觉峭寒。","燕归伤客远。","远客伤归燕。","愁莫倚高楼。","楼高倚莫愁。"],0,229,"清"],["浪淘沙 风萤","孙云凤","词",["青影乱帘旌。","点点春星。","碧天如水月华明。","深院夜凉人乍定，吹坠银屏。","阑外竹声清。","半臂纱经。","玉阶犹忆那时情。","团扇软罗兜不住，茉莉钗横。"],0,229,"清"],["鹧鸪天 赠度曲女郎","孙云凤","词",["细雨和风湿绣帘。","春寒初试越罗衫。","绿杨影里莺声滑，红杏香中蝶梦酣。","思往事，忆江南。","翠屏银烛黛蛾纤。","而今冷梦闲窗夜，明月无情堕画檐。"],0,229,"清"],["清平乐 怀仙品妹","孙云凤","词",["麝炉烟乱。","烛影瓶花短。","鱼雁不来消息断。","寂寞锦屏人远。","任他女伴嬉游。","一春常掩高楼。","除却雕梁燕子，无人解得春愁。"],0,229,"清"],["浣溪沙","孙云凤","词",["小院浓阴绿更幽。","鹧鸪声里夕阳收。","枣花微雨酿成秋。","凉月玉箫怀旧梦，东风池草惹新愁。","一春心事倚高楼。"],0,229,"清"],["菩萨蛮 七夕","孙云凤","词",["年时女伴年时院。","迎风斗巧夸针线。","拜罢烛花明。","罗衣香暗生。","事随流水去。","此恨凭谁语。","凉动画屏秋。","黄昏月一钩。"],0,229,"清"],["祝英台近 端午寄仙品妹","孙云凤","词",["绣帘垂，朱户静，庭午柳阴直。","阶下榴花，独自忍攀摘。","那堪艾虎悬丝，鬓绒贴胜。","空凝望、海天空阔。","总休说。","犹记葵扇题诗，钗映越罗雪。","拈枝流光，眉翠总成结。","负他两度熏风，几番梅雨，想怀抱、也应非昔。"],0,229,"清"],["眼儿媚 题仕女图","孙云凤","词",["云鬟玉貌小庭深。","闲却紫琼琴。","春纤乍露，银毫未落，几度沉吟。","井梧搅得西风碎，清露滴罗襟。","三分月色，半痕烟影，一点秋心。"],0,229,"清"],["少年游 梦","孙云凤","词",["梨云缥缈，东风料峭，寒恋绣衾重。","庭院游丝，池塘芳草，句惹一春中。","锦屏昼永无聊甚，鸳枕乍朦胧。","莫打黄莺，随他蝴蝶，飞入杏花丛。"],0,229,"清"],["念奴娇 玉兰，寄仙品妹","孙云凤","词",["玉梅未落，早东风作弄，浴茧时节。","衣卸湖棉犹道暖，直似残春无别。","柳眼全舒，蕉心欲展，芳草连天末。","阑干凝望，玉兰开遍如雪。","犹记昔日东墙，海棠娇倚，半被轻寒勒。","最是黄昏疏雨过，掩映晶帘明月。","摘粉香清，煎酥色腻，庭下曾攀折。","绿窗人远，此情还共谁说。"],0,229,"清"],["忆秦娥","孙云凤","词",["秋萧瑟。","黄昏独坐窗儿黑。","窗儿黑。","风风雨雨，怎生眠得。","鱼沉雁杳关山隔。","故园又近茱萸节。","茱萸节。","远书不至，灯花空结。"],0,229,"清"],["满江红 题烛溪叔祖“蓬窗听雨图”","孙云凤","词",["一舸西风，吹暮雨、沙清渚白。","尽吟啸、水云深处，鹭闲鸥逸。","帆挂乡心生远浦，橹摇凉梦依秋荻。","响萧萧、夜半听无眠，情怀别。","渔火乱，蓬窗寂。","峰隐翠，波涵碧。","只暗潮吞吐，断崖千尺。","点点轻迷天际树，声声清入烟中笛。","展新图、忽忆下潇湘，浑如昔。"],0,229,"清"],["浣溪沙","孙云凤","词",["帘卷东风燕子飞。","杏花天气卖饧时。","年年孤却踏青期。","绣榻春闲人悄悄。","画屏寒浅漏迟迟。","小窗和月写横枝。"],0,229,"清"],["喝火令 题余慈柏“秋江独钓图”","孙云凤","词",["天净明霞敛，山遥翠黛浮。","潇湘烟景画中收。","输与长竿袅袅，独钓钓清流。","逸思冥冥雁，闲情点点鸥。","断无人处一扁舟。","只有斜阳，只有晚风柔。","只有荻花枫叶，月冷半江秋。"],0,229,"清"],["十六字令","孙云凤","词",["轻。","日暖纱窗风细生。","瓶花落，蝴蝶上帘旌。"],0,229,"清"],["十六字令","孙云凤","词",["听。","六曲屏山倚晓晴。","流莺啭，风递隔花声。"],0,229,"清"],["菩萨蛮 寄仙品妹","孙云凤","词",["绣衾不寐愁如织。","玉炉烟袅纱窗碧。","残月照帘钩。","雁声寒带秋。","夜阑人寂寂。","何处高楼笛。","灯背小屏孤。","梦无书也无。"],0,229,"清"],["如梦令 游丝","孙云凤","词",["袅袅乱粘花絮。","撩撩绿窗情绪。","无赖是东风，依约欲飞还住。","无拘。","无拘。","为我带将愁去。"],0,229,"清"],["清平乐 次花海叔湖上韵","孙云凤","词",["晴丝风乱。","花里红墙短。","一抹柳烟疏欲断。","春色六桥重见。","衣香鬓影轻舟。","金尊檀板层楼。","独向小窗闲坐，满庭细草生愁。"],0,229,"清"],["浣溪沙 自题画梅","孙云凤","词",["冷蕊飞香上笔端。","早春消息陇云寒。","东风欲寄一枝难。","似色似空和月折，非烟非雾卷帘看。","黄昏清影到阑干。"],0,229,"清"],["浪淘沙 题娴卿妹“停琴伫月图”","孙云凤","词",["金鸭篆烟沉。","风满罗襟。","暮霞红断碧云深。","输与阿连清兴好，石上横琴。","独坐漫沉吟。","空际馀音。","待他蟾影挂疏林。","一院嫩凉闲不寐，无限秋心。"],0,229,"清"],["点绛唇 题辅之叔“醉墨图”","孙云凤","词",["座上春风，卷帘炉篆飘窗牖。","娱清昼。","墨花香透。","滋味浓于酒。","满纸淋漓，一试挥毫手。","披图久。","砚池波皱。","腕底烟云走。"],0,229,"清"],["虞美人 自题海棠画帧","孙云凤","词",["鹿庐破梦莺啼晓。","庭外春多少。","禁烟时节柳丝风。","吹得海棠枝上、几分红。","黄昏月澹纱窗薄。","掩映阑干角。","脂鲜黛绿总难描。","犹比桃花丰韵、杏花娇。"],0,229,"清"],["减字木兰花 自题画梅","孙云凤","词",["疏窗寒色。","独抱冰心谁似得。","瘦格玲珑。","人倚珠帘第几重。","风多雾重。","昨夜寒香吹入梦。","检点繁枝。","犹胜春前雪压时。"],0,229,"清"],["疏影 题梁蕉屏表叔“抚梅图”","孙云凤","词",["古梅瘦石。","似隐栖九里，断无尘迹。","枝北枝南，雪后霜前，几度问他消息。","沉吟树底摩挲遍，定写入、春风仙笔。","爱满庭、淡影疏香，能有几人消得。","犹记孤山山下，冻云吹散也，一湖寒碧。","渺矣林逋，寂寞空亭，何似此中清绝。","幽怀尽日忘言坐，共抱却、冬心高洁。","想月明、烟冷黄昏，还有翠禽曾识。"],0,229,"清"],["卖花声 题邵庵叔“桃花流水图”","孙云凤","词",["深树罥晴烟。","栖处悠然。","游踪常共白云还。","细认仙凡都不是，好个溪山。","黄鸟听间关。","翠草纤绵。","纸窗竹屋小吟笺。","飞尽桃花浑不语，赢得春闲。"],0,229,"清"],["应天长","孙云凤","词",["锦衾香冷消兰麝。","明镜黛眉慵不画。","重帘下，怜深夜。","细雨短檠寒穗谢。","柳梢新月挂。","记得晚凉初夏。","花底酒阑歌罢。","个浓蝉鬓卸。"],0,229,"清"],["虞美人 题秀芬妹“额粉庵联吟图”","孙云凤","词",["翠屏凉夜疏帘晓。","雪月花时好。","鸾笺真擘句先成。","应忆榭庭风絮、那时情。","池塘梦草笼烟碧。","江水盈盈隔。","灵心试问绿窗人。","分得画眉仙笔、几分春。"],0,229,"清"],["虞美人 题“莳花小筑春饯图”，送许宜芳女史于归吴门","孙云凤","词",["屏开孔雀杯浮绿。","有个人如玉。","东风明日片帆轻。","两点修蛾新斗、远山青。","瑶笙翠管相催去。","紫燕双飞处。","一庭春影醉斜阳。","无限浓花薰得、绮罗香。"],0,229,"清"],["齐天乐 咏白秋海棠，兼忆仙品妹","孙云凤","词",["莲衣未褪星期过，闲庭嫩凉天气。","寂寂墙阴，深深苔罅，花吐几分秋意。","冰清玉瘦，正掩映红窗，伴侬憔悴。","月澹烟疏，露萤点点短丛缀。","年时夜阑不寐，绛纱笼烛照，微雨初霁。","素靥凝愁，幽香酿韵，别有一般风味。","天涯此际。","定萧瑟空阶，怅思前事。","淅淅西风，怕吹成粉泪。"],0,229,"清"],["西江月 自题词稿，兼寄仙品妹","孙云凤","词",["别绪逗将吟绪，愁心翻作闲心。","美人香草意偏深。","说与旁人不省。","一自雁行云散，几番月色花阴。","何时一鼓海风琴。","共对西窗烛影。"],0,229,"清"],["长相思","那逊兰保","词",["辘轳绠短金井深，梧桐一叶生秋心。","秋心零落向谁诉，络纬唧唧答寒砧。","碧云欲暮归雁远，绿窗闲尽鸳鸯针。"],0,78,"清"],["捣练子 春怨","徐灿","词",["依旧绿，为谁红。","草草花花满泪丛。","欲挽游丝萦好梦，一枝啼血洒春空。"],0,160,"清"],["望江南 燕来迟","徐灿","词",["无情燕，故故却才来。","飞傍绣帘还絮语，笑人依旧是天涯。","戢翼正徘徊。"],0,160,"清"],["长相思 别意","徐灿","词",["花冥冥。","水泠泠。","雨雨风风满碧汀。","劳劳长短亭。","想凄清。","倚银屏。","点点声声不忍听。","盈盈泪暗零。"],0,160,"清"],["西江月 春夜","徐灿","词",["明月照人清夜，多愁多闷输他。","梦魂无计驻飞花。","展转碧阑西下。","柳嫩慢萦春病，梅销暗自酸牙。","漏声千点滴窗沙。","未到送春先怕。"],0,160,"清"],["西江月 感旧","徐灿","词",["剪烛闲思往事，看花尚记春游。","侯门东去小红楼。","曾共翠娥杯酒。","闻说倾城尚在，可如旧日风流。","匆匆弹指十三秋。","怎不教人白首。"],0,160,"清"],["西江月 十五夜雨","徐灿","词",["不是人孤明月，月还负却良宵。","如何三五雨潇潇。","偏滴助愁萋草。","云卷微寒入暮，一灯瘦影魂摇。","梦归宵短路迢迢。","今夜梦归须早。"],0,160,"清"],["西江月 感怀","徐灿","词",["又是春光将尽，东风愁煞梨花。","春魂不化蝶回家。","绕遍玉阑干下。","燕子呢喃未了，一庭蕉雨交加。","凄声细雨奈何它。","记得前春曾怕。"],0,160,"清"],["西江月 水仙","徐灿","词",["素女乍离绮阁，水晶帘动微霜。","幽情未肯便分香。","怕见桃花红浪。","粉蕊含嗔抱喜，怕它蝶乱蜂忙。","一枝清瘦玉初妆。","不许何郎窥望。"],0,160,"清"],["醉花阴 春闺","徐灿","词",["午夜沈沈香薄覆。","梦醒春依旧。","怕得燕双归，带却愁来，偏向人心授。","一剪东风寒欲逗。","渐逼檀眉瘦。","也拟醉花阴，腻白夭红，凄雨先僝僽。"],0,160,"清"],["醉花阴 风雨","徐灿","词",["几日愁风和恨雨。","乡梦教留住。","花外燕双飞，等得它来，诉与伤心语。","碧云有路须归去。","青鸟书无据。","残月又模糊，空照人愁，没个分明处。"],0,160,"清"],["卜算子 春愁","徐灿","词",["小雨做春愁，愁到眉边住。","道是愁心春带来，春又来何处。","屈指数花期，转眼花归去。","也拟花前学惜春，春去花无据。"],0,160,"清"],["如梦令 闺思","徐灿","词",["细雨落花江上。","风动玉钩帘帐。","试问倚阑人，愁锁一天春望。","怊怅。","怊怅。","波畔双鱼轻漾。"],0,160,"清"],["如梦令","徐灿","词",["雨过几枝红倦。","寂寂琐窗西畔。","半梦半醒时，谁向绣衾低唤。","魂断。","魂断，花也为人长叹。"],0,160,"清"],["如梦令 春晚","徐灿","词",["花似离颜红少。","梅学愁心酸早。","生怕子规声，啼绿庭前芳草。","春老。","春老，几树垂杨还袅。"],0,160,"清"],["如梦令 和韵","徐灿","词",["昨夜雨添春重。","滴到眉端愁动。","剪剪海棠风，一点残灯红弄。","如梦。","如梦，梦里心儿还捧。"],0,160,"清"],["如梦令","徐灿","词",["贪看枝头红动。","飞到愁边如共。","回首断桥烟，是处画阑朱栋。","如梦。","如梦，借陈好风吹送。"],0,160,"清"],["如梦令","徐灿","词",["杨柳丝丝青纵。","烟护晶帘无缝。","不信玉阑干，偏得月华珍重。","如梦。","如梦，梦到江南春仲。"],0,160,"清"],["如梦令","徐灿","词",["便别桃源仙洞。","春到愁边谁共。","肠断听阳关，珠靺玉骢催控。","如梦。","如梦，回首柳浓莺哄。"],0,160,"清"],["如梦令","徐灿","词",["隔叶黄鹂娇哢。","惊起绮窗凄凤。","阑槛半帘垂，晓镜春愁将共。","如梦。","如梦，一瞬水流春送。"],0,160,"清"],["南乡子 秋雨","徐灿","词",["秋风试寒初。","一片乡心点滴闲。","滴到湘江多是泪，珊珊。","染得无情竹也斑。","百和夜烧残。","唤起征鸿行路难。","梦里江南秋尚好，般般。","皎月黄花次第看。"],0,160,"清"],["玉楼春 寄别四娘","徐灿","词",["风波忽起催人去。","肠断一朝分燕羽。","无端残梦怯相逢，梦破更添愁万绪。","扁舟暂舣鸳鸯渚。","几度短长亭畔雨。","雨声欲逐泪痕多，知道泪痕多几许。"],0,160,"清"],["菩萨蛮 恨春","徐灿","词",["恨春不忍春光景。","昏昏似醉浑难醒。","撇绣写幽兰。","绿窗风雨寒。","梦回香尚袅。","一枕愁痕小。","负却赏梅心。","杏花春又深。"],0,160,"清"],["菩萨蛮 秋闺","徐灿","词",["西风几弄冰肌彻。","玲珑晶枕愁双设。","时节是重阳。","菊花牵恨长。","鱼书经岁绝。","烛泪流残月。","梦也不分明。","远山云乱横。"],0,160,"清"],["菩萨蛮 春闺","徐灿","词",["困花压蕊丝丝雨。","不堪只共愁人语。","斗帐抱春寒。","梦中何处山。","卷帘风意恶。","泪与残红落。","羡煞是杨花。","输它先到家。"],0,160,"清"],["菩萨蛮 不雨","徐灿","词",["一春催试桃花雨。","游丝只共晴烟舞。","燕也不曾来。","湘帘空自开。","起看花影午。","鸾镜双蛾俯。","徙倚却黄昏。","蜡如红泪痕。"],0,160,"清"],["武陵春 春怨","徐灿","词",["昨夜杨花飞几许，冷暖在心头。","萍踪浪影且随流。","切莫近红楼。","未尽生前愁与闷，烟水古杭州。","春魂黯黯绕兰舟。","却是梦中游。"],0,160,"清"],["木兰花 秋夜","徐灿","词",["夜寒不耐西风劲。","多情却是无情病。","月痕依约到南楼，楼头鼓角三更尽。","蝉残韵咽魂难定。","百般烦恼千般恨。","起来点检露华深，秋蛩四壁声相竞。"],0,160,"清"],["木兰花 秋感","徐灿","词",["春事茫茫秋有几。","眼前又近中秋矣。","怜侬却似梦中身，梦随蝴蝶花间雨。","七贵五侯谁为语。","瑶台日敞悲风里。","飞云流月总无情，有情泪满湘江水。"],0,160,"清"],["木兰花 秋暮","徐灿","词",["才见黄花秋又暮。","滴滴虫声啼绣户。","鸳鸯双枕不知寒，银蜡竞成红泪颗。","梦里乡关云满路。","钗压绿鬟蝉半亸。","月延罗帐似依依，耐它只把人愁锁。"],0,160,"清"],["少年游 有感","徐灿","词",["衰杨霜遍灞陵桥。","何物似前朝。","夜来明月，依然相照，还认楚宫腰。","金尊半掩琵琶恨，旧谙为谁调。","翡翠楼前，胭脂井畔，魂与落花飘。"],0,160,"清"],["虞美人 有感","徐灿","词",["满枕潇潇今夜雨。","人共孤灯语。","凤凰台畔乱香红。","只到寻常烟月、竟匆匆。","江上莼丝秋未采。","莫怨朱颜改。","吴山几曲碧漫漫。","还有许多风景、待人看。"],0,160,"清"],["虞美人 感兴","徐灿","词",["东皇也合怜芳草。","不雨春先老。","鹍弦才拨带愁来。","却似当年佳月、共徘徊。","隋堤弱絮年年舞。","谩惜今和古。","长江凄咽为谁流。","难道雨花春色、片时休。"],0,160,"清"],["虞美人 春闺","徐灿","词",["杨花独解随风去。","无奈廉纤雨。","为春茫未点离愁。","且向辛夷花底、听軥辀。","不知惊起双飞燕。","偷入帘前见。","休将红泪晕香腮。","正是春波带日、晚潮来。"],0,160,"清"],["一斛珠 有怀故园","徐灿","词",["恁般便过。","元宵了、踏歌声杳。","二月燕台犹白草。","风雨寒闺，何处邀春好。","吴侬只合江南老。","雪里枝枝红意早。","窗俯碧河云半袅。","绣幕才牵，一枕梅香绕。"],0,160,"清"],["点绛唇 春暮","徐灿","词",["未信桃花，偷将春色争飞去。","便成红雨。","不管莺无主。","曲曲瑶房，玉暖香深处。","春还许。","海棠枝上。","留取三分住。"],0,160,"清"],["点绛唇 偶成","徐灿","词",["霞剪丹枫，鸿飞锦字山横带。","绮窗无赖。","时把归云碍。","才卷珍珠，紫鹤如相待。","花应爱。","镜中双黛。","也耐青霜在。"],0,160,"清"],["忆秦娥 初晓","徐灿","词",["霜飞早。","花冠只向鸡窗晓。","鸡窗晓。","数声不奈，一灯悄悄。","戍楼传箭频催晓。","香寒玉枕愁心小。","愁心小。","泪盈秋水，镜分多少。"],0,160,"清"],["忆秦娥 春感次素庵韵","徐灿","词",["春时节。","昨朝似雨今朝雪。","今朝雪。","半春香暖，竞成抛撇。","销魂不待君先说。","凄凄似痛还如咽。","还如咽。","旧恩新宠，晓云流月。"],0,160,"清"],["忆秦娥 春归","徐灿","词",["东风老。","起来点检残红少。","残红少。","一帘疏雨，半庭烟草。","燕莺故故将人恼。","千声万语春归了。","春归了。","双蛾谁遣，镜痕愁小。"],0,160,"清"],["忆秦娥 感旧","徐灿","词",["春风院。","花前曾见如花面。","如花面。","浅斟低语，画楼春晏。","闻来已作新巢燕。","看花人在花如霰。","花如霰。","梦中王谢，那时愁见。"],0,160,"清"],["诉衷情 暮春","徐灿","词",["今春何事待将休。","丝雨柳梢头。","恁般心绪撩乱，还要替花愁。","江南景，绿阴稠。","惓红收。","暂飞乡梦，试看归鸿，也算忘忧。"],0,160,"清"],["浪淘沙 底树","徐灿","词",["庭树又秋花。","做弄年华。","满城霜气湿青笳。","眼底眉头愁未了，去数归鸦。","残月霭窗纱。","莫便西斜。","雁声和梦落天涯。","渺渺蒙蒙云一缕，可是还家。"],0,160,"清"],["采桑子 春宵","徐灿","词",["一春风雨和愁滴，珊枕寒时。","玉漏迟迟。","浪语灯花泪暗垂。","惜花未许春归去，香锁葳蕤。","绿遍天涯。","凭得阑干暖为谁。"],0,160,"清"],["谒金门 闻雁","徐灿","词",["愁渺渺。","禁得者番秋老。","云外南鸿音均好。","羡它归甚早。","锦帐带香风袅。","凤烛影分寒悄。","几点漏催天未晓。","一庭星月皎。"],0,160,"清"],["踏莎行 初春","徐灿","词",["芳草才芽，梨花未雨。","春魂已作天涯絮。","晶帘宛转为谁垂，金衣飞上樱桃树。","故国茫茫，扁舟何许。","夕阳一片江流去。","碧云犹叠旧河山，月痕休到深深处。"],0,160,"清"],["踏莎行 饯春","徐灿","词",["萍叶将圆，桐华飞了。","雕梁不见乌衣到。","想应春在五侯家，东风怕拂寒闺草。","归计苕苕，禅心悄悄。","帘前莫问花多少。","试将杯酒饯春愁，从今别向修蛾绕。"],0,160,"清"]]