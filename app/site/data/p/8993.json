[["大观宗祀明堂五首 其一 奠玉币用《镇安》。","郊庙朝会歌辞","四言",["交于神明，内心为贵。","外致其文，亦效精意。","嘉玉既陈，将以量币。","肃肃雍雍，惟帝之对。"],0,"x207","宋"],null,null,["景德祀皇地祇三首 降神用《静安》。","郊庙朝会歌辞","四言",["至哉厚德，陟配天长。","沈潜刚克，广大无疆。","资生万物，神化含章。","同和八变，神灵效祥。","于昭祀典，致享坤仪。","备物咸秩，柔祇格思。","功宣敏树，日益鸿禧。","持载品汇，率土攸宜。","妙用无方，倏来忽逝。","蠲洁寅恭，式终禋瘗。"],0,"x207","宋"],null,null,["常祀皇地祇五首 迎神用《宁安》。八变。","郊庙朝会歌辞","四言",["坤元之德，光大无疆。","一气交感，百物阜昌。","吉蠲致享，精明是将。","介兹景福，鼎祚灵长。","礼经之重，祭典为宗。","上公摄事，登降弥恭。","庶品丰洁，令仪肃雍。","百祥萃止，维吉之从。","礼崇禋祀，神鉴孔明。","牲牷博腯，以炰以烹。","馨香蠲洁，品物惟精。","锡以纯嘏，享兹至诚。","进旅退旅，载扬干扬。","不愆于仪，容服有章。","式绥式侑，神保是听。","鼓之舞之，神永安宁。","物备百嘉，乐周八变。","克诚是享，明德斯荐。","神鉴孔昭，蕃禧锡羡。","回驭飘然，邈不可见。"],0,"x207","宋"],null,["宋初祀神州地祇三首 降神用《静安》。","郊庙朝会歌辞","四言",["膴膴郊原，茫茫宇县。","画野分疆，禹功疏奠。","灵祇是臻，豆笾祗荐。","幽赞皇图，视之不见。","肸蚃储灵，肃恭用币。","锵洋导和，洪休允契。","嘉气云蒸，浃于华裔。","式荐坤珍，聿符明世。","献奠云毕，纯嘏祁祁。","威灵藏用，邈矣何之。"],0,"x207","宋"],null,null,null,["夕月三首 降神用《高安》。六变。","郊庙朝会歌辞","四言",["凝阴禀粹，照临八埏。","丽天垂象，继日代明。","一气资始，四时运行。","灵祇昭格，备物荐诚。","夕耀乘秋，功存宇县。","金奏在县，以时致荐。","祀事孔寅，明灵降眷。","洁粢丰盛，仓箱流衍。","夙陈笾豆，洁诚致祈。","垂休保佑，景祚巍巍。"],0,"x207","宋"],["大观秋分夕月四首 其一 降神用《高安》。","郊庙朝会歌辞","四言",["至阴之精，亏而复盈。","轮高仙桂，阶应祥蓂。","玉兔影孤，金茎露溢。","其驾星车，顾于兹夕。"],0,"x207","宋"],null,null,["熙宁以后祀高禖六首 降神用《高安》。六变。","郊庙朝会歌辞","四言",["容台讲礼，禖宫立祠。","司分届后，带韣陈仪。","嘉祥萃止，灵驭来思。","皇支蕃衍，永固邦基。","郊禖之应，肇自生商。","诞膺宝命，浚发其祥。","天材蕃衍，德称君王。","本支万世，与天无疆。","昔帝高辛，先禖肇祀。","爰揆仲阳，式祈嘉祉。","陈之牺牲，授以弓矢。","敷祐皇宗，施于孙子。","昭荐精衷，灵承端命。","青帝顾怀，神禖储庆。","祚以蕃昌，协于熙盛。","螽斯众多，流于雅咏。","赫赫高禖，万世所祀。","其德不回，锡兹福祉。","蕃衍椒聊，和平芣苢。","传类降康，世济其美。","礼奠蠲衷，祭仪竣事。","丕拥灵休，蕃衍皇嗣。"],0,"x207","宋"],null,["景德祀九宫贵神三首 降神用《高安》。","郊庙朝会歌辞","四言",["倬彼垂象，照临下土。","躔次运行，功德周普。","九宫既位，惟德是辅。","神之至上，皇皇斯睹。","灵禋既肃，明神既秩。","在国之东，协日之吉。","升歌有仪，六变中律。","怀和万灵，降兹阴骘。","祗荐有常，惟神无方。","回飙整驭，垂休降祥。"],0,"x207","宋"],["元祐祀九宫贵神二首 其一 降神用《景安》。六变。","郊庙朝会歌辞","四言",["上天贵神，九宫设位。","功德及物，乃秩明祀。","望拜紫坛，赫然灵气。","奠玉荐币，歆之无愧。"],0,"x207","宋"],null,["建隆以来祀享太庙十六首 迎神用《礼安》。","郊庙朝会歌辞","四言",["肃肃清庙，奉祠来诣。","格思之灵，如在之祭。","克谨威仪，载严容卫。","降福孔皆，以克永世。","工祝升阶，宾尸在位。","祗达孝思，允修毖祀。","显相有仪，克恭乃事。","俨恪其容，通此精意。","木符启瑞，著象成文。","于昭大号，协应明君。","灵命有属，鸿禧洞分。","歌以升荐，休嘉洽闻。","嘉彼驯象，来归帝乡。","南州毓质，中区效祥。","仁格巨兽，德柔遐荒。","有感斯应，神化无方。","素乌爰止，淳精允臧。","名符瑞牒，色应金方。","洁白容与，翘英奋扬。","孝思攸感，皇德逾张。","维牺维牲，以炰以烹。","植其鼗鼓，洁彼铏羹。","孔硕兹俎，于穆厥声。","肃雍显相，福禄来成。","汤汤洪河，经启长源。","郁郁嘉木，挺生本根。","大哉崇基，出乎庆门。","发祥垂裕，永世贻孙。","元钟九千，生于仲吕。","崇台九层，起于累土。","赫日之升，明夷为主。","孝孙作帝，式由祖武。","明明我祖，积德攸宜。","肇继瓜瓞，将隆本支。","爰资庆绪，式昭帝基。","于穆清庙，永洽重熙。","艰难积行，绵长钟庆。","同人之时，得主乃定。","既叙宗祧，乃修舞咏。","经武开先，永昭丕命。","猗欤太祖，受命于天。","化行区宇，功溢简编。","武威震耀，文德昭宣。","开基垂统，亿万斯年。","赫赫皇运，明明太宗。","四隩咸暨，一变时雍。","睿文炳焕，圣德温恭。","千龄万祀，永播笙镛。","已象文治，乃观武成。","进退可度，威仪克明。","常武徂征，诗人所称。","总干山立，厥象伊凝。","肥腯之牲，既析既荐。","郁鬯之酒，已酌已献。","祝辞亦陈，和奏斯遍。","享礼具举，彻其有践。"],0,"x207","宋"],["真宗御制二首 其一 奠瓒用《万国朝天》。","郊庙朝会歌辞","四言",["鸿源浚发，睿图诞彰。","高明锡羡，累洽延祥。","巍巍艺祖，溥率宾王。","煌煌文考，区宇大康。","珍符昭显，宝历绵长。","物性茂遂，民俗阜昌。","甫田多稼，禾黍穰穰。","含生嘉育，鸟兽跄跄。","八纮统域，九服要荒。","沐浴惠泽，祗畏典常。","隔谷分壤，望斗辨方。","并袭冠带，来奉圭璋。","峨峨双阙，济济明堂。","诸侯执帛，天后当阳。","何以辨等，衮衣绣裳。","何以褒德，辂车乘黄。","声明焕赫，雅颂汪洋。","启兹丕绪，祐我无疆。","大统斯集，大乐斯扬。","俯隆宗祏，仰继穹苍。"],0,"x207","宋"],["真宗告飨六首 其一 告受天书用《瑞安》。","郊庙朝会歌辞","四言",["宝命自天，鸿禧锡祚。","昭晰绿文，氤氲黄素。","玄感荐彰，灵休诞布。","寅奉珍符，聿怀永慕。"],0,"x207","宋"],["景祐亲享太庙二首 其一 迎神用《兴安》。","郊庙朝会歌辞","四言",["追养奉先，纳孝练主。","金奏凤鸣，关雎乐舞。","奠鬯恭神，肥腯展俎。","积庆聪明，降景寰宇。"],0,"x207","宋"],["至和祫享三首 其一 迎神用《兴安》。","郊庙朝会歌辞","四言",["濡露降霜，永怀孝思。","祫食谛叙，再闰之期。","歌德咏功，八音播之。","歆神惟始，灵其格兹。"],0,"x207","宋"],["嘉祐祫享二首 其一 迎神用《怀安》。","郊庙朝会歌辞","四言",["躬兹孝享，礼备乐成。","神登于俎，祝导于祊。","展牲肥腯，奏格和平。","灵其昭格，肃僾凝情。"],0,"x207","宋"],["熙宁以后享庙五首 酌献英宗室用《大英》。","郊庙朝会歌辞","四言",["在宋五世，天子嗣昌。","躬发英断，若干之刚。","声容沄沄，被于八荒。","垂千万年，永烈有光。","钟鼓惟旅，笾豆孔时。","衎我祖宗，既右享之。","神亟来止，孝孙之喜。","神保聿归，孝孙之思。","进退有容，服章有仪。","匪亟匪迟，降登孔时。","于穆仁庙，圣泽滂流。","华夷用乂，动植蒙休。","徽名冠古，奕世垂谋。","帝躬祼献，盛典昭修。","赫赫英皇，总提邦纪。","浚发神功，恢张圣理。","仙驭虽遥，鸿徽不弭。","永言孝思，竭诚躬祀。"],0,"x207","宋"],["常祀五享三首 其一 迎神用《兴安》。九变。","郊庙朝会歌辞","四言",["奕奕清庙，昭穆定位。","霜露增感，粢盛洁祭。","神灵来格，福祉攸暨。","追孝奉先，本支百世。"],0,"x207","宋"],null,null,["绍兴十四年奉上徽宗册宝三首 其一 册宝入门用《显安》。","郊庙朝会歌辞","四言",["于铄徽考，如天莫名。","迨兹丕扬，拟纯粹精。","温玉镂文，来至于祊。","有严奕奕，礼备乐成。"],0,"x207","宋"],["淳熙十五年上高宗徽号三首 其一 册宝入门用《显安》。","郊庙朝会歌辞","四言",["于穆高皇，功德兼隆。","称天以诔，初谥未崇。","载稽礼典，扬徽垂鸿。","涓日之良，登进庙宫。"],0,"x207","宋"],["庆元三年奉上孝宗徽号三首 其一 册宝入门用《显安》。","郊庙朝会歌辞","四言",["巍巍孝庙，圣德天通。","同符艺祖，克绍高宗。","有仪有册，载推载崇。","镂玉绳金，登奉祏宫。"],0,"x207","宋"],null,null,["理宗朝享三首 其一 皇帝升降用《干安》。","郊庙朝会歌辞","四言",["于皇祖宗，清庙奕奕。","威灵在天，不显惟德。","垂裕鸿延，诒谋燕翼。","孝孙格斯，受祉罔极。"],0,"x207","宋"],null,["孝宗明堂前享太庙三首 徽宗室酌献用《承元》。","郊庙朝会歌辞","四言",["明明徽祖，抚世升平。","制礼作乐，发政施仁。","圣灵在天，德泽在民。","亿万斯年，保佑后人。","于皇时宋，自天保定。","高宗受之，再仆景命。","绍开中兴，翼善传圣。","何千万年，永绥厥庆。","礼既行矣，乐既成矣。","维祖维妣，安且宁矣。","皇举玉趾，佩锵鸣矣。","拜贶总章，于厥明矣。"],0,"x207","宋"],["理宗明堂前朝享二首 其一 宁宗室奠币用《定安》。","郊庙朝会歌辞","四言",["皇矣昭考，圣灵在天。","称秩宗祀，有严恭先。","奉币以荐，见之僾然。","仁深泽厚，厥光以延。"],0,"x207","宋"],["皇后庙十五首 迎神用《肃安》。","郊庙朝会歌辞","四言",["閟宫翼翼，雅乐洋洋。","牲器肃设，几筵用张。","饰以明备，秩其令芳。","神兮来格，风动云翔。","服章观象，山龙是则。","容止跄跄，威仪翼翼。","恪恭奉祀，祗荐牺牲。","九成爰奏，有俎斯盈。","祀事孔明，庙室惟肃。","铏登笾豆，金石丝竹。","既灌既荐，允恭允穆。","奉神如在，以介景福。","初阳作配，内助惟贤。","柔顺中积，英徽外宣。","神宫有侐，明祀惟虔。","歆诚降祐，于万斯年。","猗那淑圣，象应资生。","配天作合，与日齐明。","椒宫垂范，彤史扬名。","聿修毖祀，永奉粢盛。","王门禀庆，帝族惟贤。","功存内治，德协静专。","流芳图史，垂范纮𫄧。","新庙有侐，祀礼昭然。","明明英媛，德备椒庭。","笾豆有践，黍稷匪馨。","静嘉致荐，容与昭灵。","精意以达，顾享来宁。","曾孙袭庆，柔祇育德。","正位居体，其仪不忒。","教被宫壶，化行邦国。","祝史正辞，垂裕无极。","淑德昭著，至乐和平。","登豆在列，膋香荐诚。","六变合礼，八音谐声。","穰穰景福，佑我休明。","为太宗后，为天下母。","诞圣继明，膺干作主。","玉振金相，兰芬桂芳。","于万斯年，永奉烝尝。","彝尊鬯酒，庆佑遂行。","介以纯嘏，允答明诚。","宗臣率礼，步玉锵锵。","吉蠲斯献，百禄是将。","荐献有终，礼容斯穆。","以奉嘉觞，以膺多福。","明禋告毕，灵辂难留。","升云杳邈，整驭优游。","诚深嘉栗，礼罄钦修。","丰融垂佑，以永洪休。"],0,"x207","宋"],["景祐以后乐章六首 章献明肃皇太后室奠瓒用《达安》。","郊庙朝会歌辞","四言",["肃肃閟宫，顺时荐事。","郁鬯馨香，如见于位。","祥标曾麓，德合方仪。","万邦展养，九御蒙慈。","孝恭祊祏，美播声诗。","淑灵顾享，申锡维祺。","青金玉瓒，祼将于京。","永怀罔极，夙夜齐明。","翊佐先朝，章明壶教。","淑顺谦勤，徽音在劭。","树风不止，劬劳匪报。","黍稷令芳，嘏兹乃告。","祼圭既陈，酌鬯斯醇。","音容彷佛，奠献惟寅。","内辅先猷，夙昭壶则。","保祐之劳，慈惠其德。","荣养有终，芳风无极。","享献閟宫，载怀凄恻。"],0,"x207","宋"],["真宗汾阴礼毕亲谢元德皇后室三首 迎神用《肃安》。","郊庙朝会歌辞","四言",["閟宫奕奕，韶乐洋洋。","牲币虔布，几筵肃张。","醴泉淳美，嘉肴洁香。","俟神来格，降彼帝乡。","乐铿金石，俎奉牺牲。","九成斯奏，五教爰行。","鸾骖复整，鹤驾难留。","白云缥缈，紫府深幽。","庙虽载止，神无不游。","垂佑皇宋，以永鸿休。"],0,"x207","宋"],null,["上钦成皇后册宝六首 其一 入门、升殿用《显安》。","郊庙朝会歌辞","四言",["上帝锡羡，寔生婉淑。","辅佐神皇，宠膺天禄。","诞育泰陵，劬劳顾复。","于昭徽音，久而弥郁。"],0,"x207","宋"],["上明达皇后册宝五首 其一 迎神用《歆安》。","郊庙朝会歌辞","四言",["恭俭宜家，柔顺承天。","德昭彤管，忧在进贤。","宝册袆翟，追荣寿原。","四时祼享，何千万年。"],0,"x207","宋"],["绍兴别庙乐歌五首 其一 升殿用《崇安》。","郊庙朝会歌辞","四言",["新庙肃肃，蒇事以时。","陟降阶墄，雍容有仪。","鞠躬周旋，罔敢不祗。","祝史正辞，灵其格思。"],0,"x207","宋"],["乾道别庙乐歌三首 其一 诣庙用《干安》。","郊庙朝会歌辞","四言",["涓选休辰，于秋之杪。","既齐既戒，爰假祖庙。","有侐仪坤，旧章是效。","享祀奚为，天子纯孝。"],0,"x207","宋"],["绍熙别庙二首 其一 安穆皇后室酌献用《歆安》。","郊庙朝会歌辞","四言",["祥发伣天，符彰梦日。","有怀慈容，孝享庙室。","泰尊是酌，旨酒嘉栗。","灵其格思，祚以元吉。"],0,"x207","宋"],null,["玉清昭应宫上尊号三首 其一 奉告用《隆安》。","郊庙朝会歌辞","四言",["登隆妙号，钦翼渊宗。","茂宣德礼，有恪其容。","奉璋升荐，垂佩弥恭。","扬休咏美，以间笙镛。"],0,"x207","宋"],["朝谒太清宫九首 其一 太尉奉圣号册宝用《真安》。","郊庙朝会歌辞","四言",["上旻降监，介祉实繁。","邦家修报，妙道归尊。","增名霄极，奉册灵轩。","茂宣圣典，永祐黎元。"],0,"x207","宋"],["景祐元年亲享景灵宫二首 降真用《太安》。","郊庙朝会歌辞","四言",["真馆奉币，洁齐致馨。","灵因斯格，社稷庆宁。","椒浆尊享，珍馔精祈。","睟容杳邈，瑶辂霞飞。"],0,"x207","宋"],["大观三年朝献景灵宫二首 其一 奉馔用《吉安》。","郊庙朝会歌辞","四言",["威灵洋洋，靡有常向。","于惟钦承，来假来飨。","博硕芬香，是烝是享。","奉器有虔，载德无爽。"],0,"x207","宋"],null,null,["孝宗明堂前朝献景灵宫八首 其一 盥洗用《干安》。","郊庙朝会歌辞","四言",["合宫之飨，报本奉先。","钦惟道祖，浚发璇源。","驾言谒款，其盥惟虔。","尚监精衷，锡祚绵绵。"],0,"x207","宋"],null,["理宗明堂前朝献景灵宫二首 其一 升殿登歌《干安》。","郊庙朝会歌辞","四言",["我享我将，罄兹精意。","陟降左右，维天与契。","斋明乃心，祗肃在位。","于万斯年，百福来备。"],0,"x207","宋"],["大中祥符封禅十首 其一 山上圜台降神用《高安》。","郊庙朝会歌辞","四言",["岩岩泰山，配德于天。","奉符展采，翼翼干干。","涤濯静嘉，罔有弗蠲。","上帝顾𬤊，冷风肃然。"],0,"x207","宋"],["汾阴十首 降神用《靖安》。","郊庙朝会歌辞","四言",["茫茫坤载，粤惟太宁。","资生光大，品物流形。","瞻言汾曲，允宅神灵。","圣皇躬享，明德惟馨。","至诚旁达，柔祇格思。","奉以琮币，致诚在兹。","博硕者牲，载纯其色。","体荐登俎，聿崇坤德。","秉阴成德，敏树宣功。","应变审谛，神力无穷。","沈潜刚克，流谦示中。","洁兹奠献，妙物玄通。","坤元茂育，植物成形。","于穆圣祖，功齐三灵。","严恭配侑，厚德攸宁。","永怀锡羡，歆此惟馨。","报功厚载，祀事惟明。","思文烈考，道济群生。","侑神定位，协德安平。","馨洁并荐，享于克诚。","寅威宝命，明祀惟虔。","协神备物，罔不吉蠲。","后祇格思，灵飙肃然。","诞受景福，遐哉亿年。","至哉柔祇，滋生蕃锡。","涤濯静嘉，寅恭夕惕。","金奏纯如，万舞有奕。","立我烝民，莫匪尔极。","博厚流形，秉阴成德。","柔顺利正，直方维则。","明祇格思，素汾之侧。","祗载吉蠲，宸心翼翼。","至哉物祖，设象隆脽。","动静之德，翕辟攸宜。","嘉栗以荐，精祷洪厘。","茂宣阴贶，五谷蕃滋。"],0,"x207","宋"],["祗奉天书六首 其一 奉香酌献用《瑞安》。","郊庙朝会歌辞","四言",["谓天盖高，惟皇合德。","倬彼灵章，图书是锡。","眷命谆谆，被以遐历。","膺箓告成，虔恭钦翼。"],0,"x207","宋"],["祭九鼎十二首 其一 帝鼐降神用《景安》。","郊庙朝会歌辞","四言",["日号丙丁，方号中央。","德惟其时，蠲吉是将。","夫何饮之，黄流玉瓒。","夫何食之，有陈伊馔。"],0,"x207","宋"],["大中祥符五岳加帝号祭告八首 其一 迎神用《静安》。","郊庙朝会歌辞","四言",["钟石既作，俎豆在前。","云旗飞扬，神光肃然。","当驾飙欻，来乎青圆。","言备缛礼，享兹吉蠲。"],0,"x207","宋"],["熙宁望祭岳镇海渎十七首 其一 东望迎神用《凝安》。","郊庙朝会歌辞","四言",["盛德惟木，勾芒御神。","沂岱淮海，厥功在民。","爰熙坛坎，裒对庶神。","于以歆格，灵贻具臻。"],0,"x207","宋"],null,null,null,null,["景德祭社稷三首 降神用《静安》。","郊庙朝会歌辞","四言",["百谷蕃滋，丽乎下土。","聿崇明祀，垂之千古。","育物惟茂，粒民斯普。","报本攸宜，国章咸睹。","于穆大祀，功利相宣。","灵坛美报，历代昭然。","介以蕃祉，祚以丰年。","土爰稼穑，允协民天。","制币牺齐，正辞无愧。","乐以送之，毕其精意。"],0,"x207","宋"],null,null,null,["熙宁祭风师五首 其一 迎神用《欣安》。","郊庙朝会歌辞","四言",["飘飖而来，淅沥而下。","爰张其旗，爰整其驾。","有豆有登，有兆有坛。","弭旌柅辀，降止且安。"],0,"x207","宋"],["大观祭风师六首 其一 降神用《欣安》。","郊庙朝会歌辞","四言",["羽旗云车，飘飖自天。","猗欤南箕，歆嘉升烟。","牲饩粢盛，俎簋铏笾。","维神戾止，从空泠然。"],0,"x207","宋"],["雨师雷神七首 其一 迎神用《欣安》。","郊庙朝会歌辞","四言",["众万之托，动之润之。","昭格孔时，维神之依。","泠然后先，肆我肯顾。","是耶非耶，纷其来下。"],0,"x207","宋"],["雍熙享先农六首馀同祈谷","郊庙朝会歌辞","四言",["先农播种，九谷务滋。","灵坛致享，良耜陈仪。","吉日惟亥，运属纯熙。","乐之作矣，神其格思。","亲耕展祀，明灵来格。","九有骏奔，百司庇职。","献奠肃肃，登降翼翼。","祈彼丰穰，福流万国。","肃陈韶舞，祗荐牺牲。","乃逆黄俎，以率躬耕。","祀惟古典，食乃民天。","歆兹洁祀，以应祈年。","式陈芳荐，爰致虔诚。","神其降鉴，永福黎氓。","明禋绀坛，灵风肃然。","登歌已阕，神驭将旋。","道光帝籍，礼备公田。","鉴兹躬稼，永赐丰年。"],0,"x207","宋"],["明道亲享先农十首 迎神用《静安》。","郊庙朝会歌辞","四言",["稼政之本，民食惟天。","甫田兆岁，后稷其先。","灵坛既祀，黛耜攸虔。","乃圣能享，亿万斯年。","冕服在御，坛壝有仪。","陟降左右，天惟显思。","将躬黛耜，先陟灵坛。","嘉玉量币，乐举礼殚。","神既至止，福亦和安。","千斯积咏，万国多欢。","将迎景福，乃荐嘉牲。","籍于千亩，用此精诚。","云罍已实，玉爵有舟。","荐于灵籍，伫乃神休。","神既至飨，福亦来酬。","申锡纯嘏，旨酒惟柔。","思文后稷，贻我来牟。","子孙千亿，丕荷天休。","羽葆有奕，文武交相。","周旋合度，福禄无疆。","豆笾虽荐，黍稷非馨。","惠我丰岁，歆兹至诚。","歆我嘉荐，锡我蕃禧。","多黍多稌，如京如坻。","献终豆彻，礼备乐成。","祠容肃肃，风驭冥冥。","三时务本，一垡躬耕。","人祇胥悦，祉福是膺。"],0,"x207","宋"],["景祐飨先农五首 其一 迎神用《凝安》。","郊庙朝会歌辞","四言",["在昔神农，首兹播殖。","无有污莱，尽为稼穑。","乃粒斯民，实惟帝力。","嘉荐令芳，伫瞻来格。"],0,"x207","宋"],["绍兴享先农十一首 皇帝入内壝盥洗用《隆安》。","郊庙朝会歌辞","四言",["大事在祀，齐洁为先。","既盥而升，奉以周旋。","下观而化，无敢不蠲。","惟神降格，监厥精虔。","猗欤田祖，粒食之宗。","世世仰德，青坛载崇。","时惟后稷，躬稼同功。","作配并祀，以诏无穷。","制为量币，厚意是将。","求之以类，各因其方。","于以奠之，精诚允彰。","神其享止，惠我无疆。","柔毛刚鬣，或剥或烹。","为俎孔硕，登荐厥诚。","蠲涤盏斝，巾帨而升。","挹彼注兹，酒醴维清。","洋洋在上，享于克诚。","神其孚佑，以厚民生。","羽毛干戚，张弛则殊。","进旅退旅，匪棘匪舒。","显相祀事，济济锵锵。","举斝酌醴，神其允臧。","殽核维旅，酒醴维馨。","于再于三，礼则有成。","幽明位异，施报理同。","克恭明神，降福乃丰。","我膺受之，来燕来崇。","岂伊专飨，于彼三农。","莫重于祭，非礼不成。","笾豆有践，尔殽既馨。","神具醉止，荐以齐明。","赞彻孔时，厘事斯成。","神之来止，风驶云翔。","神之旋归，有迎有将。","歌以送之，磬筦锵锵。","何以惠民，丰年穰穰。"],0,"x207","宋"],["亲耕藉田七首 其一 皇帝出大次用《干安》。","郊庙朝会歌辞","四言",["勤劳稼穑，必躬必亲。","为藉千亩，以教导民。","帝出乎震，时惟上春。","天颜咫尺，望之如云。"],0,"x207","宋"],["绍兴祀先农摄事七首 其一 迎神用《凝安》。","郊庙朝会歌辞","四言",["青阳开动，土膏脉起。","日练吉亥，为农祈祉。","典秩增峻，仪物具美。","幄光𤈶黄，庶几戾止。"],0,"x207","宋"],["祀先蚕六首 其一 迎神用《明安》。","郊庙朝会歌辞","四言",["功被寰宇，㒩虫之灵。","有神司之，以生以成。","典礼有初，祀事讲明。","孔盖翠旌，降集于庭。"],0,"x207","宋"],["景德蜡祭百神三首 降神用《高安》。","郊庙朝会歌辞","四言",["百物蕃阜，四方顺成。","通其八蜡，合乃嘉平。","旨酒斯醇，大庖孔盈。","万灵来格，威仪以成。","肃肃灵坛，昭昭上天。","洁粢丰盛，以享以虔。","百神咸萃，六乐斯县。","介兹景福，期于有年。","来顾来享，礼成乐备。","灵驭翩翩，云行雨施。"],0,"x207","宋"],["熙宁蜡祭十三首 其一 东西郊降神用《高安》。","郊庙朝会歌辞","四言",["天锡康年，四方顺成。","乃通蜡祭，索享于明。","金石四作，羽旄翠旌。","神来宴娭，泽被群生。"],0,"x207","宋"],["大观蜡祭二首 其一 东郊亚、终献用《庆安》。","郊庙朝会歌辞","四言",["震乘春阳，仁司生殖。","锡我岁丰，襄我民力。","谁其尸之，宗子先啬。","亿万斯年，怀神罔极。"],0,"x207","宋"],null,null,["大观三年释奠六首 其一 迎神用《凝安》。","郊庙朝会歌辞","四言",["仰之弥高，钻之弥坚。","于昭斯文，被于万年。","峨峨胶庠，神其来止。","思款无穷，敢忘于始。"],0,"x207","宋"],null,["景祐释奠武成王六首 其一 迎神用《凝安》。","郊庙朝会歌辞","四言",["维师尚父，四履分封。","灵神峻密，祀事寅恭。","萧芗祗荐，飙驭排空。","如几如式，福禄来崇。"],0,"x207","宋"],["绍兴释奠武成王七首 其一 迎神用《凝安》，姑洗为宫。","郊庙朝会歌辞","四言",["于赫烈武，光昭古今。","载严祀事，敕备惟钦。","既洁其牲，既谐其音。","神之格思，来顾来歆。"],0,"x207","宋"],["司中司命五首 其一 迎神用《欣安》。","郊庙朝会歌辞","四言",["冠峨峨兮，服章蕤蕤。","灵来下兮，进止委蛇。","我涓我坛，我洁我俎。","降舆却旌，于兹享御。"],0,"x207","宋"],["五龙六首 其一 迎神用《禧安》。","郊庙朝会歌辞","四言",["灵之智兮，跃汉潜幽。","欲豢扰兮，无董与刘。","陈金石兮，佐侑牢羞。","庶燕享兮，泽应民求。"],0,"x207","宋"],["建隆干德朝会乐章二十八首 其一 上寿用《禧安》。","郊庙朝会歌辞","四言",["干健为君，坤柔曰臣。","惟其臣子，克奉君亲。","永御皇极，以绥兆民。","称觞献寿，山岳嶙峋。"],0,"x207","宋"],["淳化中朝会二十三首 其一 上寿用《和安》。","郊庙朝会歌辞","四言",["四序伊始，三阳肇开。","条风入律，玉琯飞灰。","望云肃谒，鸣佩斯来。","称觞献寿，瞻拱星回。"],0,"x207","宋"],null,["熙宁中朝会三首 其一 皇帝初举酒用《庆云》。","郊庙朝会歌辞","四言",["乾坤顺夷，皇有嘉德。","爰施庆云，承日五色。","轮囷下乘，万物皆饰。","惟天祚休，长彼无极。"],0,"x207","宋"],["元符大朝会三首 其一 皇帝初举酒用《灵芝》。","郊庙朝会歌辞","四言",["嘉瑞降临，应我皇德。","烨烨神芝，不根而植。","春秋三秀，昼夜一色。","物播诗歌，声被金石。"],0,"x207","宋"]]