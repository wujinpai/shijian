[["阚骃引语","佚名","隋",["沛国龙穴至山乘。","诈托旅使若奔丧。","道遇寇抄失资粮。"],{"ad":"隋"},"x239","隋"],null,["郦道元引俗谚论清泉河","佚名","隋",["高梁无上源，清泉无下尾。"],{"ad":"隋"},"x239","隋"],["郦道元引古语论南北岈","佚名","隋",["南岈北岈。","万有馀家。"],{"ad":"隋"},"x239","隋"],["郦道元引涝滩净滩谚","佚名","隋",["冬涝夏净。","断官使命。"],{"ad":"隋"},"x239","隋"],["郦道元引语","佚名","隋",["绵洛为没沃。"],{"ad":"隋"},"x239","隋"],["高允引谚","佚名","隋",["其益如毫。","其损如刀。"],{"ad":"隋"},"x239","隋"],["贾思协引谚论力耕","佚名","隋",["智如禹汤，不如常耕。"],{"ad":"隋"},"x239","隋"],["贾思协引谚论种谷树木","佚名","隋",["一年之计，莫如种谷。","十年之计，莫如树木。"],{"ad":"隋"},"x239","隋"],["贾思协引谚论锄地","佚名","隋",["锄头三寸泽。"],{"ad":"隋"},"x239","隋"],["贾思协引谚论养牛马","佚名","隋",["羸牛劣马。","寒食下。"],{"ad":"隋"},"x239","隋"],["贾思协引河西语","佚名","隋",["贷我东墙。","偿我田粱。"],{"ad":"隋"},"x239","隋"],["仇儒造妖言","佚名","隋",["燕东倾。","赵当续。","欲知其名。","淮水不足。"],{"ad":"隋"},"x239","隋"],["魏孝武帝迁长安时谚","佚名","隋",["荧惑入南斗。","天子下殿走。"],{"ad":"隋"},"x239","隋"],["阿那环","佚名","隋",["闻有匈奴主，杂骑起尘埃。","列观长平坂，驱马渭桥来。"],{"ad":"隋"},"x239","隋"],["杨白花","佚名","隋",["阳春二三月。","杨柳齐作花。","春风一夜入闺闼。","杨花飘荡落南家。","含情出户脚无力。","拾得杨花泪沾臆。","秋去春还双燕子。","愿衔杨花入窠里。"],{"ad":"隋"},"x239","隋"],["化胡歌七首 其一","佚名","隋",["我往化胡时，头载通天威。","金紫照虚空，燄燄有光晖。","胡王心懭戾，不尊我为师。","吾作变通力，要之出神威。","麾月使东走，须弥而西颓。","足踏干川桥，日月左右回。","天地昼暗昏，星辰牙差驰。","众灾竞地起，良医绝不知。","胡王心怖怕，叉手向吾啼。","作大慈悲教，化之渐微微。","落簪去一食，右肩不著衣。","男曰忧婆塞，女曰忧婆夷。","化胡今宾服，游神于紫微。"],{"ad":"隋"},"x239","隋"],["化胡歌七首 其二","佚名","隋",["我在舍卫时。","约敕瞿昙身。","汝共摩诃萨。","赍经教东秦。","历落神州界。","迫至东海间。","广宣至尊法。","教授聋俗人。","与子威神法。","化道满千年。","年终时当还。","慎莫恋中秦。","致令天气怒。","太上踏地瞋。","寺庙崩倒澌。","龙王舐经文。","八万四千弟子。","一时受大缘。","轮转五道头。","万元一升仙。","吾子三天上。","悯子泪流连。","念子出行道。","不能却死缘。","不能陵虚空。","束身入黄泉。","天门地户塞。","一去不能还。","虽得存禋嗣。","使子常塞心。","逆天违地理。","灾考加子身。","神能易生死。","由子行不真。","三十六天道。","终卒归无形。","我身西化时。","登上华狱山。","举目看昆仑。","须弥了了悬。","矫翼履清虚。","倏忽到西天。","但见西王母。","严驾欲东旋。","玉女数万千。","姿容甚丽妍。","天姿绝端严。","齐执皇灵书。","诵读仙圣经。","养我同时姝。","将我入天庭。","皇老东向坐。","身体皦然明。","授我仙圣道。","接度天下贤。"],{"ad":"隋"},"x239","隋"],["化胡歌七首 其三","佚名","隋",["我昔西化时。","登上华狱山。","北向视玄冥。","秦川荡然平。","汉少杂类多。","不信至真言。","吾后千馀年。","白骨如丘山。","尸骸路草野。","流血成洪渊。","不忍见子苦。","故作大秦吟。","哀叹二十颂。","以示通中贤。","见机降时世。","不值苦以辛。"],{"ad":"隋"},"x239","隋"],["化胡歌七首 其四","佚名","隋",["我昔化胡时，西登太白山。","修身岩石里，四向集诸仙。","玉女檐浆酪，仙人歌玉文。","天龙翼从后，白虎口驰刚。","玄武负钟鼓，朱雀持幢幡。","化胡成佛道，丈六金刚身。","时与决口教，后当存经文。","吾升九天后，克木作吾身。"],{"ad":"隋"},"x239","隋"],["化胡歌七首 其五","佚名","隋",["我昔离周时，西化向罽宾。","路由函关去，会见尹喜身。","尹喜通窈冥，候天见紫云。","知吾当西过，沐浴齐戒身。","日夜立香火，约敕守门人。","执简迎谒请，延我入皇庭。","叩搏亦无数，求欲从我身。","道取人诚信，三日口不言。","吾知喜心至，遗喜五千文。","欲得求长生，读之易精神。","将喜入西域，迁喜为真人。"],{"ad":"隋"},"x239","隋"],["化胡歌七首 其六","佚名","隋",["我西化胡时。","涉天靡不遥。","牵天覆六合。","艰难身尽婴。","胡人不识法。","放火烧我身。","身亦不缺损。","乃复沉深浏。","龙王折水脉。","复流不复行。","愚人皆哀叹。","枉此贤人身。","吾作腾波气。","起立上著天。","日月头上皦。","光照亿万千。","胡王心方悟。","知是我圣人。","叩头求悔过。","今欲奉侍君。","伏愿降灵气。","怒活国土人。","吾视怨家如赤子。","不顾仇以嫌。","化命一世士。","坐卧诵经文。","身无荣华饰。","后毕得升天。","吾告时世人。","三界里中贤。","欲求长生道。","莫爱千金身。","出身著死地。","返更得生缘。","火中生莲花。","尔乃是至真。","莫有生煞想。","得道升清天。","未负即真信。","丧子千金身。"],{"ad":"隋"},"x239","隋"],["化胡歌七首 其七","佚名","隋",["我昔学道时。","登崖历长松。","盘屈幽谷里。","求觅仙圣公。","食服泥洹散。","渐得不死踪。","九重室中得见不死童。","身体绝华丽。","二仪中无双。","遗我元气乐药。","忽然天圣聪。"],{"ad":"隋"},"x239","隋"],["尹喜哀叹五首 其一","佚名","隋",["尹喜告世人。","欲求长生道。","莫求时世荣。","我昔得道时。","身为关府君。","一日三赏赐。","杂彩以金银。","不以为己有。","施与贫穷人。","白日沾王事。","夜便习灵仙。","餐松食苦柏。","微命乃得存。","精诚神明佑。","守真仰苍天。","感得天地道。","遇见老君身。","难我以父母。","却遗五千文。","秘室熟读之。","三年易精神。","授我仙圣方。","都体解自然。"],{"ad":"隋"},"x239","隋"],["尹喜哀叹五首 其二","佚名","隋",["我昔上九天，下向视玄冥。","但见飞仙士，列翼影清天。","朝宗九天主，太上皇老君。","涤荡六府中，受读仙圣文。","王乔得圣道，游行五岳间。","服气食玉英，受命与天并。"],{"ad":"隋"},"x239","隋"],["尹喜哀叹五首 其三","佚名","隋",["昔往学道时，登岳历高冈。","动见百丈谷，赫赤道里长。","有无极神气，何以到西方。","元以度赤谷，垂泪数千行。","自念宿罪重，五内心摧伤。"],{"ad":"隋"},"x239","隋"],["尹喜哀叹五首 其四","佚名","隋",["我昔求道时，径历数千崖。","浮游八荒外，徒跣身无衣。","东过日出界，西寻清山累。","足底重䟢生，手中抱少微。","道见西王母，问我子何归。","耻身不学道，意欲觅仙师。","感我精诚至，乞我鞋以衣。","尔乃得学道，仙气渐微微。","父母怪我晚，昼夜悲嗥啼。","大道与俗返，一往不复归。","高志日日远，不觉心肝摧。","虽得不死道，日月垂微微。","心精不退转，今作天人师。"],{"ad":"隋"},"x239","隋"],["尹喜哀叹五首 其五","佚名","隋",["昔往学道时，踪迹亦难寻。","东到日出界，树木郁郁深。","南到阎浮提，大火烧我身。","西到俱地?，但见金城门。","青龙绕城腹，白虎守城前。","冲天金楼殿，太上居湛然。","光影耀虚空，仙人绝端严。","齐执黄卷书，口诵长生文。","北向入玄冥，大水湛湛深。","绕天数百迎，足底重䟢生。","尔乃得仙道，把揽天地神。","子能述吾道，白日得升天。"],{"ad":"隋"},"x239","隋"],["太上皇老君哀歌七首 其一","佚名","隋",["三十六宫主。","太上皇老君。","哀悯下世士。","垂神教世贤。","子欲修冥福。","先当体窈冥。","生时得尊贵。","不如过去荣。","仙驾龙车。","迎子游清天。","上登金楼殿。","坐卧虚空间。","行则飞仙从。","威仪上柱天。","朝登天东头。","暮到于天西。","戏乐九天外。","纵意极周旋。","驱使役百鬼。","总统于万金。"],{"ad":"隋"},"x239","隋"],["太上皇老君哀歌七首 其二","佚名","隋",["吾哀世愚民，不信冥中神。","恃力害良善，不避贤行人。","驰马骋东西，自谓常无前。","善恶毕有报，业缘须臾间。","神明在上见，遣使直往牵。","从上头底收，系著天牢门。","五毒更㸦加，恶神来克侵。","口吟不能言，妻子呼仓天。","莫怨神不佑，由子行不仁。"],{"ad":"隋"},"x239","隋"],["太上皇老君哀歌七首 其三","佚名","隋",["吾哀时世人，不信于神明。","先人与种福，子孙履上行。","衣厚饭得饱，灾考不到门。","口气头嘘天，自谓常终日。","看师真辽然，得病叩头请。","外恭心不敬，神明以知人。","三魂系地狱，七魄悬著天。","三魂消散澌，五神不安宁。","伺命来执宰，丞相踏地瞋。","左神不削死，右神不著生。","生神不卫护，煞神来入身。","或患腰背痛，或患头目疼。","百脉不复流，奋忽入黄泉。","天门地户闭，一去不复还。"],{"ad":"隋"},"x239","隋"],["太上皇老君哀歌七首 其四","佚名","隋",["吾哀世愚人，不信冥中神。","生时不恭敬，死便偿罪缘。","典官逐后驱，牵北走东西。","抱沙填江海，负石累高山。","白日不得食，夜分不得眠。","朝与杖一百，暮与鞭一千。","不堪考对苦，卖罪与生人。","两两共相牵，遂至死灭门。","皆由不敬道，神明考㰅人。","何不敬真神，生死得升天。","生荣死者乐，生死得蒙恩。"],{"ad":"隋"},"x239","隋"],["太上皇老君哀歌七首 其五","佚名","隋",["吾哀时世人，不信冥中神。","一门有十息，纵意行不仁。","神明鉴无外，终不滥煞人。","或夭华秀子，或夭妙少年。","门崩户以坏，学者如浮云。","死亦不脱岁，悲哭仍相寻。","妻子沉堙澌，一身孤独存。","呼天天玄远，呼地地亦深。","不能自怨责，各道怨师尊。","虽欲思善道，十子不复还。"],{"ad":"隋"},"x239","隋"],["太上皇老君哀歌七首 其六","佚名","隋",["吾告时世人，修道宜殷勤。","恩亦不虚生，神明必报人。","昔有刘仲伯，精诚于道门。","勤恶使从善，岁会集群贤。","香火日夜勤，亦能感仓天。","命尽应当死，众神与表天。","三魂飞杨澌，七魄入死星。","右神削死藉，左神著生名。","伺命来极济，左相踏地瞋。","普告二十狱，拔出仲伯身。","三魂还复流，七魄还入身。","血脉还运转，百节方更坚。","面目更端严，肉骨更鲜明。","死臣三七日，寝尸还更生。"],{"ad":"隋"},"x239","隋"],["太上皇老君哀歌七首 其七","佚名","隋",["吾告时世人，髐骨不别真。","闲时不共语，急便来求人。","死者如流水，去者如浮云。","秦川屯军马，中庭生丛榛。","百中不留一，到思吾本言。","何不学仙道，人身常得存。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其一","佚名","隋",["一变之时。","生在南方亦如火。","出胎堕地能独坐。","合口诵经声璅璅。","眼中泪出珠子䂺。","父母世间惊怪我。","复畏寒冻来结果。","身着天衣谁知我。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其二","佚名","隋",["二变之时。","生在西岳在汉川。","寄生王家练精神。","出胎堕地谁语言。","晃晃昱昱似金银。","三十六色绮罗文。","国王欢喜会群臣。","英儒雅士平论。","忽然变化作大人。","发眉皓白头柱天。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其三","佚名","隋",["三变之时。","变形易体在北方。","出胎堕地能居床。","合口诵经声琅琅。","额上三午十二行。","两手不门把文章。","配名天地厚阴阳。","从石入金快翱翔。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其四","佚名","隋",["四变之时。","生在东方身青葱。","出胎堕地能瞳舂。","合口诵经声雍雍。","白日母抱夜乘龙。","昆仑山上或西东。","上天入地登虚空。","仙人侍从数万里。","当此之时神气通。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其五","佚名","隋",["五变之时。","生在中都在洛川。","嵩高少室岭岑颠。","中央修福十万年。","教授仙人数万千。","齐得升天入青云。","降鉴周室八百年。","运终数尽向罽宾。","化胡成佛还东秦。","敷杨道教整天文。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其六","佚名","隋",["六变之时。","生在干地西北角。","图画天地立五岳。","处置星辰叙四渎。","二十八宿注乡曲。","日月照曜为下国。","走如流水得周局。","智者察之知急速。","雨泽以时熟五䅽。","万人食之大化足。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其七","佚名","隋",["七变之时。","生在北方在海嵎。","出胎堕地声由由。","好喜歌舞无忧愁。","造作音乐作箜篌。","万帝来请用解忧。","黄河为路行竟头。","一身涉世快游游。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其八","佚名","隋",["八变之时。","生在东北在艮地。","图尽天地我次比。","白衣居士维靡诘。","欲结坐禅须谙气。","通畅经书有舍利。","见吾相好须信企。","感子单诚不延次。","齐得升天不堕地。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其九","佚名","隋",["九变之时。","下人黄泉正地柱。","开辟天地施地户。","四气非阳立冥所。","虽有人民不能语。","吾入身中施六府。","胁为傍通心为主。","从此以来能言语。","尊卑大小有次绪。","万天称传道为父。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其十","佚名","隋",["十变之时。","生在东南出风门。","尽出天道安山川。","置立五岳集灵仙。","吹嘘寒暑生万民。","烦气众生人得真。","置立五藏施心神。","动作六神能语言。","有生有死须臾间。","如水东流何时还。","邂逅相代不得停。","何不习善求长生。","槃散流俗入胶盆。","不能免离丧子身。","欲求度世于中禅。","搦心不坚固仙根。","音聋音哑都不伦。","由子前身谤经文。","论说道士毁圣人。","在恶必报受罪缘。","但勤自责莫怨天。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其十一","佚名","隋",["十一变之时。","生在南方阎浮地。","造作天地有作为。","化生万物由婴儿。","阴阳相对共相随。","众生禀气各自为。","番息众多满地池。","生活自卫由乘靡。","劫数灭尽一时亏。","洪水滔天到月支。","选擢种民留伏羲。","思之念之立僧秪。","唯有大圣共相知。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其十二","佚名","隋",["十二变之时。","生在西南在黄昏。","时人厌贱还?身。","善权方略更受新。","寄胎托俗蟒蛇身。","胎中诵经不遇人。","左胁而出不由关。","堕地七步杂秽间。","九龙洗浴人不闻。","国王欢喜立东宫。","与迎新妇守衢夷。","八百伎女营乐身。","八研四升不破禅。","破散库藏施贫人。","道十八人诣宫门。","贾作大丑婆罗门。","借问太子何时还。","王心不语动王情。","骑王白象触王瞋。","先师知意不与言。","?著擅特在丘。","投身饿虎求道门。","变为白狗数百身。","稽骨须弥示后人。","传语后学须精勤。","莫贪秽辱丧子身。","沉累六趣更生难。","不信我语至时看。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其十三","佚名","隋",["十三变之时。","变形易体在罽宾。","从天而下无根元。","号作弥勒金刚身。","胡人不识举邪神。","兴兵动众围圣人。","积薪国北烧老君。","太上慈悯怜众生。","渐渐诱进说法轮。","剔其须发作道人。","横被无领涅槃僧。","蒙头著领待老君。","手捉锡杖惊地虫。","卧便思神起诵经。","佛气错乱欲东秦。","梦应明帝张愆迎。","白象驮经诣洛城。","汉家立子无人情。","舍家父母习沙门。","亦无至心逃避兵。","不玩道法贪治生。","搦心不坚还俗经。","八万四千应罪缘。","破塔怀庙诛道人。","打?铜像削取金。","未荣几时还造新。","虽得存立帝恐心。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其十四","佚名","隋",["十四变之时。","变形易像在金卫。","沙门闱城说经偈。","至著罪人未可济。","胡人闻之心恐怪。","将从群党来朝拜。","叩头悔过求受戒。","克肌克骨誓不退。","烧指练臂自盟誓。","男不妻娶坐思禅。","死为尸陁喂鹰鹯。","迁神涅槃舍利弗。","骨得八百升散诸国。","如此迁达离烦欲。","苦身求道立可得。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其十五","佚名","隋",["十五变之时。","西向教化到罽宾。","胡国相厘还迦夷。","侵境暴耗买育人。","男子守塞忧婆夷。","吾入国中作善词。","说化男子受三归。","渐渐诱进说法轮。","剔其须发作道人。","阳为和上阴阿尼。","假作父母度僧尼。","师徒相度理无私。","迁神涅槃归紫微。","四镇安穆和我神。","胡人思念长吁啼。","铸作金像法我形。","三时入礼求长生。","寂寂寞寞不应人。","低头视地仰看天。","大圣正真何时还。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其十六","佚名","隋",["十六变之时。","生在蒲林号有遮。","大富长者树提阇。","有一手巾像龙蛇。","遣风吹去到王家。","国王得之大叹咤。","兴兵动众来向家。","离舍百里见莲花。","国有审看一月夜。","王心恶之欲破家。","忽然变化白净舍。","出家求道号释迦。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其十七","佚名","隋",["五百岁之时。","乘龙驾虎道得昌。","汉地广大历记长。","三十六人计弟兄。","超度北阙云中翔。","新卢酒出俱行尝。","娥媚出边作细昌。","当此之时乐未央。","伊耶乐生寿命长。"],{"ad":"隋"},"x239","隋"],["老君十六变词 其十八","佚名","隋",["六百岁之时。","一世以去二世归。","城郭如故时人非。","观者众多知我谁。","死生各异令人悲。","何不学道世欲衰。","踟蹰西北长吁谁。","伊耶乐生治太微。"],{"ad":"隋"},"x239","隋"],["斛律丰乐歌","佚名","隋",["朝亦饮酒醉。","暮亦饮酒醉。","日日饮酒醉。","国计无取次。"],{"ad":"隋"},"x239","隋"],["兖州民为郑氏父子歌","佚名","隋",["大郑公。","小郑公。","相去五十载。","风教尚犹同。"],{"ad":"隋"},"x239","隋"],["邯郸郭公歌","佚名","隋",["邯郸郭公九十九。","技两渐尽入滕口。","大儿缘高冈。","雉子东南走。","不信吾言时。","当看岁在酉。"],{"ad":"隋"},"x239","隋"],["济北民为崔伯谦歌","佚名","隋",["崔府君。","能治政。","易鞭鞭。","布威德。","民无争。"],{"ad":"隋"},"x239","隋"],["文宣时谣","佚名","隋",["马子入石室。","三千六百日。"],{"ad":"隋"},"x239","隋"],["废帝时童谣三首 其一","佚名","隋",["白头羊毣秃。","羖𦍠历头生角。"],{"ad":"隋"},"x239","隋"],["废帝时童谣三首 其二","佚名","隋",["羊羊吃野草。","不吃野草远我道。","不远打尔脑。"],{"ad":"隋"},"x239","隋"],["废帝时童谣三首 其三","佚名","隋",["阿?姑。","祸也。","道人姑夫。","死也。"],{"ad":"隋"},"x239","隋"],["孝昭时童谣","佚名","隋",["中兴寺内白凫翁。","四方侧听声雍雍。","道人闻之夜打钟。"],{"ad":"隋"},"x239","隋"],["武成殂后谣","佚名","隋",["千钱买果园，中有芙蓉树。","破家不分明，莲子随它去。"],{"ad":"隋"},"x239","隋"],["武平元年童谣","佚名","隋",["狐截尾。","你欲除我我除你。"],{"ad":"隋"},"x239","隋"],["武平中童谣","佚名","隋",["和士开。","七月三十日。","将你向南台。"],{"ad":"隋"},"x239","隋"],["武平中童谣","佚名","隋",["七月刈禾伤早。","九月吃糕正好。","十月洗荡饭瓮。","十一月出却赵老。"],{"ad":"隋"},"x239","隋"],["曲严祖珽为斛律光造谣二首 其一","佚名","隋",["百升飞上天。","明月照长安。"],{"ad":"隋"},"x239","隋"],["曲严祖珽为斛律光造谣二首 其二","佚名","隋",["高山不推自崩。","槲木不扶自竖。","盲老公背上下大斧。","饶舌老母不得语。"],{"ad":"隋"},"x239","隋"],["武成时童谣","佚名","隋",["九龙母死不作孝。"],{"ad":"隋"},"x239","隋"],["北齐末邺中童谣","佚名","隋",["金作扫帚玉作把，净扫殿屋迎西家。"],{"ad":"隋"},"x239","隋"],["武平末童谣","佚名","隋",["黄花势欲落。","清尊但满酌。"],{"ad":"隋"},"x239","隋"],["徐之范引童谣","佚名","隋",["周里跂求伽。","豹祠嫁石婆。","斩冢作媒人。","唯得一量紫𫄧靴。"],{"ad":"隋"},"x239","隋"],["杨子术引谣言","佚名","隋",["卢十六。","稚十四。","犍子拍头三十二。"],{"ad":"隋"},"x239","隋"],null,["齐人为苏珍之宋世轨语","佚名","隋",["决定嫌疑苏珍之，视表见里宋世轨。"],{"ad":"隋"},"x239","隋"],["省中为祖珽裴让之语","佚名","隋",["多奇多能祖孝征，能赋能诗裴让之。"],{"ad":"隋"},"x239","隋"],["文林馆中为陆乂语","佚名","隋",["五经无对。","有陆乂。"],{"ad":"隋"},"x239","隋"],["颜之推引俗谚论教子","佚名","隋",["教妇初来。","教儿婴孩。"],{"ad":"隋"},"x239","隋"],["颜之推引谚论治家","佚名","隋",["落索阿姑餐。"],{"ad":"隋"},"x239","隋"],["时人为陈元康语","佚名","隋",["三崔二张。","不如一康。"],{"ad":"隋"},"x239","隋"],["邺下为陆仲让语","佚名","隋",["讲义两行得中郎。"],{"ad":"隋"},"x239","隋"],["时人为唐邕白建言","佚名","隋",["并州赫赫唐与白。"],{"ad":"隋"},"x239","隋"],["时人为裴皇甫二姓兄弟语","佚名","隋",["诹胜于让。","和不如亮。"],{"ad":"隋"},"x239","隋"],["时人为冯祖赵三氏子语","佚名","隋",["冯祖及赵，秽我凤池。"],{"ad":"隋"},"x239","隋"],["御史台中为宋游道语","佚名","隋",["见贼能讨。","宋游道。"],{"ad":"隋"},"x239","隋"],["时人为宋游道陆操语","佚名","隋",["游道狝猴面。","陆操科斗形。","意识不关貌。","何谓丑者必无情。"],{"ad":"隋"},"x239","隋"],["邺下为李氏兄弟语","佚名","隋",["学则浑绘纬，口则绘纬浑。"],{"ad":"隋"},"x239","隋"],["时人为义深语","佚名","隋",["剑戟森森。","李义深。"],{"ad":"隋"},"x239","隋"],["时人为阳休之语","佚名","隋",["能赋能诗。","阳休之。"],{"ad":"隋"},"x239","隋"],["时人为阴凤语","佚名","隋",["阴生读书不免痴。","不识双凤脱人衣。"],{"ad":"隋"},"x239","隋"],["时人为法上谚","佚名","隋",["沙弥若来。","高座逢灾。"],{"ad":"隋"},"x239","隋"],["大禘圜丘及北郊歌辞十三首 其一 肆夏","佚名","隋",["肇应灵序，奄字黎民。","乃朝万国，爰征百神。","只展方望，幽显咸臻。","礼崇声协，贽列圭陈。","翼差鳞次，端拱垂绅。","来趋动色，式赞天人。"],{"ad":"隋"},"x239","隋"],["大禘圜丘及北郊歌辞十三首 其二 高明乐","佚名","隋",["惟神鉴矣，皇灵肃止。","圜璧展事，成文即始。","士备八能，乐合六变。","风凑伊雅，光花袭荐。","宸卫腾景，灵驾霏烟。","严坛生白，绮席凝玄。"],{"ad":"隋"},"x239","隋"],["大禘圜丘及北郊歌辞十三首 其三 昭夏乐","佚名","隋",["刚柔凤位，惟皇配之。","言肃其礼，念畅在兹。","饰牲举兽，载歌且舞。","既设伊腯，致精灵府。","物色惟典，斋沐加恭。","宗族咸暨，罔不率从。"],{"ad":"隋"},"x239","隋"],["大禘圜丘及北郊歌辞十三首 其四 昭夏乐","佚名","隋",["展礼上月，肃事应时。","茧栗为用，交畅有期。","弓矢斯发，瓮簝将事。","圆神致祀，率由先志。","和以銮刀，臭以血膋。","至哉敬矣，厥义孔高。"],{"ad":"隋"},"x239","隋"],["大禘圜丘及北郊歌辞十三首 其五 皇夏乐","佚名","隋",["帝敬昭宣，皇诚萧致。","玉帛齐轨，屏摄咸次。","三垓上列，四陛旁升。","龙陈万骑，凤动千乘。","神仪天蔼，睟容离曜。","金根停轸，奉光先导。"],{"ad":"隋"},"x239","隋"],["大禘圜丘及北郊歌辞十三首 其六 皇夏乐","佚名","隋",["紫坛云暧，绀幄霞褰。","我其陟止，载致其虔。","百灵竦听，万国咸仰。","人神咫尺，玄应肸蚃。"],{"ad":"隋"},"x239","隋"],["大禘圜丘及北郊歌辞十三首 其七 高明乐","佚名","隋",["上下眷，旁午从。","爵以质，献以恭。","咸斯畅，乐唯雍。","孝敬阐，临万邦。"],{"ad":"隋"},"x239","隋"],["大禘圜丘及北郊歌辞十三首 其八 高明乐","佚名","隋",["自天子之，会昌神道。","丘陵肃事，克光天保。","九关洞开，百灵环列。","八樽呈备，五声投节。"],{"ad":"隋"},"x239","隋"],["大禘圜丘及北郊歌辞十三首 其九 武德乐","佚名","隋",["配神登圣，主极尊灵。","敬宣昭烛，咸达窅冥。","礼弘化定，乐赞功成。","穰穰介福，下被群生。"],{"ad":"隋"},"x239","隋"]]