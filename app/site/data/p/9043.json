[null,["句","毛滂","残句",["苕水相逢眼便青。","贪恋恩波未肯飞。"],0,"x110","宋"],null,null,["句 其六","李壁","残句",["鸦健触翻红蔌蔌，鸥闲占断碧粼粼。"],0,80,"宋"],["朱用之","程珌","残句",["用之与程珌同时。"],0,255,"宋"],["句 其三","吴龙翰","残句",["蜀儒为郡追任昉，歙士呼天借寇恂。"],0,2,"宋"],["句","于石","残句",["一局残棋双鹤去，石枰空倚白云寒。"],0,146,"宋"],["句 其二","徐玑","残句",["青蛟煖昼拿云上，白雪深春压架香。"],0,133,"宋"],["句","高似孙","残句",["僧斧菘分甲，渔篝蟹斩脐。"],0,181,"宋"],["句 其二","李清照","残句",["南游尚怯吴江冷，北狩应悲易水寒。"],0,119,"宋"],null,["句","陈舜俞","残句",["石间圆影叠金波。","涧含苍壁隐青萝。"],0,133,"宋"],["句 其三十五","徐俯","残句",["两岁昭潭无瘴疠，清秋郁郁望神冈。"],0,156,"宋"],["偈颂五十一首 其四十一","释大观","残句",["教戴天履地，击壤鼓腹兮不知天地之宽。"],0,181,"宋"],["句 其十七","释祖可","残句",["茅檐攲送晚，苔径曲邀春。"],0,72,"宋"],["采桑行","顾禧","残句",["三府三起，作苦何辞。"],0,54,"宋"],["句 其八","钱惟演","残句",["平槛晓波吴榜渡，绕城春树越禽飞。"],0,175,"宋"],["句 其三","姚辟","残句",["潮卷乱峰横几席，沙填重险变桑麻。"],0,235,"宋"],["句 其三","李邴","残句",["姜坟馀马鬣，傅钓但龙泓。"],0,140,"宋"],["句","缪鉴","残句",["病独有药扶持老，贫为无人心俯仰人。"],0,134,"宋"],["句 其一","萧德藻","残句",["信脚到太古。"],0,239,"宋"],["句 其二","方翥","残句",["濑寒隐鱼鳖，庙古动龙蛇。"],0,64,"宋"],["句","白麟","残句",["三峨影漾沧浪里，万景烟笼缥缈中。"],0,107,"宋"],["句 其三","石延年","残句",["檐重冰箸晴先滴，草屈金钩绿未回。"],0,42,"宋"],["句 其四","何麒","残句",["梁山韭黄妙天下，玉箸金钗盈大把。"],0,102,"宋"],["句","吕希纯","残句",["何处孤城号秭归。","久矣抠衣阙过庭。"],0,65,"宋"],["句","吴氏","残句",["故将罗袖裛啼痕。","纷纷事如麻。"],0,81,"宋"],["句 其一","巩丰","残句",["檐端疏竹前生瘦，瓶里寒梅到死香。"],0,214,"宋"],["句 其二","张镒","残句",["老龙拿空欲轻举，山灵地只挽之住。"],0,34,"宋"],["句","徐仲谋","残句",["郡城重叠安寝有时延皓月，"],0,43,"宋"],["句 其二","林迥","残句",["青韭供盘饼面圆。"],0,198,"宋"],["句 其二","王安上","残句",["日往月来时已久，万古千年名不朽。"],0,1,"宋"],["句 其三","王镐","残句",["发爽带风梳，齿疏和月漱。"],0,75,"宋"],["句","翁宏","残句",["万木本秋里，孤膛半夜猿。"],0,201,"宋"],["句 其二","蒲公","残句",["莺花非汉旧，栋宇尚唐馀。"],0,97,"宋"],["句","释惠崇","残句",["孤云还静境，远籁发秋空。"],0,69,"宋"],["句","陈恬","残句",["嵩阳读水经。","雪里消磨一半春。"],0,18,"宋"],["句 其四","鲍慎由","残句",["平池九曲在，春水萦埼■。"],0,180,"宋"],["句 其二","黄元道","残句",["二五相逢路再迷，"],0,96,"宋"],["句","任伋","残句",["榆钱莫买城南春，柳丝莫系城中人。"],0,221,"宋"],["句","刘奇仲","残句",["玄中一著是吾宗。","吸尽西江说是公。"],0,199,"宋"],["句","刘承弼","残句",["境静人亦寂，觞至壶自倾。"],0,193,"宋"],["句","周必正","残句",["八月分圆二十年。","摛云摇碧露繁星。"],0,68,"宋"],["句","强幼安","残句",["山僧不解数甲子，一叶落知天下秋。"],0,99,"宋"],["句","李柬之","残句",["莫教独欠赤松游。","下客抛官独自回。"],0,45,"宋"],["句","毛德如","残句",["睡觉昏昏厌鼓声。","城头松柏锁愁烟。"],0,189,"宋"],["句","江炜","残句",["斗草事空犹昨日，惜花心在又明年。"],0,109,"宋"],["句","汤思退","残句",["虞妃从醒野，启母袝稽山。"],0,152,"宋"],["无讼堂诗","沈昭远","残句",["欲为袁人雪谤声。"],0,182,"宋"],["句","王才元","残句",["雪曳山容改。","远墅炊烟近。"],0,102,"宋"],["句","皮公弼","残句",["壁山老守似僧家，无酒无歌度岁华。"],0,173,"宋"],["句","罗处约","残句",["无风烟焰直。","日移竹影侵棋局。"],0,68,"宋"],["句","老郎官","残句",["下观扬子小。","猿啼旅思凄。"],0,203,"宋"],["句","能长老","残句",["僧家祗合在深山。","待到黄龙鳞甲备。"],0,173,"宋"],["句","赵世长","残句",["玉清仙子下云逵。","莫恨东风剪拂迟。"],0,110,"宋"],null,["句","邵迎","残句",["盐豉调羹金液腻，橙斋荐鲙玉丝肥。"],0,221,"宋"],["句","释简长","残句",["烟垒沉寒笛，霜空击怒雕。"],0,54,"宋"],["句","魏几","残句",["半白在梨花，"],0,149,"宋"],["句","黄仲本","残句",["丁宁莫被催科扰。","好把丹衷为上倾。"],0,206,"宋"],["句","黄元靓","残句",["各人自扫门前雪，休管他人瓦上霜。"],0,169,"宋"]]