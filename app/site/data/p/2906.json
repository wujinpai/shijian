[["丞相王舒公赞","杨杰","四言",["天子元老，坐而论道。","赫赫具瞻，傅岩惟肖。"],0,102,"宋"],["熙宁亲享明堂二首 其二 酌献用《德安》。","郊庙朝会歌辞","四言",["英声迈古，德施在民。","允秩宗祀，宾延上神。"],0,"x207","宋"],["绍兴二十八年祀圜丘 彻豆用《熙安》。","郊庙朝会歌辞","四言",["燎芗既升，焫膋以洁。","于豆于登，焄蒿有𫗣。","紫幄𤈶黄，神其安悦。","将以庆成，薄言盍彻。"],0,"x207","宋"],["淳熙十二年加上太上皇帝太上皇后尊号十一首 其九 皇帝从太上皇后册宝诣宫中用《正安》。","郊庙朝会歌辞","四言",["大矣母慈，德备且纯。","思古齐敬，佐我皇文。","明章茂典，金玉其音。","帝亲奉之，以翼以钦。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 黑帝酌献用《祐安》。","郊庙朝会歌辞","四言",["赫赫神游，周流八极。","德馨上闻，于焉来格。","不腆酒醴，用伸悃愊。","神其歆之，民用向德。"],0,"x207","宋"],["绍兴享先农十一首 其十 彻豆用《歆安》。","郊庙朝会歌辞","四言",["莫重于祭，非礼不成。","笾豆有践，尔殽既馨。","神具醉止，荐以齐明。","赞彻孔时，厘事斯成。"],0,"x207","宋"],null,["雨师雷神七首 其四 雨师位酌献用《雍安》。","郊庙朝会歌辞","四言",["山川出云，裔裔而缕。","载霪载蒙，其德乃溥。","自古有年，胡然莫祖。","无简我觞，无怠我俎。"],0,"x207","宋"],["魏京诗 其十一","刘敞","四言",["或献其宝，或请其命。","帝振于旅，惟时既定。"],0,"x51","宋"],["进仰山瑞禾诗宋大雅十三章  其一一","张商英","四言",["一本之上，双茎相向。","穗叶敷荣，挺拔寻丈。"],0,116,"宋"],["纳火祀大辰十二首 升殿用《正安》。","郊庙朝会歌辞","四言",["猗与明坛，右平左墄。","冕服斯皇，玉佩有节。","陟降惟寅，匪徐匪疾。","式崇大祀，礼文咸秩。"],0,"x207","宋"],["至和祫享三首 其三 送神用《兴安》。","郊庙朝会歌辞","四言",["四祖基庆，三后在天。","荐侑备成，灵娭其旋。","孝孙应嘏，受福永年。","送之怀之，明发恻然。"],0,"x207","宋"],["高宗祀明堂前朝享太庙二十一首 其三 盥洗用《干安》。","郊庙朝会歌辞","四言",["于皇维后，观盥之初。","精意昭著，既顺既愉。","圭鬯承祀，卿士咸趋。","目视心化，四方其孚。"],0,"x207","宋"],["熙宁以后祀高禖六首 其三 奠玉币用《嘉安》。","郊庙朝会歌辞","四言",["昔帝高辛，先禖肇祀。","爰揆仲阳，式祈嘉祉。","陈之牺牲，授以弓矢。","敷祐皇宗，施于孙子。"],0,"x207","宋"],["干德以后祀感生帝十首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["大君有命，祀典咸修。","荐献式叙，淑慎优柔。"],0,"x207","宋"],null,["鶑鸣十章寄戚伯瑞  其七","彭龟年","四言",["静观物理，式感我思。","有风凄兮，吹我裳衣。"],0,223,"宋"],["魏京诗 其十四","刘敞","四言",["皇曰卿士，圣考之德。","允于孝思，孝思惟则。"],0,"x51","宋"],["绣释迦像并十八罗汉赞 第一宾度罗跋啰堕阇尊者","惠洪","四言",["霜筠雪竹，石磴下安。","青猊妥尾，徐行仰看。","师则跏趺，顾视空几。","吐词如雷，侍者无耳。"],0,"x42","宋"],["次徐径坂四言韵 其一","赵汝腾","四言",["攲枕肱曲，匮藏美玉。","造道高深，庭草交绿。"],0,47,"宋"],["绍兴十年发皇太后册宝八首 其六 太傅奉册授提点官用《礼安》。","郊庙朝会歌辞","四言",["孝奉天仪，信维休德。","发越徽音，礼文靡忒。","永保嘉祥，时万时亿。","归于东朝，含饴燕息。"],0,"x207","宋"],["绍兴十年发皇太后册宝八首 其七 太傅奉册授提点官用《礼安》。","郊庙朝会歌辞","四言",["肃雍长乐，克笃其庆。","河洲茂德，沙麓启圣。","是生睿哲，蚤隆丕运。","钦称鸿宝，永膺天命。"],0,"x207","宋"],["皇后庙十五首 其一 迎神用《肃安》。","郊庙朝会歌辞","四言",["閟宫翼翼，雅乐洋洋。","牲器肃设，几筵用张。","饰以明备，秩其令芳。","神兮来格，风动云翔。"],0,"x207","宋"],["绍兴祀皇地祇十五首 亚、终献用《文安》。","郊庙朝会歌辞","四言",["礼有祈报，国惟典常。","笾豆丰洁，降升齐庄。","备物致志，式荐累觞。","昭格来享，自天降康。"],0,"x207","宋"],["汾阴十首 其六 太宗配坐酌献用《博安》。","郊庙朝会歌辞","四言",["报功厚载，祀事惟明。","思文烈考，道济群生。","侑神定位，协德安平。","馨洁并荐，享于克诚。"],0,"x207","宋"],["吕洞宾赞","李昴英","四言",["碧其风巾，皓其云袍。","六合飞遨，仙中之豪。"],0,124,"宋"],["绍兴祈谷三首 其三 太宗位酌献用《德安》。","郊庙朝会歌辞","四言",["天锡勇智，允惟太宗。","功隆德盛，与帝比崇。","礼严陟配，诚达精衷。","尚其锡祉，岁以屡丰。"],0,"x207","宋"],["大观宗祀明堂五首 配位酌献用《大明》。","郊庙朝会歌辞","四言",["于昭皇考，大明体神。","宪章文思，宜民宜人。","严父之道，陟配于天。","躬行孝告，有孚于先。"],0,"x207","宋"],["进仰山瑞禾诗宋大雅十三章  其二","张商英","四言",["岁在庚辰，利见大人。","十有二祀，而纪庚寅。","乾坤六子，遇庚则新。","大人法天，有革有因。"],0,116,"宋"],["绍兴祀神州地祇十六首 神州地祇位酌献用《嘉安》。","郊庙朝会歌辞","四言",["恭承明祀，嘉荐令芳。","亦有桂酒，诚悫是将。","瑟瓒以酌，效欢厥觞。","庶乎燕享，永怀不忘。"],0,"x207","宋"],["绍兴别庙乐歌五首 其二 奉俎用《肃安》。","郊庙朝会歌辞","四言",["肇严庙祀，爰图遗芳。","物必称德，或陈或将。","有缛其仪，有苾其香。","灵兮来下，割烹是尝。"],0,"x207","宋"],["张安国东坡三养帖赞","岳珂","四言",["在易之颐，饮食以节。","推而广之，有是三说。","蒸壶发羃，衰发满帻。","机赤乳白，未死神泣。","万金之璧，护一蚁缺。","彼过分者，于我何得。","昔传者诗，今见者帖。","昔以事戒，今以理悦。","吁嗟先生，何学非易。","称此翰墨，是谓知德。"],0,"x202","宋"],["绍兴十年发皇太后册宝八首 其四 太傅奉册宝出门用《圣安》。","郊庙朝会歌辞","四言",["肃肃东朝，帝隆孝治。","猗欤丕称，宝册斯备。","皇扉四辟，导迎庆瑞。","德迈太任，有周卜世。"],0,"x207","宋"],null,["颂古九十八首 其七十四","释印肃","四言",["道人到处，全示真如。","若求言句，未免区区。"],0,"x121","宋"],["皇帝上尊号一首 册宝入门用《正安》。","郊庙朝会歌辞","四言",["于穆元后，天临紫宸。","飞緌星拱，建羽林芬。","徽册是奉，鸿名愈新。","荷兹介祉，永永无垠。"],0,"x207","宋"],["正月一日皇帝御大庆殿受文武百僚朝贺行上寿之仪乐章曲名 皇帝举第三盏酒奏甘露之曲","苏颂","四言",["泫泫零露，云英醴液。","和气凝津，流甘委白。","饴泛柈杯，珠联竹柏。","天不爱道，圣功允格。"],0,"x85","宋"],["咸平亲郊八首 其六 饮福用《禧安》","郊庙朝会歌辞","四言",["祀帝圜丘，九州献力。","礼行于郊，百神受职。","灵祗格思，享我明德。","天鉴孔章，玄祉昭锡。"],0,"x207","宋"],["绍兴以后时享二十五首 孝宗室用《大伦》。","郊庙朝会歌辞","四言",["圣人之德，无加于孝。","思皇孝宗，履行立教。","始终纯诚，非曰笑貌。","于万斯年，是则是效。"],0,"x207","宋"],["绍兴亲享明堂二十六首 其二十 终献用《穆安》。","郊庙朝会歌辞","四言",["诚一为专，礼三而称。","孰陪邦祠，惟我同姓。","金丝屡调，圭玉交映。","是谓熙成，福来神听。"],0,"x207","宋"],["绍兴祀神州地祇十六首 神州地祇位奠玉币用《嘉安》。","郊庙朝会歌辞","四言",["璇玑谐序，籍敛荐嘉。","昭答柔祇，迭奏雅歌。","币琮以侑，仪腆气和。","灵其溥临，容与燕嘉。"],0,"x207","宋"],["高宗郊祀前朝享太庙三十首 其十四 英宗室用《治隆》。","郊庙朝会歌辞","四言",["穆穆英宗，持盈守成。","世德作求，是缵是承。","齐家睦族，偃武恢文。","于荐清酤，酌之欣欣。"],0,"x207","宋"],["绍兴享先农十一首 其八 终献用《正安》。","郊庙朝会歌辞","四言",["殽核维旅，酒醴维馨。","于再于三，礼则有成。"],0,"x207","宋"],["绍兴祀岳镇海渎四十三首 其三十八 北岳位酌献用《成安》。","郊庙朝会歌辞","四言",["瞻彼芒芒，曰北之常。","既高既厚，乃纪乃纲。","荐鬯伊始，灵示孔将。","玄服铁驾，览此下方。"],0,"x207","宋"],["汾阴十首 其四 后土地祇坐酌献用《博安》。","郊庙朝会歌辞","四言",["秉阴成德，敏树宣功。","应变审谛，神力无穷。","沈潜刚克，流谦示中。","洁兹奠献，妙物玄通。"],0,"x207","宋"],null,["高宗郊祀前朝享太庙三十首 其二十七 尚书彻豆用《丰安》。","郊庙朝会歌辞","四言",["熙事既成，嘉笾告彻。","洋洋来临，蔼蔼布列。","配帝其功，在天对越。","允集丛厘，万邦和悦。"],0,"x207","宋"],["绍兴祀九宫贵神十首 初献升坛用《正安》。","郊庙朝会歌辞","四言",["于昭毖祀，周旋有容。","历阶将事，趋进鞠躬。","改步如初，没阶弥恭。","左墄右平，陟降雍雍。"],0,"x207","宋"],["进仰山瑞禾诗宋大雅十三章  其七","张商英","四言",["乃疏禁网，及释青枉。","流徒赐还，鹿解禽放。","戴恩和顺，涵泳旷荡。","父子怡怡，朋友交饷。"],0,116,"宋"],["咸平亲郊八首 其七 亚献、终献用《正安》。","郊庙朝会歌辞","四言",["羽籥云罢，干戚载扬。","接神有恪，锡羡无疆。"],0,"x207","宋"],null,["兵部尚书孙公","《靖康小雅》作者","四言",["巍巍孙公，忠烈俱伟。","受天大任，渊渟山峙。","谋谟密宥，帝所眷倚。","付以留钥，又托以子。","天未悔祸，甘赴万死。","国家德泽，周及远迩。","罹兹祸变，孰奋而起。","公节不渝，独负大美。","若神人然，众所仰止。","彼以偷生，徒奄如鬼。"],0,91,"宋"],["建隆以来祀享太庙十六首 其十二 太宗室用《大盛》。","郊庙朝会歌辞","四言",["赫赫皇运，明明太宗。","四隩咸暨，一变时雍。","睿文炳焕，圣德温恭。","千龄万祀，永播笙镛。"],0,"x207","宋"],null,["纳火祀大辰十二首 送神用《理安》。","郊庙朝会歌辞","四言",["神灵降鉴，天地回旋。","惟馨荐矣，既醉歆焉。","诸宰斯彻，式礼莫愆。","𬯎祉降祥，天子万年。"],0,"x207","宋"],["题郑子真画四季诗意 其二","白珽","四言",["莲叶吹香，澹澹扁舟。","撑港斜斜，惊散一行。","白鹭西风，卷起梨花。"],0,27,"宋"],["大观祀武成王一首 酌献用《成安》。","郊庙朝会歌辞","四言",["凉彼周王，君臣相遇。","终谋其成，诸侯来许。","洋洋神灵，尊载酒醑。","新声为侑，笙箫备举。"],0,"x207","宋"],["建隆以来祀享太庙十六首 其四 又用《驯象》。","郊庙朝会歌辞","四言",["嘉彼驯象，来归帝乡。","南州毓质，中区效祥。","仁格巨兽，德柔遐荒。","有感斯应，神化无方。"],0,"x207","宋"],["元符祀感生帝五首 其二 初献升降用《保安》。","郊庙朝会歌辞","四言",["冕旒俨若，步武有容。","公卿济济，韶頀邕邕。"],0,"x207","宋"],["绍兴祀祚德庙八首 其八 送神用《凝安》。","郊庙朝会歌辞","四言",["礼乐云备，毕觞尔神。","翊翊音送，轙舆若闻。","驾言归兮，灵斿结云。","祚我千亿，介福来臻。"],0,"x207","宋"],["偈颂九十三首 其一","释梵琮","四言",["直进直出，直行直用。","瞥转玄关，百发百中。"],0,100,"宋"],["景灵宫奉册宝一首 《登安之曲》。","郊庙朝会歌辞","四言",["穆穆真宗，锡羡蕃昌。","飙轮临贶，谆诲洞彰。","虔崇懿号，祗答景祥。","至诚致享，降福无疆。"],0,"x207","宋"],null,["绍兴以后祀感生帝十六首 升殿用《保安》。","郊庙朝会歌辞","四言",["三阳交泰，日新惟良。","大建厥祀，兹报兴王。","礼严陟降，德荐馨香。","聿怀嘉庆，降福穰穰。"],0,"x207","宋"],["绍兴祀大火十二首 升殿用《正安》。","郊庙朝会歌辞","四言",["有俨其容，有洁其衷。","屹屹崇坛，伊神与通。","神肯降格，嘉神之休。","虔恭降登，神乎安留。"],0,"x207","宋"],null,["绍兴以后蜡祭四十二首 送神用《成安》。","郊庙朝会歌辞","四言",["卒爵乐阕，礼仪告备。","神保聿归，敢以辞致。","顺成之方，其蜡乃通。","自今以始，八方攸同。"],0,"x207","宋"],["绍兴以后蜡祭四十二首 送神用《成安》。","郊庙朝会歌辞","四言",["灵之来兮，虬龙沓沓。","下土光景，凭陵阊阖。","灵之旋兮，羽卫委蛇。","偃蹇高骧，遗此蕃厘。"],0,"x207","宋"],["绍兴祀大火十二首 送神用《理安》。","郊庙朝会歌辞","四言",["登降上下，奠璧献斝。","音送粥粥，礼无违者。","已虞至旦，神其将归。","顾我国家，遗以繁厘。"],0,"x207","宋"],["熙宁蜡祭十三首 其十三 送神用《成安》。","郊庙朝会歌辞","四言",["嘉荐芳美，灵来宴娭。","斿车结云，若风马驰。","既至而喜，锡我蕃禧。","嘉承天贶，曼寿无期。"],0,"x207","宋"],["绍兴十年发皇太后册宝八首 其五 太傅奉册宝入门用《圣安》。","郊庙朝会歌辞","四言",["静顺坤仪，圣神是育。","懿铄昭陈，镂文华玉。","乐奏既备，礼仪不渎。","导迎善祥，翟车归毣。"],0,"x207","宋"],["高宗郊前朝献景灵宫二十一首 其十三 文舞退、武舞进用《正安》。","郊庙朝会歌辞","四言",["于皇乐舞，进旅退旅。","一弛一张，笙磬具举。","岂惟玩声，象德是似。","神鉴孔昭，福禄来予。"],0,"x207","宋"],["正月一日皇帝御大庆殿受文武百僚朝贺行上寿之仪乐章曲名 皇帝举第一盏酒奏灵芝之曲","苏颂","四言",["嘉瑞降灵，应我皇德。","烨烨神芝，不根而植。","春秋三秀，昼夜五色。","物播诗歌，声被金石。"],0,"x85","宋"],["干德以后祀感生帝十首 酌献用《崇安》。","郊庙朝会歌辞","四言",["乐调凤律，酒浥牺尊。","至灵斯御，盛德弥敦。"],0,"x207","宋"],["绍兴亲享明堂二十六首 其十八 文舞退、武舞进用《穆安》。","郊庙朝会歌辞","四言",["神之歘至，庆阴杳冥。","风马云车，恍若有承。","备形声容，于昭文明。","庶几嘉虞，来享来宁。"],0,"x207","宋"],["绍兴享先农十一首 其一 皇帝入内壝盥洗用《隆安》。","郊庙朝会歌辞","四言",["大事在祀，齐洁为先。","既盥而升，奉以周旋。","下观而化，无敢不蠲。","惟神降格，监厥精虔。"],0,"x207","宋"],["宁宗朝享三十五首 高宗室用《大德》。","郊庙朝会歌辞","四言",["昊天有命，中兴复古。","治定功成，修文偃武。","德隆商宗，业闳汉祖。","付托得人，系尧之绪。"],0,"x207","宋"],["干德以后祀感生帝十首 奉俎用《咸安》。","郊庙朝会歌辞","四言",["俎实具列，明德惟馨。","肃容祗荐，神其降灵。"],0,"x207","宋"],["绍兴亲享明堂二十六首 其十六 徽宗位酌献用《成安》。","郊庙朝会歌辞","四言",["钦惟合宫，承神至尊。","祗戒专精，俨然若存。","奠兹嘉觞，茝兰其芬。","发祉𬯎祥，以子以孙。"],0,"x207","宋"],["绍兴淳熙分命馆职定撰十七首 升殿用《正安》。","郊庙朝会歌辞","四言",["皇祖配帝，岁祀明堂。","冕服陟降，玉佩玱玱。","疾徐有节，进止克庄。","维时右享，日靖四方。"],0,"x207","宋"],["摄事十三首 酌献僖祖室用《大善》。","郊庙朝会歌辞","四言",["肃肃艺祖，肇基鸿源。","权舆光大，燕翼贻孙。","载祀惟永，庆流后昆。","威灵在天，顾我思存。"],0,"x207","宋"],["青峰诗帖赞","岳珂","四言",["心潜书法，神造诗境。","予意是时，万念俱屏。","乐非外骛，自得隽永。","坐令尘埃，顿发深省。"],0,"x202","宋"],["景祐孟冬祭神州地祇二首 其二 酌献用《韶安》。","郊庙朝会歌辞","四言",["有炜弥文，克隆宏构。","贻此燕谋，具膺多祐。","嶰律吹莩，彝尊奠酒。","佐乃沈潜，永祈丰楙。"],0,"x207","宋"],["景德蜡祭百神三首 其二 奠玉币、酌献用《嘉安》。","郊庙朝会歌辞","四言",["肃肃灵坛，昭昭上天。","洁粢丰盛，以享以虔。","百神咸萃，六乐斯县。","介兹景福，期于有年。"],0,"x207","宋"],["张公寿求赞","释清远","四言",["首到东山，晚亲龙岫。","岁经寒暑，人非新旧。","涂毒长鸣，优昙勿嗅。","静对终日，弟子公寿。"],0,116,"宋"],["绍兴二十八年祀圜丘 降坛用《干安》。","郊庙朝会歌辞","四言",["躬展盛仪，天步逡巡。","乐备礼交，嘉玉既陈。","神方安坐，荐祉纷纶。","陟降有容，皇心载勤。"],0,"x207","宋"],["景德中朝会十四首 皇帝升坐用《隆安》。","郊庙朝会歌辞","四言",["金奏在庭，群后在位。","天威煌煌，向明负扆。","高拱穆清，弁冕端委。","盛德日新，礼容有炜。"],0,"x207","宋"],["鉴达观画像赞","王庭珪","四言",["寂然其容，万法不起。","色固无求，不怒不喜。","人自即之，其门如市。","忽然探囊，辄起人死。","本自无生，死亦何理。","公能起之，如月在水。","应物现形，本无作止。","我复赞之，亦游戏耳。"],0,"x198","宋"],["绍兴亲享明堂二十六首 其九 徽宗位奠币用《泰安》。","郊庙朝会歌辞","四言",["于穆帝临，至矣元造。","克配其仪，惟我文考。","仁恩广覃，奕叶永保。","宗祀惟初，以扬孝道。"],0,"x207","宋"],["景祐夏至祀皇地祇二首 其二 酌献用《英安》。","郊庙朝会歌辞","四言",["丕命惟皇，万物咸睹。","卜年迈周，崇功冠禹。","有烨炎精，大昌圣祚。","酌鬯祈年，永锡繁祜。"],0,"x207","宋"],["淳化中朝会二十三首 五举酒用《瑞麦》。","郊庙朝会歌辞","四言",["芃芃嘉麦，擢秀分岐。","甘露夕洒，惠风晨吹。","良农告瑞，循吏称奇。","归美英主，折而贡之。"],0,"x207","宋"],["哲宗上太皇太后册宝五首 其二 降坐用《干安》。","郊庙朝会歌辞","四言",["皇帝仁孝，总临万方。","褒显其亲，日严以庄。","龙衮翼翼，玉书煌煌。","传之亿世，休有烈光。"],0,"x207","宋"],["哲宗上太皇太后册宝五首 其四 降坐用《干安》。","郊庙朝会歌辞","四言",["涂山之德，渭涘之祥。","图徽宝册，玉色金相。","管弦烨煜，钟鼓喤喤。","天之所启，既寿而昌。"],0,"x207","宋"],["建隆以来祀享太庙十六首 饮福用《禧安》。","郊庙朝会歌辞","四言",["嘉粟旨酒，博腯牲牷。","神鉴孔昭，享兹吉蠲。","夙夜毖祀，孝以奉先。","永锡纯嘏，功格于天。"],0,"x207","宋"],["高宗郊祀前朝享太庙三十首 其十二 真宗室用《熙文》。","郊庙朝会歌辞","四言",["思文真宗，体道之崇。","憺威赫灵，遵制扬功。","真符鼎来，告成登封。","盛德百世，于昭无穷。"],0,"x207","宋"],["大晟府拟撰释奠十四首 初献盥洗用《同安》。","郊庙朝会歌辞","四言",["右文兴化，宪古师经。","明祀有典，吉日惟丁。","丰牺在俎，雅奏在庭。","周旋陟降，福祉是膺。"],0,"x207","宋"],["题郑子真画四季诗意 其一","白珽","四言",["红杏绿杨，永昼野服。","柴门散仙，莫道无人。","知处东风，都在吟笺。"],0,27,"宋"],["郊祀乐章 皇帝还大次宫架奏黄钟宫憩安之曲","崔敦诗","四言",["应天以实，已事而踆。","毡案朝帝，竹宫拜神。","灵光下烛，协气斯陈。","神禄时万，基图日新。"],0,93,"宋"],["高宗郊祀前朝享太庙三十首 其十一 太宗室用《大定》。","郊庙朝会歌辞","四言",["皇矣太宗，嗣服平成。","益奋神旅，再征不庭。","文武秉德，仁孝克明。","以圣传圣，对越紫清。"],0,"x207","宋"],["绍兴以后祀五方帝六十首 高阳氏酌献用《祐安》。","郊庙朝会歌辞","四言",["十月纳禾，民务藏盖。","不有神休，民罔攸赖。","孟冬之吉，礼行不昧。","神降百祥，昭著蓍蔡。"],0,"x207","宋"]]