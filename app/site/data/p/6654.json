[["梦中作","吴与弼","四言",["烟消雾散，海阔天高。","历块过都，乃见尔曹。"],0,"x302","明"],["短歌行","于慎行","四言",["对酒当歌，朱颜未酡。","日月其除，不乐奈何。","周道茫茫，辟如羊肠。","葆身藏名，唯有醉乡。","阴木贞心，烈士苦颜。","微子之故，胡为永叹。","海水知寒，山石知雨。","忧来攻中，谁当告语。","河之悠悠，欲济无梁。","率彼旷野，霜露沾裳。","斮桂为橑，葺兰为宇。","美人不来，吾谁与处。"],0,"x303","明"],["善哉行","于慎行","四言",["秋风萧萧，白露为霜。","今日相欢，胡不尽觞。","游彼三山，绛阙煌煌。","道逢安朝，授我要方。","采苓采苓，于彼高冈。","日暮天寒，风吹我裳。","群鸟夜鸣，虎豹纵横。","踌蹰四顾，郁何芒芒。","白鹄晨号，在彼中阿。","啸匹不得，伤如之何。","东方渐高，明星没河。","毋复相思，沉吟啸歌。"],0,"x303","明"],["独漉篇","于慎行","四言",["独漉独漉，山深水曲。","水曲回桡，山深折轴。","黄鹄高飞，横绝四极。","欲往从之，恨无羽翼。","转蓬离根，随风飞翻。","游子不归，慆此华年。","骐骥不驾，谁别逸足。","璞石不分，谁知良玉。","利剑在掌，可以割犀。","全身忘国，安用臣为。","龙欲上天，势须浮云。","岂无蹇修，不可以群。"],0,"x303","明"],["题松柏同春卷","李之世","四言",["陟彼高冈，松柏楚楚。","于日于朝，以风以雨。","日月之行，荡乎其中。","山川喷薄，不出其所。","根盘太古，苍鬣虬枝。","洗髓泬漻，濯魄玄夷。","白云在天，红日在地。","精灵出没，与之游戏。","二仪一象，四气唯春。","松耶柏耶，后众卉存。"],0,"x305","明"],["和泂酌亭诗","李之世","四言",["往来井井，于彼于兹。","众口如瓶，曷辨渑淄。","一土攸生，厥味莫齐。","舌司鉴衡，匪曰泉私。","清圣浊贤，君子是仪。","既好其辨，爰系之诗。"],0,"x305","明"],["和观棋","李之世","四言",["登岸造极，筑基累址。","义取其争，和不为美。","设险似兵，坐隐若士。","雌雄未分，黑白唯二。","投鞭断流，探穴取子。","袖手徒观，当局忘味。","惊矢落雕，游丝系鲤。","制胜以谋，纵擒在指。","败还自葺，胜勿浪喜。","艺之云乎，道如斯耳。"],0,"x305","明"],["久旱悯农因和停云 其一","李之世","四言",["停云薄空，有风无雨。","欲叩帝阍，祝融伊阻。","三春云迈，良辰空抚。","孰捣龙宫，操豚是伫。"],0,"x305","明"],["久旱悯农因和停云 其二","李之世","四言",["西郊作云，厥气冥蒙。","有赫震雷，倒岳掀江。","掩耳避之，闭户塞窗。","天意叵测，莫之适从。"],0,"x305","明"],["久旱悯农因和停云 其三","李之世","四言",["眷彼良苗，悴不再荣。","哀哀孑遗，嘿轸余情。","祠川祷岳，岂惮宵征。","昊天不恤，不如靡生。"],0,"x305","明"],["久旱悯农因和停云 其四","李之世","四言",["液不荣根，叶辞其柯。","民之不禄，孰沴天和。","及此降霖，获少丧多。","其复不尔，嗟嗟民何。"],0,"x305","明"],["和劝农 其一","李之世","四言",["天沃尔土，不敕尔民。","一耕三食，劳逸谁真。","三时弗若，兵馑相因。","劝尔务农，自利利人。"],0,"x305","明"],["和劝农 其二","李之世","四言",["市利莫争，艺我黍稷。","金贱谷贵，贷不可殖。","驱此劳民，以稼以穑。","地产明珠，饥不可食。"],0,"x305","明"],["和劝农 其三","李之世","四言",["天祻尔琼，珍饶川陆。","地发秘奇，民破淳穆。","惰农弗耕，奸贾利逐。","环琼百室，舂粮不宿。"],0,"x305","明"],["和劝农 其四","李之世","四言",["积玉堆金，家弗可久。","上智明农，相戒其偶。","坊市勿嬉，并力南亩。","农亦有闲，不为游手。"],0,"x305","明"],["和劝农 其五","李之世","四言",["谋食有方，务本不匮。","纵不逢年，勤则有冀。","物岂余悭，唯力弗至。","耕凿嬉游，帝力何愧。"],0,"x305","明"],["和劝农 其六","李之世","四言",["垦我疆场，拓我边鄙。","无地不毛，唯亩是履。","既登嘉谷，盈箱溢轨。","伏腊鸡豚，酒浓肴美。"],0,"x305","明"],["白云谣","李孙宸","四言",["白云西垂，罡风在耳。","东土悠远，陵谷间之。","将子复来，桃熟为期。"],0,"x308","明"],["短歌行","李孙宸","四言",["嘉宾在堂，旨酒盈觞。","何以乐之，鼓瑟吹簧。","衣不如新，乃有布素。","子有新人，莫忘其故。","高高者天，明明者月。","忧心殷殷，不可以说。","鸣鹤在阴，其子和之。","有美一人，寤寐求之。","鸟乐同材，鱼乐同渊。","与子交亲，可以年年。"],0,"x308","明"],["艾如张","朱诚泳","四言",["艾如张罗，黄雀几多。","雀乃高飞，其如雀何。","大雀善惊，黄口贪食。","虞人张罗，于彼路侧。","黄雀头颅，嗟谁与惜。"],0,"x310","明"],["赞十四首 其一 悯祖","朱诚泳","四言",["赳赳仪容，桓桓英武。","出甲陇西，散其部伍。","心拱北辰，威镇西土。","肇造秦邦，为我始祖。"],0,"x310","明"],["赞十四首 其二 悯祖妃邓氏","朱诚泳","四言",["堂堂世胄，曰惟宁河。","姿容严重，佐理中和。","邑姜媲美，太姒同科。","配我始祖，耿耿不磨。"],0,"x310","明"],["赞十四首 其三 隐祖","朱诚泳","四言",["仪容丰伟，性行修洁。","震若雷霆，皎如冰雪。","持已谨严，维藩卓越。","维我隐祖，天潢之杰。"],0,"x310","明"],["赞十四首 其四 隐祖妃刘氏","朱诚泳","四言",["天生淑质，世阀元勋。","中心乐善，内助惟勤。","贤声洋溢，令德彰闻。","佐我隐祖，百世腾芬。"],0,"x310","明"],["赞十四首 其五 夫人唐氏","朱诚泳","四言",["明明隐祖，允赖匡襄。","笃生国嗣，曰怀曰康。","宗枝蕃衍，奕叶隆昌。","夫人之泽，地久天长。"],0,"x310","明"],["赞十四首 其六 僖祖","朱诚泳","四言",["兢兢持已，翼翼小心。","靡奢靡纵，不骄不淫。","夙成令德，早著徽音。","天夺之速，千古沉沉。"],0,"x310","明"],["赞十四首 其七 怀祖","朱诚泳","四言",["天姿开爽，性质刚明。","雅音允协，巧思层生。","藩维之表，宗室之英。","惜乎短折，谥称其情。"],0,"x310","明"],["赞十四首 其八 怀祖妃张氏","朱诚泳","四言",["天挺幽姿，配我怀祖。","九死不移，终身一姥。","烈日严霜，中流砥柱。","寿考令德，名垂千古。"],0,"x310","明"],["赞十四首 其九 康祖","朱诚泳","四言",["天姿英毅，至性刚方。","敦崇儒术，雅尚词章。","臣工震肃，礼乐铺张。","维我康祖，于秦有光。"],0,"x310","明"],["赞十四首 其十 康祖妃陈氏","朱诚泳","四言",["具备德容，博通书史。","纲纪宫闱，教育孙子。","相我祖王，实周任姒。","于万斯年，永赖馀祉。"],0,"x310","明"],["赞十四首 其十一 惠考","朱诚泳","四言",["猗欤昭考，肫肫其仁。","有如时雨，有若阳春。","德音秩秩，文质彬彬。","爱人好予，宠谥维新。"],0,"x310","明"],["赞十四首 其十二 惠考妃王氏","朱诚泳","四言",["早膺封册，相我先王。","寿虽不永，名亦斯彰。","仪容如在，传诵不忘。","于穆清庙，同享烝尝。"],0,"x310","明"],["赞十四首 其十三 母妃杨氏","朱诚泳","四言",["天姿贞淑，懿德慈良。","山川毓秀，宫壸腾光。","生我育我，为君为王。","褒赠自天，永荷吾皇。"],0,"x310","明"],["赞十四首 其十四 惠考继妃嵇氏","朱诚泳","四言",["粤膺妙选，继佐先王。","宠颁册命，恩礼殊常。","尊崇二纪，宫壸重光。","四旬薨逝，附葬原冈。"],0,"x310","明"],["南山有椿颂寿胡廷慎父母 其一","张宁","四言",["南山有椿，其本秩秩。","有美哲人，德音藉藉。","南山有椿，其叶穰穰。","有美哲人，其福洋洋。","哲人之配，如兄弟矣。","天监定尔，俾偕老矣。","哲人之彻，克世德兮。","帝督不忘，胥将赉兮。","百禄是集，万寿是锡。","如冈如陵，永保皇极。"],0,"x315","明"],["南山有椿颂寿胡廷慎父母 其二","张宁","四言",["北堂有萱，净闿斯植。","乐只君子，柔贞惟一。","北堂有萱，雨露其滋。","乐只君子，寿考维祺。","凤之鸣矣，凰式和止。","既安且宁，家室固止。","子之生也，母式教之。","如圭如璋，显克肖之。","百禄是迓，万寿是介。","如冈如陵，夫子是载。"],0,"x315","明"],["鸣鹿颂","张宁","四言",["鹿鸣呦呦，于山之幽。","载背载呼，言善其俦。","维体泽泽，维角戢戢。","匪外之防，维内之则。","相彼麟凰，寔郊寔薮。","释是町疃，乐此灵囿。","以礼为罗，以爵为縻。","匪罗匪縻，周行之归。","展也佳宾，胡不云来。","式燕以遨，乐只有仪。","文王不已，惠然来思。"],0,"x315","明"],["六礼有将式克语之三加有辞式克御之死丧之威翕共与之饮食言笑肃慎祇之增增来仍式谷以之毋俾此邦不竞谓之 其一","张宁","四言",["伊厥肇基，实既于强。","不腆后人，孰搆孰堂。","骏美弗传，忧心京京。","载服于田，载艺于桑。","亦有良朋，于橐于囊。","硕果不食，先业用光。"],0,"x315","明"],["六礼有将式克语之三加有辞式克御之死丧之威翕共与之饮食言笑肃慎祇之增增来仍式谷以之毋俾此邦不竞谓之 其二","张宁","四言",["何晦于夕，何著于昕。","举或坠之，事必式因。","毋安于易，毋恤于艰。","念敬尔守，祀事孔陈。","先公有言，予岂不闻。","冥冥积德，在我后人。"],0,"x315","明"],["独漉篇","张宁","四言",["独漉独漉，水清泥浊。","清犹可濯，浊则云涸。","鸿雁随阳，载居载翔。","不辑于行，而竞稻粱。","朱弦清琴，轸玉徽金。","逖矣同心，空此好音。","龙剑之合，精光辉熙。","试而无施，不如睽离。","寥寥旷野，以腊以春。","有来斯亲，孰知其人。"],0,"x315","明"],["薤露八章挽沈希仁父","张宁","四言",["萎彼薤斯，零露瀼瀼。","嗟我怀人，于焉徬徨。","萎彼薤斯，零露湛湛。","嗟我怀人，劳心惆怅。","闻古圣善，赙丧助昏。","乃如之人，实获我心。","匪沽则名，中心寔殷。","闻古圣善，简所因兮。","乃如之人，所可征兮。","受言怀之，姑将亲兮。","维凤有毛，维麟有趾。","亶其然乎，善人是予。","维此善人，于彼窀穸。","彼苍者天，胡不尔吊。","翳彼大荒，祝㮚茫茫。","黾勉同心，玄冠绛裳。","绳其归思，我怀则降。","翳彼旷宇，濮铅修阻。","礿祠馨香，宁兹寝处。","绳其格思，无尔嗣苦。"],0,"x315","明"],["古战场","郑善夫","四言",["朝发汾河，暮经白沟。","茫然战场，四时为秋。","黄云阨关，壮士不忧。","拔剑斫地，战骨无收。","风沙冥冥，髑髅啸歌。","鸟飞不下，客行奈何。","世无凰麟，龙虎斗争。","谁哉弄丸，四海解兵。"],0,"x317","明"],["菖歜二章赠孙太初山人","郑善夫","四言",["菖歜葱葱，在彼涧滨。","岁茁九花，世人不纫。","秘之颍谷，以俟云君。","念彼菉葹，苍苍广津。","菖歜青青，在彼原隰。","岁茹九节，可以绝粒。","华滋寂寥，尔乃独立。","世无神皇，凤衰麟泣。"],0,"x317","明"],["野田黄雀行","郑善夫","四言",["翼翼黄雀，集彼榛柯。","上有鸷鸟，下有虞罗。","低飞不可，高飞奈何。","曷不去此，野田有禾。","鹏雏摇摇，隼则制之。","兔罝纤纤，鸿则罹之。","龙潜在渊，可以全身。","壤蠖不屈，何以引伸。","朱凤威垂，稠羽是依。","鸱枭化之，矰弋安施。"],0,"x317","明"],["梁之石操上杨国老","郑善夫","四言",["梁之山兮，岳岳其砥。","石之磐磐，兴云及雨。","肤合之施，其谁弗被。","立天之中，君子不匮。","天常西亏，地亦东溃。","我不尔奠，曷其有位。","大皇时行，大浸时滋。","怀贞用敦，君予以几。"],0,"x317","明"],["梦井歌二章","郑善夫","四言",["井之京京，其出渊渊。","汔至不繘，谓我叵泉。","甃如幕如，我梦乘如。","寤怀载且，维以永戏。","井之渊渊，爰是用汲。","王明王明，受此戬福。","渫而不食，于井何伤。","君子之履，不迁其方。"],0,"x317","明"],["白泉二章赠汪希周","郑善夫","四言",["湔湔流泉，行彼地中。","灿为星宿，丽尔云空。","万殊之母，直遂涵弘。","贲以正本，蒙以养功。","君子果行，丕显其逢。","湔湔流泉，㶁㶁滥觞。","积为江汉，博大以刚。","彼王者明，受福无疆。","神龙所都，厥澍载滂。","君子利用，何往弗臧。"],0,"x317","明"],["驱马五章章五句黄钟清宫","黄佐","四言",["驱马滔滔，遵彼林皋。","匪游以遨，将命靡竣，我心忉忉。","驱马滔滔，戒我徒旅。","匪游以遨，将命靡竣，岂求宁宇。","悠悠彼鳣，载浮载潜。","亦照于潭，将命靡竣，父于何瞻。","离离彼翟，载鸣载飞。","亦集于蓖，将命靡竣，母于何依。","驾彼乘牡，夙夜孔皆。","匪游以遨，念我二人，歌以告怀。"],0,"x318","明"],["彼尔有棠五章章四句黄钟清宫","黄佐","四言",["彼尔有棠，敷贲于稷。","焞焞𬨎车，迈如弗克。","我车徂丘，六辔既柔。","夙夜其勤，爰诹于郊。","我车徂岨，六辔如组。","夙夜其勤，爰谋于野。","我车徂薄，六辔如濯。","夙夜其勤，爰度于国。","我车徂宫，六辔既雍。","夙夜其勤，爰询于公。"],0,"x318","明"],["短歌行送洪子玉方","黄佐","四言",["秋露载晞，朔云云飞。","盍簪讵几，驾言𬴂𬴂。","肃彼前旌，奏此和铃。","风骖翼人，遄如流星。","今夕同堂，明发异乡。","何以别子，骊歌鸾觞。","林疏壑清，山空鸟鸣。","风吹断蓬，与客徂征。","子在在燕，洌洌寒泉。","挠不可浊，其流为川。","子在在浙，寒泉洌洌。","思子如濯，中心孔热。","石田碌碌，逋税斯督。","云谁之故，空其杼柚。","原则有杉，隰则有蓝。","糟糠短褐，饥寒所甘。"],0,"x318","明"],["宫桑闻北郊亲蚕赋 其一","黄佐","四言",["有菀宫桑，遵彼郊场。","其叶扬扬，仓庚载鸣。","扤扤条肄，乃集乃翔。"],0,"x318","明"],["宫桑闻北郊亲蚕赋 其二","黄佐","四言",["有菀宫桑，遵彼郊曲。","其叶维沃，以筐以簇。","以躬杼柚，用成我服。"],0,"x318","明"],["宫桑闻北郊亲蚕赋 其三","黄佐","四言",["毋曰我私，黼裳卷衣。","爰响爰禋，既襄既宜。","父母攸诒，云胡勿思。"],0,"x318","明"],["梧凤朝阳三章","黄佐","四言",["维梧有凤，鸣于朝阳。","言翔于天，其音锵锵。","明哲君子，御此南疆。","维皇眷之，晋锡孔昌。","维梧有凤，朝阳其鸣。","其音嗈嗈，言翔于京。","明哲君子，戎功告成。","逖此南夷，皇心则宁。","梧桐萋萋，朝阳杲杲。","凤鸣高冈，其音载好。","明哲君子，身维保之。","懿兹戎功，皇维焘之。"],0,"x318","明"],["翩翩者鹤贺吴子重闱荣寿三首 其三","黄佐","四言",["翩翩者鹤，鸣于菀林。","其子和之，载好其音。","念我重华，龙光是临。","天子万寿，言慰我心。","有鹤翩翩，鸣于菀柳。","其子从之，亦翯其首。","念我重华，锡此黄耇。","言慰我心，天子万寿。"],0,"x318","明"],["双节旌门诗","黄佐","四言",["明昭我皇，敬跻圣神。","允文允武，无竞惟人。","拔奇夷难，迈德振民。","丕展彝叙，上明下亲。","懿此双节，伯姒叔娣。","姒固称贤，娣以子贵。","教子伊何，敦诗说礼。","出入乌台，表表伟伟。","猗惟萧公，进思尽忠。","巡彼粤西，有奋元戎。","定姜卜征，馘夫之雄。","百战奇法，奏此肤功。","复巡东粤，崇我文教。","表章先儒，是式是效。","孟母励学，永言克孝。","绍衣德言，犹织之懋。","惟皇允武，公则诘之。","匪母之教，征则匪宜。","惟皇允文，公则崇之。","匪母之教，又孰可师。","文武彝德，既曰母教。","贞节昭宣，无德不报。","皇锡德音，旌门有诰。","为世作程，于赫斯耀。"],0,"x318","明"],["招颂补遗九首 其三 浚畎浍","黄佐","四言",["禹决九川，以距四海。","距川伊何，浚兹畎浍。","肇河积石，江岷汉嶓。","济淮入海，渭洛惟河。","其鱼发发，孔庶且有。","既汕于梁，亦获于笱。","播奏庶艰，登彼丘陵。","懋迁有无，化居是营。"],0,"x318","明"],["招颂补遗九首 其五 锡玄圭","黄佐","四言",["禹锡玄圭，告厥成功。","万邦作乂，四海会同。","庶土交正，底慎财赋。","厥贡厥篚，厥包载路。","金石盐𫄨，丝枲织皮。","羽毛齿革，纳锡元龟。","球琳琅玕，玄𫄸玑组。","弼成五服，以修六府。"],0,"x318","明"],["招颂补遗九首 其六 建皇极","黄佐","四言",["建皇之极，六府孔修。","厥动惟时，昭受天休。","帝迪厥德，光天之下。","海隅苍生，永得我所。","凡今黎献，共惟帝臣。","百工俊乂，乃歌卿云。","卿云烂兮，纠缦缦兮。","日月光华，旦复旦兮。"],0,"x318","明"],["招颂补遗九首 其七 明明一终","黄佐","四言",["明明尚天，烂然星陈。","日月光华，弘于一人。","日月有常，星辰有行。","四时顺经，万姓允诚。","于予论乐，配天之灵。","迁于贤圣，莫不咸听。","鼚乎鼓之，轩乎舞之。","精华以竭，褰裳去之。"],0,"x318","明"],["招颂补遗九首 其八 明明二终","黄佐","四言",["明明帝命，八风修通。","地平天成，万世之功。","天下攘攘，为利斯往。","诏尔和钧，与而嘉量。","天下熙熙，为利斯来。","同维审度，以莫不宜。","蟠龙贲信，蛟鱼踊跃。","草木萌生，蜚征咸若。"],0,"x318","明"],["梦中朔风诗三章","黄佐","四言",["朔风萧萧，庭绿葳蕤。","百鸟拚飞，栖宿相随。","君子亲民，安宅在兹。","彼蠢不𬤝，扰敚何为。","萧萧朔风，旖旖庭绿。","百鸟飞拚，于焉栖宿。","君子亲民，为邦建福。","彼蠢有知，归于寿谷。","朔风静矣，庭绿盛矣。","百鸟和鸣，胥自庆矣。","君子亲民，实邦之桢。","彼蠢来归，云胡不宁。"],0,"x318","明"],["麒麟诗","陈琏","四言",["至和储精，麒麟降生。","麇身牛尾，马蹄龙睛。","身备五采，绚烂晶荧。","性尤仁厚，瑞图可征。","不远万里，来自南溟。","祥云瑞霭，光绚阙廷。","出入金门，迩乎龙𫐌。","群臣聚观，喜跃弗胜。","惟昔太祖，天命是膺。","皇风以穆，皇道以贞。","九夷八蛮，莫不来庭。","冲和氤氲，屡致嘉祯。","皇帝嗣位，天下以宁。","仁被动植，泽及含灵。","祯祥沓至，以昭太平。","祥麟之来，适际文明。","惟帝之圣，贞符是承。","有濯厥声，耀于万龄。"],0,"x320","明"],["紫霞泉","陈琏","四言",["一派寒泉，出于山址。","终日清泠，不污泥滓。","伊谁所发，上清仙子。"],0,"x320","明"],["步出夏门行","黄省曾","四言",["步出夏门，登山望海。","峨峨玄圃，茫茫安在。","颓阳悬车，夜光在天。","安得人生，常保少年。","金城之上，十二玉楼。","宁有羽翼，以往遨游。","仙人宁封，曾饵飞鱼。","我非常伯，空思石蕖。","青鸐不鸣，黄河未清。","太平何时，白发巳生。","舜崩苍梧，丘殂东鲁。","古来圣贤，皆入黄土。","秋风鸣条，春花盈树。","时如驷马，超腾不住。","何不鼓瑟，嗟哉此言。","戚戚多悲，强歌无欢。"],0,"x322","明"],["高士颂九十一首 其一 被衣","黄省曾","四言",["大道不凿，至人秀世。","被衣冠出，超然释智。","啮公聆教，无言相契。","畅怿长歌，冥筌排去。"],0,"x322","明"],["高士颂九十一首 其二 王倪","黄省曾","四言",["王倪天士，缺也问道。","育艾尔神，一绵虚抱。","寒暑何侵，风雷弗眊。","大准玄黄，权舆上教。"],0,"x322","明"],["高士颂九十一首 其四 巢父","黄省曾","四言",["巢父鸟栖，弗营栋宇。","由进尘言，严挥不与。","乃临其清，乃洗其耳。","箕颖高风，千龄无巳。"],0,"x322","明"],["高士颂九十一首 其五 许由","黄省曾","四言",["武仲洁修，毫邪不处。","黄屋将归，紫芳高举。","颍汲箕田，羞颓汗鄙。","俎豆公神，绵绵无巳。"],0,"x322","明"],["高士颂九十一首 其六 善卷","黄省曾","四言",["逖矣善卷，君尧北面。","鹿衣牧世，自臻从劝。","虞钦玄德，让之赤县。","贵适心神，永凄荒𪩘。"],0,"x322","明"],["高士颂九十一首 其七 子州支父","黄省曾","四言",["休休支父，道重八埏。","阴寝阳觉，神寂而恬。","巍巍二帝，大器告传。","不遑长谢，缮性自全。"],0,"x322","明"],["高士颂九十一首 其八 壤父","黄省曾","四言",["老父皤发，愉愉壤戏。","吐厥鸣歌，朝兴夕憩。","虚渴咸充，帝焉何利。","醇和未斲，陶哉寓世。"],0,"x322","明"],["高士颂九十一首 其九 石户之农","黄省曾","四言",["虞皇御世，虚咨禅者。","石户之农，至人在野。","天位以干，弃如屣舍。","灭迹沧溟，清踪莫写。"],0,"x322","明"],["高士颂九十一首 其十 蒲衣子","黄省曾","四言",["蒲衣妙纪，德与天侔。","大舜虚襟，模范是求。","发评虞泰，致一马牛。","扰劳民宰，胡可缨留。"],0,"x322","明"],["高士颂九十一首 其十一 披裘公","黄省曾","四言",["负薪炎暑，吴有一翁。","粗𫄨弗御，冒彼蒙茸。","季札相逅，遗拾不从。","姓名终閟，空仰高风。"],0,"x322","明"],["高士颂九十一首 其十二 江上丈人","黄省曾","四言",["丈人遗俗，鼓枻江隈。","楚胥求济，夜乱芦漪。","笑辞星剑，意进鲍鱼。","匆匆诫别，何用名为。"],0,"x322","明"],["高士颂九十一首 其十三 小臣稷","黄省曾","四言",["小臣之稷，微尔齐氓。","巍崖独拔，苦节自贞。","君𫐌数过，聊得瞻迎。","区区管鲍，何足班伦。"],0,"x322","明"],["高士颂九十一首 其十四 弦高","黄省曾","四言",["弦公郑宝，托迹迁贾。","秦穆扬兵，于周邂迕。","矫命犒师，阴抒国祸。","辞赏居夷，飘焉弗顾。"],0,"x322","明"],["高士颂九十一首 其十五 商容","黄省曾","四言",["商容大道，聃也之师。","形将蜕化，教庶琼遗。","三言甚寡，万务何馀。","喜编后授，屡发其规。"],0,"x322","明"],["高士颂九十一首 其十六 老子李耳","黄省曾","四言",["伯阳圣老，人貌天行。","寿经亿代，道冠群生。","龙称礼得，牛候书成。","西关度迹，玄化冥冥。"],0,"x322","明"],["高士颂九十一首 其十七 庚桑楚","黄省曾","四言",["庚桑耳役，画去挈远。","息意三年，风尊翠𪩘。","俎豆不乐，形生自晏。","贤知明扬，世心何浅。"],0,"x322","明"],["高士颂九十一首 其十八 老莱子","黄省曾","四言",["楚莱避纷，蒙阳寄耜。","草宫木榻，水菽怡志。","驾屈楚君，经纶将贻。","内赞遐谋，相携远逝。"],0,"x322","明"],["高士颂九十一首 其二十 荣启期","黄省曾","四言",["荣公何族，弗美身隅。","扬歌郕野，抚弦而嬉。","清言自宽，披吐宣尼。","契天符命，孤引东墟。"],0,"x322","明"],["高士颂九十一首 其二十一 荷蒉","黄省曾","四言",["荷蒉者何，逃名卫地。","宣尼鸣乐，闻音知意。","翩然出讽，比之厉揭。","斯行斯言，果于忘世。"],0,"x322","明"],["高士颂九十一首 其二十二 长沮桀溺","黄省曾","四言",["悠悠沮溺，并耜荒墟。","敬询渡济，暂驻浮车。","飘然无荅，齐口致讥。","物情不足，隐德有馀。"],0,"x322","明"],["高士颂九十一首 其二十三 石门守","黄省曾","四言",["石门门者，阖辟是尸。","仲路宵投，乃询其师。","鲁尼入耳，强仕致讥。","閟光韬彩，百世所希。"],0,"x322","明"],["高士颂九十一首 其二十四 荷筱丈人","黄省曾","四言",["丈人绝轨，倨接洙贤。","天涯日暮，鸡黍是延。","载陈夫子，寻返客辕。","先几扫迹，虚室依然。"],0,"x322","明"],["高士颂九十一首 其二十五 陆通","黄省曾","四言",["接舆厌浊，放隐佯狂。","征罗上士，徙适遐方。","歌衰凤德，车下道傍。","洞天周涉，妙药为粮。"],0,"x322","明"],["高士颂九十一首 其二十六 曾参","黄省曾","四言",["孝哉子舆，领道泗滨。","浩浩之气，常骄大人。","为都不乐，好爵难婴。","单居秘论，传耀千春。"],0,"x322","明"],["高士颂九十一首 其二十七 颜回","黄省曾","四言",["颜氏之子，不怍簟瓢。","心斋白日，志迥青霄。","圃衣田食，大圣游交。","鼓琴蓬荜，可以逍遥。"],0,"x322","明"],["高士颂九十一首 其二十八 原宪","黄省曾","四言",["原生匮盝，室侵风雨。","薄炊经旬，雕裘历纪。","友赐荣华，骖𬴂萃止。","闻剖病贫，终身含耻。"],0,"x322","明"],["高士颂九十一首 其二十九 汉阴丈人","黄省曾","四言",["丈人治圃，搰搰其劳。","赐焉逢觏，进说为槔。","前陈后诘，反复见嘲。","风波全德，私语其曹。"],0,"x322","明"],["高士颂九十一首 其三十 壶丘子林","黄省曾","四言",["至哉壶子，列老下趋。","龙藏郑圃，真与道俱。","侧闻玄语，宣发希微。","载陈生化，继述黄书。"],0,"x322","明"],["高士颂九十一首 其三十一 老商氏","黄省曾","四言",["老商树教，列寇下趋。","居门七载，席始相携。","眼耳都融，叶干忘机。","乘风枯槁，得道而归。"],0,"x322","明"],["高士颂九十一首 其三十二 列御寇","黄省曾","四言",["御寇隐郑，四十馀年。","台衡大馈，顿首拒焉。","麾使悟妻，保体消愆。","𫐌风驻世，表箓蓬仙。"],0,"x322","明"],["高士颂九十一首 其三十三 庄周","黄省曾","四言",["庄周傲世，洸洋寓言。","文穷万妙，学守一玄。","戏游自快，国聘难延。","浩然就尽，弗避乌鸢。"],0,"x322","明"],["高士颂九十一首 其三十四 段干木","黄省曾","四言",["干木自晋，萍寓西河。","群贤分组，树介岩阿。","千乘登门，跳跃逃徂。","腾光韦素，耿照弗磨。"],0,"x322","明"],["高士颂九十一首 其三十五 东郭顺子","黄省曾","四言",["灏灏东郭，动展如天。","清虚应物，独抱自然。","迷窥高弟，欲述难言。","文侯失志，爵国可捐。"],0,"x322","明"],["高士颂九十一首 其三十六 公仪潜","黄省曾","四言",["鲁慕公仪，崇阶以钓。","授意孔思，乃非诚到。","面返君言，高陈友操。","考槃弗谖，毕景怡道。"],0,"x322","明"],["高士颂九十一首 其三十八 颜斶","黄省曾","四言",["特哉齐斶，剧折庙堂。","上陈二帝，下举三王。","宾师靡诺，形神恐妨。","终身不辱，野箓有光。"],0,"x322","明"]]