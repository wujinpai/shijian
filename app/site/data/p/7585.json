[["醉公子 其二","毛奇龄","词",["杏园初试酒。","挟弹遮杨柳。","醉里困金吾。","教姬倒玉壶。","绶丝如鹝子。","翠帢团团刺。","花片缀衣巾。","衣花看转新。"],0,"x427","清"],["生查子","毛奇龄","词",["绿柰匝茱幮，皂角穿萝屋。","犀槅钉明螺，眼底分朝旭。","沅浦长，淇水曲。","处处难追逐。","欲见有何由，簳蜡成红烛。"],0,"x427","清"],["浣溪沙 其一","毛奇龄","词",["碧玉蒲芽短短针。","雀罗波底刺当心。","拔蒲归去水淫淫。","楫染绿苔疑掩袖，幔漂红露似湔襟。","晚风吹转北塘深。"],0,"x427","清"],["浣溪沙 其二","毛奇龄","词",["溪女妆成出若耶。","芹丝萍蔓逼流斜。","青苔石上浣新纱。","爱把单鬟捎竹叶，羞将双脸近荷花。","缇油前覆夜来车。"],0,"x427","清"],["浣溪沙 其三","毛奇龄","词",["软红江波鸭子清。","日迟游女遍江城。","红桥度烛缓相迎。","细马隔裙穿镫子，平船素手拨帘旌。","大堤春日往来情。"],0,"x427","清"],["浣溪沙 其四","毛奇龄","词",["娇女新妆村艳浓。","四枝鬟插石榴红。","出门还怕隔溪风。","石镜暗飞山后鹊，荻屏销画水边荭。","西施台馆碧波中。"],0,"x427","清"],["浣溪沙 其五","毛奇龄","词",["绿满南园孔雀栖。","重花叠叶不通飞。","小姑独出采蔷薇。","珥底珠儿徒刺脸，带穿贝子恐磨衣。","行行立立自寻思。"],0,"x427","清"],["浣溪沙 其六","毛奇龄","词",["丛鬓轻笼象格纱。","曲尘巾皱翳朝霞。","愁听江阁按红牙。","簪管枉铰银盖叶，绣床空钉白团花。","游丝飞絮近天涯。"],0,"x427","清"],["浣溪沙 其七","毛奇龄","词",["水绕空江叶绕枝。","竹郎桥畔豆娘祠。","佳人邂逅最堪思。","烛近只将遮幔子，风前长自敛衫儿。","梨花初落酒阑时。"],0,"x427","清"],["巫山一段云 其一","毛奇龄","词",["筱壁含烟澹，椒花滴露稀。","风吹细雨晓云低。","十二碧峰迷。","神女祠前泪，清猿峡里啼。","瞿塘新水曲尘微。","行客自依依。"],0,"x427","清"],["巫山一段云 其二","毛奇龄","词",["寒雨萝衣湿，晴云蕉帔开。","空舲峡下近阳台。","谁向梦中来。","丛笛江妃庙，孤舟新妇隈。","山花石竹不须栽。","看作小姑钗。"],0,"x427","清"],["女冠子 其一","毛奇龄","词",["上元少女。","谁授玉函金筥。","倚香坛。","画帔藤花浅，雕钟橘乳寒。","南宫除牒子，北斗动幡干。","犹见春归燕，似青鸾。"],0,"x427","清"],["女冠子 其二","毛奇龄","词",["玄都清晓。","坐间碧堂红草。","女仙家。","玉铪量星豆，金◇煮雪花。","驻颜丹作粉，系肘箓垂纱。","浼浼沟头水，尽胡麻。"],0,"x427","清"],["女冠子 其三","毛奇龄","词",["上清仙梦。","桄到十三春洞。","玉颜红。","月下随王母，花前别宁封。","黄衶潜解佩，赤舄缓弛弓。","称名多误听，为呼侬。"],0,"x427","清"],["女冠子 其四","毛奇龄","词",["仙房寂寂。","戏采瑶林珠实。","是何乡。","红尾梢花犬，青衣覆石羊。","鲛丝裁绶短，鹅管呷笙长。","倘得逢燕使，问昭王。"],0,"x427","清"],["女冠子 其五","毛奇龄","词",["平明受事。","堪惜玉笄初侍。","小茅君。","薄雾笼青鬓，轻烟曳䌨裙。","凤衔琪树荩，虬使玉堂云。","恐逐童男去，思纷纷。"],0,"x427","清"],["女冠子 其六","毛奇龄","词",["碧箫初弄。","暗想秦楼双凤。","几多情。","玉锲分芦节，金箱贮枣饧。","蕉花含秘阁，松影落层城。","谁捣玄霜尽，见云英。"],0,"x427","清"],["女冠子 其七","毛奇龄","词",["短花长叶。","到处翠𫐌相接。","洞中春。","衣炷熬丹锡，唇脂瀹水银。","盘囊闲系虎，麈尾笑遗人。","总隔蓬莱路，也生尘。"],0,"x427","清"],["女冠子 其八","毛奇龄","词",["金巾姣好。","长佩玉砂瑶草。","受清虚。","妆镜歼山鬼，香奁检道书。","缃眉遮羽盖。","素手涤仙厨。","每当三五夜，望蟾蜍。"],0,"x427","清"],["女冠子 其九","毛奇龄","词",["赤城紫府。","闲贮玄珑妃女。","小仙才。","节拥蓝丝葆，冠抽绿玉钗。","蜂房融日粉，蝶梦绕天涯。","何事刘郎去，不归来。"],0,"x427","清"],["山花子 其一","毛奇龄","词",["蝉翅宫绡傅体寒。","琵琶掩面夜歌阑。","插得钿头新拨子，是红蛮。","隔舍紫姑星会浅。","开门乌桕雨啼残。","曾卜金钱今始验，拆和单。"],0,"x427","清"],["山花子 其二","毛奇龄","词",["小院风摇九子铃。","临河长对牸牛星。","欲上玉机愁杼短，织难成。","掷缕烛翻娇凤出，萦丝泪尽湿花生。","谁道锦文无样子，看回程。"],0,"x427","清"],["春晓曲 回文","毛奇龄","词",["小屏山上西江曲。","深处落梅寒簌簌。","晓鉴菱开赭粉红，残灯穗卷香脂绿。","草头阶刬袜钗金，花里碧钩幡胜玉。","绕凤双簧蜡炙新，早春惊破霜溪竹。"],0,"x427","清"],["木兰花令 回前","毛奇龄","词",["竹溪霜破惊春早。","新炙蜡簧双凤绕。","玉胜幡钩壁里花，金钗袜刬阶头草。","绿脂香卷穗灯残，红粉赭开菱鉴晓。","簌簌寒梅落处深，曲江西上山屏小。"],0,"x427","清"],["菩萨蛮 其一","毛奇龄","词",["含桃着雨花如雪。","井边吹落春云叶。","鹦鹉结钗楼，新娘半上头。","裁衣翻样子。","压线盘金篚。","十五小裙腰。","能留线几条。"],0,"x427","清"],["菩萨蛮 其二","毛奇龄","词",["山鸡栖罢乌啼树。","迎人烧尽柑红炬。","复钥下铜鱼。","车前一幰除。","褥花尝对缝。","羞见双鸳控。","渐减玉炉烟。","人眠故未眠。"],0,"x427","清"],["菩萨蛮 其三","毛奇龄","词",["宜城二月莺啼早。","罗敷十五双鬟小。","锦带约桑钩。","使君南陌头。","连钱嘶日暮。","共返宜城渡。","莫是看罗敷。","罗敷自有夫。"],0,"x427","清"],["菩萨蛮 其四","毛奇龄","词",["轻雷鹿鹿宫车转。","晚凉偷弄邠王管。","双甲小𧏗蛦。","黄鹂处处啼。","春风吹欲遍。","尽作西清怨。","暗里换歌头。","伊州似石州。"],0,"x427","清"],["菩萨蛮 其五","毛奇龄","词",["一株柳树千条叶。","桃根巧向梅根接。","花坞暗相通。","新花隔几重。","宝函春信杳。","水漫红鱼小。","半格轴头丝。","环环无尽时。"],0,"x427","清"],["菩萨蛮 其六","毛奇龄","词",["日黄不上妆山面，露圆难缀珠帘线。","种得郁金花，将来浸木瓜。","枕屏山六扇，上有江南岸。","岸尽是吴关，关前人未还。"],0,"x427","清"],["河渎神 其一","毛奇龄","词",["楚雨歇残阳。","满庭新月潇湘。","松花湿影坠山黄。","帝女花竿庙旁。","瑶瑟洞箫来极浦，风吹桂酒椒浆。","夜半烟寒翠敛，几人能上高唐。"],0,"x427","清"],["河渎神 其二","毛奇龄","词",["丹殿俯嵯峨。","洞庭秋水湘娥。","深房鬼火暗青萝。","呜咽神弦自歌。","文木漆光丝缠腹，蕉花影里婆娑。","只为相思美子，灯前一敛双蛾。"],0,"x427","清"],["更漏子 其一","毛奇龄","词",["枣屏深，桦烛冷。","复壁照人双影。","鱼坠管，兽衔环。","一床衾枕单。","更漏咽。","楼头月。","偏射小窗明蛤。","红幕掩，鹊桥低。","银河又向西。"],0,"x427","清"],["更漏子 其二","毛奇龄","词",["小檀槽，新捍拨。","弹就夜堂秋月。","银箭断，玉钗凉。","烛槃红泪长。","寒角动。","霜风送。","惊起金微残梦。","关戍柝，女郎砧。","城南秋渐深。"],0,"x427","清"],["更漏子 其三","毛奇龄","词",["幔钩绳，复斗穗。","寒夜美人半睡。","云掩絮，月胧明。","枕函亭钏声。","蚕烛耀。","飞蛾绕。","门外乌啼难晓。","燔蕙烬，隐纱笼。","罘罳划碎红。"],0,"x427","清"],["更漏子 其四","毛奇龄","词",["剪鲛丝，量兽锦。","宽窄灯前自审。","钿尺短，错刀残。","晚来多少寒。","园雾薄。","林花落。","水面星摇池阁。","山犬吠，草虫鸣。","曲房魂暗惊。"],0,"x427","清"],["更漏子 其五","毛奇龄","词",["井梧阴，庭树暝。","寂寂画栏人静。","蜡子焰，蟹衣筐。","邻家夜绩凉。","芭蕉露。","零如雨。","记得暗中欢去。","宵漏尽，晓钟催。","碧窗殊未来。"],0,"x427","清"],["木兰花令","毛奇龄","词",["晓莺娓娓流妆阁。","日上烛吹红绣幕。","束将方带玉芙蕖，裹就半鞲银芍药。","寻花露冷胭脂薄。","花底暗翻钗子落。","谁开鸳锦抱轻云，误使丁娘枕前索。"],0,"x427","清"],["小重山 其一","毛奇龄","词",["春殿香销锁碧空。","夜凉宫漏悄、咽铜龙。","银河泻地水漴漴。","妆初洗，残粉腻沟红。","双凤宿梧桐。","小桃金井上、露华浓。","长门枉自闭重重。","珠闼迥，时拂玉阶虫。"],0,"x427","清"],["小重山 其二","毛奇龄","词",["芳草茸茸翠辇迟。","昭阳初日影、散彤墀。","银幡彩胜戴双𫄥。","金错小，剪出万年枝。","御苑落花时。","祠前祈百子、汉家池。","承恩唯有臂红知。","中宵梦，频起视胭脂。"],0,"x427","清"],["小重山 其三","毛奇龄","词",["黄帕衔鳌结象床。","卷衣长拂面、侍君王。","衫襟深惹御篝香。","绡幛影，隐隐见鸳鸯。","别院罢霓裳。","众中新赐着、殿头黄。","年来独系绛纱囊。","江南路，四十杜秋娘。"],0,"x427","清"],["小重山 其四","毛奇龄","词",["𫛛鹊高翾负日温。","春冰融太液、细流浑。","懒调黄子渍香荪。","羊车近，竹叶满金盆。","十载见承恩。","踏青随例出、望春门。","却收银钥暗销魂。","梨花落，深殿又黄昏。"],0,"x427","清"],["喜迁莺 其一","毛奇龄","词",["榆叶里，楝花前。","烧尽白矾烟。","娇龙自走不须鞭。","最喜是莺迁。","歌羽歌，舞羽舞。","人在掌中飞去。","雾丝裙子本蹁跹。","何处更留仙。"],0,"x427","清"],["喜迁莺 其二","毛奇龄","词",["杏苑北，曲江西。","残雪尚依依。","轻轮辗絮着人衣。","拊马夜归迟。","蓬宴遥，莲漏浅。","红烛万条深院。","晓来唯听乳莺啼。","移上绿杨枝。"],0,"x427","清"],["临江仙 其一","毛奇龄","词",["澧浦红兰开日暮，美人倚徙空亭。","幽岩春竹雨冥冥。","长思公子，愁绝翠云屏。","碧水尚传瑶瑟怨，枨枨夜鼓湘灵。","苍梧南去晚山青。","楚江迁客，憔悴不堪听。"],0,"x427","清"],["临江仙 其二","毛奇龄","词",["秋藕丝裙春树面，龙安寺里为家。","时来空馆倚栏斜。","栏前新水，日日浸桃花。","素手自撩金索动，腕绳轻约红纱。","东风相见各天涯。","道傍愁思，散作日边霞。"],0,"x427","清"],["临江仙 其三","毛奇龄","词",["高阁近花红影合，绕床还种青梧。","西施娇小似无夫。","黄金梯滑，不见有人扶。","茭叶菱根遮浦暗，含情但采菖蒲。","金阊门外夜啼乌。","女坟前去，寒烛照东湖。"],0,"x427","清"],["临江仙 其四","毛奇龄","词",["晚渡潮生野火静，丛祠深对江波。","垂鬟接黛一青娥。","宝冠珠络，花帔贴银鹅。","估客往来争祷赛，隔船吹凤鸣鼍。","山低如带水如罗。","螭头黄绢，隐隐画双螺。"],0,"x427","清"],["临江仙 其五","毛奇龄","词",["睡架荼蘼红刺软，雾中桄蔽轻纨。","几番觅钏坐花间。","香山未暖，石炭捣烟寒。","薄絮装衣萦背胛，空悬辟冻金环。","武溪雪净尚征蛮。","杜鹃声杳，莫是未教还。"],0,"x427","清"],["十六字令","毛奇龄","词",["花下影，跟人上玉墀。","谁推倒，横着半毡儿。"],0,"x427","清"],["捣练子 其一","毛奇龄","词",["青草软，绿波长。","日暮乡关思渺茫。","吴苑隋堤何处是，满江垂柳又垂杨。"],0,"x427","清"],["捣练子 其二 泊山塘作","毛奇龄","词",["云淡淡，雨丝丝。","旧日真娘何处祠。","横笛短箫声渐远，藕花塘子夜来时。"],0,"x427","清"],["梦江南 其一 当缓缓归曲","毛奇龄","词",["临安去，陌上已开花。","扇影似翻江上羽，车帘刚拂草头沙。","缓缓好归家。"],0,"x427","清"],["梦江南 其二 当缓缓归曲","毛奇龄","词",["临安去，陌上已开花。","绕路烟丝笼暖去，清江日影带潮回。","缓缓好归来。"],0,"x427","清"],["法驾导引 送一苓和尚还罗浮","毛奇龄","词",["江帆暮，江帆暮。","六月水西头。","竹子牵来黄蛤履，荷花泛去白螺舟。","送汝返罗浮。"],0,"x427","清"],["忆王孙 其一","毛奇龄","词",["东风吹柳覆金堤。","夹岸红楼望去迷。","日映游丝卷幔低。","画桥西。","一树娇花鸟自啼。"],0,"x427","清"],["忆王孙 其二 游西施山","毛奇龄","词",["西施歌馆旧城东。","画栋朱栏映碧空。","花絮阴阴趁晚风。","翠重重。","石上胭脂堕雨红。"],0,"x427","清"],["一剪梅 其一 剪半","毛奇龄","词",["光宅坊前十字街。","桃子花开。","杏子花开。","钿头栎子有人猜。","恐是铜钗。","不是金钗。"],0,"x427","清"],["一剪梅 其二 剪半","毛奇龄","词",["缚竹纤纤似女腰。","欲上溪桥。","怕上溪桥。","黑云遮住北山坳。","昨日风潮。","今日风潮。"],0,"x427","清"],["一剪梅 其三 剪半","毛奇龄","词",["木槲花间乳鹊栖。","鹊也能飞。","花也能飞。","临行空记草花期。","二月当归。","三月当归。"],0,"x427","清"],["长相思 其一 泛舟西江即事","毛奇龄","词",["一桥低。","两桥低。","枣树湾头西复西。","江深雨欲迷。","早乌啼。","晚乌啼。","两桨归来乌未栖。","相逢半路溪。"],0,"x427","清"],["长相思 其二 泛舟西江即事","毛奇龄","词",["双头钗。","独头钗。","一样金鹅两样排。","钗梁起四台。","乌帽来。","白帽来。","湖就矶头望几回。","菖蒲花未开。"],0,"x427","清"],["点绛唇 其一 送春","毛奇龄","词",["恼杀啼鹃，逢人还道春归去。","留人不住。","谁要留春住。","花絮茫茫，万点愁人绪。","归何处，春归无路。","莫是人归路。"],0,"x427","清"],["点绛唇 其二 姜亦舆汝长庚庚邀听琵琶","毛奇龄","词",["抱出檀槽，金丝拨子轻轻落。","浅围罗幕。","月上栏杆角。","夜半嘈嘈，繁手惊相错。","敲银索。","梦回妆阁。","花底飞乌鹊。"],0,"x427","清"],["点绛唇 其三 采莲曲","毛奇龄","词",["南浦风微，画桡已到深深处。","藕花遮不住。","不许穿花去。","隔藕丛丛，似有人言语。","难寻溯。","乱红无主。","一望斜阳暮。"],0,"x427","清"],["相见欢 其一","毛奇龄","词",["倚床还绣芙蓉。","对花丛。","牵得丝丝柳线翠烟笼。","愁思远，抛金剪。","唾残绒。","羞煞鸳鸯衔去一丝红。"],0,"x427","清"],["相见欢 其二","毛奇龄","词",["花前顾影粼粼。","水中人。","水面残花片片绕人身。","私自整。","红斜领。","茜儿巾。","却讶领间巾里刺花新。"],0,"x427","清"],["相见欢 其三 怀人","毛奇龄","词",["秋风袅袅登台。","强徘徊。","两两鸳鸯飞去几时回。","钱塘路。","西陵渡。","总天涯。","不是早潮又是晚潮来。"],0,"x427","清"],["霜天晓角 其一 同丁大声、史宪臣、徐徽之、蔡大敬、来成夫登望京门楼","毛奇龄","词",["平沙十里。","滚滚江潮水。","横下秋鹰如削，短草岸，朔风起。","栏杆人共倚。","旧关何处是。","记得西施，去路残阳外，碧烟里。"],0,"x427","清"],["霜天晓角 其二 晓起","毛奇龄","词",["柳烟如织。","病起逢寒食。","昨夜东风吹紧，花梢上，雨来急。","晓开铜镜立。","镜光涵晓色。","惊见浓云堆下，梨花月，一轮白。"],0,"x427","清"],["减字木兰花 其一 桑妇词","毛奇龄","词",["城南暮雨。","尚有采桑秦氏女。","低系桑笼。","独倚桃花一树红。","青骢西去。","口里衔丝衔不住。","归到灯前。","一任三眠与四眠。"],0,"x427","清"],["减字木兰花 其二 同姜八孝廉有访","毛奇龄","词",["陆公祠畔。","十里横塘行未半。","花港深深。","王四娘家何处寻。","醁醅初注。","又是孝廉船欲去。","怕照菱花。","对面分明又一家。"],0,"x427","清"],["卜算子 其一","毛奇龄","词",["小鸟踏花枝，花落如红霰。","花树朦胧一径迷，中有佳人面。","愁见落花多，欲去还留恋。","扇子盛来仔细看，点点桃花片。"],0,"x427","清"],["卜算子 其二","毛奇龄","词",["门外绿杨堤，门里红妆女。","何处金羁美少年，故绾垂杨缕。","风起搅杨花，飞作廉纤雨。","眼底迷迷不见人，且听黄鹂语。"],0,"x427","清"],["阮郎归 其一 春暮","毛奇龄","词",["樱桃子熟竹初肥。","南园昼启迟。","蜂房滤粉暗成脾。","画垣生绿衣。","蒲雨涨，柳桥低。","秋千深院迷。","杜鹃啼歇最高枝。","有人还未归。"],0,"x427","清"],["阮郎归 其二 秋暮见晓妆者","毛奇龄","词",["拒霜花发傍妆楼。","楼前细水流。","隔花初日上帘钩。","美人楼上头。","开碧箧，泻红油。","镜边长坐愁。","鸳鸯瓦热露华浮。","玉钗寒未抽。"],0,"x427","清"],["浣溪沙 和任二王辅回环韵","毛奇龄","词",["阴柳垂庭山枕斜。","禽鸣自上槛边花。","深屏午梦隔窗纱。","瓮启冰牙蛆泻酒，襟披雪眼蟹潆茶。","临妆晚扫淡黄鸦。"],0,"x427","清"],["武陵春 登仙桃山","毛奇龄","词",["溪口桃花红欲暮，浅水泛胡麻。","行尽空林散紫霞。","来到上清家。","缥缈香坛松饭熟，石鼎醉丹砂。","归路残阳噪晚鸦。","回首乱云遮。"],0,"x427","清"],["菩萨蛮 其一 即事","毛奇龄","词",["花前鼓瑟花间听，红灯低照新妆靓。","侍婢唤行云。","高唐曾见君。","玉笼香雾绕，怕见青铜晓。","井上辘轳声，翻教睡画屏。"],0,"x427","清"],["菩萨蛮 其二 咏枕和友","毛奇龄","词",["珊瑚镂枕珠阗细。","盘云散泽香衣腻。","枯压鬓边花，花红印一些。","与谁同转侧，绣出双㶉𫛶。","将枕付陈思。","陈思思不思。"],0,"x427","清"],["菩萨蛮 其三 咏枕和友","毛奇龄","词",["嘉文小裹双丝纽。","单窝认得孤眠久。","泪浥口脂融，相逢一梦中。","花函遮短帔，中有相思字。","银烛夜来新，深怜抱枕人。"],0,"x427","清"],["菩萨蛮 其四 商霖臣纳姬","毛奇龄","词",["沟头流水山头雪。","春江几度迎桃叶。","桃叶渡江来，江花两岸开。","珍珠量几斛，买得双蛾绿。","衫子绿于蛾，双蛾奈绿何。"],0,"x427","清"],["菩萨蛮 其五 为杨生催妆者，多见纸落，椽上官知书也。最后弟子周风远，索甡和词","毛奇龄","词",["丹枫叶叶迎春小，锦茵开处香鸾绕。","银扇隔雕栊，灯花百子红。","檐前乌鹊曙，休遣催妆去。","赋得夜来珠，昭容揽镜馀。"],0,"x427","清"],["菩萨蛮 其六 为杨生催妆者，多见纸落，椽上官知书也。最后弟子周风远，索甡和词","毛奇龄","词",["雕篮细压花毬小。","金箱叠锁珠丝绕。","花烛满帘栊，双樽琥珀红。","芙蓉清漏曙，晓凤衔烟去。","慢撒帐头珠，香奁贮有馀。"],0,"x427","清"],["菩萨蛮 其七 颠倒韵伯兄大千侄阿莲同作","毛奇龄","词",["药栏勾堕衔钗雀。","雀钗衔堕勾栏药。","花落画屏纱。","纱屏画落花。","晓山关雁绕。","绕雁关山晓。","人远惜残春。","春残惜远人。"],0,"x427","清"],["菩萨蛮 其八 颠倒韵伯兄大千侄阿莲同作","毛奇龄","词",["软铺铜甃飞红浅。","浅红飞甃铜铺软。","深巷柳摇金。","金摇柳巷深。","爚篝香雾薄。","薄雾香篝爚。","门掩半黄昏。","昏黄半掩门。"],0,"x427","清"],["菩萨蛮 其九 颠倒韵伯兄大千侄阿莲同作","毛奇龄","词",["去春三鸟栖来曙。","曙来栖鸟三春去。","边塞绝秋千。","千秋绝塞边。","错弹哀抵角。","角抵哀弹错。","楼倚谢娘秋。","秋娘谢倚楼。"],0,"x427","清"],["菩萨蛮 其十 颠倒韵伯兄大千侄阿莲同作","毛奇龄","词",["井干双断金丝绠。","绠丝金断双干井。","城上响啼莺。","莺啼响上城。","绮园南去骑。","骑去南园绮。","迟日坠鸣机。","机鸣坠日迟。"],0,"x427","清"],["菩萨蛮 其十一 颠倒韵伯兄大千侄阿莲同作","毛奇龄","词",["簸钱金压花裙唾。","唾裙花压金钱簸。","斜日斗钿车。","车钿斗日斜。","酒胡雕列缶。","缶列雕胡酒。","孤独醉当垆。","垆当醉烛孤。"],0,"x427","清"],["菩萨蛮 其十二 颠倒韵伯兄大千侄阿莲同作","毛奇龄","词",["熨香沉斗珠绳屈。","屈绳珠斗沉香熨。","花鸭睡笼纱。","纱笼睡鸭花。","减丝荷漏浅。","浅漏荷丝减。","长夜好难量。","量难好夜长。"],0,"x427","清"],["菩萨蛮 其十三 颠倒韵伯兄大千侄阿莲同作","毛奇龄","词",["烛槃深影春围曲。","曲围春影深槃烛。","迷路入花溪。","溪花入路迷。","枕函空覆锦。","锦覆空函枕。","遮莫苦栖鸦。","鸦栖苦莫遮。"],0,"x427","清"],["菩萨蛮 其十四 颠倒韵伯兄大千侄阿莲同作","毛奇龄","词",["刺桐花满高桥寺。","寺桥高满花桐刺。","魂断几家村。","村家几断魂。","去䯄嘶落絮。","絮落嘶䯄去。","娘度夜中霜。","霜中夜度娘。"],0,"x427","清"],["菩萨蛮 其十五 颠倒韵伯兄大千侄阿莲同作","毛奇龄","词",["小姑村映青溪晓。","晓溪青映村姑小。","家是就矶斜。","斜矶就是家。","返舟莲棹远。","远棹莲舟返。","侬识旧娃宫。","宫娃旧识侬。"],0,"x427","清"],["菩萨蛮 其十六 寄友","毛奇龄","词",["上潮春涨西陵望。","望陵西涨春潮上。","寒雨渡来难。","难来渡雨寒。","燕泥衔断槛。","槛断衔泥燕。","时苦作蚕丝。","丝蚕作苦时。"],0,"x427","清"],["菩萨蛮 其十七 访所欢作","毛奇龄","词",["路旁厢板乌椑树。","树椑乌板厢旁路。","寻处甚阴阴。","阴阴甚处寻。","缕丝千点雨。","雨点千丝缕。","何若别情多。","多情别若何。"],0,"x427","清"],["菩萨蛮 其十八 落帆亭送女士黄皆令远行","毛奇龄","词",["窄帆轻落亭前驿。","驿前亭落轻帆窄。","红露浥花栊。","栊花浥露红。","渡淮临雨暮。","暮雨临淮渡。","长过莫愁乡。","乡愁莫过长。"],0,"x427","清"],["摊破浣溪沙 怀张七雏隐粤东未归","毛奇龄","词",["黄木湾前芦雁稀。","琵琶洲畔竹花飞。","南去陆郎烟瘴里，几时归。","翠鸟羽长临镜远，章鱼海阔跳波微。","看到木棉红又白，好装衣。"],0,"x427","清"],["少年游 过陵下感旧","毛奇龄","词",["当时邂逅，凌家山下，桃树满前津。","今来又值，桃花开后，不见那时人。","香轮翠幕陵前路，日影动飞尘。","流水横斜，鸟啼哀怨，愁对武陵春。"],0,"x427","清"],["南柯子 其一 斗草词","毛奇龄","词",["喜摘唯红豆，难攀是白榆。","百花亭外展氍毹。","藏得宜男、临赛又踟蹰。","绡帕牵藤刺，缃襕裹露珠。","朦胧却把翠钿输。","暗拣花枝、插补鬓边虚。"],0,"x427","清"],["南柯子 其二 和杨王客赋得玲珑隔窗语","毛奇龄","词",["青漆垂银钥，丹纱映玉栊。","隔窗娇立小芙蓉。","两地分明、细语一灯红。","好鸟音初剪，幽兰气转浓。","相看枉自唤玲珑。","一寸明螺、槅子万重峰。"],0,"x427","清"]]