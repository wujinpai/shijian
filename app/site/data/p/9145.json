[["归朝欢","王哲","词",["天地初分何处寄。","父母无生名甚字。","须将这个要分明，推穷此理宁论是。","细细传不二。","一能仍究从前自。","往来频，不知迷迷。","甚日得言赐。","忽尔真灵前面至。","认得元形欢喜示。","惺惺觑著甚端严，辉辉返照通容易。","见时唯密秘，妙玄微雅中深邃。","出圆光，五般颜彩，复本总祥瑞。"],0,"x263","元"],["玉蝴蝶","王哲","词",["捉住玉山赤凤，神舟同泛，激浪漂浮。","便使鸟龟，开口显出嘉谟。","吸洪涛、枯干北海，吐巨波、浇溉西湖。","自舒敷。","水纹花面，皆是金铺。","光珠。","盈盈照耀，恰如明月，晃晃方隅。","普遍腾辉，尽成霞彩覆环纡。","见圆珠。","深深渐现，结宝丹、空处超逾。","得琼途。","大罗天上，永永惺苏。"],0,"x263","元"],["西江月","王哲","词",["酒饮清光滑辣，果餐软美香甜。","两般每日做抽添。","八味依时给赡。","信步六街走遍，须寻七宝妆严。","三田九转似银蟾。","一性孤灵有验。"],0,"x263","元"],["忆王孙","白朴","词",["瑶阶月色晃疏棂。","银烛秋光冷画屏。","消遣此时此夜景。","步闲庭。","苔浸凌波罗袜冷。"],0,242,"元"],["渔父词 赋胡直之溪桥莲塘二首","张建","词",["溪桥脚下水平分，桥柱萍粘浪打痕。","天向晚，日搀昏，两簇青烟断岸村。","拂拂轻风漾翠澜，粉媒新扑小荷盘。","塘水涨，岸痕漫，草阁临流五月寒。"],0,211,"金"],["水仙子","徐再思","词",["一声梧叶一声秋，一点芭蕉一点愁，三更归梦三更后。","落灯花棋未收，叹新丰孤馆人留。","枕上十年事，江南二老忧，都到心头。"],0,150,"元"],["朝天子","徐再思","词",["里湖，外湖，无处是无春处。","真山真水真画图，一片玲珑玉。","宜酒宜诗，宜晴宜雨，销金锅锦绣窟。","老苏，老逋，杨柳堤梅开墓。"],0,150,"元"],["水仙子","马致远","词",["春风骄马五陵儿，暖日西湖三月时，管弦触水莺花市。","不知音不到此，宜歌宜酒宜诗。","山过雨颦眉黛，柳拖烟堆鬓丝，可喜杀睡足的西施！"],0,"x218","元"],null,null,null,null,["人月圆 马嵬效吴彦高","李齐贤","词",["五云绣岭明珠殿，飞燕倚新妆。","小颦中有，渔阳胡马，惊破霓裳。","海棠正好，东风无赖，狼藉春光。","明眸皓齿，如今何在，空断人肠。"],0,157,"元"],["落梅风","珠帘秀","词",["山无数，烟万缕。","憔悴煞玉堂人物，倚篷窗一身儿活受苦。","恨不得随大江东去！"],0,155,"元"],null,["西江月","佚名","词",["彼此离于生处，火遭水破惊忙。","分身各自拟深藏。","半路再遣萧郎。","夫为无衣裹体，妻因水浸衣黄。","丙丁甲乙有形相。","刚遣令合阴阳。"],0,"x217","元"],null,null,null,null,null,["明良诗","吴当","四言",["于赫皇祖，肇基朔土。","惟时忠襄，实佐神武。","天戈攸指，罔不率俾。","忠武之才，雄特瑰伟。","逮乎忠宣，相我世皇。","式开治平，统一万方。","猗与文忠，礼乐是式。","克赞英庙，以匡以翼。","硕硕元勋，后先四王。","维君之明，维臣之良。","侃侃开府，尚德象贤。","承厥父祖，佛时仔肩。","惟皇之念，翰墨是锡。","倅尔嘉名，休光有奕。","云汉于昭，发耀天藻。","垂美无疆，永以为宝。","翼翼厥明，终始典学。","陈善责难，世臣攸托。","以道事君，汝翼汝为。","股肱左右，庶底缉熙。","明良之逢，有典有则。","世笃忠贞，式报天德。"],0,"x255","元"],["恒德斋为开府明良公作","吴当","四言",["于穆天命，恒久不已。","往禅来续，与道为体。","惟圣有德，率性之常。","不二不杂，悠久无疆。","君子是则，勉勉不息。","终始弗渝，夙夜无斁。","赫赫元勋，昔佐皇祖。","配德惟一，永锡胤祚。","侃侃闻孙，靖共在位。","式谨尔常，以赞天子。","佩舄雍雍，退食自公。","肃慎斋居，用省厥躬。","协于克一，责难将美。","征其化成，万国咸理。","惟巽而动，勿承以羞。","亿万斯年，于昭匹休。"],0,"x255","元"],["极高明亭诗为曾以敬作","吴当","四言",["春木载荣，朝阳孔曦。","悠悠白云，华盖之西。","爰有新亭，翼翼中峙。","式究尔宁，君子攸止。","其止维何，朝弦莫歌。","道其问学，弗辟弗颇。","斯道之著，皎焉日星。","发育峻极，敛之灵扃。","弥纶六合，迥绝寥廓。","周知旁行，卓彼先觉。","如俯层台，洞视靡遗。","如持悬鉴，罔有蔽亏。","知崇效天，礼卑法地。","成性之存，内外交致。","万物毕备，一贯斯全。","参乎有唯，思也是传。","予忝承学，子实名裔。","自顾无闻，祇用生愧。","惟博反约，实基三省。","敢曰尚友，愿以自警。"],0,"x255","元"],["庆原堂诗为萍乡刘氏作","吴当","四言",["惟楚萍乡，邑里有堂。","繄昔刘氏，肇基于唐。","雄虎之台，郁郁丘土。","其伏未耀，本干深固。","子孙多贤，冠佩蝉联。","积善储和，溯流而源。","福庆之实，既坚既栗。","晔晔灵芝，毓秀于室。","历宋而元，流庆未已。","袒免同居，表德闾里。","山冢之迁，有霆有雷。","尚复多祉，源源其来。","奕奕君子，实居后麓。","既休既宁，以踵芳躅。","绳绳厥承，忠厚之教。","庶其绍之，以食斯报。","太史有记，邦人足征。","式勖来嗣，勒诗尔楹。"],0,"x255","元"],["咸阳王功德诗","吴当","四言",["在昔皇祖，有赫神武。","维忠宣王，杰出西土。","佐命而兴，来受圭组。","宪宗伐蜀，往补戎伍。","于穆世皇，天戈载扬。","亲拔云南，用逖蛮方。","滇之宗臣，乃悖纪纲。","复叛不顺，袭盗以狂。","天子曰嘻，孰称予使。","爰命忠惠，以绥以抚。","谕之恩信，涤汝烦苦。","简节疏目，咸得理所。","乃疆乃理，奠尔城邑。","市有居货，屋有陶甓。","我田我池，粳稌黍稷。","训厥士女，污俗斯革。","既庶既富，建学立教。","笾豆鼓钟，于乐孔庙。","诗书歌弦，孰则孰效。","折其狂猘，笃尔忠孝。","步不出国，侯幽侯深。","部曲联绎，干戈若林。","久而弥孚，向义骎骎。","锡贡无已，大赂南金。","天祚皇国，克生伟人。","历年孔多，以福远民。","远民之安，克顺克正。","惟王之贤，天子之圣。","元臣云亡，远民孔哀。","风马云车，曷往曷来。","新庙既作，执事有恪。","王其享兹，用配诸葛。","锡爵启封，皇则悼之。","嗣德象贤，天实报之。","诜诜孙子，有引无替。","太史作诗，式昭永世。"],0,"x255","元"],null,["集义斋诗为太行高氏作","吴当","四言",["瞻彼嘉木，太行之阴。","盘盘幽谷，侃侃素心。","缅焉兴怀，古道是式。","惟心之宜，至当有则。","我其扩之，制事不违。","用达万变，审乎先几。","灼知勇为，乃积乃充。","无间微显，集于厥躬。","浩然之生，实匪助长。","天地之塞，吾体同量。","肃尔斋居，永端于初。","必有事焉，昭昭圣谟。"],0,"x255","元"],null,["修省斋诗","吴当","四言",["惟皇降衷，弗忚弗亏。","习远情肆，始沦以隳。","有卓君子，励行自修。","夙夜惕若，反躬是求。","孰去孰存，惟日内省。","百鏬勿遗，靡伺靡骋。","修省之始，尤慎在独。","勇绝其萌，庶制尔欲。","于赫斯临，昭昭幽深。","毋苟自欺，其敢弗钦。","矧兹明威，曷敢戏豫。","战兢自持，主一无二。","燕居观象，恒若荐雷。","益慎益戒，万善具来。","审之靡疚，式底于完。","信立愿达，克承克安。","吾侪小人，贪欲内锢。","甘心物欲，有寐有寤。","为之由己，曷自暴弃。","呜呼灵台，幸勖尔志。"],0,"x255","元"],["寿宁堂诗为冀宁耿氏作","吴当","四言",["于昭秉彝，有本有支。","立爱惟亲，万善是基。","衎衎令子，报德慈母。","菀兹堂构，有翼其宇。","鱼轩戾止，兄弟具在。","执礼循循，百福攸介。","旨甘孔时，春酒载筵。","天锡纯嘏，眉寿永年。","哺乌在林，遗我好音。","起处攸宁，式慰母心。","琴瑟静好，以雅以南。","式歌且舞，朱衣华簪。","既曰寿只，实在宁只。","夙夜凊温，庶其敬止。","敦孝移忠，永锡不匮。","矢诗孔扬，以勖来裔。"],0,"x255","元"],null,["蓄川","杨弘道","四言",["蓄川膴膴，闲田可耕。","孰非人子，耕我先茔。","蓄川膴膴，闲田可艺。","孰非人子，艺我茔域。","皇天后土，日月照临。","汝耕汝艺，行者伤心。","奸回自终，可按可考。","利见大人，全我孝道。"],0,53,"元"],["重庆堂诗","危素","四言",["翼翼高堂，临水之阳。","谁其作之，其氏曰王。","高堂翼翼，既深且谧。","有直其楹，有虚其室。","玄冠于于，厥子来趋。","父见其孙，亦克愉愉。","旨酒在匜，登豆有菹。","其肴孔多，抟兽网鱼。","子于父母，亦既能孝。","父诏乃孙，繄父是效。","其孝伊何，古有嘉则。","敬事皇天，以明尔德。"],0,74,"明"],["鸣雁二章 其一","张玉娘","四言",["鸣雁征征，白露既零。","猗嗟清兮，怀彼春冰。","鸣雁嗥嗥，凉风飘飖。","猗嗟娈兮，怀彼春宵。"],0,210,"宋"],["灵泉翀举自有诗十八章留人间今止存五遂续之","滕斌","四言",["石冷龙蟠，风高鹤瘦。","一片白云，勿落襟袖。","月佩霞裾，雾襦云幄。","白鹤一声，秋风老壑。","本无尘埃，何事乎浴。","千仞飞泉，所濯吾足。","谁言桃实，可以疗饥。","何为武陵，迷不自知。","万山雪瀑，一叶莲舟。","世人指似，泰华峰头。","如剑斯泉，如瓮斯石。","夜横紫箫，吹散寒碧。","瑶草低云，苍松洒雪。","何人举酒，酹我明月。","天低绛阙，月满瑶台。","玉鸾何许，尽归去来。"],0,193,"元"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["句 其二","赵佶","杂言",["相公公相子。","北斗七星三四点。","选饭来时不喜餐，御厨空费八珍盘。","方当月白风清夜，正是霜高木落时。","落花满地春光晚，芳草连云暮色深。","网罗今不密，回首不须惊。","午夜笙歌连海峤，春风灯火过湟中。","暖河消雪带，风柳散冰丝。","玉阶齐种女贞子，大觉金仙采撷来。","日射晚霞金世界，月临天宇玉乾坤。","危楼日暮人千里，攲枕风秋雁一声。"],0,"x109","金"]]