江云黯黯作愁阴。"],0,182,"宋"],["句  其一一七","释晓莹","残句",["雅淡天姿固可知。"],0,182,"宋"],["句","罗克开","残句",["抚摩二字圭三复，公直一心衡不欺。"],0,247,"宋"],null,["句 其二","赵善诏","残句",["谁谓山城僻，伦魁此破荒。"],0,70,"宋"],["句 其十九","王随","残句",["晴楼凭月吟魂冷，春席眠花醉梦香。"],0,57,"宋"],["句 其五","王安国","残句",["倾家何计效。"],0,224,"宋"],["句 其六","姚孝锡","残句",["盘无兼味惭留客，梦厌多岐不到乡。"],0,142,"宋"],["句","陈伯震","残句",["修眉浓淡里，寸碧有无间。"],0,149,"宋"],["句 其七","杨长孺","残句",["一封无己帖，两首乐天诗。"],0,170,"宋"],["句 其八","邵伯温","残句",["充城繁盛冠东川。"],0,137,"宋"],["句","李渎","残句",["行到水穷处，未知天尽时。"],0,175,"宋"],["句 其九","姚孝锡","残句",["舞风初学絮，带雨不成花。"],0,142,"宋"],["句 其四","田锡","残句",["高高百里一屈盘，八十四盘青云端。"],0,6,"宋"],["句 其二十","徐似道","残句",["化成银地佛应喜，移下玉楼天不知。"],0,139,"宋"],["句 其四","王安国","残句",["谁使诗仙来凤沼，俗传贾客过鸡林。"],0,224,"宋"],["句 其十二","张商英","残句",["因寻太上长生诀，偶到青城大面山。"],0,116,"宋"],["句","张宗永","残句",["大书文字隄防老，剩买峰峦淮备闲。"],0,36,"宋"],["句 其十四","胡铨","残句",["笑春烛底影，煎泪风前杯。"],0,241,"宋"],["句 其二","王操","残句",["彩笺分卷碧云薄，腊烛对烧红泪干。"],0,230,"宋"],["句 其三","释昙颖","残句",["自从游紫陌，谁肯隐青山。"],0,167,"宋"],["句  其三","袁说友","残句",["扁舟系柳向朱扉。"],0,"x192","宋"],["句 其三","吴处厚","残句",["云共去时天杳杳，雁连来处水茫茫。"],0,154,"宋"],["句 其三","王安国","残句",["因郎憔悴却羞郎。"],0,224,"宋"],["句 其四","徐俯","残句",["平生不喜刘蕡策，色色人中自有人。"],0,156,"宋"],["句 其七十三","释惠崇","残句",["鹤惊金刹露，龙蛰玉瓶泉。"],0,69,"宋"],["句  其七","夏倪","残句",["今代文章伯。"],0,232,"宋"],["句 其一","许洞","残句",["霜霭清九衢，霞光照双阙。"],0,4,"宋"],null,["句","谢耘","残句",["路深容马窄，楼小插花多。"],0,159,"宋"],["句","王昭宇","残句",["明朝山北山南路，各自逢人话胜游。"],0,167,"宋"],["句 其一","张镃","残句",["一棹径穿花十里，满城无此好风光。"],0,"x107","宋"],["句  其一三","卢襄","残句",["麦秋天气朝朝变，蚕月人家处处忙。"],0,217,"宋"],["句 其五","张表臣","残句",["床弩天诛韩闼览，剑锋神助宋将军。"],0,16,"宋"],["句  其一一","杨炎正","残句",["风月充三益。"],0,12,"宋"],["句 其五","葛天民","残句",["平生一点调元意。"],0,31,"宋"],["句 其二","韦奇","残句",["林缺添松补，篱疏倩菊遮。"],0,174,"宋"],["句 其二","李𬭚","残句",["散尽平生眼中客，暖风晴日闭门居。"],0,151,"宋"],["句 其三","阎孝忠","残句",["贤如赠扇扬风日，贫似开门卧雪时。"],0,42,"宋"],["句 其一","朱服","残句",["孤臣正泣龙髯草，游子空簪凤尾花。"],0,134,"宋"],["句 其二","王安国","残句",["孔明勿问襄阳庞。"],0,224,"宋"],["句","陈伯育","残句",["与君分两石。"],0,126,"宋"],["句 其一","韦奇","残句",["拨灰煨芋子，带湿𦶟松枝。"],0,174,"宋"],["句 其三","宋庆之","残句",["飘泊知何处，艰难亦到僧。"],0,57,"宋"],["句","冯显","残句",["甲子循环幸一终。"],0,96,"宋"],["句 其八"