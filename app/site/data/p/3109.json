[["句 其一","高登","残句",["瘴侵玉骨终难起，魂断巫山永不归。"],0,128,"宋"],null,["句","王觌","残句",["覆栏常浸桐阴冷，煮茗犹呈玉邑寒。"],0,161,"宋"],["句 其三","严中和","残句",["涧水活不冻，山枫老自灵。"],0,125,"宋"],["句 其五","吴光","残句",["花蕊有须浑带蜜，桑枝无叶已成衣。"],0,174,"宋"],["句","钱厚","残句",["暮霭不知天远近，闲云休碍月升沉。"],0,176,"宋"],["句","释德","残句",["伫看长空垂巨泽，直教四海尽丰登。"],0,194,"宋"],["句 其二十三","丁谓","残句",["白雪芬芳玉有香。"],0,131,"宋"],["句 其三","高荷","残句",["沙软绿头相并鸭，水深红尾自跳鱼。"],0,185,"宋"],["句 其十四","宋祁","残句",["都缘赋色浅，燧不趁春繁。"],0,"x49","宋"],["句 其三","陈尧佐","残句",["千里好山云乍敛，一楼明月雨初晴。"],0,103,"宋"],["句","陈雄飞","残句",["处顺心恒逸，无求道乃高。"],0,35,"宋"],["句 其四","杨绘","残句",["何必口辞山简醉，但教心似屈原醒。"],0,15,"宋"],["句 其五","吕本中","残句",["不用君王羯鼓敲。"],0,"x83","宋"],["句","李章","残句",["愿求裴令一篇诗。"],0,72,"宋"],["句 其二","李壁","残句",["一杯谩道愁能遣，几度醒来错唤君。"],0,80,"宋"],["句 其三","孙何","残句",["美人与月正同色，客子折梅空断肠。"],0,123,"宋"],["句  其一七","李彭","残句",["鸦啼古木乱云深。"],0,"x111","宋"],["句 其一","程大昌","残句",["著庭谨护箨龙儿，养就坚高抗雪姿。"],0,162,"宋"],["句","罗寿可","残句",["追思往事真堪恨，误却南兵是蔡州。"],0,86,"宋"],["句 其四","陈师道","残句",["白鸟过林分外明。"],0,"x60","宋"],["句 其九","陈尧佐","残句",["门前碧浪家家海，树上青山寺寺云。"],0,103,"宋"],["句 其三","成锐","残句",["凭高看渐远，更上最高楼。"],0,10,"宋"],["句","王谹","残句",["水清居士涧，景好天王刹。"],0,25,"宋"],null,["句 其一","吴氏","残句",["故将罗袖裛啼痕。"],0,81,"宋"],["句","高元之","残句",["洒窗蚕食叶，入竹蟹行沙。"],0,187,"宋"],["句","蒋瑎","残句",["谁知清淡者，冬月亦登临。"],0,111,"宋"],["句 其十三","王随","残句",["晓色静和迷远径，晴光轻重织平芜。"],0,57,"宋"],["句 其一","王存","残句",["病鸾方振翼，饥隼乍离鞲。"],0,75,"宋"],["句 其五","韩维","残句",["一笛西风吹落日，满帆行客背孤城。"],0,"x114","宋"],["句 其四","丁谓","残句",["梅花过岭路，桃叶渡江船。"],0,131,"宋"],["句 其四","李壁","残句",["向来交态云翻手，静里无言石点头。"],0,80,"宋"],["句 其五","杨绘","残句",["烂紫妖红色尽卑。"],0,15,"宋"],["句 其二","陶去泰","残句",["富川郡治居高闲，万顷平湖几案间。"],0,31,"宋"],["句","陈公辅","残句",["有德传乡里，无金遗子孙。"],0,141,"宋"],["句","余玠","残句",["老子也曾来伺候，诸公聊复忍须臾。"],0,92,"宋"],["句","李孚","残句",["宫柳不知兴废事，春来还是绿纤纤。"],0,222,"宋"],["句","令狐揆","残句",["借书离近郭，冒雪渡寒溪。"],0,192,"宋"],["句","谢公定","残句",["一官如马小，众眼似衫青。"],0,166,"宋"],["句 其四","苏辙","残句",["清江入城郭，小浦生微澜。"],0,"x135","宋"],["句 其三","赵佶","残句",["北斗七星三四点。"],0,"x109","金"],["句 其十二","胡铨","残句",["中有羁孤湿帽尖。"],0,241,"宋"],["句 其四","曾布","残句",["海门西北起崇邱，极目参差见五州。"],0,67,"宋"],["句","郑内翰","残句",["西风吹得一枝生，昂首风前飞不