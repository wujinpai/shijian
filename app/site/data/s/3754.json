[["浣溪沙 送春","高濂","荷叠青钱柳脱绵。","词"],["长相思 题情二首","高濂","风淅淅，雨纷纷。","词"],["惜分钗 即事","高濂","桃花路。","词"],["好事近 春景","高濂","花信几番风，又早清明时候。","词"],["风入松 春湖","高濂","红烟紫雾隐楼台。","词"],["西江月 题情，代作","高濂","有恨不随流水，闲愁惯逐飞花。","词"],["浪淘沙 山居十首","高濂","门外柳条黄。","词"],["采莲子 银莲","高濂","霜冷汀洲云冷波，水中花撒小银杯。","词"],["望江南　　本意","吴伟业","江南好，聚石更穿池。","词"],["如梦令　　闺情","吴伟业","镇日莺愁燕懒，遍地落红谁管。","词"],["望江南  本意","曹溶","江南远，乳燕不曾来。","词"],["浣溪纱  四十年来所见歌姬某氏最丽赠之","曹溶","仕女行来乐部同，双垂罗带鬓蝉松，心儿旖旎锦堂中。","词"],["清平乐  题壁","曹溶","云屏十二，仙客曾同醉。","词"],["少年游  寄项嵋雪","曹溶","客囊清减似穷秋，典尽酒家裘。","词"],null,["蝶恋花 杏花","曹溶","深巷卖花将客唤。","词"],["荷叶杯  怨思","曹溶","细雨江边春缆，绿暗。","词"],["鹧鸪天 壬申春夜梦中作五首","叶小鸾","一卷楞严一炷香。","词"],["忆江南 湖上曲十二阕","沈宜修","湖上柳，罗带舞风轻。","词"],["忆江南 冬景八阕","沈宜修","寒夜月，景墅最凄然。","词"],["蝶恋花 桂","沈宜修","蟾兔清辉浮碧树。","词"],["渔家傲 丁丑重九日猎边外龙安山次先贤范希文词","卢象升","怪是重阳风雨恶。","词"],null,["玉蝴蝶 感春四首","叶纨纨","满目韶光明丽，东风拂拂，花影悠悠。","词"],["采桑子 秋闺","张夏","针楼共上呼俦侣，薄薄罗裳。","词"],["千秋岁 旅怀","张夏","出为小草。","词"],["忆秦娥","方以智","花如雪，东风夜扫苏堤月。","词"],null,["江城子","陈子龙","一帘病枕五更钟，晓云空，卷残红。","词"],null,null,null,null,["陇头歌","王世贞","陇水霏微，望如一丝。","四言"],["安东平","王世贞","荒鸡嚘喔，残月沈魄。","四言"],["安东平","王世贞","孟冬十月，雨雪霏霏。","四言"],["公无渡河三首","胡应麟","公无渡河，大河扬波。","四言"],["安东平","胡应麟","严冬凛烈，北风雨霜。","四言"],null,null,null,null,null,["和方山子歌 仆夫歌","李梦阳","饯者在郊，黄鸟交交。","四言"],["黄河谣二首","陈恭尹","口哆声嗔，招舟孟津。","四言"],null,null,null,null,["泉之滨哀隐士也","边贡","泉之滨兮，白石磷兮。","四言"],null,null,null,["八章 朱矶","郭之奇","湖沙漠漠，非人所乐。","四言"],null,null,null,null,null,["题画二首 圯桥进履","湛若水","进履之心，可以授道。","四言"],null,null,null,["题兰","刘崧","山则有石，谷则有兰。","四言"],null,null,null,null,["萧子志三多忧为病书来问药答此","成鹫","蜉蝣命短，龟鹤日长。","四言"],null,["陇头歌","释函可","陇头流水，或西或东。","四言"],null,null,["集古雅歌题慕溪兼贺寿","霍与瑕","山有蕨薇，薄言采之。","四言"],["寒食","霍与瑕","春华敷荣，春日渐阳。","四言"],null,null,null,null,null,null,null,null,null,null,null,null,null,["客有惠予菜图者予悬之斋头日夕爱之书俚言自勖","邹元标","咬得菜根，百事可成。","四言"],null,null,null,null,null,null,null,null,["黄石斋举子同馆勒双卮以寿","倪元璐","杏坛推才，五台选德。","四言"],["为胡甥武迁题扇石奉陈明卿祭酒","倪元璐","结为地脉，奋为星精。","四言"],null,null,null,["和陶诗 停云","李贤（原德","瞻彼停云，载风载雨。","四言"],["和陶诗 时运","李贤（原德","风其和矣，零雨崇朝。","四言"],["和陶诗 荣木","李贤（原德","荣木攸攸，春光在兹。","四言"],["和陶诗 赠长沙公族祖","李贤（原德","君子之泽，世远则疏。","四言"],["和陶诗 答庞参军","李贤（原德","林下优游，伴我惟书。","四言"],["和陶诗 劝农","李贤（原德","夫古后稷，伟哉哲人。","四言"],["和陶诗 命子","李贤（原德","厥初我祖，始侯于唐。","四言"],["和陶诗 归鸟","李贤（原德","有鸟来归，栖于旧林。","四言"],null,null,null,["独漉篇四首","何瑭","独漉独漉，水深没毂。","四言"],null,null,null,["安东平","景翩翩","西风吹衣，北风吹面。","四言"],["渔樵耕读四首","任环","明月扁舟，芦花浅水。","四言"],null,null,null,["应尽须尽吟","顾允成","应尽须尽，行法俟命。","四言"],["求儆里言","顾允成","圣哉仲尼，五十无过。","四言"],null,null,null,null,null,["莞草","卢祥","菀彼莞草，其色芃芃。","四言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["赠贾司教先生 其一","何景明","春风桃李绛帐，朝日苜蓿空盘。","六言"]]