[null,null,null,null,null,null,["颂古五首","释如净","无忧树下浴婴孩，清晓蔷薇带露开。","七言律诗"],null,null,null,null,null,null,["华严院","黄彦平","懒病寻幽意已忘，兹辰得与步同冈。","七言律诗"],null,["清溪解缆用秀才甫韵寄杜藏用 其一","黄彦平","九华晴云今日阴，清溪涨水夜来深。","七言律诗"],null,null,null,null,null,null,null,null,null,null,["次韵沈元用游天台三首 其二","吕颐浩","山居犹不厌山行，石磴攲危步履轻。","七言律诗"],["次韵李德升老堂 其一","吕颐浩","腐儒才术本庸庸，祖业安能效太公。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["濉阳八景 其一 洋背春烟","黄元实","平芜百亩敞南郭，四散人家隐篱落。","七言律诗"],["濉阳八景 其二 河潭秋月","黄元实","苍涯倒浸太阴黑，倾动变化在倏忽。","七言律诗"],["濉阳八景 其三 东川梵宇","黄元实","碧空直耸石桥杪，一径林间几萦绕。","七言律诗"],["濉阳八景 其四 铙山晴雪","黄元实","嵬嵬圣石倚霄汉，障断濉南山一半。","七言律诗"],["濉阳八景 其五 湖障夕阳","黄元实","溪西诸峰崒且壮，一峰秀出横屏幛。","七言律诗"],["濉阳八景 其七 长吉晓钟","黄元实","沈沈绀宇据城阜，屹屹云楼挹星斗。","七言律诗"],["濉阳八景 其八 迎厘午磬","黄元实","凤山胜绝三不见，竹木苍苍隔台殿。","七言律诗"],["武夷山二首 其一","黄元实","宾云奏彻控青鸾，彩幔香销生翠寒。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["句","张先","愁似鳏鱼知夜永，懒同蝴蝶为春忙。","七言律诗"],null,null,null,null,null,null,null,null,["谢惠椒酱 其二","谢枋得","孔子也食蔬菜羹，羹中无酱味不全。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["田间辞三首 其一","崔敦礼","朝余往兮苍东畴，景翳翳兮云油油。","七言律诗"],null,["登黄鹤楼","张咏","重重轩槛与云平，一度登临万想生。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["至启伏蒙仆射相公以小子近司靶阁罕扣芜音忽征庸陋之词盖示记怜之旨特贻篇什俯耀行藏捧玩无厌感戴交切谨依高韵奉和聊抒下情","李至","句无骚雅口难开，岂称明公唱和才。","七言律诗"],["残春有感 其一","李至","阴阴垂柳转黄鹂，肠断残春欲去时。","七言律诗"],["所苦之中无以遣闷更题新竹别献五章幸赐披览 其一","李至","牡丹灼灼看何厌，芍药