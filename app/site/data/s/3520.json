[["杨梅","释祖可","五月杨梅已满林，初疑一颗价千金。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["题史子仁碧沚 其一","吕祖俭","相家小有四明山，更葺桃源渺莽间。","七言律诗"],null,["江上师溃","彭秋宇","江上西风督戍秋，国人延颈捷随收。","七言律诗"],["感旧","彭秋宇","督府由来十六秋，几回祈去几回留。","七言律诗"],["罪言","彭秋宇","四境风寒满目秋，区区嫠妇隐深忧。","七言律诗"],null,null,["清明日游鹤林寺 其一","王野","蒿目黄尘扰扰间，出门偶到鹤林山。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["简雪窗董寺丞","周端臣","世路机心走兔迒，雪窗一缕不遮藏。","七言律诗"],null,null,null,["碧鸡草堂呈刘后村","宋庆之","斯文海内声名阔，犹是干淳一脉馀。","七言律诗"],null,null,null,null,null,["庆老石帆庵","李邴","鹑作衣裳铁作肝，老将身事付寒岩。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["寿赵推官 其一","赵福元","天枝分秀蔼璇杓，光涌银河半夜潮。","七言律诗"],["寿赵推官 其二","赵福元","郁葱佳气晓笼天，北斗倾霞入酒船。","七言律诗"],["庵居 其二","释仲皎","无地卓锥生计难，且空双手到林间。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,["尹洛日作","吕蒙正","昔作儒生谒贡闱，今提相印出黄扉。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,["次韵秦会之题墨梅二首 其一","张子文","南枝春色弄微温，记得清香扑酒尊。","七言律诗"],null,null,null,["海榴花","方九功","春花落尽海榴开，奇种谁分宝地栽。","七言律诗"],null,null,null,null,null,null,null,["乐庵所藏柳影及松梅二画因作二绝摹作砑花笺至今盛行于吴门","李衡","三月江南花满枝，风轻帘幕燕争飞。","七言律诗"],null,null,null,null,null,null,null,null,["百万湖","王?","台下弥漫百万湖，丛生萑苇伴菰蒲。","七言律诗"],null,null,null,null,null,["赠谈命江文魁","翁溪园","四十头颅昨自知，行年懒问斗牛箕。","七言律诗"],null,["十二月立春","胡安国","未临除夕气先交，玉嶂朝来见日消。","七言律诗"],null,null,null,null,null,null,null,null,null,["游瑞象寺和杜梦麟韵","赵希𬞟","招提深僻好山重，湿翠阴森一径松。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,["送程给事知越州 其一","何正臣","史君承诏出黄扉，急桨翩翩画鹢飞。","七言律诗"],null,null,null,null,["题张仲隆快目楼壁","刘仙伦","天上张公百尺楼，眼高四海气横秋。","七言律诗"],["题岳阳楼","刘仙伦","八月书空雁字联，岳阳楼上俯晴川。","七言律诗"],null,null,["送张无梦归天台山 其一","初炜","闲倚天台看曙霞，自然龙汉度无涯。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["暖翠","安?","暖翠浮岚万壑春，桃花流水碧沄沄。","七言律诗"],["孺子亭","宗必经","连天大厦莫容身，小向湖边一问津。","七言律诗"],null,["次太守郑安恭探梅过西湖韵 其一","张栋","亭亭冰质照溪明，㶁㶁如闻环佩声。","七言律诗"],null,null,null,null,null,null,null,["句","徐仲谋","湖上风涛或泛浮，城南因立镇湖楼。","七言律诗"],null,null,null,null,null,["玉簪花","方广德","不信搔头花㡳重，数茎秋濯露溶溶。","七言律诗"],["石榴","方广德","涂林疏树自离离，入眼红肤总不遗。","七言律诗"],null,["重游临武秀岩 其一","曾晞颜","琼楼玉宇落荒村，鸡犬无声到洞门。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["句","梁安世","更说此州异特事，寇公归后二苏来。","七言律诗"],null,["大涤洞 其七","槻伯圜","松筠玉立见长身，琼馆沉沉远楚氛。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["梅岩 其一","赵崇乱","嵌空天影落元间，更著梅花迥莫攀。","七言律诗"],null,["饯魏州判鹏举","邵桂子","松下吟哦几唱酬，却携螃蟹饯监州。","七言律诗"],["登谢公楼","邹应龙","沿岸城廓开翠屏，南山毓秀欲腾云。","七言律诗"],["睡觉","郑茜","玉炉香断瑞烟微，小院阴岑夹幕垂。","七言律诗"]]