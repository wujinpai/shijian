[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["集古 惜花","李俊民","花树流莺日过迟，少年争惜最红枝。","七言律诗"],["集古 送春","李俊民","可怜寥落送春心，负郭依山一径深。","七言律诗"],["集古 赠别","李俊民","萧萧落叶送残秋，楼上黄昏欲望休。","七言律诗"],["集古 恨别","李俊民","凄凄长是别离情，冰簟银床梦不成。","七言律诗"],["集古 戏遣","李俊民","雨散云收一饷闲，不知何处入空山。","七言律诗"],["集古 不遇","李俊民","来往风尘共白头，谁人肯向死前休。","七言律诗"],["集古 仙庙","李俊民","桂泠松香十里闲，水晶如意玉连环。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["登凤凰台二首 其二","萨都剌","梧桐叶落秋风老，人去台空凤不来。","七言律诗"],["送王真人北上代刘宗师","萨都剌","玉佩丁东下界闻，天风吹动碧霞裙。","七言律诗"],["还京口","萨都剌","黄鹤山头雪未消，行人归计在今朝。","七言律诗"],["和参政王继学海南初还韵","萨都剌","飘零南北与东西，倦鸟投林未许栖。","七言律诗"],null,null,null,["还台偶成","萨都剌","高低柳絮飞渡水，红白桃花开满枝。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["彭城杂咏四首","萨都剌","城下黄河去不回，四山依旧翠屏开。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["题西庵所藏佛牙","耶律铸","旃檀奁里贮灵牙，来自中天尊者家。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["画  太白诗意","凌云翰","君去还当我醉时，东坡解道谪仙诗。","七言律诗"],null,null,null,["二仙像 铁拐","凌云翰","一拐随身四海闻，剑锋久暗七星文。","七言律诗"]]