[null,null,["【正宫】白鹤子","关汉卿","四时春富贵，万物酒风流。","五言绝句"],["句 其五","赵佶","方当月白风清夜，正是霜高木落时。","七言绝句"],["宫词 其四","赵佶","宫嫔馀乐称幽闲，不喜浓妆斗媚颜。","七言绝句"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["宫词 其一","赵佶","晓景熙熙竹影疏，柔闲初理薄妆馀。","七言绝句"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["温日观葡萄","邓文原","满筐圆实骊珠滑，入口甘香冰玉寒。","七言绝句"],["秋日书事","马定国","井边薏苡吐秋珠，舍下瓜区杂芋区。","七言绝句"],["九日月中对菊同禧伯郎中赋六首 其五","张本","鬼化斯文念贾生，精神雕琢坐寒更。","七言绝句"],["济源庙海子内有二鼋人以将军目之投饼饵则至","郦权","我欲燃犀起蛰雷，漫夸海蘸纸钱灰。","七言绝句"],["次韵张仲宗","元干","中台宏议裨初政，学省雄文畏后生。","七言绝句"],["题庐陵义士传","刘彦章","淮海风回吹血腥，青原不改旧时青。","七言绝句"],null,null,null,null,null,null,null,null,null,null,null,null,["漫兴","萨都剌","去岁干戈险，今年蝗旱忧。","五言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["吉祥草","王冕","得名良不恶，潇洒在山房。","五言律诗"],null,null,null,null,null,null,null,["济州登太白楼怀郑从之御史二首 其一","曹伯启","高城蘸云根，聊可慰心迹。","五言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["宿台山寺绝顶","卢琦","江白潮已来，山黑月未出。","五言律诗"],null,null,null,["吴兴杂咏","朱晞颜","吴兴山水窟，清远古今闻。","五言律诗"],null,null,null,null,null,null,null,null,null,null,["寄衣曲 其一","宋无","闻有宫袍赐，翻令闺意伤。","五言律诗"],["自君之出矣二首 其一","宋无","自君之出矣，妾不出闺门。","五言律诗"],null,null,null,null,["观物 其二","许衡","万物备吾身，身贫道未贫。","五言律诗"],["水南晚眺","周昂","小径通沙稳，清溪带树深。","五言律诗"],null,["次韵鉴中八咏 其八 芬陀室","于立","视心如莲花，净明涵十虚。","五言律诗"],["次韵鉴中八咏 其四 梅山","于立","梅山如积翠，的皪手堪捧。","五言律诗"],null,["班婕妤 其一","张玉娘","一自怜捐弃，香迹玉阶疏。","五言律诗"],null,null,null,null,null,null,["和章守","元振","华堂存绘事，昭代得仪刑。","五言律诗"],["和章守","元振","飞楼跨危堞，云雾晓披披。","五言律诗"],null,["望云","黄石翁","日出五丈高，白云浩如海。","五言律诗"],["次友之秋日雨后韵","王涧","洺州秋雨后，幽胜可供闲。","五言律诗"],["高端叔挽词","元之","铁石赋梅花，闲情白玉瑕。","五言律诗"],null,null,null,null,null,["写怀","吕中孚","秦川西去远，不意过漳川。","五言律诗"]]