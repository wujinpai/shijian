[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["闲中好二首","左锡璇","闲中好，月色穿窗冷。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,["四犯剪梅花 回山息影，闭户理愁。读六禾蓼芦二词，泠然秋色动摇几案间，愈难为怀。爰依韵和之 辘轳金井·芦花","杨玉衔","鲤鱼风起。","杂言"],null,null,null,null,null,null,null,null,null,null,["拟古","纳兰性德","客从东方来，叩之非常流。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["海氛清","叶方霭","巨浸稽天，滔滔如何？","杂言"],null,["咏史 南齐","吴氏","六贵同朝激虎彪，横江勒马下秦州。","杂言"],null,null,null,null,null,null,null,null,null,null,null,["琴意诗 梅花三弄","张梁","《梅花》本笛曲，淡淡入我弦。","杂言"],null,null,null,null,null,null,null,null,null,null,null,["草地人","李乔","台阳膏腴地，一岁或三熟。","杂言"],["乌烟鬼","李乔","乌烟鬼，少年状貌真魁伟。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["客氏拜","乔亿","客氏拜，拜阿谁。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["宝山行","吴瞻泰","冬青郁郁空山里，种树何年星在尾。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["减兰 和素姊双侬妆楼作","曹景芝","疏帘低卷。","杂言"]]