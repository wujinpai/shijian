[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["真味堂","李纯甫","问渠真味若为言，不著盐梅也自全。","七言律诗"],["天游斋","李纯甫","丈人未始出吾宗，草靡波流尽太冲。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["和完学士晚出丽正门","甘立","暮光霞彩炫金题，绛阙高居雉堞低。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,["挽林武博二首","元晋","畴昔论交四十霜，知公出处我尤详。","七言律诗"],["挽林武博二首","元晋","郭令科名翁冠绝，董生制策子蝉联。","七言律诗"],null,["答方俊甫投赠二首","元美","李杜坛高未易扳，鲸波浩渺鹤天宽。","七言律诗"],["答方俊甫投赠二首","元美","抽还手板把随如，甘向三家村卜居。","七言律诗"],null,null,null,null,null,["夜夜曲","李仲南","玉窗结怨歌幽独，弦绝鸾胶几时续。","七言律诗"],null,null,null,null,null,null,null,null,["送文郎中奉使交趾","薛玄曦","天子龙飞统万邦，玉符封检下殊方。","七言律诗"],null,null,null,null,["送国王朵儿只就国","陆友","奕世名王策骏功，远分茅土镇辽东。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["春日田园杂兴","了慧","平畴水绕径微分，小圃云深景不繁。","七言律诗"],["潮","仇仁远","一痕初见海门生，顷刻长驱作怒声。","七言律诗"],["滕王","元婴","君王台榭枕巴山，万丈丹梯尚可攀。","七言律诗"],["次韵谢吕君","元方","鄂城未至客湓城，谁识惓惓欲见情。","七言律诗"],["次韵荆门张守寺簿","元简","不把离忧寄楚辞，绝嗤致邑请臧为。","七言律诗"],null,null,null,null,null,null,null,null,["梅魂","张观光","梦觉罗浮迹已陈，至今想像事如新。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,["挽陆秀夫","盛彪","紫宸黄阁共楼船，海气昏昏日月偏。","七言律诗"],null,null,null,null,null,null,null,null,null,["春日田园杂兴","陈君用","春风冗我田园务，野思芳情约不齐。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,["和戴帅初陪廉宪副游三天洞韵二首 其一","王珪","胜迹三天洞，清游五字诗。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["送管元帅南征","萨都剌","楚帆风一叶，此去几时还。","五言长篇"]]