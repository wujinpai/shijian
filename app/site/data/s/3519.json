[null,null,null,["次韵德修弟","陶梦桂","一笑相逢在眼前，底须尺素付邮传。","七言律诗"],null,null,["黄金堤","卢襄","昆仑一线破苍崖，霹雳飞声趁地来。","七言律诗"],["途中书怀寄奉化知县二首 其二","卢襄","奔驰渐觉岁峥嵘，负郭芜田未退耕。","七言律诗"],["石桥道中三首 其三","卢襄","足根重茧寸心灰，故里田园好在哉。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["次韵环翠亭","郑侠","天围湖海净团𪢮，水色山光四座寒。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["白海青","汤炳龙","皂雕赤鹘世纷纷，羽翮何如白线纹。","七言律诗"],["绣毬花","汤炳龙","谁掷流苏满小园，无心花萼密相联。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["次吴良贵雪中归韵","方樗","匆匆策马出林扉，不及江头揽别衣。","七言律诗"],["吴仲恭翠微楼九日落成和谢皋羽","方樗","层构初成一快登，新题招客共兹辰。","七言律诗"],["呈吴学士新第落成","方樗","一山遥接袅溪水，甲第宏开相府居。","七言律诗"],null,null,null,null,null,null,null,null,null,null,["挽李行甫","邓剡","倘使平生马少游，不将乡里博封侯。","七言律诗"],null,null,null,null,null,null,null,null,["送黄修永之武夷杜清碧学","刘埙","眼中尘中政昏昏，华盖风高翠入云。","七言律诗"],["鹤","刘埙","延颈池边照影池，花明柳净思依依。","七言律诗"],["燕","刘埙","万里来从海外村，定巢时听语频频。","七言律诗"],["西捷","刘埙","神器宁容小智窥，黄河河上集王师。","七言律诗"],["拜南丰先生墓","刘埙","崖挟飞泉响佩环，云涵空翠锁幽关。","七言律诗"],["率诸友祭南丰先生墓","刘埙","星斗文章焕九天，萧萧松槚暗荒阡。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["建炎丞相成国吕忠穆公退老堂 其一","张澄","均佚归来一品崇，赤城新野焕仙风。","七言律诗"],["文昌轩","张澄","峭茜云烟晓骑迷，地偏心远爱林扉。","七言律诗"],null,null,null,null,null,null,null,null,null,null,["呈杨侍郎","田锡","权分忧寄理漳滨，惠化何曾及相民。","七言律诗"],["干明节祝圣寿 其一","田锡","百辟欢呼降诞辰，金樽献酒愿千春。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["玉清宫与赵达夫鲜于枢联句二首 其二","白珽","巾子峰头舣钓船，初阳台上坐鸣弦。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["锦屏山","鲜于侁","分命叮咛诏旨宽，昼归聊憩锦屏山。","七言律诗"],null,null,null,null,null,null,["远色阁","何耕","小小楼居著散仙，渊明真趣本幽然。","七言律诗"],null,null,null,["寿周丞相益公 其四","刘子寰","昨丙辰年相魏公，当时克敌首归功。","七言律诗"],null,null,null,null,null,null,null,null,["重阳对菊得开字","方梓","江源旧社兹重来，素车欲返犹徘徊。","七言律诗"],["次吴良贵雪中归韵","方梓","儿时谐笑几庐扉，聚散浮云天上衣。","七言律诗"],["吴仲恭翠微楼九日落成和谢皋羽","方梓","新楼招乐偶今朝，与客登临四望遥。","七言律诗"],["寄吴立夫","方梓","寻师负笈频千里，授业登堂此一时。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["清江曲 其一","苏庠","属玉双飞水满塘，菰蒲深处浴鸳鸯。","七言律诗"]]