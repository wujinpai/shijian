[null,["题杂画四首 蝴蝶","欧大任","倦雨宿南葑，穿烟起西□。","杂言"],null,null,null,null,null,["朱明洞景八首 浮邱别墅","卢龙云","旧社窥丹井，开林别有天。","杂言"],["题小景八首 渔","卢龙云","风清鸥鹭渚，波静荻芦湾。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["闲居七咏孙建侯赋 映雪","邓云霄","开窗临积雪，片玉坠遥天。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["秋日园居口号六十章","张萱","径荒客少门常楗，濯魄台前新月偃。","杂言"],null,null,null,null,["十禽言","张萱","郭公郭婆，郭公郭婆，为乐孔多。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,["禽言六首","李梦阳","泥滑滑，车马不得安，何不停车絷马待泥干。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,["谒陵游九龙池八首 渡石涧","程敏政","驱马渡南涧，涧水清且驶。","杂言"],["追思旧游寄浙江左时翊参政十绝次草庭都尉韵","程敏政","湖船诗十联，半入烟霞气。","杂言"],null,null,null,null,null,null,null,["庆宣和 行住坐卧卷","程敏政","银屏金屋逞骄奢。","杂言"],null,null,null,null,["湘山杂诗十首 古塔","顾璘","古塔已千载，白骨为黄金。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["十二月十八日至蕲阳舍舟从兴国走咸宁道出金牛镇山路如刀脊飞雪浸肤舆人艰窘几不能步然千峰缀雪或如鸦鵛或如积琼亦行役之一快也道中随事口占遂得十六绝句","袁宏道","江行值逆风，陆行招雪雨。","杂言"],null,null,null,null,null,null,null,["别石篑","袁宏道","别石篑，石篑何忍别。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["铙歌 朱鹭","李攀龙","朱鹭猎其缨，茄下行。","杂言"],null,null,null,["神弦歌三首 宿阿曲","李攀龙","天门詄荡荡，地户郁沈沈。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["古像赞二百零五首 盘古","孙承恩","厥初洪荒，浑沌一气。","杂言"],null,null,null,null,null,null,null,null,null,null,null,["九望 望瑶台","区大相","瑶台兮云浮，菌阁兮蕙楼。","杂言"],["阿子歌　十首","郭之奇","六年刚载震，频夜梦维蛇。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,["九歌 出门","郭之奇","春王正兮予征，驾言北兮神京。","杂言"],null,null,null,null,["鄱阳舟中对匡庐小酌四首","林光","薄雾挟山光，推篷杯在手。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["龙州诗 