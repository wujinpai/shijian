,["黄石斋举子同馆勒双卮以寿","倪元璐","杏坛推才，五台选德。","四言"],["为胡甥武迁题扇石奉陈明卿祭酒","倪元璐","结为地脉，奋为星精。","四言"],null,null,null,["和陶诗 停云","李贤（原德","瞻彼停云，载风载雨。","四言"],["和陶诗 时运","李贤（原德","风其和矣，零雨崇朝。","四言"],["和陶诗 荣木","李贤（原德","荣木攸攸，春光在兹。","四言"],["和陶诗 赠长沙公族祖","李贤（原德","君子之泽，世远则疏。","四言"],["和陶诗 答庞参军","李贤（原德","林下优游，伴我惟书。","四言"],["和陶诗 劝农","李贤（原德","夫古后稷，伟哉哲人。","四言"],["和陶诗 命子","李贤（原德","厥初我祖，始侯于唐。","四言"],["和陶诗 归鸟","李贤（原德","有鸟来归，栖于旧林。","四言"],null,null,null,["独漉篇四首","何瑭","独漉独漉，水深没毂。","四言"],null,null,null,["安东平","景翩翩","西风吹衣，北风吹面。","四言"],["渔樵耕读四首","任环","明月扁舟，芦花浅水。","四言"],null,null,null,["应尽须尽吟","顾允成","应尽须尽，行法俟命。","四言"],["求儆里言","顾允成","圣哉仲尼，五十无过。","四言"],null,null,null,null,null,["莞草","卢祥","菀彼莞草，其色芃芃。","四言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["赠贾司教先生 其一","何景明","春风桃李绛帐，朝日苜蓿空盘。","六言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["白华园作","屈大均","舒卷因风雨，芭蕉亦有心。","杂言"],["子夜歌","屈大均","卿生东越东，妾生南越南。","杂言"],["古意","屈大均","赠欢百合根，根比?花好。","杂言"],null,null,null,null,null,null,null,["弹子矶谣","屈大均","一篙一尺，十篙一丈。","杂言"],["二妃操 益阳王妃","屈大均","为我殓王，送之北邙。","杂言"],null,null,null,["天净沙　塞上　八首","屈大均","沙如乱雪非来。","杂言"],["古调笑　二首","屈大均","蝴蝶。","杂言"],null,null,null,null,null,null,["弇园杂咏四十三首 清凉界","王世贞","步屧修竹林，银桥佛庐净。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["四十咏 皇甫佥事汸","王世贞","安定饶世业，八龙得其半。","杂言"],null,null,null,null,null,null,null,["西山诗 戊申冬以秩祀行作","王世贞","朝上西山，艰哉?崟。","杂言"],null,null,null,null,null,null,null,null,null,["乐府变十九首 治兵使者行当雁门太守","王世贞","今皇帝时，治兵使者任君繇。","杂言"],["地驱乐歌","王世贞","穹沙大潴，天公模糊。","杂言"],["读曲歌","王世贞","欢掷芙蓉花，悴如菉葹草。","杂言"],null,["五杂俎三首","王世贞","五杂俎，车中缨。","杂言"],["平城歌","王世贞","汉使来，胡马死。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["八哀诗 大司寇东吴王公世贞","胡应麟","洪荒忽中辟，宇宙钟人豪。","杂言"],["四知篇 新都汪司马伯玉","胡应麟","粤惟汉元封，司马两当轴。","杂言"],null,null,null,null,null,null,null,["五杂组诗二首","胡应麟","五杂组，中天霞。","杂言"],null,["陇头歌五首","胡应麟","尘起玉门关，雕弓马上弯。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,["归田趣 春牧","杨士奇","霜鬓萧萧，皇恩重、赐归田里。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["题杂画四首 蝴蝶","欧大任","倦雨宿南葑，穿烟起西□。","杂言"],null,null,null,null,null,["朱明洞景八首 浮邱别墅","卢龙云","旧社窥丹井，开林别有天。","杂言"],["题小景八首 渔","卢龙云","风清鸥鹭渚，波静荻芦湾。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["闲居七咏孙建侯赋 映雪","邓云霄","开窗临积雪，片玉坠遥天。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["秋日园居口号六十章","张萱","径荒客少门常楗，濯魄台前新月偃。","杂言"],null,null,null,null,["十禽言","张萱","郭公郭婆，郭公郭婆，为乐孔多。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,["禽言六首","李梦阳","泥滑滑，车马不得安，何不停车絷马待泥干。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,["谒陵游九龙池八首 渡石涧","程敏政","驱马渡南涧，涧水清且驶。","杂言"],["追思旧游寄浙江左时翊参政十绝次草庭都尉韵","程敏政","湖船诗十联，半入烟霞气。","杂言"],null,null,null,null,null,null,null,["庆宣和 行住坐卧卷","程敏政","银屏金屋逞骄奢。","杂言"],null,null,null,null,["湘山杂诗十首 古塔","顾璘","古塔已千载，白骨为黄金。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["十二月十八日至蕲阳舍舟从兴国走咸宁道出金牛镇山路如刀脊飞雪浸肤舆人艰窘几不能步然千峰缀雪或如鸦鵛或如积琼亦行役之一快也道中随事口占遂得十六绝句","袁宏道","江行值逆风，陆行招雪雨。","杂言"],null,null,null,null,null,null,null,["别石篑","袁宏道","别石篑，石篑何忍别。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["铙歌 朱鹭","李攀龙","朱鹭猎其缨，茄下行。","杂言"],null,null,null,["神弦歌三首 宿阿曲","李攀龙","天门詄荡荡，地户郁沈沈。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["古像赞二百零五首 盘古","孙承恩","厥初洪荒，浑沌一气。","杂言"],null,null,null,null,null,null,null,null,null,null,null,["九望 望瑶台","区大相","瑶台兮云浮，菌阁兮蕙楼。","杂言"],["阿子歌　十首","郭之奇","六年刚载震，频夜梦维蛇。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,["九歌 出门","郭之奇","春王正兮予征，驾言北兮神京。","杂言"],null,null,null,null,["鄱阳舟中对匡庐小酌四首","林光","薄雾挟山光，推篷杯在手。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["龙州诗 其一","湛若水","龙之山不兴雨云，山中之人不可以论。","杂言"],["闻雁二绝","湛若水","??北塞雁，肃肃向南飞。","杂言"],["新春出游白石试笔四首","湛若水","□日过人日，开关始一游。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["荔枝 浪淘沙","徐熥","高树锦蒸霞。","杂言"],null,null,null,null,null,null,null,null,null,null,null,["无俗念 游仙二首","杨慎","十年奔走，向红麈、何处可寻蓬岛。","杂言"],null,null,["天净沙 题画 惜花春早起","杨慎","霜天晓角声残。","杂言"],["阙调名 中秋夜小酌即席示二弟小词二首","杨慎","江树无烟。","杂言"],["黑漆弩 谢曾少岷题扇","杨慎","梁尘飞绕停教住。","杂言"],["金字经 二首 江上晚归","杨慎","璧月寒生晕，银河冻欲冰。","杂言"],null,null,["殿前欢 感通寺赠承冰壶炼帅、董西羽征君","杨慎","问冰壶。","杂言"],null,["一七令 舟中阅唐诗纪事王起李绅张籍令孤楚于白乐天席上各赋一字至七字诗以题为韵遂效其体为花风月雪四首宋人名","杨慎","花。","杂言"],null,["关岭曲贵州","杨慎","倦枕愁鸡鸣，问郎今日程。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["园居杂兴四十三首 兰","黄衷","甘露香何古，枯桐调自高。","杂言"],null,null,null,null,null,null,null,null,null,null,["为晋宁诸子说春秋口占自笑四首","王夫之","腹借征南库，灯邀汉寿光。","杂言"],["怀入山来所栖伏林谷三百里中小有丘壑辄畅然欣感各述以小诗得二十九首 排子岭","王夫之","稻亩绿茸茸，平田接回坞。","杂言"],["绝句八首","王夫之","黄鸟衔青虫，径飞入深箐。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,["十九秋 秋寺","成鹫","寂寞蒹葭外，微茫见佛灯。","杂言"],null,null,null,null,null,null,null,null,null,["题吴道延西征卷","郑真","万里烟沙惨淡中，西风遥跨锦花骢。","杂言"],null,null,null,null,null,null,["戏效读曲歌体六章","释函可","辛苦道傍井，辘轳无停时。","杂言"],null,null,null,null,null,null,null,null,null,null,["禽言","李之世","南山张缴北山罗，行不得哥哥。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["古意三首","郑善夫","蓬门霜雪繁，玉颜苦禁当。","杂言"],null,null,null,null,null,null,null,null,null,null,null,["挽乐义王公夫妇二首","张宁","海邑夸名族，清时乐永年。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["追挽谢都转令岳石厓秀才","符锡","乐公还自好，何预卫郎贤。","杂言"],["萍乡泛小舟下湘东绝句","符锡","昨日泸溪客，今朝此问津。","杂言"],["丙戍正月部兵赴南宁道中杂韵","符锡","蕞尔蛮夷长，干天不自量。","杂言"],null,null,null,null,null,null,null,null,null,["五子诗 谢山人榛","宗臣","谢生隐者流，偃蹇来京国。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["杂谣五首","王廷陈","茸茸者离，而子践之。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,["金字经 喜舍弟昌明至","李昌祺","雨意斑鸠唤，春光杜宇催。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["折杨柳歌","欧必元","欢爱并蒂花，侬爱同心草。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["箫谱　拟霓裳羽衣曲","伍瑞隆","玉城峨峨，白云匝银河。","杂言"],null,null,null,["明月斜 闺情","梁清标","漏三更，香一缕。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["画扇二首","董纪","世态有古今，江山本无异。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["转应曲 春雨","尤侗","春雨，春雨。","杂言"],null,["怨东风 客思","尤侗","蒲叶端阳寓。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["五惜 惜岁月","韩上桂","一惜曰：混沌既判，伦类斯繁。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,["题山水","方孝孺","欲向匡庐隐，出门知路难。","杂言"],null,null,null,null,null,null,null,null,["按察使张公宗政以客中写怀八绝见寄，聊和以荅","曹义","旧好惟取最，新诗?我思。","杂言"],null,["送时阴阳大正归仪真","曹义","慇勤千里寄香芹，珍重斯文气味新。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["题红梅三首","童冀","玉骨换丹砂，夜雪迷春色。","杂言"],null,null,["十宫词 吴宫","高启","芙蓉水殿屟廊东，白苎秋来不耐风。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,["金兰操二首","祝允明","金兰之猗猗兮。","杂言"],null,null,["八咏 禁省","祝允明","彤华耀芝盖，初旭浮绛缬。","杂言"],null,null,null,["五杂组","赵完璧","五杂组，宫姝色。","杂言"],null,null,null,null,null,["五杂组","童轩","五杂组，蜀锦裳。","杂言"],null,null,["鹦鹉曲 偶记北乐府咏渔父鹦鹉曲又名黑漆