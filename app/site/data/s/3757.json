[["新春出游白石试笔四首","湛若水","□日过人日，开关始一游。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["荔枝 浪淘沙","徐熥","高树锦蒸霞。","杂言"],null,null,null,null,null,null,null,null,null,null,null,["无俗念 游仙二首","杨慎","十年奔走，向红麈、何处可寻蓬岛。","杂言"],null,null,["天净沙 题画 惜花春早起","杨慎","霜天晓角声残。","杂言"],["阙调名 中秋夜小酌即席示二弟小词二首","杨慎","江树无烟。","杂言"],["黑漆弩 谢曾少岷题扇","杨慎","梁尘飞绕停教住。","杂言"],["金字经 二首 江上晚归","杨慎","璧月寒生晕，银河冻欲冰。","杂言"],null,null,["殿前欢 感通寺赠承冰壶炼帅、董西羽征君","杨慎","问冰壶。","杂言"],null,["一七令 舟中阅唐诗纪事王起李绅张籍令孤楚于白乐天席上各赋一字至七字诗以题为韵遂效其体为花风月雪四首宋人名","杨慎","花。","杂言"],null,["关岭曲贵州","杨慎","倦枕愁鸡鸣，问郎今日程。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["园居杂兴四十三首 兰","黄衷","甘露香何古，枯桐调自高。","杂言"],null,null,null,null,null,null,null,null,null,null,["为晋宁诸子说春秋口占自笑四首","王夫之","腹借征南库，灯邀汉寿光。","杂言"],["怀入山来所栖伏林谷三百里中小有丘壑辄畅然欣感各述以小诗得二十九首 排子岭","王夫之","稻亩绿茸茸，平田接回坞。","杂言"],["绝句八首","王夫之","黄鸟衔青虫，径飞入深箐。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,["十九秋 秋寺","成鹫","寂寞蒹葭外，微茫见佛灯。","杂言"],null,null,null,null,null,null,null,null,null,["题吴道延西征卷","郑真","万里烟沙惨淡中，西风遥跨锦花骢。","杂言"],null,null,null,null,null,null,["戏效读曲歌体六章","释函可","辛苦道傍井，辘轳无停时。","杂言"],null,null,null,null,null,null,null,null,null,null,["禽言","李之世","南山张缴北山罗，行不得哥哥。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["古意三首","郑善夫","蓬门霜雪繁，玉颜苦禁当。","杂言"],null,null,null,null,null,null,null,null,null,null,null,["挽乐义王公夫妇二首","张宁","海邑夸名族，清时乐永年。","杂言"]]