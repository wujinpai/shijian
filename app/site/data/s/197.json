[["郊庙歌辞 昭德皇后庙乐章 雍和","佚名","我将我享，尽明而诚。","四言"],["郊庙歌辞 昭德皇后庙乐章 雍和","佚名","公尸既起，享礼载终。","四言"],["郊庙歌辞 享太庙乐章 文舞","张说","圣谟九德，真言五千。","四言"],["郊庙歌辞 五郊乐章 青帝角音 肃和","魏征","玄鸟司春，苍龙登岁。","四言"],["郊庙歌辞 蜡百神乐章 雍和","佚名","缇籥劲序，玄英晚候。","四言"],["郊庙歌辞 享太庙乐章 大和舞","张说","退居江水，郁起丹陵。","四言"],["郊庙歌辞 禅社首乐章 其三 肃和","贺知章","黄祇是祗，我其夙夜。","四言"],null,["补周礼九夏系文   二","皮日休","爣爣皎日，歘入于地。","四言"],["补周礼九夏系文   二","皮日休","杳杳阴竹，坎坎路鼓。","四言"],["补周礼九夏系文   二","皮日休","既醑既酢，爰朄爰舞。","四言"],["补周礼九夏系文   二","皮日休","凤之愉愉，不篝不笯。","四言"],["补周礼九夏系文   二","皮日休","王有虎臣，锡之圭瓒。","四言"],["补周礼九夏系文   二","皮日休","厥流浩漾，厥势嵯峨。","四言"],["补周礼九夏系文   二","皮日休","礼酒既竭，嘉宾既悦，应为之节。","四言"],["补周礼九夏系文   二","皮日休","桓桓其珪，衮衮其服。","四言"],null,["郊庙歌辞 五郊乐章 赤帝徵音 雍和","魏征","昭昭丹陆，奕奕炎方。","四言"],["郊庙歌辞 祀雨师乐章 迎俎酌献","包佶","阳开幽蛰，躬奉郁鬯。","四言"],["郊庙歌辞 享太庙乐章 光大舞","佚名","大业龙祉，徽音骏尊。","四言"],null,null,["郊庙歌辞 五郊乐章 白帝商音 雍和","魏征","律应西成，气躔南吕。","四言"],null,["郊庙歌辞 祀风师乐章 迎神","包佶","太皞御气，句芒肇功。","四言"],["乐府杂曲 鼓吹铙歌曲十二篇 其九 靖本邦","柳宗元","本邦伊晋，惟时不靖。","四言"],["五郊乐章 赤帝徵音 雍和","魏征","昭昭丹陆，帟帟炎方。","四言"],["咏方圆动静","李泌","方如行义，圆如用智。","四言"],["郊庙歌辞 祀雨师乐章 迎神","包佶","陟降左右，诚达幽圜。","四言"],null,null,null,["倬彼我系 其八","王勃","有鸟反哺，其声嗷嗷。","四言"],null,["倬彼我系 其三","王勃","伊我有器，思逢其主。","四言"],["郊庙歌辞 明皇祀圜丘乐章 雍和","佚名","烂云普洽，律风无外。","四言"],["江有枫一篇十章 三","萧颖士","想彼槭矣，亦类其枫。","四言"],["郊庙歌辞 享先农乐章 雍和","褚亮","前夕视牲，质明奉俎。","四言"],["江有枫一篇十章 九","萧颖士","有鸟有鸟，粤鸥与鹭。","四言"],["江有枫一篇十章 六","萧颖士","我朋在矣，彼陆之子。","四言"],["郊庙歌辞 仪坤庙乐章 寿和","徐坚","于穆清庙，肃雍严祀。","四言"],["倬彼我系 其九","王勃","从役伊何，薄求卑位。","四言"],null,["祭汾阴乐章","贾曾","蠲我渐饎，洁我膋芗。","四言"],["补乐歌十首  一","元结","猗太帝兮，其智如神。","四言"],["郊庙歌辞 仪坤庙乐章 金奏","佚名","阴灵曜祉，轩曜降精。","四言"],["判行营将士申请裹粮","宋光嗣","才请冬赐，又给行装。","四言"],["郊庙歌辞 祭汾阴乐章 寿和","苏颋","礼物斯具，乐章乃陈。","四言"],["江有枫一篇十章 十","萧颖士","此惧惟何，惧寘于罗。","四言"],["郊庙歌辞 祭神州乐章 雍和","褚亮","泰折严享，阴郊展敬。","四言"],["郊庙歌辞 享文敬太子庙乐章 送神","张荐","三献具举，九旗将旋。","四言"],["补乐歌十首  二","元结","猗太帝兮，其功如天。","四言"],["郊庙歌辞 五郊乐章 青帝角音 雍和","魏征","大乐稀音，至诚简礼。","四言"],["郊庙歌辞 祭汾阴乐章 顺和","源光裕","方丘既膳，嘉飨载谧。","四言"],["郊庙歌辞 禅社首乐章 雍和","贺知章、源乾曜","夙夜宥密，不敢宁宴。","四言"],["倬彼我系 其五","王勃","爰述帝制，大搜王道。","四言"],null,["郊庙歌辞 禅社首乐章 太和","贺知章、源乾曜","肃我成命，于昭黄祇。","四言"],["郊庙歌辞 禅社首乐章 太和","贺知章、源乾曜","昭昭有唐，天俾万国。","四言"],null,["享太庙乐章","萧倣","于铄丕嗣，惟帝之光。","四言"],["中和乐九章 歌东军第三","卢照邻","遐哉庙略，赫矣台臣。","四言"],["郊庙歌辞 仪坤庙乐章 雍和","员半千","孝享云毕，维彻有章。","四言"],["鹡鸰颂","李隆基","伊我轩宫，奇树青葱，蔼周庐兮。","四言"],["郊庙歌辞 祭[太]社乐章 雍和","褚亮","美报崇本，严恭展事。","四言"],["江有归舟三章 一","萧颖士","江有归舟，亦乱其流。","四言"],["讲古文联句","皎然","帝出于震，文明始敷。","四言"],null,["江有归舟三章 三","萧颖士","彼游惟帆，匪风不扬。","四言"],null,["郊庙歌辞 祀圜丘乐章 寿和","褚亮","八音斯奏，三献毕陈。","四言"],["郊庙歌辞 享太庙乐章 大顺舞","郑𬘡","于穆时文，受天明命。","四言"],["郊庙歌辞 祀圜丘乐章 雍和","褚亮","钦惟大帝，[载]仰皇穹。","四言"],["江有归舟三章 二","萧颖士","舟既归止，人亦荣止。","四言"],["重联句一首","皎然","肃肃清院，翛翛碧鲜。","四言"],null,null,["中和乐九章 歌明堂第二","卢照邻","穆穆圣皇，雍雍明堂。","四言"],["郊庙歌辞 中宗祀昊天乐章 太和","佚名","恭临宝位，肃奉瑶图。","四言"],["郊庙歌辞 仪坤庙乐章 永和","祝钦明","閟宫实实，清庙微微。","四言"],["祝牛宫辞","陆龟蒙","四牸三牯，中一去乳。","四言"],["春昼","韩偓","春融艳艳，大醉陶陶。","四言"],["中和乐九章 歌公卿第八","卢照邻","蹇蹇三事，师师百僚。","四言"],["郊庙歌辞 武后明堂乐章 皇帝行","武则天","仰膺历数，俯顺讴歌。","四言"],["郊庙歌辞 周宗庙乐舞辞 咸顺","佚名","万舞咸列，三阶克清。","四言"],["郊庙歌辞 雩祀乐章 雍和","褚亮","绀筵分彩，珤图吐绚。","四言"],["咏方圆动静示李泌","张说","方如棋局，圆如棋子。","四言"],["菊荣一篇五章 四","萧颖士","采采者菊，于宾之馆。","四言"],["郊庙歌辞 仪坤庙乐章 坤贞","薛稷","乾道既亨，坤元以贞。","四言"],null,["菊荣一篇五章 二","萧颖士","采采者菊，于邑之城。","四言"],["江有枫一篇十章 五","萧颖士","粤东可居，彼吴之墟。","四言"],["菊荣一篇五章 三","萧颖士","采采者菊，于邦之府。","四言"],["江有枫一篇十章 八","萧颖士","我思震泽，菱芡幕幕。","四言"],["江有枫一篇十章 四","萧颖士","东可游矣，会之丘矣。","四言"],["嫁女诗 其九","嵩岳诸仙","上清神女，玉京仙郎。","四言"],["郊庙歌辞·后唐宗庙乐舞辞·永平舞","崔居俭、卢文纪","庆传瓒祚，位正瑶图。","四言"],["江有枫一篇十章 七","萧颖士","我友于征，彼郑之子。","四言"],["赠皇甫侍御赴都八首 二","元希声","猗嗟众珍，以况君子。","四言"],["菊荣一篇五章 五","萧颖士","岁方晏矣，霜露残促。","四言"],["空馆夜歌 一","夷陵女郎","明月清风，良宵会同。","四言"],["赠皇甫侍御赴都八首 其一","元希声","东南之美，生于会稽。","四言"],["郊庙歌辞 祭汾阴乐章 凯安","蒋挺","维岁之吉，维辰之良。","四言"],["郊庙歌辞 武后享清庙乐章十首 第五饮福","佚名","爰陈玉醴，式奠琼浆。","四言"],["赠皇甫侍御赴都八首 其六","元希声","载怀朋情，尝接闲宴。","四言"],["赠皇甫侍御赴都八首 其八","元希声","金石其心，芝兰其室。","四言"],null,["池州夫子庙麟台","韦表微","二仪既闭，三象乃乖。","四言"],["菊荣一篇五章 一","萧颖士","采采者菊，芬其荣斯。","四言"],["赠皇甫侍御赴都八首 其五","元希声","绰绰夫君，是膺柱下。","四言"],["郊庙歌辞 享太庙乐章 象德舞","段文昌","肃肃清庙，登显至德。","四言"],["赠皇甫侍御赴都八首 其四","元希声","粤在古昔，分官厥初。","四言"],null,["郊庙歌辞 祭汾阴乐章 太簇角","卢从愿","坤元载物，阳乐发生。","四言"],["郊庙歌辞 周朝飨乐章 康顺","佚名","鸿钧广运，嘉节良辰。","四言"],["空馆夜歌 其三","夷陵女郎","[玉]户金缸，愿陪君王。","四言"],["和马郎中画鹤赞","卢纶","高高华亭，有鹤在屏。","四言"],["郊庙歌辞 祭汾阴乐章 太和","王晙","於穆圣皇，六叶重光。","四言"],["与独孤穆冥会诗 其六 县主请迁葬诗","临淄县主","露草芊芊，颓茔未迁。","四言"],["与独孤穆冥会诗 其七 穆荅县主","临淄县主","伊彼维扬，在天一方。","四言"],null,["郊庙歌辞 享太庙乐章 长发舞","魏征","濬哲惟唐，长发其祥。","四言"],null,["郊庙歌辞 封泰山乐章 太和","张说","孝敬中发，和容外彰。","四言"],["赠皇甫侍御赴都八首 其七","元希声","会合非我，关山坐违。","四言"],null,["郊庙歌辞 享太庙乐章 大明舞","魏征","五纪更运，三正逓升。","四言"],["郊庙歌辞 享太庙乐章 金奏","佚名","肃肃清庙，巍巍盛唐。","四言"],null,["郊庙歌辞 享太庙乐章 永和","魏征","於穆烈祖，弘此丕基。","四言"],["郊庙歌辞 享太庙乐章 永和","魏征","肃肃清祀，烝烝孝思。","四言"],["郊庙歌辞 梁郊祀乐章 庆肃","张衮","笾豆簠簋，黍稷非馨。","四言"],["大蜀皇帝寿春节进尧铭舜颂二首 舜颂","贯休","高高历山，有黍有粟。","四言"],["郊庙歌辞 祭方丘乐章 顺和","褚亮","阴祇协赞，厚载方贞。","四言"],["郊庙歌辞 享惠昭太子庙乐章 迎俎酌献","李逢吉","既洁酒醴，聿陈熟腥。","四言"],["大蜀皇帝寿春节进尧铭舜颂二首 尧铭","贯休","金册昭昭，列圣孤标。","四言"],null,["郊庙歌辞 武后大享拜洛乐章 禋和","佚名","百礼崇容，千官肃事。","四言"],["郊庙歌辞 善胜舞","佚名","圣祖累功，福钟来裔。","四言"],["赠皇甫侍御赴都八首 其三","元希声","道心惟微，厥用允塞。","四言"],["郊庙歌辞 后唐宗庙乐舞辞 武成舞","崔居俭","艰难王业，返正皇唐。","四言"],null,["郊庙歌辞 朝日乐章 雍和","佚名","晨仪式荐，明祀惟光。","四言"],["郊庙歌辞 后唐宗庙乐舞辞 文明舞","崔居俭、卢文纪","帝业光扬，皇图翕赫。","四言"],["郊庙歌辞 明堂乐章 雍和","褚亮","八牖晨披，五精朝奠。","四言"],["铸镜歌","龙护老人","盘龙盘龙，隐于镜中。","四言"],null,null,["郊庙歌辞 太清宫乐章 冲和","佚名","虚无结思，钟磬和音。","四言"],["中和乐九章 歌诸王第七","卢照邻","星陈帝子，岳列天孙。","四言"],null,["啄木","齐己","啄木啄啄，鸣林响壑。","四言"],null,["唐大飨拜洛乐章 敬和","武则天","兰俎既升，苹羞可荐。","四言"],["中和乐九章 歌登封第一","卢照邻","炎图丧宝，黄历开璇。","四言"],["郊庙歌辞 仪坤庙乐章 金奏","徐彦伯","阴灵效祉，轩曜降精。","四言"],["郊庙歌辞 享先农乐章 肃和","褚亮","樽彝既列，瑚簋方荐。","四言"],null,["郊庙歌辞 后唐宗庙乐舞辞 武成舞","崔居俭、卢文纪","艰难王业，返正皇唐。","四言"],null,["郊庙歌辞 享太庙乐章 雍和","魏征","崇兹享祀，诚敬兼至。","四言"],["郊庙歌辞 享太庙乐章 雍和","魏征","於穆清庙，聿修严祀。","四言"],null,["郊庙歌辞 梁郊祀乐章 其五 庆和","赵光逢","惟德动天，有感必通。","四言"],["郊庙歌辞 梁郊祀乐章 庆肃","赵光逢、张衮","笾豆簠簋，黍稷非馨。","四言"],["郊庙歌辞 梁郊祀乐章 其六 庆和","赵光逢","天惟佑德，辟乃奉天。","四言"],["郊庙歌辞 夕月乐章 肃和","佚名","测妙为神，通微曰圣。","四言"],null,["郊庙歌辞 享节愍太子庙乐章 登歌酌鬯","佚名","灼灼重明，仰承元首。","四言"],["郊庙歌辞 祭汾阴乐章 姑洗征","刘晃","大君出震，有事郊禋。","四言"],["郊庙歌辞 仪坤庙乐章 永和","徐彦伯","猗若清庙，肃肃荧荧。","四言"],["中和乐九章 歌储宫第六","卢照邻","波澄少海，景丽前星。","四言"],null,["郊庙歌辞 明堂乐章 肃和","褚亮","象天御宇，乘时布政。","四言"],["郊庙歌辞 享惠昭太子庙乐章 登歌","杜羔","因心克孝，位震遗芬。","四言"],null,["郊庙歌辞 仪坤庙乐章 昭升","薛稷","阳灵配德，阴魄昭升。","四言"],null,["中和乐九章 歌南郊第四","卢照邻","虔郊上帝，肃事圆丘。","四言"],null,["郊庙歌辞 梁郊祀乐章 庆顺","赵光逢","圣皇戾止，天步舒迟。","四言"],["祈谷乐章 肃和","褚亮","履艮斯绳，居中体正。","四言"],null,["郊庙歌辞 梁郊祀乐章 庆熙","赵光逢、张衮","哲后躬享，旨酒斯陈。","四言"],null,["郊庙歌辞 雩祀乐章 豫和","佚名","鸟纬迁序，龙星见辰。","四言"],["郊庙歌辞 雩祀乐章 豫和","佚名","祀遵经设，享缘诚举。","四言"],null,["郊庙歌辞 后唐宗庙乐舞辞 应天舞","崔居俭、卢文纪","晋国肇兴，雄图再固。","四言"],["郊庙歌辞 后唐宗庙乐舞辞 雍煕舞","崔居俭、卢文纪","仁君御宇，寰海谧清。","四言"],null,null,null,["刘方平壁画山","皇甫冉","墨妙无前，性生笔先。","四言"],null,["郊庙歌辞 梁郊祀乐章 庆熙","张衮","哲后躬享，旨酒斯陈。","四言"],["唐大飨拜洛乐章 九和","武则天","祗荷坤德，钦若干灵。","四言"],["郊庙歌辞 梁郊祀乐章 庆平","赵光逢","天命降鉴，帝德惟馨。","四言"],["凉雨一章","萧颖士","习习凉风，泠泠浮飙。","四言"],null,null,null,["唐大飨拜洛乐章 禋和","武则天","百礼崇容，千官肃事。","四言"],null,["郊庙歌辞 享隐太子庙乐章 诚和","佚名","道閟鹤关，运缠鸠里。","四言"],["郊庙歌辞 享先农乐章 咸和","褚亮","粒食伊始，农之所先。","四言"],["虞获子鹿","韦应物","虞获子鹿，畜之城陬。","四言"],null,null,["郊庙歌辞 仪坤庙乐章 肃和","张齐贤","祼圭既濯，郁鬯既陈。","四言"],["郊庙歌辞 襃德庙乐章 昭德","佚名","道赫梧宫，悲盈蒿里。","四言"],["唐德明兴圣庙乐章 送神","李纾","元精回复，灵贶繁滋。","四言"],null,["郊庙歌辞 中宗祀昊天乐章 福和","佚名","九成爰奏，三献式陈。","四言"],["郊庙歌辞 晋朝飨乐章 初举酒文同乐","佚名","赫矣昌运，明哉圣王。","四言"],null,["郊庙歌辞 享太庙乐章 永和","魏征、褚亮","肃肃清祀，烝烝孝思。","四言"],["郊庙歌辞 享太庙乐章 大定舞","李回","受天明命，敷佑下土。","四言"],["郊庙歌辞 德明兴圣庙乐章 迎神","李纾","元尊九德，佐尧光宅。","四言"],["郊庙歌辞 中宗祀昊天乐章 肃和","佚名","悠哉广覆，大矣曲成。","四言"],["郊庙歌辞 中宗祀昊天乐章 亚献","佚名","三灵降飨，三后配神。","四言"],null,null,["泽宫诗 其一","刘禹锡","秩秩泽宫，有的维鹄。","四言"],["泽宫诗 其二","刘禹锡","彼鹄斯微，若止若翔。","四言"],["泽宫诗 其三","刘禹锡","我矢既直，我弓既良。","四言"],null,null,["唐享昊天乐 第十一","武则天","礼终肆类，乐阕九成。","四言"],null,["泽宫诗 其四","刘禹锡","高墉伊何，维器与时。","四言"],["郊庙歌辞 祀风师乐章 迎俎酌献","包佶","德盛昭临，迎拜巽方。","四言"],["曳鼎歌","武则天","羲农首出，轩昊膺期。","四言"],["郊庙歌辞 享孔子庙乐章 送神","佚名","醴溢牺象，羞陈俎豆。","四言"],["彼农二章 一","陆龟蒙","世路浇险，淳风荡除。","四言"],null,["郊庙歌辞 享太庙乐章 雍和","魏征、褚亮","於穆清庙，聿修严祀。","四言"],null,["彼农二章 二","陆龟蒙","禹贡厥田，上下各异。","四言"],null,["题僧房绝句","吕岩","唐朝进士，今日神仙。","四言"],["郊庙歌辞 雩祀乐章 肃和","褚亮","朱鸟开辰，苍龙启映。","四言"],["绣袈裟衣缘","长屋","山川异域，风月同天。","四言"],null,["郊庙歌辞 祭方丘乐章 金奏","佚名","坤元至德，品物资生。","四言"],["郊庙歌辞 德明兴圣庙乐章 德明酌献","李纾","清庙弈弈，和乐雍雍。","四言"],["祭汾阴乐章","韩思复","大乐和畅，殷荐明神。","四言"],["郊庙歌辞 享太庙乐章 大基舞","魏征","猗与祖业，皇矣帝先。","四言"],["郊庙歌辞 享文敬太子庙乐章 登歌","陈京","歌以德发，声以乐贵。","四言"],["郊庙歌辞 祭方丘乐章 顺和","佚名","坤厚载物，德柔垂祉。","四言"]]