[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["次宋省斋木犀 其一","杨公远","西风生桂子，香色总关情。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["送沈炼师归武夷 其一","胡仲弓","仙骨久已蜕，尚遗空石函。","五言长篇"],null,null,null,null,null,null,["送林弓寮归闽省觐竹溪中书往赴安溪县新任 其一","释文珦","当展经纶志，初为抚字官。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["闲居","释文珦","影不落人间，空门断往还。","五言长篇"],null,null,null,null,null,["依韵酬葛秋岩陶体四首 其一","释文珦","山林自多趣，况此晴和时。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["真歇老人退居东庵予过雪峰特访之为留再宿仍赋两诗 其一","张元干","云卧孤峰顶，斋馀闭户眠。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["庚午岁屏居零陵七月二十日以门掩候虫秋为韵赋五首 其一","汪藻","幽人独夜时，潮落西川根。","五言长篇"],["与任道及顺久二师赋小阁见月","强至","醉领玉川子，夜入支公院。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["赠史康时二首 其一","李洪","史侯眉山英，壮岁陪戎旃。","五言长篇"],["题四兰 风","释绍昙","深藏岩谷里，初不要人知。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["维心过邵子非溪亭夜话有伤时感旧之作索余次韵 其一","沈与求","官仪全复汉，盟会竞尊周。","五言长篇"],null,["子虚航重湖之险远过山中辄次维心韵以谢 其一","沈与求","客里伤为别，相望岁一周。","五言长篇"],null,null,["刘希颜提举见过出示卞山居二诗次其韵 其一","沈与求","偪仄风尘际，分携岁月赊。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["游郭希吕石洞二十咏 其一 清旷","刘过","笋舆咿哑来，路转此歇脚。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,["送税官仇副使诗十首","熊禾","儒道未易行，俛首为禄仕。","五言长篇"],["上严廉访十首","熊禾","七闽天南陬，实惟文明方。","五言长篇"],["赠王典史五首","熊禾","百里古君侯，一邑天下积。","五言长篇"],["寄赵菊东山长三首","熊禾","男儿贵神交，何必见颜色。","五言长篇"],["三山先贤祠落成八首","熊禾","填宿久旅奎，一朝开文治。","五言长篇"],["七夕遇雨访石堂先生","熊禾","今宵无月烛，鬃瓢泻银河。","五言长篇"],["暑雨","范纯仁","暑候积隆暵，骄阳变重阴。","五言长篇"],null,["签判李太博静胜轩二首 其一","范纯仁","开轩纳清景，为吏似闲居。","五言长篇"],null,null,null,null,null,null,null,null,null,null,["孙曼叔尚书挽词三首 其一","范纯仁","少海风云会，先朝眷遇隆。","五言长篇"],null,null,["蜀郡范公景仁挽词三首 其一","范纯仁","翰苑文章伯，金华侍从臣。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["承君棋输包子诗以促之 其一","孔平仲","君看射夫指，柔软作皮室。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["馀干学录徐君名桂蟾号月斋龙游人善文词善谈方外之学春晚来山中谈七日乃别今重到玄妙寄乐府一阕赋此为别","徐瑞","博雅南州士，风流小隐仙。","五言长篇"],null,["庚寅正月十六携家入山大雪弥旬止既月叔祖东绿翁以那知风雨夜复此对床眠分韵瑞得那眠字 其一","徐瑞","辟俗过逢少，离居感慨多。","五言长篇"],null,null,null,null,["余自入山距出山五十五日竹屋青灯山阴杖屦忘其痴不了事矣随所赋录之得二十首 其一 入山","徐瑞","石浪啮我足，山雨湿我衣。","五言长篇"],null,null,null,["修禊后三日与仲退坐小斋煖雨初歇忽闻异香于是花事已罢春在尘土意其为草木畅茂有自然之香而卒莫诘其所从来明日仲退以心清闻妙香为韵作五诗奉次一噱 其一","徐瑞","斋居屏尘迹，读易洗我心。","五言长篇"],null,null,null,null,null,["仲实践约来访又得韶甫方君同行数日语蝉联甚慰五诗寄意甚高次韵为一笑 其一","牟𪩘","重膇嫌卑湿，那堪暑雨稠。","五言长篇"],null,["挽杨知府 其一","牟𪩘","蜀有古爱直，公为令子孙。","五言长篇"],null,null,["挽陈本斋尚书 其一","牟𪩘","在昔实斋老，公能继盛名。","五言长篇"],["挽王厚斋尚书 其一","牟𪩘","清要三朝望，文章一世荣。","五言长篇"],null,null,null,["贾节庵冒夏暑越修涂过我苕霅情谊甚厚令闻古式无思大节不可复见而骨肉消息访问难真相对殆感慨不能为怀青灯夜语诵少陵夜阑更秉烛相对如梦寐之句意甚惘然其归也儿曹以此为韵赋诗道别余亦作焉衰老拙恶姑写我怀且以卜后期云尔 其一","牟𪩘","君留剑水浔，我卧弁峰下。","五言长篇"],null,["希年初度老友王希宣扁舟远访夙谊甚厚贶以十诗实用渊明采菊东篱下语五章云每岁思亲不持斝蓼莪几欲废诗雅盖深知予心者读之凄然辄尔和韵 其一","牟𪩘","行年似启期，颜发日夜改。","五言长篇"],["题束季博山园二十首 其一 垂柳","牟𪩘","是谁挼蓝染，千条万条碧。","五言长篇"],null,["东坡九日尊俎萧然有怀宜兴高安诸子侄和渊明贫士七首余今岁重九有酒无肴而长儿在宜兴诸儿苏杭溧阳因辄继和 其一","牟𪩘","吾翁始落南，土思尚依依。","五言长篇"],["和同社饯梅","赵必𤩪","花开春意动，花谢春意静。","五言长篇"],["避地山中和杨推夜寒韵二首 其一","赵必𤩪","山藏皇恐色，溪诉不平声。","五言长篇"],["别和明府归帅省","赵必𤩪","江山如昨日，人物已晨星。","五言长篇"],["和朱水乡韵","赵必𤩪","已落渊明后，归欤寂寞滨。","五言长篇"],["挽陈东湖 其一","赵必𤩪","诸公凋谢尽，此老鲁灵光。","五言长篇"],["吟社递至诗卷足十四韵以答之为梅水村发也","赵必𤩪","铁石其心肠，冰雪其襟胸。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["午日","谢薖","今晨定何祥，桃柳各映户。","五言长篇"],["寄汪信民二首 其一","谢薖","泮水传经老，蓬山佐著才。","五言长篇"],null,null,null,["寄王立之二首 其一","谢薖","坎𡒄修门里，萧条处士庐。","五言长篇"],null,null,["次董彦速示轮老韵三首 其一","谢薖","法涌僧中鸾，孤绝翔千仞。","五言长篇"],null,null,null,null,["吉州刺史蔡直之挽词二首 其一","叶适","领合号亲贵，光宗始用儒。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["挽王茂悦提舶二首 其一","周密","清气钟全蜀，风流压盛唐。","五言长篇"],null,null,null,null,null,null,null,["游法华瑶阜蜃洞以糁径杨花铺白毡点溪荷叶叠青钱分韵余既有作复各赋古诗一以纪游事 其一","周密","青旗倏南指，洒洒风日澹。","五言长篇"],null,null,null,null,null,null,["熙宁癸丑季冬十有三日某被旨谢雪于济祠已事与秘书监光禄卿直史馆太常少卿屯田郎中秘书丞同游枋口泛舟沁水至岘石而登岸历观岩谷间前贤之题名翌日游化成寺以车渡沁回入盘谷穷览山水之嘉处由燕川而归 其一 盘谷作","文彦博","昔有幽栖士，兹焉遂考槃。","五言长篇"],null,null,null,null,null,null,["东枢后轩列植花草随时竞秀种类寔繁滋蔓因依未易图也然昔之造化者为不少矣故录其名数榜于北垣意欲后之人勿剪勿伐且无忘于封植也因观其榜偶作小诗三章曰嘲曰解曰断云 其一 嘲","文彦博","百种闲花草，皆非药笼材。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["远游篇寿立斋","金履祥","我歌远游篇，西望心悠然。","五言长篇"],["送金簿解官归天台五首 其五","金履祥","白云苍山东，归骖迈长道。","五言长篇"],["送金簿解官归天台五首 其三","金履祥","自从夫君来，剑气躔须女。","五言长篇"],null,["挽北山子何子三首 其一","金履祥","道自朱黄逝，人多名利趋。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["三老堂","刘摰","三老非隐者，乡里道义人。","五言长篇"],null,null,null,null,null,null,null,null,null,["挽右光禄大夫知枢密院事赠开府仪同三司孙公二首 其一","刘摰","岑令神情竭，裴公柱石衰。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["丙子岁三月十有二日游嵩山宿峻极中院时天气清朗山月甚明因以阴壑生虚籁月林散清影为韵诗各六句 其一","李廌","阳崖转窅窕，层林蔽重阴。","五言长篇"],["岑使君牧襄阳受代还朝某同赵德麟谢公定潘仲宝皆饯于八叠驿酒中以西王母所谓山川悠远白云自出相期不老尚能复来各人分四字为韵以送之某分得相期不老 其一","李廌","使臣抚南夏，万夫久以望。","五言长篇"],["故谏议大夫鲜于公欲作新堂以传世谱名曰卓绝内相先生题其名曰蜀鲜于氏卓绝之堂某以此八字为韵作八诗盖鲜于公顷尝俾某赋之而三子以求其诗故原其古而美其今以颂美之 其一","李廌","商朝有仁人，为奴耻荣禄。","五言长篇"],null,null,["送杭州使君苏内相先生某用先生旧诗方丈仙人出渺茫高情犹爱水云乡为韵作古诗十四首 其一","李廌","至人本无我，与世初无方。","五言长篇"],["又九月十四日登秋风阁以馀霞散成绮澄江静如练为韵分得馀静二字 其一","李廌","缪蹈江海迹，吾生靡怀居。","五言长篇"],["同德麟仲宝过谢公定酌酒赏菊以悲哉秋之为气萧瑟八字探韵各赋二诗仍复相次八韵某分得哉萧二字 其一","李廌","楚女唱桃叶，楚巫歌竹枝。","五言长篇"],null,["东津夜饮送岑穰彦休赴阙 其一","李廌","东门何煌煌，骊驹络金羁。","五言长篇"],["同诸公饯望元因宿谷隐以何当风雨夜复此对床眠为韵分得对此二字 其一","李廌","雨气天末来，暝色江皋起。","五言长篇"],["同仲宝风雨中过德麟留宿以夜未央为韵分得未字并和二公夜央字韵 其一","李廌","悲风送寒雨，遥夜俄总至。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["之南丰道上寄介甫","曾巩","应逮冒烦暑，驱驰山水间。","五言长篇"],["秋怀二首 其二","曾巩","为州讵非忝，即事亮何成？","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["汪信民载酒令表弟吴迪吉邀予同游南湖 其一","谢逸","古人多龃龉，吾党故徘徊。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["奉陪舅丈秘书彦平主簿兄游慧聚终日小饮上方待月再历妙峰诸胜处用前人韵得二诗是日尝微雨作 其一","仲并","凭高情不浅，尽日倚胡床。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["用清秋鹤发翁韵赋小书招洁堂 其一","马廷鸾","幽居抱孤明，怀古思旧京。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["游登袋寺寺出茶笋甚佳独无杜鹃 其一","戴表元","苦雨忽相贷，名山难久孤。","五言长篇"],null,null,null,["东阳方韶卿惠古意七篇久不得和五月二十六日将假馆宗阳桥稍有闲暇乃为次韵因寄讯彼中吴子善前辈 其一","戴表元","长岁狎纷諠，新庐稍疏静。","五言长篇"],["以羔裘如濡洵美且侯韵为八诗送夹谷子括赴明州推官 其一","戴表元","鉴虚磨愈明，弦柔调自直。","五言长篇"],null,null,null,null,null,["阆风舒先生客居棠溪袁仲素家见示竹帘诗戏作问答二首 其一","戴表元","剡竹吾问君，班班为谁设。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["春怀赋得冰雪莺来晚春寒花较迟十字 其一","王安中","深居足移气，熏炉坐晨兴。","五言长篇"],["同郡李达之贡辟廱偶试不利还乡及河不得济作二诗凄然读之殆难为怀因为次韵极其悲苦卒少纾之当烦刘元忠彭少逸同赋 其一","王安中","客行天雨霜，屦穿敢留迹。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,["饮沈氏园得僻字","曾协","会心足胜侣，暇日访春色。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["见苏黄邦字韵诗戏示王倅安国二首 其一","刘跂","与君南北人，斗粟聚此邦。","五言长篇"],null,null,null,null,null,null,null,null,["挽杨料院二首 其一","陈淳","早识渊源正，从师事切磨。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["昔游诗十五首 其三","姜夔","九山如马首，一一奔洞庭。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["用旧韵送普守赴阙 其一","王灼","圜墙闲木索，南亩富锄钩。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["和李士举陪提刑徽猷游中梁山临秀远轩以望江中平陆之胜承示佳句且叙故旧离合之感次韵二首 其一","王之望","空翠浮轩槛，岚光拂栋梁。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,["城中别徐山玉先生归归后奉寄 其一","黎廷瑞","北风走平湖，枯荷鸣索索。","五言长篇"],null,null,null,["过干越宿熊氏澹园偕东采驾阁西玉国正二同年登羊角峰观天池访昌国寺陆羽茶灶拿船过琵琶洲回延休观听琴记游四首 其一","黎廷瑞","倚策试新晴，扶摇上羊角。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["南华阳洞","周文璞","稽首游名山，驾言入华阳。","五言长篇"],null,null,null,null,null,null,null,null,["种罂粟","李复","前年阳亢骄，旱日赤如血。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,["和答李德臣","刘辰翁","忍寒一百五，何开落匆匆。","五言长篇"],["春景 绝域改春华","刘辰翁","绝域何堪久，悠悠日又斜。","五言长篇"],["春景 落花香满泥","刘辰翁","春去如流水，落花忙又忙。","五言长篇"],["春景 村村自花柳","刘辰翁","御宿长杨馆，南山沁水园。","五言长篇"],["春景 新年贺太平","刘辰翁","乱向残年定，东风息战尘。","五言长篇"],["春景 小水细通池","刘辰翁","过雨山泉润，悠悠小水同。","五言长篇"],["春景 孤舟乱春华","刘辰翁","天地孤舟客，东风是处家。","五言长篇"],["夏景 夏雨生众绿","刘辰翁","入夏可曾晴，阴阴众绿成。","五言长篇"],["夏景 松凉夏健人","刘辰翁","松影夏天云，凉开一院新。","五言长篇"],["夏景 衣冷欲装绵","刘辰翁","老厌人间热，单衣就冷泉。","五言长篇"],["秋景 月色醉远客","刘辰翁","明月有佳色，客中迷远游。","五言长篇"],["秋景 门掩候虫秋","刘辰翁","四壁可谁语，一年将次休。","五言长篇"],["秋景 出逢危叶落","刘辰翁","举眼秋萧索，乾坤岂不容。","五言长篇"],["秋景 鹭于飞","刘辰翁","沧洲开晚景，莽苍更依稀。","五言长篇"],null,null,["郡斋望蒋山","叶梦得","十年在空山，未觉与世殊。","五言长篇"],["送沈传曜","叶梦得","卞峰摩青空，东望乌氐墩。","五言长篇"],["哭赵叔问","叶梦得","刘氏磐石宗，略分天下半。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["牧童歌十首 其一","蒲寿宬","荷笠小苍头，犊裈乘水牛。","五言长篇"],null,["和博古直五首 其一","蒲寿宬","圣门蔼徒众，几人得称贤。","五言长篇"],null,["舶使王会溪太守赵见泰九日领客枉顾山中赋采菊东篱下悠然见南山韵十首 其一","蒲寿宬","翠节摩秋云，朱轓映朝彩。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,["松风","释智圆","青青数树松，扶疏空庭里。","五言长篇"],["湖居感伤","释智圆","迷真渺无始，飘业产钱唐。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["子温侄用再闻诵新作突过黄初诗作十诗见遗辄勉强次韵 其一","张扩","小人无远谋，湮没如湛辈。","五言长篇"],null,null,["奉和朱新仲祠部六月晦日省宿用白乐天诗无波古井水有节秋竹竿十字为韵 其一","张扩","漫郎省中宿，展转良夜徂。","五言长篇"],null,["送高丞别","李吕","君侯七闽英，学问早有馀。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["乙亥岁八月十五日夜同景叔知府少卿翼道提举大夫望月于河中之名阃堂兼简襄守欧三叔弼虢守孙八元忠二首 其一","毕仲游","上楼初照席，条华渐分明。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["何和尚寻母","赵文","写经母血尽，长素母容枯。","五言长篇"],null,null,null,null,null,null,null,["送谯允蹈解青神赴永康学官二首 其一","史尧弼","簿领尘埃地，淹回岁月阑。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["任邱道中值雪赠权邑宰曹弋取道曹河间同僚也 其一","赵鼎臣","宿雾寒犹重，浓阴晓未分。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,["乙未寒食前一日陪姚季一吴和甫登崇德寺阁赋诗以驾言出游以写我忧为韵分得我出二字 其一","赵鼎臣","东风日夜狂，草木困掀簸。","五言长篇"],null,null,null,null,null,["挽夔路帅韩徽猷 其一","员兴宗","先声一鹗天，万点蜀山悬。","五言长篇"],null,null,["哭黄省元贡 其一","员兴宗","故国地灵处，人文天意深。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["四民诗 士","范仲淹","前王诏多士，咸以德为先。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,["帅节留先生两年粤服氓獠安之一日疏十宜归欲袖手板还丞相言者犹不之置上命以厘廷之禄解印东归门生临川陈元晋援后山送坡仙故事至惠之海丰而别作诗四章云 其一","陈元晋","手疏宜归十，心知昨梦非。","五言长篇"],null,null,null,null,["游罗浮宝积寺 其一","陈元晋","晴峰膏秋容，远骑驻春脚。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["属疾","晁迥","精鹜成勤瘁，颐贞俟有瘳。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["上元被差监酤妙觉书呈文叔二首 其一","周行己","密雪沾游幕，馀寒犯酒茵。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["答曾清甫 其一","张埴","看花都是梦，听雨甚于秋。","五言长篇"],null,null,null,null,null,null,null,["挽钝斋先生许象州三首 其一","李昴英","家学存斋授，渊源自晦庵。","五言长篇"],null,null,null,null,null,["偶作 其十九","杨简","矧复赘无极，哀哉可太息。","五言长篇"],["偶作 其十八","杨简","道心非动静，学者何难易。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["谢疟鬼","陈克","皇天分四时，寒暑代翕张。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["艾轩老先生文集刊传上以揄扬其问学下则得佛家以法布施之意前后数君子有是志而不果今日薄西山幸一见此喜成古风三篇以贺后来之有作者且述下悰云 其一","陈藻","老艾先生殁，骎骎四纪年。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["思耕亭","高斯得","莘郊投耒兴，六百奠殷祀。","五言长篇"],null,null,null,null,null,null,null,null,["和苏著作麻姑十咏 其一 鲁公碑","李觏","他人工字书，美好若妇女。","五言长篇"],null,null,null,null,null,null,null,["翟簿示似中秋高作命意着语殆与商素争清读至人与月忘年之句不觉击节借五言为韵赋诗答谢 其一","史弥宁","饮月漱吟齿，心事何轮囷。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["悼蜀四十韵并序","张咏","蜀国富且庶，风俗矜浮薄。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["十月晦过舍弟庭玉处见诸人棋战方酣顷之复过集者皆散独枰尚在窗户阒然因成三篇呈子常汉臣 其一","李昭玘","妙手固多暇，忿兵终易穷。","五言长篇"],null,null,null,null,null,null,null,null,["游山","苏舜钦","上春游南峰，出自阊扉西。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["谢太守答诗莱州","郑侠","闲斋掩昼扉，疏竹间风韵。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["春夏之交四首 其一","孙嵩","江花江水意，春色为谁多。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,["湖上观春","汤炳龙","闭门五日雨，出门万山春。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["游宝掌山寺","方樗","何年此招提，近在芝掌侧。","五言长篇"],["重阳对菊得雨字","方樗","昨我醉骑马，失脚行踽踽。","五言长篇"],["题义门","方樗","大义久不作，颓纲孰能扶。","五言长篇"],["立秋日喜雨寄楚老","方樗","抱疾不安枕，且为枯旱忧。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,["挽文文山","邓剡","忆公泪悬河，九地无处泻。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["一春屡有阳明之约雨辄尼之将旋幕侍外舅来游解后二羽衣一能参上道一能知大丹竟日留话喜赋二解时清明日也 其一","施枢","几有行山约，山灵圣得知。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,["雷公山","张澄","年大嗜烟壑，心鄙城郭近。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,["结交篇","田锡","为簪莫用玉，玉脆长忧折。","五言长篇"],["寄宋白拾遗","田锡","醉中别大梁，西归胃水阳。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["无题二首","王千秋","雄姿画麒麟，朽骨分蝼蚁。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["游金山","鲜于侁","蓬莱三神山，横绝巨鳌背。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["柳","丁谓","杨柳郁氤氲，金堤总翠氛。","五言长篇"]]