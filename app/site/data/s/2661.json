四言"],["寿域诗四章为庄得全编修尊人作","区大相","煌煌寿域，光于南斗。","四言"],["太和山铭","区大相","穹窿太和，上参冥莫。","四言"],["海棠果赞","区大相","海棠色殊，纷披曜日。","四言"],["木瓜赞","区大相","垂垂木瓜，诗人所咏。","四言"],["崇德诗七章","区大相","翼翼旧京，作配丰芑。","四言"],["续刺谗诗 其一","区大相","天监下民，正直是与。","四言"],["续刺谗诗 其二","区大相","缉缉谗夫，实善中人。","四言"],["续刺谗诗 其三","区大相","施施谗夫，胡言之厚。","四言"],["续刺谗诗 其四","区大相","毁玉为珉，诬舜为跖。","四言"],["续刺谗诗 其五","区大相","俨斯恪斯，我仪孔嘉。","四言"],["续刺谗诗 其六","区大相","天之方蹶，良士祚之。","四言"],["续刺谗诗 其七","区大相","道之丧矣，谗人是命。","四言"],["续刺谗诗 其八","区大相","嗟余小子，不早是图。","四言"],["续刺谗诗 其九","区大相","高林致风，盛德来毁。","四言"],["续刺谗诗 其十","区大相","昔在公车，偕我仲季。","四言"],["续刺谗诗 其十一","区大相","有鸟在梁，亦曰在原。","四言"],["井井亭","湛若水","有亭井井，山下出泉。","四言"],["石潭","湛若水","水行石上，用柔破刚。","四言"],["翩翩者棣三章赠潘希召之弟归辰阳","湛若水","翩翩者棣，花萼相及。","四言"],["赠徐曰仁守祁州三物三章章六句","湛若水","有徂怀人，赠之纨扇。","四言"],["习古斋","湛若水","习之习之，古自我作。","四言"],["恐斋","湛若水","临深履薄，匪曰觳觫。","四言"],["命吴生?字泳中诗四章章八句","湛若水","厥初生民，昊天降极。","四言"],["古劳二章章十二句","湛若水","古劳之下，有川洋洋。","四言"],["藤江雨中","湛若水","腊月既望，我徂自藤。","四言"],["平南遣兴","湛若水","渔渊水深，采芝云迷。","四言"],["爱日二章章十句","湛若水","瞻彼爱日，实慰我心。","四言"],["敬止","湛若水","风云自天，龙蛇起陆。","四言"],["𪾢睆二章章六句","湛若水","𪾢睆黄鸟，遗音千山。","四言"],["赋东山","湛若水","瞻彼东山，巍巍南极。","四言"],["西征凯旋雅","湛若水","皇天眷德，全畀所覆。","四言"],["题画二首 其一 圯桥进履","湛若水","进履之心，可以授道。","四言"],["题画二首 其二 希夷睡图","湛若水","不醒是梦，醒亦是梦。","四言"],["高氏祖庙诗 其一","湛若水","奕奕大族，世于乐清。","四言"],["示诸学者","湛若水","心无一物，天理见前。","四言"],["潘生子嘉姑母贞节诗","湛若水","忘独忘寡，忘寡忘贫。","四言"],["题金芝呈瑞卷","湛若水","煌煌金芝，维山之辉。","四言"],["朔风","湛若水","朔风飕飕，送子归舟。","四言"],["答侍御朱君诗 其一","湛若水","陟彼泉山，其山崇崇。","四言"],["感忠楼诗 其一","湛若水","奕奕钜汪，司马昌之。","四言"],["感忠楼诗 其二","湛若水","视彼牛尾，牧者骇异。","四言"],["感忠楼诗 其三","湛若水","登源之茔，萎木再荣。","四言"],["感忠楼诗 其四","湛若水","其忠维何，岭表寔多。","四言"],["感忠楼诗 其五","湛若水","何以怀云，视尔赤心。","四言"],["感忠楼诗 其六","湛若水","忠勋念兹，何日忘之。","四言"],["感忠楼诗 其七","湛若水","思彼槁木，犹感忠诚。","四言"],["偶笔示张廷佐都司马金挥使","湛若水","天地合德，为阴为阳，为雨为霜。","四言"],["寿宝安任君砚斋先生华诞诗","湛若水","我怀铁江，宝安之阳，隔水汤汤。","四言"],["寿张母封太孺人华诞","湛若水","陈乐高堂，华筵广张。","四言"],["昔我三章章六句","湛若水","昔我视尔，兄弟不犹。","四言"],["候官黄孝子兰坡 其三","湛若水","君子孝思，兰之辉辉。","四言"],["高氏祖庙诗 其二","湛若水","于穆大宗，本支太尉。","四言"],["高氏祖庙诗 其三","湛若水","于昭堂庙，堂庙盘谷。","四言"],["高氏祖庙诗 其四","湛若水","于潭宗会，时思著存。","四言"],["高氏祖庙诗 其六","湛若水","延月斯沼，受泉于岩。","四言"],["高氏祖庙诗 其七","湛若水","于弘有庙，有庙孔贲。","四言"],["答侍御朱君诗 其二","湛若水","酌彼泉水，其泉泚泚。","四言"],["九龙颂 其一","湛若水","一龙乘云，九龙在田。","四言"],["九龙颂 其二","湛若水","一龙将雨，九龙处处。","四言"],["即席送陈梓卿归省携侄来山","湛若水","太丘子弟，从宝潭来。","四言"],["谗谮二章","湛若水","彼谮妇妾，多言谍谍。","四言"],["显陵五章送严介溪宗伯","边贡","于穆献考，睿哲维则。","四言"],["朝涉篇六章","边贡","朝涉洪流，夕步江皋。","四言"],["泉之滨哀隐士也 其一","边贡","泉之滨兮，白石磷兮。","四言"],["泉之滨哀隐士也 其二","边贡","泉之浒兮，锡之土兮。","四言"],["泉之滨哀隐士也 其三","边贡","人之坠矣，泉之匮矣。","四言"],["杜蒉","边贡","旷饮调饮，臣蒉亦饮。","四言"],["石祁子","边贡","冠佩则兆，吾弗敢知。","四言"],["和陶停云赠芋岩五十初度四首 其一","王夫之","蒸蒸良稼，涤涤灵雨。","四言"],["和陶停云赠芋岩五十初度四首 其二","王夫之","道延今者，爰如鸿蒙。","四言"],["和陶停云赠芋岩五十初度四首 其三","王夫之","有梅有梅，霜裛其荣。","四言"],["和陶停云赠芋岩五十初度四首 其四","王夫之","乔乔豫章，执彼斧柯。","四言"],["杂诗","王夫之","清夕始澄，孤月出林。","四言"],["来日大难","王夫之","来日大难，毛凋羽残。","四言"],["石流篇","王夫之","石上流水，渐彼蒲英。","四言"],["短歌行","王夫之","临觞不辞，当歌不悲。","四言"],["读易赠熊体贞孙倩 其一","王夫之","澄宇既涤，清霜欲飞。","四言"],["读易赠熊体贞孙倩 其二","王夫之","油云在天，舒卷不齐。","四言"],["读易赠熊体贞孙倩 其三","王夫之","自我徂冬，元夜其修。","四言"],["读易赠熊体贞孙倩 其四","王夫之","大圜如规，旦昏各半。","四言"],["读易赠熊体贞孙倩 其五","王夫之","文王既没，文其在兹。","四言"],["读易赠熊体贞孙倩 其六","王夫之","昨日之日，为今日先。","四言"],["读易赠熊体贞孙倩 其七","王夫之","脂我神舆，游于太虚。","四言"],["读易赠熊体贞孙倩 其八","王夫之","悠悠我生，去日巳长。","四言"],["耿耿二章","释函可","耿耿双瞳，游于面间。","四言"],["佛不在木一章章十句","释函可","佛不在木，念不在珠。","四言"],["山鬼四章章四句","释函可","明月在天，塔影在地。","四言"],["善哉行 其一","释函可","日月烛照，民多纰缪。","四言"],["善哉行 其二","释函可","南有佳人，颜色静好。","四言"],["短歌行","释函可","前后左右，四面八方。","四言"],["长歌行","释函可","我歌我歌，旧民犹可，新民奈何。","四言"],["来日大难","释函可","来日大难，风雨在门。","四言"],["放歌行","释函可","斫却孤桐，凤或来止。","四言"],["陇头歌 其一","释函可","陇头流水，或西或东。","四言"],["陇头歌 其二","释函可","陇头流水，声惨以凄。","四言"],["修竹篇三章","陆深","瞻彼修竹，薄言眷之。","四言"],["恭拟太祖高皇帝孝慈高皇后上册乐章 其一 迎神","陆深","惟皇高祖，英灵在天。","四言"],["恭拟太祖高皇帝孝慈高皇后上册乐章 其二 初献","陆深","俎豆既陈，酒醴维清。","四言"],["恭拟太祖高皇帝孝慈高皇后上册乐章 其三 亚献","陆深","载酌载献，惟圣顾歆。","四言"],["恭拟太祖高皇帝孝慈高皇后上册乐章 其四 终献","陆深","神降伊迩，终秩有严。","四言"],["恭拟太祖高皇帝孝慈高皇后上册乐章 其五 彻馔","陆深","奠献既备，敬彻不迟。","四言"],["恭拟太祖高皇帝孝慈高皇后上册乐章 其六 还宫","陆深","祀事孔明，神休滋锡。","四言"],["梦中作","吴与弼","烟消雾散，海阔天高。","四言"],["短歌行","于慎行","对酒当歌，朱颜未酡。","四言"],["善哉行","于慎行","秋风萧萧，白露为霜。","四言"],["独漉篇","于慎行","独漉独漉，山深水曲。","四言"],["题松柏同春卷","李之世","陟彼高冈，松柏楚楚。","四言"],["和泂酌亭诗","李之世","往来井井，于彼于兹。","四言"],["和观棋","李之世","登岸造极，筑基累址。","四言"],["久旱悯农因和停云 其一","李之世","停云薄空，有风无雨。","四言"],["久旱悯农因和停云 其二","李之世","西郊作云，厥气冥蒙。","四言"],["久旱悯农因和停云 其三","李之世","眷彼良苗，悴不再荣。","四言"],["久旱悯农因和停云 其四","李之世","液不荣根，叶辞其柯。","四言"],["和劝农 其一","李之世","天沃尔土，不敕尔民。","四言"],["和劝农 其二","李之世","市利莫争，艺我黍稷。","四言"],["和劝农 其三","李之世","天祻尔琼，珍饶川陆。","四言"],["和劝农 其四","李之世","积玉堆金，家弗可久。","四言"],["和劝农 其五","李之世","谋食有方，务本不匮。","四言"],["和劝农 其六","李之世","垦我疆场，拓我边鄙。","四言"],["白云谣","李孙宸","白云西垂，罡风在耳。","四言"],["短歌行","李孙宸","嘉宾在堂，旨酒盈觞。","四言"],["艾如张","朱诚泳","艾如张罗，黄雀几多。","四言"],["赞十四首 其一 悯祖","朱诚泳","赳赳仪容，桓桓英武。","四言"],["赞十四首 其二 悯祖妃邓氏","朱诚泳","堂堂世胄，曰惟宁河。","四言"],["赞十四首 其三 隐祖","朱诚泳","仪容丰伟，性行修洁。","四言"],["赞十四首 其四 隐祖妃刘氏","朱诚泳","天生淑质，世阀元勋。","四言"],["赞十四首 其五 夫人唐氏","朱诚泳","明明隐祖，允赖匡襄。","四言"],["赞十四首 其六 僖祖","朱诚泳","兢兢持已，翼翼小心。","四言"],["赞十四首 其七 怀祖","朱诚泳","天姿开爽，性质刚明。","四言"],["赞十四首 其八 怀祖妃张氏","朱诚泳","天挺幽姿，配我怀祖。","四言"],["赞十四首 其九 康祖","朱诚泳","天姿英毅，至性刚方。","四言"],["赞十四首 其十 康祖妃陈氏","朱诚泳","具备德容，博通书史。","四言"],["赞十四首 其十一 惠考","朱诚泳","猗欤昭考，肫肫其仁。","四言"],["赞十四首 其十二 惠考妃王氏","朱诚泳","早膺封册，相我先王。","四言"],["赞十四首 其十三 母妃杨氏","朱诚泳","天姿贞淑，懿德慈良。","四言"],["赞十四首 其十四 惠考继妃嵇氏","朱诚泳","粤膺妙选，继佐先王。","四言"],["南山有椿颂寿胡廷慎父母 其一","张宁","南山有椿，其本秩秩。","四言"],["南山有椿颂寿胡廷慎父母 其二","张宁","北堂有萱，净闿斯植。","四言"],["鸣鹿颂","张宁","鹿鸣呦呦，于山之幽。","四言"],["六礼有将式克语之三加有辞式克御之死丧之威翕共与之饮食言笑肃慎祇之增增来仍式谷以之毋俾此邦不竞谓之 其一","张宁","伊厥肇基，实既于强。","四言"],["六礼有将式克语之三加有辞式克御之死丧之威翕共与之饮食言笑肃慎祇之增增来仍式谷以之毋俾此邦不竞谓之 其二","张宁","何晦于夕，何著于昕。","四言"],["独漉篇","张宁","独漉独漉，水清泥浊。","四言"],["薤露八章挽沈希仁父","张宁","萎彼薤斯，零露瀼瀼。","四言"],["古战场","郑善夫","朝发汾河，暮经白沟。","四言"],["菖歜二章赠孙太初山人","郑善夫","菖歜葱葱，在彼涧滨。","四言"],["野田黄雀行","郑善夫","翼翼黄雀，集彼榛柯。","四言"],["梁之石操上杨国老","郑善夫","梁之山兮，岳岳其砥。","四言"],["梦井歌二章","郑善夫","井之京京，其出渊渊。","四言"],["白泉二章赠汪希周","郑善夫","湔湔流泉，行彼地中。","四言"],["驱马五章章五句黄钟清宫","黄佐","驱马滔滔，遵彼林皋。","四言"],["彼尔有棠五章章四句黄钟清宫","黄佐","彼尔有棠，敷贲于稷。","四言"],["短歌行送洪子玉方","黄佐","秋露载晞，朔云云飞。","四言"],["宫桑闻北郊亲蚕赋 其一","黄佐","有菀宫桑，遵彼郊场。","四言"],["宫桑闻北郊亲蚕赋 其二","黄佐","有菀宫桑，遵彼郊曲。","四言"],["宫桑闻北郊亲蚕赋 其三","黄佐","毋曰我私，黼裳卷衣。","四言"],["梧凤朝阳三章","黄佐","维梧有凤，鸣于朝阳。","四言"],["翩翩者鹤贺吴子重闱荣寿三首 其三","黄佐","翩翩者鹤，鸣于菀林。","四言"],["双节旌门诗","黄佐","明昭我皇，敬跻圣神。","四言"],["招颂补遗九首 其三 浚畎浍","黄佐","禹决九川，以距四海。","四言"],["招颂补遗九首 其五 锡玄圭","黄佐","禹锡玄圭，告厥成功。","四言"],["招颂补遗九首 其六 建皇极","黄佐","建皇之极，六府孔修。","四言"],["招颂补遗九首 其七 明明一终","黄佐","明明尚天，烂然星陈。","四言"],["招颂补遗九首 其八 明明二终","黄佐","明明帝命，八风修通。","四言"],["梦中朔风诗三章","黄佐","朔风萧萧，庭绿葳蕤。","四言"],["麒麟诗","陈琏","至和储精，麒麟降生。","四言"],["紫霞泉","陈琏","一派寒泉，出于山址。","四言"],["步出夏门行","黄省曾","步出夏门，登山望海。","四言"],["高士颂九十一首 其一 被衣","黄省曾","大道不凿，至人秀世。","四言"],["高士颂九十一首 其二 王倪","黄省曾","王倪天士，缺也问道。","四言"],["高士颂九十一首 其四 巢父","黄省曾","巢父鸟栖，弗营栋宇。","四言"],["高士颂九十一首 其五 许由","黄省曾","武仲洁修，毫邪不处。","四言"],["高士颂九十一首 其六 善卷","黄省曾","逖矣善卷，君尧北面。","四言"],["高士颂九十一首 其七 子州支父","黄省曾","休休支父，道重八埏。","四言"],["高士颂九十一首 其八 壤父","黄省曾","老父皤发，愉愉壤戏。","四言"],["高士颂九十一首 其九 石户之农","黄省曾","虞皇御世，虚咨禅者。","四言"],["高士颂九十一首 其十 蒲衣子","黄省曾","蒲衣妙纪，德与天侔。","四言"],["高士颂九十一首 其十一 披裘公","黄省曾","负薪炎暑，吴有一翁。","四言"],["高士颂九十一首 其十二 江上丈人","黄省曾","丈人遗俗，鼓枻江隈。","四言"],["高士颂九十一首 其十三 小臣稷","黄省曾","小臣之稷，微尔齐氓。","四言"],["高士颂九十一首 其十四 弦高","黄省曾","弦公郑宝，托迹迁贾。","四言"],["高士颂九十一首 其十五 商容","黄省曾","商容大道，聃也之师。","四言"],["高士颂九十一首 其十六 老子李耳","黄省曾","伯阳圣老，人貌天行。","四言"],["高士颂九十一首 其十七 庚桑楚","黄省曾","庚桑耳役，画去挈远。","四言"],["高士颂九十一首 其十八 老莱子","黄省曾","楚莱避纷，蒙阳寄耜。","四言"],["高士颂九十一首 其二十 荣启期","黄省曾","荣公何族，弗美身隅。","四言"],["高士颂九十一首 其二十一 荷蒉","黄省曾","荷蒉者何，逃名卫地。","四言"],["高士颂九十一首 其二十二 长沮桀溺","黄省曾","悠悠沮溺，并耜荒墟。","四言"],["高士颂九十一首 其二十三 石门守","黄省曾","石门门者，阖辟是尸。","四言"],["高士颂九十一首 其二十四 荷筱丈人","黄省曾","丈人绝轨，倨接洙贤。","四言"],["高士颂九十一首 其二十五 陆通","黄省曾","接舆厌浊，放隐佯狂。","四言"],["高士颂九十一首 其二十六 曾参","黄省曾","孝哉子舆，领道泗滨。","四言"],["高士颂九十一首 其二十七 颜回","黄省曾","颜氏之子，不怍簟瓢。","四言"],["高士颂九十一首 其二十八 原宪","黄省曾","原生匮盝，室侵风雨。","四言"],["高士颂九十一首 其二十九 汉阴丈人","黄省曾","丈人治圃，搰搰其劳。","四言"],["高士颂九十一首 其三十 壶丘子林","黄省曾","至哉壶子，列老下趋。","四言"],["高士颂九十一首 其三十一 老商氏","黄省曾","老商树教，列寇下趋。","四言"],["高士颂九十一首 其三十二 列御寇","黄省曾","御寇隐郑，四十馀年。","四言"],["高士颂九十一首 其三十三 庄周","黄省曾","庄周傲世，洸洋寓言。","四言"],["高士颂九十一首 其三十四 段干木","黄省曾","干木自晋，萍寓西河。","四言"],["高士颂九十一首 其三十五 东郭顺子","黄省曾","灏灏东郭，动展如天。","四言"],["高士颂九十一首 其三十六 公仪潜","黄省曾","鲁慕公仪，崇阶以钓。","四言"],["高士颂九十一首 其三十八 颜斶","黄省曾","特哉齐斶，剧折庙堂。","四言"]]