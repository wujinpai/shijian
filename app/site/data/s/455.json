ll,null,null,null,null,["济州登太白楼怀郑从之御史二首 其一","曹伯启","高城蘸云根，聊可慰心迹。","五言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["宿台山寺绝顶","卢琦","江白潮已来，山黑月未出。","五言律诗"],null,null,null,["吴兴杂咏","朱晞颜","吴兴山水窟，清远古今闻。","五言律诗"],null,null,null,null,null,null,null,null,null,null,["寄衣曲 其一","宋无","闻有宫袍赐，翻令闺意伤。","五言律诗"],["自君之出矣二首 其一","宋无","自君之出矣，妾不出闺门。","五言律诗"],null,null,null,null,["观物 其二","许衡","万物备吾身，身贫道未贫。","五言律诗"],["水南晚眺","周昂","小径通沙稳，清溪带树深。","五言律诗"],null,["次韵鉴中八咏 其八 芬陀室","于立","视心如莲花，净明涵十虚。","五言律诗"],["次韵鉴中八咏 其四 梅山","于立","梅山如积翠，的皪手堪捧。","五言律诗"],null,["班婕妤 其一","张玉娘","一自怜捐弃，香迹玉阶疏。","五言律诗"],null,null,null,null,null,null,["和章守","元振","华堂存绘事，昭代得仪刑。","五言律诗"],["和章守","元振","飞楼跨危堞，云雾晓披披。","五言律诗"],null,["望云","黄石翁","日出五丈高，白云浩如海。","五言律诗"],["次友之秋日雨后韵","王涧","洺州秋雨后，幽胜可供闲。","五言律诗"],["高端叔挽词","元之","铁石赋梅花，闲情白玉瑕。","五言律诗"],null,null,null,null,null,["写怀","吕中孚","秦川西去远，不意过漳川。","五言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["集古 惜花","李俊民","花树流莺日过迟，少年争惜最红枝。","七言律诗"],["集古 送春","李俊民","可怜寥落送春心，负郭依山一径深。","七言律诗"],["集古 赠别","李俊民","萧萧落叶送残秋，楼上黄昏欲望休。","七言律诗"],["集古 恨别","李俊民","凄凄长是别离情，冰簟银床梦不成。","七言律诗"],["集古 戏遣","李俊民","雨散云收一饷闲，不知何处入空山。","七言律诗"],["集古 不遇","李俊民","来往风尘共白头，谁人肯向死前休。","七言律诗"],["集古 仙庙","李俊民","桂泠松香十里闲，水晶如意玉连环。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["登凤凰台二首 其二","萨都剌","梧桐叶落秋风老，人去台空凤不来。","七言律诗"],["送王真人北上代刘宗师","萨都剌","玉佩丁东下界闻，天风吹动碧霞裙。","七言律诗"],["还京口","萨都剌","黄鹤山头雪未消，行人归计在今朝。","七言律诗"],["和参政王继学海南初还韵","萨都剌","飘零南北与东西，倦鸟投林未许栖。","七言律诗"],null,null,null,["还台偶成","萨都剌","高低柳絮飞渡水，红白桃花开满枝。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,nul