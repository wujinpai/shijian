,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["暮春感怀 其一","丁鹤年","杜宇声声唤客愁，故园何处此登楼。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["鼓山灵源洞","黄镇成","屴崱峰头万丈梯，上方高与白云齐。","七言律诗"],null,null,null,null,null,null,null,null,null,["读汪水云诗集二首 其一","乃贤","三日钱塘海不波，子婴系组纳山河。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["寄文济王府教授郭尚之","卢琦","闻君客食贤王府，剪地芙蓉赐坐温。","七言律诗"],["愁","卢琦","来何容易去何迟，半在心头半在眉。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,["又，槜李诗系卷三八陈彦廉作春草堂养母，诗以美之","张昱","綦履鸣环左右间，佳儿佳妇及承欢。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["送道士游武当","郭翼","武当诸峰何壮哉，大朵小朵青莲开。","七言律诗"],["奉同袁子英简呈杨廉夫先生","郭翼","杨子十年官不调，如此永州文力何？","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["邳州","贡奎","荒城十载路重经，暂舣扁舟坐驿亭。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["无题二首 其一","张玉娘","征雁初闻废织梭，支颐机杼恨偏多。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,nu