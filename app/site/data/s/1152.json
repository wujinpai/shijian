[["偈","释圆济","雨过山青，云开月白。","四言"],["神功盛德诗  其二四","华镇","济济朝廷，有名有实。","四言"],["乾道七年恭上太上皇帝太上皇后尊号十一首 其八 太傅奉太上皇后册宝升殿用《圣安》。","郊庙朝会歌辞","乾元资始，坤元资生。","四言"],["采蕺 其三","王十朋","厥草匪甘，厥蔬匪香。","四言"],["偈颂三首 其一","释行巩","横眸碧汉，万国风清。","四言"],["放翁自赞四首 其二","陆游","名动高皇，语触秦桧。","四言"],["石霜普照珂禅师赞","惠洪","漆瞳照座，骨相巉岩。","四言"],["暑热","白玉蟾","玉友避嫌，竹奴专宠。","四言"],["和陶命子韵示津调官 其五","吴芾","勿谓吾身，有才有德。","四言"],["临终辞众偈","释元聪","来未尝来，去未尝去。","四言"],["偈八首 其七","释仁勇","大方无外，大圆无内。","四言"],["永嘉真觉大师真赞","惠洪","情根无功，意识无作。","四言"],["太常乐章三十首 其五 皇帝酌献第一室奏大善之舞曲","杨亿","肃肃艺祖，肇基洪源。","四言"],["道从上人","释祖钦","惟道是从，惟心是宗。","四言"],["紫岩九章章八句上寿张丞相  其一","张元干","赫赫紫岩，白虹贯渊。","四言"],["和陶时运四首，并引 其二","苏轼","下有澄潭，可饮可濯。","四言"],["汾阳昭禅师真赞","惠洪","维摩杜口，释迦饶舌。","四言"],["和陶时运四首，并引 其一","苏轼","我卜我居，居非一朝。","四言"],["颂古","释昙华","居士倒地，灵照扶起。","四言"],["家国吟","邵雍","邪正异心，家国同体。","四言"],["和冯济川题枯髅图","释法清","形骸在此，其人何在。","四言"],["偈颂四十二首 其九","释祖先","马祖升堂，百丈卷席。","四言"],["嵩禅师赞","惠洪","欧阳之学，师宗于世。","四言"],["和陶命子韵示津调官 其四","吴芾","乔木千寻，竟困斧柯。","四言"],["赞死心禅师偈 其一","释惟久","韶阳死心，灵源甚深。","四言"],["文宣王及其弟子赞 其十","赵构","谦德知二，器实瑚琏。","四言"],["哑子观音赞","释子益","赞者舌秃，画者口哑。","四言"],["颂古七十六首  其七五","释士珪","口是祸门，电掣雷奔。","四言"],["长沙岑大虫真赞","惠洪","长沙大虫，声威甚重。","四言"],["赞死心禅师偈 其二","释惟久","死心非真，真非死心。","四言"],["转轮八花诗 其六","项安世","槁枯滋泽，偃屈抽芒。","四言"],["宽猛吟","邵雍","宽则民慢，猛则民残。","四言"],["观音真赞 其三","释慧空","此大开士，愿力弘深。","四言"],["皇雅十首  其七","尹洙","蜀都既平，将臣失律。","四言"],["颂古五首 其三","释慧光","偷吃油糍，卖弄口觜。","四言"],["和陶命子韵示津调官 其九","吴芾","既有馀力，且亲灯火。","四言"],["偈颂一百六十九首 其一五五","释智朋","丛林圣制，有解有结。","四言"],["荣木和陶靖节韵","程洵","我卜我居，游息在兹。","四言"],["颂古五首 其四","释文准","人人生缘，北律南禅。","四言"],["须菩提赞","释师观","老老大大，岩中宴坐。","四言"],["十画四言","孔平仲","亨倅沉俗，泥虬卧虹。","四言"],["荣木","范成大","薰风南来，木荣于兹。","四言"],["禅人写余真求赞 其二","释慧方","古松怪石，全体是我。","四言"],["题枯髅图","冯楫","形骸在此，其人何在。","四言"],["天禧三年册皇太子一首","郊庙朝会歌辞","明离之象，少阳之位。","四言"],["为黄仲宣赋山中四章章四句  其三","方回","山中之人，耘夫耕民。","四言"],["颂古四十四首 其一","释法泰","生无所生，死无所死。","四言"],["山行见月作 其三","赵蕃","东坡老翁，有言莫酬。","四言"],["观世音赞六首 其六","黄庭坚","敬礼补陀，岩下水边。","四言"],["淳化乡饮酒三十三章  其一七","郊庙朝会歌辞","崇丘峨峨，动植斯属。","四言"],["新安吕公尚书夫人坟","徐积","彼美新安，有水有山。","四言"],["兴祖","释崇岳","有祖以来，世不可陪。","四言"],["皇雅十首  其一四","尹洙","帝怀永图，治古是宪。","四言"],["偈二十七首 其十一","释守