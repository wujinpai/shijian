[null,null,null,null,null,null,null,null,null,null,null,null,["晚次鄂州","卢纶","云开远见洛阳城，犹见孤帆一日程。","七言绝句"],null,null,null,null,null,null,null,null,null,null,null,null,null,["山家","张继","板桥人渡泉声，茅檐日午鸡鸣。","六言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["春雪","刘方平","飞雪带春风，徘徊乱绕空。","五言绝句"],null,null,null,null,null,null,["暮秋山行（节选）","岑参","疲马卧长坂，夕阳下通津。","五言绝句"],null,["送李中丞归汉阳别业","刘长卿","流落征南将，曾驱十万师。","五言律诗"],["秋日登吴公台上寺远眺","刘长卿","古台摇落后，秋入望乡心。","五言律诗"],null,null,null,["早梅","张谓","一权寒梅白玉条，迥临村路傍溪桥。","七言绝句"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["古朗月行（节选）","李白","小时不识月，呼作白玉盘。","五言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["晓发","贺知章","故乡杳无际，江皋闻曙钟。","五言绝句"],null,null,null,null,["赋得古原草送别","白居易","离离原上草，一岁一枯荣。","五言绝句"],null,null,null,null,["西塞山怀古","刘禹锡","王浚楼船下益州，金陵王气黯然收。","七言律诗"],null,null,null,null,null,null,null,["村民苦寒（节选）","白居易","八年十二月，五日雪纷纷。","五言长篇"],null,null,null,null,null,["清明","杜牧","清明时节雨纷纷，路上行人欲断魂。","七言绝句"],null,null,null,null,null,null,null,null,null,null,["落花","李商隐","高阁客竟去，小园花乱飞。","杂言"],null,null,null,null,null,null,null,null,null,["遣怀","杜牧","落魄江湖载酒行，楚腰纤细掌中轻。","七言绝句"],null,null,null,null,null,null,null,null,["孤雁","崔涂","几行归塞尽，念尔独何之？暮雨相呼失，寒塘欲下迟。","五言律诗"]]