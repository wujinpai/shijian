[null,null,null,null,null,null,["题梅坛","钟尤","万松护岭与天齐，中有真人旧隐栖。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,["椒屯墟","黄载","乔水村墟十里秋，渔盐微利竞蝇头。","七言律诗"],null,null,["碧沼寺","丁仿","万峰翠插锁萦纡，一沼光涵湛碧虚。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["涵碧亭","刘述","两山嵚处一泉飞，飞到亭前聚作池。","七言律诗"],["天边风露楼漫题","卢珏","十二阑干俯碧溪，凭高一览万山低。","七言律诗"],null,["忆罗浮","古成之","忆昔罗浮最上峰，当年曾得寄仙踪。","七言律诗"],["凤鸣洞","史唐卿","何年雷斧凿山裂，千尺苍崖泻飞雪。","七言律诗"],null,["登凌云山绝顶","叶升","崔巍万仞俨危梯，蹑履多凭一杖藜。","七言律诗"],null,null,["题光华亭","叶簬","画栋朱帘势翼然，鼎新气象冠山川。","七言律诗"],null,["贺陈随隐以布衣除东宫掌书","吕三馀","青宫楼观近尧阶，班列屏风间坐开。","七言律诗"],null,null,null,null,["句","吕希哲","将谓清风全扫地，世间今复有卢鸿。","七言律诗"],null,null,null,null,null,null,null,null,["九姑山最高亭","姚?","一亭重构冠崇冈，下瞰千岩拱四旁。","七言律诗"],null,null,null,["顶山寺","孔延之","高山峰顶欲参天，蓄怪储灵远近传。","七言律诗"],null,null,null,null,null,null,null,null,["嘉鱼池","宁某","四百峰峦隐画屏，翠光楼阁起山溟。","七言律诗"],null,["句","宋自适","老去放令心胆健，后来留得姓名香。","七言律诗"],["题七星岩","宋逑","三四奇峰傍短亭，一岩春色冠图经。","七言律诗"],null,["被命出镇淮西至任","尤煜","万籁无声意转豪，一挥出守敢云劳。","七言律诗"],null,null,["云间阁留题壁间","张垓","清江一曲抱村流，古柏千茎绕径幽。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,["题集福院","徐楠","松溪竹坞密藏村，行尽杉阴始到门。","七言律诗"],null,["送梵才上人归天台","徐舜俞","芳袍麟殿赐蒲茸，道胜年来请谒慵。","七言律诗"],null,null,null,null,["灯市","曹?","春满天街夜色酣，绮罗香结雾漫漫。","七言律诗"],null,null,null,null,null,null,null,null,null,["上巳从史巫山?饮江皋","李埴","风沙一夜卷冥冥，晓色曈曚上翠屏。","七言律诗"],null,["句","李大方","三百年来今几秋，天地自老江自流。","七言律诗"],null,null,null,null,null,null,null,null,["送僧归护国寺","李遵勖","雷海谭音出世雄，台岩香社冠禅丛。","七言律诗"],["金紫岩","李钖","百尺云岩道院边，晓钟疏磬思悠然。","七言律诗"],null,null,null,null,["绍兴己巳游洞霄","杨契","青山九锁隔凡缘，福地潜通小有天。","七言律诗"],["福应山","杨崈","清风送月上栏干，云雨溪流破玉寒。","七言律诗"],null,["游惠山","杨文炳","骑马西神访远公，湛君旧宅且从容。","七言律诗"],null,null,null,null,null,null,["横山耸翠","柳叙","兰阴山跨浴溪南，瀔破峰颜三月三。","七言律诗"],null,null,null,null,null,null,null,null,["等法院","江白","满路烟花画不成，栖桐佳致古流名。","七言律诗"],null,null,null,["句","温益","少年曾接元公论，屡话南闽佛刹奇。","七言律诗"],null,null,null,null,null,null,null,null,null,["游黄山留题","王揆（尤溪","地灵山秀景清虚，健羡游人兴有馀。","七言律诗"],null,null,null,null,null,["登巾子山有怀旧游","王道","路转岧峣瞰古城，阑干曲处眼偏明。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["批赵氏卷","罗壮","汗牛试卷浩无涯，刬尽雷同别一家。","七言律诗"],null,null,null,null,null,null,null,["句","苏绅","游人汉女投珠路，野火荆山出猎朝。","七言律诗"],null,null,["呈寇公二首","蒨桃","一曲清歌一束绫，美人犹自意嫌轻。","七言律诗"],null,null,null,null,null,null,null,null,null,["句","袁默","高标远韵果何处，宜在小沼浮荷花。","七言律诗"],null,["送钤辖馆使王公","解程","武帐推恩诏十行，雍容鸣玉觐清光。","七言律诗"],null,null,null,["留题白龙山","赵发","访梅那复怕山寒，隙地原来有大观。","七言律诗"],null,null,null,null,null,null,null,["杨十七应之兄学士挽辞","赵挺之","廓落襟怀德艺优，身名曾不问沈浮。","七言律诗"],null,["喜英公大师相访","赵昌言","僧中何事最闻名，笔札高奇是梦英。","七言律诗"],null,null,["与同年陈公过山亭","赵汝暖","青苔满地护阶阴，尘俗曾无半点侵。","七言律诗"],null,null,null,null,["和华安仁花村二首","赵逢","格是而今老有馀，行行真欠瘦筇扶。","七言律诗"],null,null,null,["钱塘晚望","郑协","钱塘江上夜潮过，秋静寒烟白露多。","七言律诗"],null,null,null,["赠梦英大师","郭从义","云水僧来说我师，换鹅书札转高奇。","七言律诗"]]