[["度关山","曹操","天地间。",""],["短歌行 其一","曹操","对酒当歌，人生几何！譬如朝露，去日苦多。",""],["短歌行 其二","曹操","周西伯昌，怀此圣德。",""],["对酒","曹操","对酒歌，太平时，吏不呼门。",""],["观沧海","曹操","东临碣石，以观沧海。",""],["龟虽寿","曹操","神龟虽寿，犹有竟时。",""],["蒿里行","曹操","关东有义士，兴兵讨群凶。",""],["精列","曹操","厥初生。",""],["苦寒行","曹操","北上太行山，艰哉何巍巍！",""],["气出唱 其一","曹操","华阴山，自以为大。",""],["气出唱 其二","曹操","驾六龙，乘风而行。",""],["气出唱 其三","曹操","游君山，甚为真。",""],["却东西门行","曹操","鸿雁出塞北，乃在无人乡。",""],["塘上行","曹操","蒲生我池中，其叶何离离。",""],["薤露行","曹操","惟汉廿二世，所任诚不良。",""],["陌上桑","曹操","驾虹霓，乘赤云，登彼九疑历玉门。",""],["秋胡行 其一","曹操","晨上散关山，此道当何难！",""],["秋胡行 其二","曹操","愿登泰华山，神人共远游。",""],["善哉行 其一","曹操","古公亶甫，积德垂仁。",""],["善哉行 其二","曹操","自惜身薄祜，夙贱罹孤苦。",""],["善哉行 其三","曹操","朝日乐相乐，酣饮不知醉。",""],["步出夏门行 艳","曹操","云行雨步，超越九江之皋。",""],["步出夏门行 冬十月","曹操","孟冬十月，北风徘徊，",""],["步出夏门行 土不同","曹操","乡土不同，河朔隆冬。",""],["谣俗词","曹操","瓮中无斗储，发箧无尺缯。",""],["董逃歌词","曹操","德行不亏缺，变故自难常。",""]]