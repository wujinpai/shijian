[null,null,null,null,null,null,["南华阳洞","周文璞","稽首游名山，驾言入华阳。","五言长篇"],null,null,null,null,null,null,null,null,["种罂粟","李复","前年阳亢骄，旱日赤如血。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,["和答李德臣","刘辰翁","忍寒一百五，何开落匆匆。","五言长篇"],["春景 绝域改春华","刘辰翁","绝域何堪久，悠悠日又斜。","五言长篇"],["春景 落花香满泥","刘辰翁","春去如流水，落花忙又忙。","五言长篇"],["春景 村村自花柳","刘辰翁","御宿长杨馆，南山沁水园。","五言长篇"],["春景 新年贺太平","刘辰翁","乱向残年定，东风息战尘。","五言长篇"],["春景 小水细通池","刘辰翁","过雨山泉润，悠悠小水同。","五言长篇"],["春景 孤舟乱春华","刘辰翁","天地孤舟客，东风是处家。","五言长篇"],["夏景 夏雨生众绿","刘辰翁","入夏可曾晴，阴阴众绿成。","五言长篇"],["夏景 松凉夏健人","刘辰翁","松影夏天云，凉开一院新。","五言长篇"],["夏景 衣冷欲装绵","刘辰翁","老厌人间热，单衣就冷泉。","五言长篇"],["秋景 月色醉远客","刘辰翁","明月有佳色，客中迷远游。","五言长篇"],["秋景 门掩候虫秋","刘辰翁","四壁可谁语，一年将次休。","五言长篇"],["秋景 出逢危叶落","刘辰翁","举眼秋萧索，乾坤岂不容。","五言长篇"],["秋景 鹭于飞","刘辰翁","沧洲开晚景，莽苍更依稀。","五言长篇"],null,null,["郡斋望蒋山","叶梦得","十年在空山，未觉与世殊。","五言长篇"],["送沈传曜","叶梦得","卞峰摩青空，东望乌氐墩。","五言长篇"],["哭赵叔问","叶梦得","刘氏磐石宗，略分天下半。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["牧童歌十首 其一","蒲寿宬","荷笠小苍头，犊裈乘水牛。","五言长篇"],null,["和博古直五首 其一","蒲寿宬","圣门蔼徒众，几人得称贤。","五言长篇"],null,["舶使王会溪太守赵见泰九日领客枉顾山中赋采菊东篱下悠然见南山韵十首 其一","蒲寿宬","翠节摩秋云，朱轓映朝彩。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,["松风","释智圆","青青数树松，扶疏空庭里。","五言长篇"],["湖居感伤","释智圆","迷真渺无始，飘业产钱唐。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["子温侄用再闻诵新作突过黄初诗作十诗见遗辄勉强次韵 其一","张扩","小人无远谋，湮没如湛辈。","五言长篇"],null,null,["奉和朱新仲祠部六月晦日省宿用白乐天诗无波古井水有节秋竹竿十字为韵 其一","张扩","漫郎省中宿，展转良夜徂。","五言长篇"],null,["送高丞别","李吕","君侯七闽英，学问早有馀。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["乙亥岁八月十五日夜同景叔知府少卿翼道提举大夫望月于河中之名阃堂兼简襄守欧三叔弼虢守孙八元忠二首 其一","毕仲游","上楼初照席，条华渐分明。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["何和尚寻母","赵文","写经母血尽，长素母容枯。","五言长篇"],null,null,null,null,null,null,null,["送谯允蹈解青神赴永康学官二首 其一","史尧弼","簿领尘埃地，淹回岁月阑。","五言长篇"]]