[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["次宋省斋木犀 其一","杨公远","西风生桂子，香色总关情。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["送沈炼师归武夷 其一","胡仲弓","仙骨久已蜕，尚遗空石函。","五言长篇"],null,null,null,null,null,null,["送林弓寮归闽省觐竹溪中书往赴安溪县新任 其一","释文珦","当展经纶志，初为抚字官。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["闲居","释文珦","影不落人间，空门断往还。","五言长篇"],null,null,null,null,null,["依韵酬葛秋岩陶体四首 其一","释文珦","山林自多趣，况此晴和时。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["真歇老人退居东庵予过雪峰特访之为留再宿仍赋两诗 其一","张元干","云卧孤峰顶，斋馀闭户眠。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["庚午岁屏居零陵七月二十日以门掩候虫秋为韵赋五首 其一","汪藻","幽人独夜时，潮落西川根。","五言长篇"],["与任道及顺久二师赋小阁见月","强至","醉领玉川子，夜入支公院。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["赠史康时二首 其一","李洪","史侯眉山英，壮岁陪戎旃。","五言长篇"],["题四兰 风","释绍昙","深藏岩谷里，初不要人知。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["维心过邵子非溪亭夜话有伤时感旧之作索余次韵 其一","沈与求","官仪全复汉，盟会竞尊周。","五言长篇"],null,["子虚航重湖之险远过山中辄次维心韵以谢 其一","沈与求","客里伤为别，相望岁一周。","五言长篇"],null,null,["刘希颜提举见过出示卞山居二诗次其韵 其一","沈与求","偪仄风尘际，分携岁月赊。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["游郭希吕石洞二十咏 其一 清旷","刘过","笋舆咿哑来，路转此歇脚。","五言长篇"],null,null,null,null,null,null,null,null,null,null,null,null,null,["送税官仇副使诗十首","熊禾","儒道未易行，俛首为禄仕。","五言长篇"],["上严廉访十首","熊禾","七闽天南陬，实惟文明方。","五言长篇"],["赠王典史五首","熊禾","百里古君侯，一邑天下积。","五言长篇"],["寄赵菊东山长三首","熊禾","男儿贵神交，何必见颜色。","五言长篇"],["三山先贤祠落成八首","熊禾","填宿久旅奎，一朝开文治。","五言长篇"],["七夕遇雨访石堂先生","熊禾","今宵无月烛，鬃瓢泻银河。","五言长篇"],["暑雨","范纯仁","暑候积隆暵，骄阳变重阴。","五言长篇"],null,["签判李太博静胜轩二首 其一","范纯仁","开轩纳清景，为吏似闲居。","五言长篇"],null,null,null,null,null,null,null,null,null,null,["孙曼叔尚书挽词三首 其一","范纯仁","少海风云会，先朝眷遇隆。","五言长篇"],null,null,["蜀郡范公景仁挽词三首 其一","范纯仁","翰苑文章伯，金华侍从臣。","五言长篇"]]