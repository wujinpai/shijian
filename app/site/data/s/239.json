[["槟榔俗语","佚名","槟榔扶留，可以忘忧。","残句"],["句","高若拙","人间不见月，天外自分明。","残句"],["闲[宵]（霄）望月","鲍君徽","转扇来清风，援琴飞白雪。","残句"],["九日","蔡孚","九日重阳节，开门有菊花。","残句"],null,["题旅榇","廖有方","嗟君没世委空囊，几度劳心翰墨场。","残句"],["秋晴曲江望太一纳归云赋附歌","乔潭","节彼南山兮人所瞻，施此云雨兮济君欲。","残句"],["远意","崔公远","看花独不语，裴回双涙澘。","残句"],["途中诗","卞震","风涛秋渡阙，烟雨晚村孤。","残句"],["郑生诗","湘中蛟女","情无垠兮水汤汤，怀佳期兮属三湘。","残句"],["句 一","李尧夫","水沉为骨玉为肌。","残句"],["杂歌谣辞 黄麞歌","佚名","黄麞黄麞草里藏，弯弓射尔伤。","残句"],["句 二","李尧夫","群芳且莫相矜笑。","残句"],["句","屠瓌智","轻身都是义，殉主始为忠。","残句"],["别崔琼英","张𬸦","卞和山未斵，羊雍地不耕。","残句"],["赏酴醿","薛熊","香琼绶带雪缨络。","残句"],["句","周存孺","指下黄金星未曙，七条弦上夜乌啼。","残句"],["句","潘天锡","风便磬声远，日斜楼影长。","残句"],["时人为兔褐语（题从《古谣谚》卷五八）","佚名","兔褐真不如假。","残句"],null,["句","赵仁奖","令乘骢马去，丞脱绣衣来。","残句"],["金榆山土人言（题拟）","佚名","金驴一鸣，天下太平。","残句"],null,null,["袁夸郎遇仙诗 袁夸郎清夜长吟（题拟）","佚名","露湿寒塘草，月映清淮流。","残句"],null,null,["醉卧田间赖里人章氏子扶归作诗以谢之","吕从庆","荷锄田泽畔，垂手引糢糊。","残句"],null,null,null,null,null,null,null,null,null,null,null,null,null,["马作人语","佚名","芦荻花，此花开后路无家。","残句"],["梦黄衣童子歌","代宗","中五之德方峨峨，胡胡呼呼何奈何。","残句"],["梦中句","周延翰","紫髯之伴有丹砂。","残句"],["梦中和句","任玠","故国路遥归去来，春风天远望不尽。","残句"],["梦中语","杜牧","辞春不及秋，昆脚与皆头。","残句"],["梦中诗","胥偃","昔作树头花，今为冢中骨。","残句"],["梦中语","曾崇范妻","田头有鹿迹，由尾著日炙。","残句"],["纪梦句","张孜","上天知我忆其人，使向人间梦中见。","残句"],["皇太子夏日赐宴诗","权龙褒","严霜白浩浩，明月赤团团。","残句"],["续茅山秀才吟","顾况","驻马上山阿，风来屎气多。","残句"],["讥元载诗","高亭","上元官吏务剥削，江淮之人皆白著。","残句"],["嘲赵璘 其二","薛能","不知原在鞍轿里，将谓空驮席帽归。","残句"],["嘲赵璘 其三","薛能","火炉床上平身立，便与夫人作镜台。","残句"],["别庐州郡人","郑綮","唯有两行公廨泪，一时洒向渡头风。","残句"],["戏荅成汭","徐彦若","南海黄茅瘴，不死成和尚。","残句"],["荅妻","冯晖","休说办不办，且看瓮里飞出雁。","残句"],["被按自悔诗","刘炎","早知太守如虎狼，猎取膏粱以啗之。","残句"],["荅或人","张𬸦","宁可且将朱唇饮酒，谁能遂你黑齿常之。","残句"],["嘲崔嘏","施肩吾","二十九人及第，五十七眼看花。","残句"],["岭南诗句","苏芸","郭里多榕树，街中足使君。","残句"],["谐诗逸句 其一","包贺","雾是山巾子，船为水靸鞋。","残句"],["谐诗逸句 其二","包贺","櫂摇船掠鬓，风动水槌胸。","残句"],["谐诗逸句 其三","包贺","苦竹笋抽青橛子，石榴树挂小缾儿。","残句"],["题洞庭湖","蔡押衙","可怜洞庭湖，恰到三冬无髭须。","残句"],["戏令狐相","温庭筠","自从元老登庸后，天下诸胡悉带铃。","残句"],["与罗隐互谑","顾云","青蝇被扇扇离席，白泽遭钉钉在门。","残句"],null,["嘲廪丘令丞","商则","令丞俱动手，县尉止回身。","残句"],["题汉祖庙","罗颖","项羽英雄犹不惧，可怜容得辟阳侯。","残句"],["自赋催妆诗","陈峤","彭祖尚闻年八百，陈郎犹是小孩儿。","残句"],null,["荅弟妇歇后语","李涛","慙无窦建，媿作梁山。","残句"],["与释惠江互谑","程紫霄","僧录琵琶腿，先生觱栗头。","残句"],["嘲主司崔澹","佚名","主司何事厌吾王，解把黄巢比武王。","残句"],["嘲刘师老","佚名","大府朝天升穆老，尚书倒地落刘郎。","残句"],["嘲郑薰","佚名","主司头脑太冬烘，错认颜标作鲁公。","残句"],["嘲蒋蟠金丹","佚名","张鹄只消千驮绢，蒋蟠惟用一丸丹。","残句"],["注苗张二进士题名","佚名","一双前进士，两个阿孩儿。","残句"],["袁州人谑彭伉","佚名","湛贲及第，彭伉落驴。","残句"],["洛中人语","佚名","昔楼师德园，今袁德师楼。","残句"],["嘲毛炳彭会","佚名","彭生作赋茶三片，毛氏传诗酒半升。","残句"],["右威卫嘲语","佚名","门缘御史塞，厅被校书侵。","残句"],["南唐伶人献先主词","佚名","惟愿普天多瑞庆，柳条结絮鹅双生。","残句"],["闽伶官戏主延政语","佚名","只闻有泗州和尚，不见有五县天子。","残句"],["言志","佚名","腰缠十万贯，骑鹤上扬州。","残句"],["判部民诉主簿牒","王鲁","汝虽打草，吾已惊蛇。","残句"],["戏为冥吏判","伶人","焦湖百里，一任作獭。","残句"],["刺左右膊句","张干","生不怕京兆尹，死不畏阎罗王。","残句"],["薛将军歌","佚名","将军三箭定天山，战士长歌入汉关。","残句"],null,["桑条歌","佚名","桑条韦也，女时韦也乐。","残句"],["景龙中嘲宰相歌","佚名","礼贤不解开东阁，燮理惟能闭北门。","残句"],["吴人歌","佚名","朝判长洲暮判吴，道不拾遗人不孤。","残句"],["九龙帐歌","佚名","谁谓九龙帐，惟贮一归郎。","残句"],["曲江游人歌","佚名","春光且莫去，留与醉人看。","残句"],["挽歌","佚名","红轮决定沈西去，未委魂灵往那方。","残句"],["唐受命谶 其三","佚名","桃花园，宛转属旌幡。","残句"],["唐受命谶 其五","佚名","桃李子，洪水绕杨山。","残句"],["劝进疏引谶 四","佚名","胡兵未济汉不整，治中都护有八井。","残句"],["符凤引谶","佚名","黑衣神孙披天裳。","残句"],["南省北街人吟","佚名","放牓只应三月暮，登科又校一年迟。","残句"],["卢求牓谶","佚名","裴头黄尾，三求六李。","残句"],["清僧示赵宗儒","佚名","棃花发后杏花初，甸邑南来庆有余。","残句"],["又示段文昌","佚名","去日既逢梅蘂绽，来时应见杏花开。","残句"],["洛城五凤楼中歌","佚名","天津桥畔火光起，魏王堤上看洪水。","残句"],["唐旧谶","佚名","兔子上金床。","残句"],["蜀王氏谶文","佚名","李祜西王逢吉昌，上德兑兴丹莫当。","残句"],["孟蜀丐者语","佚名","不得登，登便倒。","残句"],["孟蜀桃符诗","佚名","新年纳余庆，嘉节号长春。","残句"],["上蓝和尚晋汉二代谶","佚名","石榴花发石榴开。","残句"],["又遗钟传偈","佚名","但看来年二三月，柳条堪作打钟槌。","残句"],["又报王审知十字谶","佚名","不怕羊入屋，只怕钱入腹。","残句"],["钱处士李氏谶","佚名","髣髴之间一倍杨。","残句"],["陈智广谶","佚名","骑马来，骑马去。","残句"],["昌明里中谶","佚名","欲知修续者，脚下是生毛。","残句"],["田承嗣诳李宝臣伪谶","佚名","二帝同功势万全，将田作伴入幽燕。","残句"],["上阳铜器篆","佚名","长宜子孙。","残句"],["永安渠石铭","佚名","百年为市后为池。","残句"],["长安空宅铭篆","佚名","夏天子紫金三千斤，赐有德者。","残句"],["玄元观栋桁记","佚名","山水谁无言，元年有福重修。","残句"],["青羊宫甎记","佚名","太平平中元灾。","残句"],["京西市放生池墓铭","佚名","龟言市，蓍言水。","残句"],["卫先生墓铭","佚名","姜师度，更移向南三五步。","残句"],["岩腹棺铭","佚名","欲堕不堕逢王果，五百年中重收我。","残句"],null,["四王语","佚名","宁向儋崖振白，不事江滕蒋虢。","残句"],["杨刺史语","佚名","宁食三斗蒜，不逢杨德干。","残句"],["万年人语","佚名","宁食三斗尘，无逢权怀恩。","残句"],["赞皇人语","佚名","太冲无兄，孝端无弟。","残句"],["时人为李义甫语","佚名","今日巨唐年，还诛四凶族。","残句"],["洛州语","佚名","洛州有前贾后张，可敌京兆三王。","残句"],["江淮间语","佚名","贵如许郝，富若田彭。","残句"],["河北语","佚名","唯此两何，杀人最多。","残句"],["李昭德为王弘义语","佚名","昔闻苍鹰狱吏，今见白兔御史。","残句"],["吏人语","佚名","不畏侯卿杖，惟畏尹卿笔。","残句"],["选人语 其二","佚名","硕学师刘子，儒生用与言。","残句"],["选人语 其三","佚名","今年柿子并遭霜，为语石榴须早摘。","残句"],["韦氏语","佚名","大郎罢相，小郎拜相。","残句"],["天授中语","佚名","遇徐杜者必生，遇来侯者必死。","残句"],["题张昌仪门语","佚名","一两丝能得几时络。","残句"],["时人号李知远语","佚名","李下无蹊。","残句"],["又号李乂语","佚名","李下无蹊径。","残句"],["时人为崔无诐语","佚名","皇后嫁女，天子娶妇。","残句"],["神龙中语","佚名","崔冉郑，乱时政。","残句"],["李处郁语","佚名","飧若入咽，百无一全。","残句"],["景云初语","佚名","前有裴马，后有卢李。","残句"],["先天时京中语","佚名","姜师度一心看地，傅孝忠两眼相天。","残句"],["时人号王丘崔沔语","佚名","丘山岌岌连天峻，沔水澄澄彻底清。","残句"],["吏部过官语","佚名","麟之口，光庭手。","残句"],["郇公厨语","佚名","人欲不饭筋骨舒，夤缘须入郇公厨。","残句"],["四俊语","佚名","令君四俊，苗吕崔员。","残句"],["八友语","佚名","殷颜柳陆，李萧邵赵。","残句"],["罗吉口号","佚名","罗钳吉网。","残句"],["里闾诅语","佚名","若违教，值三豹。","残句"],["真源邑语","佚名","南金口，明府手。","残句"],["称二王语","佚名","朝廷左相笔，天下右丞诗。","残句"],["戏谏司语","佚名","韩谏议虽分左右，归拾遗莫辨存亡。","残句"],["魏博语","佚名","长安天子，魏府牙军。","残句"],null,["又号牛李","佚名","门生故吏，不牛则李。","残句"],["郑仁表自语","佚名","天瑞有五色云，人瑞有郑仁表。","残句"],["湖苏二郡语","佚名","湖接两头，苏联三尾。","残句"],["广明初都人语","佚名","黄贼打黑贼。","残句"],["郎吏语","佚名","司门水部，入省不数。","残句"],["御史台语","佚名","事长如事端。","残句"],["京兆府语","佚名","不立两县令，不坐两少尹。","残句"],["翰林谏议语","佚名","饶道斗上坡去，亦须却下坡来。","残句"],["举子语","佚名","槐花黄，举子忙。","残句"],["明经进士语","佚名","三十老明经，五十少进士。","残句"],["杂帖语","佚名","常杂鲍帖。","残句"],["闽人语","佚名","欧阳独步，藻蕴横行。","残句"],["大中后进士语","佚名","欲得命通，问瑝嵎都雍。","残句"],["科目举人语","佚名","未见王窦，徒劳漫走。","残句"],["戏杜审权语","佚名","座主审权，门生处权。","残句"],["崔沆放牓时人语","佚名","座主门生，沆瀣一家。","残句"],["唐末五代人语","佚名","及第不必读书，作官何须事业。","残句"],["号沈宋语","佚名","苏李居前，沈宋比肩。","残句"],["号钱郎语","佚名","前有沈宋，后有钱郎。","残句"],["潘何诗赋语","佚名","潘纬十年吟古镜，何涓一夜赋潇湘。","残句"],["魏薛草书语","佚名","前有虞褚，后有薛魏。","残句"],["薛稷书语","佚名","买褚得薛不落节。","残句"],["时人为刘毕语","佚名","刘郎中松树孤标，毕庶子松根绝妙。","残句"],["时人为黄筌语","佚名","黄筌画鹤，薛稷减价。","残句"],["道杰语","佚名","大头杰，难杀人。","残句"],["马周疏引俚语","佚名","贫不学俭，富不学奢。","残句"],["杜甫引俚语","佚名","城南韦杜，去天尺五。","残句"],["孙光宪琐言引古语 一","佚名","乘船走马，去死一分。","残句"],["孙光宪琐言引古语 二","佚名","好事不出门，恶事行千里。","残句"],["杜重威引俚语","佚名","逢贼得命，更望复子。","残句"],["建安语","佚名","龙门一半在闽川。","残句