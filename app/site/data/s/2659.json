四言"],["三士道人自赞","郭之奇","诗骚作性，兰雪居胸。","四言"],["八章 其三 瀑布","郭之奇","湖山相联，云汉中悬。","四言"],["八章 其一 朱矶","郭之奇","湖沙漠漠，非人所乐。","四言"],["八章 其二 星墩","郭之奇","飞金逐玉，爰失其足。","四言"],["八章 其四 虾蟆石","郭之奇","视水临形，审志却停。","四言"],["八章 其五 大姑鞋","郭之奇","我闻在昔，随刊日迈。","四言"],["八章 其六 石钟","郭之奇","动静相持，元声以时。","四言"],["八章 其七 小姑钗","郭之奇","矻矻中阿，独立无颇。","四言"],["八章 其八 马当山","郭之奇","湖软江雄，追飞自东。","四言"],["八月四章","郭之奇","八月秋风，在河在嵩。","四言"],["鹿鸣三章","郭之奇","呦呦鹿鸣，天中有声。","四言"],["言旋","郭之奇","征车言旋，黄花在馆。","四言"],["家谋","郭之奇","既劳王役，徐定家谋。","四言"],["寒菊四章","郭之奇","凄葭一方，寒菊相俟。","四言"],["世心","郭之奇","无怀时远，世心日波。","四言"],["众口","郭之奇","结绳时远，众口喁𪡋。","四言"],["追昔","郭之奇","嗛嗛为膏，亦愧颐朵。","四言"],["勖今","郭之奇","外物欣己，亦念吾庐。","四言"],["汉谣四首 其一","郭之奇","祖龙璧归，秦鹿奔棘。","四言"],["汉谣四首 其二","郭之奇","采龙既成，生彘可食。","四言"],["汉谣四首 其三","郭之奇","商山四鸿，同哺雉鷇。","四言"],["汉谣四首 其四","郭之奇","雉则彘人，𪸩耳剔目。","四言"],["蓬栖","郭之奇","人亦有言，心远地偏。","四言"],["山水之闲","郭之奇","宇宙虽遐，古今若寄。","四言"],["空山十首 其一 山有云","郭之奇","山中何有，云在其中。","四言"]]