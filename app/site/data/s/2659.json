[["张伯子五十寿言","王世贞","昔在世皇，肃外台纲。","四言"],["石禅斋诗","王世贞","以禅呼石，石不点头。","四言"],["中泠馆诗","王世贞","天一之精，汇为天潢。","四言"],["上泷谣四章","屈大均","宁上三峡，莫上六泷。","四言"],["上滩谣三章","屈大均","一滩一尺，十滩一丈。","四言"],["上三峡谣","屈大均","潮上飞来，一宿即回。","四言"],["英德滩谣","屈大均","舟上龙头，一沉一浮。","四言"],["连州滩谣","屈大均","五里一峡，十里一滩。","四言"],["薏苡谣","屈大均","食米得薏，薏一米二。","四言"],["槟榔谣","屈大均","一殡一榔，无蒌亦香。","四言"],["罾布谣","屈大均","以罾为布，渔家所造。","四言"],["渔谣","屈大均","鳝多乌耳，蟹尽黄膏。","四言"],["甘露八章章四句","李梦阳","于辟是兴，皇用锡祉。","四言"],["有鸱六章","李梦阳","有鸱有鸱，集于乔林。","四言"],["型范","李梦阳","器土必型，器竹必范。","四言"],["归寿 其一","李梦阳","春日既熙，有繁其梅。","四言"],["归寿 其二","李梦阳","尔生之辰，尔子遄驰。","四言"],["归寿 其三","李梦阳","又何献之，崧高之松。","四言"],["河之水歌","李梦阳","河水淲淲，舟子摇橹。","四言"],["和方山子歌 其一 仆夫歌","李梦阳","饯者在郊，黄鸟交交。","四言"],["和方山子歌 其二 答歌","李梦阳","何柳不黄，何鸟不鸣。","四言"],["和方山子歌 其三 舟子歌","李梦阳","春水涣涣，水鸟鸣唤。","四言"],["和方山子歌 其四 答歌","李梦阳","食君琅玕，佩君玉环。","四言"],["豆娘子","李梦阳","汝何者物，小而轻盈，妁约悠扬。","四言"],["禽言六首 其六","李梦阳","不如归去，南山豆熟，北山有黍。","四言"],["雨雪曲","李梦阳","冬十一月，阻舟徐汊。","四言"],["阳鸟篇","李梦阳","阳鸟攸居，于渚于野。","四言"],["湖吟行","李梦阳","鱼游于水，游于水而。","四言"],["虎欲啮人不避豪贤篇","李梦阳","吾之于人，谁毁谁誉。","四言"],["独漉篇","李梦阳","独漉独漉，弃田求屋。","四言"],["苦热行","李梦阳","蕴隆焚如，二仪为炉。","四言"],["鸡鸣篇","李梦阳","鸡鸣月落，飘风振宇。","四言"],["朝吟行","李梦阳","亭毒既周，明星有烂。","四言"],["赐游东苑诗九章 其一 斋宫","杨士奇","严严斋居，清庙之侧。","四言"],["赐游东苑诗九章 其二 圆亭","杨士奇","翼翼圆亭，法象上玄。","四言"],["赐游东苑诗九章 其三 方沼","杨士奇","凿方甃池，制仪坤舆。","四言"],["赐游东苑诗九章 其四 翠渠","杨士奇","湜湜澄渠，天汉其宗。","四言"],["赐游东苑诗九章 其五 黛峰","杨士奇","苍乎凌波，如戴神鳌。","四言"],["赐游东苑诗九章 其六 灵泉","杨士奇","天一所生，而出异源。","四言"],["赐游东苑诗九章 其七 御苑","杨士奇","群植斯蕃，盎乎凝春。","四言"],["赐游东苑诗九章 其八 嘉鱼","杨士奇","喁喁洋洋，以游以泳。","四言"],["芳桂堂诗为杨御史作","杨士奇","连绻桂树，罗生堂前。","四言"],["题雪窗兰","杨士奇","粲粲幽兰，在彼岩阿。","四言"],["题勉仁学士草虫图","杨士奇","种瓜于田，既勤且劬。","四言"],["送尤安礼 其一","杨士奇","君子之马，六辔如丝。","四言"],["送尤安礼 其二","杨士奇","君子之马，六辔沃若。","四言"],["送尤安礼 其三","杨士奇","岂无他人，不如友生。","四言"],["送尤安礼 其四","杨士奇","言笑晏晏，维予与女。","四言"],["送尤安礼 其五","杨士奇","与子成说，方何为期。","四言"],["驺虞诗","杨士奇","维天至仁，涵育万类。","四言"],["圣孝瑞应诗","杨士奇","惟皇御极，八纮率俾。","四言"],["瑞星诗","杨士奇","惟天之高，荡荡难名。","四言"],["东川迎养图诗十章","杨士奇","东川之漘，栾栾柏松。","四言"],["听乌轩诗为刘宗韶作","杨士奇","民物之生，厥赋惟均。","四言"],["后山诗为江西林宪副作","杨士奇","崔崔后山，清漳之漘。","四言"],["题辉侄兰","杨士奇","幽澹其芳，介于贞石。","四言"],["题升龙","杨士奇","阳德中正，与时偕行。","四言"],["题降龙","杨士奇","云行雨施，万物咸春。","四言"],["承训堂诗","杨士奇","奕奕高堂，有父有母。","四言"],["具庆堂诗","杨士奇","郁郁乔林，发厚于本。","四言"],["永思堂诗","杨士奇","南山之木，厥有本根。","四言"],["题张子俊山水","杨士奇","高山崔崔，青川浏浏。","四言"],["题陈宪虎","杨士奇","虨虨其文，眈眈其视。","四言"],["题陈宪龙","杨士奇","云行雨施，阳德之亨。","四言"],["荣寿堂诗","杨士奇","奕奕高堂，奉父与母。","四言"],["题白云山房图","杨士奇","高山在上，清流在下。","四言"],["题泉坡学士龙","杨士奇","时而渊潜，时而云升。","四言"],["题水仙","杨士奇","汉广之滨，清洛之汭。","四言"],["题菊","杨士奇","秋霜既肃，黄花始妍。","四言"],["题谖草","杨士奇","对此谖草，粲乎有章。","四言"],["题玉簪","杨士奇","姑射之姝，翠旌如帏。","四言"],["题兰","杨士奇","懿此芳兰，在彼岩阿。","四言"],["题鹡鸰图","杨士奇","人之亲爱，至性所有。","四言"],["善哉行","袁宏道","今日相乐，式舞且歌。","四言"],["短歌燕中逢乐之律作","袁宏道","下马一言，不及暄寒。","四言"],["别石篑 其九","袁宏道","气嘘为风，云流为水。","四言"],["湘湖莼菜","袁宏道","托恨西湖，沉质湘水。","四言"],["独漉篇","何景明","独漉独漉，驱车折轴。","四言"],["刺促篇","何景明","刺促刺促，井燎不续。","四言"],["皇告","何景明","八月至贵，其日载旸。","四言"],["短歌行","何景明","冉冉秋序，肃肃霜露。","四言"],["鸣雁行","何景明","鸣雁鸣斯，其音嘹嘹。","四言"],["直路行","何景明","直路难行，直言难受。","四言"],["南山篇","何景明","朝采南山，白石盘盘。","四言"],["予尝梦昼所决不为事心恶之后读唐书李坚贞传稍解焉","徐渭","坚贞十七，之死靡他。","四言"],["雁台诗","徐渭","左江右湖，名山有台。","四言"],["土鲁番贡狮","徐渭","羌饭官驿，斯物不的。","四言"],["善哉行","杨慎","夏夜苦短，冬夜苦长。","四言"],["白云谣","李攀龙","白云在天，山陵逶迤。","四言"],["瑶池谣","李攀龙","白云在山，亦洽而野。","四言"],["短歌行","李攀龙","驷马可縻，去日难追。","四言"],["善哉行 其一","李攀龙","来日难期，少合多离。","四言"],["善哉行 其二","李攀龙","巢父洁身，天下为污。","四言"],["地驱乐歌","李攀龙","萧萧条条，风雨漂摇。","四言"],["神弦歌三首 其二 道君曲","李攀龙","中庭有树，其实诩诩。","四言"],["青溪小姑曲","李攀龙","青溪汤汤，白石为梁。","四言"],["碣石篇 其一","李攀龙","碣石中怒，沧海北倚。","四言"],["碣石篇 其二","李攀龙","凉秋九月，塞外草衰。","四言"],["碣石篇 其三","李攀龙","委蛇者河，千里一曲。","四言"],["碣石篇 其四","李攀龙","羽翼未就，鸿鹄徘徊。","四言"],["效阮公 其一","李攀龙","太清孔阳，元气𬘡缊。","四言"],["效阮公 其二","李攀龙","日照月临，天高气清。","四言"],["土偶祸","沈周","锽锽鸣锣，彭彭伐鼓。","四言"],["孝诗六章为颜季栗赋 其二 归骨操之二","沈周","惟山有狐，惟水有龙。","四言"],["孝诗六章为颜季栗赋 其三 迎养操之一","沈周","父还儿迎，越彼西疆。","四言"],["孝诗六章为颜季栗赋 其四 迎养操之二","沈周","惟溲之浊，我心惟惕。","四言"],["自题小像","沈周","七十四年，我未识我。","四言"],["之荆操","高启","粤有我土，岐山之下。","四言"],["泰风","祝允明","岁律默迁，夕飙儆物。","四言"],["读余侍御游泰山记咏其间二三处 其一 明堂","祝允明","于铄姬后，缔兹合宫。","四言"],["读余侍御游泰山记咏其间二三处 其二 绝顶玉皇殿","祝允明","干居冠峻，岳承级通。","四言"],["怀知诗 其十二 吴文定公","祝允明","穆穆文定，渊渊金玉。","四言"],["怀知诗 其十三 王文恪公","祝允明","肃肃文恪，有严我师。","四言"],["怀知诗 其十四 韩尚书贯道","祝允明","司徒岩岩，四海具瞻。","四言"],["怀知诗 其十五 沈周先生","祝允明","有华东阳，烨于吴门。","四言"],["怀知诗 其十六 本郡使君南海林公","祝允明","昌哉我牧，百夫之特。","四言"],["怀知诗 其十七 陆冢宰","祝允明","陆缔于我，好也奕世。","四言"],["怀知诗 其十八 朱孝廉","祝允明","秀矣孝廉，名驹在谷。","四言"],["怀知诗 其十九 朱文学尧民","祝允明","葑亦多彦，哿矣两朱。","四言"],["秋山琴月图","祝允明","玉照洞秋，冰厓肃夜。","四言"],["有室七章","王守仁","有室如虞，周之崇墉。","四言"],["六月五章","王守仁","六月凄风，七月暑雨。","四言"],["春暮有怀","张煌言","嗟予初衣，柔翰勃窣。","四言"],["泉穴鱼","张煌言","南有鲋鱼，实生泉穴；","四言"],["促织","张煌言","促织促织，微吟闺夕。","四言"],["蜀府敬慎斋","方孝孺","天降大命，孔神而明。","四言"],["读书斋","方孝孺","翼翼高斋，秩秩群经。","四言"],["解氏世系歌","解缙","悠悠我祖，系出平阳。","四言"],["短歌行","唐寅","尊酒前陈，欲举不能。","四言"],["送文温州","唐寅","日月徂暑，时风布和。","四言"],["苦寒行","袁凯","雨雪雨雪，凄风如刀，我行中野，而无缊袍。","四言"],["送贡先生入闽","袁凯","日月异行，川岳异途。","四言"],["徐氏建华亭学诗","袁凯","渠渠新学，徐卿始作。","四言"],["荒园","袁凯","莽莽荒园，阴阴雾霾。","四言"],["赋耕隐","袁凯","维古四民，次二曰农。","四言"],["赋许思敬真率朝","袁凯","邃古之初，民性质朴。","四言"],["自取池","戚继光","挠之亦浊，澄之亦清。","四言"],["拟大明铙歌曲十八首 其六 四友","胡应麟","于维文王，是亲四友。","四言"],["拟汉郊祀歌十九首 其二 帝临","胡应麟","帝临中央，以运四方。","四言"],["拟汉郊祀歌十九首 其三 青阳","胡应麟","青阳载临，万物敷荣。","四言"],["拟汉郊祀歌十九首 其四 朱明","胡应麟","朱明烨烨，品汇嘉悦。","四言"],["拟汉郊祀歌十九首 其五 西颢","胡应麟","西颢金方，蓐收是秉。","四言"],["拟汉郊祀歌十九首 其六 玄冥","胡应麟","玄冥水伯，载司寒冱。","四言"],["拟汉郊祀歌十九首 其七 维泰元","胡应麟","于维泰元，象帝之先。","四言"],["拟汉郊祀歌十九首 其十二 景星","胡应麟","景星见祠，神鼎载出。","四言"],["拟汉郊祀歌十九首 其十三 后皇","胡应麟","后皇降休，介我景福。","四言"],["拟汉郊祀歌十九首 其十四 斋房","胡应麟","斋房三秀，柯叶九茎。","四言"],["琴操十一首 其二 猗兰操","胡应麟","泛泛崇兰，在彼空谷。","四言"],["琴操十一首 其五 采芝操","胡应麟","煌煌紫芝，三秀五茎。","四言"],["公无渡河三首 其一","胡应麟","公无渡河，大河扬波。","四言"],["公无渡河三首 其二","胡应麟","公无渡河，一苇奈何。","四言"],["公无渡河三首 其三","胡应麟","公无渡河，谗言孔多。","四言"],["短歌行","胡应麟","日吉时良，嘉宾满堂。","四言"],["善哉行","胡应麟","来日大难，肠干体疲。","四言"],["安东平 其一","胡应麟","严冬凛烈，北风雨霜。","四言"],["安东平 其二","胡应麟","客子远游，夐夐秦越。","四言"],["安东平 其三","胡应麟","我有绨袍，以遗故人。","四言"],["安东平 其四","胡应麟","微物在机，是侬手织。","四言"],["安东平 其五","胡应麟","东平刘生，远持遗郎。","四言"],["白石郎","胡应麟","侬居清溪，郎居白石。","四言"],["短歌行","欧大任","乐乐自生，人穷反本。","四言"],["独漉篇","欧大任","独漉独漉，摩肩击毂。","四言"],["辟廱","程敏政","有严辟廱，四方之则。","四言"],["双瑞","程敏政","义兴之郊，有山隆隆。","四言"],["思亲堂","程敏政","有堂渠渠，有客佖佖。","四言"],["寿鞠","程敏政","有寿者鞠，其色孔黄。","四言"],["言志赠友人","刘崧","深山邃谷，虎豹所凭。","四言"],["题唐子华江居平远图","刘崧","宛其长洲，在彼中流。","