[["霜天晓角","佚名","浮生碌碌。","词"],["霜天晓角","佚名","世事促促。","词"],["醉太平","佚名","钗分凤凰。","词"],["醉太平 无题","佚名","利名场事冗。","词"],["朝天子 庐山","佚名","早霞。","词"],["驻马听 无题","佚名","月小潮平。","词"],["寒夜谣 其一","刘基","良夜悠悠，星河满天。","四言"],["寒夜谣 其二","刘基","今夕何夕，岁聿其徂。","四言"],["春夜一首","刘基","春夜迢迢，微风不兴。","四言"],["青阳一首","刘基","青阳俶载，白日孔昭。","四言"],["有泉在山一首","刘基","有泉在山，爰注为壑。","四言"],["芳树","刘基","蔚彼芳树，生于兰池。","四言"],["上陵","刘基","零雨霏霏，亦降于桑。","四言"],["将进酒","刘基","有酒湛湛，亦盈于觞。","四言"],["气出唱","刘基","今日不乐，振策远游。","四言"],["秋怀 其一","刘基","凉夜悠悠，华灯有辉。","四言"],["秋怀 其二","刘基","陟彼高原，望美中陵。","四言"],["秋怀 其三","刘基","喓喓草虫，剽剽其股。","四言"],["秋怀 其四","刘基","中庭有枣，累累其实。","四言"],["秋怀 其五","刘基","有爝者萤，载飞载扬。","四言"],["秋怀 其六","刘基","夕簟既清，瓶水既寒。","四言"],["秋怀 其七","刘基","郁彼晨烟，亦曼于楚。","四言"],["秋怀 其八","刘基","今日何日，岁聿其秋。","四言"],["有鸟一首赠袁尚志","刘基","有鸟有鸟，薄言激之。","四言"],["擢彼乔松一首","刘基","擢彼乔松，在彼丘阿。","四言"],["步出夏门行","刘基","步出夏门，遥望沧海。","四言"],["东园之柳一首","刘基","东园之柳，萋其黄矣。","四言"],["维泽有蒲一首","刘基","维泽有蒲，其叶濡濡。","四言"],["送季德大之文登税务官任二首 其一","刘基","有客有客，驾言远行。","四言"],["黄华一首送叶师仁省兄还栝苍","刘基","睆彼黄花，有烨其辉。","四言"],["春日一首送吴浩叔大之饶州府通判任","刘基","春日载阳，鸟鸣于乘。","四言"],["条风一首","刘基","正月载阳，二月条风。","四言"],["题兰雀图","刘基","有雀有雀，亦集于棘。","四言"],["山有乔木一首赠王子章","刘基","山有乔木，有条有柯。","四言"],["送薛推官诗","杨维桢","有渊有清，又静且平。","四言"],["钟藤辞","杨维桢","南有美木，钟藤束只。","四言"],["寿岂诗","杨维桢","有桥有谖，云有桥洋。","四言"],["万松老人真赞","耶律楚材","每恨恒山，不逢圭老。","四言"],["示从智","耶律楚材","知人者明，自知者智。","四言"],["味经堂诗","虞集","维昔玄圣，有子过庭。","四言"],["题宋诚甫侍郎垂纶亭","虞集","岷源建高，驶无游舠。","四言"],["竹林七贤图","虞集","瞻彼修竹，下临清流。","四言"],["万户张公庙堂诗","虞集","于赫世皇，并用豪杰。","四言"],["题胡征君器之和陶轩","虞集","春木晨荣，秋华夕滋。","四言"],["素衣诗素衣内自省也督输官租羁絷忧愤思弃田庐敛裳宵遁焉","倪瓒","素衣涅兮，在彼公庭。","四言"],["题鼯鼠食瓜图","揭傒斯","种瓜中园，予亦勤止。","四言"],["孔林图诗","揭傒斯","峨峨尼山，蔽于鲁邦。","四言"],["琴操二首 其二","宋濂","有洞者林，其色阴阴。","四言"],["琴操二首 其二 伤妷女","宋濂","有妷者女，颜如舜英。","四言"],["含山操二解","宋濂","含山有云，莫蔽我衣。","四言"],["王国祀仁祖庙乐八章 其一 迎神奏淳和之曲","宋濂","皇图聿崇，茅社受封。","四言"],["王国祀仁祖庙乐八章 其二 奉牲奏庆和之曲","宋濂","王国之东，清庙翼翼。","四言"],["王国祀仁祖庙乐八章 其三 初献奏保和之曲","宋濂","皇祖载德，既淳且仁。","四言"],["王国祀仁祖庙乐八章 其四 亚献奏清和之曲","宋濂","穆穆灵宫，庭燎有炜。","四言"],["王国祀仁祖庙乐八章 其五 终献奏成和之曲","宋濂","神兮下临，陟降在庭。","四言"],["王国祀仁祖庙乐八章 其六 饮福奏咸和之曲","宋濂","神具醉止，威仪孔肃。","四言"],["王国祀仁祖庙乐八章 其七 彻豆奏嘉禾之曲","宋濂","礼备乐举，祀事攸宜。","四言"],["王国祀仁祖庙乐八章 其八 送神奏德和之曲","宋濂","杳兮忽兮，神运无迹。","四言"],["宋铙歌鼓吹曲十二首 其九 王师伐江南江南主李煜䧏时彗出柳历舆儿为彗出柳第九","宋濂","维彗出柳，六合布新。","四言"],["风树亭诗","宋濂","山有嘉树，油然发荣。","四言"],["灵槐诗","宋濂","难谌惟帝，厥命孔赫。","四言"],["赠阎希曾参政山东诗","宋濂","山东钜藩，统府惟六。","四言"],["有田","张养浩","有田负郭，伊迩匪辽。","四言"],["题钟馗","张昱","梦以自见，正以辟邪。","四言"],["萧权府三害图","李俊民","长桥之蛟，南山之虎。","四言"],["止姚亚之刲羊","李俊民","养生之鞭，陇种之苗。","四言"],["焦天禄野叟听音图","李俊民","梨园弟子，天宝之后。","四言"],["唐叔王韦生卧虎图","李俊民","梁鸯之养，或失其时。","四言"],["学中史正之会客","李俊民","有怀伊人，在泮饮酒。","四言"],["烟江绝岛图","李俊民","江风不波，峭壁森立。","四言"],["双松古渡图","李俊民","倾盖相逢，堂堂两公。","四言"],["古柏寒泉图","李俊民","冬夏长青，昼夜不舍。","四言"],["纸扇","李俊民","竹疏而骨，楮剥而肤。","四言"],["棕扇","李俊民","直节贯中，怒发冲上。","四言"],["扇面画竹","凌云翰","故人清风，美人明月。","四言"],["郭景谅画","凌云翰","月来中天，琴声以和。","四言"],["旭斋诗","凌云翰","九日为旭，羿不能射。","四言"],["时雨","赵秉文","天降时雨，山川出云。","四言"],["皇武","赵秉文","皇奋厥武，如雷如霆。","四言"],["旌表孝义金门","郑元祐","出吴东门，沄沄其水。","四言"],["高昌契侯三节堂","郑元祐","惟天启契，产自辇水。","四言"],["可斋","郑元祐","大哉宣圣，以诗教我。","四言"],["登鸿山吊梁伯鸾","郑元祐","我以饥驱，爰求乐土。","四言"],["兰","郑元祐","恊以鼓琴，世谁知音？","四言"],["为李绎成悼其妻冯氏","郑元祐","彼美者媛，令姿静淑。","四言"],["春晖楼","郑元祐","阳春有晖，泛在物表。","四言"],["春晖，美华孝子也","郑元祐","阳春有晖，物其是依。","四言"],["明良诗 其一","吴当","于赫皇祖，肇基朔土。","四言"],["明良诗 其二","吴当","天戈攸指，罔不率俾。","四言"],["明良诗 其三","吴当","逮乎忠宣，相我世皇。","四言"],["明良诗 其四","吴当","猗与文忠，礼乐是式。","四言"],["明良诗 其五","吴当","硕硕元勋，后先四王。","四言"],["明良诗 其六","吴当","侃侃开府，尚德象贤。","四言"],["明良诗 其七","吴当","惟皇之念，翰墨是锡。","四言"],["明良诗 其八","吴当","云汉于昭，发耀天藻。","四言"],["明良诗 其九","吴当","翼翼厥明，终始典学。","四言"],["明良诗 其十","吴当","以道事君，汝翼汝为。","四言"],["明良诗 其十一","吴当","明良之逢，有典有则。","四言"],["恒德斋为开府明良公作 其一","吴当","于穆天命，恒久不已。","四言"],["恒德斋为开府明良公作 其二","吴当","惟圣有德，率性之常。","四言"],["恒德斋为开府明良公作 其三","吴当","君子是则，勉勉不息。","四言"],["恒德斋为开府明良公作 其四","吴当","赫赫元勋，昔佐皇祖。","四言"],["恒德斋为开府明良公作 其五","吴当","侃侃闻孙，靖共在位。","四言"],["恒德斋为开府明良公作 其六","吴当","佩舄雍雍，退食自公。","四言"],["恒德斋为开府明良公作 其七","吴当","协于克一，责难将美。","四言"],["恒德斋为开府明良公作 其八","吴当","惟巽而动，勿承以羞。","四言"],["极高明亭诗为曾以敬作 其一","吴当","春木载荣，朝阳孔曦。","四言"],["极高明亭诗为曾以敬作 其二","吴当","爰有新亭，翼翼中峙。","四言"],["极高明亭诗为曾以敬作 其三","吴当","其止维何，朝弦莫歌。","四言"],["极高明亭诗为曾以敬作 其四","吴当","斯道之著，皎焉日星。","四言"],["极高明亭诗为曾以敬作 其五","吴当","弥纶六合，迥绝寥廓。","四言"],["极高明亭诗为曾以敬作 其六","吴当","如俯层台，洞视靡遗。","四言"],["极高明亭诗为曾以敬作 其七","吴当","知崇效天，礼卑法地。","四言"],["极高明亭诗为曾以敬作 其八","吴当","万物毕备，一贯斯全。","四言"],["极高明亭诗为曾以敬作 其九","吴当","予忝承学，子实名裔。","四言"],["极高明亭诗为曾以敬作 其十","吴当","惟博反约，实基三省。","四言"],["庆原堂诗为萍乡刘氏作 其一","吴当","惟楚萍乡，邑里有堂。","四言"],["庆原堂诗为萍乡刘氏作 其二","吴当","雄虎之台，郁郁丘土。","四言"],["庆原堂诗为萍乡刘氏作 其三","吴当","子孙多贤，冠佩蝉联。","四言"],["庆原堂诗为萍乡刘氏作 其四","吴当","福庆之实，既坚既栗。","四言"],["庆原堂诗为萍乡刘氏作 其五","吴当","历宋而元，流庆未已。","四言"],["庆原堂诗为萍乡刘氏作 其六","吴当","山冢之迁，有霆有雷。","四言"],["庆原堂诗为萍乡刘氏作 其七","吴当","奕奕君子，实居后麓。","四言"],["庆原堂诗为萍乡刘氏作 其八","吴当","绳绳厥承，忠厚之教。","四言"],["庆原堂诗为萍乡刘氏作 其九","吴当","太史有记，邦人足征。","四言"],["咸阳王功德诗 其一","吴当","在昔皇祖，有赫神武。","四言"],["咸阳王功德诗 其二","吴当","佐命而兴，来受圭组。","四言"],["咸阳王功德诗 其三","吴当","于穆世皇，天戈载扬。","四言"],["咸阳王功德诗 其四","吴当","滇之宗臣，乃悖纪纲。","四言"],["咸阳王功德诗 其五","吴当","天子曰嘻，孰称予使。","四言"],["咸阳王功德诗 其六","吴当","谕之恩信，涤汝烦苦。","四言"],["咸阳王功德诗 其七","吴当","乃疆乃理，奠尔城邑。","四言"],["咸阳王功德诗 其八","吴当","我田我池，粳稌黍稷。","四言"],["咸阳王功德诗 其九","吴当","既庶既富，建学立教。","四言"],["咸阳王功德诗 其十","吴当","诗书歌弦，孰则孰效。","四言"],["咸阳王功德诗 其十一","吴当","步不出国，侯幽侯深。","四言"],["咸阳王功德诗 其十二","吴当","久而弥孚，向义骎骎。","四言"],["咸阳王功德诗 其十三","吴当","天祚皇国，克生伟人。","四言"],["咸阳王功德诗 其十四","吴当","远民之安，克顺克正。","四言"],["咸阳王功德诗 其十五","吴当","元臣云亡，远民孔哀。","四言"],["咸阳王功德诗 其十六","吴当","新庙既作，执事有恪。","四言"],["咸阳王功德诗 其十七","吴当","锡爵启封，皇则悼之。","四言"],["咸阳王功德诗 其十八","吴当","诜诜孙子，有引无替。","四言"],["性乐堂诗 其一","吴当","繄厥成性，浩然其天。","四言"],["性乐堂诗 其二","吴当","惟尔学者，夙夜有恪。","四言"],["性乐堂诗 其三","吴当","翼翼高堂，攸介攸宁。","四言"],["集义斋诗为太行高氏作 其一","吴当","瞻彼嘉木，太行之阴。","四言"],["集义斋诗为太行高氏作 其二","吴当","缅焉兴怀，古道是式。","四言"],["集义斋诗为太行高氏作 其三","吴当","我其扩之，制事不违。","四言"],["集义斋诗为太行高氏作 其四","吴当","灼知勇为，乃积乃充。","四言"],["集义斋诗为太行高氏作 其五","吴当","浩然之生，实匪助长。","四言"],["集义斋诗为太行高氏作 其六","吴当","肃尔斋居，永端于初。","四言"],["致亭诗 其一","吴当","瞻彼绎山，绵绵其麓。","四言"],["致亭诗 其二","吴当","先民有觉，昧兹寡闻。","四言"],["致亭诗 其三","吴当","顾瞻周行，玄邈奚绪。","四言"],["致亭诗 其四","吴当","潏彼川流，昼夜斯逝。","四言"],["致亭诗 其五","吴当","既种既耨，廪积孔殷。","四言"],["修省斋诗 其一","吴当","惟皇降衷，弗忚弗亏。","四言"],["修省斋诗 其二","吴当","有卓君子，励行自修。","四言"],["修省斋诗 其三","吴当","孰去孰存，惟日内省。","四言"],["修省斋诗 其四","吴当","修省之始，尤慎在独。","四言"],["修省斋诗 其五","吴当","于赫斯临，昭昭幽深。","四言"],["修省斋诗 其六","吴当","矧兹明威，曷敢戏豫。","四言"],["修省斋诗 其七","吴当","燕居观象，恒若荐雷。","四言"],["修省斋诗 其八","吴当","审之靡疚，式底于完。","四言"],["修省斋诗 其九","吴当","吾侪小人，贪欲内锢。","四言"],["修省斋诗 其十","吴当","为之由己，曷自暴弃。","四言"],["寿宁堂诗为冀宁耿氏作 其一","吴当","于昭秉彝，有本有支。","四言"],["寿宁堂诗为冀宁耿氏作 其二","吴当","衎衎令子，报德慈母。","四言"],["寿宁堂诗为冀宁耿氏作 其三","吴当","鱼轩戾止，兄弟具在。","四言"],["寿宁堂诗为冀宁耿氏作 其四","吴当","旨甘孔时，春酒载筵。","四言"],["寿宁堂诗为冀宁耿氏作 其五","吴当","哺乌在林，遗我好音。","四言"],["寿宁堂诗为冀宁耿氏作 其六","吴当","琴瑟静好，以雅以南。","四言"],["寿宁堂诗为冀宁耿氏作 其七","吴当","既曰寿只，实在宁只。","四言"],["寿宁堂诗为冀宁耿氏作 其八","吴当","敦孝移忠，永锡不匮。","四言"],["永思堂诗为董仲资作","陶宗仪","子之于亲，思无不至。","四言"],["归来","李孝光","有悸孺子，衣之狐裘。","四言"],["题吴景良荷锸图","黄玠","倚冰为山，击石作火。","四言"],["狐虎图","黄玠","狐假虎威，虎为狐使。","四言"],["刘子舆清啸轩","黄玠","大哉扶舆，动应有机，律吕风云。","四言"],["一姓三氏诗","黄玠","彼种树者，更枝易叶。","四言"],["画鲤","黄玠","以为鱼耶，鳞甲已具。","四言"],["春晚书怀四声体","黄玠","春晚翠阁，朱户绣箔。","四言"],["行素轩","丁鹤年","素履所践，王道平平。","四言"],["复渊","丁鹤年","沈沈止水，如大圆镜。","四言"],["竹隐图","丁鹤年","昔有君子，隐居种竹。","四言"],["菊泉轩","丁鹤年","英英径菊，混混原泉。","四言"],["养素斋","丁鹤年","养浩配义，行素顺天。","四言"],["义乌括田诗","王祎","维县义乌，有腴其田。","四言"],["婺州新城诗","王祎","额额婺城，十里其周。","四言"],["青潭山神祠乐歌三首 其二 享神灵临","王祎","灵既临矣，膋萧载馨。","四言"],["有鸟","丁复","有鸟有鸟，鸣声嘐嘐。","四言"],["众羽送刘士干知事赴湖广省掾","丁复","众羽之差，差彼翰而。","四言"],["维山送章子端调浙东奏差","丁复","维山其砠，维水沮洳。","四言"],["原存为叶博士作","丁复","道一而二，阖辟周还。","四言"],["题墨兰","丁复","凤凰可罗，麒麟可羁。","四言"],["湘山寺无量寿佛","陈孚","大地山河，无非佛者。","四言"],["题水月洞","陈孚","铁崖万仞，鬼斧所凿。","四言"],["瞻屺堂","陈谟","缅彼崔嵬，坤土而隆。","四言"],["咨询堂诗","陈谟","奕奕岩岩，风纪之堂。","四言"],["朝阳诗","陈谟","瀛海之东，桃都之山。","四言"],["蓄川 其一","杨弘道","蓄川膴膴，闲田可耕。","四言"],["蓄川 其二","杨弘道","蓄川膴膴，闲田可艺。","四言"],["蓄川 其三","杨弘道","皇天后土，日月照临。","四言"],["蓄川 其四","杨弘道","奸回自终，可按可考。","四言"],["竹素斋","谢应芳","天人交敷，牺画马图。","四言"],["宜山谣 其三 枯桑","谢应芳","枯桑枯桑，徒为我薪。","四言"],["短歌行","梁寅","今日燕胥，乐如之何。","四言"],["飞龙篇","梁寅","西登崆峒，如观五城。","四言"],["独漉篇","郭翼","求禄求禄，清白不浊。","四言"],["饱食箴示同志二三子","段克己","饱食终日，无所用心。","四言"],["赠薛宝臣疏梅冻雀图并以颂之","段克己","玄冥司候，百卉俱衰。","四言"],["陈丈良臣诞弥令日谨拜手而献颂曰","段克己","矫矫夫君，由义居仁。","四言"],["雪竹","吴镇","董宣之烈，严颜之节。","四言"],["茅屋读书图","刘永之","峨峨苍山，白云冒之。","四言"],["汉水赠别也","陈高","瞻彼汉水，其流潺湲。","四言"],["题窗前松竹因自号松竹主人","胡天游","王官鳞鳞，多士振振。","四言"],["重庆堂诗 其一","危素","翼翼高堂，临水之阳。","四言"],["重庆堂诗 其二","危素","高堂翼翼，既深且谧。","四言"],["重庆堂诗 其三","危素","玄冠于于，厥子来趋。","四言"],["重庆堂诗 其四","危素","旨酒在匜，登豆有菹。","四言"],["重庆堂诗 其五","危素","子于父母，亦既能孝。","四言"],["重庆堂诗 其六","危素","其孝伊何，古有嘉则。","四言"],["山中歌","危素","朝牧于林，暮钓于溪，吾何忧而。","四言"],["春草堂诗集诗句 其一","陆仁","春日迟迟，昭明有融。","四言"],["白鸟二章章八句","许谦","嗷嗷哀鸣，迁于壤木。","四言"],["郁松赠陶思齐任通波驿长","许谦","郁郁乔松，在彼中林。","四言"],["灵泉翀举自有诗十八章留人间今止存五遂续之 其一","滕斌","石冷龙蟠，风高鹤瘦。","四言"],["灵泉翀举自有诗十八章留人间今止存五遂续之 其二","滕斌","月佩霞裾，雾襦云幄。","四言"],["灵泉翀举自有诗十八章留人间今止存五遂续之 其三","滕斌","本无尘埃，何事乎浴。","四言"],["灵泉翀举自有诗十八章留人间今止存五遂续之 其四","滕斌","谁言桃实，可以疗饥。","四言"],["灵泉翀举自有诗十八章留人间今止存五遂续之 其五","滕斌","万山雪瀑，一叶莲舟。","四言"],["灵泉翀举自有诗十八章留人间今止存五遂续之 其六","滕斌","如剑斯泉，如瓮斯石。","四言"],["灵泉翀举自有诗十八章留人间今止存五遂续之 其七","滕斌","瑶草低云，苍松洒雪。","四言"],["灵泉翀举自有诗十八章留人间今止存五遂续之 其八","滕斌","天低绛阙，月满瑶台。","四言"],["新溪书堂诗","胡炳文","宇胡曰宙，古往来今。","四言"],["赠鹤庵相士四言","胡炳文","我相尔鹤，风骨卓荦。","四言"],["李道人嵩阳归隐图","麻九畴","城郭维崇，井里维通。","四言"],["鹤寿堂诗","苏天爵","奕奕新堂，滹水之阳。","四言"],["千夫长梁侯寿诗","苏天爵","皇有中夏，戡定南土。","四言"],["送叶伯奇入官","赵偕","朔风列列，海天茫茫。","四言"],["杂诗五首 其四","李经","岩椒郁云，日夕生阴。","四言"],["述祖诗","赵由侪","悠悠我祖，始于轩丘。","四言"],["新州行旅为仓振高芝歌","刘应雄","仓榕高松，手泽重重。","四言"],["古像赞二百零五首 其一七四 米南宫","元章","辞章绝俗，翰墨入神。","四言"],["涅槃前偈","释月林","昔不曾生，今何曾灭。","四言"],["谢郡守王宁轩","莫肃震","泮水溶溶，新庙有颙。","四言"],["嘲洪起畏","佚名","家在临安，职守京口。","四言"],["武冈民颂","佚名","前有公绰，武冈父母；","四言"],["曲沃民歌","佚名","泮宫之崇，以扶儒宗。","四言"]]