[["送蔡守","徐积","维淮之南，楚为剧州。","四言"],["皇帝上太上皇帝寿乐曲 太上皇帝初举酒用蟠桃之曲","崔敦诗","结根阆苑，登实瑶池。","四言"],["庆元二年皇后册宝十三首 其二","郊庙朝会歌辞","熛阙蟺蜎，璧门云龙。","四言"],["诚台春色","薛季宣","凤阙西冈，郎亭东乳。","四言"],["宝祐二年皇子冠二十首 其十七","郊庙朝会歌辞","皇王烝哉，令闻不已。","四言"],["姑苏蒋公北池诗","张方平","浙江汤汤，南国之纪。","四言"],["太庙乐章 其二 皇帝还位干安之曲","周麟之","于穆清庙，明禋是躬。","四言"],["龙眠居士画十六大阿罗汉赞 其七","李纲","宝珠腾空，光焰璀璨。","四言"],["淳熙二年发太上皇帝太上皇后册宝十一首 其八 太傅奉太上皇后册宝升殿用《圣安》。","郊庙朝会歌辞","干健坤从，阳刚阴相。","四言"],["宋颂九首 其三 皇祖","石介","皇祖曰嘻，物情难筹。","四言"],["颂古一百二十一首 其四十八","释宗杲","瑞岩宸风，唤主人公。","四言"],["四偈 报冤行","惠洪","僧婴王难，情观可丑。","四言"],["偈颂八十五首 其七十一","释妙伦","五峰影里，双涧声中。","四言"],["题真仁夫画卷","刘克庄","草木黄落，水云莽苍。","四言"],["上邓宪生辰  其六","杨简","迺眷西顾，金节畀之。","四言"],["麦秀歌","薛季宣","麦秀渐渐，殷商宫兮。","四言"],["宋颂九首 其二 汤汤","石介","彼以险守，我以德怀。","四言"],["宋颂九首 其二 金陵","石介","帝赫斯怒，王师徐驱。","四言"],["崧高诗为九江赵使君寿  其一","杨冠卿","崧高维岳，四方之极。","四言"],["宋颂九首 其三 汤汤","石介","昔时蜀道，绝人来往。","四言"],["送程守","徐积","蜀之有眉，有山有江。","四言"],["淳祐祭海神十六首 南海位奠玉币用《瀛安》。","郊庙朝会歌辞","祝融之位，贵乎三神。","四言"],["咏茅山元符万宁宫","蔡卞","猗嗟三茅，得自初成。","四言"],["鶑鸣十章寄戚伯瑞  其一","彭龟年","有鸣其禽，其鸣维何。","四言"],["浮山圆鉴和尚赞","释清远","并汾铁骑，老息荒丘。","四言"],["南陔五章二章章八句三章章四句  其一","郑刚中","陟彼南陔，有风惟薰。","四言"],["上许州吕相公嗣崧许康诗二首 许康诗 其三","宋祁","公视于庭，师兵翼翼，孔武有力。","四言"],["上许州吕相公嗣崧许康诗二首 许康诗 其四","宋祁","左拂其殽，炰鼈燔羔，给鲜于庖。","四言"],["宋颂九首 其一 汤汤","石介","汤汤其江，区区尔孟。","四言"],["南陔五章二章章八句三章章四句  其五","郑刚中","敬尔身矣，怿其亲矣。","四言"],["东坡像李伯时作曾无疑藏之命予赞之","周必大","龙章凤姿，挥斥八极。","四言"],["赞三十六祖颂 其二十九","释印肃","直截猛利，立雪断臂。","四言"],["寒山拾得赞","释智愚","五峰石上，双涧松边。","四言"],["喜晴","赵鼎臣","我田既臧，零雨其蒙。","四言"],["补乐府十篇 其二 帝神农氏之乐歌","曹勋","丰年告成，百谷用登。","四言"],["皇帝上太上皇帝寿乐曲 酒一行罢用万寿无疆之舞","崔敦诗","三纪御图，道丰德盛。","四言"],["颂古十一首 其二","释普济","肩担口叫，晓夜撑船。","四言"],["偈颂一百六十首 其十五","释宗杲","二月仲春，久雨不晴。","四言"],["赞梅溪王先生像","陈宓","先生之道，得天之全。","四言"],["淳熙十二年加上太上皇帝太上皇后尊号十一首 其七 太傅、中书令、侍中奉太上皇帝册宝升殿用《圣安》。","郊庙朝会歌辞","天锡伊嘏，地效其珍。","四言"],["张横渠赞","陈长方","祖龙吐毒，烈火四焚。","四言"],["郊祀乐章 皇帝入小次宫架奏黄钟宫仪安之曲","崔敦诗","匏尊既举，苏席未移。","四言"],["偈颂六十首 其三十六","释昙华","一呼善来，须发自落。","四言"],["崧高诗为九江赵使君寿  其五","杨冠卿","之纲之纪，允文允武。","四言"],["有宋死孝毛子仁哀辞","杨万里","灏穹眷宋，方郅隆些。","四言"],["崧高诗为九江赵使君寿  其二","杨冠卿","绵绵瓜瓞，莫莫葛藟。","四言"],["番阳喜晴赠幕僚","袁甫","大江以东，岁屡弗康。","四言"],["题真净肖像","张商英","云庵纲宗，能用能照。","