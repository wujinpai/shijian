[null,["绝句和杜","庞尚鹏","远树笼朝雾，轻鸿踏雪泥。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,["五杂俎","温纯","五杂俎，酝盈瓿。","杂言"],null,null,null,null,null,["留别再赋四首","宋登春","长揖辞所知，去去濮水上。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,["竹枝词 五首","王洪","妾貌如花朝暮新，郎心似水荡青春。","杂言"],["拟读曲歌七首","罗万杰","妾似菡萏花，随波上下生。","杂言"],null,null,null,null,null,null,null,null,null,null,["杂谣四首","徐祯卿","夫为虏，妻为囚。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["哀桂孙十绝","黄锦","人生苦不慧，慧反惜无成。","杂言"],null,null,null,null,null,null,null,null,null,null,null,["五仙 赵蕤","王绅","高人抱冲志，不与凡士同。","杂言"],null,["杂题画 钱舜举折枝","释妙声","目极江南有所思，馀□风雨落花时。","杂言"],null,null,["读史述 侯生","魏学洢","翩翩信陵君，夷门拔奇士。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["五杂组","刘炳","五杂组，架上衣。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["题钟馗四首","罗玘","前有枕，前有枕，乃是石，可寝巾簪。","杂言"],null,null,null,null,null,["题青山白云","虞堪","幽人卧春晓，四山云气迷。","杂言"],null,null,null,null,null,null,null,null,["杨柳枝 闺怨","高濂","风里花飞水上流。","杂言"],null,null,null,null,null,null,null,null,null,null,["八景 查岭朝烟","梁兰","冥冥天欲曙，一抹横轻素。","杂言"],["湘江绝句五首","王跂","崖石列?砑，江涨所漱出。","杂言"],null,null,null,null,["圣人出","梁元柱","圣人出，黄河清。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["山居四景 其一","惟则","林轩飞翠隔黄尘，瑶草吹香别是春。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["夜坐国学玉兔泉联句","张孟兼","成均地何灵，圣泽资灌沃。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["皂罗袍 四时词","呼文如","早是垒灯儿时节。","杂言"],null,null,null,null,null,["咸阳怀古","梁潜","咸阳古帝宅，雉堞何崔嵬。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["田水歌二首","黄渊","田水活活，上田落下田，人家兄弟不相怜。","杂言"],null,null,null