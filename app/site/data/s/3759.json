[null,null,null,null,null,null,null,null,null,null,null,null,null,["画扇二首","董纪","世态有古今，江山本无异。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["转应曲 春雨","尤侗","春雨，春雨。","杂言"],null,["怨东风 客思","尤侗","蒲叶端阳寓。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["五惜 惜岁月","韩上桂","一惜曰：混沌既判，伦类斯繁。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,["题山水","方孝孺","欲向匡庐隐，出门知路难。","杂言"],null,null,null,null,null,null,null,null,["按察使张公宗政以客中写怀八绝见寄，聊和以荅","曹义","旧好惟取最，新诗?我思。","杂言"],null,["送时阴阳大正归仪真","曹义","慇勤千里寄香芹，珍重斯文气味新。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["题红梅三首","童冀","玉骨换丹砂，夜雪迷春色。","杂言"],null,null,["十宫词 吴宫","高启","芙蓉水殿屟廊东，白苎秋来不耐风。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,["金兰操二首","祝允明","金兰之猗猗兮。","杂言"],null,null,["八咏 禁省","祝允明","彤华耀芝盖，初旭浮绛缬。","杂言"],null,null,null,["五杂组","赵完璧","五杂组，宫姝色。","杂言"],null,null,null,null,null,["五杂组","童轩","五杂组，蜀锦裳。","杂言"],null,null,["鹦鹉曲 偶记北乐府咏渔父鹦鹉曲又名黑漆努晁无咎赓和甚多惜未及樵耕牧因次韵足成四首 次韵咏樵耕牧","黄淮","侬家少室山中住。","杂言"],["喜春来 七夕二首","黄淮","凉飙轻约银河浪，灵鹊新成织女桥。","杂言"],null,null,null,null,["杂体诗 班婕妤","薛蕙","团扇团如月，月色比光妍。","杂言"],null,null,null,null,null,null,null,null,null,["张用宜丹房十咏 著方","徐庸","察脉随著方，品剂重新定。","杂言"],["五亩园十八题为姚举人作","徐庸","芳园带草堂，深广逾千步。","杂言"],null,null,null,null,null,null,null,null,["五杂组二首","徐庸","五杂组，织锦图。","杂言"],null,null,null,null,null,null,["五杂俎三首","沈炼","五杂俎，天上云。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["行路难","丘浚","蜀道难，难于上青天。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["五杂组","黎景义","五杂组，星霞锓。","杂言"]]