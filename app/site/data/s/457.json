诗为太行高氏作","吴当","瞻彼嘉木，太行之阴。","四言"],null,["修省斋诗","吴当","惟皇降衷，弗忚弗亏。","四言"],["寿宁堂诗为冀宁耿氏作","吴当","于昭秉彝，有本有支。","四言"],null,["蓄川","杨弘道","蓄川膴膴，闲田可耕。","四言"],["重庆堂诗","危素","翼翼高堂，临水之阳。","四言"],["鸣雁二章 其一","张玉娘","鸣雁征征，白露既零。","四言"],["灵泉翀举自有诗十八章留人间今止存五遂续之","滕斌","石冷龙蟠，风高鹤瘦。","四言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["句 其二","赵佶","相公公相子。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["五杂俎","刘基","五杂俎，原上翮。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["五杂组","宋褧","五杂组，䗖𬟽掣。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["祀蚕姑火龙词四章","杨维桢","火之龙兮，云弗从，雨弗降。","杂言"],null,null,null,null,null,null,null,null,null,null,null,["春闺怨","袁桷","妾家住在湘江曲，门枕湘江春水绿。","杂言"],null,null,null,null,null,null,null,null,null,null,null,["五杂组","徐贲","五杂组，机上丝。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["六幺令","晏几道","绿阴春尽，飞絮绕香阁。","杂言"],null,null,null,null,null,null,["杂诗五首","吕诚","三月南江渡，行春属晚晴。","杂言"],null,null,null,null,null,null,["辽人射猎图","李孝光","美人貂帽玉骢马，谁其从之臂鹰者。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["宣布同知自燕京来报国哀时文皇晏驾","卢琦","雨倾盆，风掷瓦，白髯使者能骑马。","杂言"],["儒有萨氏子者家无田囊无储始以进士入官为京口录事长行南台辟为掾继而御史台奏为燕廉访架阁官岁馀迁知闽海廉访事又岁馀诏进河北廉访经历皆奉其母以行其禄养也后至元三年八月望舟泊延平津上是夕星河粲然天无翳云月色如白日溪潺潺如乐奏四山环抱如拱如立如侍左右如奔走执事者萨子奉母船上与其妇具酒殽盘馔奉觞继而若妹妹之婿若仆若婢次而进和而不亵谨而怡怡月光荡酒而溪韵杂语笑母叹息舟人醉歌亦相与鼓枻作南歌为乐今夕何夕不知其异乡","卢琦","龙津秋水涵太虚，今夕何夕光景殊。","杂言"],null,["东汉高士咏十四首 刘翊","张雨","子相足周旋，破此家产丰。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["宝林丈室所藏子昂饮马图","丁复","奚官小臣职奚为，马饥则秣渴饮之。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["天净沙 梅梢月","张弘范","黄昏低映梅枝，照人两处相思，那是愁肠断时，弯弯何似，","杂言"],null,["咏十器 虾须杖","曹文晦","曾读安南奉使书，海翁往往策虾须。","杂言"],null,null,null,null,null,null,null,null,null,["拟古 行行重行行","钱宰","出门万里别，行行远防边。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["宜山谣 椎髻舞","谢应芳","椎髻舞，击铜鼓，浅蛮生蛮皆安堵。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["和禽言二首 婆饼焦","胡天游","婆饼焦，新妇腰镰孙荷樵。","杂言"],null,["忆馀杭 嘉禾八景 空翠风烟","吴镇","万寿山前，屹立一亭名槜李，堂阴数亩竹涓涓。","杂言"],null,null,null,null,null,null,["寄眠云处士","宋无","闻说华阳洞，人间第八天。","杂言"],["宫词 其一","宋无","月照芙蓉水殿秋，仙韶一曲奏《凉州》。","杂言"],["五杂组","宋无","五杂组，角黍丝。","杂言"],null,null,null,null,null,null,null,["鹦鹉曲 处士虚名","冯子振","高人谁恋朝中住。","杂言"],["鹦鹉曲 市朝归兴","冯子振","山林朝市都曾住。","杂言"],["鹦鹉曲 庞隐图","冯子振","团栾话里禅龛住。","杂言"],["鹦鹉曲 都门感旧","冯子振","都门花月蹉跎住。","杂言"],null,null,null,null,null,null,["【双调】大德歌 其一","关汉卿","粉墙低，景凄凄，正是那西厢月上时。","杂言"],["【双调】大德歌 春","关汉卿","子规啼，不如归，道是春归人未归。","杂言"],["【南吕】四块玉 闲适","关汉卿","适意行，安心坐。","杂言"],null,null,null,null,null,null,null,["山之高三章","张玉娘","山之高，月出小。","杂言"],["拜新月二章","张玉娘","拜新月，拜月愿月圆。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["神光灿","谭处端","茫茫苦海，逐浪飘沦，痴如蜂蜜蛾灯。","杂言"],null,null,null,null,null,null,["金字经","张可久","百年浑似醉，满怀都是春，高卧东山一片云。","杂言"],["一半儿","张可久","花边娇月静妆楼，叶底沧波冷翠沟，池上好风闲御舟。","杂言"],null,null,["刮鼓社","王哲","刮鼓社，这刮鼓食中拍。","杂言"],null,null,null,null,["蒲中八咏为师岩卿赋 蒲津晚渡","陈赓","云涛注壶口，水府蟠九垒。","杂言"],null,["雪后","李纯甫","玉环晕月蟠长虹，飞沙卷土号阴风。","杂言"],null,null,null,null,null,["月伯明讲经与玉山各赋二绝以寄","姚文奂","玉笛飞空过洞庭，西山不改旧时青。","杂言"],null,null,null,null,["十二月过尧民歌为别情","王实甫","自别后遥山隐隐，更那堪远水粼粼。","杂言"],["紫花儿序","王实甫","也不学刘伶荷锸，也不学屈子投江，且做个范蠡归湖。","杂言"],["越调 斗鹌鹑","王实甫","闲对着绿树青山，消遣我烦心倦目。","杂言"],["【双调】得胜乐 春","白朴","丽日迟，和风习，共王孙公子游戏。","杂言"],["咏雪 大石调【青杏子】","白朴","空外六花番，被大风洒落千山。","杂言"],null,null,null,null,null,null,null,null,null,null,null,["鹦鹉曲","吕济民","朱颜绿鬓难留住。","杂言"],["鹦鹉曲 寄故人和韵","吕济民","心猿意马羁难住。","杂言"],null,["咏雪","张鸣善","漫天坠，扑地飞，白占许多田地。","杂言"],["普天乐 咏世","张鸣善","洛阳花，梁园月，好花须买，皓月须赊。","杂言"],null,null,["歌白苎","李仲南","娇如花，美如玉，越溪女儿十五六。","杂言"],null,null,null,null,null,null,null,null,["清江引","马致远","樵夫觉来山月底，钓叟来寻觅。","杂言"],["金鸡叫","马钰","日日朝朝常报晓。","杂言"],["清心镜 赠荔菲大隐","马钰","修行人，休失错。","杂言"],null,null,null,["玩瑶台（北曲）","冯尊师","直指玄元路。","杂言"],["折桂令","刘庭信","想人生最苦离别。","杂言"],null,["【双调】蟾宫曲","奥敦周卿","西山雨退云收，缥缈楼台，隐隐汀洲。","杂言"],null,["沉醉东风 宫词二首 其一","孙周卿","双拂黛停分翠羽，一窝云半吐犀梳。","杂言"],null,null,null,null,null,["梧叶儿","杨朝英","檐头溜，窗外声。","杂言"],["一半儿 拟美人八咏","查德卿","绿窗时有唾茸粘，银甲频将彩线挦。","杂言"],null,null,["【越调】小桃红 消遣","爱山","一溪流水水溪云，雨霁山光润，野鸟山花破愁闷。","杂言"],null,null,["谢师恩 文登丹霞观二首","王处一","市民官吏同兴观。","杂言"],["鹦鹉曲","白贲","侬家鹦鹉洲边住。","杂言"],null,null,["沉醉东风","赵善庆","山对面蓝堆翠岫，草齐腰绿染沙洲。","杂言"],["折桂令","赵禹圭","长江浩浩西来，水面云山，山上楼台。","杂言"],["百香诗 琴","郭居敬","高山影里希音远，流水声中古调长。","杂言"],null,null,null,null,null,null,null,["仙吕 寄生草 闲评","佚名","问什么虚名利，管什么闲是非。","杂言"],["正宫 叨叨令","佚名","黄尘万古长安路，折碑三尺邙山墓。","杂言"],["中吕 红绣鞋","佚名","窗外雨声声不住，枕边泪点点长吁，雨声泪点急相逐。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["病居读顾与新诗","郑善夫","伏枕殊方客，秋风岁载阴。","五言绝句"],["听莺阁","唐顺之","春催金谷晓，一望百花齐。","五言绝句"],["烟波亭","吴琳","汉水连天阔，江云护晓寒。","五言绝句"],["广州元夜歌 其一","李云龙","粤秀春山锦绣文，烧香士女日纷纷。","七言绝句"],["书云山小景","王恭","野杖闲行日未曛，商歌休使世人闻。","七言绝句"],["题崔甥画卷","李东阳","谷口长松涧底藤，石桥山路晚登登。","七言绝句"],["和山阴宋太史韵 其一","解缙","大秀千峰菡萏开，玉梁高接九仙台。","七言绝句"],["寄于仲宽","解缙","欲写乡书寄故园，行人已远意空存。","七言绝句"],["送友人还山阴","解缙","金凤洲头倒玉壶，铜塘浦口送飞舻。","七言绝句"],["兰溪棹歌三首 其一","汪广洋","凉月如眉挂柳湾，越中山色镜中看。","七言绝句"],["下山寻朱继","林鸿","携琴载酒远寻君，石径人稀日半曛。","七言绝句"],["宫人拈笔图","刘祖满","倦倚西风十二楼，苦吟强半为悲秋。","七言绝句"],["修竹仕女","姚纶","瑶台无信托青鸾，一寸芳心思万端。","七言绝句"],["百花庵主见访","杨循吉","一春高卧只垂帘，说着浮名病又添。","七言绝句"],["旅次","梁若衡","朔风吹雁断菰芦，楚水吴山问去途。","七言绝句"],["蕉萱仕女","唐庠","罗袜生香踏软沙，钗横玉燕鬓松鸦。","七言绝句"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["晚望","刘崧","山气碧氤氲，深林带夕曛。","五言律诗"],["寄赠翠岩泰上人","刘崧","兰若倚西冈，年深松桂长。","五言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,