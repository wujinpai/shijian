[null,null,null,null,null,null,null,null,null,null,["仪真太守召看牡丹","丘浚","何事化工情愈重，偏教此卉大妖妍。","七言律诗"],["登西湖北楼 其一","丘浚","寻游心绪忍阑珊，高处重登始是观。","七言律诗"],["咏钱塘","丘浚","南屏高瞰府城西，画舸千艘共醉迷。","七言律诗"],null,null,null,null,null,null,null,["蔡倅羔羊斋 其一","朱翌","有生不酿羔羊酒，无日不诵羔羊诗。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["送僧","释重显","春风??花正飞，红霞碧霭笼高低。","七言律诗"],null,null,null,null,null,null,null,["倚江亭会上虞伯逵送梅花并二绝句坐上次韵并调贺子忱 其一","王之望","肠断江头索笑花，三三两两逐枝斜。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["项城主簿赵岍求书惹云亭为系二绝 其一","李复","东西飘忽本无心，留碍危檐便不禁。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["府中即事 其二","叶梦得","行歌坐啸往来频，俯仰之间迹已陈。","七言律诗"],["闻兀术将过淮再遣晁公昂觇师","叶梦得","狂酋屡惯骋长驱，未省新军有被庐。","七言律诗"],["淮西军大破贼兵连六告捷喜成口号二首 其一","叶梦得","一战聊麾十万师，西来捷报走黄旗。","七言律诗"],["余每岁病肺往往坐达旦去冬以来偶不作遂得安眠","叶梦得","衰残每苦病相缠，粗喜今年胜去年。","七言律诗"],["诸幕府见和复答二首 其二","叶梦得","欲眠遣客笑吾真，爱酒空床羡汝邻。","七言律诗"],["长桥","叶梦得","长桥跨空水弥漫，北望吞天去无岸。","七言律诗"],null,null,null,null,null,null,null,null,null,["七月廿六日登四望亭小酌和赵守韵二绝 其一","陈文蔚","为爱黄云到晚晴，一樽高兴寄危亭。","七言律诗"],null,null,null,["傅材甫窗前白月桂开材甫索诗戏作 其一","陈文蔚","天然容貌本施朱，喜异羞同世不趋。","七言律诗"],null,null,null,null,null,null,null,null,null,["朝宗雨中醉归为娼女窃笑戏作两绝因继其韵 其一","欧阳澈","雨裛轻尘步武迟，垫巾归自武陵溪。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["坤成节教坊致语口号","范祖禹","彩仗含风缥缈间，神孙当宁燕千官。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,["斗法八条 其三 择牵","贾似道","牵头要长捍要直，落牵不要如弩力。","七言律诗"],null,null,null,null,null,null,null,null,["病起二首 其二","释智圆","湖天淡荡雁参差，行乐支筇绕所居。","七言律诗"],["病起二首 其一","释智圆","衡门牢落雨苔斑，病起深秋气象闲。","七言律诗"],["寄远","释智圆","车声日日碾红埃，何事良人独未回。","七言律诗"],["寄题虎丘山","释智圆","崛起孤峰号虎丘，奇踪宁与众山俦。","七言律诗"],null,null,null,null,["酬王主簿示道中所作","释绍嵩","蓼花红淡苇条黄，洛岸秋晴夕照长。","七言律诗"],null,null,null,null,null,null,["山矾花","张扩","秋风刻縠先黄染，七里寻香不辞远。","七言律诗"],null,null,null,null,null,null,null,["船子和尚赞","释慧远","老手当年靠夹山，全机丧尽结深冤。","七言律诗"],["寄赠洛下达三藏","魏野","曾携钵锡到灵山，古寺归来洛水边。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["某在洛中蒙朝请惠书促归兼录示赏家园芍药两绝比离洛中芍药已阑矣因次元韵追和二首 其一","毕仲游","花开次第剪繁枝，先后争妍各是时。","七言律诗"]]