[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["入都 其一","李鸿章","丈夫只手把吴钩，意气高于百尺楼。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,["五月十日登爱菊亭谒靖节祠二首 其二","王恩浩","高风久仰千秋后，遗址来寻五月中。","七言律诗"],["冬至午后余与吴弟登爱菊亭后塔薄暮唤舟渡湖至江滨品茶而归 其一","王恩浩","孤塔巍然矗半空，登临一览尽西东。","七言律诗"],["杨柳枝  拟花闲","王鹏运","赋里长杨旧有名，即看眉样亦倾城。","七言律诗"],null,null,["登澄台观海","六十七","层台爽气豁双眸，远望沧溟万顷收。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["秋物十咏","卢德嘉","千山瘦削绕平原，纵目西风坐故园。","七言律诗"],["秋物十咏","卢德嘉","澄江入暮夕阳斜，不尽低徊一望赊。","七言律诗"],["秋物十咏","卢德嘉","轻尘静处暗闻香，遥指平原是故乡。","七言律诗"],["秋物十咏","卢德嘉","西风拂柳破愁醒，旧绪依稀别帝京。","七言律诗"],["寄和刘海峰三丈游伊阙之作","姚鼐","闻去梁园超广武，西登阙塞眺黄河。","七言律诗"],["一青仲孚往金陵属访耕南三丈消息","姚鼐","域中前辈尽颓颜，混迹刘伶尚闭关。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["壬辰1832春捧檄来澎随同芸皋观察查办抚恤蒙赐书画联扇赋诗申谢 其一","施模","福星载道海壖东，千里欣乘破浪风。","七言律诗"],["壬辰1832春捧檄来澎随同芸皋观察查办抚恤蒙赐书画联扇赋诗申谢 其二","施模","文章经济达丹墀，鹭岛荆襄见措施。","七言律诗"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["柳枝词二首","纳兰性德","马卿苦忆红泥阁，我亦伤心碧树村。","七言律诗"],null,null,null,null,null,null,null,["澎湖 其一","钱琦","海上三山未渺茫，竹湾花屿郁苍苍。","七言律诗"],["澎湖 其二","钱琦","六六沙湾小似舟，须弥大界一萍浮。","七言律诗"],null,null,null,null,["七夕","马朴臣","何关人事说年年，此夕银河分外妍。","七言律诗"]]