[["句","吴说","山峡名标第一楼。","诗"],["吕子进知睦州予追送累日别后寄之","张举","篱𫛩云鹏各有程，匆匆相别未忘情。","诗"],["春日西兴道中 其五","张栻","檐铎无声鸟语稀，径深钟梵出花迟。","诗"],["游丝","张栻","游丝浩荡醉春光，倚赖微风故故长。","诗"],["次韵东坡还自岭南","李廌","凭陵岁月固难堪，食檗多来味却甘。","诗"],["句","李缜","𫛸𫛞一声春事空。","诗"],["句","欧阳景","清明时节正稼芳。","诗"],["句","汪晫","灭烛闵娥伤。","诗"],["句","王安石","雪底黄精与不疏。","诗"],["句","王安石","周迥莫有千株叶。","诗"],["句 其十","王琪","蚕寒冰茧瘦，蜂老露房攲。","诗"],["句","赵世长","玉清仙子下云达。","诗"],["水国","郑克己","水国烟霞客，春来始定居。","诗"],["偈颂四十一首 其三十七","释普宁","圆同太虚，无欠无馀。","诗"],["句","陈恬","雪晨消磨一半春。","诗"],["句","陶谷","气与金钟病眼明。","诗"]]