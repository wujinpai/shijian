[null,null,null,null,null,null,null,null,null,null,["田水歌二首","黄渊","田水活活，上田落下田，人家兄弟不相怜。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["白云海（范阳卢熊公武篆颜） 其一","瞿荣智","白云深，白云深，白云深护山之心。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,["五杂俎","黄谏","五杂俎，乖空霓。","杂言"],null,null,null,null,null,null,null,null,null,null,["白翁老公祖请告归淄青岁暮凄其离怀充斥漫赋绝句言别","唐汝询","桂香飘处谒司农，践豆相邀意更浓。","杂言"],null,null,null,null,null,null,null,null,null,null,null,["红黄","明令","头似珊瑚项班红，翅如金箔肉带黄。","杂言"],["宋泰始歌舞曲十二首 皇业颂","明帝","皇业沿德建，帝运资勋融。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["九骚引 感往昔","葛高行文","岁聿莫而历蹇兮，执霜心以为柄。","杂言"],null,null,["题张秋蟾画龙","袁忠彻","张公画龙人不识，笔法远自僧繇得。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["永乐初给事姚伯善采木广右被瘴客死殡及六十年至其孙榛鹤始克归葬先兆作诗记之 其十","沈周","呜呼二子者，颓俗亦可兴。","残句"],["成化戊戌十二月十六日与吴原博史明古张子静游阳山入云泉庵观大石联句 其四","李应祯","落照红抹赭，归云白流汞。","残句"]]