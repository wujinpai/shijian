[null,null,["六幺令","晏几道","绿阴春尽，飞絮绕香阁。","杂言"],null,null,null,null,null,null,["杂诗五首","吕诚","三月南江渡，行春属晚晴。","杂言"],null,null,null,null,null,null,["辽人射猎图","李孝光","美人貂帽玉骢马，谁其从之臂鹰者。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["宣布同知自燕京来报国哀时文皇晏驾","卢琦","雨倾盆，风掷瓦，白髯使者能骑马。","杂言"],["儒有萨氏子者家无田囊无储始以进士入官为京口录事长行南台辟为掾继而御史台奏为燕廉访架阁官岁馀迁知闽海廉访事又岁馀诏进河北廉访经历皆奉其母以行其禄养也后至元三年八月望舟泊延平津上是夕星河粲然天无翳云月色如白日溪潺潺如乐奏四山环抱如拱如立如侍左右如奔走执事者萨子奉母船上与其妇具酒殽盘馔奉觞继而若妹妹之婿若仆若婢次而进和而不亵谨而怡怡月光荡酒而溪韵杂语笑母叹息舟人醉歌亦相与鼓枻作南歌为乐今夕何夕不知其异乡","卢琦","龙津秋水涵太虚，今夕何夕光景殊。","杂言"],null,["东汉高士咏十四首 刘翊","张雨","子相足周旋，破此家产丰。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["宝林丈室所藏子昂饮马图","丁复","奚官小臣职奚为，马饥则秣渴饮之。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["天净沙 梅梢月","张弘范","黄昏低映梅枝，照人两处相思，那是愁肠断时，弯弯何似，","杂言"],null,["咏十器 虾须杖","曹文晦","曾读安南奉使书，海翁往往策虾须。","杂言"],null,null,null,null,null,null,null,null,null,["拟古 行行重行行","钱宰","出门万里别，行行远防边。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["宜山谣 椎髻舞","谢应芳","椎髻舞，击铜鼓，浅蛮生蛮皆安堵。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["和禽言二首 婆饼焦","胡天游","婆饼焦，新妇腰镰孙荷樵。","杂言"],null,["忆馀杭 嘉禾八景 空翠风烟","吴镇","万寿山前，屹立一亭名槜李，堂阴数亩竹涓涓。","杂言"],null,null,null,null,null,null,["寄眠云处士","宋无","闻说华阳洞，人间第八天。","杂言"],["宫词 其一","宋无","月照芙蓉水殿秋，仙韶一曲奏《凉州》。","杂言"],["五杂组","宋无","五杂组，角黍丝。","杂言"],null,null,null,null,null,null,null,["鹦鹉曲 处士虚名","冯子振","高人谁恋朝中住。","杂言"],["鹦鹉曲 市朝归兴","冯子振","山林朝市都曾住。","杂言"],["鹦鹉曲 庞隐图","冯子振","团栾话里禅龛住。","杂言"],["鹦鹉曲 都门感旧","冯子振","都门花月蹉跎住。","杂言"],null,null,null,null,null,null,["【双调】大德歌 其一","关汉卿","粉墙低，景凄凄，正是那西厢月上时。","杂言"],["【双调】大德歌 春","关汉卿","子规啼，不如归，道是春归人未归。","杂言"],["【南吕】四块玉 闲适","关汉卿","适意行，安心坐。","杂言"],null,null,null,null,null,null,null,["山之高三章","张玉娘","山之高，月出小。","杂言"],["拜新月二章","张玉娘","拜新月，拜月愿月圆。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["神光灿","谭处端","茫茫苦海，逐浪飘沦，痴如蜂蜜蛾灯。","杂言"],null,null,null,null,null,null,["金字经","张可久","百年浑似醉，满怀都是春，高卧东山一片云。","杂言"],["一半儿","张可久","花边娇月静妆楼，叶底沧波冷翠沟，池上好风闲御舟。","杂言"],null,null,["刮鼓社","王哲","刮鼓社，这刮鼓食中拍。","杂言"],null,null,null,null,["蒲中八咏为师岩卿赋 蒲津晚渡","陈赓","云涛注壶口，水府蟠九垒。","杂言"],null,["雪后","李纯甫","玉环晕月蟠长虹，飞沙卷土号阴风。","杂言"],null,null,null,null,null,["月伯明讲经与玉山各赋二绝以寄","姚文奂","玉笛飞空过洞庭，西山不改旧时青。","杂言"],null,null,null,null,["十二月过尧民歌为别情","王实甫","自别后遥山隐隐，更那堪远水粼粼。","杂言"],["紫花儿序","王实甫","也不学刘伶荷锸，也不学屈子投江，且做个范蠡归湖。","杂言"],["越调 斗鹌鹑","王实甫","闲对着绿树青山，消遣我烦心倦目。","杂言"],["【双调】得胜乐 春","白朴","丽日迟，和风习，共王孙公子游戏。","杂言"],["咏雪 大石调【青杏子】","白朴","空外六花番，被大风洒落千山。","杂言"],null,null,null,null,null,null,null,null,null,null,null,["鹦鹉曲","吕济民","朱颜绿鬓难留住。","杂言"],["鹦鹉曲 寄故人和韵","吕济民","心猿意马羁难住。","杂言"],null,["咏雪","张鸣善","漫天坠，扑地飞，白占许多田地。","杂言"],["普天乐 咏世","张鸣善","洛阳花，梁园月，好花须买，皓月须赊。","杂言"],null,null,["歌白苎","李仲南","娇如花，美如玉，越溪女儿十五六。","杂言"]]