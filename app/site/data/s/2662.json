[["高士颂九十一首 其三十九 黔娄先生","黄省曾","黔娄物表，著撰存志。","四言"],["高士颂九十一首 其四十一 渔父","黄省曾","楚老垂竿，渔于烟水。","四言"],["高士颂九十一首 其四十二 安期生","黄省曾","安期高蹈，疗俗千祀。","四言"],["高士颂九十一首 其四十五 盖公","黄省曾","嬴末龙争，奋图封拜。","四言"],["高士颂九十一首 其四十六 四皓","黄省曾","皇皇四老，同襟齐志。","四言"],["高士颂九十一首 其四十七 黄石公","黄省曾","何者老翁，托名黄石。","四言"],["高士颂九十一首 其四十八 鲁二征士","黄省曾","姬鲁两生，孔庭遗学。","四言"],["高士颂九十一首 其四十九 田何","黄省曾","商瞿授易，桥𫘛周孙。","四言"],["高士颂九十一首 其五十 王生","黄省曾","硕以王生，道研轩李。","四言"],["高士颂九十一首 其五十二 韩福","黄省曾","北郡韩福，洁白修躬。","四言"],["高士颂九十一首 其五十四 □丘望之","黄省曾","安丘丈人，中林自命。","四言"],["高士颂九十一首 其五十五 宋胜之","黄省曾","胜之敦孝，聚居风动。","四言"],["高士颂九十一首 其五十六 张仲蔚","黄省曾","仲蔚遐轮，景卿并辙。","四言"],["高士颂九十一首 其五十八 彭城老父","黄省曾","彭城老父，陆沉皓首。","四言"],["高士颂九十一首 其五十九 韩顺","黄省曾","世道交丧，子良隐息。","四言"],["高士颂九十一首 其六十 郑朴","黄省曾","谷口子真，甘恬秉默。","四言"],["高士颂九十一首 其六十一 李弘","黄省曾","仲元所居，俗用拭新。","四言"],["高士颂九十一首 其六十二 向长","黄省曾","子平上哲，赋德渊冲。","四言"],["高士颂九十一首 其六十四 □霸","黄省曾","儒仲处英，放独新世。","四言"],["高士颂九十一首 其六十五 严光","黄省曾","吁嗟子陵，少与龙潜。","四言"],["高士颂九十一首 其六十六 牛牢","黄省曾","君直峻守，耻交万乘。","四言"],["高士颂九十一首 其六十七 东海隐者","黄省曾","隐者闲旷，避世沧瀛。","四言"],["高士颂九十一首 其六十八 梁鸿","黄省曾","伯鸾者何，修远之子。","四言"],["高士颂九十一首 其六十九 高恢","黄省曾","高恢总发，道德是求。","四言"],["高士颂九十一首 其七十 台佟","黄省曾","孝威特迈，税趾武安。","四言"],["高士颂九十一首 其七十一 韩康","黄省曾","伯休谢俗，𣃁药青冥。","四言"],["高士颂九十一首 其七十二 丘欣","黄省曾","季春傲俗，自矜无伍。","四言"],["高士颂九十一首 其七十四 □棠","黄省曾","季卿懿资，弘通卜艺。","四言"],["高士颂九十一首 其七十五 挚恂","黄省曾","挚氏之恂，光于祖德。","四言"],["高士颂九十一首 其七十六 法真","黄省曾","高卿宿学，门众纷如。","四言"],["高士颂九十一首 其七十七 汉滨老父","黄省曾","汉滨老父，操锄沔上。","四言"],["高士颂九十一首 其七十八 徐稚","黄省曾","孺子清妙，超绝代俗。","四言"],["高士颂九十一首 其七十九 夏馥","黄省曾","八顾夏馥，不通纨绮。","四言"],["高士颂九十一首 其八十 郭太","黄省曾","介休林宗，行师伯彦。","四言"],["高士颂九十一首 其八十一 申屠蟠","黄省曾","子龙尚节，抗论生枯。","四言"],["高士颂九十一首 其八十二 袁闳","黄省曾","汝南夏甫，杜门深处。","四言"],["高士颂九十一首 其八十四 □宁","黄省曾","宁也何自，管仲之孙。","四言"],["高士颂九十一首 其八十五 郑玄","黄省曾","康成蚤颖，博极群典。","四言"],["高士颂九十一首 其八十六 任安","黄省曾","定祖儒流，世有赞言。","四言"],["高士颂九十一首 其八十七 庞公","黄省曾","庞公真隐，志凌冰雪。","四言"],["高士颂九十一首 其八十八 姜岐","黄省曾","子平幼孤，俞俞守道。","四言"],["高士颂九十一首 其八十九 荀靖","黄省曾","八龙矫首，里署高阳。","四言"],["高士颂九十一首 其九十 胡昭","黄省曾","胡昭高尚，不事袁曹。","四言"],["高士颂九十一首 其九十一 焦先","黄省曾","孝然奇士，少避白波。","四言"],["二陶赞二首 其二","黄省曾","弘景通明，丹阳秣陵。","四言"],["游槜李城赞","黄省曾","禹枝稷裔，密为邻奠。","四言"],["游泰伯古墟赞","黄省曾","遐哉泰伯，夙景高风。","四言"],["白鸠篇","黄省曾","白鸠翩翩，飞集君前。","四言"],["独漉篇","黄省曾","独漉独漉，灵沼昆明。","四言"],["当弩渝新福歌一首","黄省曾","光华舜日，烂熳尧云。","四言"],["杂诗","陈子升","绡帏高廓，华燄辉荧。","四言"],["自悼诗","陈子升","有虞之裔，曰我邦家。","四言"],["离合","陈子升","一丘若共，稻斛方均。","四言"],["短歌行","陈子升","有酒盈樽，嘉宾在门。","四言"],["合江楼禊日兰亭体二首 其一","陈子升","白鹤高峙，青牛独驯。","四言"],["相城谣","王鏊","东南地下，众水赴之。","四言"],["纪梦","王鏊","有菀者树，其石惟磐。","四言"],["广成子寿图","王鏊","青山重重，白石齿齿。","四言"],["咏凫山","陶安","凫山苍苍，鲁邦是瞻。","四言"],["咏当涂张县尹善政","陶安","有美君子，尝观国光。","四言"],["咏苏守义妻齐氏","陶安","幽燕之南，晋赵之疆。","四言"],["咏张同知","陶安","有颀之英，今德在躬。","四言"],["樵山会讲学者四人方西樵邓敬所何古林与予时甘露连降于紫云楼之松者三日方西樵有诗乃续而赓之","王渐逵","大渊之岁，厥月惟玄。","四言"],["广居堂","王渐逵","佛山之麓，古洛之墟。","四言"],["空中楼阁","王渐逵","高高者楼，八窗涵之。","四言"],["忠烈陶氏先祠诗 其一","王渐逵","郁郁层林，苍梧之阳。","四言"],["忠烈陶氏先祠诗 其二","王渐逵","戎车戎行，皇威斯张。","四言"],["忠烈陶氏先祠诗 其三","王渐逵","庙食于今，帝显其光。","四言"],["忠烈陶氏先祠诗 其四","王渐逵","下民孔宁，藩侯告成。","四言"],["己酉岁壬辰之夜梦与三洲李丈登高台遥望中原但见齐州九点在苍霭中隐隐可辨三洲曰宇宙内事吾儒分内事也曰子知分内之事则知尽分内之道乎三洲又曰吾今乃知居高则明处下则塞曰子知明塞之义则知尽居处之道矣三洲又曰天地山河存乎两界秦晋为首闽越为尾馀皆毛发肢节也曰子通督任之义则知通致理之源矣须臾云霞四歛皎日照衣环顾太和万物融合浑为一丸三洲曰此所谓弄丸者耶曰子知转九之义则宇宙之柄在手矣语罢而觉遂赋四章以纪其事因以赠三洲之","王渐逵","中原膴膴，谁其域之。","四言"],["书座自警四首 其一","王渐逵","萝山之阴，其下惟松。","四言"],["书座自警四首 其二","王渐逵","勿尔苗稚，其舒则扬。","四言"],["书座自警四首 其三","王渐逵","山则有薇，或渔于河。","四言"],["书座自警四首 其四","王渐逵","甘以疢病，苦则反之。","四言"],["采松歌 其一","霍与瑕","采松采松，东门之阿。","四言"],["采松歌 其三","霍与瑕","三献既陈，礼仪孔殷。","四言"],["集古雅歌题慕溪兼贺寿 其一","霍与瑕","山有蕨薇，薄言采之。","四言"],["集古雅歌题慕溪兼贺寿 其二","霍与瑕","山有乔松，于涧之中。","四言"],["集古雅歌题慕溪兼贺寿 其三","霍与瑕","月出皎兮，于林之下。","四言"],["集古雅歌题慕溪兼贺寿 其四","霍与瑕","尔之安行，永言孝思。","四言"],["集古雅歌题慕溪兼贺寿 其五","霍与瑕","恺悌君子，为龙为光。","四言"],["集古雅歌题慕溪兼贺寿 其六","霍与瑕","思皇多士，称彼兕觥。","四言"],["安愚雅诗","霍与瑕","翩翩黄雀，集于廪廋。","四言"],["初四日舟至观音岩忆诸兄弟集古寄怀","霍与瑕","十月之交，北风其凉。","四言"],["寄潘春楼年兄","霍与瑕","维此暮春，既多受祉。","四言"],["送杜方伯入觐 其一","霍与瑕","显显方伯，屏此明都。","四言"],["送杜方伯入觐 其二","霍与瑕","方伯维儒，恂恂大雅。","四言"],["寒食 其一","霍与瑕","春华敷荣，春日渐阳。","四言"],["寒食 其二","霍与瑕","庭树有枝，蔼其繁阴。","四言"],["寒食 其三","霍与瑕","谓山其高，谓水其深。","四言"],["寒食 其四","霍与瑕","驱马出郊，风凉月皓。","四言"],["白云谣","欧必元","白云在天，出自山谷。","四言"],["善哉行","欧必元","唯昔巢父，逃颍之湄。","四言"],["日出东南隅四章 其一","欧必元","采采南陌，言采其桑。","四言"],["日出东南隅四章 其二","欧必元","采采南陌，言采其叶。","四言"],["日出东南隅四章 其三","欧必元","日出东南，照彼城隅。","四言"],["日出东南隅四章 其四","欧必元","春日载阳，仓庚既鸣。","四言"],["清溪小姑曲","欧必元","欢住湖东，侬住湖西。","四言"],["寿大中丞总督尚书戴公","欧必元","于穆我祖，万邦作乂。","四言"],["远游","石宝","君之出矣，游如之何。","四言"],["述始","石宝","于皇崇祖，植义槁郊。","四言"],["谢桑园子送山丹","石宝","有灼其华，绿茎丹葩。","四言"],["题学觉堂次白沙韵","庞嵩","圣学何学，天灵天觉。","四言"],["予所岩在黄龙洞西己亥长至庞子始辟","庞嵩","高山尔名，龙岩尔姓。","四言"],["盘予谷在予所岩下中有八卦台","庞嵩","据后天后，悟先天前。","四言"],["枕碧岩在黄龙洞东泉澄碧可鉴","庞嵩","欲澄尔心，用照尔面。","四言"],["候不至三章","庞嵩","坐柏之下，晷移八尺。","四言"],["语影","庞嵩","欲行欲行，顾子行行。","四言"],["隐翠岩在黄龙洞最深处林翠盘郁径引泉带","庞嵩","毋曰隐矣，莫予闻觏。","四言"],["达观岩","庞嵩","广而非旷，高而非迂。","四言"],["游白云洞","庞嵩","洞有鼓钟，泉奏管籥。","四言"],["拟矫志篇","王廷陈","龙虬虽困，不资鳝鳅。","四言"],["放歌行","王廷陈","窃钩者诛，窃国者王。","四言"],["杂谣五首 其一","王廷陈","茸茸者离，而子践之。","四言"],["杂谣五首 其五","王廷陈","翁曰留宾，妪曰无尊。","四言"],["来日大难","王廷陈","来日大难，天命奈何。","四言"],["猛虎行","王廷陈","上山采樵，道逢猛虎。","四言"],["远游篇四首 其一","王廷陈","汤谷既暗，蒙汜则荣。","四言"],["远游篇四首 其二","王廷陈","徘徊昆丘，憩驾层城。","四言"],["远游篇四首 其三","王廷陈","手揽羲和，顿策徐行。","四言"],["远游篇四首 其四","王廷陈","逍遥天衢，恣意所之。","四言"],["怨诗一章","王廷陈","陨叶眷柯，断株怀蒂。","四言"],["善哉行","薛蕙","来日大难，痛心疾首。","四言"],["白华美孝子也","王绂","彼白者华，维色之洁。","四言"],["濑水美仲琰也史仲琰能绍先志故美之","王绂","瞻彼濑水，其流汤汤。","四言"],["玄鸟赠蒋氏","薛蕙","翩翩玄鸟，秋日载徂。","四言"],["晋七贤图像诗","薛蕙","在昔有晋，多士间出。","四言"],["寿顾华玉母分得云林夫人","薛蕙","金台曾构，瑶波潭沲。","四言"],["顾东江先生遗善堂诗 其一","薛蕙","纷纶灵系，昭晰瑞图。","四言"],["顾东江先生遗善堂诗 其二","薛蕙","谷水盘纡，昆山岝㠋。","四言"],["顾东江先生遗善堂诗 其三","薛蕙","三五迭终，公侯复始。","四言"],["顾东江先生遗善堂诗 其四","薛蕙","履满思谦，居崇鉴替。","四言"],["顾东江先生遗善堂诗 其五","薛蕙","昔尔先祖，遗善自名。","四言"],["顾东江先生遗善堂诗 其六","薛蕙","粲粲新宫，峨峨层构。","四言"],["顾东江先生遗善堂诗 其七","薛蕙","堂置诗书，庭陈金石。","四言"],["煌煌京洛行","薛蕙","猗猗椅桐，斤斯斧斯。","四言"],["黄鹄篇","薛蕙","飞飞者鹄，于彼苍天。","四言"],["短歌行","薛蕙","蟋蟀在堂，野有繁霜。","四言"],["君子行","薛蕙","君子思危，惧不终日。","四言"],["飞龙篇","薛蕙","晨登金坛，神君所治。","四言"],["惜阴五章章八句","钟芳","日居月诸，瞬息异咎。","四言"],["有感","钟芳","惟重惟默，退焉若缩。","四言"],["竹石","钟芳","有蔚者竹，其叶沃若。","四言"],["谕俗诗","钟芳","惟兹临漳，闽南奥区。","四言"],["赠黄用晦贡士","钟芳","癸巳之春，予徂自南。","四言"],["宋璟开元初璟入相广州吏民为璟立遗爱碑璟上言在州无异迹请敕禁之于是他州皆不敢立","钟芳","丰碑镌实，骏庸则书。","四言"],["阅历科进士录 其三","钟芳","悠悠扬扬，为鸾为凤。","四言"],["短歌行","胡俨","前有樽酒，扬眉浩歌。","四言"],["独漉篇","郑学醇","独漉独漉，水深泥浊。","四言"],["恭遇上耕籍田作诗八章","黎遂球","帝德萃虞，王功尚周。","四言"],["幼妇篇","黎遂球","幼妇皎然，年当艳时。","四言"],["孤鸟篇","黎遂球","孤鸟卓卓，回翔自天。","四言"],["壮游篇","黎遂球","壮游峨峨，戏谑逍遥。","四言"],["独漉","黎遂球","独漉独漉，水深泥浊。","四言"],["善哉行","黎遂球","人生百年，昼夜平分。","四言"],["中夜篇","黎遂球","中夜对酒，徙倚徬徨。","四言"],["东皋修禊诗","黎遂球","黄鸟既鸣，曲池既波。","四言"],["村居效陶体四首 其一","曹义","幽幽村居，异彼廛庐。","四言"],["村居效陶体四首 其二","曹义","村居幽幽，面山临流。","四言"],["村居效陶体四首 其三","曹义","依依杨柳，荫我户牖。","四言"],["村居效陶体四首 其四","曹义","嗟予小子，才无寸长。","四言"],["猛虎行","贝琼","有虎有虎，在彼中野。","四言"],["出都谣八章","何绛","鞭马射狐，狐入地呼。","四言"],["挽杨烈妇二章","何绛","室中之戈，其乱孔多，妾死则那。","四言"],["图茔致思四首 其一 宝涧操","史鉴","群山巃嵷，孕厥灵兮。","四言"],["图茔致思四首 其四 涂岭操","史鉴","涂岭崔嵬，深谷逶迤。","四言"],["三元塔宝顶铭","林熙春","凤城之东，吉水一泓。","四言"],["赵氏一瓢春轩","袁华","斋居如壶，迥非人间。","四言"],["君子之骢","倪谦","君子之骢，载骤载驰。","四言"],["慈乌","倪谦","慈乌在林，爰返其哺。","四言"],["萱堂","倪谦","彼茁者萱，于堂之域。","四言"],["望云思亲卷为史侍御赋","童轩","白云悠悠，在天之陬。","四言"],["玉泉","童轩","樟山何有，有玉有泉。","四言"],["兰室为会稽陈德诚赋","童轩","兰之香兮，维叶茂茂。","四言"],["东江堤 其一","祁顺","维城宝安，东七十里。","四言"],["东江堤 其二","祁顺","前有邓侯，后获杨尹。","四言"],["送司寇金公诗","祁顺","圣皇御极，治迈尧汤。","四言"],["翟家嘴道中","赵完璧","高山崭岩，冰溪冱结。","四言"],["过西岩寺山","赵完璧","陟彼东𪩘，寒云苍苍。","四言"],["魏太史为其尊公中丞请封册子 其一","韩日缵","邈矣魏祖，远出姬系。","四言"],["魏太史为其尊公中丞请封册子 其二","韩日缵","其裔伊何，神之所笃。","四言"],["魏太史为其尊公中丞请封册子 其三","韩日缵","丰光伊茂，奕世振丕。","四言"],["魏太史为其尊公中丞请封册子 其四","韩日缵","桓桓司马，勋猷允赫。","四言"],["魏太史为其尊公中丞请封册子 其五","韩日缵","缵戎祖考，维此武功。","四言"],["题黄亮垣采兰册 其一","韩日缵","有猗其兰，植彼阶庭。","四言"],["题黄亮垣采兰册 其二","韩日缵","芄兰之枝，荫彼玉池。","四言"],["题黄亮垣采兰册 其三","韩日缵","采兰采兰，于粤之沚。","四言"],["采薇","汪广洋","采薇采薇，山高路危。","四言"],["命子篇戏呈岳丈张太守","陶益","明我曾祖，谥忠烈臣。","四言"],["所思","陶益","有台可登，有酒可增。","四言"],["拊剑篇","孙一元","天风扬蓬，海水啸波。","四言"],["勤有斋铭","邓雅","民生在勤，勤则不匮。","四言"],["题王氏可逸堂（其孙永安求赋堂扁乃三十八代天师所书）","邓雅","人生在勤，勤乃可逸。","四言"],["兰雪堂铭","邓雅","乾坤清气，人物所钟。","四言"],["舟中","伍瑞隆","皎皎亮月，丽于中流。","四言"],["遣兴","伍瑞隆","罗衣虽轻，不如布好。","四言"],["拟秦楼初成弄玉赠萧史作赠伯友新昏","伍瑞隆","黄金为宇，白玉雕栏。","四言"],["善哉行","伍瑞隆","微风扇霁，天高夜清。","四言"],["寿从父初度","伍瑞隆","赫赫我祖，令德孔艾。","四言"],["存介斋箴","董纪","人或未然，我审其几。","四言"],["春江曲","李英","持竿垂钓，顶笠披蓑。","四言"],["暮春遇卢达章诸君","李英","武陵春暮，返照西台。","四言"],["纪兴二首 其一","李英","每日频开，竹径清修，独爱谈玄。","四言"],["纪兴二首 其二","李英","所为三教，弟子长吟，社结莲花。","四言"],["偶作","杨爵","飒飒西风，悠悠危困。","四言"],["今日无酒","李昱","今日无酒，何以写心。","四言"],["对酒（亦曰《偶会行》）","唐之淳","对酒勿伤，偶会何常？","四言"],["一斋铭有序","唐之淳","天地之道，博厚高明。","四言"],["禊日效兰亭体二首 其一","陈子壮","春服既成，少长乃携。","四言"],["仿孔北海离合诗","陈子壮","早披八索，寸丝不长。","四言"],["为冯青方铭杖","陈子壮","七尺之筇，五尺之童。","四言"],["天涯曲","沈炼","来牛去马，运方兴兮。","四言"],["题松石图","张以宁","繄松之苍，繄石之刚。","四言"],["题松隐图","张以宁","苍苍藓石，谡谡云松。","四言"],["昭信曲","释宗泐","维此妙香，五分普熏。","四言"],["延慈曲","释宗泐","泥连先馈，纯陁后供。","四言"],["法喜曲","释宗泐","仁风广被，春日载熙。","四言"],["禅悦曲","释宗泐","礼诚在敬，三献靡加。","四言"],["遍应曲","释宗泐","𫗣馨既歆，笾豆尚列。","四言"],["善成曲","释宗泐","瞻燎于西，祥焰腾空。","四言"],["献币","释宗泐","礼有至重，无逾法施。","四言"],["献茶","释宗泐","有茁者茗，于彼先春。","四言"],["送鲍仲嘉省亲诗望云篇","唐文凤","朝登崇山，言策其马。","四言"],["瑞应驺虞诗","杨荣","于维圣皇，德被八垠。","四言"],["神龟诗","杨荣","于昭皇祖，圣神文武。","四言"],["瑞应麒麟诗六章章十句","杨荣","猗欤祥麟，其祥曷征。","四言"],["双松堂","杨荣","郁郁双松，植于堂傍。","四言"],["广寿堂","杨荣","翼翼高堂，有华其构。","四言"],["猗兰操","周瑛","维山有谷，露瀼瀼兮。","四言"],["题刘时让知县一清泉卷二章","王缜","相彼流泉，湜湜其清。","四言"],["正德戊辰余叨参政滇南四月十日有寒鸦四来巢于公衙之西北墙空西者乳子四纯墨北者乳子亦四间白占之朕兆不知何谓因作短句四章以识之庶后有所考","王缜","有鸟有鸟，载飞载鸣。","四言"],["题李元敬母陈氏旌节卷","王缜","维竹挺节，维玉秉洁。","四言"],["代枯鱼过河泣 其二","凌义渠","四大虽坚，微风可析。","四言"],["戊子歌","王邦畿","岁维戊子，月建乙卯。","四言"],["终慕堂","何乔新","瞻彼堂前，维椿郁郁。","四言"],["平林十章送宪使钱廷珍赴任","何乔新","菀彼平林，言秣我马。","四言"],["北山堂诗","林弼","瞻彼北山，其下有堂。","四言"],["元帅观公平寇诗","林弼","元受天命，率土悉臣。","四言"],["宋公遗爱祠","张诩","懿哉宋公，德大有容。","四言"],["燕喜亭","张诩","连山苍苍，湟水东之。","四言"],["马鞍山","张诩","郁郁葱葱，王气佳兮。","四言"],["题琼山王銮妻吴氏贞节坊","张诩","五星烛天，五岳峙地。","四言"],["有严八章　迁泮落成也","邱云霄","有严新宫，维南孔旸。","四言"],["乘黄一章章二十八句　咏图寿何古叟也","邱云霄","我闻有昔，皇运其昌。","四言"],["卿云四章　书所见也","邱云霄","卿云英英，出自方东。","四言"],["芃芃斯蔗四章　寿冯司徒郎也","邱云霄","芃芃斯蔗，有旨且甘。","四言"],["嗟嗟一章章十二句　咏屈平也","邱云霄","嗟嗟贵戚，顾义瞿瞿。","四言"],["赫赫一章章十句　咏留侯也","邱云霄","赫赫留侯，万夫之特。","四言"],["有烨咏一章章八句　靖节也","邱云霄","有烨黄花，味同隐逸。","四言"],["龙卧一章章十句　咏武侯也","邱云霄","龙卧南阳，与世相忘。","四言"]]