四言"],["陇头水","戴亨","陇水汤汤，塞草茫茫。","四言"],["关山月","戴亨","关山月苦，如雪如霜。","四言"],["长至日祀天圜丘有述四章","玄烨","于穆天縡，鉴观惟赫。","四言"],["题兰","玄烨","君子之道，暗然日章。","四言"],["题徐碧岩桃溪自在图","林占梅","蕉阳之西，村庄幽沃。","四言"],null,["琴志楼诗其二","易顺鼎","峨峨高山，洋洋流水。壑想藏舟，岩思避雨。太虚无垠，人","四言"],["琴志楼诗其三","易顺鼎","高山峨峨，流水洋洋。躬耕百年，奉我高堂。左列图书，右","四言"],["琴志楼诗其四","易顺鼎","流水洋洋，高山峨峨。八表非远，一云能多。攀我丛桂，赠","四言"],["题太白醉月图一首","金朝觐","乐哉学士，对月称觞。","四言"],["赐怡亲王二首 其一","胤禛","皇皇藩服，惟德是荣。","四言"],["钓鱼篇","李锴","鱼之洋洋，避我钓竿。","四言"],["戒子书","洪亮吉","九垓之内，人同蛾多。","四言"],["苏门啸","洪亮吉","阮生狂耶，稽生傲耶。","四言"],["桃源记","洪亮吉","不闻人声，但闻琴声。","四言"],["题姻亲郭信发实颐夫妻像赞 诰授昭武都尉郭君像赞","曾习经","抗心希古，养素全真。","四言"],["诰封恭人林太人像赞","曾习经","庆云承光，鸣琚表德。","四言"],["题布袋和尚","戴梓","瞻彼布袋，其高如邱。","四言"],["题画罗汉 其一","戴梓","溪水泠泠，石梁屹屹。","四言"],["题画罗汉 其三","戴梓","承彼箕趺，岩岩石峙。","四言"],["题画罗汉 其四","戴梓","合掌陈词，问以大道。","四言"],["题画罗汉 其五","戴梓","猛士贾力，视虎如𫎆。","四言"],["题画罗汉 其六","戴梓","偶逢一石，就之欲眠。","四言"],["题画罗汉 其七","戴梓","茫茫大海，何为彼岸。","四言"],["题画罗汉 其八","戴梓","宝塔七级，其小如锥。","四言"],["题画罗汉 其九","戴梓","杖不自持，反付童子。","四言"],["题画罗汉 其十","戴梓","白云蒸蒸，高台层层。","四言"],["医巫闾山","戴梓","瞻彼闾山，巍巍灵厚。","四言"],["高宗纯皇帝御制大雩乐章云汉诗八章乾隆七年","弘历","瞻彼朱鸟，爰居实沈。","四言"],["高宗纯皇帝御制盛京大燕世德舞乐十章乾隆八年","弘历","粤昔造清，匪人伊天。","四言"],["高宗纯皇帝御制乡饮酒礼乐章补笙诗六篇乾隆十年 南陔三章二章章六句一章八句","弘历","我逝南陔，言陟其岵。","四言"],["高宗纯皇帝御制乡饮酒礼乐章补笙诗六篇乾隆十年 由庚四章章四句","弘历","由庚便便，东西朔南。","四言"],["高宗纯皇帝御制乡饮酒礼乐章补笙诗六篇乾隆十年 由仪四章二章章四句二章章二句","弘历","在上曰天，在下曰地。","四言"],["归农","王季珠","猗猗桑柘，蚕事三春。","四言"],["画格赘言","陈式金","园居多暇，好写无声。","四言"],["玄冥","张令仪","北户乃墐，凝阴冱寒。","四言"],["西颢","张令仪","大火既流，凉风荐爽。","四言"],["哭长姊诗","李长霞","允矣我姊，令德祁祁。","四言"],["命女 其一","李长霞","干刚坤柔，太始判德。","四言"],["命女 其二","李长霞","谦为德舍，让为礼基。","四言"],["命女 其三","李长霞","夫正而和，妇顺而敬。","四言"],["命女 其四","李长霞","女德无极，维顺是长。","四言"],["命女 其五","李长霞","小心翼翼，在圣犹称。","四言"],["命女 其六","李长霞","维诗与书，发天明命。","四言"],["命女 其七","李长霞","德成于谨，业盛于勤。","四言"],["善哉行","李邺嗣","登山采薇，重茧下山。","四言"],["关陇平 其六","叶方霭","勇自河西，衔枚疾指。","四言"],["关陇平 其七","叶方霭","东西合围，贼在釜底。","四言"],["关陇平 其八","叶方霭","于征何所，于巩于临。","四言"],["关陇平 其九","叶方霭","胁从蚩蚩，亦孔之哀。","四言"],["关陇平 其十","叶方霭","义威戢武，奠我西陲。","四言"],["海氛清 其三","叶方霭","于兴于泉，于汀于漳。","四言"],["海氛清 其六","叶方霭","将士和睦，有凫在藻。","四言"],["海氛清 其九","叶方霭","四州士女，来迎王旅。","四言"],["海氛清 其十","叶方霭","帝德溥将，涵负吐纳。","四言"],["海氛清 其十一","叶方霭","皇帝在位，受天之箓。","四言"],["拟古三章","刘慎荣","芃芃黍苗，蕴崇孔劳。","四言"],["石房樵唱画册题辞","施钰","岩石嵌空，松风谡飒。","四言"],["怡轩歌","莫友芝","湛湛良秋，煜煜佳树。","四言"],["短兵篇","梦麟","长戈荡决，不如短兵。","四言"],["哀歌行","梦麟","喧者勿喧，歌者勿歌。","四言"],["儿语","费锡璜","鹞鹰搏鸡，鸡有母护。","四言"],["题过谨言先生慕劬室图四言四章征其题孙集汉陶秋","缪九畴","采采荣木，蔚蔚洪柯。","四言"],["励志诗·主敬","旻宁","圣学之原，基于方寸。","四言"],["励志诗·勤学","旻宁","饱食终日，宴安自居。","四言"],["励志诗·改过","旻宁","人谁无过，患不自知。","四言"],["修禊六章","顾绍敏","幽兰在室，修竹在林。","四言"],["拟束皙补亡诗 其一 南陔","吴敦仁","南陔有兰，言采其英。","四言"],["拟束皙补亡诗 其二 白华","吴敦仁","白华翩反，在彼空谷。","四言"],["拟束皙补亡诗 其三 华黍","吴敦仁","有黍者华，植于阪田。","四言"],["拟束皙补亡诗 其四 由庚","吴敦仁","由庚由庚，同我太平。","四言"],["拟束皙补亡诗 其六 由仪","吴敦仁","先王有道，小大由之。","四言"],["瘗鹤铭有序","刘伯琛","伟兹胎禽，禀质清绝。","四言"],["山居诗","秦道然","山斋寂寂，玄鸟初来。","四言"],["日月山铭","陈文述","青海万里，连山突兀。","四言"],["风雨篇","鲁兰仙","春风习习，春雨丝丝。","四言"],["肥乡乡学诸生恭送肥乡训导刘光陛先生百韵诗","崔旭","隋陆才卓，未遑武功。","四言"],["薤露歌","魏裔介","波流汤汤，逝不竭兮。","四言"],["十阿父","顾陈垿","为天子父，孰如其尊。","四言"],["出门","赵由仪","出门茫茫，明日异乡。","四言"],["咏史 其一","章学诚","浩浩今古，茫茫长途。","四言"],["刘参军锸","王吉武","伯伦沉酣，万古转睫。","四言"],["敬摹亚圣像立石台郡学宫诗以记之","许青麟","巍巍圣德，孰与比隆。","四言"],["雉子斑","缪慧远","雉子斑兮，其羽煌煌。","四言"],["题画","超源","溪口有亭，岩边有屋。","四言"],["短歌行","杨宗发","有酒当歌，歌亦莫苦。","四言"],["拟剥啄行","万承苍","剥剥啄啄，有客停车。","四言"],["祠阙里雅","李振裕","太山岩岩，遐尔具瞻。","四言"],["曹仁宪谨荣寿又集诗句","林春和","岂弟君子，在彼中河。","四言"],["复性篇","俞荔","混沌之初，无极太极。","四言"],["善哉行","任元祥","人生太难，车摧马烦。","四言"],["短歌行","黄垍","龙蟠于泥，蚖其肆之。","四言"],["自箴四章","沈蕙玉","天生蒸民，有觉其性。","四言"],["渔父","俞桐","身为渔父，志不在鱼。","四言"],["曹仁宪谨荣寿颂四章","黄文彬","维岳降神，诞我公祖。","四言"],["挽乡前辈理斋常公殉节集古","王柱","瑰望硕儒，为郡盛族。","四言"],["题石屋洞","吴树芬","石顽不顽，非屋似屋。","四言"],["游元朔山汇诗品","钱维伦","大道日往，妙机其微。","四言"],["石浪庵山楼社集分体分韵得四言人字","陈大钧","眷怀锡麓，乘彼良辰。","四言"],["六月十八日未明望海","郑孝胥","天荒荒而非云，月团团而无色。海兀兀而不波，楼迢迢而将","六言"],["广谪仙怨","文廷式","玄菟千里烽烟，铁骑纵横柳边。","六言"],["金陵十二钗又副册 袭人","曹雪芹","枉自温柔和顺，空云似桂如兰。","六言"],["虚空","陈曾寿","鸭子过新罗去，国师在鼻孔中。时无石巩好手，如何捉住虚","六言"],["桑林乍绿蚕事方兴诗以嘉之","玄烨","弥望桑林吐叶，垂枝嫩碧初匀。","六言"],["忆畅春园牡丹","玄烨","晓雨疏疏薄洒，午风习习轻吹。","六言"],["铁岭","玄烨","雨馀塞草自绿，日出山花更红。","六言"],["杂咏","玄烨","古戍行来日落，孤村坐对月明。","六言"],["水淀杂诗四首 其一","玄烨","轻舟十里五里，垂柳千丝万丝。","六言"],["水淀杂诗四首 其二","玄烨","春水船行天上，泠风雨过田家。","六言"],[