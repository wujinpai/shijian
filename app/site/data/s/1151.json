时六章章四句  其五","彭汝砺","勇兮勇兮，子我所器。","四言"],["文宣王及其弟子赞 其四十","赵构","肃肃曹伯，王室之裔。","四言"],["偈","徐守信","天地一尺，四海一滴。","四言"],["偈颂一百三十三首 其四十一","释法薰","举古举今，和泥合水。","四言"],["神功盛德诗  其七","华镇","恢恢皇纲，周汉之后。","四言"],["赠朱世英","惠洪","老妻营炊，稚子汲水。","四言"],["神功盛德诗  其九","华镇","蕞尔汾晋，秽我王路。","四言"],["文宣王及其弟子赞 其三十一","赵构","惟禽之问，从容其鲤。","四言"],["文宣王及其弟子赞 其六十一","赵构","君子若人，单父之政。","四言"],["偈六十九首 其一","释道宁","宝座既登，清风四起。","四言"],["古器图赞","刘跂","想古之人，悠哉邈乎。","四言"],["好恶吟","邵雍","恶死好生，去害就利。","四言"],["三月十三日夜五更闻杜鹃时成父欲入浙因赋六章章四句以送之  其六","赵蕃","不如归去，子宁肯住。","四言"],["酬海宗二侍者 其二","释重显","兰之得荪，其道必存。","四言"],["偈颂七十一首 其二十四","释了惠","诸佛诸祖，邪入肺腑。","四言"],["赤城六章章四句  其四","释居简","千里寿公，祷公寿康。","四言"],["野狐话颂","释空","含血噀人，先污其口。","四言"],["文宣王及其弟子赞 其三十","赵构","秦有子南，蜚声述作。","四言"],["偈六十九首 其二十三","释道宁","大道无私，要由心悟。","四言"],["四皓歌 其三","刘敞","高岩有薇，深谷有芝。","四言"],["枕头","释慧开","轮回根本，莫著相好。","四言"],["颂古一百二十一首 其八十","释宗杲","有礼有乐，有唱有酬。","四言"],["寄君时四章章四句  其一","彭汝砺","我脂我车，陟彼高冈。","四言"],["寄君时四章章四句  其一","彭汝砺","我灌我园，有采之心。","四言"],["偈六十九首 其三","释道宁","没弦琴韵，罕遇知音。","四言"],["题秋堂四兰 其四 雪","释绍昙","幽石封白，深林掩芳。","四言"],["祭先农","李新","帝先农功，曰惟孟春。","四言"],["三月十三日夜五更闻杜鹃时成父欲入浙因赋六章章四句以送之  其四","赵蕃","归去来兮，言发动随。","四言"],["四皓歌 其一","刘敞","与汝携手，南山之阿。","四言"],["四皓歌 其二","刘敞","大风横厉，江海荡波。","四言"],["文宣王及其弟子赞 其二十","赵构","伯夫荥阳，实惟令德。","四言"],["文宣王及其弟子赞 其五十","赵构","有怀子折，全鲁之彦。","四言"],["迷悟吟","邵雍","君子改过，小人饰非。","四言"],["和陶劝农六首，并引 其四","苏轼","听我苦言，其福永久。","四言"],["嘉定十五年皇帝受恭膺天命之宝三首 其二","郊庙朝会歌辞","于穆我皇，之德之纯。","四言"],["把手吟","邵雍","富贵把手，贫贱掣肘。","四言"],["寄君时六章章四句  其四","彭汝砺","勿谓过小，我姑为之。","四言"],["偈颂一百零二首 其七十八","释慧远","春日迟迟，春风浩浩。","四言"],["有美人兮四章  其四","赵友直","有美人兮，在天之北。","四言"],["偈一百二十首 其一○八","释怀深","水中盐味，色里胶青。","四言"],["偈三首 其三","惠洪","不知即问，不见即讨。","四言"],["颂古十七首 其十四","释道行","如何是佛，口是祸门。","四言"],["偈颂七十一首 其十八","释了惠","楚江南畔，甬水东边。","四言"],["文宣王及其弟子赞 其三十三","赵构","纪伯子鲁，圣学是务。","四言"],["日用","惠洪","昼为情缘，夜为恶想。","四言"],["五方帝 其五","郊庙朝会歌辞","圣考能飨，宗祀熙成。","四言"],["寄君时四章章四句  其三","彭汝砺","我思昔人，亦采其薇。","四言"],["四不可吟","邵雍","言不可妄，行不可隳。","四言"],["封本堂","徐积","物无其实，其名弗至。","四言"],null,["采蕺 其四","王十朋","我陟高岗，瞻望东越。","四言"],["寄君时六章章四句  其三","彭汝砺","勿谓道远，我至之难。","四言"],["养雁","仇远","雍雍阳鸟，其居朔方。","四言"],["信士画真请赞 其五","释印肃","苍天苍天，悟无生法。","四言"],["思虑吟","邵雍","思虑未起，鬼神莫知。","四言"],["冽井  其三","王柏","有冽彼泉，弦歌之东。","四言"],["渊圣皇帝题十八学士颂","李纲","英英策府，十八学士。","四言"],["三月某日有感而书","杜范","敏不可恃，钝宜自强。","四言"],["和君时十章章四句  其一","彭汝砺","猗彼君子，笃志乎道。","四言"],["新池答问","陈宓","即宅见湖，移园就宅。","四言"],["送云鹤山人","徐积","星非甘公，卦非焦赣。","四言"],["小车吟","邵雍","有客无知，唯知有家。","四言"],["嘉定十五年皇帝受恭膺天命之宝三首 其三","郊庙朝会歌辞","我祖我宗，德厚泽深。","四言"],["颂古十八首 其十二","释宝印","何必不必，金刀玉尺。","四言"],["偈颂七十六首 其二","释师观","坐断要津，全提正令。","四言"],["赠别李次翁","黄庭坚","利欲薰心，随人翕张。","四言"],["昕侍者求赞","释清远","吾行尔随，吾唤尔应。","四言"],["文宣王及其弟子赞 其五十二","赵构","黄伯著祀，公孙是云。","四言"],["文宣王及其弟子赞 其五十一","赵构","先觉既位，簪履并驰。","四言"],["接待","释慧开","洋铜汁羹，热铁丸饭。","四言"],["偈颂七十一首 其十九","释了惠","隔江回首，已涉波澜。","四言"],["偈颂一百二十三首 其五十六","释崇岳","石巩张弓，鲁祖面壁。","四言"],["牙药","释慧开","点著些儿，妙不可述。","四言"],["采蕺 其二","王十朋","陟彼越山，言采其茗。","四言"],["送山阳宰","徐积","大夫三年，平恕如一。","四言"],["凝华殿帖子","赵禥","帝德巍巍，温恭允塞。","四言"],["和君时十章章四句  其九","彭汝砺","为山一篑，惧乎或止。","四言"],["寄君时六章章四句  其一","彭汝砺","我思古人，克诚其心。","四言"],["文宣王及其弟子赞 其二十三","赵构","惟时义方，有子诚孝。","四言"],["有客","释智圆","有客有客，来扣我门。","四言"],["和君时十章章四句  其三","彭汝砺","孰违孰从，曰吾从义。","四言"],["克商操","薛季宣","天命文考，剪灭大商。","四言"],["寄君时六章章四句  其六","彭汝砺","子能吾取，吾谁之匿。","四言"],["师自作真赞 其四","释守卓","南海之滨，兔生两角。","四言"],["颂古二十五首 其二十四","释崇岳","腊月烧山，天宽地宽。","四言"],["颂古九首 其三","释梵言","田中插锹，床上推枕。","四言"],["自警 其一","赵禥","孳孳为善，无怠讲习。","四言"],["祭佛照塔","释善珍","师在干淳，名塞穹壤。","四言"],["盘居六章  其五","项安世","渐以中上，屯以正行。","四言"],["嘉定十五年皇帝受恭膺天命之宝三首 其一","郊庙朝会歌辞","我祖受命，恭膺于天。","四言"],["文宣王及其弟子赞 其六十","赵构","仕进之道，要在究习。","四言"],["颂古二十一首  其一六","释正觉","大地火发，间不容发。","四言"],["新田诗","王安石","离离新田，其下流水。","四言"],["和君时十章章四句  其八","彭汝砺","无悔无尤，是则养亲。","四言"],["春秋赞","赵禥","微显阐幽，三体五例。","四言"],["再次四言韵二首 其一","洪炎","执虎入圈，絷驹在闲。","四言"],["石藏玉赞","陈著","天下之宝，惟玉为最。","四言"],["偈一百二十首 其一○三","释怀深","身心一如，身外无馀。","四言"],["淳熙三年发皇后册宝十三首 其二","郊庙朝会歌辞","卜月惟良，练辰斯臧。","四言"],["颂古九首 其八","释思岳","天魔谤佛，桀犬吠尧。","四言"],["皇帝冬至御大庆殿举第一盏酒奏庆云之曲","王珪","乾坤顺夷，皇有嘉德。","四言"],["贵贱吟","邵雍","系自我者，可以力行。","四言"],["三月十三日夜五更闻杜鹃时成父欲入浙因赋六章章四句以送之  其五","赵蕃","不如归去，载丁载宁。","四言"],["偈","释惟简","莫离盖缠，莫求佛祖。","四言"],["偈颂七十六首 其二十七","释师范","一阳来复，万汇发生。","四言"],["文宣王及其弟子赞 其二十二","赵构","乐善哲士，伯于汧阳。","四言"],["惠门寺钟铭","王庭珪","万动俱寂，如大虚空。","四言"],["偈颂一百三十三首 其二","释法薰","高峰方丈，内外皆空。","四言"],["有美人兮四章  其三","赵友直","有美人兮，在天之南。","四言"],["寄三山彭鹤林","白玉蟾","瞻彼鹤林，在彼无诸。","四言"],["止堂铭","释守卓","旨哉斯堂，全观全止。","四言"],["观音大士赞","释普济","空如来藏，立大圆镜。","四言"],["补乐府十篇 其四 帝少昊氏之乐歌","曹勋","鸟飞于天，鱼跃于渊。","四言"],["智贤上人","释祖钦","智者必贤，正者不偏。","四言"],["九月 其四","曾丰","八月撷葵，十月撷梨。","四言"],["颂古四十四首 其十一","释师范","金毛狮子，生铁秤锤。","四言"],["六句偈六首 其三 前念非凡","释清远","前念非凡，语正言谗。","四言"],["转轮八花诗 其七","项安世","皞皞情适，熙熙俗康。","四言"],["偈十首 其九","释道行","问问不差，答答不错。","四言"],["和君时十章章四句  其四","彭汝砺","温凊匪偕，云如之何。","四言"],["得老龙见和复呈","陈渊","是渠白芽，聚为黑块。","四言"],["偈颂一百六十首 其一五五","释宗杲","千灵万圣，万圣千灵。","四言"],["偈六十九首 其四十一","释道宁","宗门奥旨，祖室玄枢。","四言"],["采蕺 其一","王十朋","陟彼越山，言采其蕺。","四言"],["谢李自明","徐积","养以其久，真以其积。","四言"],["精卫诗","吕本中","西山有鸟，其状如乌。","四言"],["解空居士赞","惠洪","空若不解，即是断空。","四言"],["送江倅","徐积","昔之别驾，则有王祥。","四言"],["天地无穷行","释文珦","天地无穷，人处于中。","四言"],["寄君时四章章四句  其四","彭汝砺","仲兮仲兮，曷日汝偕。","四言"],["题毛霆甫诗集 其一","文天祥","英英白云，在涧之𣸣。","四言"],["有美人兮四章  其二","赵友直","有美人兮，在天之西。","四言"],["自赞 其三","释文准","我已是妄，尔更妄写。","四言"],["颂古三首 其一","释可封","阿魏无真，水银无假。","四言"],["颂古三十一首 其二十三","释如本","家世拄杖，佛祖付嘱。","四言"],["文宣王及其弟子赞 其二十九","赵构","伯兹雩娄，务学实著。","四言"],["和君时十章章四句  其七","彭汝砺","凡人逐物，其力则倍。","四言"],["又求胡忠简公赞","周必大","春秋尊王，外攘夷狄。","四言"],["宋江三十六赞 其二十三 神行太保戴宗","龚开","不疾而速，故神无方。","四言"],["和陶时运四首，并引 其三","苏轼","我视此邦，如洙如沂。","四言"],["文宣王及其弟子赞 其九","赵构","升堂惟光，千乘惟权。","四言"],["治乱吟五首 其一","邵雍","乱多于治，害多于利。","四言"],["口诀颂","周无所住","意到心诚，湛然若凝。","四言"],["颂古六首  其三","释士珪","劈面三拳，连腮七掌。","四言"],["颂古二十七首 其三","释昙贲","六月上伏，八月中秋。","四言"],["山行见月作 其四","赵蕃","恨我无酒，负尔一醉。","四言"],["文宣王及其弟子赞 其十七","赵构","猗尔子上，鲁邦之望。","四言"],["太常乐章三十首 其二十一 皇帝回仗乾元殿奏采茨之曲","杨亿","礼成于郊，迎日之至。","四言"],["法度颂","周无所住","清净药材，密意为丸。","四言"],["人我","张伯端","我不异人，人心自异。","四言"],["临济赞","释崇岳","一棒一喝，倾湫倒岳。","四言"],["寄君时四章章四句  其二","彭汝砺","我帆我舟，泛彼大江。","四言"],["寄君时四章章四句  其二","彭汝砺","我游我庭，有菊之苗。","四言"],["遗偈","释庆闲","露质浮世，奄质浮灭。","四言"],["书亡弟殡所","邵雍","后乎吾来，先乎吾往。","四言"],["天道虽远行","释文珦","天道虽远，人心匪殊。","四言"],["内外吟 其一","邵雍","衣冠严整，谓之外修。","四言"],["和君时十章章四句  其二","彭汝砺","猗彼君子，克诚其身。","四言"],["疏山仁禅师赞","惠洪","三支习气，其毒炽然。","四言"],["偈颂三十首 其二十三","释印肃","显老明禅，入理深渊。","四言"],["颂古三十二首 其八","释明辩","冤憎会苦，爱别离苦。","四言"],["祖机上人","释祖钦","灵妙之机，佛祖莫知。","四言"],["神功盛德诗  其二三","华镇","既发我明，既达我聪。","四言"],["偈四首 其二","释法秀","秋云秋水，看山满目。","四言"],["当断吟","邵雍","断以决疑，疑不可缓。","四言"],["赠武夷旅人","徐积","武夷旅人，而有气节。","四言"],["文宣王及其弟子赞 其七十","赵构","温温子里，入闻至圣。","四言"],["穷达吟","邵雍","穷不能卷，达不能舒。","四言"],["临终偈","释祖先","末后一句，已成忉怛。","四言"],["和陶停云四首，并引 其一","苏轼","停云在空，黯其将雨。","四言"],["诧嗟吟","邵雍","昨日炙手，今日张罗。","四言"],["盘居六章  其六","项安世","行止盘盘，其乐孔多。","四言"],["无妄吟","邵雍","耳无妄听，目无妄顾，口无妄言，心无妄虑。","四言"],["偈颂十三首 其一","释智愚","不劳弹指，岂涉思惟。","四言"],["示寂偈","释真如","昨夜三更，风雷忽作。","四言"],["所居三章二章章八句一章章十句  其三","洪皓","人亦有言，祸福无门。","四言"],["偈颂一百零二首 其五","释绍昙","山舍春深，生涯日贫。","四言"],["义利吟","邵雍","意不若义，义不若利。","四言"],["义利吟","邵雍","贲于丘园，束帛戋戋。","四言"],["圭首座求赞","释清远","如圭如璋，惟子非我。","四言"],["宋江三十六赞 其三十六 扑天雕李应","龚开","鸷禽雄长，惟雕最狡。","四言"],["和君时十章章四句  其六","彭汝砺","尔旋尔车，不知其期。","四言"],["三月十三日夜五更闻杜鹃时成父欲入浙因赋六章章四句以送之  其一","赵蕃","不如归去，苍山茂树。","四言"],["送赵守","徐积","齐有高密，有沂有沐。","四言"],["和陶停云四首，并引 其三","苏轼","凛然清臞，落其骄荣。","四言"],["拈古十四首 其六","释法薰","来风可辨，驷马难追。","四言"],["雨师雷神七首 其七 送神。曲同迎神。","郊庙朝会歌辞","阴旄载旋，鼓车其鞭。","四言"],["寄君时六章章四句  其二","彭汝砺","我处于中，而舍其偏。","四言"],["和君时十章章四句  其五","彭汝砺","吾斯未信，吾颜之厚。","四言"],["金丹大药诀","白玉蟾","离府龙飞，坎宫虎跃。","四言"],["和陶命子韵示津调官 其二","吴芾","又岂不知，道否晚周。","四言"],["偈颂一百二十三首 其十一","释祖钦","黄面老子，六载辛勤。","四言"],["送直禅人","释宗杲","直出直入，直行直坐。","四言"],["和陶劝农六首，并引 其六","苏轼","逸谚戏侮，博弈顽鄙。","四言"],["碧泉兴作即事有感因续魏武之诗","胡宏","对酒当歌，人生几何。","四言"],["白云端和尚赞","释清远","纲纪著明，不忘付授。","四言"],["丁宁吟","邵雍","人无忽略，事贵丁宁。","四言"]]