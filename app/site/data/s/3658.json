[["归朝欢","王哲","天地初分何处寄。","词"],["玉蝴蝶","王哲","捉住玉山赤凤，神舟同泛，激浪漂浮。","词"],["西江月","王哲","酒饮清光滑辣，果餐软美香甜。","词"],["忆王孙","白朴","瑶阶月色晃疏棂。","词"],["渔父词 赋胡直之溪桥莲塘二首","张建","溪桥脚下水平分，桥柱萍粘浪打痕。","词"],["水仙子","徐再思","一声梧叶一声秋，一点芭蕉一点愁，三更归梦三更后。","词"],["朝天子","徐再思","里湖，外湖，无处是无春处。","词"],["水仙子","马致远","春风骄马五陵儿，暖日西湖三月时，管弦触水莺花市。","词"],null,null,null,null,["人月圆 马嵬效吴彦高","李齐贤","五云绣岭明珠殿，飞燕倚新妆。","词"],["落梅风","珠帘秀","山无数，烟万缕。","词"],null,["西江月","佚名","彼此离于生处，火遭水破惊忙。","词"],null,null,null,null,null,["明良诗","吴当","于赫皇祖，肇基朔土。","四言"],["恒德斋为开府明良公作","吴当","于穆天命，恒久不已。","四言"],["极高明亭诗为曾以敬作","吴当","春木载荣，朝阳孔曦。","四言"],["庆原堂诗为萍乡刘氏作","吴当","惟楚萍乡，邑里有堂。","四言"],["咸阳王功德诗","吴当","在昔皇祖，有赫神武。","四言"],null,["集义斋诗为太行高氏作","吴当","瞻彼嘉木，太行之阴。","四言"],null,["修省斋诗","吴当","惟皇降衷，弗忚弗亏。","四言"],["寿宁堂诗为冀宁耿氏作","吴当","于昭秉彝，有本有支。","四言"],null,["蓄川","杨弘道","蓄川膴膴，闲田可耕。","四言"],["重庆堂诗","危素","翼翼高堂，临水之阳。","四言"],["鸣雁二章 其一","张玉娘","鸣雁征征，白露既零。","四言"],["灵泉翀举自有诗十八章留人间今止存五遂续之","滕斌","石冷龙蟠，风高鹤瘦。","四言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["句 其二","赵佶","相公公相子。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["五杂俎","刘基","五杂俎，原上翮。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["五杂组","宋褧","五杂组，䗖𬟽掣。","杂言"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["祀蚕姑火龙词四章","杨维桢","火之龙兮，云弗从，雨弗降。","杂言"],null,null,null,null,null,null,null,null,null,null,null,["春闺怨","袁桷","妾家住在湘江曲，门枕湘江春水绿。","杂言"],null,null,null,null,null,null,null,null,null,null,null,["五杂组","徐贲","五杂组，机上丝。","杂言"]]